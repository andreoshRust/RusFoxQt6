//№    Тест    Статус
//1    Создание объекта    ✅
//2    Проверка валидности    ✅
//3    Тип формата (TableFormat = 4)    ✅
//4    Проверка пустоты    ✅
//5    Количество колонок (setColumns/columns)    ✅
//6    Отступы ячеек (cellSpacing/cellPadding)    ✅
//7    Границы (border/borderStyle)    ✅
//8    Выравнивание (alignment)    ✅
//9    Отступы (top/bottom/left/right)    ✅
//10    Заголовочные строки (headerRowCount)    ✅
//11    Цвет границы (setBorderColor/borderColor)    ✅
//12    Копирование (copyTo/КопироватьВ)    ✅
//13    Получить/Установить формат    ✅




// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстТаблицаФормат
// ============================================================

Функция ДиагностикаМетодовQtTextTableFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстТаблицаФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстТаблицаФормат: " + (typeof QtТекстТаблицаФормат !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстТаблицаФормат: " + e)
    КонецПопытки;
    
    Попытка
        диагФормат = Новый QtТекстТаблицаФормат()
        Если диагФормат == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстТаблицаФормат не создан")
            Возврат
        КонецЕсли;
        
        диагФормат.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtТекстТаблицаФормат создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "type", "objectIndex", "isEmpty",
            "setProperty", "property", "hasProperty", "clearProperty", "propertyCount",
            "operatorEqual", "operatorNotEqual",
            "merge", "copy",
            "getFormat", "setFormat",
            "getTableFormatObject", "setTableFormat",
            "setColumns", "columns",
            "setCellSpacing", "cellSpacing",
            "setCellPadding", "cellPadding",
            "setBorder", "border",
            "setBorderStyle", "borderStyle",
            "setBorderColor", "borderColor",
            "setAlignment", "alignment",
            "setTopMargin", "topMargin",
            "setBottomMargin", "bottomMargin",
            "setLeftMargin", "leftMargin",
            "setRightMargin", "rightMargin",
            "setHeaderRowCount", "headerRowCount",
            "setPageBreakPolicy", "pageBreakPolicy",
            "setColumnWidthConstraints", "columnWidthConstraints",
            "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "Тип", "ИндексОбъекта", "Пусто",
            "УстановитьСвойство", "Свойство", "ЕстьСвойство", "ОчиститьСвойство", "КоличествоСвойств",
            "Равно", "НеРавно",
            "Объединить", "Копировать",
            "ПолучитьФормат", "УстановитьФормат",
            "ПолучитьФорматТаблицы", "УстановитьФорматТаблицы",
            "УстановитьКолонки", "Колонки",
            "УстановитьРасстояниеЯчеек", "РасстояниеЯчеек",
            "УстановитьОтступЯчеек", "ОтступЯчеек",
            "УстановитьГраницу", "Граница",
            "УстановитьСтильГраницы", "СтильГраницы",
            "УстановитьЦветГраницы", "ЦветГраницы",
            "УстановитьВыравнивание", "Выравнивание",
            "УстановитьВерхнийОтступ", "ВерхнийОтступ",
            "УстановитьНижнийОтступ", "НижнийОтступ",
            "УстановитьЛевыйОтступ", "ЛевыйОтступ",
            "УстановитьПравыйОтступ", "ПравыйОтступ",
            "УстановитьЗаголовочныеСтроки", "ЗаголовочныеСтроки",
            "УстановитьПолитикуРазрываСтраницы", "ПолитикаРазрываСтраницы",
            "УстановитьОграниченияШириныКолонок", "ОграниченияШириныКолонок",
            "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагФормат.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагФормат.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстТаблицаФормат: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстТаблицаФормат
// ============================================================

Функция ЭтоМетодБезПараметровТаблица(имя)
    список = [
        "isValid", "type", "objectIndex", "isEmpty",
        "propertyCount", "operatorEqual", "operatorNotEqual",
        "merge", "copy", "getFormat",
        "getTableFormatObject", "columns",
        "cellSpacing", "cellPadding", "border",
        "borderStyle", "borderColor", "alignment",
        "topMargin", "bottomMargin", "leftMargin", "rightMargin",
        "headerRowCount", "pageBreakPolicy",
        "columnWidthConstraints",
        "copyTo", "RusFunc"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСОднимПараметромТаблица(имя)
    список = [
        "setFormat", "setTableFormat", "setColumns",
        "setCellSpacing", "setCellPadding", "setBorder",
        "setBorderStyle", "setBorderColor", "setAlignment",
        "setTopMargin", "setBottomMargin", "setLeftMargin", "setRightMargin",
        "setHeaderRowCount", "setPageBreakPolicy"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСДвумяПараметрамиТаблица(имя)
    список = [
        "setProperty"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСМассивомПараметровТаблица(имя)
    список = [
        "setColumnWidthConstraints"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ДиагностикаМетаОбъектаTextTableFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстТаблицаФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextTableFormat: " + (typeof QtTextTableFormat !== "undefined"))
        ВывестиСтрокуВКонсоль("Проверка QtТекстТаблицаФормат: " + (typeof QtТекстТаблицаФормат !== "undefined"))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        формат = НовыйОбъект("QtТекстТаблицаФормат")
        Если формат == null Тогда
            формат = Новый QtTextTableFormat()
            Если формат == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtTextTableFormat()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстТаблицаФормат:")
    
    методы = Object.getOwnPropertyNames(формат)
    прототип = Object.getPrototypeOf(формат)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    
    Для i = 0 По методыПрототипа.длина - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Список проблемных методов
    проблемныеМетоды = []
    успешныеМетоды = []
    
    Для i = 0 По методы.длина - 1 Цикл
        имя = методы[i]
        
        // Пропускаем служебные методы
        Если имя === "constructor" ИЛИ имя === "objectNameChanged" ИЛИ имя === "destroyed" Тогда
            Продолжить
        КонецЕсли
        
        Попытка
            // Проверяем, является ли это функцией
            Если typeof(формат[имя]) === "function" Тогда
                // Пытаемся вызвать метод с правильными параметрами
                Попытка
                    // Определяем тип метода по имени
                    Если ЭтоМетодБезПараметровТаблица(имя) Тогда
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСОднимПараметромТаблица(имя) Тогда
                        формат[имя](1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСДвумяПараметрамиТаблица(имя) Тогда
                        формат[имя](1, 2)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1, 2) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСМассивомПараметровТаблица(имя) Тогда
                        формат[имя]([])
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "([]) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    Иначе
                        // Неизвестный метод - пробуем вызвать без параметров
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK (неизвестный)")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                    КонецЕсли
                    
                Исключение
                    // Метод вызвал исключение
                    УстановитьЦветКонсоли("красный")
                    ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - ОШИБКА: " + e)
                    СброситьЦветКонсоли()
                    проблемныеМетоды.push({имя: имя, ошибка: e})
                КонецПопытки
            КонецЕсли
        Исключение
            // Ошибка при проверке типа метода
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("  ✗ " + имя + " - ОШИБКА ПРОВЕРКИ: " + e)
            СброситьЦветКонсоли()
            проблемныеМетоды.push({имя: имя, ошибка: e})
        КонецПопытки
    КонецЦикла
    
    // ========== ИТОГИ ==========
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("голубой")
    ВывестиСтрокуВКонсоль("=== ИТОГИ ДИАГНОСТИКИ ===")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("  ✅ Успешных методов: " + успешныеМетоды.length)
    
    Если проблемныеМетоды.length > 0 Тогда
        УстановитьЦветКонсоли("красный")
        ВывестиСтрокуВКонсоль("  ❌ Проблемных методов: " + проблемныеМетоды.length)
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("  Список проблемных методов:")
        Для i = 0 По проблемныеМетоды.length - 1 Цикл
            элемент = проблемныеМетоды[i]
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("    - " + элемент.имя + "() : " + элемент.ошибка)
            СброситьЦветКонсоли()
        КонецЦикла
    Иначе
        УстановитьЦветКонсоли("зеленый")
        ВывестиСтрокуВКонсоль("  ✅ Все методы работают корректно!")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТекстТаблицаФормат
// ============================================================
Функция ТестQtTextTableFormatFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        формат = Новый QtТекстТаблицаФормат()
        Если формат != null Тогда
            формат.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстТаблицаФормат создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстТаблицаФормат НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtТекстТаблицаФормат провален (ошибка создания)"
    КонецПопытки;
    
    Если формат == null Тогда
        Возврат "❌ Тест QtТекстТаблицаФормат провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        валидный = формат.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = формат.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ТИП ФОРМАТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Тип формата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        тип = формат.type()
