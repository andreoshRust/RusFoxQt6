//№    Тест    Статус
//1    Создание объекта    ✅
//2    Проверка валидности    ✅
//3    Тип формата    ✅
//4    Проверка пустоты    ✅
//5    Стиль списка (ListDisc, ListCircle)    ✅
//6    Префикс и суффикс номера    ✅
//7    Отступ (indent)    ✅
//8    Копирование (copyTo/КопироватьВ)    ✅
//9    Получить/Установить формат    ✅
// Стили списков (использованные в тесте)
//Значение    Константа    Описание
//1    ListDisc    Маркер в виде круга ●
//2    ListCircle    Маркер в виде окружности ○
//3    ListSquare    Маркер в виде квадрата ■
//4    ListDecimal    Нумерация (1, 2, 3...)
//5    ListLowerAlpha    Буквы строчные (a, b, c...)
//6    ListUpperAlpha    Буквы прописные (A, B, C...)
//7    ListLowerRoman    Римские строчные (i, ii, iii...)
//8    ListUpperRoman    Римские прописные (I, II, III...)

Пусть Режим_Отладки = ИСТИНА
// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстСписокФормат
// ============================================================

Функция ДиагностикаМетодовQtTextListFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстСписокФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстСписокФормат: " + (typeof QtТекстСписокФормат !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстСписокФормат: " + e)
    КонецПопытки;
    
    Попытка
        диагФормат = Новый QtТекстСписокФормат()
        диагФормат.РежимОтладки(Режим_Отладки)
        Если диагФормат == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстСписокФормат не создан")
            Возврат
        КонецЕсли;
        
        диагФормат.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtТекстСписокФормат создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "type", "objectIndex", "isEmpty",
            "setProperty", "property", "hasProperty", "clearProperty", "propertyCount",
            "operatorEqual", "operatorNotEqual",
            "merge", "copy",
            "getFormat", "setFormat",
            "getListFormatObject", "setListFormat",
            "setStyle", "style",
            "setNumberPrefix", "numberPrefix",
            "setNumberSuffix", "numberSuffix",
            "setIndent", "indent",
            "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "Тип", "ИндексОбъекта", "Пусто",
            "УстановитьСвойство", "Свойство", "ЕстьСвойство", "ОчиститьСвойство", "КоличествоСвойств",
            "Равно", "НеРавно",
            "Объединить", "Копировать",
            "ПолучитьФормат", "УстановитьФормат",
            "ПолучитьФорматСписка", "УстановитьФорматСписка",
            "УстановитьСтиль", "Стиль",
            "УстановитьПрефиксНомера", "ПрефиксНомера",
            "УстановитьСуффиксНомера", "СуффиксНомера",
            "УстановитьОтступ", "Отступ",
            "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагФормат.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагФормат.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстСписокФормат: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстСписокФормат
// ============================================================

Функция ЭтоМетодБезПараметровСписок(имя)
    список = [
        "isValid", "type", "objectIndex", "isEmpty",
        "propertyCount", "operatorEqual", "operatorNotEqual",
        "merge", "copy", "getFormat",
        "getListFormatObject", "style",
        "numberPrefix", "numberSuffix", "indent",
        "copyTo", "RusFunc"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСОднимПараметромСписок(имя)
    список = [
        "setFormat", "setListFormat", "setStyle",
        "setNumberPrefix", "setNumberSuffix",
        "setIndent"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСДвумяПараметрамиСписок(имя)
    список = [
        "setProperty"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ДиагностикаМетаОбъектаTextListFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстСписокФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextListFormat: " + (typeof QtTextListFormat !== "undefined"))
        ВывестиСтрокуВКонсоль("Проверка QtТекстСписокФормат: " + (typeof QtТекстСписокФормат !== "undefined"))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        формат = Новый QtТекстСписокФормат()
        формат.РежимОтладки(Режим_Отладки)
        Если формат == null Тогда
            формат = Новый QtTextListFormat()
            формат.РежимОтладки(Режим_Отладки)
            Если формат == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtTextListFormat()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстСписокФормат:")
    
    методы = Object.getOwnPropertyNames(формат)
    прототип = Object.getPrototypeOf(формат)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    
    Для i = 0 По методыПрототипа.длина - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Список проблемных методов
    проблемныеМетоды = []
    успешныеМетоды = []
    
    Для i = 0 По методы.длина - 1 Цикл
        имя = методы[i]
        
        // Пропускаем служебные методы
        Если имя === "constructor" ИЛИ имя === "objectNameChanged" ИЛИ имя === "destroyed" Тогда
            Продолжить
        КонецЕсли
        
        Попытка
            // Проверяем, является ли это функцией
            Если typeof(формат[имя]) === "function" Тогда
                // Пытаемся вызвать метод с правильными параметрами
                Попытка
                    // Определяем тип метода по имени
                    Если ЭтоМетодБезПараметровСписок(имя) Тогда
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСОднимПараметромСписок(имя) Тогда
                        формат[имя](1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСДвумяПараметрамиСписок(имя) Тогда
                        формат[имя](1, 2)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1, 2) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    Иначе
                        // Неизвестный метод - пробуем вызвать без параметров
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK (неизвестный)")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                    КонецЕсли
                    
                Исключение
                    // Метод вызвал исключение
                    УстановитьЦветКонсоли("красный")
                    ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - ОШИБКА: " + e)
                    СброситьЦветКонсоли()
                    проблемныеМетоды.push({имя: имя, ошибка: e})
                КонецПопытки
            КонецЕсли
        Исключение
            // Ошибка при проверке типа метода
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("  ✗ " + имя + " - ОШИБКА ПРОВЕРКИ: " + e)
            СброситьЦветКонсоли()
            проблемныеМетоды.push({имя: имя, ошибка: e})
        КонецПопытки
    КонецЦикла
    
    // ========== ИТОГИ ==========
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("голубой")
    ВывестиСтрокуВКонсоль("=== ИТОГИ ДИАГНОСТИКИ ===")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("  ✅ Успешных методов: " + успешныеМетоды.length)
    
    Если проблемныеМетоды.length > 0 Тогда
        УстановитьЦветКонсоли("красный")
        ВывестиСтрокуВКонсоль("  ❌ Проблемных методов: " + проблемныеМетоды.length)
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("  Список проблемных методов:")
        Для i = 0 По проблемныеМетоды.length - 1 Цикл
            элемент = проблемныеМетоды[i]
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("    - " + элемент.имя + "() : " + элемент.ошибка)
            СброситьЦветКонсоли()
        КонецЦикла
    Иначе
        УстановитьЦветКонсоли("зеленый")
        ВывестиСтрокуВКонсоль("  ✅ Все методы работают корректно!")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТекстСписокФормат
// ============================================================
Функция ТестQtTextListFormatFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        формат = Новый QtТекстСписокФормат()
        Если формат != null Тогда
            формат.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстСписокФормат создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстСписокФормат НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtТекстСписокФормат провален (ошибка создания)"
    КонецПопытки;
    
    Если формат == null Тогда
        Возврат "❌ Тест QtТекстСписокФормат провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        валидный = формат.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = формат.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ТИП ФОРМАТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Тип формата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        тип = формат.type()
        ВывестиСтрокуВКонсоль("    [ENG] type: " + тип + " (ожидается 3 - ListFormat)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И тип == 3 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] type работает корректно")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 3, получено " + тип)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            типРус = формат.Тип()
            ВывестиСтрокуВКонсоль("    [RUS] Тип: " + типРус + " (ожидается 3)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И типРус == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Тип работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3, получено " + типРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 4. ПРОВЕРКА ПУСТОТЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка пустоты")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        пустой = формат.isEmpty()
        ВывестиСтрокуВКонсоль("    [ENG] isEmpty: " + пустой + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И пустой == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isEmpty работает корректно")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + пустой)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            пустойРус = формат.Пусто()
            ВывестиСтрокуВКонсоль("    [RUS] Пусто: " + пустойРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И пустойРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Пусто работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + пустойРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 5. СТИЛЬ СПИСКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Стиль списка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат.setStyle(1)
        стиль = формат.style()
        ВывестиСтрокуВКонсоль("    [ENG] setStyle/style: " + стиль + " (ожидается 1 - ListDisc)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И стиль == 1 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль списка работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 1, получено " + стиль)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат.УстановитьСтиль(2)
            стильРус = формат.Стиль()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтиль/Стиль: " + стильРус + " (ожидается 2 - ListCircle)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И стильРус == 2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль списка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 2, получено " + стильРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 6. ПРЕФИКС И СУФФИКС НОМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Префикс и суффикс номера")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат.setNumberPrefix("[")
        формат.setNumberSuffix("]")
        префикс = формат.numberPrefix()
        суффикс = формат.numberSuffix()
        ВывестиСтрокуВКонсоль("    [ENG] prefix='" + префикс + "', suffix='" + суффикс + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И префикс == "[" И суффикс == "]" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Префикс/суффикс работают")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка в префиксе/суффиксе")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат.УстановитьПрефиксНомера("(")
            формат.УстановитьСуффиксНомера(")")
            префиксРус = формат.ПрефиксНомера()
            суффиксРус = формат.СуффиксНомера()
            ВывестиСтрокуВКонсоль("    [RUS] префикс='" + префиксРус + "', суффикс='" + суффиксРус + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И префиксРус == "(" И суффиксРус == ")" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Префикс/суффикс работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка в префиксе/суффиксе")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 7. ОТСТУП =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Отступ")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат.setIndent(5)
        отступ = формат.indent()
        ВывестиСтрокуВКонсоль("    [ENG] setIndent/indent: " + отступ + " (ожидается 5)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И отступ == 5 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Отступ работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 5, получено " + отступ)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат.УстановитьОтступ(10)
            отступРус = формат.Отступ()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьОтступ/Отступ: " + отступРус + " (ожидается 10)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И отступРус == 10 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Отступ работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10, получено " + отступРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 8. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        копияЦель = Новый QtТекстСписокФормат()
        копияЦель.РежимОтладки(Режим_Отладки)
        Если копияЦель != null Тогда
            успех = формат.copyTo(копияЦель)
            Если успех Тогда
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: содержимое скопировано")
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] копия isValid: " + валидность)
                Если typeof копияЦель.Действителен === 'function' Тогда
                    валидностьРус = копияЦель.Действителен()
                    ВывестиСтрокуВКонсоль("    [ENG] копия Действителен: " + валидностьРус)
                    ВывестиСтрокуВКонсоль("    [ENG] Русские методы доступны ✓")
                    англУспех = ИСТИНА
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [ENG] Русские методы НЕ доступны")
                    СброситьЦветКонсоли()
                    тестПройден = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            копияЦельРус = Новый QtТекстСписокФормат()
            копияЦельРус.РежимОтладки(Режим_Отладки)
            Если копияЦельРус != null Тогда
                успехРус = формат.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: содержимое скопировано")
                    Если typeof копияЦельРус.Действителен === 'function' Тогда
                        валидностьРус = копияЦельРус.Действителен()
                        ВывестиСтрокуВКонсоль("    [RUS] копия Действителен: " + валидностьРус)
                        русУспех = ИСТИНА
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ [RUS] Русские методы НЕ доступны")
                        СброситьЦветКонсоли()
                        тестРусский = ЛОЖЬ
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 9. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Получить/Установить формат")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        полученныйФормат = формат.getListFormatObject()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getListFormatObject: формат получен")
            формат.setListFormat(полученныйФормат)
            ВывестиСтрокуВКонсоль("    [ENG] setListFormat: формат установлен")
            англУспех = ИСТИНА
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getListFormatObject: формат НЕ получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            полученныйФорматРус = формат.ПолучитьФорматСписка()
            Если полученныйФорматРус != null Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьФорматСписка: формат получен")
                формат.УстановитьФорматСписка(полученныйФорматРус)
                ВывестиСтрокуВКонсоль("    [RUS] УстановитьФорматСписка: формат установлен")
                русУспех = ИСТИНА
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПолучитьФорматСписка: формат НЕ получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Получить/Установить формат работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Получить/Установить формат не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстСписокФормат завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.14  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtТекстСписокФормат (QtTextListFormat)             ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTextListFormat()
    ДиагностикаМетаОбъектаTextListFormat()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстСписокФормат (русские и английские методы)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextListFormatFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстСписокФормат: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ
