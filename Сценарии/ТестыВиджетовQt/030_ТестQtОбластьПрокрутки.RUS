    КонецЕсли
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtОбластьПрокрутки завершён"
КонецФункции



// ============================================================
// УПРОЩЕННЫЙ ТЕСТ QtОбластьПрокрутки
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 3.0 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    ДиагностикаМетодовQtScrollArea()
    ДиагностикаМетаОбъектаScrollArea()
    ТестQtScrollAreaFull()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtОбластьПрокрутки (QtScrollArea)                ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("=== ТЕСТ 1: СОЗДАНИЕ ОБЪЕКТА ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Создание QtScrollArea...")
        область = new QtScrollArea()
        ВывестиСтрокуВКонсоль("✓ Объект создан: " + (область != null ? "не null" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
    КонецПопытки
    
    Если область == null Тогда
        ВывестиСтрокуВКонсоль("❌ Объект не создан, тест прерван")
        Возврат
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("=== ТЕСТ 2: ПРОВЕРКА МЕТОДОВ ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка isValid(): " + область.isValid())
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка isValid(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка getRealWidget(): " + (область.getRealWidget() != null ? "не null" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка getRealWidget(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка widgetResizable(): " + область.widgetResizable())
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка widgetResizable(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка horizontalScrollBarPolicy(): " + область.horizontalScrollBarPolicy())
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка horizontalScrollBarPolicy(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка verticalScrollBarPolicy(): " + область.verticalScrollBarPolicy())
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка verticalScrollBarPolicy(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка horizontalScrollBar(): " + (область.horizontalScrollBar() != null ? "не null" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка horizontalScrollBar(): " + e)
    КонецПопытки
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка verticalScrollBar(): " + (область.verticalScrollBar() != null ? "не null" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка verticalScrollBar(): " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("=== ТЕСТ 3: РУССКИЕ МЕТОДЫ ===")
    
    Попытка
        Если typeof область.Действителен === 'function' Тогда
            ВывестиСтрокуВКонсоль("✓ Метод Действителен существует")
            ВывестиСтрокуВКонсоль("  Действителен(): " + область.Действителен())
        Иначе
            ВывестиСтрокуВКонсоль("✗ Метод Действителен НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка: " + e)
    КонецПопытки
    
    Попытка
        Если typeof область.УстановитьВиджет === 'function' Тогда
            ВывестиСтрокуВКонсоль("✓ Метод УстановитьВиджет существует")
        Иначе
            ВывестиСтрокуВКонсоль("✗ Метод УстановитьВиджет НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка: " + e)
    КонецПопытки
    
    Попытка
        Если typeof область.ПолитикаГоризонтальнойПолосы === 'function' Тогда
            ВывестиСтрокуВКонсоль("✓ Метод ПолитикаГоризонтальнойПолосы существует")
        Иначе
            ВывестиСтрокуВКонсоль("✗ Метод ПолитикаГоризонтальнойПолосы НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка: " + e)
    КонецПопытки
    
    Попытка
        Если typeof область.ПолитикаВертикальнойПолосы === 'function' Тогда
            ВывестиСтрокуВКонсоль("✓ Метод ПолитикаВертикальнойПолосы существует")
        Иначе
            ВывестиСтрокуВКонсоль("✗ Метод ПолитикаВертикальнойПолосы НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("=== ТЕСТ 4: RUSFUNC ===")
    
    Попытка
        Если typeof область.RusFunc === 'function' Тогда
            ВывестиСтрокуВКонсоль("✓ Метод RusFunc существует")
            Попытка
                jsonStr = область.RusFunc()
                ВывестиСтрокуВКонсоль("  RusFunc вызван, длина: " + jsonStr.length)
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ Ошибка при вызове RusFunc: " + e)
            КонецПопытки
        Иначе
            ВывестиСтрокуВКонсоль("✗ Метод RusFunc НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("✅ Тест завершен!")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ



