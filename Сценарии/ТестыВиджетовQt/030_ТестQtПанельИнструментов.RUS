//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность    isValid    Действителен    ✅
//3    Добавление действий    addAction    ДобавитьДействие    ✅
//4    Добавление разделителя    addSeparator    ДобавитьРазделитель    ✅
//5    Получение списка действий    actions    Действия    ✅
//6    Перемещаемость    setMovable/isMovable    УстановитьПеремещаемый/Перемещаемый    ✅
//7    Стиль кнопок    setToolButtonStyle/toolButtonStyle    УстановитьСтильКнопок/СтильКнопок    ✅
//8    Разрешенные области    setAllowedAreas/allowedAreas    УстановитьРазрешенныеОбласти/РазрешенныеОбласти    ✅
//9    Константы    LeftToolBarArea, RightToolBarArea, ...    ЛеваяОбласть, ПраваяОбласть, ...    ✅
//10    Очистка    clear    Очистить    ✅
//11    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//12    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//13    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//14    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//15    Получение реального виджета    getRealWidget/getRealObject    ПолучитьОбъект

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtToolBar
// ============================================================

Функция ДиагностикаМетодовQtToolBar()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtToolBar ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtToolBar: " + (typeof QtToolBar !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtToolBar: " + e)
    КонецПопытки;
    
    Попытка
        диагToolBar = НовыйОбъект("QtПанельИнструментов")
        Если диагToolBar == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПанельИнструментов не создан")
            Возврат
        КонецЕсли;
        
        диагToolBar.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПанельИнструментов создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "addAction", "addSeparator", "addWidget", "clear",
            "setAllowedAreas", "allowedAreas",
            "isFloating",
            "setToolButtonStyle", "toolButtonStyle",
            "setMovable", "isMovable",
            "orientation",
            "setIconSize", "iconSize",
            "actions", "actionAt",
            "LeftToolBarArea", "RightToolBarArea", "TopToolBarArea", "BottomToolBarArea",
            "NoToolBarArea", "AllToolBarAreas",
            "ToolButtonIconOnly", "ToolButtonTextOnly", "ToolButtonTextBesideIcon",
            "ToolButtonTextUnderIcon", "ToolButtonFollowStyle",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагToolBar[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "ДобавитьДействие", "ДобавитьРазделитель", "ДобавитьВиджет", "Очистить",
            "УстановитьРазрешенныеОбласти", "РазрешенныеОбласти",
            "Плавающий",
            "УстановитьСтильКнопок", "СтильКнопок",
            "УстановитьПеремещаемый", "Перемещаемый",
            "Ориентация",
            "УстановитьРазмерИконок", "РазмерИконок",
            "Действия", "ДействиеВКоординатах",
            "ЛеваяОбласть", "ПраваяОбласть", "ВерхняяОбласть", "НижняяОбласть",
            "НетОбласти", "ВсеОбласти",
            "ТолькоИконка", "ТолькоТекст", "ТекстРядомСИконкой",
            "ТекстПодИконкой", "СледоватьСтилю",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагToolBar[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагToolBar.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагToolBar.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПанельИнструментов: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtToolBar (QtПанельИнструментов)
// ============================================================

Функция ТестQtToolBarFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    toolBar = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        toolBar = НовыйОбъект("QtПанельИнструментов")
        Если toolBar == null Тогда
            toolBar = new QtToolBar()
        КонецЕсли
        
        Если toolBar != null Тогда
            toolBar.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПанельИнструментов создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПанельИнструментов НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если toolBar == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ ToolBar не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = toolBar.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = toolBar.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. ДОБАВЛЕНИЕ ДЕЙСТВИЙ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "addAction/ДобавитьДействие"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Добавление действий")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    действие1 = null
    действие2 = null
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        действие1 = toolBar.addAction("Действие 1")
        действие2 = toolBar.addAction("Действие 2")
        ВывестиСтрокуВКонсоль("    [ENG] addAction: action1=" + (действие1 != null) + ", action2=" + (действие2 != null))
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И действие1 != null И действие2 != null Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Добавление действий работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка добавления действий")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            действие3 = toolBar.ДобавитьДействие("Действие 3")
            действие4 = toolBar.ДобавитьДействие("Действие 4")
            ВывестиСтрокуВКонсоль("    [RUS] ДобавитьДействие: action3=" + (действие3 != null) + ", action4=" + (действие4 != null))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И действие3 != null И действие4 != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Добавление действий работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка добавления действий")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. ДОБАВЛЕНИЕ РАЗДЕЛИТЕЛЯ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "addSeparator/ДобавитьРазделитель"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Добавление разделителя")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        toolBar.addSeparator()
        список = toolBar.actions()
        ВывестиСтрокуВКонсоль("    [ENG] addSeparator: actions count=" + список.length)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Добавление разделителя работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка добавления разделителя")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            toolBar.ДобавитьРазделитель()
            списокРус = toolBar.Действия()
            ВывестиСтрокуВКонсоль("    [RUS] ДобавитьРазделитель: actions count=" + списокРус.length)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Добавление разделителя работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
