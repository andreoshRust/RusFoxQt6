//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность    isValid    Действителен    ✅
//3    Установка простого текста    setPlainText/toPlainText    УстановитьПростойТекст/ПростойТекст    ✅
//4    Добавление текста    append    Добавить    ✅
//5    Режим только чтения    setReadOnly/isReadOnly    УстановитьТолькоЧтение/ТолькоЧтение    ✅
//6    Отмена/Повтор    undo/redo/canUndo/canRedo    Отменить/Повторить/МожноОтменить/МожноПовторить    ✅
//7    Выделение всего    selectAll    ВыделитьВсе    ✅
//8    Управление шрифтом    setFontPointSize/fontPointSize/setFontBold/fontBold    УстановитьРазмерШрифта/РазмерШрифта/УстановитьКурсивШрифта/КурсивШрифта    ✅
//9    Константы переноса    NoWrap/WidgetWidth/FixedPixelWidth/FixedColumnWidth    БезПереноса/ШиринаВиджета/ФиксированнаяШиринаПикселей/ФиксированнаяШиринаКолонок    ✅
//10    Плейсхолдер    setPlaceholderText/placeholderText    УстановитьТекстПлейсхолдера/ТекстПлейсхолдера    ✅
//11    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//12    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//13    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//14    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//15    Получение реального виджета    getRealWidget/getRealObject    ПолучитьОбъект    ✅



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtTextEdit
// ============================================================

Функция ДиагностикаМетодовQtTextEdit()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtTextEdit ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtTextEdit: " + (typeof QtTextEdit !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtTextEdit: " + e)
    КонецПопытки;
    
    Попытка
        диагTextEdit = НовыйОбъект("QtРедакторТекста")
        Если диагTextEdit == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtРедакторТекста не создан")
            Возврат
        КонецЕсли;
        
        диагTextEdit.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtРедакторТекста создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "setPlainText", "toPlainText",
            "setHtml", "toHtml",
            "append", "clear",
            "setReadOnly", "isReadOnly",
            "setTabStopDistance", "tabStopDistance",
            "document",
            "setPlaceholderText", "placeholderText",
            "setAlignment", "alignment",
            "setFontPointSize", "fontPointSize",
            "setFontFamily", "fontFamily",
            "setFontBold", "fontBold",
            "setFontItalic", "fontItalic",
            "setFontUnderline", "fontUnderline",
            "setOverwriteMode", "overwriteMode",
            "setTabChangesFocus", "tabChangesFocus",
            "setLineWrapColumnOrWidth", "lineWrapColumnOrWidth",
            "setLineWrapMode", "lineWrapMode",
            "setUndoRedoEnabled", "isUndoRedoEnabled",
            "undo", "redo", "canUndo", "canRedo",
            "selectAll", "copy", "cut", "paste",
            "NoWrap", "WidgetWidth", "FixedPixelWidth", "FixedColumnWidth",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTextEdit[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "УстановитьПростойТекст", "ПростойТекст",
            "УстановитьHtml", "В_Html",
            "Добавить", "Очистить",
            "УстановитьТолькоЧтение", "ТолькоЧтение",
            "УстановитьРасстояниеТабуляции", "РасстояниеТабуляции",
            "Документ",
            "УстановитьТекстПлейсхолдера", "ТекстПлейсхолдера",
            "УстановитьВыравнивание", "Выравнивание",
            "УстановитьРазмерШрифта", "РазмерШрифта",
            "УстановитьСемействоШрифта", "СемействоШрифта",
            "УстановитьЖирностьШрифта", "ЖирностьШрифта",
            "УстановитьКурсивШрифта", "КурсивШрифта",
            "УстановитьПодчеркиваниеШрифта", "ПодчеркиваниеШрифта",
            "УстановитьРежимПерезаписи", "РежимПерезаписи",
            "УстановитьTabПереключениеФокуса", "TabПереключениеФокуса",
            "УстановитьШиринуПереноса", "ШиринаПереноса",
            "УстановитьРежимПереноса", "РежимПереноса",
            "УстановитьОтменуПовтор", "ОтменаПовторВключена",
            "Отменить", "Повторить", "МожноОтменить", "МожноПовторить",
            "ВыделитьВсе", "Копировать", "Вырезать", "Вставить",
            "БезПереноса", "ШиринаВиджета", "ФиксированнаяШиринаПикселей", "ФиксированнаяШиринаКолонок",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTextEdit[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагTextEdit.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагTextEdit.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtРедакторТекста: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtTextEdit (QtРедакторТекста)
// ============================================================

Функция ТестQtTextEditFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    textEdit = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        textEdit = НовыйОбъект("QtРедакторТекста")
        Если textEdit == null Тогда
            textEdit = new QtTextEdit()
        КонецЕсли
        
        Если textEdit != null Тогда
            textEdit.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtРедакторТекста создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtРедакторТекста НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если textEdit == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ TextEdit не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = textEdit.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = textEdit.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА ПРОСТОГО ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setPlainText/УстановитьПростойТекст"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка простого текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестТекст = "Hello, World!"
    тестТекстРус = "Привет, Мир!"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        textEdit.setPlainText(тестТекст)
        получТекст = textEdit.toPlainText()
        ВывестиСтрокуВКонсоль("    [ENG] setPlainText: '" + получТекст + "' (ожидается '" + тестТекст + "')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И получТекст == тестТекст Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка простого текста работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка установки простого текста")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            textEdit.УстановитьПростойТекст(тестТекстРус)
            получТекстРус = textEdit.ПростойТекст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПростойТекст: '" + получТекстРус + "' (ожидается '" + тестТекстРус + "')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И получТекстРус == тестТекстРус Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка простого текста работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка установки простого текста")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. ДОБАВЛЕНИЕ ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "append/Добавить"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Добавление текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    добавитьТекст = "Добавленный текст"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        textEdit.append("Первая строка")
        textEdit.append("Вторая строка")
        получТекст = textEdit.toPlainText()
        ВывестиСтрокуВКонсоль("    [ENG] append: текст содержит " + (получТекст.indexOf("Первая строка") >= 0 ? "первую" : "") + " и " + (получТекст.indexOf("Вторая строка") >= 0 ? "вторую" : "") + " строку")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
