//#Область QtWidget_Наследники
//QObject
//    ↓
//QWidget (QtВиджет) - базовый класс всех виджетов
//    ↓
//    ├── QFrame (QtРамка) - базовый для виджетов с рамкой
//    │       ↓
//    │       ├── QLabel (QtЭтикетка) - отображение текста/изображений
//    │       │
//    │       ├── QAbstractScrollArea (QtАбстрактнаяОбластьПрокрутки)
//    │       │       ↓
//    │       │       ├── QTextEdit (QtРедакторТекста) - многострочный текст/HTML
//    │       │       │
//    │       │       ├── QPlainTextEdit (QtПростойТекст) - простой многострочный текст
//    │       │       │
//    │       │       └── QAbstractItemView (QtАбстрактныйВидЭлементов)
//    │       │               ↓
//    │       │               ├── QListView (QtСписокВид) - список элементов
//    │       │               │
//    │       │               ├── QTableView (QtТаблицаВид) - таблица элементов
//    │       │               │
//    │       │               ├── QTreeView (QtДеревоВид) - дерево элементов
//    │       │               │
//    │       │               └── QColumnView (QtКолоночныйВид) - колоночный вид
//    │       │
//    │       ├── QGroupBox (QtГруппБокс) - группа с заголовком
//    │       │
//    │       ├── QAbstractButton (QtАбстрактнаяКнопка)
//    │       │       ↓
//    │       │       ├── QPushButton (QtКнопка) - обычная кнопка
//    │       │       │
//    │       │       ├── QCheckBox (QtФлажок) - флажок
//    │       │       │
//    │       │       ├── QRadioButton (QtРадиоКнопка) - радиокнопка
//    │       │       │
//    │       │       └── QToolButton (QtКнопкаИнструмента) - кнопка панели инструментов
//    │       │
//    │       ├── QLineEdit (QtРедакторСтроки) - однострочный ввод
//    │       │
//    │       ├── QComboBox (QtВыпадающийСписок) - выпадающий список
//    │       │
//    │       ├── QSpinBox (QtВращающийсяБокс) - ввод целых чисел
//    │       │
//    │       ├── QDoubleSpinBox (QtДвойнойСпинБокс) - ввод дробных чисел
//    │       │
//    │       ├── QSlider (QtПолзунок) - ползунок
//    │       │
//    │       ├── QProgressBar (QtПрогрессБар) - индикатор прогресса
//    │       │
//    │       ├── QTabWidget (QtВкладки) - виджет с вкладками
//    │       │
//    │       ├── QStackedWidget (QtСтекВиджетов) - стек страниц
//    │       │
//    │       ├── QSplitter (QtРазделитель) - разделитель с изменяемым размером
//    │       │
//    │       ├── QScrollArea (QtОбластьПрокрутки) - область прокрутки
//    │       │
//    │       ├── QMdiArea (QtMDIОбласть) - MDI область
//    │       │
//    │       ├── QToolBar (QtПанельИнструментов) - панель инструментов
//    │       │
//    │       ├── QStatusBar (QtСтрокаСостояния) - строка состояния
//    │       │
//    │       └── QMenuBar (QtСтрокаМеню) - строка меню
//    │
//    ├── QMainWindow (QtГлавноеОкно) - главное окно приложения
//    │       ↓
//    │       └── (содержит QMenuBar, QToolBar, QStatusBar, центральный виджет)
//    │
//    ├── QDialog (QtДиалог) - диалоговое окно
//    │       ↓
//    │       ├── QMessageBox (QtСообщение) - сообщение
//    │       │
//    │       ├── QFileDialog (QtДиалогФайла) - выбор файла
//    │       │
//    │       ├── QColorDialog (QtДиалогЦвета) - выбор цвета
//    │       │
//    │       ├── QFontDialog (QtДиалогШрифта) - выбор шрифта
//    │       │
//    │       ├── QInputDialog (QtДиалогВвода) - ввод данных
//    │       │
//    │       ├── QProgressDialog (QtДиалогПрогресса) - прогресс
//    │       │
//    │       └── QPrintDialog (QtДиалогПечати) - печать
//    │
//    ├── QListWidget (QtСписокЭлементов) - список элементов
//    │
//    ├── QTableWidget (QtТаблицаВиджет) - таблица элементов
//    │
//    └── QTreeWidget (QtДеревоЭлементов) - дерево элементов
//#КонецОбласти


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВиджет
// ============================================================

Функция ДиагностикаМетодовQtWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВиджет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtВиджет: " + (typeof QtВиджет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtВиджет: " + e)
    КонецПопытки;
    
    Попытка
        диагВиджет = Новый QtВиджет()
        Если диагВиджет == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВиджет не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtВиджет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setVisible", "isVisible", "show", "hide", "raise", "lower",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setAccessibleName", "accessibleName",
            "setAccessibleDescription", "accessibleDescription",
            "setObjectName", "objectName",
            "isValid", "getRealWidget",
            "setParentWrapper", "getParentWrapper",
            "getDebug", "setDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВиджет[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьВидимость", "Видим", "Показать", "Скрыть", "Поднять", "Опустить",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьИмяДоступности", "ИмяДоступности",
            "УстановитьОписаниеДоступности", "ОписаниеДоступности",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "Действителен", "ПолучитьРеальныйВиджет",
            "УстановитьРодителя", "ПолучитьРодителя",
            "РежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВиджет[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагВиджет.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагВиджет.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВиджет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВиджет
// ============================================================

Функция ДиагностикаМетаОбъектаWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВиджет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtWidget: " + (typeof QtWidget !== 'undefined'))
        Попытка
            ВывестиСтрокуВКонсоль("Проверка QtВиджет: " + (typeof QtВиджет !== 'undefined'))
        Исключение
        КонецПопытки;
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        виджет1 = НовыйОбъект("QtВиджет")
        Если виджет1 == null Тогда
            виджет1 = new QtWidget()
            Если виджет1 == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtWidget()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtВиджет:")
    методы = Object.getOwnPropertyNames(виджет1)
    прототип = Object.getPrototypeOf(виджет1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof виджет1[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof виджет1.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = виджет1.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


Функция ТестQtWidgetFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    виджет = null
    Попытка
        виджет = Новый QtВиджет()
        Если виджет != null Тогда
            виджет.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Виджет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Виджет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если виджет == null Тогда
        Возврат "❌ Тест провален (виджет не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = виджет.Действителен()
        ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка заголовка")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьЗаголовок("Тестовое окно")
        заголовок = виджет.Заголовок()
        ВывестиСтрокуВКонсоль("    [RUS] Заголовок: '" + заголовок + "' (ожидается 'Тестовое окно')")
        Если заголовок == "Тестовое окно" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка заголовка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тестовое окно'")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. УСТАНОВКА РАЗМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка размера")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьФиксированныйРазмер(400, 300)
        ширина = виджет.Ширина()
        высота = виджет.Высота()
        размер = виджет.Размер()
        ВывестиСтрокуВКонсоль("    [RUS] Размер: " + ширина + "x" + высота + " (ожидается 400x300)")
        Если ширина == 400 И высота == 300 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка размера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 400x300")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПЕРЕМЕЩЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Перемещение")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.Переместить(100, 200)
        x = виджет.ПозицияX()
        y = виджет.ПозицияY()
        позиция = виджет.Позиция()
        ВывестиСтрокуВКонсоль("    [RUS] Позиция: " + x + "," + y + " (ожидается 100,200)")
        Если x == 100 И y == 200 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Перемещение работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 100,200")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьВидимость(ЛОЖЬ)
        видим = виджет.Видим()
        виджет.УстановитьВидимость(ИСТИНА)
        видим2 = виджет.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьДоступность(ЛОЖЬ)
        доступен = виджет.Доступен()
        виджет.УстановитьДоступность(ИСТИНА)
        доступен2 = виджет.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. СТИЛЬ (ИСПРАВЛЕННЫЙ) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьСтиль("background-color: lightblue;")
        стиль = виджет.Стиль()
        длина = стиль.length
        ВывестиСтрокуВКонсоль("    [RUS] Стиль установлен, длина: " + длина)
        Если длина > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка стиля работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Стиль пустой")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьПодсказку("Тестовая подсказка")
        подсказка = виджет.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тестовая подсказка')")
        Если подсказка == "Тестовая подсказка" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тестовая подсказка'")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ИМЯ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Имя объекта")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.УстановитьИмяОбъекта("ТестовыйВиджет")
        имя = виджет.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    [RUS] Имя объекта: '" + имя + "' (ожидается 'ТестовыйВиджет')")
        Если имя == "ТестовыйВиджет" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Имя объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'ТестовыйВиджет'")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПОКАЗАТЬ И СКРЫТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Показать и скрыть")
    СброситьЦветКонсоли()
    
    Попытка
        виджет.Скрыть()
        видим1 = виджет.Видим()
        виджет.Показать()
        видим2 = виджет.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] После скрытия: " + видим1 + ", после показа: " + видим2)
        Если видим1 == ЛОЖЬ И видим2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Показать/скрыть работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof виджет.RusFunc === 'function' Тогда
            jsonStr = виджет.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtВиджет завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

