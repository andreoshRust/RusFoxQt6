        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка видимости")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            радио.УстановитьВидимость(ЛОЖЬ)
            видимРус = радио.Видим()
            радио.УстановитьВидимость(ИСТИНА)
