    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        // Проверяем, что autoExclusive работает по умолчанию
        исключ = радио.autoExclusive()
        ВывестиСтрокуВКонсоль("    [ENG] autoExclusive по умолчанию: " + исключ + " (ожидается true)")
        
        Если исключ == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Группировка включена по умолчанию")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ [ENG] autoExclusive: " + исключ + " (не соответствует ожидаемому)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли
        
        // Проверяем русский метод
        Если тестПройден Тогда
            исключРус = радио.АвтоИсключительность()
            ВывестиСтрокуВКонсоль("    [RUS] АвтоИсключительность: " + исключРус + " (ожидается true)")
            Если исключРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Группировка работает")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("yellow")
                ВывестиСтрокуВКонсоль("    ⚠️ [RUS] АвтоИсключительность: " + исключРус)
                СброситьЦветКонсоли()
                неуспешноРус = неуспешноРус + 1
            КонецЕсли
        Иначе
