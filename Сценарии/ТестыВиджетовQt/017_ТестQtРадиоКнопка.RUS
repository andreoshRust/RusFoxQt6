    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        радио2 = Новый QtРадиоКнопка("Created with text")
        Если радио2 != null Тогда
            текст = радио2.text()
            ВывестиСтрокуВКонсоль("    [ENG] текст: '" + текст + "' (ожидается 'Created with text')")
            Если текст == "Created with text" Тогда
                УстановитьЦветКонсоли("green")
