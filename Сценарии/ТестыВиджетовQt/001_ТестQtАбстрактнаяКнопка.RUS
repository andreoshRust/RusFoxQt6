//✅ Тесты (10 из 10 успешны):
//✅ Создание объекта
//✅ Текст (setText/text, УстановитьТекст/Текст)
//✅ Состояние (setChecked/isChecked/toggle, УстановитьВыбрано/Выбрано/Переключить)
//✅ Автоповтор (setAutoRepeat/autoRepeat, УстановитьАвтоповтор/Автоповтор)
//✅ Шрифт (setFont/setFontSize, УстановитьШрифт/УстановитьРазмерШрифта)
//✅ Стиль (setStyleSheet/styleSheet, УстановитьСтиль/Стиль)
//✅ Валидность (isValid/Действителен)
//✅ Видимость (setVisible/isVisible, УстановитьВидимость/Видим)
//✅ Размеры (setFixedSize/width/height, УстановитьФиксированныйРазмер/Ширина/Высота)
//✅ RusFunc

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtАбстрактнаяКнопка
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtAbstractButton()
    ИмяКласса = "QtAbstractButton"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtAbstractButton !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtAbstractButton()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции


// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtАбстрактнаяКнопка
// ============================================================

Функция ДиагностикаМетаОбъектаAbstractButton()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtАбстрактнаяКнопка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtAbstractButton: " + (typeof QtAbstractButton !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtАбстрактнаяКнопка: " + (typeof QtАбстрактнаяКнопка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        кнопка1 = Новый QtКнопка()
        Если кнопка1 == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат 
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtКнопка()")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКнопка (наследник QtAbstractButton):")
    методы = Object.getOwnPropertyNames(кнопка1)
    прототип = Object.getPrototypeOf(кнопка1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof кнопка1[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof кнопка1.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = кнопка1.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtАбстрактнаяКнопка (через QtКнопка)
// ============================================================

Функция ТестQtAbstractButtonFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    кнопка = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        кнопка = Новый QtКнопка()
        Если кнопка == null Тогда
            кнопка = new QtPushButton()
        КонецЕсли
        
        Если кнопка != null Тогда
            кнопка.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtКнопка создана")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtКнопка НЕ создана")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если кнопка == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Кнопка не создана, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ТЕКСТ (ENG) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setText/text"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестТекст = "Test Button"
    тестТекст2 = "New Button"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setText(тестТекст)
        текст = кнопка.text()
        кнопка.setText(тестТекст2)
        текст2 = кнопка.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText: '" + текст + "' -> '" + текст2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == тестТекст И текст2 == тестТекст2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка текста")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьТекст(тестТекст)
            текстРус = кнопка.Текст()
            кнопка.УстановитьТекст(тестТекст2)
            текстРус2 = кнопка.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст: '" + текстРус + "' -> '" + текстРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == тестТекст И текстРус2 == тестТекст2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка текста")
            СброситьЦветКонсоли()
