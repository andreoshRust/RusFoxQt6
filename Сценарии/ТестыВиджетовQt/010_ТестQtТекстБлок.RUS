// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстБлок
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtTextBlock()
    ИмяКласса = "QtTextBlock"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtTextBlock !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtTextBlock()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtТекстБлок
// ============================================================

Функция ДиагностикаМетаОбъектаTextBlock()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстБлок ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextBlock: " + (typeof QtTextBlock !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtТекстБлок: " + (typeof QtТекстБлок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        // Создаем редактор для получения документа
        тестРедактор1 = Новый QtРедакторТекста()
        тестРедактор = тестРедактор1
        тестРедактор.УстановитьПростойТекст("Тест\nСтрока 2\nСтрока 3")
        документ = тестРедактор.Документ()
        
        // Пробуем создать через НовыйОбъект
        блок1 = Новый QtТекстБлок( документ, 0)
        блок = блок1
        Если блок == null Тогда
            // Если не получилось, пробуем через new
            блок2 = new QtTextBlock(документ, 0)
            блок = блок2
            Если блок == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtTextBlock()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстБлок:")
    методы = Object.getOwnPropertyNames(блок)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(блок)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof блок[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof блок.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = блок.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "Действителен", "НомерБлока", "Текст",
        "Выравнивание", "УстановитьВыравнивание"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof блок[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = Новый QtБазовыйТаймер()
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТекстБлок (русские и английские методы)
// ============================================================

Функция ТестQtTextBlockFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        тестРедактор = Новый QtРедакторТекста()
        тестРедактор.УстановитьПростойТекст("Строка 1\nСтрока 2\nСтрока 3")
        документ = тестРедактор.Документ()
        
        блок = Новый QtТекстБлок(документ, 0)
        Если блок != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстБлок создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстБлок НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если блок == null Тогда
        Возврат "❌ Тест QtТекстБлок провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        валидный = блок.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = блок.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
