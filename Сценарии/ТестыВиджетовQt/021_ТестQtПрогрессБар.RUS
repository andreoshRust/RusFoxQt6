//№    Тест    Описание
//1    Создание объекта    Проверка создания QtПрогрессБар
//2    Действительность    isValid/Действителен
//3    Значение    setValue/value, УстановитьЗначение/Значение
//4    Диапазон    setRange/minimum/maximum, УстановитьДиапазон/Минимум/Максимум
//5    Формат    setFormat/format, УстановитьФормат/Формат
//6    Видимость текста    setTextVisible/textVisible, УстановитьТекстВидим/ТекстВидим
//7    Выравнивание    setAlignment/alignment, УстановитьВыравнивание/Выравнивание
//8    Ориентация    setOrientation/orientation, УстановитьОриентацию/Ориентация
//9    Инвертированный вид    setInvertedAppearance/invertedAppearance, УстановитьИнвертированныйВид/ИнвертированныйВид
//10    Сброс    reset, Сбросить
//11    Доступность    setEnabled/isEnabled, УстановитьДоступность/Доступен
//12    Видимость    setVisible/isVisible, УстановитьВидимость/Видим
//13    Подсказка    setToolTip/toolTip, УстановитьПодсказку/Подсказка
//14    Стиль    setStyleSheet/styleSheet, УстановитьСтиль/Стиль

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПрогрессБар
// ============================================================

Функция ДиагностикаМетодовQtProgressBar()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПрогрессБар ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПрогрессБар: " + (typeof QtПрогрессБар !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПрогрессБар: " + e)
    КонецПопытки;
    
    Попытка
        диагПрогресс = НовыйОбъект("QtПрогрессБар")
        Если диагПрогресс == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПрогрессБар не создан")
            Возврат
        КонецЕсли;
        
        диагПрогресс.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПрогрессБар создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "value", "setValue", "reset",
            "minimum", "setMinimum", "maximum", "setMaximum", "setRange",
            "text", "format", "setFormat",
            "textVisible", "setTextVisible",
            "styleSheet", "setStyleSheet",
            "alignment", "setAlignment",
            "invertedAppearance", "setInvertedAppearance",
            "orientation", "setOrientation",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline", "setFontStrikeOut",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "Horizontal", "Vertical"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрогресс[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "Значение", "УстановитьЗначение", "Сбросить",
            "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум", "УстановитьДиапазон",
            "Текст", "Формат", "УстановитьФормат",
            "ТекстВидим", "УстановитьТекстВидим",
            "Стиль", "УстановитьСтиль",
            "Выравнивание", "УстановитьВыравнивание",
            "ИнвертированныйВид", "УстановитьИнвертированныйВид",
            "Ориентация", "УстановитьОриентацию",
            "Шрифт", "УстановитьШрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт", "УстановитьЗачеркнутыйШрифт",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "Что Это", "УстановитьЧто Это",
            "ЕстьФокус", "УстановитьФокус",
            "Горизонтальный", "Вертикальный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрогресс[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПрогресс.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПрогресс.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПрогрессБар: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtПрогрессБар
// ============================================================

Функция ДиагностикаМетаОбъектаProgressBar()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПрогрессБар ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtProgressBar: " + (typeof QtProgressBar !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПрогрессБар: " + (typeof QtПрогрессБар !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        прогресс = НовыйОбъект("QtПрогрессБар")
        Если прогресс == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПрогрессБар:")
    методы = Object.getOwnPropertyNames(прогресс)
    прототип = Object.getPrototypeOf(прогресс)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof прогресс[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof прогресс.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = прогресс.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "Значение", "УстановитьЗначение",
        "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум",
        "Формат", "УстановитьФормат",
        "ТекстВидим", "УстановитьТекстВидим",
        "Выравнивание", "УстановитьВыравнивание",
        "Ориентация", "УстановитьОриентацию",
        "ИнвертированныйВид", "УстановитьИнвертированныйВид",
        "Действителен", "Показать", "Скрыть"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof прогресс[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtПрогрессБар (QtProgressBar)
// ============================================================

Функция ТестQtProgressBarFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    прогресс = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        прогресс = НовыйОбъект("QtПрогрессБар")
        Если прогресс == null Тогда
            прогресс = new QtProgressBar()
        КонецЕсли
        
        Если прогресс != null Тогда
            прогресс.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПрогрессБар создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПрогрессБар НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если прогресс == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ ПрогрессБар не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = прогресс.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = прогресс.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. ЗНАЧЕНИЕ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setValue/value"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Значение")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗначение = 50
    тестЗначение2 = 75
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        прогресс.setRange(0, 100)
        прогресс.setValue(тестЗначение)
        значение = прогресс.value()
        прогресс.setValue(тестЗначение2)
        значение2 = прогресс.value()
        ВывестиСтрокуВКонсоль("    [ENG] setValue: " + значение + " -> " + значение2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
