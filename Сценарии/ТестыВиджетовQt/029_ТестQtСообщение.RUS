//✅ QtMessageBox (QtСообщение) - 10/10 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка текста    ✅
//3    Установка иконки    ✅
//4    Установка стандартных кнопок    ✅
//5    Информативный текст    ✅
//6    Константы    ✅
//7    Проверка валидности    ✅
//8    Имя объекта    ✅
//9    Подсказка    ✅
//10    Видимость    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtСообщение
// ============================================================

Функция ДиагностикаМетодовQtMessageBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtСообщение ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtСообщение: " + (typeof QtСообщение !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtСообщение: " + e)
    КонецПопытки;
    
    Попытка
        диагСообщение = НовыйОбъект("QtСообщение")
        Если диагСообщение == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtСообщение не создан")
            Возврат
        КонецЕсли;
        
        диагСообщение.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtСообщение создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setText", "text",
            "setInformativeText", "informativeText",
            "setDetailedText", "detailedText",
            "setIcon", "icon",
            "setIconPixmap", "iconPixmap",
            "setStandardButtons", "standardButtons",
            "setDefaultButton", "defaultButton",
            "setEscapeButton", "escapeButton",
            "addButton", "removeButton",
            "buttons", "button", "buttonRole", "standardButton",
            "setTextFormat", "textFormat",
            "setTextInteractionFlags", "textInteractionFlags",
            "information", "warning", "critical", "question",
            "NoIcon", "Information", "Warning", "Critical", "Question",
            "Ok", "Cancel", "Yes", "No",
            "Abort", "Retry", "Ignore", "Apply", "Reset", "Help",
            "InvalidRole", "AcceptRole", "RejectRole",
            "DestructiveRole", "ActionRole", "HelpRole", "YesRole", "NoRole",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСообщение[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьТекст", "Текст",
            "УстановитьИнформативныйТекст", "ИнформативныйТекст",
            "УстановитьПодробныйТекст", "ПодробныйТекст",
            "УстановитьИконку", "Иконка",
            "УстановитьКартинкуИконки", "КартинкаИконки",
            "УстановитьСтандартныеКнопки", "СтандартныеКнопки",
            "УстановитьКнопкуПоУмолчанию", "КнопкаПоУмолчанию",
            "УстановитьКнопкуEscape", "КнопкаEscape",
            "ДобавитьКнопку", "УдалитьКнопку",
            "Кнопки", "Кнопка", "РольКнопки", "СтандартнаяКнопка",
            "УстановитьФорматТекста", "ФорматТекста",
            "УстановитьФлагиВзаимодействия", "ФлагиВзаимодействия",
            "Информация", "Предупреждение", "Ошибка", "Вопрос",
            "БезИконки", "ИнформацияИконка", "ПредупреждениеИконка",
            "ОшибкаИконка", "ВопросИконка",
            "КнопкаOk", "КнопкаОтмена", "КнопкаДа", "КнопкаНет",
            "КнопкаПрервать", "КнопкаПовторить", "КнопкаИгнорировать",
            "КнопкаПрименить", "КнопкаСброс", "КнопкаПомощь",
            "РольНевалидная", "РольПринять", "РольОтклонить",
            "РольРазрушительная", "РольДействие", "РольПомощь",
            "РольДа", "РольНет",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСообщение[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСообщение.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСообщение.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtСообщение: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtСообщение
// ============================================================

Функция ТестQtMessageBox()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    сообщение = null
    Попытка
        сообщение = НовыйОбъект("QtСообщение")
        Если сообщение == null Тогда
            сообщение = new QtMessageBox()
        КонецЕсли
        
        Если сообщение != null Тогда
            сообщение.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtСообщение создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtСообщение НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если сообщение == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Сообщение не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setText/УстановитьТекст"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестТекст = "Тестовое сообщение"
    тестТекст2 = "Новое сообщение"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        сообщение.setText(тестТекст)
        текст = сообщение.text()
        сообщение.setText(тестТекст2)
        текст2 = сообщение.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText: '" + текст + "' -> '" + текст2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == тестТекст И текст2 == тестТекст2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка текста")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            сообщение.УстановитьТекст(тестТекст)
            текстРус = сообщение.Текст()
            сообщение.УстановитьТекст(тестТекст2)
            текстРус2 = сообщение.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст: '" + текстРус + "' -> '" + текстРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == тестТекст И текстРус2 == тестТекст2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка текста")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. УСТАНОВКА ИКОНКИ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setIcon/УстановитьИконку"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка иконки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        сообщение.setIcon(сообщение.Information())
        иконка = сообщение.icon()
        ВывестиСтрокуВКонсоль("    [ENG] setIcon(Information): " + иконка)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И иконка == сообщение.Information() Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Иконка работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка иконки")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            сообщение.УстановитьИконку(сообщение.ОшибкаИконка())
            иконкаРус = сообщение.Иконка()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьИконку(ОшибкаИконка): " + иконкаРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И иконкаРус == сообщение.ОшибкаИконка() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Иконка работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка иконки")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. УСТАНОВКА СТАНДАРТНЫХ КНОПОК =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setStandardButtons"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка стандартных кнопок")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопки = сообщение.Ok() | сообщение.Cancel()
        сообщение.setStandardButtons(кнопки)
        установленные = сообщение.standardButtons()
        ВывестиСтрокуВКонсоль("    [ENG] setStandardButtons(Ok|Cancel): " + установленные)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И установленные == (сообщение.Ok() | сообщение.Cancel()) Тогда
