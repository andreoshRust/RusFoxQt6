//№    Тест    Описание
//1    Создание объекта    Проверка создания QtВкладки
//2    Действительность    isValid/Действителен
//3    Добавление вкладок    addTab, ДобавитьВкладку
//4    Количество вкладок    count, КоличествоВкладок
//5    Текущая вкладка    currentIndex/setCurrentIndex, ТекущийИндекс/УстановитьТекущийИндекс
//6    Текст вкладки    setTabText/tabText, УстановитьТекстВкладки/ТекстВкладки
//7    Вставка вкладки    insertTab, ВставитьВкладку
//8    Удаление вкладки    removeTab, УдалитьВкладку
//9    Видимость вкладки    setTabVisible/isTabVisible, УстановитьВидимостьВкладки/ВкладкаВидима
//10    Закрываемость вкладок    setTabsClosable/tabsClosable, УстановитьЗакрываемостьВкладок/ВкладкиЗакрываемы
//11    Перемещаемость вкладок    setMovable/isMovable, УстановитьПеремещаемость/Перемещаемы
//12    Положение вкладок    setTabPosition/tabPosition, УстановитьПоложениеВкладок/ПоложениеВкладок
//13    Форма вкладок    setTabShape/tabShape, УстановитьФормуВкладок/ФормаВкладок
//14    Очистка    clear, Очистить
//Особенности виджета вкладок:
//Поддерживает добавление, вставку и удаление вкладок
//Каждая вкладка может содержать любой виджет
//Настраиваемое положение вкладок (сверху, снизу, слева, справа)
//Настраиваемая форма вкладок (закругленные, треугольные)
//Поддержка закрытия вкладок с помощью кнопки
//Поддержка перетаскивания вкладок для изменения порядка
//Сигналы для отслеживания изменений

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВкладки
// ============================================================

Функция ДиагностикаМетодовQtTabWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВкладки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtВкладки: " + (typeof QtВкладки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtВкладки: " + e)
    КонецПопытки;
    
    Попытка
        диагВкладки = НовыйОбъект("QtВкладки")
        Если диагВкладки == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВкладки не создан")
            Возврат
        КонецЕсли;
        
        диагВкладки.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtВкладки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "addTab", "insertTab", "removeTab", "clear", "count",
            "currentIndex", "setCurrentIndex", "currentWidget", "setCurrentWidget",
            "tabText", "setTabText", "tabIcon", "setTabIcon",
            "isTabVisible", "setTabVisible",
            "tabsClosable", "setTabsClosable",
            "isMovable", "setMovable",
            "tabPosition", "setTabPosition",
            "tabShape", "setTabShape",
            "widget", "indexOf",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "North", "South", "West", "East",
            "Rounded", "Triangular"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВкладки[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "ДобавитьВкладку", "ДобавитьВкладкуСИконкой",
            "ВставитьВкладку", "ВставитьВкладкуСИконкой",
            "УдалитьВкладку", "Очистить", "КоличествоВкладок",
            "ТекущийИндекс", "УстановитьТекущийИндекс",
            "ТекущийВиджет", "УстановитьТекущийВиджет",
            "ТекстВкладки", "УстановитьТекстВкладки",
            "ИконкаВкладки", "УстановитьИконкуВкладки",
            "ВкладкаВидима", "УстановитьВидимостьВкладки",
            "ВкладкиЗакрываемы", "УстановитьЗакрываемостьВкладок",
            "Перемещаемы", "УстановитьПеремещаемость",
            "ПоложениеВкладок", "УстановитьПоложениеВкладок",
            "ФормаВкладок", "УстановитьФормуВкладок",
            "ВиджетВкладки", "ИндексВкладки",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "Что Это", "УстановитьЧто Это",
            "ЕстьФокус", "УстановитьФокус",
            "Сверху", "Снизу", "Слева", "Справа",
            "Закругленные", "Треугольные"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВкладки[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагВкладки.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагВкладки.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВкладки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtВкладки
// ============================================================

Функция ДиагностикаМетаОбъектаTabWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВкладки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTabWidget: " + (typeof QtTabWidget !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtВкладки: " + (typeof QtВкладки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        вкладки = НовыйОбъект("QtВкладки")
        Если вкладки == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtВкладки:")
    методы = Object.getOwnPropertyNames(вкладки)
    прототип = Object.getPrototypeOf(вкладки)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof вкладки[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof вкладки.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = вкладки.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "ДобавитьВкладку", "КоличествоВкладок",
        "ТекущийИндекс", "УстановитьТекущийИндекс",
        "ТекстВкладки", "УстановитьТекстВкладки",
        "УдалитьВкладку", "Очистить",
        "Действителен", "Показать", "Скрыть"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof вкладки[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtВкладки (QtTabWidget) - ИСПРАВЛЕННЫЙ (ВСЕ 14 ТЕСТОВ)
// ============================================================

Функция ТестQtTabWidgetFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    вкладки = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        вкладки = НовыйОбъект("QtВкладки")
        Если вкладки == null Тогда
            вкладки = new QtTabWidget()
        КонецЕсли
        
        Если вкладки != null Тогда
            вкладки.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВкладки создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВкладки НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если вкладки == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ TabWidget не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    валид = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = вкладки.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = вкладки.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. ДОБАВЛЕНИЕ ВКЛАДОК =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "addTab/ДобавитьВкладку"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Добавление вкладок")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
