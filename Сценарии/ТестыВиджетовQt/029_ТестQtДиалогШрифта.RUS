//✅ QtFontDialog (QtДиалогШрифта) - 10/10 тестов пройдено
//№    Тест    Описание
//1    Создание объекта    Проверка создания QtДиалогШрифта
//2    Установка заголовка    setWindowTitle/УстановитьЗаголовок
//3    Статический метод getFont    getFont/ВыбратьШрифт
//4    Установка опций    setOptions/УстановитьОпции
//5    Константы    NoButtons, ScalableFonts, MonospacedFonts
//6    Валидность    isValid/Действителен
//7    Имя объекта    setObjectName/УстановитьИмяОбъекта
//8    Подсказка    setToolTip/УстановитьПодсказку
//9    Видимость    setVisible/УстановитьВидимость
//10    Установка текущего шрифта    setCurrentFont/УстановитьТекущийШрифт

// ============================================================
// ГЛОБАЛЬНАЯ ПЕРЕМЕННАЯ РЕЖИМА ОТЛАДКИ
// ============================================================

Пусть Режим_Отладки = ИСТИНА

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДиалогШрифта
// ============================================================

Функция ДиагностикаМетодовQtFontDialog()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДиалогШрифта ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДиалогШрифта: " + (typeof QtДиалогШрифта !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДиалогШрифта: " + e)
    КонецПопытки;
    
    Попытка
        диагДиалогШрифта = НовыйОбъект("QtДиалогШрифта")
        Если диагДиалогШрифта == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДиалогШрифта не создан")
            Возврат
        КонецЕсли;
        
        диагДиалогШрифта.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtДиалогШрифта создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setCurrentFont", "currentFont", "selectedFont",
            "setOptions", "options",
            "getFont",
            "NoButtons", "DontUseNativeDialog",
            "ScalableFonts", "NonScalableFonts",
            "MonospacedFonts", "ProportionalFonts",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалогШрифта[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьТекущийШрифт", "ТекущийШрифт", "ВыбранныйШрифт",
            "УстановитьОпции", "Опции",
            "ВыбратьШрифт",
            "БезКнопок", "НеИспользоватьНативныйДиалог",
            "МасштабируемыеШрифты", "НемасштабируемыеШрифты",
            "МоноширинныеШрифты", "ПропорциональныеШрифты",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалогШрифта[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДиалогШрифта.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДиалогШрифта.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДиалогШрифта: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДиалогШрифта (исправленная)
// ============================================================

Функция ТестQtFontDialog()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    тестДиалогШрифта = null
    Попытка
        тестДиалогШрифта = НовыйОбъект("QtДиалогШрифта")
        Если тестДиалогШрифта == null Тогда
            тестДиалогШрифта = new QtFontDialog()
        КонецЕсли
        
        Если тестДиалогШрифта != null Тогда
            тестДиалогШрифта.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДиалогШрифта создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДиалогШрифта НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если тестДиалогШрифта == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Диалог не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setWindowTitle/УстановитьЗаголовок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка заголовка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗаголовок1 = "Выбор шрифта"
    тестЗаголовок2 = "Новый заголовок"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДиалогШрифта.setWindowTitle(тестЗаголовок1)
        заголовокАнгл = тестДиалогШрифта.windowTitle()
        тестДиалогШрифта.setWindowTitle(тестЗаголовок2)
        заголовокАнгл2 = тестДиалогШрифта.windowTitle()
        ВывестиСтрокуВКонсоль("    [ENG] setWindowTitle: '" + заголовокАнгл + "' -> '" + заголовокАнгл2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И заголовокАнгл == тестЗаголовок1 И заголовокАнгл2 == тестЗаголовок2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Заголовок работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка заголовка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестДиалогШрифта.УстановитьЗаголовок(тестЗаголовок1)
            заголовокРус = тестДиалогШрифта.Заголовок()
            тестДиалогШрифта.УстановитьЗаголовок(тестЗаголовок2)
            заголовокРус2 = тестДиалогШрифта.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок: '" + заголовокРус + "' -> '" + заголовокРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И заголовокРус == тестЗаголовок1 И заголовокРус2 == тестЗаголовок2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка заголовка")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. СТАТИЧЕСКИЙ МЕТОД getFont =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "getFont/ВыбратьШрифт"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Статический метод выбора шрифта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        Если typeof тестДиалогШрифта.getFont === 'function' Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getFont() метод существует")
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getFont() метод НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            Если typeof тестДиалогШрифта.ВыбратьШрифт === 'function' Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ВыбратьШрифт() метод существует")
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ВыбратьШрифт() метод НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
                неуспешноРус = неуспешноРус + 1
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. УСТАНОВКА ОПЦИЙ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setOptions/УстановитьОпции"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка опций")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДиалогШрифта.setOptions(тестДиалогШрифта.NoButtons())
        опцииАнгл = тестДиалогШрифта.options()
        ВывестиСтрокуВКонсоль("    [ENG] setOptions(NoButtons): " + опцииАнгл)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И опцииАнгл == тестДиалогШрифта.NoButtons() Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Опции работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка опций")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестДиалогШрифта.УстановитьОпции(тестДиалогШрифта.НеИспользоватьНативныйДиалог())
            опцииРус = тестДиалогШрифта.Опции()
