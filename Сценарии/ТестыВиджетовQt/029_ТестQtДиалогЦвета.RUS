//✅ QtColorDialog (QtДиалогЦвета) - 10/10 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка заголовка    ✅
//3    Статический метод выбора цвета    ✅
//4    Установка опций    ✅
//5    Статический метод выбора цвета    ✅
//6    Константы    ✅
//7    Проверка валидности    ✅
//8    Имя объекта    ✅
//9    Подсказка    ✅
//10    Видимость    ✅



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДиалогЦвета
// ============================================================

Функция ДиагностикаМетодовQtColorDialog()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДиалогЦвета ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДиалогЦвета: " + (typeof QtДиалогЦвета !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДиалогЦвета: " + e)
    КонецПопытки;
    
    Попытка
        диагДиалог = НовыйОбъект("QtДиалогЦвета")
        Если диагДиалог == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДиалогЦвета не создан")
            Возврат
        КонецЕсли;
        
        диагДиалог.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДиалогЦвета создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setCurrentColor", "currentColor", "selectedColor",
            "setOptions", "options",
            "getColor", "getColorRgba",
            "ShowAlphaChannel", "NoButtons", "DontUseNativeDialog",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьТекущийЦвет", "ТекущийЦвет", "ВыбранныйЦвет",
            "УстановитьОпции", "Опции",
            "ВыбратьЦвет", "ВыбратьЦветRGBA",
            "ПоказыватьАльфаКанал", "БезКнопок", "НеИспользоватьНативныйДиалог",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДиалог.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДиалог.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДиалогЦвета: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДиалогЦвета
// ============================================================

Функция ТестQtColorDialog()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    диалог = null
    Попытка
        диалог = НовыйОбъект("QtДиалогЦвета")
        Если диалог == null Тогда
            диалог = new QtColorDialog()
        КонецЕсли
        
        Если диалог != null Тогда
            диалог.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДиалогЦвета создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДиалогЦвета НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если диалог == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Диалог не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setWindowTitle/УстановитьЗаголовок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка заголовка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗаголовок = "Выбор цвета"
    тестЗаголовок2 = "Новый заголовок"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setWindowTitle(тестЗаголовок)
        заголовок = диалог.windowTitle()
        диалог.setWindowTitle(тестЗаголовок2)
        заголовок2 = диалог.windowTitle()
        ВывестиСтрокуВКонсоль("    [ENG] setWindowTitle: '" + заголовок + "' -> '" + заголовок2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И заголовок == тестЗаголовок И заголовок2 == тестЗаголовок2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Заголовок работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка заголовка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьЗаголовок(тестЗаголовок)
            заголовокРус = диалог.Заголовок()
            диалог.УстановитьЗаголовок(тестЗаголовок2)
            заголовокРус2 = диалог.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок: '" + заголовокРус + "' -> '" + заголовокРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И заголовокРус == тестЗаголовок И заголовокРус2 == тестЗаголовок2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка заголовка")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
// ===== 5. СТАТИЧЕСКИЙ МЕТОД getColor (исправленный) =====
всегоТестов = всегоТестов + 1
названияТестов[названияТестов.length] = "getColor/ВыбратьЦвет"
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Статический метод выбора цвета")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// --- АНГЛИЙСКИЙ ---
Попытка
    // Проверяем существование метода
    Если typeof диалог.getColor === 'function' Тогда
        ВывестиСтрокуВКонсоль("    [ENG] getColor() метод существует")
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] getColor() метод НЕ СУЩЕСТВУЕТ")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки

// --- РУССКИЙ ---
Если тестПройден Тогда
    Попытка
        Если typeof диалог.ВыбратьЦвет === 'function' Тогда
            ВывестиСтрокуВКонсоль("    [RUS] ВыбратьЦвет() метод существует")
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] ВыбратьЦвет() метод НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    неуспешноРус = неуспешноРус + 1
КонецЕсли

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. УСТАНОВКА ОПЦИЙ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setOptions/УстановитьОпции"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка опций")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setOptions(диалог.ShowAlphaChannel())
        опции = диалог.options()
        ВывестиСтрокуВКонсоль("    [ENG] setOptions(ShowAlphaChannel): " + опции)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И опции == диалог.ShowAlphaChannel() Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Опции работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка опций")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьОпции(диалог.БезКнопок())
            опцииРус = диалог.Опции()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьОпции(БезКнопок): " + опцииРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И опцииРус == диалог.БезКнопок() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Опции работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка опций")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
