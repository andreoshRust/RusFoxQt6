//✅ QtColorDialog (QtДиалогЦвета) - 10/10 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка заголовка    ✅
//3    Установка опций    ✅
//4    Статический метод выбора цвета    ✅
//5    Константы    ✅
//6    Проверка валидности    ✅
//7    Имя объекта    ✅
//8    Подсказка    ✅
//9    Видимость    ✅

// ============================================================
// ГЛОБАЛЬНАЯ ПЕРЕМЕННАЯ РЕЖИМА ОТЛАДКИ
// ============================================================

Пусть Режим_Отладки = ИСТИНА

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДиалогЦвета
// ============================================================

Функция ДиагностикаМетодовQtColorDialog()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДиалогЦвета ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДиалогЦвета: " + (typeof QtДиалогЦвета !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДиалогЦвета: " + e)
    КонецПопытки;
    
    Попытка
        диагДиалогЦвета = НовыйОбъект("QtДиалогЦвета")
        Если диагДиалогЦвета == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДиалогЦвета не создан")
            Возврат
        КонецЕсли;
        
        диагДиалогЦвета.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtДиалогЦвета создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setCurrentColor", "currentColor", "selectedColor",
            "setOptions", "options",
            "getColor", "getColorRgba",
            "ShowAlphaChannel", "NoButtons", "DontUseNativeDialog",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалогЦвета[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьТекущийЦвет", "ТекущийЦвет", "ВыбранныйЦвет",
            "УстановитьОпции", "Опции",
            "ВыбратьЦвет", "ВыбратьЦветRGBA",
            "ПоказыватьАльфаКанал", "БезКнопок", "НеИспользоватьНативныйДиалог",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалогЦвета[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДиалогЦвета.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДиалогЦвета.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДиалогЦвета: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДиалогЦвета (исправленная)
// ============================================================

Функция ТестQtColorDialog()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    тестДиалогЦвета = null
    Попытка
        тестДиалогЦвета = НовыйОбъект("QtДиалогЦвета")
        Если тестДиалогЦвета == null Тогда
            тестДиалогЦвета = new QtColorDialog()
        КонецЕсли
        
        Если тестДиалогЦвета != null Тогда
            тестДиалогЦвета.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДиалогЦвета создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДиалогЦвета НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если тестДиалогЦвета == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Диалог не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setWindowTitle/УстановитьЗаголовок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка заголовка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗаголовок1 = "Выбор цвета"
    тестЗаголовок2 = "Новый заголовок"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДиалогЦвета.setWindowTitle(тестЗаголовок1)
        заголовокАнгл = тестДиалогЦвета.windowTitle()
        тестДиалогЦвета.setWindowTitle(тестЗаголовок2)
        заголовокАнгл2 = тестДиалогЦвета.windowTitle()
        ВывестиСтрокуВКонсоль("    [ENG] setWindowTitle: '" + заголовокАнгл + "' -> '" + заголовокАнгл2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И заголовокАнгл == тестЗаголовок1 И заголовокАнгл2 == тестЗаголовок2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Заголовок работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка заголовка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестДиалогЦвета.УстановитьЗаголовок(тестЗаголовок1)
            заголовокРус = тестДиалогЦвета.Заголовок()
            тестДиалогЦвета.УстановитьЗаголовок(тестЗаголовок2)
            заголовокРус2 = тестДиалогЦвета.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок: '" + заголовокРус + "' -> '" + заголовокРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И заголовокРус == тестЗаголовок1 И заголовокРус2 == тестЗаголовок2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка заголовка")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. УСТАНОВКА ОПЦИЙ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setOptions/УстановитьОпции"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка опций")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДиалогЦвета.setOptions(тестДиалогЦвета.ShowAlphaChannel())
        опцииАнгл = тестДиалогЦвета.options()
        ВывестиСтрокуВКонсоль("    [ENG] setOptions(ShowAlphaChannel): " + опцииАнгл)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И опцииАнгл == тестДиалогЦвета.ShowAlphaChannel() Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Опции работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка опций")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестДиалогЦвета.УстановитьОпции(тестДиалогЦвета.БезКнопок())
            опцииРус = тестДиалогЦвета.Опции()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьОпции(БезКнопок): " + опцииРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И опцииРус == тестДиалогЦвета.БезКнопок() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Опции работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка опций")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. СТАТИЧЕСКИЙ МЕТОД getColor =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "getColor/ВыбратьЦвет"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Статический метод выбора цвета")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        Если typeof тестДиалогЦвета.getColor === 'function' Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getColor() метод существует")
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getColor() метод НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            Если typeof тестДиалогЦвета.ВыбратьЦвет === 'function' Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ВыбратьЦвет() метод существует")
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ВыбратьЦвет() метод НЕ СУЩЕСТВУЕТ")
