// ============================================================
// РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица (QtTextTable)
// ============================================================

Функция ТестРеальнойРаботыQtTextTable()
    ВывестиСтрокуВКонсоль("=== РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица ===")
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ДОКУМЕНТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание документа")
    СброситьЦветКонсоли()
    
    документ = null
    Попытка
        документ = Новый QtТекстовыйДокумент()
        Если документ != null Тогда
            документ.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Документ создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Документ НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если документ == null Тогда
        Возврат "❌ Реальный тест провален (документ не создан)"
    КонецЕсли
    
    // ===== 2. ПОЛУЧЕНИЕ РЕАЛЬНОГО КУРСОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Получение реального курсора")
    СброситьЦветКонсоли()
    
    реальныйКурсор = null
    Попытка
        реальныйКурсор = документ.ПолучитьКурсор()
        Если реальныйКурсор != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Реальный курсор получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Реальный курсор НЕ получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если реальныйКурсор == null Тогда
        Возврат "❌ Реальный тест провален (реальный курсор не получен)"
    КонецЕсли
    
    // ===== 3. СОЗДАНИЕ ОБЕРТКИ КУРСОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Создание обертки курсора")
    СброситьЦветКонсоли()
    
    курсорОбертка = null
    Попытка
        курсорОбертка = Новый QtТекстовыйКурсор(реальныйКурсор)
        Если курсорОбертка != null Тогда
            курсорОбертка.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Обертка курсора создана")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Обертка курсора НЕ создана")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если курсорОбертка == null Тогда
        Возврат "❌ Реальный тест провален (обертка курсора не создана)"
    КонецЕсли
    
    // ===== 4. СОЗДАНИЕ ТАБЛИЦЫ (ИСПРАВЛЕННЫЙ) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Создание таблицы")
    СброситьЦветКонсоли()
    
    таблица = null
    Попытка
        // 1. Создаём объект таблицы
        таблица = Новый QtТекстТаблица()
        
        Если таблица != null Тогда
            таблица.РежимОтладки(ИСТИНА)
            
            // 2. Устанавливаем курсор-обёртку
            таблица.УстановитьКурсор(курсорОбертка)
            
            // 3. Вставляем таблицу через русский метод
            таблица.ВставитьТаблицу(3, 3)
            
            // 4. Проверяем валидность
            Если таблица.isValid() Тогда
                стр = таблица.Строк()
                кол = таблица.Колонок()
                ВывестиСтрокуВКонсоль("    [RUS] Размер таблицы: " + стр + "x" + кол)
                
                Если стр == 3 И кол == 3 Тогда
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Таблица валидна, размер " + стр + "x" + кол)
                    СброситьЦветКонсоли()
                    успешноТестов = успешноТестов + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Неправильный размер: " + стр + "x" + кол)
                    СброситьЦветКонсоли()
                    Возврат "❌ Реальный тест провален (неправильный размер)"
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Таблица НЕ валидна")
                СброситьЦветКонсоли()
                Возврат "❌ Реальный тест провален (таблица не валидна)"
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Таблица НЕ создана")
            СброситьЦветКонсоли()
            Возврат "❌ Реальный тест провален (таблица не создана)"
        КонецЕсли
        
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Реальный тест провален (ошибка создания таблицы)"
    КонецПопытки
    
    // ===== 5. УСТАНОВКА ТЕКСТА В ЯЧЕЙКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Установка текста в ячейки")
    СброситьЦветКонсоли()
    
    Попытка
        таблица.УстановитьТекстЯчейки(0, 0, "Ячейка 1,1")
        таблица.УстановитьТекстЯчейки(0, 1, "Ячейка 1,2")
        таблица.УстановитьТекстЯчейки(0, 2, "Ячейка 1,3")
        таблица.УстановитьТекстЯчейки(1, 0, "Ячейка 2,1")
        таблица.УстановитьТекстЯчейки(1, 1, "Ячейка 2,2")
        таблица.УстановитьТекстЯчейки(1, 2, "Ячейка 2,3")
        таблица.УстановитьТекстЯчейки(2, 0, "Ячейка 3,1")
        таблица.УстановитьТекстЯчейки(2, 1, "Ячейка 3,2")
        таблица.УстановитьТекстЯчейки(2, 2, "Ячейка 3,3")
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст установлен во все ячейки")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== 6. ЧТЕНИЕ ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Чтение текста из ячейки")
    СброситьЦветКонсоли()
    
    Попытка
        текст = таблица.ТекстЯчейки(0, 0)
        ВывестиСтрокуВКонсоль("    [RUS] Текст ячейки (0,0): '" + текст + "' (ожидается 'Ячейка 1,1')")
        Если текст == "Ячейка 1,1" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Чтение текста работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Ячейка 1,1'")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== 7. ПРОВЕРКА РАЗМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка размера таблицы")
    СброситьЦветКонсоли()
    
    Попытка
        строк = таблица.Строк()
        колонок = таблица.Колонок()
        ВывестиСтрокуВКонсоль("    [RUS] Размер: " + строк + "x" + колонок + " (ожидается 3x3)")
        Если строк == 3 И колонок == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Размер таблицы корректный")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3x3")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                   РЕЗУЛЬТАТЫ РЕАЛЬНОГО ТЕСТА                                │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                      │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                   │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Реальный тест QtТекстТаблица завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 3.0 Тогда 
        ПоказатьСообщение("Данный сценарий работает с версии 3.0. Ваша версия: " + НомерВерсииПрограммы)
        Возврат    
    КонецЕсли
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtТекстТаблица (QtTextTable)                       ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Диагностика
    ДиагностикаМетодовQtTextTable()
    ДиагностикаМетаОбъектаTextTable()
    
    // Стандартный тест
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстТаблица (русские и английские методы)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextTableFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстТаблица: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Реальный тест с документом
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица (с QtТекстовыйДокумент)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = ТестРеальнойРаботыQtTextTable()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в реальном тесте: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Завершение
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ
