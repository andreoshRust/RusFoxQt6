            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 1, затем 0")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 7. РЕЖИМ ЗАВЕРШЕНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Режим завершения")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setCompletionMode(0) // PopupCompletion
        режим = завершающий.completionMode()
        завершающий.setCompletionMode(1) // UnfilteredPopupCompletion
        режим2 = завершающий.completionMode()
        ВывестиСтрокуВКонсоль("    [ENG] setCompletionMode: " + режим + " -> " + режим2)
    Исключение
