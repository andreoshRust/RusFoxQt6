            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 6. РЕГИСТР =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Чувствительность к регистру")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setCaseSensitivity(0) // CaseInsensitive
        чувствительность = завершающий.caseSensitivity()
        завершающий.setCaseSensitivity(1) // CaseSensitive
        чувствительность2 = завершающий.caseSensitivity()
        ВывестиСтрокуВКонсоль("    [ENG] setCaseSensitivity: " + чувствительность + " -> " + чувствительность2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И чувствительность == 0 И чувствительность2 == 1 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Регистр работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 0, затем 1")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            завершающий.УстановитьРегистр(1) // CaseSensitive
            чувствительностьРус = завершающий.Регистр()
            завершающий.УстановитьРегистр(0) // CaseInsensitive
            чувствительностьРус2 = завершающий.Регистр()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьРегистр: " + чувствительностьРус + " -> " + чувствительностьРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
