        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            завершающий.УстановитьРежимЗавершения(1) // UnfilteredPopupCompletion
            режимРус = завершающий.РежимЗавершения()
            завершающий.УстановитьРежимЗавершения(0) // PopupCompletion
            режимРус2 = завершающий.РежимЗавершения()
