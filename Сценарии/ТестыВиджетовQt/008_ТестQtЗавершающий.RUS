//Тест проверяет 12 основных функций QtCompleter:
//================================================
//Создание объекта - проверка создания QtЗавершающий
//Установка списка строк - setStringList/stringList, УстановитьСписокСтрок/СписокСтрок
//Установка префикса - setCompletionPrefix/completionPrefix, УстановитьПрефикс/Префикс
//Получение списка завершений - completions/completionCount, СписокЗавершений/КоличествоЗавершений
//Количество завершений для префикса - completionCountForPrefix, КоличествоЗавершенийДляПрефикса
//Чувствительность к регистру - setCaseSensitivity/caseSensitivity, УстановитьРегистр/Регистр
//Режим завершения - setCompletionMode/completionMode, УстановитьРежимЗавершения/РежимЗавершения
//Максимум видимых - setMaxVisibleItems/maxVisibleItems, УстановитьМаксимумВидимых/МаксимумВидимых
//Циклический режим - setWrapAround/wrapAround, УстановитьЦиклический/Циклический
//Колонка - setCompletionColumn/completionColumn, УстановитьКолонку/Колонка
//Роль - setCompletionRole/completionRole, УстановитьРоль/Роль
//Текущее завершение - currentCompletion, ТекущееЗавершение



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЗавершающий
// ============================================================

Функция ДиагностикаМетодовQtCompleter()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЗавершающий ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtЗавершающий: " + (typeof QtЗавершающий !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЗавершающий: " + e)
    КонецПопытки;
    
    Попытка
        диагЗавершающий = Новый QtЗавершающий()
        Если диагЗавершающий == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЗавершающий не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtЗавершающий создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setModel", "setStringList", "stringList",
            "setCompletionPrefix", "completionPrefix",
            "setCompletionColumn", "completionColumn",
            "setCompletionRole", "completionRole",
            "model", "currentCompletion", "completions",
            "completionCount", "completionCountForPrefix",
            "setCaseSensitivity", "caseSensitivity",
            "setFilterMode", "filterMode",
            "setCompletionMode", "completionMode",
            "setMaxVisibleItems", "maxVisibleItems",
            "setWrapAround", "wrapAround",
            "setWidget", "widget",
            "complete", "completeRect"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагЗавершающий[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьМодель", "УстановитьСписокСтрок", "СписокСтрок",
            "УстановитьПрефикс", "Префикс",
            "УстановитьКолонку", "Колонка",
            "УстановитьРоль", "Роль",
            "Модель", "ТекущееЗавершение", "СписокЗавершений",
            "КоличествоЗавершений", "КоличествоЗавершенийДляПрефикса",
            "УстановитьРегистр", "Регистр",
            "УстановитьРежимФильтра", "РежимФильтра",
            "УстановитьРежимЗавершения", "РежимЗавершения",
            "УстановитьМаксимумВидимых", "МаксимумВидимых",
            "УстановитьЦиклический", "Циклический",
            "УстановитьВиджет", "Виджет",
            "Завершить", "ЗавершитьВОбласти"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагЗавершающий[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагЗавершающий.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагЗавершающий.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЗавершающий: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЗавершающий
// ============================================================

Функция ДиагностикаМетаОбъектаCompleter()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЗавершающий ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtCompleter: " + (typeof QtCompleter !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЗавершающий: " + (typeof QtЗавершающий !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        завершающий = НовыйОбъект("QtЗавершающий")
        Если завершающий == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            завершающий = new QtCompleter()
            Если завершающий == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtCompleter()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtCompleter()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЗавершающий:")
    методы = Object.getOwnPropertyNames(завершающий)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(завершающий)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof завершающий[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof завершающий.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = завершающий.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьСписокСтрок", "СписокСтрок",
        "УстановитьПрефикс", "Префикс",
        "КоличествоЗавершений"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof завершающий[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = НовыйОбъект("QtБазовыйТаймер")
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtЗавершающий (русские и английские методы)
// ============================================================
Функция ТестQtCompleterFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        завершающий = Новый QtЗавершающий()
        Если завершающий != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЗавершающий создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЗавершающий НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если завершающий == null Тогда
        Возврат "❌ Тест QtЗавершающий провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА СПИСКА СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка списка строк")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    тестСписок = ["Яблоко", "Банан", "Апельсин", "Груша", "Киви"]
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setStringList(тестСписок)
        список = завершающий.stringList()
        размер = список.length
        ВывестиСтрокуВКонсоль("    [ENG] setStringList: размер=" + размер + " (ожидается 5)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И размер == 5 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка списка работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 5, получено " + размер)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            тестСписокРус = ["Один", "Два", "Три", "Четыре"]
            завершающий.УстановитьСписокСтрок(тестСписокРус)
            списокРус = завершающий.СписокСтрок()
            размерРус = списокРус.length
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСписокСтрок: размер=" + размерРус + " (ожидается 4)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И размерРус == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка списка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 4, получено " + размерРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. УСТАНОВКА ПРЕФИКСА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка префикса")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    тестПрефикс = "Ап"
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setCompletionPrefix(тестПрефикс)
        префикс = завершающий.completionPrefix()
        ВывестиСтрокуВКонсоль("    [ENG] setCompletionPrefix: '" + префикс + "' (ожидается '" + тестПрефикс + "')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И префикс == тестПрефикс Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Префикс работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается '" + тестПрефикс + "', получено '" + префикс + "'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            тестПрефиксРус = "Ба"
            завершающий.УстановитьПрефикс(тестПрефиксРус)
            префиксРус = завершающий.Префикс()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПрефикс: '" + префиксРус + "' (ожидается '" + тестПрефиксРус + "')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И префиксРус == тестПрефиксРус Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Префикс работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается '" + тестПрефиксРус + "', получено '" + префиксРус + "'")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

  // ===== 4. ПОЛУЧЕНИЕ СПИСКА ЗАВЕРШЕНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Получение списка завершений")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setStringList(["Яблоко", "Апельсин", "Арбуз", "Банан", "Груша"])
        завершающий.setCompletionPrefix("А")
        списокЗавершений = завершающий.completions()
        количество = завершающий.completionCount()
        ВывестиСтрокуВКонсоль("    [ENG] completions: " + списокЗавершений.join(", ") + " (count=" + количество + ")")
        
        // Проверяем, что список содержит ожидаемые элементы
        содержитАпельсин = списокЗавершений.indexOf("Апельсин") !== -1
        содержитАрбуз = списокЗавершений.indexOf("Арбуз") !== -1
        содержитЯблоко = списокЗавершений.indexOf("Яблоко") !== -1
        
        Если содержитАпельсин ИЛИ содержитАрбуз ИЛИ содержитЯблоко Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Список завершений работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: список не содержит ожидаемых элементов")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            завершающий.УстановитьСписокСтрок(["Яблоко", "Апельсин", "Арбуз", "Банан", "Груша"])
            завершающий.УстановитьПрефикс("А")
            списокЗавершенийРус = завершающий.СписокЗавершений()
            количествоРус = завершающий.КоличествоЗавершений()
            ВывестиСтрокуВКонсоль("    [RUS] СписокЗавершений: " + списокЗавершенийРус.join(", ") + " (count=" + количествоРус + ")")
            
            содержитАпельсинРус = списокЗавершенийРус.indexOf("Апельсин") !== -1
            содержитАрбузРус = списокЗавершенийРус.indexOf("Арбуз") !== -1
            содержитЯблокоРус = списокЗавершенийРус.indexOf("Яблоко") !== -1
            
            Если содержитАпельсинРус ИЛИ содержитАрбузРус ИЛИ содержитЯблокоРус Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Список завершений работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: список не содержит ожидаемых элементов")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 5. КОЛИЧЕСТВО ЗАВЕРШЕНИЙ ДЛЯ ПРЕФИКСА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Количество завершений для префикса")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        завершающий.setStringList(["Один", "Два", "Двенадцать", "Три", "Четыре"])
        количество = завершающий.completionCountForPrefix("Д")
        ВывестиСтрокуВКонсоль("    [ENG] completionCountForPrefix('Д'): " + количество + " (ожидается 2)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И количество == 2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Количество для префикса работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 2, получено " + количество)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            завершающий.УстановитьСписокСтрок(["Один", "Два", "Двенадцать", "Три", "Четыре"])
            количествоРус = завершающий.КоличествоЗавершенийДляПрефикса("Д")
            ВывестиСтрокуВКонсоль("    [RUS] КоличествоЗавершенийДляПрефикса('Д'): " + количествоРус + " (ожидается 2)")
