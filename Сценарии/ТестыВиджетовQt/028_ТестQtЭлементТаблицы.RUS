Функция ДиагностикаМетодовQtTableWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТаблицаВиджет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТаблицаВиджет: " + (typeof QtТаблицаВиджет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТаблицаВиджет: " + e)
    КонецПопытки;
    
    Попытка
        диагТаблица = Новый QtТаблицаВиджет()
        Если диагТаблица == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТаблицаВиджет не создан")
            Возврат
        КонецЕсли;
        
        диагТаблица.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtТаблицаВиджет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setRowCount", "rowCount", "setColumnCount", "columnCount",
            "setItem", "setItemText", "itemText", "takeItem",
            "setHorizontalHeaderLabels", "setVerticalHeaderLabels",
            "horizontalHeaderText", "verticalHeaderText",
            "setHorizontalHeaderItem", "setVerticalHeaderItem",
            "insertRow", "insertColumn", "removeRow", "removeColumn",
            "setRowHeight", "rowHeight", "setColumnWidth", "columnWidth",
            "resizeRowsToContents", "resizeColumnsToContents",
            "resizeRowToContents", "resizeColumnToContents",
            "selectRow", "selectColumn", "selectAll", "clearSelection",
            "selectedRows", "selectedColumns",
            "setCurrentCell", "currentRow", "currentColumn",
            "clear", "clearContents",
            "sortItems", "setSortingEnabled", "isSortingEnabled",
            "setShowGrid", "showGrid",
            "setAlternatingRowColors", "alternatingRowColors",
            "setSelectionBehavior", "selectionBehavior",
            "setSelectionMode", "selectionMode",
            "setEditTriggers", "editTriggers",
            "setWordWrap", "wordWrap",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаблица[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьКоличествоСтрок", "КоличествоСтрок",
            "УстановитьКоличествоКолонок", "КоличествоКолонок",
            "УстановитьТекст", "Текст", "ИзвлечьЭлемент",
            "УстановитьЗаголовкиКолонок", "УстановитьЗаголовкиСтрок",
            "ТекстЗаголовкаКолонки", "ТекстЗаголовкаСтроки",
            "ВставитьСтроку", "ВставитьКолонку", "УдалитьСтроку", "УдалитьКолонку",
            "УстановитьВысотуСтроки", "ВысотаСтроки",
            "УстановитьШиринуКолонки", "ШиринаКолонки",
            "ПодогнатьСтроки", "ПодогнатьКолонки",
            "ПодогнатьСтроку", "ПодогнатьКолонку",
            "ВыделитьСтроку", "ВыделитьКолонку", "ВыделитьВсе", "СнятьВыделение",
            "ВыделенныеСтроки", "ВыделенныеКолонки",
            "УстановитьТекущуюЯчейку", "ТекущаяСтрока", "ТекущаяКолонка",
            "Очистить", "ОчиститьСодержимое",
            "Сортировать", "ВключитьСортировку", "СортировкаВключена",
            "ПоказатьСетку", "СеткаПоказана",
            "ЧередоватьЦветаСтрок", "ЧередованиеЦветов",
            "УстановитьПоведениеВыделения", "ПоведениеВыделения",
            "УстановитьРежимВыделения", "РежимВыделения",
            "УстановитьТриггерыПравки", "ТриггерыПравки",
            "ПереносСлов", "ПереносСловВключен",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаблица[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаблица.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаблица.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТаблицаВиджет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

