Функция ДиагностикаМетаОбъектаTableWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtTableWidget ===")
    
    // 1. Проверяем создание через Новый QtТаблицаВиджет()
    Попытка
        метаТаблица = Новый QtТаблицаВиджет()
        Если метаТаблица == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через Новый QtТаблицаВиджет()")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtТаблицаВиджет()")
        КонецЕсли
        
        // Проверяем создание с параметрами
        метаТаблица2 = Новый QtТаблицаВиджет(3, 5)
        Если метаТаблица2 != null Тогда
            стр = метаТаблица2.КоличествоСтрок()
            кол = метаТаблица2.КоличествоКолонок()
            ВывестиСтрокуВКонсоль("✓ Объект создан с параметрами: строк=" + стр + ", колонок=" + кол)
        Иначе
            ВывестиСтрокуВКонсоль("✗ Объект НЕ создан с параметрами")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 2. Проверяем русские методы
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка ключевых русских методов таблицы:")
    русскиеМетоды = [
        "УстановитьКоличествоСтрок", "КоличествоСтрок",
        "УстановитьКоличествоКолонок", "КоличествоКолонок",
        "УстановитьТекст", "Текст",
        "УстановитьЗаголовкиКолонок", "УстановитьЗаголовкиСтрок",
        "ВставитьСтроку", "ВставитьКолонку",
        "УдалитьСтроку", "УдалитьКолонку",
        "Очистить", "ОчиститьСодержимое",
        "Действителен", "ПолучитьВиджет"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof метаТаблица[имя] === 'function' Тогда
            найдено = найдено + 1
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
            СброситьЦветКонсоли()
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 3. Проверяем наследование от QtWidget
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка наследования от QtВиджет:")
    методыQtWidget = ["setVisible", "isVisible", "setEnabled", "isEnabled", "setToolTip", "toolTip"]
    найдено = 0
    Для i = 0 По методыQtWidget.length - 1 Цикл
        имя = методыQtWidget[i]
        Если typeof метаТаблица[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + методыQtWidget.length + " методов QtВиджет доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТаблицаВиджет
// ============================================================

Функция ТестQtTableWidget()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    таблица = null
    Попытка
        таблица = Новый QtТаблицаВиджет()
        Если таблица == null Тогда
            таблица = new QtTableWidget()
        КонецЕсли
        
        Если таблица != null Тогда
            таблица.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТаблицаВиджет создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
