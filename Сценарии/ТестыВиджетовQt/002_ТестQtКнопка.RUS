        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД (ИСПРАВЛЕНО) ---
    Если тестПройден Тогда
        Попытка
            // Правильные русские методы: УстановитьВыбираемый и УстановитьВыбрано
            кнопка.УстановитьВыбираемый(ИСТИНА)
            кнопка.УстановитьВыбрано(ИСТИНА)
            нажатРус = кнопка.Выбрано()
            кнопка.Переключить()
            нажатРус2 = кнопка.Выбрано()
