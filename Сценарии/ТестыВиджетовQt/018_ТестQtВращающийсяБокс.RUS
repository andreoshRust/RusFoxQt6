//№    Тест    Описание
//1    Создание объекта    Проверка создания QtВращающийсяБокс
//2    Действительность    isValid/Действителен
//3    Значение    setValue/value, УстановитьЗначение/Значение
//4    Диапазон    setRange/minimum/maximum, УстановитьДиапазон/Минимум/Максимум
//5    Шаг    setSingleStep/singleStep, УстановитьШаг/Шаг
//6    Префикс и суффикс    setPrefix/prefix, setSuffix/suffix, УстановитьПрефикс/Префикс, УстановитьСуффикс/Суффикс
//7    Только чтение    setReadOnly/isReadOnly, УстановитьТолькоЧтение/ТолькоЧтение
//8    Основание    setDisplayIntegerBase/displayIntegerBase, УстановитьОснование/Основание
//9    Выделение    selectAll/clear, ВыбратьВсе/Очистить
//10    Доступность    setEnabled/isEnabled, УстановитьДоступность/Доступен
//11    Видимость    setVisible/isVisible, УстановитьВидимость/Видим
//12    Подсказка    setToolTip/toolTip, УстановитьПодсказку/Подсказка
//13    Стиль    setStyleSheet/styleSheet, УстановитьСтиль/Стиль

//Особенности спин-бокса:
//Поддерживает целочисленные значения в заданном диапазоне
//Автоматическая валидация ввода
//Поддержка различных систем счисления (десятичная, шестнадцатеричная и т.д.)
//Префикс и суффикс для форматирования отображения
//Кнопки-стрелки для изменения значения
//Поддержка только чтения

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВращающийсяБокс
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtSpinBox()
    ИмяКласса = "QtSpinBox"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtSpinBox !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtSpinBox()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtВращающийсяБокс
// ============================================================

Функция ДиагностикаМетаОбъектаSpinBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВращающийсяБокс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtSpinBox: " + (typeof QtSpinBox !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtВращающийсяБокс: " + (typeof QtВращающийсяБокс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        спинБокс1 = Новый QtВращающийсяБокс()
        Если спинБокс1 == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат 
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtВращающийсяБокс()")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtВращающийсяБокс:")
    методы = Object.getOwnPropertyNames(спинБокс1)
    прототип = Object.getPrototypeOf(спинБокс1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof спинБокс1[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof спинБокс1.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = спинБокс1.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "Значение", "УстановитьЗначение",
        "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум",
        "Шаг", "УстановитьШаг",
        "Префикс", "УстановитьПрефикс", "Суффикс", "УстановитьСуффикс",
        "Действителен", "Показать", "Скрыть"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof спинБокс1[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtВращающийсяБокс (QtSpinBox)
// ============================================================

Функция ТестQtSpinBoxFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    спинБокс = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        спинБокс = Новый QtВращающийсяБокс()
        Если спинБокс == null Тогда
            спинБокс = new QtSpinBox()
        КонецЕсли
        
        Если спинБокс != null Тогда
            спинБокс.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВращающийсяБокс создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВращающийсяБокс НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если спинБокс == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ SpinBox не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = спинБокс.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
