    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        statusBar.setStyleSheet("QStatusBar { background-color: #f0f0f0; }")
