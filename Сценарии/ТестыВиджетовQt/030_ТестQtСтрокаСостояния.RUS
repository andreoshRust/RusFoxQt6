            ВывестиСтрокуВКонсоль("    [RUS] ПолучитьОбъект: " + (реалРус != null ? "успешно" : "неудачно"))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
