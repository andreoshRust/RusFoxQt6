    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        statusBar.setVisible(false)
        видим = statusBar.isVisible()
        statusBar.setVisible(true)
        видим2 = statusBar.isVisible()
