    русУспех = ЛОЖЬ
    
// --- АНГЛИЙСКИЙ (ИСПРАВЛЕНО) ---
Попытка
    // ИСПРАВЛЕНО: setVisible() → setVisibleValue(), isVisible() → isVisibleValue()
    диалог.setVisibleValue(ЛОЖЬ)
    видим = диалог.isVisibleValue()
    диалог.setVisibleValue(ИСТИНА)
    видим2 = диалог.isVisibleValue()
    ВывестиСтрокуВКонсоль("    [ENG] setVisible(false): " + видим + ", setVisible(true): " + видим2)
Исключение
