КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ ВСЕХ ВАЛИДАТОРОВ
// ============================================================
// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ ВСЕХ ВАЛИДАТОРОВ (ИСПРАВЛЕННАЯ - БЕЗ ДУБЛИКАТОВ)
// ============================================================
// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ ВСЕХ ВАЛИДАТОРОВ (С УНИКАЛЬНЫМИ ИМЕНАМИ)
// ============================================================
// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ ВСЕХ ВАЛИДАТОРОВ (С ПРАВИЛЬНЫМИ МЕТОДАМИ)
// ============================================================

Функция ТестВсеВалидаторы()
    всегоТестов = 0
    успешноТестов = 0
    
    // Константы состояния валидатора
    Acceptable = 2
    Intermediate = 1
    Invalid = 0
    
    // ============================================================
    // ТЕСТ 1: ВАЛИДАТОР ЦЕЛЫХ ЧИСЕЛ
    // ============================================================
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТИРОВАНИЕ QtВалидаторЦелых                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // ===== 1.1 СОЗДАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1.1: Создание валидатора целых чисел")
    СброситьЦветКонсоли()
    
    тестВалидаторЦелых = null
    Попытка
        // Используем правильный класс QtIntValidator
        тестВалидаторЦелых1 = Новый QtIntValidator(1, 100)
        тестВалидаторЦелых = тестВалидаторЦелых1
        Если тестВалидаторЦелых == null Тогда
            тестВалидаторЦелых2 = Новый QtIntValidator()
            тестВалидаторЦелых = тестВалидаторЦелых2
        КонецЕсли
        
        Если тестВалидаторЦелых != null Тогда
            тестВалидаторЦелых.setDebug(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВалидаторЦелых создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВалидаторЦелых НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        тестВалидаторЦелых = null
    КонецПопытки
    
    Если тестВалидаторЦелых != null Тогда
    
        // ===== 1.2 ПРОВЕРКА ВАЛИДНОСТИ =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 1.2: Проверка валидности")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        Попытка
            валид = тестВалидаторЦелых.isValid()
            ВывестиСтрокуВКонсоль("    [ENG] isValid() = " + валид)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И валид == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        Если тестПройден Тогда
            Попытка
                валидРус = тестВалидаторЦелых.isValid()
                ВывестиСтрокуВКонсоль("    [RUS] Действителен (isValid) = " + валидРус)
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И валидРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
