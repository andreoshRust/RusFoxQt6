        ВывестиСтрокуВКонсоль("    ✓ [ENG] Доступность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка доступности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьДоступность(ЛОЖЬ)
            доступенРус = кнопка.Доступен()
            кнопка.УстановитьДоступность(ИСТИНА)
            доступенРус2 = кнопка.Доступен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступность: false->" + доступенРус + ", true->" + доступенРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И доступенРус == ЛОЖЬ И доступенРус2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка доступности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 10. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setVisible/isVisible"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Видимость")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setVisible(false)
        видим = кнопка.isVisible()
        кнопка.setVisible(true)
        видим2 = кнопка.isVisible()
        ВывестиСтрокуВКонсоль("    [ENG] setVisible: false->" + видим + ", true->" + видим2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Видимость работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка видимости")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьВидимость(ЛОЖЬ)
            видимРус = кнопка.Видим()
            кнопка.УстановитьВидимость(ИСТИНА)
            видимРус2 = кнопка.Видим()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВидимость: false->" + видимРус + ", true->" + видимРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И видимРус == ЛОЖЬ И видимРус2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка видимости")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 11. СТИЛЬ (setStyleSheet) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setStyleSheet/styleSheet"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Стиль (setStyleSheet)")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setStyleSheet("background-color: red; color: white;")
        стиль = кнопка.styleSheet()
        ВывестиСтрокуВКонсоль("    [ENG] setStyleSheet: '" + стиль + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И стиль != "" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка стиля")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьСтиль("background-color: blue; color: yellow;")
            стильРус = кнопка.Стиль()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтиль: '" + стильРус + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И стильРус != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка стиля")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 12. ПРОВЕРКА КОНСТАНТ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Константы"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка констант")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        иконка = кнопка.ToolButtonIconOnly()
        текст = кнопка.ToolButtonTextOnly()
        рядом = кнопка.ToolButtonTextBesideIcon()
        под = кнопка.ToolButtonTextUnderIcon()
        след = кнопка.ToolButtonFollowStyle()
        ноСтрел = кнопка.NoArrow()
        вверх = кнопка.UpArrow()
        вниз = кнопка.DownArrow()
        влево = кнопка.LeftArrow()
        вправо = кнопка.RightArrow()
        задержка = кнопка.DelayedPopup()
        кнопкаМеню = кнопка.MenuButtonPopup()
        мгновенно = кнопка.InstantPopup()
        ВывестиСтрокуВКонсоль("    [ENG] Константы: IconOnly=" + иконка + ", TextOnly=" + текст + ", NoArrow=" + ноСтрел + ", Delayed=" + задержка)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Константы работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка констант")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            иконкаРус = кнопка.ТолькоИконка()
            текстРус2 = кнопка.ТолькоТекст()
            рядомРус = кнопка.ТекстРядомСИконкой()
            подРус = кнопка.ТекстПодИконкой()
            следРус = кнопка.СледоватьСтилю()
            ноСтрелРус = кнопка.НетСтрелки()
            вверхРус = кнопка.СтрелкаВверх()
            внизРус = кнопка.СтрелкаВниз()
            влевоРус = кнопка.СтрелкаВлево()
            вправоРус = кнопка.СтрелкаВправо()
            задержкаРус = кнопка.ОтложенноеВсплытие()
            кнопкаМенюРус = кнопка.КнопкаМеню()
            мгновенноРус = кнопка.МгновенноеВсплытие()
            ВывестиСтрокуВКонсоль("    [RUS] Константы: ТолькоИконка=" + иконкаРус + ", ТолькоТекст=" + текстРус2 + ", НетСтрелки=" + ноСтрелРус + ", Отложенное=" + задержкаРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Константы работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка констант")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    Для i = 0 По названияТестов.length - 1 Цикл
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + (i+1) + "    │ " + названияТестов[i] + " " + англСтатус + "        │ " + названияТестов[i] + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtКнопкаИнструмента завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtКнопкаИнструмента (QtToolButton)                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtToolButton()
    ДиагностикаМетаОбъектаToolButton()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtКнопкаИнструмента (русские и английские методы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtToolButton()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtКнопкаИнструмента: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

