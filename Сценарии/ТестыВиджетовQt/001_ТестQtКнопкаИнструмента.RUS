//№    Тест    Описание
//1    Создание объекта    Проверка создания QtКнопкаИнструмента
//2    Действительность    isValid/Действителен
//3    Стиль кнопки    setToolButtonStyle/toolButtonStyle, УстановитьСтильКнопки/СтильКнопки
//4    Тип стрелки    setArrowType/arrowType, УстановитьТипСтрелки/ТипСтрелки
//5    Автоподнятие    setAutoRaise/autoRaise, УстановитьАвтоподнятие/Автоподнятие
//6    Меню    setMenu/menu, УстановитьМеню/Меню
//7    Режим всплытия    setPopupMode/popupMode, УстановитьРежимВсплытия/РежимВсплытия
//8    Текст    setText/text, УстановитьТекст/Текст
//9    Состояние    setChecked/isChecked, УстановитьВыбрано/Выбрано
//10    Доступность    setEnabled/isEnabled, УстановитьДоступность/Доступен
//11    Видимость    setVisible/isVisible, УстановитьВидимость/Видим
//12    Стиль    setStyleSheet/styleSheet, УстановитьСтиль/Стиль
//13    Константы    Проверка констант

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtКнопкаИнструмента
// ============================================================

Функция ДиагностикаМетодовQtToolButton()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtКнопкаИнструмента ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtКнопкаИнструмента: " + (typeof QtКнопкаИнструмента !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtКнопкаИнструмента: " + e)
    КонецПопытки;
    
    Попытка
        диагКнопка = НовыйОбъект("QtКнопкаИнструмента")
        Если диагКнопка == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtКнопкаИнструмента не создан")
            Возврат
        КонецЕсли;
        
        диагКнопка.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtКнопкаИнструмента создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "toolButtonStyle", "setToolButtonStyle",
            "arrowType", "setArrowType",
            "autoRaise", "setAutoRaise",
            "menu", "setMenu", "showMenu",
            "popupMode", "setPopupMode",
            "text", "setText",
            "isChecked", "setChecked", "toggle",
            "isEnabled", "setEnabled",
            "isVisible", "setVisible", "show", "hide",
            "setToolTip", "toolTip",
            "setStyleSheet", "styleSheet",
            "setFont", "font", "setFontSize", "setFontBold",
            "setIcon", "icon", "setIconSize", "iconSize",
            "ToolButtonIconOnly", "ToolButtonTextOnly",
            "ToolButtonTextBesideIcon", "ToolButtonTextUnderIcon", "ToolButtonFollowStyle",
            "NoArrow", "UpArrow", "DownArrow", "LeftArrow", "RightArrow",
            "DelayedPopup", "MenuButtonPopup", "InstantPopup"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКнопка[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "СтильКнопки", "УстановитьСтильКнопки",
            "ТипСтрелки", "УстановитьТипСтрелки",
            "Автоподнятие", "УстановитьАвтоподнятие",
            "Меню", "УстановитьМеню", "ПоказатьМеню",
            "РежимВсплытия", "УстановитьРежимВсплытия",
            "Текст", "УстановитьТекст",
            "Выбрано", "УстановитьВыбрано", "Переключить",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку",
            "Стиль", "УстановитьСтиль",
            "Шрифт", "УстановитьШрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "Иконка", "УстановитьИконку", "РазмерИконки", "УстановитьРазмерИконки",
            "ТолькоИконка", "ТолькоТекст",
            "ТекстРядомСИконкой", "ТекстПодИконкой", "СледоватьСтилю",
            "НетСтрелки", "СтрелкаВверх", "СтрелкаВниз", "СтрелкаВлево", "СтрелкаВправо",
            "ОтложенноеВсплытие", "КнопкаМеню", "МгновенноеВсплытие"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКнопка[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагКнопка.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагКнопка.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtКнопкаИнструмента: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtКнопкаИнструмента
// ============================================================

Функция ДиагностикаМетаОбъектаToolButton()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКнопкаИнструмента ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtToolButton: " + (typeof QtToolButton !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtКнопкаИнструмента: " + (typeof QtКнопкаИнструмента !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        кнопка = НовыйОбъект("QtКнопкаИнструмента")
        Если кнопка == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКнопкаИнструмента:")
    методы = Object.getOwnPropertyNames(кнопка)
    прототип = Object.getPrototypeOf(кнопка)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof кнопка[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof кнопка.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = кнопка.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtКнопкаИнструмента (QtToolButton)
// ============================================================

Функция ТестQtToolButton()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    кнопка = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        кнопка = НовыйОбъект("QtКнопкаИнструмента")
        Если кнопка == null Тогда
            кнопка = new QtToolButton()
        КонецЕсли
        
        Если кнопка != null Тогда
            кнопка.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtКнопкаИнструмента создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtКнопкаИнструмента НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если кнопка == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Кнопка не создана, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = кнопка.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = кнопка.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. СТИЛЬ КНОПКИ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setToolButtonStyle/toolButtonStyle"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Стиль кнопки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setToolButtonStyle(кнопка.ToolButtonTextOnly())
        стиль = кнопка.toolButtonStyle()
        кнопка.setToolButtonStyle(кнопка.ToolButtonIconOnly())
        стиль2 = кнопка.toolButtonStyle()
        ВывестиСтрокуВКонсоль("    [ENG] setToolButtonStyle: " + стиль + " -> " + стиль2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль кнопки работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка стиля")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьСтильКнопки(кнопка.ТолькоТекст())
            стильРус = кнопка.СтильКнопки()
            кнопка.УстановитьСтильКнопки(кнопка.ТолькоИконка())
            стильРус2 = кнопка.СтильКнопки()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтильКнопки: " + стильРус + " -> " + стильРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
