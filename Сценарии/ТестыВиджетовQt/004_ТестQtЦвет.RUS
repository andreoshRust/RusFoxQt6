            Если белРус != null И крРус != null И зелРус != null И синРус != null Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    [RUS] Предопределенные цвета: все объекты созданы")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: некоторые объекты не созданы")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    

    // ===== 10. RGB FLOAT =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: RGB Float")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет1.setRgbF(1.0, 0.5, 0.25)
        r = цвет1.redF()
        g = цвет1.greenF()
        b = цвет1.blueF()
        diffR = Math.abs(r - 1.0)
        diffG = Math.abs(g - 0.5)
        diffB = Math.abs(b - 0.25)
        ВывестиСтрокуВКонсоль("    [ENG] setRgbF: " + r + ", " + g + ", " + b + " (ожидается ~1.0, ~0.5, ~0.25)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И diffR < 0.01 И diffG < 0.01 И diffB < 0.01 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] RGB Float работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается ~1.0, ~0.5, ~0.25, получено " + r + ", " + g + ", " + b)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет1.УстановитьRGBF(0.25, 0.5, 1.0)
            rРус = цвет1.КрасныйF()
            gРус = цвет1.ЗеленыйF()
            bРус = цвет1.СинийF()
            diffRРус = Math.abs(rРус - 0.25)
            diffGРус = Math.abs(gРус - 0.5)
            diffBРус = Math.abs(bРус - 1.0)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьRGBF: " + rРус + ", " + gРус + ", " + bРус + " (ожидается ~0.25, ~0.5, ~1.0)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И diffRРус < 0.01 И diffGРус < 0.01 И diffBРус < 0.01 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] RGB Float работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается ~0.25, ~0.5, ~1.0, получено " + rРус + ", " + gРус + ", " + bРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

     // ===== 11. ИЗ CMYK =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Из CMYK")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цветИзCMYK = цвет1.fromCmyk(0, 255, 255, 0)
        
        // Проверяем, что объект создан
        Если цветИзCMYK != null Тогда
            // Проверяем, что у объекта есть метод name()
            Если typeof цветИзCMYK.name === 'function' Тогда
                имя = цветИзCMYK.name()
                ВывестиСтрокуВКонсоль("    [ENG] fromCmyk: цвет создан, имя=" + имя)
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Из CMYK работает")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    [ENG] fromCmyk: цвет создан")
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Из CMYK работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: цвет не создан")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цветИзCMYKРус = цвет1.ИзCMYK(255, 0, 255, 0)
            
            Если цветИзCMYKРус != null Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ИзCMYK: цвет создан")
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Из CMYK работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: цвет не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    

    // ===== 12. ПОЛУЧЕНИЕ QCOLOR И СОЗДАНИЕ НОВОГО QtColor =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Получение QColor и создание нового QtColor")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет1.setRgb(100, 150, 200)
        qcolor = цвет1.getColor()
        новыйЦвет = цвет1.fromQColor(qcolor)
        r = новыйЦвет.red()
        g = новыйЦвет.green()
        b = новыйЦвет.blue()
        ВывестиСтрокуВКонсоль("    [ENG] getColor/fromQColor: RGB(" + r + ", " + g + ", " + b + ") (ожидается 100, 150, 200)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И r == 100 И g == 150 И b == 200 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] getColor/fromQColor работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 100, 150, 200, получено " + r + ", " + g + ", " + b)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет1.УстановитьRGB(200, 150, 100)
            qcolorРус = цвет1.ПолучитьЦвет()
            
            // Создаем новый QtColor из QColor
            новыйЦветРус = цвет1.ИзQColor(qcolorРус)
            
            // Для русского теста используем английские методы, 
            // так как русские методы могут не добавиться автоматически
            Если typeof новыйЦветРус.red === 'function' Тогда
                rРус = новыйЦветРус.red()
                gРус = новыйЦветРус.green()
                bРус = новыйЦветРус.blue()
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьЦвет/ИзQColor (англ. методы): RGB(" + rРус + ", " + gРус + ", " + bРус + ") (ожидается 200, 150, 100)")
                
                Если rРус == 200 И gРус == 150 И bРус == 100 Тогда
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] ПолучитьЦвет/ИзQColor работает")
                    СброситьЦветКонсоли()
                    успешноТестов = успешноТестов + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 200, 150, 100, получено " + rРус + ", " + gРус + ", " + bРус)
                    СброситьЦветКонсоли()
                КонецЕсли
            Иначе
                ВывестиСтрокуВКонсоль("    [RUS] Ошибка: у нового цвета нет метода red()")
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtЦвет: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtЦвет: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtЦвет завершён"
КонецФункции

// ============================================================
// УНИВЕРСАЛЬНАЯ ФУНКЦИЯ ДЛЯ ПОЛУЧЕНИЯ КОМПОНЕНТОВ ЦВЕТА
// ============================================================

Функция ПолучитьКомпонентыЦвета(цв)
    Попытка
        // Пробуем получить как методы
        Если typeof цв.red === 'function' Тогда
            Возврат {красный: цв.red(), зеленый: цв.green(), синий: цв.blue()}
        Иначе
            // Пробуем как свойства
            Если typeof цв.red !== 'undefined' Тогда
                Возврат {красный: цв.red, зеленый: цв.green, синий: цв.blue}
            Иначе
                // Пробуем через JSON
                стр = JSON.stringify(цв)
                Возврат {красный: 0, зеленый: 0, синий: 0}
            КонецЕсли
        КонецЕсли
    Исключение
        // Если ничего не работает, возвращаем 0
        Возврат {красный: 0, зеленый: 0, синий: 0}
    КонецПопытки
КонецФункции


