    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДерево.setSortingEnabled(ИСТИНА)
        сортировка = тестДерево.isSortingEnabled()
        тестДерево.setSortingEnabled(ЛОЖЬ)
