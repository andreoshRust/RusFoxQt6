    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестДерево.setAlternatingRowColors(ИСТИНА)
        чередование = тестДерево.alternatingRowColors()
        тестДерево.setAlternatingRowColors(ЛОЖЬ)
