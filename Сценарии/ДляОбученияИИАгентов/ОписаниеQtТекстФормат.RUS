// Правила для опрераторов языка программирования:
// 1) Конструкция Если ... Тогда  должна располагаться на одной строке.
// 2) Все указатели на объекты в сценарии должны иметь уникальные имена.
// 3) Указатели, созданные не через оператор "Новый" или "new" имеют только английские имена методов.

Пусть Режим_Отладки = ИСТИНА

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстФормат (QtTextFormat)
// ============================================================

Функция Методы_QtТекстФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстФормат() ==============================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        формат = Новый QtТекстФормат()
        формат.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    Попытка
        валидный = формат.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Действителен(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ПОЛУЧЕНИЕ ТИПА =====
    Попытка
        тип = формат.Тип()
        ВывестиСтрокуВКонсоль("    Тип(): " + тип + " (ожидается -1 - Invalid)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Тип(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пустой = формат.Пусто()
        ВывестиСтрокуВКонсоль("    Пусто(): " + пустой + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пусто(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. КОНСТАНТЫ ТИПОВ =====
    Попытка
        невал = формат.НевалидныйФормат()
        символьный = формат.СимвольныйФормат()
        блочный = формат.БлочныйФормат()
        списочный = формат.ФорматСписка()
        табличный = формат.ФорматТаблицы()
        пользовательский = формат.ФорматПользователя()
        
        ВывестиСтрокуВКонсоль("    Константы типов:")
        ВывестиСтрокуВКонсоль("      Невалидный=" + невал + ", Символьный=" + символьный)
        ВывестиСтрокуВКонсоль("      Блочный=" + блочный + ", Список=" + списочный)
        ВывестиСтрокуВКонсоль("      Таблица=" + табличный + ", Пользователя=" + пользовательский)
        
        Если невал == -1 И символьный == 2 И блочный == 1 И списочный == 3 И табличный == 4 И пользовательский == 100 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Константы типов: ВСЕ РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Константы типов: ЕСТЬ ОШИБКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Константы типов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. РАБОТА СО СВОЙСТВАМИ =====
    Попытка
        // Установка свойства
        формат.УстановитьСвойство(100, "Тестовое значение")
        
        // Проверка наличия
        есть = формат.ЕстьСвойство(100)
        значение = формат.Свойство(100)
        колво = формат.КоличествоСвойств()
        
        ВывестиСтрокуВКонсоль("    Свойства:")
        ВывестиСтрокуВКонсоль("      УстановитьСвойство(100, 'Тест') -> ЕстьСвойство: " + есть)
        ВывестиСтрокуВКонсоль("      Свойство(100): '" + значение + "' (ожидается 'Тестовое значение')")
        ВывестиСтрокуВКонсоль("      КоличествоСвойств(): " + колво + " (ожидается > 0)")
        
        // Очистка свойства
        формат.ОчиститьСвойство(100)
        естьПосле = формат.ЕстьСвойство(100)
        ВывестиСтрокуВКонсоль("      ОчиститьСвойство(100) -> ЕстьСвойство: " + естьПосле + " (ожидается false)")
        
        Если есть == ИСТИНА И значение == "Тестовое значение" И колво > 0 И естьПосле == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ Свойства: ВСЕ РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Свойства: ЕСТЬ ОШИБКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Свойства: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. КОПИРОВАНИЕ =====
    Попытка
        цель = Новый QtТекстФормат()
        результат = формат.КопироватьВ(цель)
        
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + " (ожидается true)")
        
        Если результат == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Копирование: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Копирование: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ОБЪЕДИНЕНИЕ =====
    Попытка
        формат2 = Новый QtТекстФормат()
        формат2.УстановитьСвойство(200, "Значение из второго")
        формат.Объединить(формат2.ПолучитьФормат())
        
        естьСвойство = формат.ЕстьСвойство(200)
        значение = формат.Свойство(200)
        
        ВывестиСтрокуВКонсоль("    Объединить():")
        ВывестиСтрокуВКонсоль("      ЕстьСвойство(200): " + естьСвойство + " (ожидается true)")
        ВывестиСтрокуВКонсоль("      Свойство(200): '" + значение + "' (ожидается 'Значение из второго')")
        
        Если естьСвойство == ИСТИНА И значение == "Значение из второго" Тогда
            ВывестиСтрокуВКонсоль("    ✓ Объединение: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Объединение: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Объединение: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ ФОРМАТА =====
    Попытка
        полученный = формат.ПолучитьФормат()
        ВывестиСтрокуВКонсоль("    ПолучитьФормат(): " + (полученный != null ? "УСПЕШНО" : "НЕУДАЧНО"))
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ ПолучитьФормат(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof формат.RusFunc === 'function' Тогда
            jsonStr = формат.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof формат.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.type !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.copyTo !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.property !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.hasProperty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof формат.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      type(): " + (typeof формат.type === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof формат.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      copyTo(): " + (typeof формат.copyTo === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      property(): " + (typeof формат.property === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      hasProperty(): " + (typeof формат.hasProperty === 'function' ? "✅" : "❌"))
        
        Если англРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Английские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Английские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка английских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Попытка
        русРаботают = ИСТИНА
        Если typeof формат.Действителен !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.Тип !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.Пусто !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.КопироватьВ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.Свойство !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof формат.ЕстьСвойство !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Русские методы:")
        ВывестиСтрокуВКонсоль("      Действителен(): " + (typeof формат.Действителен === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Тип(): " + (typeof формат.Тип === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Пусто(): " + (typeof формат.Пусто === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      КопироватьВ(): " + (typeof формат.КопироватьВ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Свойство(): " + (typeof формат.Свойство === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ЕстьСвойство(): " + (typeof формат.ЕстьСвойство === 'function' ? "✅" : "❌"))
        
        Если русРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Русские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Русские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка русских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("=== Диагностика QtТекстФормат завершена ========================================")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстСимволФормат (QtTextCharFormat)
// ============================================================

Функция Методы_QtТекстСимволФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстСимволФормат() ========================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        СимвФорм1_ = Новый QtТекстСимволФормат()
        СимвФорм1_.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ШРИФТ =====
    Попытка
        СимвФорм1_.УстановитьРазмерШрифта(16)
        СимвФорм1_.УстановитьЖирныйШрифт(ИСТИНА)
        размер = СимвФорм1_.РазмерШрифта()
        жирный = СимвФорм1_.ЖирныйШрифт()
        ВывестиСтрокуВКонсоль("    Шрифт: размер=" + размер + ", жирный=" + жирный + " (ожидается 16, true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Шрифт: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ЦВЕТ ТЕКСТА =====
    Попытка
        СимвФорм1_.УстановитьЦветТекста("red")
        цвет = СимвФорм1_.ЦветТекста()
        имяЦвета = цвет.name
        ВывестиСтрокуВКонсоль("    Цвет текста: " + имяЦвета + " (ожидается red)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Цвет текста: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ЦВЕТ ФОНА =====
    Попытка
        СимвФорм1_.УстановитьЦветФона("yellow")
        цветФона = СимвФорм1_.ЦветФона()
        имяЦветаФона = цветФона.name
        ВывестиСтрокуВКонсоль("    Цвет фона: " + имяЦветаФона + " (ожидается yellow)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Цвет фона: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОДЧЕРКИВАНИЕ =====
    Попытка
        СимвФорм1_.УстановитьСтильПодчеркивания(1) // SingleUnderline
        стиль = СимвФорм1_.СтильПодчеркивания()
        СимвФорм1_.УстановитьЦветПодчеркивания("blue")
        ВывестиСтрокуВКонсоль("    Подчеркивание: стиль=" + стиль + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Подчеркивание: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ВЕРТИКАЛЬНОЕ ВЫРАВНИВАНИЕ =====
    Попытка
        СимвФорм1_.УстановитьВертикальноеВыравнивание(1) // AlignSuperScript
        выравнивание = СимвФорм1_.ВертикальноеВыравнивание()
        ВывестиСтрокуВКонсоль("    Вертикальное выравнивание: " + выравнивание + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Вертикальное выравнивание: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ИНТЕРВАЛЫ =====
    Попытка
        СимвФорм1_.УстановитьМежбуквенныйИнтервал(1.5)
        букв = СимвФорм1_.МежбуквенныйИнтервал()
        СимвФорм1_.УстановитьМежсловныйИнтервал(2.0)
        слов = СимвФорм1_.МежсловныйИнтервал()
        ВывестиСтрокуВКонсоль("    Интервалы: межбуквенный=" + букв + ", межсловный=" + слов + " (ожидается 1.5, 2.0)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Интервалы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пусто = СимвФорм1_.Пусто()
        ВывестиСтрокуВКонсоль("    Пусто(): " + пусто + " (ожидается false - после установки свойств)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пусто(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. КОПИРОВАНИЕ =====
    Попытка
        копия = СимвФорм1_.Копировать()
        Если копия != null Тогда
            размерКопии = копия.РазмерШрифта()
            ВывестиСтрокуВКонсоль("    Копировать(): размер=" + размерКопии + " (ожидается 16)")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Копировать(): копия не создана")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Копировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. СВОЙСТВА =====
    Попытка
        СимвФорм1_.УстановитьСвойство(100, "Тестовое значение")
        есть = СимвФорм1_.ЕстьСвойство(100)
        значение = СимвФорм1_.Свойство(100)
        колво = СимвФорм1_.КоличествоСвойств()
        СимвФорм1_.ОчиститьСвойство(100)
        естьПосле = СимвФорм1_.ЕстьСвойство(100)
        
        ВывестиСтрокуВКонсоль("    Свойства:")
        ВывестиСтрокуВКонсоль("      ЕстьСвойство(100): " + есть + " (ожидается true)")
        ВывестиСтрокуВКонсоль("      Свойство(100): '" + значение + "' (ожидается 'Тестовое значение')")
        ВывестиСтрокуВКонсоль("      КоличествоСвойств(): " + колво + " (ожидается > 0)")
        ВывестиСтрокуВКонсоль("      После ОчиститьСвойство(100): " + естьПосле + " (ожидается false)")
        
        Если есть == ИСТИНА И значение == "Тестовое значение" И колво > 0 И естьПосле == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ Свойства: ВСЕ РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Свойства: ЕСТЬ ОШИБКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Свойства: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ОБЪЕДИНЕНИЕ =====
    Попытка
        СимвФорм2_ = Новый QtТекстСимволФормат()
        СимвФорм2_.РежимОтладки(Режим_Отладки)
        СимвФорм2_.УстановитьКурсивныйШрифт(ИСТИНА)
        СимвФорм2_.УстановитьРазмерШрифта(20)
        
        // Сохраняем исходные значения
        размерДо = СимвФорм1_.РазмерШрифта()
        курсивДо = СимвФорм1_.КурсивныйШрифт()
        
        // Объединяем
        СимвФорм1_.Объединить(СимвФорм2_.ПолучитьФормат())
        
        размерПосле = СимвФорм1_.РазмерШрифта()
        курсивПосле = СимвФорм1_.КурсивныйШрифт()
        
        ВывестиСтрокуВКонсоль("    Объединить():")
        ВывестиСтрокуВКонсоль("      Размер: было " + размерДо + ", стало " + размерПосле + " (ожидается 20)")
        ВывестиСтрокуВКонсоль("      Курсив: было " + курсивДо + ", стало " + курсивПосле + " (ожидается true)")
        
        Если размерПосле == 20 И курсивПосле == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Объединение: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Объединение: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Объединение: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    Попытка
        полученный = СимвФорм1_.ПолучитьФормат()
        ВывестиСтрокуВКонсоль("    ПолучитьФормат(): " + (полученный != null ? "УСПЕШНО" : "НЕУДАЧНО"))
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ ПолучитьФормат(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 13. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof СимвФорм1_.RusFunc === 'function' Тогда
            jsonStr = СимвФорм1_.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 14. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof СимвФорм1_.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.copy !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.merge !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setFontSize !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setTextColor !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setBackgroundColor !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setUnderlineStyle !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setVerticalAlignment !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.setLetterSpacing !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof СимвФорм1_.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      copy(): " + (typeof СимвФорм1_.copy === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      merge(): " + (typeof СимвФорм1_.merge === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof СимвФорм1_.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setFontSize(): " + (typeof СимвФорм1_.setFontSize === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setTextColor(): " + (typeof СимвФорм1_.setTextColor === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setBackgroundColor(): " + (typeof СимвФорм1_.setBackgroundColor === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setUnderlineStyle(): " + (typeof СимвФорм1_.setUnderlineStyle === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setVerticalAlignment(): " + (typeof СимвФорм1_.setVerticalAlignment === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setLetterSpacing(): " + (typeof СимвФорм1_.setLetterSpacing === 'function' ? "✅" : "❌"))
        
        Если англРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Английские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Английские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка английских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 15. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Попытка
        русРаботают = ИСТИНА
        Если typeof СимвФорм1_.Действителен !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.Копировать !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.Объединить !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.Пусто !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьРазмерШрифта !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьЦветТекста !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьЦветФона !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьСтильПодчеркивания !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьВертикальноеВыравнивание !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof СимвФорм1_.УстановитьМежбуквенныйИнтервал !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Русские методы:")
        ВывестиСтрокуВКонсоль("      Действителен(): " + (typeof СимвФорм1_.Действителен === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Копировать(): " + (typeof СимвФорм1_.Копировать === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Объединить(): " + (typeof СимвФорм1_.Объединить === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Пусто(): " + (typeof СимвФорм1_.Пусто === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьРазмерШрифта(): " + (typeof СимвФорм1_.УстановитьРазмерШрифта === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьЦветТекста(): " + (typeof СимвФорм1_.УстановитьЦветТекста === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьЦветФона(): " + (typeof СимвФорм1_.УстановитьЦветФона === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьСтильПодчеркивания(): " + (typeof СимвФорм1_.УстановитьСтильПодчеркивания === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьВертикальноеВыравнивание(): " + (typeof СимвФорм1_.УстановитьВертикальноеВыравнивание === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьМежбуквенныйИнтервал(): " + (typeof СимвФорм1_.УстановитьМежбуквенныйИнтервал === 'function' ? "✅" : "❌"))
        
        Если русРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Русские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Русские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка русских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("=== Диагностика QtТекстСимволФормат завершена ==================================")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстИзображениеФормат (QtTextImageFormat)
// ============================================================

Функция Методы_QtТекстИзображениеФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстИзображениеФормат() ===================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        ТекстИзобр1_ = Новый QtТекстИзображениеФормат()
        ТекстИзобр1_.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    Попытка
        валидный = ТекстИзобр1_.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Действителен(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. УСТАНОВКА ИМЕНИ =====
    Попытка
        ТекстИзобр1_.УстановитьИмя("test.png")
        имя = ТекстИзобр1_.Имя()
        ВывестиСтрокуВКонсоль("    УстановитьИмя/Имя: '" + имя + "' (ожидается 'test.png')")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ УстановитьИмя/Имя: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. УСТАНОВКА ШИРИНЫ =====
    Попытка
        ТекстИзобр1_.УстановитьШирину(100)
        ширина = ТекстИзобр1_.Ширина()
        ВывестиСтрокуВКонсоль("    УстановитьШирину/Ширина: " + ширина + " (ожидается 100)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ УстановитьШирину/Ширина: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. УСТАНОВКА ВЫСОТЫ =====
    Попытка
        ТекстИзобр1_.УстановитьВысоту(50)
        высота = ТекстИзобр1_.Высота()
        ВывестиСтрокуВКонсоль("    УстановитьВысоту/Высота: " + высота + " (ожидается 50)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ УстановитьВысоту/Высота: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пустой = ТекстИзобр1_.Пустой()
        ВывестиСтрокуВКонсоль("    Пустой(): " + пустой + " (ожидается false - после установки свойств)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пустой(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ОЧИСТКА =====
    Попытка
        // Сохраняем данные до очистки
        имяДо = ТекстИзобр1_.Имя()
        ширинаДо = ТекстИзобр1_.Ширина()
        высотаДо = ТекстИзобр1_.Высота()
        
        // Очищаем
        ТекстИзобр1_.Очистить()
        
        // Проверяем после очистки
        имяПосле = ТекстИзобр1_.Имя()
        ширинаПосле = ТекстИзобр1_.Ширина()
        высотаПосле = ТекстИзобр1_.Высота()
        пустойПосле = ТекстИзобр1_.Пустой()
        
        ВывестиСтрокуВКонсоль("    Очистить():")
        ВывестиСтрокуВКонсоль("      Было: имя='" + имяДо + "', ширина=" + ширинаДо + ", высота=" + высотаДо)
        ВывестиСтрокуВКонсоль("      Стало: имя='" + имяПосле + "', ширина=" + ширинаПосле + ", высота=" + высотаПосле)
        ВывестиСтрокуВКонсоль("      Пустой(): " + пустойПосле + " (ожидается true)")
        
        Если имяПосле == "" И ширинаПосле == 0 И высотаПосле == 0 И пустойПосле == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Очистка: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Очистка: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Очистка: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. TOSTRING =====
    Попытка
        ТекстИзобр1_.УстановитьИмя("image.png")
        ТекстИзобр1_.УстановитьШирину(200)
        ТекстИзобр1_.УстановитьВысоту(150)
        строка = ТекстИзобр1_.ВСтроку()
        ВывестиСтрокуВКонсоль("    ВСтроку(): '" + строка + "'")
        
        Если строка.indexOf("image.png") != -1 И строка.indexOf("200") != -1 И строка.indexOf("150") != -1 Тогда
            ВывестиСтрокуВКонсоль("    ✓ ВСтроку(): РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ ВСтроку(): НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ ВСтроку(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧИТЬФОРМАТ И УСТАНОВИТЬФОРМАТ =====
    Попытка
        // Создаем источник
        ТекстИзобр2_ = Новый QtТекстИзображениеФормат()
        ТекстИзобр2_.РежимОтладки(Режим_Отладки)
        ТекстИзобр2_.УстановитьИмя("copy.png")
        ТекстИзобр2_.УстановитьШирину(300)
        ТекстИзобр2_.УстановитьВысоту(200)
        
        // Получаем формат
        внутрФормат = ТекстИзобр2_.ПолучитьФормат()
        ВывестиСтрокуВКонсоль("    ПолучитьФормат(): формат получен")
        
        // Устанавливаем формат в новый объект
        ТекстИзобр3_ = Новый QtТекстИзображениеФормат()
        ТекстИзобр3_.РежимОтладки(Режим_Отладки)
        ТекстИзобр3_.УстановитьФормат(внутрФормат)
        
        имяКопии = ТекстИзобр3_.Имя()
        ширинаКопии = ТекстИзобр3_.Ширина()
        высотаКопии = ТекстИзобр3_.Высота()
        
        ВывестиСтрокуВКонсоль("    УстановитьФормат(): имя='" + имяКопии + "', ширина=" + ширинаКопии + ", высота=" + высотаКопии)
        
        Если имяКопии == "copy.png" И ширинаКопии == 300 И высотаКопии == 200 Тогда
            ВывестиСтрокуВКонсоль("    ✓ ПолучитьФормат/УстановитьФормат: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ ПолучитьФормат/УстановитьФормат: НЕ РАБОТАЮТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ ПолучитьФормат/УстановитьФормат: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof ТекстИзобр1_.RusFunc === 'function' Тогда
            jsonStr = ТекстИзобр1_.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof ТекстИзобр1_.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.name !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.width !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.height !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.clear !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.toString !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.getFormat !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.setFormat !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.setName !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.setWidth !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.setHeight !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof ТекстИзобр1_.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      name(): " + (typeof ТекстИзобр1_.name === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      width(): " + (typeof ТекстИзобр1_.width === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      height(): " + (typeof ТекстИзобр1_.height === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof ТекстИзобр1_.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      clear(): " + (typeof ТекстИзобр1_.clear === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      toString(): " + (typeof ТекстИзобр1_.toString === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      getFormat(): " + (typeof ТекстИзобр1_.getFormat === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setFormat(): " + (typeof ТекстИзобр1_.setFormat === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setName(): " + (typeof ТекстИзобр1_.setName === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setWidth(): " + (typeof ТекстИзобр1_.setWidth === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setHeight(): " + (typeof ТекстИзобр1_.setHeight === 'function' ? "✅" : "❌"))
        
        Если англРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Английские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Английские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка английских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Попытка
        русРаботают = ИСТИНА
        Если typeof ТекстИзобр1_.Действителен !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.Имя !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.Ширина !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.Высота !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.Пустой !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.Очистить !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.ВСтроку !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.ПолучитьФормат !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.УстановитьФормат !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.УстановитьИмя !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.УстановитьШирину !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстИзобр1_.УстановитьВысоту !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Русские методы:")
        ВывестиСтрокуВКонсоль("      Действителен(): " + (typeof ТекстИзобр1_.Действителен === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Имя(): " + (typeof ТекстИзобр1_.Имя === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Ширина(): " + (typeof ТекстИзобр1_.Ширина === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Высота(): " + (typeof ТекстИзобр1_.Высота === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Пустой(): " + (typeof ТекстИзобр1_.Пустой === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Очистить(): " + (typeof ТекстИзобр1_.Очистить === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ВСтроку(): " + (typeof ТекстИзобр1_.ВСтроку === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПолучитьФормат(): " + (typeof ТекстИзобр1_.ПолучитьФормат === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьФормат(): " + (typeof ТекстИзобр1_.УстановитьФормат === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьИмя(): " + (typeof ТекстИзобр1_.УстановитьИмя === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьШирину(): " + (typeof ТекстИзобр1_.УстановитьШирину === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьВысоту(): " + (typeof ТекстИзобр1_.УстановитьВысоту === 'function' ? "✅" : "❌"))
        
        Если русРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Русские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Русские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка русских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("=== Диагностика QtТекстИзображениеФормат завершена =============================")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстБлокФормат (QtTextBlockFormat)
// ============================================================

Функция Методы_QtТекстБлокФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстБлокФормат() ==========================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        ТекстБлок2_ = Новый QtТекстБлокФормат()
        ТекстБлок2_.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    Попытка
        валидный = ТекстБлок2_.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Действителен(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ТИП ФОРМАТА =====
    Попытка
        тип = ТекстБлок2_.Тип()
        ВывестиСтрокуВКонсоль("    Тип(): " + тип + " (ожидается 1 - BlockFormat)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Тип(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пустой = ТекстБлок2_.Пусто()
        ВывестиСтрокуВКонсоль("    Пусто(): " + пустой + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пусто(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ВЫРАВНИВАНИЕ =====
    Попытка
        ТекстБлок2_.УстановитьВыравнивание(1)
        выравнивание = ТекстБлок2_.Выравнивание()
        ВывестиСтрокуВКонсоль("    УстановитьВыравнивание/Выравнивание: " + выравнивание + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Выравнивание: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОТСТУПЫ =====
    Попытка
        ТекстБлок2_.УстановитьВерхнийОтступ(10)
        ТекстБлок2_.УстановитьНижнийОтступ(20)
        ТекстБлок2_.УстановитьЛевыйОтступ(30)
        ТекстБлок2_.УстановитьПравыйОтступ(40)
        
        top = ТекстБлок2_.ВерхнийОтступ()
        bottom = ТекстБлок2_.НижнийОтступ()
        left = ТекстБлок2_.ЛевыйОтступ()
        right = ТекстБлок2_.ПравыйОтступ()
        
        ВывестиСтрокуВКонсоль("    Отступы: верхний=" + top + ", нижний=" + bottom + ", левый=" + left + ", правый=" + right)
        ВывестиСтрокуВКонсоль("      (ожидается: 10, 20, 30, 40)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Отступы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ОТСТУП =====
    Попытка
        ТекстБлок2_.УстановитьОтступ(5)
        отступ = ТекстБлок2_.Отступ()
        ВывестиСтрокуВКонсоль("    УстановитьОтступ/Отступ: " + отступ + " (ожидается 5)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Отступ: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ТЕКСТОВЫЙ ОТСТУП =====
    Попытка
        ТекстБлок2_.УстановитьТекстовыйОтступ(8)
        текстовыйОтступ = ТекстБлок2_.ТекстовыйОтступ()
        ВывестиСтрокуВКонсоль("    УстановитьТекстовыйОтступ/ТекстовыйОтступ: " + текстовыйОтступ + " (ожидается 8)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Текстовый отступ: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ВЫСОТА СТРОКИ =====
    Попытка
        ТекстБлок2_.УстановитьВысотуСтроки(20, 1)
        высота = ТекстБлок2_.ВысотаСтроки()
        типВысоты = ТекстБлок2_.ТипВысотыСтроки()
        ВывестиСтрокуВКонсоль("    УстановитьВысотуСтроки/ВысотаСтроки: высота=" + высота + ", тип=" + типВысоты)
        ВывестиСтрокуВКонсоль("      (ожидается: 20, 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Высота строки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. НЕРАЗРЫВНЫЕ СТРОКИ =====
    Попытка
        ТекстБлок2_.УстановитьНеразрывныеСтроки(ИСТИНА)
        неразрывные = ТекстБлок2_.НеразрывныеСтроки()
        ВывестиСтрокуВКонсоль("    УстановитьНеразрывныеСтроки/НеразрывныеСтроки: " + неразрывные + " (ожидается true)")
        
        ТекстБлок2_.УстановитьНеразрывныеСтроки(ЛОЖЬ)
        неразрывные2 = ТекстБлок2_.НеразрывныеСтроки()
        ВывестиСтрокуВКонсоль("    УстановитьНеразрывныеСтроки(false)/НеразрывныеСтроки: " + неразрывные2 + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Неразрывные строки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПОЛИТИКА РАЗРЫВА СТРАНИЦЫ =====
    Попытка
        ТекстБлок2_.УстановитьПолитикуРазрываСтраницы(1)
        политика = ТекстБлок2_.ПолитикаРазрываСтраницы()
        ВывестиСтрокуВКонсоль("    УстановитьПолитикуРазрываСтраницы/ПолитикаРазрываСтраницы: " + политика + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Политика разрыва страницы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. КОПИРОВАНИЕ =====
    Попытка
        копияЦель12 = Новый QtТекстБлокФормат()
        копияЦель12.РежимОтладки(Режим_Отладки)
        успех = ТекстБлок2_.КопироватьВ(копияЦель12)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успех + " (ожидается true)")
        
        Если успех == ИСТИНА Тогда
            валидностьКопии = копияЦель12.Действителен()
            ВывестиСтрокуВКонсоль("    Копия Действителен(): " + валидностьКопии + " (ожидается true)")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 13. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    Попытка
        полученныйФормат = ТекстБлок2_.ПолучитьБлочныйФормат()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    ПолучитьБлочныйФормат(): формат получен")
            
            ТекстБлок2_.УстановитьБлочныйФормат(полученныйФормат)
            ВывестиСтрокуВКонсоль("    УстановитьБлочныйФормат(): формат установлен")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ ПолучитьБлочныйФормат(): формат НЕ получен")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Получить/Установить формат: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 14. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof ТекстБлок2_.RusFunc === 'function' Тогда
            jsonStr = ТекстБлок2_.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 15. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof ТекстБлок2_.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.type !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.alignment !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.topMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.bottomMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.leftMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.rightMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.indent !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.textIndent !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.lineHeight !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.nonBreakableLines !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.pageBreakPolicy !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.copyTo !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.getBlockFormatObject !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.setBlockFormat !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof ТекстБлок2_.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      type(): " + (typeof ТекстБлок2_.type === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof ТекстБлок2_.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      alignment(): " + (typeof ТекстБлок2_.alignment === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      topMargin(): " + (typeof ТекстБлок2_.topMargin === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      bottomMargin(): " + (typeof ТекстБлок2_.bottomMargin === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      leftMargin(): " + (typeof ТекстБлок2_.leftMargin === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      rightMargin(): " + (typeof ТекстБлок2_.rightMargin === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      indent(): " + (typeof ТекстБлок2_.indent === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      textIndent(): " + (typeof ТекстБлок2_.textIndent === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      lineHeight(): " + (typeof ТекстБлок2_.lineHeight === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      nonBreakableLines(): " + (typeof ТекстБлок2_.nonBreakableLines === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      pageBreakPolicy(): " + (typeof ТекстБлок2_.pageBreakPolicy === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      copyTo(): " + (typeof ТекстБлок2_.copyTo === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      getBlockFormatObject(): " + (typeof ТекстБлок2_.getBlockFormatObject === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setBlockFormat(): " + (typeof ТекстБлок2_.setBlockFormat === 'function' ? "✅" : "❌"))
        
        Если англРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Английские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Английские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка английских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 16. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Попытка
        русРаботают = ИСТИНА
        Если typeof ТекстБлок2_.Действителен !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.Тип !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.Пусто !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.Выравнивание !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ВерхнийОтступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.НижнийОтступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ЛевыйОтступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ПравыйОтступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.Отступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ТекстовыйОтступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ВысотаСтроки !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.НеразрывныеСтроки !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ПолитикаРазрываСтраницы !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.КопироватьВ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.ПолучитьБлочныйФормат !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстБлок2_.УстановитьБлочныйФормат !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Русские методы:")
        ВывестиСтрокуВКонсоль("      Действителен(): " + (typeof ТекстБлок2_.Действителен === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Тип(): " + (typeof ТекстБлок2_.Тип === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Пусто(): " + (typeof ТекстБлок2_.Пусто === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Выравнивание(): " + (typeof ТекстБлок2_.Выравнивание === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ВерхнийОтступ(): " + (typeof ТекстБлок2_.ВерхнийОтступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      НижнийОтступ(): " + (typeof ТекстБлок2_.НижнийОтступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ЛевыйОтступ(): " + (typeof ТекстБлок2_.ЛевыйОтступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПравыйОтступ(): " + (typeof ТекстБлок2_.ПравыйОтступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Отступ(): " + (typeof ТекстБлок2_.Отступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ТекстовыйОтступ(): " + (typeof ТекстБлок2_.ТекстовыйОтступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ВысотаСтроки(): " + (typeof ТекстБлок2_.ВысотаСтроки === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      НеразрывныеСтроки(): " + (typeof ТекстБлок2_.НеразрывныеСтроки === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПолитикаРазрываСтраницы(): " + (typeof ТекстБлок2_.ПолитикаРазрываСтраницы === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      КопироватьВ(): " + (typeof ТекстБлок2_.КопироватьВ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПолучитьБлочныйФормат(): " + (typeof ТекстБлок2_.ПолучитьБлочныйФормат === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьБлочныйФормат(): " + (typeof ТекстБлок2_.УстановитьБлочныйФормат === 'function' ? "✅" : "❌"))
        
        Если русРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Русские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Русские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка русских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("=== Диагностика QtТекстБлокФормат завершена =====================================")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстСписокФормат (QtTextListFormat)
// ============================================================

Функция Методы_QtТекстСписокФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстСписокФормат() ========================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        ТекстСп1_ = Новый QtТекстСписокФормат()
        ТекстСп1_.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    Попытка
        валидный = ТекстСп1_.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Действителен(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ТИП ФОРМАТА =====
    Попытка
        тип = ТекстСп1_.Тип()
        ВывестиСтрокуВКонсоль("    Тип(): " + тип + " (ожидается 3 - ListFormat)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Тип(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пустой = ТекстСп1_.Пусто()
        ВывестиСтрокуВКонсоль("    Пусто(): " + пустой + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пусто(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. СТИЛЬ СПИСКА =====
    Попытка
        // Проверяем все основные стили списков
        ТекстСп1_.УстановитьСтиль(1) // ListDisc
        стиль1 = ТекстСп1_.Стиль()
        ВывестиСтрокуВКонсоль("    УстановитьСтиль(1)/Стиль(): " + стиль1 + " (ожидается 1 - ListDisc)")
        
        ТекстСп1_.УстановитьСтиль(2) // ListCircle
        стиль2 = ТекстСп1_.Стиль()
        ВывестиСтрокуВКонсоль("    УстановитьСтиль(2)/Стиль(): " + стиль2 + " (ожидается 2 - ListCircle)")
        
        ТекстСп1_.УстановитьСтиль(3) // ListSquare
        стиль3 = ТекстСп1_.Стиль()
        ВывестиСтрокуВКонсоль("    УстановитьСтиль(3)/Стиль(): " + стиль3 + " (ожидается 3 - ListSquare)")
        
        ТекстСп1_.УстановитьСтиль(4) // ListDecimal
        стиль4 = ТекстСп1_.Стиль()
        ВывестиСтрокуВКонсоль("    УстановитьСтиль(4)/Стиль(): " + стиль4 + " (ожидается 4 - ListDecimal)")
        
        Если стиль1 == 1 И стиль2 == 2 И стиль3 == 3 И стиль4 == 4 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Стили списков: ВСЕ РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Стили списков: ЕСТЬ ОШИБКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Стили списков: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПРЕФИКС И СУФФИКС НОМЕРА =====
    Попытка
        ТекстСп1_.УстановитьПрефиксНомера("[")
        ТекстСп1_.УстановитьСуффиксНомера("]")
        префикс = ТекстСп1_.ПрефиксНомера()
        суффикс = ТекстСп1_.СуффиксНомера()
        ВывестиСтрокуВКонсоль("    УстановитьПрефиксНомера/ПрефиксНомера: '" + префикс + "' (ожидается '[')")
        ВывестиСтрокуВКонсоль("    УстановитьСуффиксНомера/СуффиксНомера: '" + суффикс + "' (ожидается ']')")
        
        ТекстСп1_.УстановитьПрефиксНомера("(")
        ТекстСп1_.УстановитьСуффиксНомера(")")
        префикс2 = ТекстСп1_.ПрефиксНомера()
        суффикс2 = ТекстСп1_.СуффиксНомера()
        ВывестиСтрокуВКонсоль("    Префикс: '" + префикс2 + "' (ожидается '(')")
        ВывестиСтрокуВКонсоль("    Суффикс: '" + суффикс2 + "' (ожидается ')')")
        
        Если префикс == "[" И суффикс == "]" И префикс2 == "(" И суффикс2 == ")" Тогда
            ВывестиСтрокуВКонсоль("    ✓ Префикс/суффикс: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Префикс/суффикс: ЕСТЬ ОШИБКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Префикс/суффикс: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ОТСТУП =====
    Попытка
        ТекстСп1_.УстановитьОтступ(5)
        отступ = ТекстСп1_.Отступ()
        ВывестиСтрокуВКонсоль("    УстановитьОтступ/Отступ: " + отступ + " (ожидается 5)")
        
        ТекстСп1_.УстановитьОтступ(10)
        отступ2 = ТекстСп1_.Отступ()
        ВывестиСтрокуВКонсоль("    УстановитьОтступ(10)/Отступ: " + отступ2 + " (ожидается 10)")
        
        Если отступ == 5 И отступ2 == 10 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Отступ: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Отступ: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Отступ: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. КОПИРОВАНИЕ =====
    Попытка
        копияЦель = Новый QtТекстСписокФормат()
        копияЦель.РежимОтладки(Режим_Отладки)
        успех = ТекстСп1_.КопироватьВ(копияЦель)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успех + " (ожидается true)")
        
        Если успех == ИСТИНА Тогда
            валидностьКопии = копияЦель.Действителен()
            ВывестиСтрокуВКонсоль("    Копия Действителен(): " + валидностьКопии + " (ожидается true)")
            
            // Проверяем, что данные скопировались
            стильКопии = копияЦель.Стиль()
            отступКопии = копияЦель.Отступ()
            ВывестиСтрокуВКонсоль("    Стиль копии: " + стильКопии + ", Отступ копии: " + отступКопии)
            
            Если валидностьКопии == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ Копирование: РАБОТАЕТ")
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ Копирование: НЕ РАБОТАЕТ")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Копирование: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    Попытка
        полученныйФормат = ТекстСп1_.ПолучитьФорматСписка()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    ПолучитьФорматСписка(): формат получен")
            
            ТекстСп1_.УстановитьФорматСписка(полученныйФормат)
            ВывестиСтрокуВКонсоль("    УстановитьФорматСписка(): формат установлен")
            
            // Проверяем, что формат остался действительным
            валидныйПосле = ТекстСп1_.Действителен()
            ВывестиСтрокуВКонсоль("    После установки формата Действителен(): " + валидныйПосле + " (ожидается true)")
            
            Если валидныйПосле == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ Получить/Установить формат: РАБОТАЕТ")
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ Получить/Установить формат: НЕ РАБОТАЕТ")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ ПолучитьФорматСписка(): формат НЕ получен")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Получить/Установить формат: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof ТекстСп1_.RusFunc === 'function' Тогда
            jsonStr = ТекстСп1_.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof ТекстСп1_.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.type !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.style !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.numberPrefix !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.numberSuffix !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.indent !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.copyTo !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.getListFormatObject !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.setListFormat !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof ТекстСп1_.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      type(): " + (typeof ТекстСп1_.type === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof ТекстСп1_.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      style(): " + (typeof ТекстСп1_.style === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      numberPrefix(): " + (typeof ТекстСп1_.numberPrefix === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      numberSuffix(): " + (typeof ТекстСп1_.numberSuffix === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      indent(): " + (typeof ТекстСп1_.indent === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      copyTo(): " + (typeof ТекстСп1_.copyTo === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      getListFormatObject(): " + (typeof ТекстСп1_.getListFormatObject === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      setListFormat(): " + (typeof ТекстСп1_.setListFormat === 'function' ? "✅" : "❌"))
        
        Если англРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Английские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Английские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка английских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Попытка
        русРаботают = ИСТИНА
        Если typeof ТекстСп1_.Действителен !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.Тип !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.Пусто !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.Стиль !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.ПрефиксНомера !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.СуффиксНомера !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.Отступ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.КопироватьВ !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.ПолучитьФорматСписка !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстСп1_.УстановитьФорматСписка !== 'function' Тогда русРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Русские методы:")
        ВывестиСтрокуВКонсоль("      Действителен(): " + (typeof ТекстСп1_.Действителен === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Тип(): " + (typeof ТекстСп1_.Тип === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Пусто(): " + (typeof ТекстСп1_.Пусто === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Стиль(): " + (typeof ТекстСп1_.Стиль === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПрефиксНомера(): " + (typeof ТекстСп1_.ПрефиксНомера === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      СуффиксНомера(): " + (typeof ТекстСп1_.СуффиксНомера === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      Отступ(): " + (typeof ТекстСп1_.Отступ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      КопироватьВ(): " + (typeof ТекстСп1_.КопироватьВ === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      ПолучитьФорматСписка(): " + (typeof ТекстСп1_.ПолучитьФорматСписка === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      УстановитьФорматСписка(): " + (typeof ТекстСп1_.УстановитьФорматСписка === 'function' ? "✅" : "❌"))
        
        Если русРаботают == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ Русские методы: ВСЕ ДОСТУПНЫ")
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Русские методы: ЧАСТИЧНО ДОСТУПНЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Проверка русских методов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("=== Диагностика QtТекстСписокФормат завершена ===================================")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// КРАТКАЯ ДИАГНОСТИКА QtТекстТаблицаФормат (QtTextTableFormat)
// ============================================================

Функция Методы_QtТекстТаблицаФормат()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТекстТаблицаФормат() =======================================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Попытка
        ТекстТабл1_ = Новый QtТекстТаблицаФормат()
        ТекстТабл1_.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Создание объекта: ОШИБКА - " + e)
        Возврат
    КонецПопытки
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    Попытка
        валидный = ТекстТабл1_.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Действителен(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ТИП ФОРМАТА =====
    Попытка
        тип = ТекстТабл1_.Тип()
        ВывестиСтрокуВКонсоль("    Тип(): " + тип + " (ожидается 4 - TableFormat)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Тип(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ПРОВЕРКА ПУСТОТЫ =====
    Попытка
        пустой = ТекстТабл1_.Пусто()
        ВывестиСтрокуВКонсоль("    Пусто(): " + пустой + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Пусто(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. КОЛИЧЕСТВО КОЛОНОК =====
    Попытка
        ТекстТабл1_.УстановитьКолонки(3)
        колонки = ТекстТабл1_.Колонки()
        ВывестиСтрокуВКонсоль("    УстановитьКолонки/Колонки: " + колонки + " (ожидается 3)")
        
        ТекстТабл1_.УстановитьКолонки(5)
        колонки2 = ТекстТабл1_.Колонки()
        ВывестиСтрокуВКонсоль("    УстановитьКолонки(5)/Колонки: " + колонки2 + " (ожидается 5)")
        
        Если колонки == 3 И колонки2 == 5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Количество колонок: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Количество колонок: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Количество колонок: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОТСТУПЫ ЯЧЕЕК =====
    Попытка
        ТекстТабл1_.УстановитьРасстояниеЯчеек(5.5)
        ТекстТабл1_.УстановитьОтступЯчеек(3.5)
        расстояние = ТекстТабл1_.РасстояниеЯчеек()
        отступ = ТекстТабл1_.ОтступЯчеек()
        ВывестиСтрокуВКонсоль("    РасстояниеЯчеек: " + расстояние + " (ожидается 5.5)")
        ВывестиСтрокуВКонсоль("    ОтступЯчеек: " + отступ + " (ожидается 3.5)")
        
        Если расстояние == 5.5 И отступ == 3.5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Отступы ячеек: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Отступы ячеек: НЕ РАБОТАЮТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Отступы ячеек: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ГРАНИЦЫ =====
    Попытка
        ТекстТабл1_.УстановитьГраницу(2.5)
        ТекстТабл1_.УстановитьСтильГраницы(1)
        граница = ТекстТабл1_.Граница()
        стиль = ТекстТабл1_.СтильГраницы()
        ВывестиСтрокуВКонсоль("    Граница: " + граница + " (ожидается 2.5)")
        ВывестиСтрокуВКонсоль("    СтильГраницы: " + стиль + " (ожидается 1)")
        
        Если граница == 2.5 И стиль == 1 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Границы: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Границы: НЕ РАБОТАЮТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Границы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ВЫРАВНИВАНИЕ =====
    Попытка
        ТекстТабл1_.УстановитьВыравнивание(1)
        выравнивание = ТекстТабл1_.Выравнивание()
        ВывестиСтрокуВКонсоль("    УстановитьВыравнивание/Выравнивание: " + выравнивание + " (ожидается 1)")
        
        ТекстТабл1_.УстановитьВыравнивание(2)
        выравнивание2 = ТекстТабл1_.Выравнивание()
        ВывестиСтрокуВКонсоль("    УстановитьВыравнивание(2)/Выравнивание: " + выравнивание2 + " (ожидается 2)")
        
        Если выравнивание == 1 И выравнивание2 == 2 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Выравнивание: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Выравнивание: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Выравнивание: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ОТСТУПЫ =====
    Попытка
        ТекстТабл1_.УстановитьВерхнийОтступ(10)
        ТекстТабл1_.УстановитьНижнийОтступ(20)
        ТекстТабл1_.УстановитьЛевыйОтступ(30)
        ТекстТабл1_.УстановитьПравыйОтступ(40)
        
        top = ТекстТабл1_.ВерхнийОтступ()
        bottom = ТекстТабл1_.НижнийОтступ()
        left = ТекстТабл1_.ЛевыйОтступ()
        right = ТекстТабл1_.ПравыйОтступ()
        
        ВывестиСтрокуВКонсоль("    Отступы: верхний=" + top + ", нижний=" + bottom + ", левый=" + left + ", правый=" + right)
        ВывестиСтрокуВКонсоль("      (ожидается: 10, 20, 30, 40)")
        
        Если top == 10 И bottom == 20 И left == 30 И right == 40 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Отступы: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Отступы: НЕ РАБОТАЮТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Отступы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ЗАГОЛОВОЧНЫЕ СТРОКИ =====
    Попытка
        ТекстТабл1_.УстановитьЗаголовочныеСтроки(2)
        заголовки = ТекстТабл1_.ЗаголовочныеСтроки()
        ВывестиСтрокуВКонсоль("    УстановитьЗаголовочныеСтроки/ЗаголовочныеСтроки: " + заголовки + " (ожидается 2)")
        
        ТекстТабл1_.УстановитьЗаголовочныеСтроки(3)
        заголовки2 = ТекстТабл1_.ЗаголовочныеСтроки()
        ВывестиСтрокуВКонсоль("    УстановитьЗаголовочныеСтроки(3)/ЗаголовочныеСтроки: " + заголовки2 + " (ожидается 3)")
        
        Если заголовки == 2 И заголовки2 == 3 Тогда
            ВывестиСтрокуВКонсоль("    ✓ Заголовочные строки: РАБОТАЮТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Заголовочные строки: НЕ РАБОТАЮТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Заголовочные строки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ЦВЕТ ГРАНИЦЫ =====
    Попытка
        ТекстТабл1_.УстановитьЦветГраницы("#ff0000")
        цвет = ТекстТабл1_.ЦветГраницы()
        ВывестиСтрокуВКонсоль("    УстановитьЦветГраницы/ЦветГраницы: " + цвет + " (ожидается #ff0000)")
        
        Если цвет != "" И цвет != null Тогда
            ВывестиСтрокуВКонсоль("    ✓ Цвет границы: РАБОТАЕТ")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Цвет границы: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Цвет границы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. КОПИРОВАНИЕ =====
    Попытка
        копияЦель11 = Новый QtТекстТаблицаФормат()
        копияЦель11.РежимОтладки(Режим_Отладки)
        успех = ТекстТабл1_.КопироватьВ(копияЦель11)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успех + " (ожидается true)")
        
        Если успех == ИСТИНА Тогда
            валидностьКопии = копияЦель11.Действителен()
            ВывестиСтрокуВКонсоль("    Копия Действителен(): " + валидностьКопии + " (ожидается true)")
            
            // Проверяем, что данные скопировались
            колонкиКопии = копияЦель11.Колонки()
            ВывестиСтрокуВКонсоль("    Колонки копии: " + колонкиКопии)
            
            Если валидностьКопии == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ Копирование: РАБОТАЕТ")
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ Копирование: НЕ РАБОТАЕТ")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ Копирование: НЕ РАБОТАЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 13. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    Попытка
        полученныйФормат = ТекстТабл1_.ПолучитьФорматТаблицы()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    ПолучитьФорматТаблицы(): формат получен")
            
            ТекстТабл1_.УстановитьФорматТаблицы(полученныйФормат)
            ВывестиСтрокуВКонсоль("    УстановитьФорматТаблицы(): формат установлен")
            
            // Проверяем, что формат остался действительным
            валидныйПосле = ТекстТабл1_.Действителен()
            ВывестиСтрокуВКонсоль("    После установки формата Действителен(): " + валидныйПосле + " (ожидается true)")
            
            Если валидныйПосле == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ Получить/Установить формат: РАБОТАЕТ")
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ Получить/Установить формат: НЕ РАБОТАЕТ")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ ПолучитьФорматТаблицы(): формат НЕ получен")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ Получить/Установить формат: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 14. ПРОВЕРКА RUSFUNC =====
    Попытка
        Если typeof ТекстТабл1_.RusFunc === 'function' Тогда
            jsonStr = ТекстТабл1_.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
            
            // Показываем первые 10 методов
            ВывестиСтрокуВКонсоль("    Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ RusFunc(): НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ RusFunc(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 15. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    Попытка
        англРаботают = ИСТИНА
        Если typeof ТекстТабл1_.isValid !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.type !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.isEmpty !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.columns !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.cellSpacing !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.cellPadding !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.border !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.borderStyle !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.borderColor !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.alignment !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.topMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.bottomMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.leftMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.rightMargin !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.headerRowCount !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.copyTo !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.getTableFormatObject !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        Если typeof ТекстТабл1_.setTableFormat !== 'function' Тогда англРаботают = ЛОЖЬ КонецЕсли
        
        ВывестиСтрокуВКонсоль("    Английские методы:")
        ВывестиСтрокуВКонсоль("      isValid(): " + (typeof ТекстТабл1_.isValid === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      type(): " + (typeof ТекстТабл1_.type === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      isEmpty(): " + (typeof ТекстТабл1_.isEmpty === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      columns(): " + (typeof ТекстТабл1_.columns === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      cellSpacing(): " + (typeof ТекстТабл1_.cellSpacing === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      cellPadding(): " + (typeof ТекстТабл1_.cellPadding === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      border(): " + (typeof ТекстТабл1_.border === 'function' ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("      borderStyle(): " + (typeof ТекстТабл1_.borderStyle === 'function' ? "✅" : "❌"))
