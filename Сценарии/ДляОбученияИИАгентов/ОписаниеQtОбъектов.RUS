        ВывестиСтрокуВКонсоль("    Статические методы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 17. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем цикл событий
        циклПракт17 = Новый QtЦиклСобытий()
        циклПракт17.РежимОтладки(Режим_Отладки)
        
        // Создаем блокировщик для цикла
        реальныйЦиклПракт = циклПракт17.ПолучитьОбъект()
        блокПракт = Новый QtЦиклСобытийБлокировщик(реальныйЦиклПракт)
        блокПракт.РежимОтладки(Режим_Отладки)
        
        // Проверяем состояние
        действителенПракт = блокПракт.Действителен()
        ВывестиСтрокуВКонсоль("    Практическое использование: Действителен=" + действителенПракт)
        
        // Разблокируем
        блокПракт.Разблокировать()
        действителенПосле = блокПракт.Действителен()
        ВывестиСтрокуВКонсоль("    После разблокировки: Действителен=" + действителенПосле)
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 18. ПРОВЕРКА РАЗЛИЧНЫХ КОНСТРУКТОРОВ =====
    Попытка
        // Создаем блокировщик без параметров
        блокПустой = Новый QtЦиклСобытийБлокировщик()
        блокПустой.РежимОтладки(Режим_Отладки)
        дейстПустой = блокПустой.Действителен()
        
        // Создаем блокировщик с циклом
        циклКонстр = Новый QtЦиклСобытий()
        циклКонстр.РежимОтладки(Режим_Отладки)
        реальныйЦиклКонстр = циклКонстр.ПолучитьОбъект()
        блокСЦиклом = Новый QtЦиклСобытийБлокировщик(реальныйЦиклКонстр)
        блокСЦиклом.РежимОтладки(Режим_Отладки)
        дейстСЦиклом = блокСЦиклом.Действителен()
        
        ВывестиСтрокуВКонсоль("    Разные конструкторы: пустой=" + дейстПустой + ", с циклом=" + дейстСЦиклом + " (ожидается true, true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Разные конструкторы: ОШИБКА - " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== Тест QtEventLoopLocker (QtЦиклСобытийБлокировщик) завершён.=========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции



