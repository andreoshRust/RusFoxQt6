        циклПракт.РежимОтладки(Режим_Отладки)
        
        // Проверяем состояние
        запущенПракт = циклПракт.Запущен()
        действителенПракт = циклПракт.Действителен()
        
        ВывестиСтрокуВКонсоль("    Практическое использование: запущен=" + запущенПракт + ", действителен=" + действителенПракт)
        
        // Обрабатываем события
        циклПракт.ОбработатьСобытия()
        циклПракт.ОбработатьВсеСобытия()
        
        // Выходим из цикла
        циклПракт.Выйти(0)
        ВывестиСтрокуВКонсоль("    Практическое использование: завершено успешно")
    Исключение
