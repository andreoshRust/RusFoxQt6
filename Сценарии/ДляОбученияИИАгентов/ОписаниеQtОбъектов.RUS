//│ 110 │ УдалитьВиджет                    │ removeWidget                   │
//│ 111 │ ВзятьПоИндексу                   │ takeAt                         │
//│ 112 │ ЭлементПоИндексу                 │ itemAt                         │
//│ 113 │ РодительскийВиджет               │ getParentWidget                │
//│ 114 │ УстановитьРодительскийВиджет     │ setParentWidget                │
//│ 115 │ ПолучитьБлочноеРасположение      │ getRealBoxLayout               │
//│ 116 │ ПолучитьРасположение             │ getRealLayout                  │
//│ 117 │ Расположение                     │ getRealLayout                  │
//│ 118 │ Количество                       │ getCountValue                  │
//│ 119 │ Пустой                           │ isEmptyValue                   │
//│ 120 │ Направление                      │ getDirectionValue              │
//│ 121 │ НаправлениеСтрока                │ directionString                │
//│ 122 │ Вертикальный                     │ isVerticalValue                │
//│ 123 │ Горизонтальный                   │ isHorizontalValue              │
//│ 124 │ Верт                             │ isVerticalValue                │
//│ 125 │ Гориз                            │ isHorizontalValue              │
//│ 126 │ ДобавитьВиджет                   │ addWidget                      │
//│ 127 │ ВставитьВиджет                   │ insertWidget                   │
//│ 128 │ УстановитьПромежуток             │ setSpacingValue                │
//│ 129 │ Промежуток                       │ getSpacingValue                │
//│ 130 │ УстановитьОтступ                 │ setMarginValue                 │
//│ 131 │ Отступ                           │ getMarginValue                 │
//│ 132 │ Очистить                         │ clear                          │
//│ 133 │ Активировать                     │ activate                       │
//│ 134 │ ПолучитьВертикальноеРасположение │ getRealVBoxLayout              │
//│ 135 │ ПолучитьБлочноеРасположение      │ getRealBoxLayout               │
//│ 136 │ ПолучитьРасположение             │ getRealLayout                  │
//└─────┴──────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtVBoxLayout (QtВертикальнаяКомпоновка) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ВертКомп1_1 = Новый QtВертикальнаяКомпоновка()
    ВертКомп1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ВертКомп1_1.isValid()
    валидныйРус = ВертКомп1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. НАПРАВЛЕНИЕ =====
    направление = ВертКомп1_1.Направление()
    направлениеСтр = ВертКомп1_1.НаправлениеСтрока()
    вертикальный = ВертКомп1_1.Вертикальный()
    горизонтальный = ВертКомп1_1.Горизонтальный()
    ВывестиСтрокуВКонсоль("    Направление(): " + направление + ", НаправлениеСтрока(): " + направлениеСтр)
    ВывестиСтрокуВКонсоль("    Вертикальный(): " + вертикальный + ", Горизонтальный(): " + горизонтальный)
    
    // ===== 4. МЕТОДЫ ДОБАВЛЕНИЯ =====
    имеетAddWidget = typeof ВертКомп1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof ВертКомп1_1.ДобавитьВиджет === 'function'
    имеетAddStretch = typeof ВертКомп1_1.addStretch === 'function'
    имеетДобавитьРастяжение = typeof ВертКомп1_1.ДобавитьРастяжение === 'function'
    имеетAddSpacing = typeof ВертКомп1_1.addSpacing === 'function'
    имеетДобавитьОтступ = typeof ВертКомп1_1.ДобавитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
    
    // ===== 5. МЕТОДЫ ВСТАВКИ =====
    имеетInsertWidget = typeof ВертКомп1_1.insertWidget === 'function'
    имеетВставитьВиджет = typeof ВертКомп1_1.ВставитьВиджет === 'function'
    имеетInsertStretch = typeof ВертКомп1_1.insertStretch === 'function'
    имеетВставитьРастяжение = typeof ВертКомп1_1.ВставитьРастяжение === 'function'
    имеетInsertSpacing = typeof ВертКомп1_1.insertSpacing === 'function'
    имеетВставитьОтступ = typeof ВертКомп1_1.ВставитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
    
    // ===== 6. УПРАВЛЕНИЕ РАСТЯЖЕНИЕМ =====
    Попытка
        ВертКомп1_1.УстановитьРастяжение(0, 5)
        растяжение = ВертКомп1_1.Растяжение(0)
        ВертКомп1_1.УстановитьРастяжение(0, 3)
        растяжениеРус = ВертКомп1_1.Растяжение(0)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,5) -> Растяжение(0): " + растяжение + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,3) -> Растяжение(0): " + растяжениеРус + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Управление растяжением: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. РАБОТА С ВЛОЖЕННЫМИ LAYOUT =====
    имеетAddLayout = typeof ВертКомп1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof ВертКомп1_1.ДобавитьРасположение === 'function'
    имеетInsertLayout = typeof ВертКомп1_1.insertLayout === 'function'
    имеетВставитьРасположение = typeof ВертКомп1_1.ВставитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertLayout(): " + (имеетInsertLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРасположение(): " + (имеетВставитьРасположение ? "✅" : "❌"))
    
    // ===== 8. ОТСТУПЫ, ПРОМЕЖУТКИ И ДОСТУПНОСТЬ =====
    Попытка
        ВертКомп1_1.УстановитьОтступ(10)
        отступ = ВертКомп1_1.Отступ()
        ВертКомп1_1.УстановитьОтступ(15)
        отступРус = ВертКомп1_1.Отступ()
        
        ВертКомп1_1.УстановитьПромежуток(5)
        промежуток = ВертКомп1_1.Промежуток()
        ВертКомп1_1.УстановитьПромежуток(8)
        промежутокРус = ВертКомп1_1.Промежуток()
        
        ВертКомп1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = ВертКомп1_1.Доступен()
        ВертКомп1_1.УстановитьДоступен(ИСТИНА)
        доступен2 = ВертКомп1_1.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус + " (ожидается 10 / 15)")
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус + " (ожидается 5 / 8)")
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + " -> " + доступен2 + " (ожидается false -> true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/промежутки/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = ВертКомп1_1.getRealVBoxLayout()
    реальныйРус = ВертКомп1_1.ПолучитьВертикальноеРасположение()
    реальныйLayout = ВертКомп1_1.getRealLayout()
    реальныйLayoutРус = ВертКомп1_1.ПолучитьРасположение()
    реальныйBox = ВертКомп1_1.getRealBoxLayout()
    реальныйBoxРус = ВертКомп1_1.ПолучитьБлочноеРасположение()
    ВывестиСтрокуВКонсоль("    getRealVBoxLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьВертикальноеРасположение(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальныйBox != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйBoxРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    ВертКомп1_2 = Новый QtВертикальнаяКомпоновка()
    ВертКомп1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ВертКомп1_1.copyTo(ВертКомп1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof ВертКомп1_1.RusFunc === 'function' Тогда
        jsonStr = ВертКомп1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 12. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - ОЧИСТКА =====
    имеетClear = typeof ВертКомп1_1.clear === 'function'
    имеетОчистить = typeof ВертКомп1_1.Очистить === 'function'
    ВывестиСтрокуВКонсоль("    clear(): " + (имеетClear ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    Очистить(): " + (имеетОчистить ? "✅" : "❌"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtVBoxLayout (QtВертикальнаяКомпоновка) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtГоризонтальнаяКомпоновка()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                      │ Английский метод                │
//├─────┼────────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                       │ isValid                        │
//│ 2 │ ПолучитьОбъект                     │ getRealObject                  │
//│ 3 │ УстановитьРодителя                 │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                   │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта               │ setObjectName                  │
//│ 6 │ ИмяОбъекта                         │ objectName                     │
//│ 7 │ УстановитьСвойство                 │ setProperty                    │
//│ 8 │ Свойство                           │ property                       │
//│ 9 │ ПодключитьСигнал                   │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                    │ disconnectSignal               │
//│ 11 │ КопироватьВ                        │ copyTo                         │
//│ 12 │ РежимОтладки                       │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки               │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                  │ getClassType                   │
//│ 15 │ УстановитьТипКласса                │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                  │ getClassName                   │
//│ 17 │ УстановитьИмяКласса                │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов              │ RusFunc                        │
//│ 19 │ ПолучитьРасположение               │ getRealLayout                  │
//│ 20 │ Действителен                       │ isValidValue                   │
//│ 21 │ УстановитьРодительскийВиджет       │ setParentWidget                │
//│ 22 │ РодительскийВиджет                 │ getParentWidget                │
//│ 23 │ ДобавитьВиджет                     │ addWidget                      │
//│ 24 │ ДобавитьРасположение               │ addLayout                      │
//│ 25 │ УдалитьВиджет                      │ removeWidget                   │
//│ 26 │ Очистить                           │ clear                          │
//│ 27 │ Обновить                           │ updateLayout                   │
//│ 28 │ Активировать                       │ activate                       │
//│ 29 │ Инвалидировать                     │ invalidate                     │
//│ 30 │ ЭлементПоИндексу                   │ itemAt                         │
//│ 31 │ ВзятьПоИндексу                     │ takeAt                         │
//│ 32 │ Количество                         │ getCountValue                  │
//│ 33 │ Пустой                             │ isEmptyValue                   │
//│ 34 │ Геометрия                          │ getGeometryValue               │
//│ 35 │ ПрямоугольникСодержимого           │ getContentsRectValue           │
//│ 36 │ УстановитьОтступ                   │ setMarginValue                 │
//│ 37 │ Отступ                             │ getMarginValue                 │
//│ 38 │ УстановитьЛевыйОтступ              │ setLeftMarginValue             │
//│ 39 │ ЛевыйОтступ                        │ getLeftMarginValue             │
