Функция Методы_QtБлокировкаЧтенияЗаписи()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtReadWriteLock (QtБлокировкаЧтенияЗаписи) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    БлокЧт1_1 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = БлокЧт1_1.isValid()
    валидныйРус = БлокЧт1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = БлокЧт1_1.isRecursive()
    рекурсивныйРус = БлокЧт1_1.РекурсивнаяБлокировка()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивнаяБлокировка(): " + рекурсивныйРус + " (ожидается false)")
    
    // ===== 4. БЛОКИРОВКА ДЛЯ ЧТЕНИЯ =====
    Попытка
        БлокЧт1_1.lockForRead()
        БлокЧт1_1.unlock()
        ВывестиСтрокуВКонсоль("    lockForRead/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lockForRead/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        БлокЧт1_1.ЗаблокироватьДляЧтения()
        БлокЧт1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЧтения/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЧтения/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. БЛОКИРОВКА ДЛЯ ЗАПИСИ =====
    Попытка
        БлокЧт1_1.lockForWrite()
        БлокЧт1_1.unlock()
        ВывестиСтрокуВКонсоль("    lockForWrite/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lockForWrite/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        БлокЧт1_1.ЗаблокироватьДляЗаписи()
        БлокЧт1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЗаписи/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЗаписи/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЧТЕНИЯ =====
    результат1 = БлокЧт1_1.tryLockForRead()
    Если результат1 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат2 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЧтения()
    Если результат2 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForRead(): " + результат1 + ", ПопробоватьЗаблокироватьДляЧтения(): " + результат2 + " (ожидается true)")
    
    // ===== 7. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЗАПИСИ =====
    результат3 = БлокЧт1_1.tryLockForWrite()
    Если результат3 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат4 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЗаписи()
    Если результат4 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForWrite(): " + результат3 + ", ПопробоватьЗаблокироватьДляЗаписи(): " + результат4 + " (ожидается true)")
    
    // ===== 8. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЧТЕНИЯ С ТАЙМАУТОМ =====
    результат5 = БлокЧт1_1.tryLockForReadTimeout(100)
    Если результат5 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат6 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЧтенияТаймаут(100)
    Если результат6 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForReadTimeout(100): " + результат5 + ", ПопробоватьЗаблокироватьДляЧтенияТаймаут(100): " + результат6 + " (ожидается true)")
    
    // ===== 9. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЗАПИСИ С ТАЙМАУТОМ =====
    результат7 = БлокЧт1_1.tryLockForWriteTimeout(100)
    Если результат7 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат8 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЗаписиТаймаут(100)
    Если результат8 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForWriteTimeout(100): " + результат7 + ", ПопробоватьЗаблокироватьДляЗаписиТаймаут(100): " + результат8 + " (ожидается true)")
    
    // ===== 10. КОНСТАНТЫ =====
    нерек = БлокЧт1_1.nonRecursive()
    рек = БлокЧт1_1.recursive()
    нерекРус = БлокЧт1_1.Нерекурсивный()
    рекРус = БлокЧт1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 11. РЕКУРСИВНАЯ БЛОКИРОВКА =====
    БлокЧт1_2 = Новый QtБлокировкаЧтенияЗаписи(1)
    БлокЧт1_2.РежимОтладки(Режим_Отладки)
    рек2 = БлокЧт1_2.isRecursive()
    рекРус2 = БлокЧт1_2.РекурсивнаяБлокировка()
    ВывестиСтрокуВКонсоль("    Рекурсивная блокировка -> isRecursive(): " + рек2 + ", РекурсивнаяБлокировка(): " + рекРус2 + " (ожидается true)")
    
    // ===== 12. КОПИРОВАНИЕ =====
    БлокЧт1_3 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_3.РежимОтладки(Режим_Отладки)
    БлокЧт1_3.ЗаблокироватьДляЧтения()
    БлокЧт1_4 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_4.РежимОтладки(Режим_Отладки)
    результатКопия = БлокЧт1_3.КопироватьВ(БлокЧт1_4)
    БлокЧт1_3.Разблокировать()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопия + " (ожидается true)")
    
    // ===== 13. RUSFUNC =====
    Если typeof БлокЧт1_1.RusFunc === 'function' Тогда
        jsonStr = БлокЧт1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtReadWriteLock (QtБлокировкаЧтенияЗаписи) завершён.===================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtМьютекс()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtMutex (QtМьютекс) - КОМПАКТНАЯ ВЕРСИЯ ========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА (НЕРЕКУРСИВНЫЙ) =====
    Мьютекс1_1 = Новый QtМьютекс()
    Мьютекс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта (нерекурсивный): УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Мьютекс1_1.isValid()
    валидныйРус = Мьютекс1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = Мьютекс1_1.isRecursive()
    рекурсивныйРус = Мьютекс1_1.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивныйМьютекс(): " + рекурсивныйРус + " (ожидается false)")
    
    // ===== 4. БЛОКИРОВКА И РАЗБЛОКИРОВКА =====
    Попытка
        Мьютекс1_1.lock()
        Мьютекс1_1.unlock()
        ВывестиСтрокуВКонсоль("    lock/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lock/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Мьютекс1_1.Заблокировать()
        Мьютекс1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    Заблокировать/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Заблокировать/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОПЫТКА БЛОКИРОВКИ =====
    результат1 = Мьютекс1_1.tryLock()
    Если результат1 == ИСТИНА Тогда
        Мьютекс1_1.unlock()
    КонецЕсли
    результат2 = Мьютекс1_1.ПопробоватьЗаблокировать()
    Если результат2 == ИСТИНА Тогда
        Мьютекс1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLock(): " + результат1 + ", ПопробоватьЗаблокировать(): " + результат2 + " (ожидается true)")
    
    // ===== 6. ПОПЫТКА БЛОКИРОВКИ С ТАЙМАУТОМ =====
    результат3 = Мьютекс1_1.tryLockTimeout(100)
    Если результат3 == ИСТИНА Тогда
        Мьютекс1_1.unlock()
    КонецЕсли
    результат4 = Мьютекс1_1.ПопробоватьЗаблокироватьТаймаут(100)
    Если результат4 == ИСТИНА Тогда
        Мьютекс1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockTimeout(100): " + результат3 + ", ПопробоватьЗаблокироватьТаймаут(100): " + результат4 + " (ожидается true)")
    
    // ===== 7. КОНСТАНТЫ =====
    нерек = Мьютекс1_1.nonRecursive()
    рек = Мьютекс1_1.recursive()
    нерекРус = Мьютекс1_1.Нерекурсивный()
    рекРус = Мьютекс1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 8. РЕКУРСИВНЫЙ МЬЮТЕКС =====
    Мьютекс1_2 = Новый QtМьютекс(1)
    Мьютекс1_2.РежимОтладки(Режим_Отладки)
    Мьютекс1_2.lock()
    Мьютекс1_2.lock()
    Мьютекс1_2.unlock()
    Мьютекс1_2.unlock()
    рек2 = Мьютекс1_2.isRecursive()
    рекРус2 = Мьютекс1_2.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    Рекурсивный мьютекс -> isRecursive(): " + рек2 + ", РекурсивныйМьютекс(): " + рекРус2 + " (ожидается true)")
    
    // ===== 9. КОПИРОВАНИЕ =====
    Мьютекс1_3 = Новый QtМьютекс()
    Мьютекс1_3.РежимОтладки(Режим_Отладки)
    результатКопия = Мьютекс1_1.copyTo(Мьютекс1_3)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Мьютекс1_4 = Новый QtМьютекс()
    Мьютекс1_4.РежимОтладки(Режим_Отладки)
    результатКопияРус = Мьютекс1_1.КопироватьВ(Мьютекс1_4)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // Проверяем валидность копии
    валидныйКопия = Мьютекс1_3.isValid()
    валидныйКопияРус = Мьютекс1_4.Действителен()
    ВывестиСтрокуВКонсоль("    Копия isValid(): " + валидныйКопия + ", Копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 10. RUSFUNC =====
    Если typeof Мьютекс1_1.RusFunc === 'function' Тогда
        jsonStr = Мьютекс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtMutex (QtМьютекс) завершён.===========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtНаблюдательБудущего()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtFutureWatcher (QtНаблюдательБудущего) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Набл1_1 = Новый QtНаблюдательБудущего()
    Набл1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Набл1_1.isValid()
    валидныйРус = Набл1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. СОСТОЯНИЕ НОВОГО НАБЛЮДАТЕЛЯ =====
    запущен = Набл1_1.isStarted()
    выполняется = Набл1_1.isRunning()
    завершён = Набл1_1.isFinished()
    запущенРус = Набл1_1.Запущен()
    выполняетсяРус = Набл1_1.Выполняется()
    завершёнРус = Набл1_1.Завершён()
    ВывестиСтрокуВКонсоль("    isStarted(): " + запущен + ", isRunning(): " + выполняется + ", isFinished(): " + завершён + " (ожидается true, false, true)")
    ВывестиСтрокуВКонсоль("    Запущен(): " + запущенРус + ", Выполняется(): " + выполняетсяРус + ", Завершён(): " + завершёнРус + " (ожидается true, false, true)")
    
    // ===== 4. ПРОГРЕСС =====
    мин = Набл1_1.progressMinimum()
    макс = Набл1_1.progressMaximum()
    значение = Набл1_1.progressValue()
    текст = Набл1_1.progressText()
    минРус = Набл1_1.ПрогрессМинимум()
    максРус = Набл1_1.ПрогрессМаксимум()
    значениеРус = Набл1_1.Прогресс()
    текстРус = Набл1_1.ТекстПрогресса()
    ВывестиСтрокуВКонсоль("    progressMinimum(): " + мин + ", progressMaximum(): " + макс + ", progressValue(): " + значение + ", progressText(): '" + текст + "'")
    ВывестиСтрокуВКонсоль("    ПрогрессМинимум(): " + минРус + ", ПрогрессМаксимум(): " + максРус + ", Прогресс(): " + значениеРус + ", ТекстПрогресса(): '" + текстРус + "'")
    
    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО НАБЛЮДАТЕЛЯ =====
    реальный = Набл1_1.getRealWatcher()
    реальныйРус = Набл1_1.ПолучитьНаблюдателя()
    ВывестиСтрокуВКонсоль("    getRealWatcher(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьНаблюдателя(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. УСТАНОВКА КОЛБЭКОВ =====
    Попытка
        Набл1_1.onStarted(function() {
            // Пустой колбэк
        })
        Набл1_1.onFinished(function() {
            // Пустой колбэк
        })
        Набл1_1.onProgressValueChanged(function(value) {
            // Пустой колбэк
        })
        ВывестиСтрокуВКонсоль("    onStarted(), onFinished(), onProgressValueChanged(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    onStarted/onFinished/onProgressValueChanged: ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Набл1_1.ПриЗапуске(function() {
            // Пустой колбэк
        })
        Набл1_1.ПриЗавершении(function() {
            // Пустой колбэк
        })
        Набл1_1.ПриИзмененииПрогресса(function(value) {
            // Пустой колбэк
        })
        ВывестиСтрокуВКонсоль("    ПриЗапуске(), ПриЗавершении(), ПриИзмененииПрогресса(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ПриЗапуске/ПриЗавершении/ПриИзмененииПрогресса: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. КОПИРОВАНИЕ =====
    Набл1_2 = Новый QtНаблюдательБудущего()
    Набл1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Набл1_1.copyTo(Набл1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Набл1_3 = Новый QtНаблюдательБудущего()
    Набл1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Набл1_1.КопироватьВ(Набл1_3)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // Проверяем валидность копии
    валидныйКопия = Набл1_2.isValid()
    валидныйКопияРус = Набл1_3.Действителен()
    ВывестиСтрокуВКонсоль("    Копия isValid(): " + валидныйКопия + ", Копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof Набл1_1.RusFunc === 'function' Тогда
        jsonStr = Набл1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtFutureWatcher (QtНаблюдательБудущего) завершён.=====================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПараллельный()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtConcurrentRunner (QtПараллельный) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Парал1_1 = Новый QtПараллельный()
    Парал1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Парал1_1.isValid()
    валидныйРус = Парал1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ЗАПУСК АСИНХРОННО =====
    выполнено = ЛОЖЬ
    функция1 = function() {
        выполнено = ИСТИНА
    }
    watcher1 = Парал1_1.runAsync(функция1)
    Если watcher1 != null Тогда
        watcher1.waitForFinished()
    КонецЕсли
    
    выполненоРус = ЛОЖЬ
    функцияРус = function() {        выполненоРус = ИСТИНА    }
    watcher2 = Парал1_1.ЗапуститьАсинхронно(функцияРус)
    Если watcher2 != null Тогда
        watcher2.waitForFinished()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("    runAsync(): " + (выполнено == ИСТИНА ? "УСПЕШНО" : "НЕ ВЫПОЛНЕНО") + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ЗапуститьАсинхронно(): " + (выполненоРус == ИСТИНА ? "УСПЕШНО" : "НЕ ВЫПОЛНЕНО") + " (ожидается true)")
    
    // ===== 4. ОБРАБОТКА МАССИВА =====
    обработаноИндексов = 0
    массив = [1, 2, 3, 4, 5]
    функцияМассив = function(item, index) {        обработаноИндексов = обработаноИндексов + 1    }
    watcher3 = Парал1_1.processArray(массив, функцияМассив)
    Если watcher3 != null Тогда
        watcher3.waitForFinished()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    processArray(): обработано " + обработаноИндексов + " элементов (ожидается 5)")
    
    обработаноИндексовРус = 0
    массивРус = [10, 20, 30, 40, 50]
    функцияМассивРус = function(item, index) {        обработаноИндексовРус = обработаноИндексовРус + 1    }
    watcher4 = Парал1_1.ОбработатьМассив(массивРус, функцияМассивРус)
    Если watcher4 != null Тогда
        watcher4.waitForFinished()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("    ОбработатьМассив(): обработано " + обработаноИндексовРус + " элементов (ожидается 5)")
    
    // ===== 5. КОПИРОВАНИЕ =====
    Парал1_2 = Новый QtПараллельный()
    Парал1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Парал1_1.copyTo(Парал1_2)
    валидныйКопия = Парал1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): , копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Парал1_3 = Новый QtПараллельный()
    Парал1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Парал1_1.КопироватьВ(Парал1_3)
    валидныйКопияРус = Парал1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 6. RUSFUNC =====
    Если typeof Парал1_1.RusFunc === 'function' Тогда
        jsonStr = Парал1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtConcurrentRunner (QtПараллельный) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtРекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtRecursiveMutex (QtРекурсивныйМьютекс) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Рекурс1_1 = Новый QtРекурсивныйМьютекс()
    Рекурс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Рекурс1_1.isValid()
    валидныйРус = Рекурс1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = Рекурс1_1.isRecursive()
    рекурсивныйРус = Рекурс1_1.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивныйМьютекс(): " + рекурсивныйРус + " (ожидается true)")
    
    // ===== 4. МНОЖЕСТВЕННАЯ БЛОКИРОВКА (РЕКУРСИВНАЯ) =====
    Попытка
        Рекурс1_1.lock()
        Рекурс1_1.lock()
        Рекурс1_1.unlock()
        Рекурс1_1.unlock()
        ВывестиСтрокуВКонсоль("    lock/lock/unlock/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lock/lock/unlock/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Рекурс1_1.Заблокировать()
        Рекурс1_1.Заблокировать()
        Рекурс1_1.Разблокировать()
        Рекурс1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    Заблокировать/Заблокировать/Разблокировать/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Заблокировать/Заблокировать/Разблокировать/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО РЕКУРСИВНОГО МЬЮТЕКСА =====
    реальный = Рекурс1_1.getRealRecursiveMutex()
    реальныйРус = Рекурс1_1.ПолучитьРекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    getRealRecursiveMutex(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРекурсивныйМьютекс(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. КОНСТАНТЫ =====
    нерек = Рекурс1_1.nonRecursive()
    рек = Рекурс1_1.recursive()
    нерекРус = Рекурс1_1.Нерекурсивный()
    рекРус = Рекурс1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 7. КОПИРОВАНИЕ =====
    Рекурс1_2 = Новый QtРекурсивныйМьютекс()
    Рекурс1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Рекурс1_1.copyTo(Рекурс1_2)
    валидныйКопия = Рекурс1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Рекурс1_3 = Новый QtРекурсивныйМьютекс()
    Рекурс1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Рекурс1_1.КопироватьВ(Рекурс1_3)
    валидныйКопияРус = Рекурс1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof Рекурс1_1.RusFunc === 'function' Тогда
        jsonStr = Рекурс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
   
    ВывестиСтрокуВКонсоль("==== Тест QtRecursiveMutex (QtРекурсивныйМьютекс) завершён.======================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСемафор()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSemaphore (QtСемафор) - КОМПАКТНАЯ ВЕРСИЯ ====================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Семаф1_1 = Новый QtСемафор()
    Семаф1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Семаф1_1.isValid()
    валидныйРус = Семаф1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ДОСТУПНО РЕСУРСОВ =====
    доступно = Семаф1_1.available()
    доступноРус = Семаф1_1.Доступно()
    ВывестиСтрокуВКонсоль("    available(): " + доступно + ", Доступно(): " + доступноРус + " (ожидается 0)")
    
    // ===== 4. ОСВОБОЖДЕНИЕ РЕСУРСОВ =====
    Попытка
        Семаф1_1.release()
        Семаф1_1.release(2)
        доступно = Семаф1_1.available()
        ВывестиСтрокуВКонсоль("    release() + release(2) -> available(): " + доступно + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    release(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Семаф1_1.Освободить()
        Семаф1_1.Освободить(2)
        доступноРус = Семаф1_1.Доступно()
        ВывестиСтрокуВКонсоль("    Освободить() + Освободить(2) -> Доступно(): " + доступноРус + " (ожидается 6)")
    Исключение
        ВывестиСтрокуВКонсоль("    Освободить(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ЗАХВАТ РЕСУРСОВ =====
    Попытка
        Семаф1_1.acquire()
        Семаф1_1.acquire(2)
        доступно = Семаф1_1.available()
        ВывестиСтрокуВКонсоль("    acquire() + acquire(2) -> available(): " + доступно + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    acquire(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Семаф1_1.Захватить()
        Семаф1_1.Захватить(2)
        доступноРус = Семаф1_1.Доступно()
        ВывестиСтрокуВКонсоль("    Захватить() + Захватить(2) -> Доступно(): " + доступноРус + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Захватить(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПОПЫТКА ЗАХВАТА =====
    Семаф1_1.release(3)
    результат = Семаф1_1.tryAcquire()
    ВывестиСтрокуВКонсоль("    tryAcquire(): " + результат + " (ожидается true)")
    Семаф1_1.Освободить(3)
    результатРус = Семаф1_1.ПопробоватьЗахватить()
    ВывестиСтрокуВКонсоль("    ПопробоватьЗахватить(): " + результатРус + " (ожидается true)")
    
    // ===== 7. ПОПЫТКА ЗАХВАТА С ТАЙМАУТОМ =====
    Семаф1_1.release(2)
    результат = Семаф1_1.tryAcquireTimeout(1, 100)
    ВывестиСтрокуВКонсоль("    tryAcquireTimeout(1,100): " + результат + " (ожидается true)")
    Семаф1_1.Освободить(2)
    результатРус = Семаф1_1.ПопробоватьЗахватитьТаймаут(1, 100)
    ВывестиСтрокуВКонсоль("    ПопробоватьЗахватитьТаймаут(1,100): " + результатРус + " (ожидается true)")
    
    // ===== 8. СОЗДАНИЕ С НАЧАЛЬНЫМ ЗНАЧЕНИЕМ =====
    Семаф1_2 = Новый QtСемафор(5)
    Семаф1_2.РежимОтладки(Режим_Отладки)
    доступно2 = Семаф1_2.available()
    ВывестиСтрокуВКонсоль("    QtSemaphore(5) -> available(): " + доступно2 + " (ожидается 5)")
    
    Семаф1_3 = Новый QtСемафор(10)
    Семаф1_3.РежимОтладки(Режим_Отладки)
    доступноРус2 = Семаф1_3.Доступно()
    ВывестиСтрокуВКонсоль("    QtСемафор(10) -> Доступно(): " + доступноРус2 + " (ожидается 10)")
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СЕМАФОРА =====
    реальный = Семаф1_1.getRealSemaphore()
    реальныйРус = Семаф1_1.ПолучитьСемафор()
    ВывестиСтрокуВКонсоль("    getRealSemaphore(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьСемафор(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    Семаф1_4 = Новый QtСемафор()
    Семаф1_4.РежимОтладки(Режим_Отладки)
    результатКопия = Семаф1_1.copyTo(Семаф1_4)
    валидныйКопия = Семаф1_4.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Семаф1_5 = Новый QtСемафор()
    Семаф1_5.РежимОтладки(Режим_Отладки)
    результатКопияРус = Семаф1_1.КопироватьВ(Семаф1_5)
    валидныйКопияРус = Семаф1_5.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Семаф1_1.RusFunc === 'function' Тогда
        jsonStr = Семаф1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSemaphore (QtСемафор) завершён.======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtУсловнаяПеременная()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtWaitCondition (QtУсловнаяПеременная) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    УслПерем1_1 = Новый QtУсловнаяПеременная()
    УслПерем1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = УслПерем1_1.isValid()
    валидныйРус = УслПерем1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ РЕАЛЬНОЙ УСЛОВНОЙ ПЕРЕМЕННОЙ =====
    реальная = УслПерем1_1.getRealCondition()
    реальнаяРус = УслПерем1_1.ПолучитьУсловнуюПеременную()
    ВывестиСтрокуВКонсоль("    getRealCondition(): " + (реальная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьУсловнуюПеременную(): " + (реальнаяРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. РАЗБУДИТЬ ОДНОГО И ВСЕХ =====
    Попытка
        УслПерем1_1.wakeOne()
        УслПерем1_1.wakeAll()
        ВывестиСтрокуВКонсоль("    wakeOne/wakeAll(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    wakeOne/wakeAll(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        УслПерем1_1.РазбудитьОдного()
        УслПерем1_1.РазбудитьВсех()
        ВывестиСтрокуВКонсоль("    РазбудитьОдного/РазбудитьВсех(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    РазбудитьОдного/РазбудитьВсех(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ОЖИДАНИЕ (С МЬЮТЕКСОМ) =====
    тестМьютекс = Новый QtМьютекс()
    тестМьютекс.РежимОтладки(Режим_Отладки)
    реальныйМьютекс = тестМьютекс.getRealMutex()
    Если реальныйМьютекс != null Тогда
        ВывестиСтрокуВКонсоль("    wait(): метод " + (typeof УслПерем1_1.wait === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    wait(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    тестМьютексРус = Новый QtМьютекс()
    тестМьютексРус.РежимОтладки(Режим_Отладки)
    реальныйМьютексРус = тестМьютексРус.ПолучитьМьютекс()
    Если реальныйМьютексРус != null Тогда
        ВывестиСтрокуВКонсоль("    Ожидать(): метод " + (typeof УслПерем1_1.Ожидать === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    Ожидать(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    // ===== 6. ОЖИДАНИЕ С ТАЙМАУТОМ =====
    тестМьютекс2 = Новый QtМьютекс()
    тестМьютекс2.РежимОтладки(Режим_Отладки)
    реальныйМьютекс2 = тестМьютекс2.getRealMutex()
    Если реальныйМьютекс2 != null Тогда
        ВывестиСтрокуВКонсоль("    waitTimeout(): метод " + (typeof УслПерем1_1.waitTimeout === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    waitTimeout(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    тестМьютекс2Рус = Новый QtМьютекс()
    тестМьютекс2Рус.РежимОтладки(Режим_Отладки)
    реальныйМьютекс2Рус = тестМьютекс2Рус.ПолучитьМьютекс()
    Если реальныйМьютекс2Рус != null Тогда
        ВывестиСтрокуВКонсоль("    ОжидатьТаймаут(): метод " + (typeof УслПерем1_1.ОжидатьТаймаут === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    ОжидатьТаймаут(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    // ===== 7. КОПИРОВАНИЕ =====
    УслПерем1_2 = Новый QtУсловнаяПеременная()
    УслПерем1_2.РежимОтладки(Режим_Отладки)
    результатКопия = УслПерем1_1.copyTo(УслПерем1_2)
    валидныйКопия = УслПерем1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    УслПерем1_3 = Новый QtУсловнаяПеременная()
    УслПерем1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = УслПерем1_1.КопироватьВ(УслПерем1_3)
    валидныйКопияРус = УслПерем1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof УслПерем1_1.RusFunc === 'function' Тогда
        jsonStr = УслПерем1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtWaitCondition (QtУсловнаяПеременная) завершён.======================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtОбщийСтиль()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtCommonStyle (QtОбщийСтиль) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ОбщСтиль1_1 = Новый QtОбщийСтиль()
    ОбщСтиль1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ОбщСтиль1_1.isValid()
    валидныйРус = ОбщСтиль1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ ИМЕНИ СТИЛЯ =====
    имя = ОбщСтиль1_1.getName()
    имяРус = ОбщСтиль1_1.Имя()
    ВывестиСтрокуВКонсоль("    getName(): " + имя + ", Имя(): " + имяРус + " (ожидается не пусто)")
    
    // ===== 4. ПИКСЕЛЬНЫЙ РАЗМЕР =====
    размер = ОбщСтиль1_1.pixelMetric(0)
    размерРус = ОбщСтиль1_1.ПиксельныйРазмер(0)
    ВывестиСтрокуВКонсоль("    pixelMetric(0): " + размер + ", ПиксельныйРазмер(0): " + размерРус + " (ожидается >= 0)")
    
    // ===== 5. ПРОВЕРКА НАТИВНОСТИ СТИЛЯ =====
    нативный = ОбщСтиль1_1.isNativeStyleValue()
    нативныйРус = ОбщСтиль1_1.Нативный()
    ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный + ", Нативный(): " + нативныйРус + " (ожидается false)")
    
    // ===== 6. СТАНДАРТНАЯ ИКОНКА =====
    иконка = ОбщСтиль1_1.standardIcon(0)
    иконкаРус = ОбщСтиль1_1.СтандартнаяИконка(0)
    ВывестиСтрокуВКонсоль("    standardIcon(0): " + (иконка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН") + ", СтандартнаяИконка(0): " + (иконкаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 7. КОПИРОВАНИЕ =====
    ОбщСтиль1_2 = Новый QtОбщийСтиль()
    ОбщСтиль1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ОбщСтиль1_1.copyTo(ОбщСтиль1_2)
    валидныйКопия = ОбщСтиль1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    ОбщСтиль1_3 = Новый QtОбщийСтиль()
    ОбщСтиль1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = ОбщСтиль1_1.КопироватьВ(ОбщСтиль1_3)
    валидныйКопияРус = ОбщСтиль1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЩЕГО СТИЛЯ =====
    реальный = ОбщСтиль1_1.getRealCommonStyle()
    реальныйРус = ОбщСтиль1_1.ПолучитьОбщийСтиль()
    ВывестиСтрокуВКонсоль("    getRealCommonStyle(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьОбщийСтиль(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СТИЛЯ (QStyle) =====
    реальныйСтиль = ОбщСтиль1_1.getRealStyle()
    реальныйСтильРус = ОбщСтиль1_1.ПолучитьСтиль()
    ВывестиСтрокуВКонсоль("    getRealStyle(): " + (реальныйСтиль != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьСтиль(): " + (реальныйСтильРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. РАЗМЕР ИЗ СОДЕРЖИМОГО =====
    Попытка
        размерQt = Новый QtРазмер(50, 20)
        результатРазмер = ОбщСтиль1_1.sizeFromContents(0, null, размерQt)
        ширина = результатРазмер.Ширина()
        высота = результатРазмер.Высота()
        ВывестиСтрокуВКонсоль("    sizeFromContents(0): " + ширина + "x" + высота)
    Исключение
        ВывестиСтрокуВКонсоль("    sizeFromContents(): " + (typeof ОбщСтиль1_1.sizeFromContents === 'function' ? "МЕТОД СУЩЕСТВУЕТ (тест пропущен)" : "НЕ ДОСТУПЕН"))
    КонецПопытки
    
    Попытка
        размерQtРус = Новый QtРазмер(50, 20)
        результатРазмерРус = ОбщСтиль1_1.РазмерИзСодержимого(0, null, размерQtРус)
        ширинаРус = результатРазмерРус.Ширина()
        высотаРус = результатРазмерРус.Высота()
        ВывестиСтрокуВКонсоль("    РазмерИзСодержимого(0): " + ширинаРус + "x" + высотаРус)
    Исключение
        ВывестиСтрокуВКонсоль("    РазмерИзСодержимого(): " + (typeof ОбщСтиль1_1.РазмерИзСодержимого === 'function' ? "МЕТОД СУЩЕСТВУЕТ (тест пропущен)" : "НЕ ДОСТУПЕН"))
    КонецПопытки
    
    // ===== 11. RUSFUNC =====
    Если typeof ОбщСтиль1_1.RusFunc === 'function' Тогда
        jsonStr = ОбщСтиль1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtCommonStyle (QtОбщийСтиль) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПроксиСтиль()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtProxyStyle (QtПроксиСтиль) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ПроксиСтиль1_1 = Новый QtПроксиСтиль()
    ПроксиСтиль1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ПроксиСтиль1_1.isValid()
    валидныйРус = ПроксиСтиль1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ ИМЕНИ СТИЛЯ =====
    имя = ПроксиСтиль1_1.getName()
    имяРус = ПроксиСтиль1_1.Имя()
    ВывестиСтрокуВКонсоль("    getName(): " + имя + ", Имя(): " + имяРус + " (ожидается не пусто)")
    
    // ===== 4. РАБОТА С БАЗОВЫМ СТИЛЕМ =====
    базовый = ПроксиСтиль1_1.getBaseStyle()
    базовыйРус = ПроксиСтиль1_1.БазовыйСтиль()
    ВывестиСтрокуВКонсоль("    getBaseStyle(): " + (базовый != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    БазовыйСтиль(): " + (базовыйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 5. ОБЁРТКА БАЗОВОГО СТИЛЯ =====
    обёртка = ПроксиСтиль1_1.getBaseStyleWrapper()
    обёрткаРус = ПроксиСтиль1_1.БазовыйСтильОбёртка()
    ВывестиСтрокуВКонсоль("    getBaseStyleWrapper(): " + (обёртка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    БазовыйСтильОбёртка(): " + (обёрткаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. ПИКСЕЛЬНЫЙ РАЗМЕР =====
    размер = ПроксиСтиль1_1.pixelMetric(0)
    размерРус = ПроксиСтиль1_1.ПиксельныйРазмер(0)
    ВывестиСтрокуВКонсоль("    pixelMetric(0): " + размер + ", ПиксельныйРазмер(0): " + размерРус + " (ожидается >= 0)")
    
    // ===== 7. ПРОВЕРКА НАТИВНОСТИ СТИЛЯ =====
    нативный = ПроксиСтиль1_1.isNativeStyleValue()
    нативныйРус = ПроксиСтиль1_1.НативныйСтиль()
    ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный + ", НативныйСтиль(): " + нативныйРус)
    
    // ===== 8. СТАНДАРТНАЯ ИКОНКА =====
    иконка = ПроксиСтиль1_1.standardIcon(0)
    иконкаРус = ПроксиСтиль1_1.СтандартнаяИконка(0)
    ВывестиСтрокуВКонсоль("    standardIcon(0): " + (иконка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    СтандартнаяИконка(0): " + (иконкаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. КОПИРОВАНИЕ =====
    ПроксиСтиль1_2 = Новый QtПроксиСтиль()
    ПроксиСтиль1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ПроксиСтиль1_1.copyTo(ПроксиСтиль1_2)
    валидныйКопия = ПроксиСтиль1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    ПроксиСтиль1_3 = Новый QtПроксиСтиль()
    ПроксиСтиль1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = ПроксиСтиль1_1.КопироватьВ(ПроксиСтиль1_3)
    валидныйКопияРус = ПроксиСтиль1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ПРОКСИ-СТИЛЯ =====
    реальный = ПроксиСтиль1_1.getRealProxyStyle()
    реальныйРус = ПроксиСтиль1_1.ПолучитьПроксиСтиль()
    ВывестиСтрокуВКонсоль("    getRealProxyStyle(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьПроксиСтиль(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
   
    // ===== 12. RUSFUNC =====
    Если typeof ПроксиСтиль1_1.RusFunc === 'function' Тогда
        jsonStr = ПроксиСтиль1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtProxyStyle (QtПроксиСтиль) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

