//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//│ 49 │ ОткрытьПорт                    │ openPort                       │
//│ 50 │ ЗакрытьПорт                    │ closePort                      │
//│ 51 │ Открыт                         │ isOpenDevice                   │
//│ 52 │ Подключен                      │ isConnected                    │
//│ 53 │ Очистить                       │ clear                          │
//│ 54 │ Прервать                       │ abort                          │
//│ 55 │ УстановитьИмяПорта             │ setPortName                    │
//│ 56 │ ПолучитьИмяПорта               │ getPortName                    │
//│ 57 │ УстановитьСкорость             │ setBaudRate                    │
//│ 58 │ ПолучитьСкорость               │ getBaudRate                    │
//│ 59 │ УстановитьБитыДанных           │ setDataBits                    │
//│ 60 │ ПолучитьБитыДанных             │ getDataBits                    │
//│ 61 │ УстановитьЧетность             │ setParity                      │
//│ 62 │ ПолучитьЧетность               │ getParity                      │
//│ 63 │ УстановитьСтопБиты             │ setStopBits                    │
//│ 64 │ ПолучитьСтопБиты               │ getStopBits                    │
//│ 65 │ УстановитьУправлениеПотоком    │ setFlowControl                 │
//│ 66 │ ПолучитьУправлениеПотоком      │ getFlowControl                 │
//│ 67 │ ДоступноБайт                   │ bytesAvailable                 │
//│ 68 │ ДоступноБайтДляЗаписи          │ bytesToWrite                   │
//│ 69 │ ПрочитатьВсе                   │ readAll                        │
//│ 70 │ Прочитать                      │ read                           │
