    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 13. ПРОВЕРКА RUSFUNC =====
    Если typeof ЦиклСоб1_1.RusFunc === 'function' Тогда
