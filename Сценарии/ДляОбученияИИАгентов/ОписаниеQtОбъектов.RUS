    имеетВыйтиСКодом = typeof ЦиклСоб1_1.Выйти === 'function'
    имеетОбработатьСобытия = typeof ЦиклСоб1_1.ОбработатьСобытия === 'function'
    имеетОбработатьВсеСобытия = typeof ЦиклСоб1_1.ОбработатьВсеСобытия === 'function'
    имеетОбработатьОжидающиеСобытия = typeof ЦиклСоб1_1.ОбработатьОжидающиеСобытия === 'function'
    имеетКопироватьВ = typeof ЦиклСоб1_1.КопироватьВ === 'function'
