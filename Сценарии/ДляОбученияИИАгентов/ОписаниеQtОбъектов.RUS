    параметры.name = "Иван"
    параметры.age = 30
    параметры.city = "Москва"
    Адрес1_5.УстановитьПараметрыЗапроса(параметры)
    полученные = Адрес1_5.ПараметрыЗапроса()
    ВывестиСтрокуВКонсоль("    УстановитьПараметрыЗапроса({name:'Иван', age:30, city:'Москва'})")
    ВывестиСтрокуВКонсоль("    ПараметрыЗапроса(): name=" + полученные.name + ", age=" + полученные.age + ", city=" + полученные.city)
    
    // ===== 7. ПРЕОБРАЗОВАНИЯ =====
    Адрес1_6 = Новый QtАдрес()
    Адрес1_6.РежимОтладки(Режим_Отладки)
    Адрес1_6.Установить("https://example.com/path/to/page")
    стр6_1 = Адрес1_6.ВСтроку()
    стр6_2 = Адрес1_6.ВОтображаемуюСтроку()
    стр6_3 = Адрес1_6.ВЗакодированный()
    ВывестиСтрокуВКонсоль("    ВСтроку(): " + стр6_1)
    ВывестиСтрокуВКонсоль("    ВОтображаемуюСтроку(): " + стр6_2)
    ВывестиСтрокуВКонсоль("    ВЗакодированный(): " + стр6_3)
    
    // ===== 8. РАЗРЕШЕНИЕ ОТНОСИТЕЛЬНОГО АДРЕСА =====
    Адрес1_7 = Новый QtАдрес()
    Адрес1_7.РежимОтладки(Режим_Отладки)
    Адрес1_7.Установить("https://example.com/path/")
    разрешенный = Адрес1_7.Разрешить("sub/page.html")
    стр8 = разрешенный.toStringValue()
    ВывестиСтрокуВКонсоль("    Разрешить('sub/page.html'): " + стр8 + " (ожидается https://example.com/path/sub/page.html)")
    
    // ===== 9. КОРРЕКТИРОВКА АДРЕСА =====
    Адрес1_8 = Новый QtАдрес()
    Адрес1_8.РежимОтладки(Режим_Отладки)
    Адрес1_8.Установить("https://user:pass@example.com:8080/path/page?query=value#fragment")
    опции = Адрес1_8.УдалитьПорт()
    скорректированный = Адрес1_8.Скорректировать(опции)
    стр9 = скорректированный.toStringValue()
    ВывестиСтрокуВКонсоль("    УдалитьПорт() -> Скорректировать(): " + стр9 + " (порт удален)")
    
    // ===== 10. ИЗ ЛОКАЛЬНОГО ФАЙЛА =====
    Адрес1_9 = Новый QtАдрес()
    Адрес1_9.РежимОтладки(Режим_Отладки)
