    действителенРус = ЦиклСобБл1_1.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен: " + действителен + "/" + действителенРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА ВАЛИДНОСТИ =====
    валид = ЦиклСобБл1_1.isValid()
    валидРус = ЦиклСобБл1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валид + ", Действителен(): " + валидРус + " (ожидается true)")
    
    // ===== 4. СОЗДАНИЕ С QEVENTLOOP =====
    Попытка
        цикл4 = Новый QtЦиклСобытий()
        цикл4.РежимОтладки(Режим_Отладки)
        
        // Получаем реальный объект QEventLoop
        реальныйЦикл = цикл4.ПолучитьОбъект()
        ЦиклСобБл1_2 = Новый QtЦиклСобытийБлокировщик(реальныйЦикл)
        ЦиклСобБл1_2.РежимОтладки(Режим_Отладки)
        
        действителен2 = ЦиклСобБл1_2.Действителен()
        ВывестиСтрокуВКонсоль("    Создание с QEventLoop: Действителен=" + действителен2 + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Создание с QEventLoop: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. СОЗДАНИЕ С QTHREAD =====
    Попытка
        поток = Новый QtПоток()
