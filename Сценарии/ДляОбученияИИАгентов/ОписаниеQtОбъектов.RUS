Функция Методы_QtВебСокет()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtWebSocket (QtВебСокет) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ВебСок1_1 = Новый QtWebSocket()
    ВебСок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = ВебСок1_1.Состояние()
    состояниеСтр = ВебСок1_1.СостояниеСтрокой()
    подключено = ВебСок1_1.isConnected()
    действителен = ВебСок1_1.Действителен()
    неПодкл = ВебСок1_1.НеПодключено()
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + "), НеПодключено: " + неПодкл + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    isConnected(): " + подключено + " (ожидается false), Действителен(): " + действителен + " (ожидается false)")
    
    // ===== 3. МЕТОДЫ УПРАВЛЕНИЯ =====
    ВывестиСтрокуВКонсоль("    Открыть(): " + (typeof ВебСок1_1.Открыть === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Закрыть(): " + (typeof ВебСок1_1.Закрыть === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Прервать(): " + (typeof ВебСок1_1.Прервать === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. МЕТОДЫ ОТПРАВКИ =====
    ВывестиСтрокуВКонсоль("    ОтправитьТекст(): " + (typeof ВебСок1_1.ОтправитьТекст === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьДанные(): " + (typeof ВебСок1_1.ОтправитьДанные === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьПинг(): " + (typeof ВебСок1_1.ОтправитьПинг === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьПонг(): " + (typeof ВебСок1_1.ОтправитьПонг === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    
    // ===== 5. ИНФОРМАЦИЯ ОБ АДРЕСЕ =====
    локАдрес = ВебСок1_1.ЛокальныйАдрес()
    локПорт = ВебСок1_1.ЛокальныйПорт()
    имяУдал = ВебСок1_1.ИмяУдаленного()
    портУдал = ВебСок1_1.ПортУдаленного()
    стрОшибки = ВебСок1_1.СтрокаОшибки()
    ВывестиСтрокуВКонсоль("    ЛокальныйАдрес(): " + локАдрес + ", ЛокальныйПорт(): " + локПорт)
    ВывестиСтрокуВКонсоль("    ИмяУдаленного(): " + имяУдал + ", ПортУдаленного(): " + портУдал)
    ВывестиСтрокуВКонсоль("    СтрокаОшибки(): " + стрОшибки)
    
    // ===== 6. КОНСТАНТЫ СОСТОЯНИЙ =====
    поиск = ВебСок1_1.ПоискХоста()
    подкл = ВебСок1_1.Подключается()
    подключ = ВебСок1_1.Подключено()
    прив = ВебСок1_1.Привязан()
    прослуш = ВебСок1_1.Прослушивание()
    закр = ВебСок1_1.Закрывается()
    ВывестиСтрокуВКонсоль("    ПоискХоста: " + поиск + " (ожидается 1), Подключается: " + подкл + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    Подключено: " + подключ + " (ожидается 3), Привязан: " + прив + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    Прослушивание: " + прослуш + " (ожидается 5), Закрывается: " + закр + " (ожидается 6)")
    
    // ===== 7. КОНСТАНТЫ КОДОВ ЗАКРЫТИЯ =====
    кодНорм = ВебСок1_1.КодНормально()
    кодУход = ВебСок1_1.КодУход()
    кодПротокол = ВебСок1_1.КодОшибкаПротокола()
    кодПолитика = ВебСок1_1.КодПолитикаНарушена()
    кодTLS = ВебСок1_1.КодTLSОшибкаРукопожатия()
    ВывестиСтрокуВКонсоль("    КодНормально: " + кодНорм + " (ожидается 1000)")
    ВывестиСтрокуВКонсоль("    КодУход: " + кодУход + " (ожидается 1001)")
    ВывестиСтрокуВКонсоль("    КодОшибкаПротокола: " + кодПротокол + " (ожидается 1002)")
    ВывестиСтрокуВКонсоль("    КодПолитикаНарушена: " + кодПолитика + " (ожидается 1008)")
    ВывестиСтрокуВКонсоль("    КодTLSОшибкаРукопожатия: " + кодTLS + " (ожидается 1015)")
    
    // ===== 8. ЗАКРЫТИЕ С КОДОМ =====
    Попытка
        ВебСок1_1.Закрыть(1000, "Нормальное закрытие")
        состояниеПосле = ВебСок1_1.Состояние()
        ВывестиСтрокуВКонсоль("    Закрыть(1000) -> Состояние: " + состояниеПосле + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Закрыть(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПРОВЕРКА ДЕЙСТВИТЕЛЕН =====
    действителен2 = ВебСок1_1.Действителен()
    ВебСок1_2 = Новый QtWebSocket()
    действителен3 = ВебСок1_2.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен (текущий): " + действителен2 + ", Действителен (новый): " + действителен3 + " (ожидается false)")
    
    // ===== 10. КОЛБЭКИ =====
    Проверка1 = typeof ВебСок1_1.ПриПодключении === 'function' && typeof ВебСок1_1.ПриОтключении === 'function' && typeof ВебСок1_1.ПриПолученииТекста === 'function'
    Проверка2 = typeof ВебСок1_1.ПриПолученииДанных === 'function' && typeof ВебСок1_1.ПриОшибке === 'function' && typeof ВебСок1_1.ПриИзмененииСостояния === 'function'
    Проверка3 = typeof ВебСок1_1.ПриОтправкеДанных === 'function'
    ВывестиСтрокуВКонсоль("    Колбэки: " + (Проверка1 && Проверка2 && Проверка3 ? "ВСЕ ДОСТУПНЫ" : "НЕ ВСЕ ДОСТУПНЫ"))
    
    // ===== 11. НАСТРОЙКА БУФЕРА ЧТЕНИЯ =====
    ВебСок1_1.УстановитьРазмерБуфераЧтения(8192)
    размер = ВебСок1_1.РазмерБуфераЧтения()
    ВывестиСтрокуВКонсоль("    УстановитьРазмерБуфераЧтения(8192) -> РазмерБуфераЧтения(): " + размер + " (ожидается 8192)")
    
    // ===== 12. RUSFUNC =====
    Если typeof ВебСок1_1.RusFunc === 'function' Тогда
        jsonStr = ВебСок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtWebSocket (QtВебСокет) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПроцесс()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtProcess (QtПроцесс) - КОМПАКТНАЯ ВЕРСИЯ ======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Процесс1_1 = Новый QtПроцесс()
    Процесс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. УСТАНОВКА ПРОГРАММЫ И АРГУМЕНТОВ =====
    Процесс1_1.УстановитьПрограмму("cmd.exe")
    Процесс1_1.УстановитьАргументы(["/c", "echo", "Hello"])
    программа = Процесс1_1.ПолучитьПрограмму()
    аргументы = Процесс1_1.ПолучитьАргументы()
    ВывестиСтрокуВКонсоль("    Программа: " + программа + ", Аргументы: " + аргументы.join(", "))
    
    // ===== 3. ЗАПУСК ПРОЦЕССА =====
    Процесс1_2 = Новый QtПроцесс()
    Процесс1_2.РежимОтладки(Режим_Отладки)
    Процесс1_2.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Hello World"])
    Процесс1_2.ЖдатьЗавершения(5000)
    завершен = Процесс1_2.Завершен()
    состояние = Процесс1_2.ПолучитьСостояние()
    ВывестиСтрокуВКонсоль("    ЗапуститьПроцесс() -> Завершен: " + завершен + ", Состояние: " + состояние)
    
    // ===== 4. ЧТЕНИЕ ВЫВОДА =====
    Процесс1_3 = Новый QtПроцесс()
    Процесс1_3.РежимОтладки(Режим_Отладки)
    Процесс1_3.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Test Output"])
    Процесс1_3.ЖдатьЗавершения(5000)
    вывод = Процесс1_3.ПрочитатьТекстВывода()
    ВывестиСтрокуВКонсоль("    ПрочитатьТекстВывода(): " + вывод + " (содержит 'Test Output')")
    
    // ===== 5. КОД ВЫХОДА =====
    Процесс1_4 = Новый QtПроцесс()
    Процесс1_4.РежимОтладки(Режим_Отладки)
    Процесс1_4.ЗапуститьПроцесс("cmd.exe", ["/c", "exit 0"])
    Процесс1_4.ЖдатьЗавершения(5000)
    кодВыхода = Процесс1_4.ПолучитьКодВыхода()
    статусВыхода = Процесс1_4.ПолучитьСтатусВыхода()
    нормальный = (статусВыхода == 0)
    ВывестиСтрокуВКонсоль("    ПолучитьКодВыхода(): " + кодВыхода + " (ожидается 0), Нормальный выход: " + нормальный + " (ожидается true)")
    
    // ===== 6. ОБРАБОТКА ОШИБОК =====
    Процесс1_5 = Новый QtПроцесс()
    Процесс1_5.РежимОтладки(Режим_Отладки)
    Процесс1_5.ЗапуститьПроцесс("nonexistent_program.exe")
    Процесс1_5.ЖдатьЗавершения(5000)
    кодОшибки = Процесс1_5.ПолучитьОшибку()
    текстОшибки = Процесс1_5.ПолучитьТекстОшибки()
    ВывестиСтрокуВКонсоль("    ПолучитьОшибку(): " + кодОшибки + ", ПолучитьТекстОшибки(): " + текстОшибки + " (ожидается не пусто)")
    
    // ===== 7. ЗАПИСЬ В ПРОЦЕСС =====
    Процесс1_6 = Новый QtПроцесс()
    Процесс1_6.РежимОтладки(Режим_Отладки)
    Процесс1_6.ЗапуститьПроцесс("cmd.exe")
    Процесс1_6.ЖдатьЗапуска(5000)
    Если Процесс1_6.isRunning() Тогда
        Процесс1_6.ЗаписатьСтроку("echo Hello from process")
        Процесс1_6.ЗаписатьСтроку("exit")
        Процесс1_6.ЗакрытьКаналЗаписи()
        Процесс1_6.ЖдатьЗавершения(5000)
        вывод6 = Процесс1_6.ПрочитатьТекстВывода()
        ВывестиСтрокуВКонсоль("    ЗаписатьСтроку() -> вывод: " + вывод6 + " (содержит 'Hello from process')")
    Иначе
        ВывестиСтрокуВКонсоль("    Запись в процесс: ПРОПУЩЕНО (процесс не запустился)")
    КонецЕсли
    
    // ===== 8. РАБОЧАЯ ДИРЕКТОРИЯ =====
    Процесс1_7 = Новый QtПроцесс()
    Процесс1_7.РежимОтладки(Режим_Отладки)
    Процесс1_7.УстановитьРабочийКаталог("C:/")
    рабочий = Процесс1_7.ПолучитьРабочийКаталог()
    ВывестиСтрокуВКонсоль("    УстановитьРабочийКаталог('C:/') -> ПолучитьРабочийКаталог(): " + рабочий + " (ожидается C:/)")
    
    // ===== 9. РЕЖИМ КАНАЛОВ =====
    Процесс1_8 = Новый QtПроцесс()
    Процесс1_8.РежимОтладки(Режим_Отладки)
    режим = Процесс1_8.MergedChannels()
    Процесс1_8.УстановитьРежимКаналов(режим)
    получРежим = Процесс1_8.ПолучитьРежимКаналов()
    ВывестиСтрокуВКонсоль("    УстановитьРежимКаналов(" + режим + ") -> ПолучитьРежимКаналов(): " + получРежим)
    
    // ===== 10. ЗАПУСК ОТДЕЛЕННОГО ПРОЦЕССА =====
    Процесс1_9 = Новый QtПроцесс()
    Процесс1_9.РежимОтладки(Режим_Отладки)
    результат = Процесс1_9.ЗапуститьОтделенный("cmd.exe", ["/c", "echo detached"])
    ВывестиСтрокуВКонсоль("    ЗапуститьОтделенный(): " + результат + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Процесс1_1.RusFunc === 'function' Тогда
        jsonStr = Процесс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtProcess (QtПроцесс) завершён.=======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonRpcStdioКлиент()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonRpcStdioClient - КОМПАКТНАЯ ВЕРСИЯ =======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    RpcStd1_1 = Новый QtJsonRpcStdioКлиент()
    RpcStd1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. НАСТРОЙКА КОЛБЭКОВ =====
    Попытка
        RpcStd1_1.ПриЗапуске(Функция() {
            ВывестиСтрокуВКонсоль("    >> Gateway запущен")
        })
        RpcStd1_1.ПриОстановке(Функция() {
            ВывестиСтрокуВКонсоль("    >> Gateway остановлен")
        })
        RpcStd1_1.ПриОшибке(Функция(ошибка) {
            ВывестиСтрокуВКонсоль("    >> Ошибка: " + ошибка)
        })
        RpcStd1_1.ПриУведомлении(Функция(метод, параметры) {
            ВывестиСтрокуВКонсоль("    >> Уведомление: " + метод)
        })
        ВывестиСтрокуВКонсоль("    Колбэки установлены: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Колбэки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ПРОВЕРКА СОСТОЯНИЯ =====
    запущен = RpcStd1_1.Запущен()
    ВывестиСтрокуВКонсоль("    Запущен(): " + запущен + " (ожидается false)")
    
    // ===== 4. ВЫЗОВ МЕТОДА БЕЗ ЗАПУСКА =====
    колбэкВызван = ЛОЖЬ
    id = RpcStd1_1.ВызватьМетод("test.method", null, Функция(успех, ошибка, результат) {
        колбэкВызван = ИСТИНА
    })
    ВывестиСтрокуВКонсоль("    ВызватьМетод('test.method') без запуска: " + id + " (ожидается -1)")
    
    // ===== 5. ОТПРАВКА УВЕДОМЛЕНИЯ =====
    Попытка
        RpcStd1_1.ОтправитьУведомление("test.notification", null)
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОСТАНОВКА =====
    Попытка
        RpcStd1_1.ОстановитьШлюз()
        ВывестиСтрокуВКонсоль("    ОстановитьШлюз(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ОстановитьШлюз(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. RUSFUNC =====
    Если typeof RpcStd1_1.RusFunc === 'function' Тогда
        jsonStr = RpcStd1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtJsonRpcStdioClient завершён.========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtIOУстройство()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtIODevice (QtIOУстройство) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Устр1_1 = Новый QtIODeviceTest()
    Устр1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    режим = Устр1_1.ReadWrite()
    Устр1_1.ОткрытьУстройство(режим)
    открыто = Устр1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ОткрытьУстройство(ReadWrite) -> УстройствоОткрыто(): " + открыто + " (ожидается true)")
    Устр1_1.ЗакрытьУстройство()
    открытоПосле = Устр1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ЗакрытьУстройство() -> УстройствоОткрыто(): " + открытоПосле + " (ожидается false)")
    
    // ===== 3. ЧТЕНИЕ =====
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    Устр1_1.ОчиститьБуфер()
    Устр1_1.ДобавитьВБуфер("Тестовые данные для чтения\nСтрока 2\nСтрока 3")
    Устр1_1.СброситьУстройство()
    размер = Устр1_1.Размер()
    доступно = Устр1_1.ДоступноДанных()
    прочитано = Устр1_1.ПрочитатьВсеДанные()
    прочитаноСтрока = прочитано.toString()
    ВывестиСтрокуВКонсоль("    Размер(): " + размер + ", ДоступноДанных(): " + доступно)
    ВывестиСтрокуВКонсоль("    ПрочитатьВсеДанные(): " + прочитаноСтрока + " (ожидается не пусто)")
    
    // ===== 4. ЗАПИСЬ =====
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    Устр1_1.ОчиститьБуфер()
    записано1 = Устр1_1.ЗаписатьДанные("Hello World")
    записано2 = Устр1_1.ЗаписатьСтроку("Line 2")
    записано3 = Устр1_1.ЗаписатьСимвол('!')
    буфер = Устр1_1.ПолучитьБуфер()
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('Hello World'): " + записано1 + " байт")
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('Line 2'): " + записано2 + " байт")
    ВывестиСтрокуВКонсоль("    ЗаписатьСимвол('!'): " + записано3)
    ВывестиСтрокуВКонсоль("    ПолучитьБуфер(): " + буфер + " (содержит 'Hello WorldLine 2!')")
    
    // ===== 5. ПОЗИЦИОНИРОВАНИЕ =====
    Устр1_1.ОчиститьБуфер()
    Устр1_1.ДобавитьВБуфер("0123456789")
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    позиция = Устр1_1.Позиция()
    размер = Устр1_1.Размер()
    ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
    Устр1_1.ПерейтиВ(5)
    позиция2 = Устр1_1.Позиция()
    ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция2 + " (ожидается 5)")
    Устр1_1.СброситьУстройство()
    позиция3 = Устр1_1.Позиция()
    ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + позиция3 + " (ожидается 0)")
    вконце = Устр1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце(): " + вконце)
    
    // ===== 6. ОШИБКИ =====
    Устр1_1.УстановитьТекстОшибки("Тестовая ошибка")
    ошибка = Устр1_1.ТекстОшибки()
    ВывестиСтрокуВКонсоль("    УстановитьТекстОшибки('Тестовая ошибка') -> ТекстОшибки(): " + ошибка + " (ожидается 'Тестовая ошибка')")
    
    // ===== 7. RUSFUNC =====
    Если typeof Устр1_1.RusFunc === 'function' Тогда
        jsonStr = Устр1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtIODevice (QtIOУстройство) завершён.================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtSSLСокет()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSslSocket (QtSSLСокет) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    SSLСокет1_1 = Новый QtSslSocket()
    SSLСокет1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = SSLСокет1_1.ПолучитьСостояние()
    состояниеСтр = SSLСокет1_1.СостояниеСтрокой()
    подключен = SSLСокет1_1.Подключен()
    зашифрован = SSLСокет1_1.Зашифрован()
    валидный = SSLСокет1_1.Валидный()
    неПодключен = SSLСокет1_1.НеПодключен()
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + "), НеПодключен: " + неПодключен + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Подключен: " + подключен + " (ожидается false), Зашифрован: " + зашифрован + " (ожидается false), Валидный: " + валидный + " (ожидается true)")
    
    // ===== 3. АДРЕСА =====
    локАдрес = SSLСокет1_1.ЛокальныйАдрес()
    локПорт = SSLСокет1_1.ЛокальныйПорт()
    ВывестиСтрокуВКонсоль("    ЛокальныйАдрес(): " + локАдрес + ", ЛокальныйПорт(): " + локПорт)
    
    // ===== 4. SSL НАСТРОЙКИ =====
    протокол = SSLСокет1_1.БезопасныеПротоколы()
    SSLСокет1_1.УстановитьПротокол(протокол)
    полученныйПротокол = SSLСокет1_1.ПолучитьПротокол()
    ВывестиСтрокуВКонсоль("    УстановитьПротокол(БезопасныеПротоколы) -> ПолучитьПротокол(): " + полученныйПротокол)
    режим = SSLСокет1_1.Проверять()
    SSLСокет1_1.УстановитьРежимПроверки(режим)
    полученныйРежим = SSLСокет1_1.ПолучитьРежимПроверки()
    ВывестиСтрокуВКонсоль("    УстановитьРежимПроверки(Проверять) -> ПолучитьРежимПроверки(): " + полученныйРежим)
    
    // ===== 5. ЗАПИСЬ (без подключения) =====
    результатЗапись = SSLСокет1_1.ЗаписатьДанные("test")
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('test'): " + результатЗапись + " (ожидается -1)")
    
    // ===== 6. ЧТЕНИЕ (без подключения) =====
    данные = SSLСокет1_1.ПрочитатьВсе()
    ВывестиСтрокуВКонсоль("    ПрочитатьВсе(): '" + данные + "' (ожидается пустая строка)")
    
    // ===== 7. ДЕСКРИПТОР =====
    дескриптор = SSLСокет1_1.Дескриптор()
    ВывестиСтрокуВКонсоль("    Дескриптор(): " + дескриптор + " (ожидается -1 для не открытого)")
    
    // ===== 8. КОНСТАНТЫ СОСТОЯНИЙ =====
    поискХоста = SSLСокет1_1.ПоискХоста()
    подключение = SSLСокет1_1.Подключение()
    подключен2 = SSLСокет1_1.Подключен()
    связан = SSLСокет1_1.Связан()
    прослушивание = SSLСокет1_1.Прослушивание()
    закрытие = SSLСокет1_1.Закрытие()
    ВывестиСтрокуВКонсоль("    ПоискХоста: " + поискХоста + ", Подключение: " + подключение + ", Подключен: " + подключен2)
    ВывестиСтрокуВКонсоль("    Связан: " + связан + ", Прослушивание: " + прослушивание + ", Закрытие: " + закрытие)
    
    // ===== 9. КОНСТАНТЫ ПРОТОКОЛОВ =====
    tls10 = SSLСокет1_1.TLSv1_0()
    tls11 = SSLСокет1_1.TLSv1_1()
    tls12 = SSLСокет1_1.TLSv1_2()
    tls13 = SSLСокет1_1.TLSv1_3()
    любой = SSLСокет1_1.ЛюбойПротокол()
    безопасный = SSLСокет1_1.БезопасныеПротоколы()
    ВывестиСтрокуВКонсоль("    TLSv1_0: " + tls10 + ", TLSv1_1: " + tls11 + ", TLSv1_2: " + tls12 + ", TLSv1_3: " + tls13)
    ВывестиСтрокуВКонсоль("    ЛюбойПротокол: " + любой + ", БезопасныеПротоколы: " + безопасный)
    
    // ===== 10. КОНСТАНТЫ ПРОВЕРКИ =====
    verifyNone = SSLСокет1_1.НеПроверять()
    verifyPeer = SSLСокет1_1.Проверять()
    ВывестиСтрокуВКонсоль("    НеПроверять: " + verifyNone + ", Проверять: " + verifyPeer)
    
    // ===== 11. SSL ОШИБКИ =====
    Попытка
        SSLСокет1_1.ИгнорироватьSSLOшибки()
        ошибки = SSLСокет1_1.ПолучитьSSLОшибки()
        ВывестиСтрокуВКонсоль("    ИгнорироватьSSLOшибки() -> ПолучитьSSLОшибки(): " + (ошибки == "" ? "пусто" : ошибки))
    Исключение
        ВывестиСтрокуВКонсоль("    SSL ошибки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. РЕАЛЬНЫЙ ОБЪЕКТ =====
    реал = SSLСокет1_1.ПолучитьSslСокет()
    ВывестиСтрокуВКонсоль("    ПолучитьSslСокет(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 13. ОЖИДАНИЯ =====
    ожид1 = SSLСокет1_1.ОжидатьПодключения(100)
    ожид2 = SSLСокет1_1.ОжидатьОтключения(100)
    ожид3 = SSLСокет1_1.ОжидатьГотовностиЧтения(100)
    ожид4 = SSLСокет1_1.ОжидатьОтправки(100)
    ожид5 = SSLСокет1_1.ОжидатьШифрования(100)
    ВывестиСтрокуВКонсоль("    ОжидатьПодключения(100): " + ожид1 + ", ОжидатьОтключения(100): " + ожид2)
    ВывестиСтрокуВКонсоль("    ОжидатьГотовностиЧтения(100): " + ожид3 + ", ОжидатьОтправки(100): " + ожид4 + ", ОжидатьШифрования(100): " + ожид5)
    
    // ===== 14. RUSFUNC =====
    Если typeof SSLСокет1_1.RusFunc === 'function' Тогда
        jsonStr = SSLСокет1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSslSocket (QtSSLСокет) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtTcpСокет()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtTcpSocket (QtTcpСокет) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    TCPСок1_1 = Новый QtTcpSocket()
    TCPСок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = TCPСок1_1.ПолучитьСостояние()
    состояниеСтр = TCPСок1_1.СостояниеСтрокой()
    подключен = TCPСок1_1.Подключен()
    валидный = TCPСок1_1.Валидный()
    // Для не подключенного сокета состояние 0
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ") (ожидается 0 - UnconnectedState)")
    ВывестиСтрокуВКонсоль("    Подключен: " + подключен + " (ожидается false), Валидный: " + валидный + " (ожидается true)")
    
    // ===== 3. АДРЕСА =====
    локАдрес = TCPСок1_1.ЛокальныйАдрес()
    локПорт = TCPСок1_1.ЛокальныйПорт()
    адресПиера = TCPСок1_1.АдресПиера()
    портПиера = TCPСок1_1.ПортПиера()
    ВывестиСтрокуВКонсоль("    ЛокальныйАдрес(): " + локАдрес + ", ЛокальныйПорт(): " + локПорт)
    ВывестиСтрокуВКонсоль("    АдресПиера(): " + адресПиера + ", ПортПиера(): " + портПиера)
    
    // ===== 4. ЗАПИСЬ (без подключения) =====
    результатЗапись = TCPСок1_1.ЗаписатьДанные("test")
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('test'): " + результатЗапись + " (ожидается -1)")
    
    // ===== 5. ЧТЕНИЕ (без подключения) =====
    данные = TCPСок1_1.ПрочитатьВсе()
    ВывестиСтрокуВКонсоль("    ПрочитатьВсе(): '" + данные + "' (ожидается пустая строка)")
    
    // ===== 6. ДЕСКРИПТОР =====
    дескриптор = TCPСок1_1.ПолучитьДескриптор()
    ВывестиСтрокуВКонсоль("    ПолучитьДескриптор(): " + дескриптор + " (ожидается -1)")
    
    // ===== 7. МЕТОДЫ ОЖИДАНИЯ =====
    ожид1 = TCPСок1_1.ОжидатьПодключения(100)
    ожид2 = TCPСок1_1.ОжидатьОтключения(100)
    ожид3 = TCPСок1_1.ОжидатьЧтения(100)
    ожид4 = TCPСок1_1.ОжидатьЗаписи(100)
    ожид5 = TCPСок1_1.ЖдатьПодключения(100)
    ожид6 = TCPСок1_1.ЖдатьОтключения(100)
    ВывестиСтрокуВКонсоль("    ОжидатьПодключения(100): " + ожид1 + ", ОжидатьОтключения(100): " + ожид2)
    ВывестиСтрокуВКонсоль("    ОжидатьЧтения(100): " + ожид3 + ", ОжидатьЗаписи(100): " + ожид4)
    ВывестиСтрокуВКонсоль("    ЖдатьПодключения(100): " + ожид5 + ", ЖдатьОтключения(100): " + ожид6)
    
    // ===== 8. РЕАЛЬНЫЙ ОБЪЕКТ =====
    реал = TCPСок1_1.ПолучитьTcpСокет()
    ВывестиСтрокуВКонсоль("    ПолучитьTcpСокет(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    доступно = TCPСок1_1.ДоступноБайт()
    можноЧитать = TCPСок1_1.МожноЧитатьСтроку()
    открыто = TCPСок1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ДоступноБайт(): " + доступно + ", МожноЧитатьСтроку(): " + можноЧитать + ", УстройствоОткрыто(): " + открыто)
    
    // ===== 10. RUSFUNC =====
    Если typeof TCPСок1_1.RusFunc === 'function' Тогда
        jsonStr = TCPСок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtTcpSocket (QtTcpСокет) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtUdpСокет()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtUdpSocket (QtUdpСокет) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    UdpСокет1_1 = Новый QtUdpSocket()
    UdpСокет1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = UdpСокет1_1.ПолучитьСостояние()
    состояниеСтр = UdpСокет1_1.СостояниеСтрокой()
    привязан = UdpСокет1_1.Привязан()
    валидный = UdpСокет1_1.Валидный()
    // Для не привязанного сокета состояние 0 (UnconnectedState)
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ") (ожидается 0 - UnconnectedState)")
    ВывестиСтрокуВКонсоль("    Привязан: " + привязан + " (ожидается false), Валидный: " + валидный + " (ожидается true)")
    
    // ===== 3. АДРЕСА =====
    локАдрес = UdpСокет1_1.ЛокальныйАдрес()
    локПорт = UdpСокет1_1.ЛокальныйПорт()
    ВывестиСтрокуВКонсоль("    ЛокальныйАдрес(): " + локАдрес + ", ЛокальныйПорт(): " + локПорт)
    
    // ===== 4. ПРИВЯЗКА К ПОРТУ =====
    результатПривязки = UdpСокет1_1.ПривязатьКПорту(0)
    привязан2 = UdpСокет1_1.Привязан()
    локПорт2 = UdpСокет1_1.ЛокальныйПорт()
    ВывестиСтрокуВКонсоль("    ПривязатьКПорту(0): " + результатПривязки + ", Привязан(): " + привязан2 + ", ЛокальныйПорт(): " + локПорт2)
    
    // ===== 5. ОТПРАВКА =====
    результатОтправки = UdpСокет1_1.ОтправитьНаАдрес("127.0.0.1", 9999, "test message")
    ВывестиСтрокуВКонсоль("    ОтправитьНаАдрес('127.0.0.1', 9999, 'test message'): " + результатОтправки)
    
    // ===== 6. ЧТЕНИЕ =====
    естьДатаграммы = UdpСокет1_1.ЕстьДатаграммы()
    данные = UdpСокет1_1.ПрочитатьВсеДанные()
    ВывестиСтрокуВКонсоль("    ЕстьДатаграммы(): " + естьДатаграммы + ", ПрочитатьВсеДанные(): '" + данные + "'")
    
    // ===== 7. ДЕСКРИПТОР =====
    дескриптор = UdpСокет1_1.ПолучитьДескриптор()
    ВывестиСтрокуВКонсоль("    ПолучитьДескриптор(): " + дескриптор)
    
    // ===== 8. КОНСТАНТЫ СОСТОЯНИЙ =====
    Подключен = UdpСокет1_1.Подключен()
    ВывестиСтрокуВКонсоль("    НеПодключен: " + Подключен + " (ожидается 0)")
    
    // ===== 9. МУЛЬТИКАСТ МЕТОДЫ =====
    Попытка
        UdpСокет1_1.УстановитьМультикастИнтерфейс("0.0.0.0")
        размерБуфера = UdpСокет1_1.РазмерБуфера()
        UdpСокет1_1.УстановитьРазмерБуфера(65536)
        размерБуфера2 = UdpСокет1_1.РазмерБуфера()
        ВывестиСтрокуВКонсоль("    УстановитьМультикастИнтерфейс(): УСПЕШНО")
        ВывестиСтрокуВКонсоль("    РазмерБуфера(): " + размерБуфера + ", УстановитьРазмерБуфера(65536) -> РазмерБуфера(): " + размерБуфера2)
    Исключение
        ВывестиСтрокуВКонсоль("    Мультикаст методы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. РЕАЛЬНЫЙ ОБЪЕКТ =====
    реал = UdpСокет1_1.ПолучитьUdpСокет()
    ВывестиСтрокуВКонсоль("    ПолучитьUdpСокет(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. ЗАКРЫТИЕ =====
    Попытка
        UdpСокет1_1.Закрыть()
        ВывестиСтрокуВКонсоль("    Закрыть(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Закрыть(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. RUSFUNC =====
    Если typeof UdpСокет1_1.RusFunc === 'function' Тогда
        jsonStr = UdpСокет1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtUdpSocket (QtUdpСокет) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБуфер()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBuffer (QtБуфер) - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Буф1_1 = Новый QtБуфер()
    Буф1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. БАЗОВЫЕ СВОЙСТВА =====
    размер = Буф1_1.Размер()
    ВывестиСтрокуВКонсоль("    Размер(): " + размер + " (ожидается 0)")
    
    // ===== 3. ОТКРЫТИЕ БУФЕРА =====
    результатОткрытия = Буф1_1.ОткрытьБуфер(Буф1_1.ReadOnly() | Буф1_1.ReadWrite())
    открыто = Буф1_1.БуферОткрыт()
    ВывестиСтрокуВКонсоль("    ОткрытьБуфер(ReadOnly|ReadWrite): " + результатОткрытия + ", БуферОткрыт(): " + открыто + " (ожидается true)")
    
    // ===== 4. ЗАПИСЬ СТРОКИ =====
    тестСтрока = "Hello World!"
    записано = Буф1_1.ЗаписатьДанные(тестСтрока)
    размер2 = Буф1_1.Размер()
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('" + тестСтрока + "'): " + записано + " байт, Размер(): " + размер2 + " (ожидается > 0)")
    
    // ===== 5. ЧТЕНИЕ ДАННЫХ =====
    Буф1_1.СброситьУстройство()
    текст = Буф1_1.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ПолучитьТекст(): '" + текст + "' (ожидается 'Hello World!')")
    
    // ===== 6. ЗАПИСЬ СИМВОЛА =====
    Буф1_1.СброситьУстройство()
    Буф1_1.ОчиститьБуфер()
    результатСимвол = Буф1_1.ЗаписатьСимвол('X')
    Буф1_1.СброситьУстройство()
    символ = Буф1_1.ПрочитатьСимвол()
    ВывестиСтрокуВКонсоль("    ЗаписатьСимвол('X'): " + результатСимвол + ", ПрочитатьСимвол(): '" + символ + "' (ожидается 'X')")
    
    // ===== 7. ПОЗИЦИОНИРОВАНИЕ =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьСтроку("0123456789")
    Буф1_1.СброситьУстройство()
    позицияНач = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    Позиция(): " + позицияНач + " (ожидается 0)")
    Буф1_1.ПерейтиВ(5)
    позиция5 = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция5 + " (ожидается 5)")
    Буф1_1.СброситьУстройство()
    позицияСброс = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + позицияСброс + " (ожидается 0)")
    
    // ===== 8. КОНЕЦ БУФЕРА =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьДанные("12345")
    Буф1_1.СброситьУстройство()
    вКонце = Буф1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце() в начале: " + вКонце + " (ожидается false)")
    Буф1_1.ПерейтиВ(5)
    вКонце2 = Буф1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце() в позиции 5: " + вКонце2 + " (ожидается true)")
    
    // ===== 9. ДОСТУПНЫЕ ДАННЫЕ =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьСтроку("Test Data 123")
    Буф1_1.СброситьУстройство()
    доступно = Буф1_1.ДоступноДанных()
    ВывестиСтрокуВКонсоль("    ДоступноДанных(): " + доступно + " (ожидается > 0)")
    Буф1_1.ПрочитатьДанные(5)
    доступно2 = Буф1_1.ДоступноДанных()
    ВывестиСтрокуВКонсоль("    После чтения 5 байт: " + доступно2 + " (ожидается меньше " + доступно + ")")
    
    // ===== 10. ЗАКРЫТИЕ БУФЕРА =====
    Буф1_1.ЗакрытьБуфер()
    открыто2 = Буф1_1.БуферОткрыт()
    ВывестиСтрокуВКонсоль("    ЗакрытьБуфер() -> БуферОткрыт(): " + открыто2 + " (ожидается false)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Буф1_1.RusFunc === 'function' Тогда
        jsonStr = Буф1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBuffer (QtБуфер) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБуферУстройство()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBufferDevice (QtБуферУстройство) - КОМПАКТНАЯ ВЕРСИЯ ======")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Буф2_1 = Новый QtБуферУстройство()
    Буф2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПОЛУЧЕНИЕ УСТРОЙСТВА =====
    устройство = Буф2_1.ПолучитьУстройство()
    ВывестиСтрокуВКонсоль("    ПолучитьУстройство(): " + (устройство != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 3. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    результат = Буф2_1.Открыть(Буф2_1.ReadWrite() | Буф2_1.Truncate())
    открыто = Буф2_1.Открыто()
    ВывестиСтрокуВКонсоль("    Открыть(ReadWrite|Truncate): " + результат + ", Открыто(): " + открыто + " (ожидается true)")
    Буф2_1.Закрыть()
    закрыто = Буф2_1.Открыто()
    ВывестиСтрокуВКонсоль("    Закрыть() -> Открыто(): " + закрыто + " (ожидается false)")
    
    // ===== 4. ЗАПИСЬ И ЧТЕНИЕ =====
    Буф2_2 = Новый QtБуферУстройство()
    Буф2_2.РежимОтладки(Режим_Отладки)
    Буф2_2.Открыть(Буф2_2.ReadWrite() | Буф2_2.Truncate())
    тестТекст = "Hello World!"
    записано = Буф2_2.ЗаписатьСтроку(тестТекст)
    размер = Буф2_2.ПолучитьРазмер()
    Буф2_2.Сбросить()
    прочитано = Буф2_2.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('" + тестТекст + "'): " + записано + " байт, Размер: " + размер + ", ПрочитатьВесьТекст(): '" + прочитано + "' (ожидается 'Hello World!')")
    Буф2_2.Закрыть()
    
    // ===== 5. ЗАПИСЬ СИМВОЛА (через строки) =====
    Буф2_3 = Новый QtБуферУстройство()
    Буф2_3.РежимОтладки(Режим_Отладки)
    Буф2_3.Открыть(Буф2_3.ReadWrite() | Буф2_3.Truncate())
    Буф2_3.ЗаписатьСтроку("A")
    Буф2_3.ЗаписатьСтроку("B")
    Буф2_3.ЗаписатьСтроку("C")
    Буф2_3.Сбросить()
    прочитано3 = Буф2_3.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('A'), ЗаписатьСтроку('B'), ЗаписатьСтроку('C') -> ПрочитатьВесьТекст(): '" + прочитано3 + "' (ожидается 'ABC')")
    Буф2_3.Закрыть()
    
    // ===== 6. ПОЗИЦИОНИРОВАНИЕ =====
    Буф2_4 = Новый QtБуферУстройство("0123456789")
    Буф2_4.РежимОтладки(Режим_Отладки)
    Буф2_4.Открыть(Буф2_4.ReadWrite())
    позицияНач = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    ПолучитьПозицию(): " + позицияНач + " (ожидается 0)")
    Буф2_4.Перейти(5)
    позиция5 = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    Перейти(5) -> ПолучитьПозицию(): " + позиция5 + " (ожидается 5)")
    вКонце = Буф2_4.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце(): " + вКонце + " (ожидается false)")
    размер4 = Буф2_4.Размер()
    Буф2_4.Перейти(размер4)
    вКонце2 = Буф2_4.ВКонце()
    ВывестиСтрокуВКонсоль("    Перейти(Размер) -> ВКонце(): " + вКонце2 + " (ожидается true)")
    Буф2_4.Сбросить()
    позицияСброс = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    Сбросить() -> ПолучитьПозицию(): " + позицияСброс + " (ожидается 0)")
    Буф2_4.Закрыть()
    
    // ===== 7. БИНАРНЫЕ ДАННЫЕ =====
    Буф2_5 = Новый QtБуферУстройство()
    Буф2_5.РежимОтладки(Режим_Отладки)
    Буф2_5.Открыть(Буф2_5.ReadWrite() | Буф2_5.Truncate())
    байты = Новый QtБайтМассив()
    байты.ДобавитьСтроку("Binary Data")
    бинарныеДанные = байты.ПолучитьДанные()
    Буф2_5.Записать(бинарныеДанные)
    Буф2_5.Сбросить()
    прочитанныеБайты = Буф2_5.Прочитать(100)
    байтыРезультат = Новый QtБайтМассив(прочитанныеБайты)
    размерПрочитано = байтыРезультат.ПолучитьРазмер()
    текстРезультат = байтыРезультат.ПолучитьКакСтроку()
    ВывестиСтрокуВКонсоль("    Записать(бинарные) -> Прочитать(): '" + текстРезультат + "' (ожидается 'Binary Data'), Размер: " + размерПрочитано)
    Буф2_5.Закрыть()
    
    // ===== 8. ДОСТУПНЫЕ ДАННЫЕ =====
    Буф2_6 = Новый QtБуферУстройство("Test Data 1234567890")
    Буф2_6.РежимОтладки(Режим_Отладки)
    Буф2_6.Открыть(Буф2_6.ReadOnly())
    доступно = Буф2_6.ДоступноБайт()
    ВывестиСтрокуВКонсоль("    ДоступноБайт(): " + доступно + " (ожидается > 0)")
    Буф2_6.Прочитать(5)
    доступно2 = Буф2_6.ДоступноБайт()
    ВывестиСтрокуВКонсоль("    После чтения 5 байт: " + доступно2 + " (ожидается меньше " + доступно + ")")
    Буф2_6.Закрыть()
    
    // ===== 9. ОЧИСТКА ДАННЫХ =====
    Буф2_7 = Новый QtБуферУстройство("Data to clear")
    Буф2_7.РежимОтладки(Режим_Отладки)
    Буф2_7.Открыть(Буф2_7.ReadWrite())
    размерДо = Буф2_7.ПолучитьРазмер()
    текстДо = Буф2_7.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ПолучитьРазмер(): " + размерДо + ", ПолучитьТекст(): '" + текстДо + "'")
    Буф2_7.ОчиститьДанные()
    размерПосле = Буф2_7.ПолучитьРазмер()
    текстПосле = Буф2_7.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ОчиститьДанные() -> Размер: " + размерПосле + " (ожидается 0), Текст: '" + текстПосле + "' (ожидается пусто)")
    Буф2_7.Закрыть()
    
    // ===== 10. УСТАНОВКА ДАННЫХ ИЗ СТРОКИ =====
    тестСтрока = "Строка для теста"
    Буф2_8 = Новый QtБуферУстройство(тестСтрока)
    Буф2_8.РежимОтладки(Режим_Отладки)
    Буф2_8.Открыть(Буф2_8.ReadOnly())
    текст8 = Буф2_8.ПолучитьТекст()
    размер8 = Буф2_8.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    Конструктор со строкой -> ПолучитьТекст(): '" + текст8 + "', Размер: " + размер8 + " (ожидается '" + тестСтрока + "')")
    Буф2_8.Закрыть()
    
    // ===== 11. КОНСТАНТЫ РЕЖИМОВ =====
    режимЧт = Буф2_1.ReadOnly()
    режимЗап = Буф2_1.WriteOnly()
    режимЧтЗап = Буф2_1.ReadWrite()
    режимДоб = Буф2_1.Append()
    режимОчист = Буф2_1.Truncate()
    ВывестиСтрокуВКонсоль("    ReadOnly: " + режимЧт + ", WriteOnly: " + режимЗап + ", ReadWrite: " + режимЧтЗап + ", Append: " + режимДоб + ", Truncate: " + режимОчист)
    
    // ===== 12. ЧТЕНИЕ ПО ЧАСТЯМ =====
    Буф2_9 = Новый QtБуферУстройство("0123456789")
    Буф2_9.РежимОтладки(Режим_Отладки)
    Буф2_9.Открыть(Буф2_9.ReadOnly())
    часть1 = Буф2_9.ПрочитатьСтроку(3)
    часть2 = Буф2_9.ПрочитатьСтроку(3)
    часть3 = Буф2_9.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ПрочитатьСтроку(3): '" + часть1 + "', ПрочитатьСтроку(3): '" + часть2 + "', ПрочитатьВесьТекст(): '" + часть3 + "' (ожидается '012', '345', '6789')")
    Буф2_9.Закрыть()
    
    // ===== 13. УСТАНОВКА ДАННЫХ ЧЕРЕЗ SETDATA =====
    Буф2_10 = Новый QtБуферУстройство()
    Буф2_10.РежимОтладки(Режим_Отладки)
    Буф2_10.УстановитьДанные("SetData Test")
    Буф2_10.Открыть(Буф2_10.ReadOnly())
    текст10 = Буф2_10.ПолучитьТекст()
    размер10 = Буф2_10.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    УстановитьДанные('SetData Test') -> ПолучитьТекст(): '" + текст10 + "', Размер: " + размер10)
    Буф2_10.Закрыть()
    
    // ===== 14. RUSFUNC =====
    Если typeof Буф2_1.RusFunc === 'function' Тогда
        jsonStr = Буф2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBufferDevice (QtБуферУстройство) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

