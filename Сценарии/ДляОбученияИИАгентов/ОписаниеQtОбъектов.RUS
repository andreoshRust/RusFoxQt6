//│ 136 │ ПолучитьРасположение               │ getRealLayout                  │
//└─────┴────────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtHBoxLayout (QtГоризонтальнаяКомпоновка) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ГоризКом1_1 = Новый QtГоризонтальнаяКомпоновка()
    ГоризКом1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ГоризКом1_1.isValid()
    валидныйРус = ГоризКом1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. НАПРАВЛЕНИЕ =====
    направление = ГоризКом1_1.Направление()
    направлениеСтр = ГоризКом1_1.НаправлениеСтрока()
    вертикальный = ГоризКом1_1.Вертикальный()
    горизонтальный = ГоризКом1_1.Горизонтальный()
    ВывестиСтрокуВКонсоль("    Направление(): " + направление + ", НаправлениеСтрока(): " + направлениеСтр)
    ВывестиСтрокуВКонсоль("    Вертикальный(): " + вертикальный + ", Горизонтальный(): " + горизонтальный + " (ожидается true для горизонтального)")
    
    // ===== 4. МЕТОДЫ ДОБАВЛЕНИЯ =====
    имеетAddWidget = typeof ГоризКом1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof ГоризКом1_1.ДобавитьВиджет === 'function'
    имеетAddWidgetEnd = typeof ГоризКом1_1.addWidgetEnd === 'function'
    имеетДобавитьВиджетВКонец = typeof ГоризКом1_1.ДобавитьВиджетВКонец === 'function'
    имеетAddStretch = typeof ГоризКом1_1.addStretch === 'function'
    имеетДобавитьРастяжение = typeof ГоризКом1_1.ДобавитьРастяжение === 'function'
    имеетAddSpacing = typeof ГоризКом1_1.addSpacing === 'function'
    имеетДобавитьОтступ = typeof ГоризКом1_1.ДобавитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addWidgetEnd(): " + (имеетAddWidgetEnd ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьВиджетВКонец(): " + (имеетДобавитьВиджетВКонец ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
    
    // ===== 5. МЕТОДЫ ВСТАВКИ =====
    имеетInsertWidget = typeof ГоризКом1_1.insertWidget === 'function'
    имеетВставитьВиджет = typeof ГоризКом1_1.ВставитьВиджет === 'function'
    имеетInsertStretch = typeof ГоризКом1_1.insertStretch === 'function'
    имеетВставитьРастяжение = typeof ГоризКом1_1.ВставитьРастяжение === 'function'
    имеетInsertSpacing = typeof ГоризКом1_1.insertSpacing === 'function'
    имеетВставитьОтступ = typeof ГоризКом1_1.ВставитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
    
    // ===== 6. УПРАВЛЕНИЕ РАСТЯЖЕНИЕМ =====
    Попытка
        ГоризКом1_1.УстановитьРастяжение(0, 5)
        растяжение = ГоризКом1_1.Растяжение(0)
        ГоризКом1_1.УстановитьРастяжение(0, 3)
        растяжениеРус = ГоризКом1_1.Растяжение(0)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,5) -> Растяжение(0): " + растяжение + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,3) -> Растяжение(0): " + растяжениеРус + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Управление растяжением: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. РАБОТА С ВЛОЖЕННЫМИ LAYOUT =====
    имеетAddLayout = typeof ГоризКом1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof ГоризКом1_1.ДобавитьРасположение === 'function'
    имеетInsertLayout = typeof ГоризКом1_1.insertLayout === 'function'
    имеетВставитьРасположение = typeof ГоризКом1_1.ВставитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertLayout(): " + (имеетInsertLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРасположение(): " + (имеетВставитьРасположение ? "✅" : "❌"))
    
    // ===== 8. ОТСТУПЫ, ПРОМЕЖУТКИ И ДОСТУПНОСТЬ =====
    Попытка
        ГоризКом1_1.УстановитьОтступ(10)
        отступ = ГоризКом1_1.Отступ()
        ГоризКом1_1.УстановитьОтступ(15)
        отступРус = ГоризКом1_1.Отступ()
        
        ГоризКом1_1.УстановитьПромежуток(5)
        промежуток = ГоризКом1_1.Промежуток()
        ГоризКом1_1.УстановитьПромежуток(8)
        промежутокРус = ГоризКом1_1.Промежуток()
        
        ГоризКом1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = ГоризКом1_1.Доступен()
        ГоризКом1_1.УстановитьДоступен(ИСТИНА)
        доступен2 = ГоризКом1_1.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус + " (ожидается 10 / 15)")
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус + " (ожидается 5 / 8)")
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + " -> " + доступен2 + " (ожидается false -> true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/промежутки/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = ГоризКом1_1.getRealHBoxLayout()
    реальныйРус = ГоризКом1_1.ПолучитьГоризонтальноеРасположение()
    реальныйBox = ГоризКом1_1.getRealBoxLayout()
    реальныйBoxРус = ГоризКом1_1.ПолучитьБлочноеРасположение()
    реальныйLayout = ГоризКом1_1.getRealLayout()
    реальныйLayoutРус = ГоризКом1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealHBoxLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьГоризонтальноеРасположение(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальныйBox != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйBoxРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    ГоризКом1_2 = Новый QtГоризонтальнаяКомпоновка()
    ГоризКом1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ГоризКом1_1.copyTo(ГоризКом1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof ГоризКом1_1.RusFunc === 'function' Тогда
        jsonStr = ГоризКом1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        // Выводим несколько первых методов для проверки
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 12. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - КОЛИЧЕСТВО И ГЕОМЕТРИЯ =====
    //имеетCount = typeof ГоризКом1_1.count === 'function'
    //имеетIsEmpty = typeof ГоризКом1_1.isEmpty === 'function'
    //имеетGeometry = typeof ГоризКом1_1.geometry === 'function'
    //имеетContentsRect = typeof ГоризКом1_1.contentsRect === 'function'
    //ВывестиСтрокуВКонсоль("    count(): " + (имеетCount ? "✅" : "❌"))
    //ВывестиСтрокуВКонсоль("    isEmpty(): " + (имеетIsEmpty ? "✅" : "❌"))
    //ВывестиСтрокуВКонсоль("    geometry(): " + (имеетGeometry ? "✅" : "❌"))
    //ВывестиСтрокуВКонсоль("    contentsRect(): " + (имеетContentsRect ? "✅" : "❌"))

    имеетКоличество = typeof ГоризКом1_1.Количество === 'function'
    имеетПустой = typeof ГоризКом1_1.Пустой === 'function'
    имеетГеометрия = typeof ГоризКом1_1.Геометрия === 'function'
    имеетПрямоугольникСодержимого = typeof ГоризКом1_1.ПрямоугольникСодержимого === 'function'
    
    ВывестиСтрокуВКонсоль("    Количество(): " + (имеетКоличество ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    Пустой(): " + (имеетПустой ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    Геометрия(): " + (имеетГеометрия ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ПрямоугольникСодержимого(): " + (имеетПрямоугольникСодержимого ? "✅" : "❌"))
    
    // ===== 13. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - ОЧИСТКА =====
    имеетClear = typeof ГоризКом1_1.clear === 'function'
    имеетОчистить = typeof ГоризКом1_1.Очистить === 'function'
    ВывестиСтрокуВКонсоль("    clear(): " + (имеетClear ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    Очистить(): " + (имеетОчистить ? "✅" : "❌"))
    
    // ===== 14. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - ИМЯ ОБЪЕКТА =====
    имеетSetObjectName = typeof ГоризКом1_1.setObjectName === 'function'
    имеетУстановитьИмяОбъекта = typeof ГоризКом1_1.УстановитьИмяОбъекта === 'function'
    имеетObjectName = typeof ГоризКом1_1.objectName === 'function'
    имеетИмяОбъекта = typeof ГоризКом1_1.ИмяОбъекта === 'function'
    ВывестиСтрокуВКонсоль("    setObjectName(): " + (имеетSetObjectName ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    УстановитьИмяОбъекта(): " + (имеетУстановитьИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    objectName(): " + (имеетObjectName ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ИмяОбъекта(): " + (имеетИмяОбъекта ? "✅" : "❌"))
    
    // ===== 15. ПРОВЕРКА РЕЖИМА ОТЛАДКИ =====
    имеетSetDebug = typeof ГоризКом1_1.setDebug === 'function'
    имеетРежимОтладки = typeof ГоризКом1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof ГоризКом1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof ГоризКом1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtHBoxLayout (QtГоризонтальнаяКомпоновка) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtКлючеваяПоследовательность()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьПоследовательность     │ getRealSequence                │
//│ 20 │ Действителен                   │ isValid                        │
//│ 21 │ ВСтроку                        │ toString                       │
//│ 22 │ Количество                     │ count                          │
//│ 23 │ Пустой                         │ isEmpty                        │
//│ 24 │ УстановитьИзСтроки             │ setFromString                  │
//│ 25 │ УстановитьИзСтандартногоКлюча  │ setFromStandardKey             │
//│ 26 │ Очистить                       │ clear                          │
//│ 27 │ Равно                          │ equals                         │
//│ 28 │ НеРавно                        │ notEquals                      │
//│ 29 │ СоответствуетСтандартномуКлючу │ matchesStandardKey             │
//│ 30 │ ВСтрокуСФорматом               │ toStringWithFormat             │
//│ 31 │ СписокСтандартныхКлючей        │ standardKeyList                │
//│ 32 │ ТекстСтандартногоКлюча         │ standardKeyText                │
//│ 33 │ КопироватьВ                    │ copyTo                         │
//│ 34 │ Клонировать                    │ clone                          │
//│ 35 │ ФорматNative                   │ FormatNative                   │
//│ 36 │ ФорматPortable                 │ FormatPortable                 │
//│ 37 │ СтандартныйОткрыть             │ Open                           │
//│ 38 │ СтандартныйСохранить           │ Save                           │
//│ 39 │ СтандартныйНовый               │ New                            │
//│ 40 │ СтандартныйЗакрыть             │ Close                          │
//│ 41 │ СтандартныйПечать              │ Print                          │
//│ 42 │ СтандартныйВыход               │ Quit                           │
//│ 43 │ СтандартныйКопировать          │ Copy                           │
//│ 44 │ СтандартныйВставить            │ Paste                          │
//│ 45 │ СтандартныйВырезать            │ Cut                            │
//│ 46 │ СтандартныйОтменить            │ Undo                           │
//│ 47 │ СтандартныйПовторить           │ Redo                           │
//│ 48 │ СтандартныйНайти               │ Find                           │
//│ 49 │ СтандартныйНайтиДалее          │ FindNext                       │
//│ 50 │ СтандартныйНайтиПредыдущий     │ FindPrevious                   │
//│ 51 │ СтандартныйЗаменить            │ Replace                        │
//│ 52 │ СтандартныйВыделитьВсе         │ SelectAll                      │
//│ 53 │ СтандартныйУдалить             │ Delete                         │
//│ 54 │ СтандартныйПомощь              │ Help                           │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtKeySequence (QtКлючеваяПоследовательность) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    КлючПосл1_1 = Новый QtКлючеваяПоследовательность()
    КлючПосл1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ ИЗ СТРОКИ =====
    КлючПосл1_2 = Новый QtКлючеваяПоследовательность("Ctrl+S")
    строка = КлючПосл1_2.toString()
    строкаРус = КлючПосл1_2.ВСтроку()
    ВывестиСтрокуВКонсоль("    toString(): " + строка + ", ВСтроку(): " + строкаРус)
    
    // ===== 3. СОЗДАНИЕ ИЗ СТАНДАРТНОГО КЛЮЧА =====
    КлючПосл1_3 = Новый QtКлючеваяПоследовательность(1)  // 1 = Save
    строкаСтд = КлючПосл1_3.toString()
    ВывестиСтрокуВКонсоль("    QtKeySequence(Save) -> toString(): " + строкаСтд)
    
    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    КлючПосл1_4 = Новый QtКлючеваяПоследовательность("Ctrl+S")
    КлючПосл1_4Empty = Новый QtКлючеваяПоследовательность()
    
    валид1 = КлючПосл1_4.isValid()
    валид1Рус = КлючПосл1_4.Действителен()
    валид2 = КлючПосл1_4Empty.isValid()
    валид2Рус = КлючПосл1_4Empty.Действителен()
    
    ВывестиСтрокуВКонсоль("    isValid(Ctrl+S): " + валид1 + ", Действителен(): " + валид1Рус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isValid(empty): " + валид2 + ", Действителен(): " + валид2Рус + " (ожидается false)")
    
    // ===== 5. ПРОВЕРКА ПУСТОТЫ И КОЛИЧЕСТВА =====
    КлючПосл1_5 = Новый QtКлючеваяПоследовательность("Ctrl+Shift+S")
    КлючПосл1_5Empty = Новый QtКлючеваяПоследовательность()
    
    пуст1 = КлючПосл1_5.isEmpty()
    пуст1Рус = КлючПосл1_5.Пустой()
    пуст2 = КлючПосл1_5Empty.isEmpty()
    пуст2Рус = КлючПосл1_5Empty.Пустой()
    кол1 = КлючПосл1_5.count()
    кол1Рус = КлючПосл1_5.Количество()
    кол2 = КлючПосл1_5Empty.count()
    кол2Рус = КлючПосл1_5Empty.Количество()
    
    ВывестиСтрокуВКонсоль("    isEmpty(Ctrl+Shift+S): " + пуст1 + ", Пустой(): " + пуст1Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isEmpty(empty): " + пуст2 + ", Пустой(): " + пуст2Рус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    count(Ctrl+Shift+S): " + кол1 + ", Количество(): " + кол1Рус + " (ожидается >0)")
    ВывестиСтрокуВКонсоль("    count(empty): " + кол2 + ", Количество(): " + кол2Рус + " (ожидается 0)")
    
    // ===== 6. УСТАНОВКА ИЗ СТРОКИ =====
    КлючПосл1_6 = Новый QtКлючеваяПоследовательность()
    Попытка
        КлючПосл1_6.setFromString("Ctrl+P")
        строка6 = КлючПосл1_6.toString()
        КлючПосл1_6.УстановитьИзСтроки("Ctrl+F")
        строка6Рус = КлючПосл1_6.ВСтроку()
        ВывестиСтрокуВКонсоль("    setFromString(Ctrl+P): " + строка6 + ", УстановитьИзСтроки(Ctrl+F): " + строка6Рус)
    Исключение
        ВывестиСтрокуВКонсоль("    setFromString/УстановитьИзСтроки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. УСТАНОВКА ИЗ СТАНДАРТНОГО КЛЮЧА =====
    КлючПосл1_7 = Новый QtКлючеваяПоследовательность()
    Попытка
        КлючПосл1_7.setFromStandardKey(1)  // Save
        строка7 = КлючПосл1_7.toString()
        КлючПосл1_7.УстановитьИзСтандартногоКлюча(2)  // New
        строка7Рус = КлючПосл1_7.ВСтроку()
        ВывестиСтрокуВКонсоль("    setFromStandardKey(Save): " + строка7 + ", УстановитьИзСтандартногоКлюча(New): " + строка7Рус)
    Исключение
        ВывестиСтрокуВКонсоль("    setFromStandardKey/УстановитьИзСтандартногоКлюча: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. СРАВНЕНИЕ ПОСЛЕДОВАТЕЛЬНОСТЕЙ =====
    КлючПосл1_8a = Новый QtКлючеваяПоследовательность("Ctrl+S")
    КлючПосл1_8b = Новый QtКлючеваяПоследовательность("Ctrl+S")
    КлючПосл1_8c = Новый QtКлючеваяПоследовательность("Ctrl+O")
    
    Попытка
        рав1 = КлючПосл1_8a.equals(КлючПосл1_8b)
        рав1Рус = КлючПосл1_8a.Равно(КлючПосл1_8b)
        рав2 = КлючПосл1_8a.equals(КлючПосл1_8c)
        рав2Рус = КлючПосл1_8a.Равно(КлючПосл1_8c)
        неРав1 = КлючПосл1_8a.notEquals(КлючПосл1_8c)
        неРав1Рус = КлючПосл1_8a.НеРавно(КлючПосл1_8c)
        неРав2 = КлючПосл1_8a.notEquals(КлючПосл1_8b)
        неРав2Рус = КлючПосл1_8a.НеРавно(КлючПосл1_8b)
        
        ВывестиСтрокуВКонсоль("    equals(Ctrl+S, Ctrl+S): " + рав1 + ", Равно(): " + рав1Рус + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    equals(Ctrl+S, Ctrl+O): " + рав2 + ", Равно(): " + рав2Рус + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    notEquals(Ctrl+S, Ctrl+O): " + неРав1 + ", НеРавно(): " + неРав1Рус + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    notEquals(Ctrl+S, Ctrl+S): " + неРав2 + ", НеРавно(): " + неРав2Рус + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    equals/notEquals: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. СТАНДАРТНЫЕ КЛЮЧИ =====
    КлючПосл1_9 = Новый QtКлючеваяПоследовательность()
    Попытка
        текст = КлючПосл1_9.standardKeyText(1)  // Save
        текстРус = КлючПосл1_9.ТекстСтандартногоКлюча(1)
        список = КлючПосл1_9.standardKeyList()
        списокРус = КлючПосл1_9.СписокСтандартныхКлючей()
        ВывестиСтрокуВКонсоль("    standardKeyText(Save): " + текст + ", ТекстСтандартногоКлюча(): " + текстРус)
        ВывестиСтрокуВКонсоль("    standardKeyList() размер: " + список.length + ", СписокСтандартныхКлючей(): " + списокРус.length)
    Исключение
        ВывестиСтрокуВКонсоль("    standardKeyText/standardKeyList: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ОЧИСТКА, КОПИРОВАНИЕ И ПОЛУЧЕНИЕ РЕАЛЬНОЙ ПОСЛЕДОВАТЕЛЬНОСТИ =====
    КлючПосл1_10 = Новый QtКлючеваяПоследовательность("Ctrl+S")
    Попытка
        реальная = КлючПосл1_10.getRealSequence()
        реальнаяРус = КлючПосл1_10.ПолучитьПоследовательность()
        копия112 = Новый QtКлючеваяПоследовательность()
        успех = КлючПосл1_10.copyTo(копия112)
        успехРус = КлючПосл1_10.КопироватьВ(копия112)
        КлючПосл1_10.clear()
        строка10 = КлючПосл1_10.toString()
        КлючПосл1_10.Очистить()
        строка10Рус = КлючПосл1_10.ВСтроку()
        
        ВывестиСтрокуВКонсоль("    getRealSequence(): " + (реальная != null ? "valid" : "null") + ", ПолучитьПоследовательность(): " + (реальнаяРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    copyTo(): " + успех + ", КопироватьВ(): " + успехРус)
        ВывестиСтрокуВКонсоль("    clear() -> toString(): " + строка10 + ", Очистить() -> ВСтроку(): " + строка10Рус)
    Исключение
        ВывестиСтрокуВКонсоль("    clear/copyTo/getRealSequence: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПРОВЕРКА RUSFUNC =====
    Если typeof КлючПосл1_1.RusFunc === 'function' Тогда
        jsonStr = КлючПосл1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 12. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    // Проверяем наличие других методов из документации
    имеетSetDebug = typeof КлючПосл1_1.setDebug === 'function'
    имеетРежимОтладки = typeof КлючПосл1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof КлючПосл1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof КлючПосл1_1.ПолучитьРежимОтладки === 'function'
    имеетSetObjectName = typeof КлючПосл1_1.setObjectName === 'function'
    имеетУстановитьИмяОбъекта = typeof КлючПосл1_1.УстановитьИмяОбъекта === 'function'
    имеетObjectName = typeof КлючПосл1_1.objectName === 'function'
    имеетИмяОбъекта = typeof КлючПосл1_1.ИмяОбъекта === 'function'
    
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setObjectName(): " + (имеетSetObjectName ? "✅" : "❌") + ", УстановитьИмяОбъекта(): " + (имеетУстановитьИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    objectName(): " + (имеетObjectName ? "✅" : "❌") + ", ИмяОбъекта(): " + (имеетИмяОбъекта ? "✅" : "❌"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtKeySequence (QtКлючеваяПоследовательность) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtКомпоновкаФорм()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                      │ Английский метод                │
//├─────┼────────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                       │ isValid                        │
//│ 2 │ ПолучитьОбъект                     │ getRealObject                  │
//│ 3 │ УстановитьРодителя                 │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                   │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта               │ setObjectName                  │
//│ 6 │ ИмяОбъекта                         │ objectName                     │
//│ 7 │ УстановитьСвойство                 │ setProperty                    │
//│ 8 │ Свойство                           │ property                       │
//│ 9 │ ПодключитьСигнал                   │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                    │ disconnectSignal               │
//│ 11 │ КопироватьВ                        │ copyTo                         │
//│ 12 │ РежимОтладки                       │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки               │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                  │ getClassType                   │
//│ 15 │ УстановитьТипКласса                │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                  │ getClassName                   │
//│ 17 │ УстановитьИмяКласса                │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов              │ RusFunc                        │
//│ 19 │ ПолучитьРасположение               │ getRealLayout                  │
//│ 20 │ Действителен                       │ isValidValue                   │
//│ 21 │ УстановитьРодительскийВиджет       │ setParentWidget                │
//│ 22 │ РодительскийВиджет                 │ getParentWidget                │
//│ 23 │ ДобавитьВиджет                     │ addWidget                      │
//│ 24 │ ДобавитьРасположение               │ addLayout                      │
//│ 25 │ УдалитьВиджет                      │ removeWidget                   │
//│ 26 │ Очистить                           │ clear                          │
//│ 27 │ Обновить                           │ updateLayout                   │
//│ 28 │ Активировать                       │ activate                       │
//│ 29 │ Инвалидировать                     │ invalidate                     │
//│ 30 │ ЭлементПоИндексу                   │ itemAt                         │
//│ 31 │ ВзятьПоИндексу                     │ takeAt                         │
//│ 32 │ Количество                         │ getCountValue                  │
//│ 33 │ Пустой                             │ isEmptyValue                   │
//│ 34 │ Геометрия                          │ getGeometryValue               │
//│ 35 │ ПрямоугольникСодержимого           │ getContentsRectValue           │
//│ 36 │ УстановитьОтступ                   │ setMarginValue                 │
//│ 37 │ Отступ                             │ getMarginValue                 │
//│ 38 │ УстановитьЛевыйОтступ              │ setLeftMarginValue             │
//│ 39 │ ЛевыйОтступ                        │ getLeftMarginValue             │
//│ 40 │ УстановитьПравыйОтступ             │ setRightMarginValue            │
//│ 41 │ ПравыйОтступ                       │ getRightMarginValue            │
//│ 42 │ УстановитьВерхнийОтступ            │ setTopMarginValue              │
//│ 43 │ ВерхнийОтступ                      │ getTopMarginValue              │
//│ 44 │ УстановитьНижнийОтступ             │ setBottomMarginValue           │
//│ 45 │ НижнийОтступ                       │ getBottomMarginValue           │
//│ 46 │ УстановитьПромежуток               │ setSpacingValue                │
//│ 47 │ Промежуток                         │ getSpacingValue                │
//│ 48 │ УстановитьДоступен                 │ setEnabledValue                │
//│ 49 │ Доступен                           │ isEnabledValue                 │
//│ 50 │ УстановитьИмяОбъекта               │ setObjectName                  │
//│ 51 │ ИмяОбъекта                         │ getObjectName                  │
//│ 52 │ ТипРасположения                    │ getLayoutTypeValue             │
//│ 53 │ ТипРасположенияСтрока              │ layoutTypeString               │
//│ 54 │ КопироватьВ                        │ copyTo                         │
//│ 55 │ Расположение                       │ getRealLayout                  │
//│ 56 │ КолЭлементов                       │ getCountValue                  │
//│ 57 │ Пусто                              │ isEmptyValue                   │
//│ 58 │ Отступы                            │ getMarginValue                 │
//│ 59 │ Промежутки                         │ getSpacingValue                │
//│ 60 │ Тип                                │ getLayoutTypeValue             │
//│ 61 │ ПолучитьКомпоновкуФорм             │ getRealFormLayout              │
//│ 62 │ КоличествоСтрок                    │ getRowCountValue               │
//│ 63 │ ГоризонтальныйПромежуток           │ getHorizontalSpacingValue      │
//│ 64 │ УстановитьГоризонтальныйПромежуток │ setHorizontalSpacingValue      │
//│ 65 │ ВертикальныйПромежуток             │ getVerticalSpacingValue        │
//│ 66 │ УстановитьВертикальныйПромежуток   │ setVerticalSpacingValue        │
//│ 67 │ ВыравниваниеМеток                  │ getLabelAlignmentValue         │
//│ 68 │ УстановитьВыравниваниеМеток        │ setLabelAlignmentValue         │
//│ 69 │ ВыравниваниеФормы                  │ getFormAlignmentValue          │
//│ 70 │ УстановитьВыравниваниеФормы        │ setFormAlignmentValue          │
//│ 71 │ ПолитикаРостаПолей                 │ getFieldGrowthPolicyValue      │
//│ 72 │ УстановитьПолитикуРостаПолей       │ setFieldGrowthPolicyValue      │
//│ 73 │ ПолитикаПереносаСтрок              │ getRowWrapPolicyValue          │
//│ 74 │ УстановитьПолитикуПереносаСтрок    │ setRowWrapPolicyValue          │
//│ 75 │ ДобавитьСтроку                     │ addRow                         │
//│ 76 │ ДобавитьСтрокуСВиджетом            │ addRowWidget                   │
//│ 77 │ ДобавитьСтрокуСРасположением       │ addRowLayout                   │
//│ 78 │ ДобавитьСтрокуПолную               │ addRowWidgetFull               │
//│ 79 │ ДобавитьСтрокуРасположениеПолное   │ addRowLayoutFull               │
//│ 80 │ ВставитьСтроку                     │ insertRow                      │
//│ 81 │ ВставитьСтрокуСВиджетом            │ insertRowWidget                │
//│ 82 │ ВставитьСтрокуСРасположением       │ insertRowLayout                │
//│ 83 │ УдалитьСтроку                      │ removeRow                      │
//│ 84 │ Очистить                           │ clear                          │
//│ 85 │ КопироватьВ                        │ copyTo                         │
//│ 86 │ Строки                             │ getRowCountValue               │
//│ 87 │ ГПромежуток                        │ getHorizontalSpacingValue      │
//│ 88 │ ВПромежуток                        │ getVerticalSpacingValue        │
//│ 89 │ ВырМеток                           │ getLabelAlignmentValue         │
//│ 90 │ ВырФормы                           │ getFormAlignmentValue          │
//│ 91 │ ПолитикаРоста                      │ getFieldGrowthPolicyValue      │
//│ 92 │ ПолитикаПереноса                   │ getRowWrapPolicyValue          │
//└─────┴────────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtFormLayout (QtКомпоновкаФорм) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    КомпФорм1_1 = Новый QtКомпоновкаФорм()
    КомпФорм1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = КомпФорм1_1.isValid()
    валидныйРус = КомпФорм1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. КОЛИЧЕСТВО СТРОК =====
    строкРус = КомпФорм1_1.КоличествоСтрок()
    ВывестиСтрокуВКонсоль("    КоличествоСтрок(): " + строкРус + " (ожидается 0)")
    
    // ===== 4. ПРОМЕЖУТКИ =====
    Попытка
        КомпФорм1_1.УстановитьГоризонтальныйПромежуток(15)
        горизРус = КомпФорм1_1.ГоризонтальныйПромежуток()
        
        КомпФорм1_1.УстановитьВертикальныйПромежуток(8)
        вертРус = КомпФорм1_1.ВертикальныйПромежуток()
        
        ВывестиСтрокуВКонсоль("    horizontalSpacing:  " + горизРус + " (ожидается  15)")
        ВывестиСтрокуВКонсоль("    verticalSpacing:  " + вертРус + " (ожидается  8)")
    Исключение
        ВывестиСтрокуВКонсоль("    Промежутки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ВЫРАВНИВАНИЕ И ПОЛИТИКИ =====
    Попытка
        КомпФорм1_1.УстановитьВыравниваниеМеток(2)
        вырМетокРус = КомпФорм1_1.ВыравниваниеМеток()
        
        КомпФорм1_1.УстановитьВыравниваниеФормы(2)
        вырФормыРус = КомпФорм1_1.ВыравниваниеФормы()
        
        КомпФорм1_1.УстановитьПолитикуРостаПолей(2)
        политикаРостаРус = КомпФорм1_1.ПолитикаРостаПолей()
        
        КомпФорм1_1.УстановитьПолитикуПереносаСтрок(2)
        политикаПереносаРус = КомпФорм1_1.ПолитикаПереносаСтрок()
        
        ВывестиСтрокуВКонсоль("    ВыравниваниеМеток():  " + вырМетокРус)
        ВывестиСтрокуВКонсоль("    ВыравниваниеФормы():  " + вырФормыРус)
        ВывестиСтрокуВКонсоль("    ПолитикаРостаПолей():  " + политикаРостаРус)
        ВывестиСтрокуВКонсоль("    ПолитикаПереносаСтрок():  " + политикаПереносаРус)
    Исключение
        ВывестиСтрокуВКонсоль("    Выравнивание/политики: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОТСТУПЫ И ДОСТУПНОСТЬ =====
    Попытка
        КомпФорм1_1.УстановитьОтступ(15)
        отступРус = КомпФорм1_1.Отступ()
        
        КомпФорм1_1.УстановитьДоступен(false)
        доступенРус = КомпФорм1_1.Доступен()
        КомпФорм1_1.УстановитьДоступен(true)
        доступен2Рус = КомпФорм1_1.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ():  " + отступРус + " (ожидается 15)")
        ВывестиСтрокуВКонсоль("    Доступен():  " + доступенРус + "->" + доступен2Рус)
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ДОБАВЛЕНИЕ СТРОК =====
    Попытка
        КомпФорм1_1.Очистить()
        
        // Создаем виджеты для теста
        поле1 = Новый QtРедакторСтроки()
        поле2 = Новый QtРедакторСтроки()
        поле3 = Новый QtРедакторСтроки()
        поле4 = Новый QtРедакторСтроки()
        
        Если поле1 != null И поле2 != null И поле3 != null И поле4 != null Тогда
            реальныйПоле1 = поле1.getRealWidget()
            реальныйПоле2 = поле2.getRealWidget()
            реальныйПоле3 = поле3.getRealWidget()
            реальныйПоле4 = поле4.getRealWidget()
            
            КомпФорм1_1.addRow("Имя:", реальныйПоле1)
            КомпФорм1_1.addRow("Email:", реальныйПоле2)
            КомпФорм1_1.ДобавитьСтроку("Телефон:", реальныйПоле3)
            КомпФорм1_1.ДобавитьСтроку("Адрес:", реальныйПоле4)
            
            колРус = КомпФорм1_1.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("   КоличествоСтрок(): " + колРус + " (ожидается 4)")
        Иначе
            ВывестиСтрокуВКонсоль("    addRow: НЕ УДАЛОСЬ СОЗДАТЬ ВИДЖЕТЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Добавление строк: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ДОБАВЛЕНИЕ СТРОКИ НА ВСЮ ШИРИНУ =====
    Попытка
        кнопка1 = Новый QtКнопка("Кнопка 1")
        кнопка2 = Новый QtКнопка("Кнопка 2")
        //
        Если кнопка1 != null И кнопка2 != null Тогда
            реальныйКнопка1 = кнопка1.getRealWidget()
            реальныйКнопка2 = кнопка2.getRealWidget()
            
            КомпФорм1_1.addRowWidgetFull(реальныйКнопка1)
            КомпФорм1_1.ДобавитьСтрокуПолную(реальныйКнопка2)
            
            колРус = КомпФорм1_1.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("    КоличествоСтрок():  " + колРус + " (ожидается 6)")
        Иначе
            ВывестиСтрокуВКонсоль("    addRowWidgetFull: НЕ УДАЛОСЬ СОЗДАТЬ КНОПКИ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Добавление строк на всю ширину: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ВСТАВКА СТРОКИ =====
    Попытка
        полеВставка1 = Новый QtРедакторСтроки()
        полеВставка2 = Новый QtРедакторСтроки()
        
        Если полеВставка1 != null И полеВставка2 != null Тогда
            реальныйПолеВст1 = полеВставка1.getRealWidget()
            реальныйПолеВст2 = полеВставка2.getRealWidget()
            
            КомпФорм1_1.insertRow(1, "Вставка 1:", реальныйПолеВст1)
            КомпФорм1_1.ВставитьСтроку(2, "Вставка 2:", реальныйПолеВст2)
            
        //    кол = КомпФорм1_1.rowCount()
            колРус = КомпФорм1_1.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("  КоличествоСтрок():  " + колРус + " (ожидается 8)")
        Иначе
            ВывестиСтрокуВКонсоль("    insertRow: НЕ УДАЛОСЬ СОЗДАТЬ ВИДЖЕТЫ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Вставка строк: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. УДАЛЕНИЕ СТРОКИ =====
    Попытка
        колДоРус = КомпФорм1_1.КоличествоСтрок()
        КомпФорм1_1.УдалитьСтроку(1)
        колПослеРус = КомпФорм1_1.КоличествоСтрок()
        
        ВывестиСтрокуВКонсоль("    УдалитьСтроку(1):  " + колДоРус + "->" + колПослеРус)
    Исключение
        ВывестиСтрокуВКонсоль("    Удаление строк: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ОЧИСТКА ФОРМЫ =====
    Попытка
        колДоРус = КомпФорм1_1.КоличествоСтрок()
        КомпФорм1_1.Очистить()
        колПослеРус = КомпФорм1_1.КоличествоСтрок()
        
        ВывестиСтрокуВКонсоль("  Очистить():  " + колДоРус + "->" + колПослеРус + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Очистка: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = КомпФорм1_1.getRealFormLayout()
    реальныйРус = КомпФорм1_1.ПолучитьКомпоновкуФорм()
    реальныйLayout = КомпФорм1_1.getRealLayout()
    реальныйLayoutРус = КомпФорм1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealFormLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьКомпоновкуФорм(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 13. КОПИРОВАНИЕ =====
    КомпФорм1_2 = Новый QtКомпоновкаФорм()
    КомпФорм1_2.РежимОтладки(Режим_Отладки)
    результатКопия = КомпФорм1_1.copyTo(КомпФорм1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    // ===== 14. ПРОВЕРКА RUSFUNC =====
    Если typeof КомпФорм1_1.RusFunc === 'function' Тогда
        jsonStr = КомпФорм1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 15. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    имеетКоличество = typeof КомпФорм1_1.Количество === 'function'
    имеетПустой = typeof КомпФорм1_1.Пустой === 'function'
    имеетГеометрия = typeof КомпФорм1_1.Геометрия === 'function'
    имеетПрямоугольникСодержимого = typeof КомпФорм1_1.ПрямоугольникСодержимого === 'function'
    имеетЭлементПоИндексу = typeof КомпФорм1_1.ЭлементПоИндексу === 'function'
    имеетВзятьПоИндексу = typeof КомпФорм1_1.ВзятьПоИндексу === 'function'
    
    ВывестиСтрокуВКонсоль("   Количество(): " + (имеетКоличество ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Пустой(): " + (имеетПустой ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Геометрия(): " + (имеетГеометрия ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   ПрямоугольникСодержимого(): " + (имеетПрямоугольникСодержимого ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   ЭлементПоИндексу(): " + (имеетЭлементПоИндексу ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   ВзятьПоИндексу(): " + (имеетВзятьПоИндексу ? "✅" : "❌"))
    
    // ===== 16. ИМЯ ОБЪЕКТА И РЕЖИМ ОТЛАДКИ =====
    имеетSetObjectName = typeof КомпФорм1_1.setObjectName === 'function'
    имеетУстановитьИмяОбъекта = typeof КомпФорм1_1.УстановитьИмяОбъекта === 'function'
    имеетObjectName = typeof КомпФорм1_1.objectName === 'function'
    имеетИмяОбъекта = typeof КомпФорм1_1.ИмяОбъекта === 'function'
    имеетSetDebug = typeof КомпФорм1_1.setDebug === 'function'
    имеетРежимОтладки = typeof КомпФорм1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof КомпФорм1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof КомпФорм1_1.ПолучитьРежимОтладки === 'function'
    
    ВывестиСтрокуВКонсоль("    setObjectName(): " + (имеетSetObjectName ? "✅" : "❌") + ", УстановитьИмяОбъекта(): " + (имеетУстановитьИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    objectName(): " + (имеетObjectName ? "✅" : "❌") + ", ИмяОбъекта(): " + (имеетИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtFormLayout (QtКомпоновкаФорм) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПрямоугольник()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьПрямоугольник          │ getRealRect                    │
//│ 20 │ Действителен                   │ isValid                        │
//│ 21 │ ПолучитьX                      │ getX                           │
//│ 22 │ ПолучитьY                      │ getY                           │
//│ 23 │ ПолучитьШирину                 │ getWidth                       │
//│ 24 │ ПолучитьВысоту                 │ getHeight                      │
//│ 25 │ УстановитьX                    │ setX                           │
//│ 26 │ УстановитьY                    │ setY                           │
//│ 27 │ УстановитьШирину               │ setWidth                       │
//│ 28 │ УстановитьВысоту               │ setHeight                      │
//│ 29 │ УстановитьПрямоугольник        │ setRect                        │
//│ 30 │ Левый                          │ left                           │
//│ 31 │ Правый                         │ right                          │
//│ 32 │ Верхний                        │ top                            │
//│ 33 │ Нижний                         │ bottom                         │
//│ 34 │ УстановитьЛевый                │ setLeft                        │
//│ 35 │ УстановитьПравый               │ setRight                       │
//│ 36 │ УстановитьВерхний              │ setTop                         │
//│ 37 │ УстановитьНижний               │ setBottom                      │
//│ 38 │ Нулевой                        │ isNull                         │
//│ 39 │ Пустой                         │ isEmpty                        │
//│ 40 │ Переместить                    │ translate                      │
//│ 41 │ Перемещённый                   │ translated                     │
//│ 42 │ Содержит                       │ contains                       │
//│ 43 │ СодержитПрямоугольник          │ containsRect                   │
//│ 44 │ Пересекается                   │ intersects                     │
//│ 45 │ Пересечение                    │ intersected                    │
//│ 46 │ Объединение                    │ united                         │
//│ 47 │ Нормализованный                │ normalized                     │
//│ 48 │ Размер                         │ size                           │
//│ 49 │ Центр                          │ center                         │
//│ 50 │ ВерхнийЛевый                   │ topLeft                        │
//│ 51 │ ВерхнийПравый                  │ topRight                       │
//│ 52 │ НижнийЛевый                    │ bottomLeft                     │
//│ 53 │ НижнийПравый                   │ bottomRight                    │
//│ 54 │ ВСтроку                        │ toString                       │
//│ 55 │ КопироватьВ                    │ copyTo                         │
//│ 56 │ Клонировать                    │ clone                          │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtRect (QtПрямоугольник) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
     //===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Прямоуг1_1 = Новый QtRect()
    Прямоуг1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С ПАРАМЕТРАМИ =====
    Прямоуг1_2 = Новый QtRect()
    Прямоуг1_2.setRect(10, 20, 100, 50)
    x = Прямоуг1_2.getX()
    y = Прямоуг1_2.getY()
    ширина = Прямоуг1_2.getWidth()
    высота = Прямоуг1_2.getHeight()
    ВывестиСтрокуВКонсоль("    setRect(10,20,100,50) -> getX=" + x + ", getY=" + y + ", getWidth=" + ширина + ", getHeight=" + высота + " (ожидается 10,20,100,50)")
    
    // ===== 3. РУССКИЙ ВАРИАНТ =====
    Прямоуг1_2Рус = Новый QtRect()
    Прямоуг1_2Рус.УстановитьПрямоугольник(20, 30, 200, 100)
    xРус = Прямоуг1_2Рус.ПолучитьX()
    yРус = Прямоуг1_2Рус.ПолучитьY()
    ширинаРус = Прямоуг1_2Рус.ПолучитьШирину()
    высотаРус = Прямоуг1_2Рус.ПолучитьВысоту()
    ВывестиСтрокуВКонсоль("    УстановитьПрямоугольник(20,30,200,100) -> ПолучитьX=" + xРус + ", ПолучитьY=" + yРус + ", ПолучитьШирину=" + ширинаРус + ", ПолучитьВысоту=" + высотаРус + " (ожидается 20,30,200,100)")
    
    // ===== 4. УСТАНОВКА КООРДИНАТ И РАЗМЕРОВ =====
    Прямоуг1_3 = Новый QtRect()
    Прямоуг1_3.setRect(0, 0, 0, 0)
    Прямоуг1_3.setX(10)
    Прямоуг1_3.setY(20)
    Прямоуг1_3.setWidth(100)
    Прямоуг1_3.setHeight(50)
    x3 = Прямоуг1_3.getX()
    y3 = Прямоуг1_3.getY()
    ширина3 = Прямоуг1_3.getWidth()
    высота3 = Прямоуг1_3.getHeight()
    ВывестиСтрокуВКонсоль("    setX(10),setY(20),setWidth(100),setHeight(50) -> getX=" + x3 + ", getY=" + y3 + ", getWidth=" + ширина3 + ", getHeight=" + высота3 + " (ожидается 10,20,100,50)")
    
    // ===== 5. РУССКИЙ ВАРИАНТ УСТАНОВКИ =====
    Прямоуг1_3Рус = Новый QtRect()
    Прямоуг1_3Рус.УстановитьПрямоугольник(0, 0, 0, 0)
    Прямоуг1_3Рус.УстановитьX(20)
    Прямоуг1_3Рус.УстановитьY(30)
    Прямоуг1_3Рус.УстановитьШирину(200)
    Прямоуг1_3Рус.УстановитьВысоту(100)
    x3Рус = Прямоуг1_3Рус.ПолучитьX()
    y3Рус = Прямоуг1_3Рус.ПолучитьY()
    ширина3Рус = Прямоуг1_3Рус.ПолучитьШирину()
    высота3Рус = Прямоуг1_3Рус.ПолучитьВысоту()
    ВывестиСтрокуВКонсоль("    УстановитьX(20),УстановитьY(30),УстановитьШирину(200),УстановитьВысоту(100) -> ПолучитьX=" + x3Рус + ", ПолучитьY=" + y3Рус + ", ПолучитьШирину=" + ширина3Рус + ", ПолучитьВысоту=" + высота3Рус + " (ожидается 20,30,200,100)")
    
    // ===== 6. ПРОВЕРКА ВАЛИДНОСТИ =====
    Прямоуг1_4a = Новый QtRect()
    Прямоуг1_4a.setRect(10, 20, 100, 50)
    Прямоуг1_4b = Новый QtRect()
    Прямоуг1_4b.setRect(0, 0, 0, 0)
    Прямоуг1_4c = Новый QtRect()
    Прямоуг1_4c.setRect(10, 20, -100, 50)
    
    валид1 = Прямоуг1_4a.isValid()
    валид1Рус = Прямоуг1_4a.Действителен()
    валид2 = Прямоуг1_4b.isValid()
    валид2Рус = Прямоуг1_4b.Действителен()
    нулевой1 = Прямоуг1_4a.isNull()
    нулевой1Рус = Прямоуг1_4a.Нулевой()
    нулевой2 = Прямоуг1_4b.isNull()
    нулевой2Рус = Прямоуг1_4b.Нулевой()
    пустой1 = Прямоуг1_4a.isEmpty()
    пустой1Рус = Прямоуг1_4a.Пустой()
    пустой2 = Прямоуг1_4b.isEmpty()
    пустой2Рус = Прямоуг1_4b.Пустой()
    
    ВывестиСтрокуВКонсоль("    isValid: (10,20,100,50)=" + валид1 + "/" + валид1Рус + ", (0,0,0,0)=" + валид2 + "/" + валид2Рус + " (ожидается true/false)")
    ВывестиСтрокуВКонсоль("    isNull: (10,20,100,50)=" + нулевой1 + "/" + нулевой1Рус + ", (0,0,0,0)=" + нулевой2 + "/" + нулевой2Рус + " (ожидается false/true)")
    ВывестиСтрокуВКонсоль("    isEmpty: (10,20,100,50)=" + пустой1 + "/" + пустой1Рус + ", (0,0,0,0)=" + пустой2 + "/" + пустой2Рус + " (ожидается false/true)")
    
    // ===== 7. ПЕРЕМЕЩЕНИЕ =====
    Прямоуг1_5 = Новый QtRect()
    Прямоуг1_5.setRect(10, 20, 100, 50)
    Прямоуг1_5.translate(5, 10)
    x5 = Прямоуг1_5.getX()
    y5 = Прямоуг1_5.getY()
    ВывестиСтрокуВКонсоль("    translate(5,10) -> getX=" + x5 + ", getY=" + y5 + " (ожидается 15,30)")
    
    // Русский вариант
    Прямоуг1_5Рус = Новый QtRect()
    Прямоуг1_5Рус.УстановитьПрямоугольник(10, 20, 100, 50)
    Прямоуг1_5Рус.Переместить(5, 10)
    x5Рус = Прямоуг1_5Рус.ПолучитьX()
    y5Рус = Прямоуг1_5Рус.ПолучитьY()
    ВывестиСтрокуВКонсоль("    Переместить(5,10) -> ПолучитьX=" + x5Рус + ", ПолучитьY=" + y5Рус + " (ожидается 15,30)")
    
    // ===== 8. ПРОВЕРКА СОДЕРЖАНИЯ И ПЕРЕСЕЧЕНИЯ =====
    Прямоуг1_6 = Новый QtRect()
    Прямоуг1_6.setRect(10, 20, 100, 50)
    Прямоуг1_6Другой = Новый QtRect()
    Прямоуг1_6Другой.setRect(30, 40, 50, 30)
    Прямоуг1_6Другой2 = Новый QtRect()
    Прямоуг1_6Другой2.setRect(200, 200, 50, 30)
    
    содержит1 = Прямоуг1_6.contains(50, 40)
    содержит1Рус = Прямоуг1_6.Содержит(50, 40)
    содержит2 = Прямоуг1_6.contains(200, 200)
    содержит2Рус = Прямоуг1_6.Содержит(200, 200)
    пересекает = Прямоуг1_6.intersects(Прямоуг1_6Другой)
    пересекаетРус = Прямоуг1_6.Пересекается(Прямоуг1_6Другой)
    пересекает2 = Прямоуг1_6.intersects(Прямоуг1_6Другой2)
    пересекает2Рус = Прямоуг1_6.Пересекается(Прямоуг1_6Другой2)
    
    ВывестиСтрокуВКонсоль("    contains(50,40): " + содержит1 + "/" + содержит1Рус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains(200,200): " + содержит2 + "/" + содержит2Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    intersects(30,40,50,30): " + пересекает + "/" + пересекаетРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    intersects(200,200,50,30): " + пересекает2 + "/" + пересекает2Рус + " (ожидается false)")
    
    // ===== 9. ПЕРЕСЕЧЕНИЕ И ОБЪЕДИНЕНИЕ =====
    Прямоуг1_7 = Новый QtRect()
    Прямоуг1_7.setRect(10, 20, 100, 50)
    Прямоуг1_7Другой = Новый QtRect()
    Прямоуг1_7Другой.setRect(30, 40, 50, 30)
    
    Попытка
        пересечение = Прямоуг1_7.intersected(Прямоуг1_7Другой)
        объединение = Прямоуг1_7.united(Прямоуг1_7Другой)
        
        Если пересечение != null Тогда
            стрПерес = пересечение.toString()
        Иначе
            стрПерес = "null"
        КонецЕсли;
        Если объединение != null Тогда
            стрОбъед = объединение.toString()
        Иначе
            стрОбъед = "null"
        КонецЕсли;
        
        // Русский вариант
        Прямоуг1_7Рус = Новый QtRect()
        Прямоуг1_7Рус.УстановитьПрямоугольник(10, 20, 100, 50)
        Прямоуг1_7ДругойРус = Новый QtRect()
        Прямоуг1_7ДругойРус.УстановитьПрямоугольник(30, 40, 50, 30)
        
        пересечениеРус = Прямоуг1_7Рус.Пересечение(Прямоуг1_7ДругойРус)
        объединениеРус = Прямоуг1_7Рус.Объединение(Прямоуг1_7ДругойРус)
        
        Если пересечениеРус != null Тогда
            стрПересРус = пересечениеРус.toString()
        Иначе
            стрПересРус = "null"
        КонецЕсли;
        Если объединениеРус != null Тогда
            стрОбъедРус = объединениеРус.toString()
        Иначе
            стрОбъедРус = "null"
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("    intersected(): " + стрПерес + " / Пересечение(): " + стрПересРус)
        ВывестиСтрокуВКонсоль("    united(): " + стрОбъед + " / Объединение(): " + стрОбъедРус)
    Исключение
        ВывестиСтрокуВКонсоль("    intersected/united: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    реальный = Прямоуг1_1.getRealRect()
    реальныйРус = Прямоуг1_1.ПолучитьПрямоугольник()
    ВывестиСтрокуВКонсоль("    getRealRect(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьПрямоугольник(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. ПРОВЕРКА RUSFUNC =====
    Если typeof Прямоуг1_1.RusFunc === 'function' Тогда
        jsonStr = Прямоуг1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 12. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    имеетToString = typeof Прямоуг1_1.toString === 'function'
    имеетВСтроку = typeof Прямоуг1_1.ВСтроку === 'function'
    имеетSetDebug = typeof Прямоуг1_1.setDebug === 'function'
    имеетРежимОтладки = typeof Прямоуг1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof Прямоуг1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof Прямоуг1_1.ПолучитьРежимОтладки === 'function'
    имеетSetObjectName = typeof Прямоуг1_1.setObjectName === 'function'
    имеетУстановитьИмяОбъекта = typeof Прямоуг1_1.УстановитьИмяОбъекта === 'function'
    имеетObjectName = typeof Прямоуг1_1.objectName === 'function'
    имеетИмяОбъекта = typeof Прямоуг1_1.ИмяОбъекта === 'function'
    
    ВывестиСтрокуВКонсоль("    toString(): " + (имеетToString ? "✅" : "❌") + ", ВСтроку(): " + (имеетВСтроку ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setObjectName(): " + (имеетSetObjectName ? "✅" : "❌") + ", УстановитьИмяОбъекта(): " + (имеетУстановитьИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    objectName(): " + (имеетObjectName ? "✅" : "❌") + ", ИмяОбъекта(): " + (имеетИмяОбъекта ? "✅" : "❌"))
    
    // ===== 13. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - КОПИРОВАНИЕ =====
    имеетCopyTo = typeof Прямоуг1_1.copyTo === 'function'
    имеетКопироватьВ = typeof Прямоуг1_1.КопироватьВ === 'function'
    ВывестиСтрокуВКонсоль("    copyTo(): " + (имеетCopyTo ? "✅" : "❌") + ", КопироватьВ(): " + (имеетКопироватьВ ? "✅" : "❌"))
    
    Если имеетCopyTo Тогда
        Попытка
            Прямоуг1_Копия = Новый QtRect()
            результатКопия = Прямоуг1_1.copyTo(Прямоуг1_Копия)
            ВывестиСтрокуВКонсоль("      copyTo() результат: " + результатКопия)
        Исключение
            ВывестиСтрокуВКонсоль("      copyTo() ошибка: " + e)
        КонецПопытки
    КонецЕсли
    
    // ===== 14. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - ПОЛУЧЕНИЕ ГРАНИЦ =====
    Прямоуг1_8 = Новый QtRect()
    Прямоуг1_8.setRect(10, 20, 100, 50)
    
    имеетLeft = typeof Прямоуг1_8.left === 'function'
    имеетЛевый = typeof Прямоуг1_8.Левый === 'function'
    имеетRight = typeof Прямоуг1_8.right === 'function'
    имеетПравый = typeof Прямоуг1_8.Правый === 'function'
    имеетTop = typeof Прямоуг1_8.top === 'function'
    имеетВерхний = typeof Прямоуг1_8.Верхний === 'function'
    имеетBottom = typeof Прямоуг1_8.bottom === 'function'
    имеетНижний = typeof Прямоуг1_8.Нижний === 'function'
    
    ВывестиСтрокуВКонсоль("    left(): " + (имеетLeft ? "✅" : "❌") + ", Левый(): " + (имеетЛевый ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    right(): " + (имеетRight ? "✅" : "❌") + ", Правый(): " + (имеетПравый ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    top(): " + (имеетTop ? "✅" : "❌") + ", Верхний(): " + (имеетВерхний ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    bottom(): " + (имеетBottom ? "✅" : "❌") + ", Нижний(): " + (имеетНижний ? "✅" : "❌"))
    
    Если имеетLeft И имеетTop Тогда
        Попытка
            левый = Прямоуг1_8.left()
            правый = Прямоуг1_8.right()
            верхний = Прямоуг1_8.top()
            нижний = Прямоуг1_8.bottom()
            ВывестиСтрокуВКонсоль("      left=" + левый + ", right=" + правый + ", top=" + верхний + ", bottom=" + нижний + " (ожидается 10,109,20,69)")
        Исключение
            ВывестиСтрокуВКонсоль("      left/right/top/bottom ошибка: " + e)
        КонецПопытки
    КонецЕсли
    
    // ===== 15. ПРОВЕРКА ПЕРЕМЕЩЁННОГО =====
    имеетTranslated = typeof Прямоуг1_8.translated === 'function'
    имеетПеремещённый = typeof Прямоуг1_8.Перемещённый === 'function'
    ВывестиСтрокуВКонсоль("    translated(): " + (имеетTranslated ? "✅" : "❌") + ", Перемещённый(): " + (имеетПеремещённый ? "✅" : "❌"))
    
    Если имеетTranslated Тогда
        Попытка
            перем = Прямоуг1_8.translated(10, 5)
            Если перем != null Тогда
                стрПерем = перем.toString()
                ВывестиСтрокуВКонсоль("      translated(10,5) -> " + стрПерем + " (ожидается 20,25 100x50)")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("      translated() ошибка: " + e)
        КонецПопытки
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtRect (QtПрямоугольник) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtРасположение()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьРасположение           │ getRealLayout                  │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ УстановитьРодительскийВиджет   │ setParentWidget                │
//│ 22 │ РодительскийВиджет             │ getParentWidget                │
//│ 23 │ ДобавитьВиджет                 │ addWidget                      │
//│ 24 │ ДобавитьРасположение           │ addLayout                      │
//│ 25 │ УдалитьВиджет                  │ removeWidget                   │
//│ 26 │ Очистить                       │ clear                          │
//│ 27 │ Обновить                       │ updateLayout                   │
//│ 28 │ Активировать                   │ activate                       │
//│ 29 │ Инвалидировать                 │ invalidate                     │
//│ 30 │ ЭлементПоИндексу               │ itemAt                         │
//│ 31 │ ВзятьПоИндексу                 │ takeAt                         │
//│ 32 │ Количество                     │ getCountValue                  │
//│ 33 │ Пустой                         │ isEmptyValue                   │
//│ 34 │ Геометрия                      │ getGeometryValue               │
//│ 35 │ ПрямоугольникСодержимого       │ getContentsRectValue           │
//│ 36 │ УстановитьОтступ               │ setMarginValue                 │
//│ 37 │ Отступ                         │ getMarginValue                 │
//│ 38 │ УстановитьЛевыйОтступ          │ setLeftMarginValue             │
//│ 39 │ ЛевыйОтступ                    │ getLeftMarginValue             │
//│ 40 │ УстановитьПравыйОтступ         │ setRightMarginValue            │
//│ 41 │ ПравыйОтступ                   │ getRightMarginValue            │
//│ 42 │ УстановитьВерхнийОтступ        │ setTopMarginValue              │
//│ 43 │ ВерхнийОтступ                  │ getTopMarginValue              │
//│ 44 │ УстановитьНижнийОтступ         │ setBottomMarginValue           │
//│ 45 │ НижнийОтступ                   │ getBottomMarginValue           │
//│ 46 │ УстановитьПромежуток           │ setSpacingValue                │
//│ 47 │ Промежуток                     │ getSpacingValue                │
//│ 48 │ УстановитьДоступен             │ setEnabledValue                │
//│ 49 │ Доступен                       │ isEnabledValue                 │
//│ 50 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 51 │ ИмяОбъекта                     │ getObjectName                  │
//│ 52 │ ТипРасположения                │ getLayoutTypeValue             │
//│ 53 │ ТипРасположенияСтрока          │ layoutTypeString               │
//│ 54 │ КопироватьВ                    │ copyTo                         │
//│ 55 │ Расположение                   │ getRealLayout                  │
//│ 56 │ КолЭлементов                   │ getCountValue                  │
//│ 57 │ Пусто                          │ isEmptyValue                   │
//│ 58 │ Отступы                        │ getMarginValue                 │
//│ 59 │ Промежутки                     │ getSpacingValue                │
//│ 60 │ Тип                            │ getLayoutTypeValue             │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtLayout (QtРасположение) - КОМПАКТНАЯ ВЕРСИЯ ====")
  
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Распол1_1 = Новый QtРасположение()
    Распол1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Распол1_1.isValid()
    валидныйРус = Распол1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. КОЛИЧЕСТВО ЭЛЕМЕНТОВ =====
    колРус = Распол1_1.Количество()
    ВывестиСтрокуВКонсоль("  Количество(): " + колРус + " (ожидается 0)")
    
    // ===== 4. ПРОВЕРКА НА ПУСТОТУ =====
    пустРус = Распол1_1.Пустой()
    ВывестиСтрокуВКонсоль("  Пустой(): " + пустРус + " (ожидается true)")
    
    // ===== 5. ОТСТУПЫ =====
    Попытка
        Распол1_1.УстановитьОтступ(20)
        отступРус = Распол1_1.Отступ()
        ВывестиСтрокуВКонсоль("    Отступ():  " + отступРус + " (ожидается  20)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПРОМЕЖУТКИ =====
    Попытка
        Распол1_1.УстановитьПромежуток(10)
        промежутокРус = Распол1_1.Промежуток()
        ВывестиСтрокуВКонсоль("  Промежуток():  " + промежутокРус + " (ожидается 10)")
    Исключение
        ВывестиСтрокуВКонсоль("    Промежутки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ДОСТУПНОСТЬ =====
    Попытка
          Распол1_1.УстановитьДоступен(false)
        доступен1Рус = Распол1_1.Доступен()
        Распол1_1.УстановитьДоступен(true)
        доступен2Рус = Распол1_1.Доступен()
        ВывестиСтрокуВКонсоль("    Доступен():  " + доступен1Рус + "->" + доступен2Рус + " (ожидается false->true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. РОДИТЕЛЬСКИЙ ВИДЖЕТ =====
    Попытка
        родительРус = Распол1_1.РодительскийВиджет()
        ВывестиСтрокуВКонсоль("  РодительскийВиджет(): " + (родительРус != null ? "valid" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("    Родительский виджет: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ГЕОМЕТРИЯ =====
    Попытка
        геометрияРус = Распол1_1.Геометрия()
        содержимоеРус = Распол1_1.ПрямоугольникСодержимого()
        ВывестиСтрокуВКонсоль("   Геометрия(): " + (геометрияРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("  ПрямоугольникСодержимого(): " + (содержимоеРус != null ? "valid" : "null"))
    Исключение
        ВывестиСтрокуВКонсоль("    Геометрия: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ИМЯ ОБЪЕКТА =====
    Попытка
        Распол1_1.setObjectName("TestLayout")
        имя = Распол1_1.objectName()
        Распол1_1.УстановитьИмяОбъекта("TestLayoutRus")
        имяРус = Распол1_1.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    objectName: " + имя + " / " + имяРус)
    Исключение
        ВывестиСтрокуВКонсоль("    Имя объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ТИП РАСПОЛОЖЕНИЯ =====
    Попытка
        типРус = Распол1_1.ТипРасположения()
        типСтрРус = Распол1_1.ТипРасположенияСтрока()
        ВывестиСтрокуВКонсоль("  ТипРасположения():  " + типРус)
        ВывестиСтрокуВКонсоль("  ТипРасположенияСтрока():  " + типСтрРус)
    Исключение
        ВывестиСтрокуВКонсоль("    Тип расположения: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. МЕТОДЫ ДОБАВЛЕНИЯ =====
    имеетAddWidget = typeof Распол1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof Распол1_1.ДобавитьВиджет === 'function'
    имеетAddLayout = typeof Распол1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof Распол1_1.ДобавитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌") + ", ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌") + ", ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    
    // ===== 13. МЕТОДЫ ОЧИСТКИ И УДАЛЕНИЯ =====
    имеетClear = typeof Распол1_1.clear === 'function'
    имеетОчистить = typeof Распол1_1.Очистить === 'function'
    имеетRemoveWidget = typeof Распол1_1.removeWidget === 'function'
    имеетУдалитьВиджет = typeof Распол1_1.УдалитьВиджет === 'function'
    ВывестиСтрокуВКонсоль("    clear(): " + (имеетClear ? "✅" : "❌") + ", Очистить(): " + (имеетОчистить ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    removeWidget(): " + (имеетRemoveWidget ? "✅" : "❌") + ", УдалитьВиджет(): " + (имеетУдалитьВиджет ? "✅" : "❌"))
    
    // ===== 14. МЕТОДЫ ПОЛУЧЕНИЯ ЭЛЕМЕНТОВ =====
    имеетItemAt = typeof Распол1_1.itemAt === 'function'
    имеетЭлементПоИндексу = typeof Распол1_1.ЭлементПоИндексу === 'function'
    имеетTakeAt = typeof Распол1_1.takeAt === 'function'
    имеетВзятьПоИндексу = typeof Распол1_1.ВзятьПоИндексу === 'function'
    ВывестиСтрокуВКонсоль("    itemAt(): " + (имеетItemAt ? "✅" : "❌") + ", ЭлементПоИндексу(): " + (имеетЭлементПоИндексу ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    takeAt(): " + (имеетTakeAt ? "✅" : "❌") + ", ВзятьПоИндексу(): " + (имеетВзятьПоИндексу ? "✅" : "❌"))
    
    // ===== 15. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    реальный = Распол1_1.getRealLayout()
    реальныйРус = Распол1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 16. КОПИРОВАНИЕ =====
    Попытка
        Распол1_2 = Новый QtРасположение()
        Распол1_2.РежимОтладки(Режим_Отладки)
        результатКопия = Распол1_1.copyTo(Распол1_2)
        ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 17. РЕЖИМ ОТЛАДКИ =====
    имеетSetDebug = typeof Распол1_1.setDebug === 'function'
    имеетРежимОтладки = typeof Распол1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof Распол1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof Распол1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 18. ПРОВЕРКА RUSFUNC =====
    Если typeof Распол1_1.RusFunc === 'function' Тогда
        jsonStr = Распол1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 19. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем тестовый виджет
        тестВиджет = Новый QtВиджет()
        тестВиджет.Размер(400, 300)
        тестВиджет.Показать()
        
        // Создаем расположение
        тестРаспол = Новый QtРасположение()
        тестРаспол.РежимОтладки(Режим_Отладки)
        
        // Добавляем кнопки
        кнопка21 = Новый QtКнопка("Кнопка 1")
        кнопка22 = Новый QtКнопка("Кнопка 2")
        
        реальнаяКнопка21 = кнопка21.getRealWidget()
        реальнаяКнопка22 = кнопка22.getRealWidget()
        
        Если реальнаяКнопка21 != null И реальнаяКнопка22 != null Тогда
            тестРаспол.ДобавитьВиджет(реальнаяКнопка21)
            тестРаспол.ДобавитьВиджет(реальнаяКнопка22)
            
            реальныйВиджет = тестВиджет.getRealWidget()
            Если реальныйВиджет != null Тогда
                тестРаспол.УстановитьРодительскийВиджет(реальныйВиджет)
                колПосле = тестРаспол.Количество()
                ВывестиСтрокуВКонсоль("    Практическое использование: добавлено " + колПосле + " виджетов")
            КонецЕсли
        КонецЕсли
        
        тестВиджет.Скрыть()
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 20. ПРОВЕРКА МЕТОДА УСТАНОВКИ РОДИТЕЛЬСКОГО ВИДЖЕТА =====
    имеетSetParentWidget = typeof Распол1_1.setParentWidget === 'function'
    имеетУстановитьРодительскийВиджет = typeof Распол1_1.УстановитьРодительскийВиджет === 'function'
    ВывестиСтрокуВКонсоль("    setParentWidget(): " + (имеетSetParentWidget ? "✅" : "❌") + ", УстановитьРодительскийВиджет(): " + (имеетУстановитьРодительскийВиджет ? "✅" : "❌"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtLayout (QtРасположение) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtТабличнаяКомпоновка()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                      │ Английский метод                │
//├─────┼────────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                       │ isValid                        │
//│ 2 │ ПолучитьОбъект                     │ getRealObject                  │
//│ 3 │ УстановитьРодителя                 │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                   │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта               │ setObjectName                  │
//│ 6 │ ИмяОбъекта                         │ objectName                     │
//│ 7 │ УстановитьСвойство                 │ setProperty                    │
//│ 8 │ Свойство                           │ property                       │
//│ 9 │ ПодключитьСигнал                   │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                    │ disconnectSignal               │
//│ 11 │ КопироватьВ                        │ copyTo                         │
//│ 12 │ РежимОтладки                       │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки               │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                  │ getClassType                   │
//│ 15 │ УстановитьТипКласса                │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                  │ getClassName                   │
//│ 17 │ УстановитьИмяКласса                │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов              │ RusFunc                        │
//│ 19 │ ПолучитьРасположение               │ getRealLayout                  │
//│ 20 │ Действителен                       │ isValidValue                   │
//│ 21 │ УстановитьРодительскийВиджет       │ setParentWidget                │
//│ 22 │ РодительскийВиджет                 │ getParentWidget                │
//│ 23 │ ДобавитьВиджет                     │ addWidget                      │
//│ 24 │ ДобавитьРасположение               │ addLayout                      │
//│ 25 │ УдалитьВиджет                      │ removeWidget                   │
//│ 26 │ Очистить                           │ clear                          │
//│ 27 │ Обновить                           │ updateLayout                   │
//│ 28 │ Активировать                       │ activate                       │
//│ 29 │ Инвалидировать                     │ invalidate                     │
//│ 30 │ ЭлементПоИндексу                   │ itemAt                         │
//│ 31 │ ВзятьПоИндексу                     │ takeAt                         │
//│ 32 │ Количество                         │ getCountValue                  │
//│ 33 │ Пустой                             │ isEmptyValue                   │
//│ 34 │ Геометрия                          │ getGeometryValue               │
//│ 35 │ ПрямоугольникСодержимого           │ getContentsRectValue           │
//│ 36 │ УстановитьОтступ                   │ setMarginValue                 │
//│ 37 │ Отступ                             │ getMarginValue                 │
//│ 38 │ УстановитьЛевыйОтступ              │ setLeftMarginValue             │
//│ 39 │ ЛевыйОтступ                        │ getLeftMarginValue             │
//│ 40 │ УстановитьПравыйОтступ             │ setRightMarginValue            │
//│ 41 │ ПравыйОтступ                       │ getRightMarginValue            │
//│ 42 │ УстановитьВерхнийОтступ            │ setTopMarginValue              │
//│ 43 │ ВерхнийОтступ                      │ getTopMarginValue              │
//│ 44 │ УстановитьНижнийОтступ             │ setBottomMarginValue           │
//│ 45 │ НижнийОтступ                       │ getBottomMarginValue           │
//│ 46 │ УстановитьПромежуток               │ setSpacingValue                │
//│ 47 │ Промежуток                         │ getSpacingValue                │
//│ 48 │ УстановитьДоступен                 │ setEnabledValue                │
//│ 49 │ Доступен                           │ isEnabledValue                 │
//│ 50 │ УстановитьИмяОбъекта               │ setObjectName                  │
//│ 51 │ ИмяОбъекта                         │ getObjectName                  │
//│ 52 │ ТипРасположения                    │ getLayoutTypeValue             │
//│ 53 │ ТипРасположенияСтрока              │ layoutTypeString               │
//│ 54 │ КопироватьВ                        │ copyTo                         │
//│ 55 │ Расположение                       │ getRealLayout                  │
//│ 56 │ КолЭлементов                       │ getCountValue                  │
//│ 57 │ Пусто                              │ isEmptyValue                   │
//│ 58 │ Отступы                            │ getMarginValue                 │
//│ 59 │ Промежутки                         │ getSpacingValue                │
//│ 60 │ Тип                                │ getLayoutTypeValue             │
//│ 61 │ ПолучитьТабличнуюКомпоновку        │ getRealGridLayout              │
//│ 62 │ КоличествоСтрок                    │ getRowCountValue               │
//│ 63 │ КоличествоКолонок                  │ getColumnCountValue            │
//│ 64 │ ГоризонтальныйПромежуток           │ getHorizontalSpacingValue      │
//│ 65 │ УстановитьГоризонтальныйПромежуток │ setHorizontalSpacingValue      │
//│ 66 │ ВертикальныйПромежуток             │ getVerticalSpacingValue        │
//│ 67 │ УстановитьВертикальныйПромежуток   │ setVerticalSpacingValue        │
//│ 68 │ ДобавитьВиджет                     │ addWidget                      │
//│ 69 │ ДобавитьВиджетПростой              │ addWidgetSimple                │
//│ 70 │ ДобавитьВиджетСВыравниванием       │ addWidgetAlignment             │
//│ 71 │ ДобавитьРасположение               │ addLayout                      │
//│ 72 │ УстановитьРастяжениеСтроки         │ setRowStretchValue             │
//│ 73 │ РастяжениеСтроки                   │ getRowStretchValue             │
//│ 74 │ УстановитьРастяжениеКолонки        │ setColumnStretchValue          │
//│ 75 │ РастяжениеКолонки                  │ getColumnStretchValue          │
//│ 76 │ УстановитьМинимальнуюВысотуСтроки  │ setRowMinimumHeight            │
//│ 77 │ УстановитьМинимальнуюШиринуКолонки │ setColumnMinimumWidth          │
//│ 78 │ ЭлементПоПозиции                   │ itemAtPosition                 │
//│ 79 │ КопироватьВ                        │ copyTo                         │
//│ 80 │ Строки                             │ getRowCountValue               │
//│ 81 │ Колонки                            │ getColumnCountValue            │
//│ 82 │ ГПромежуток                        │ getHorizontalSpacingValue      │
//│ 83 │ ВПромежуток                        │ getVerticalSpacingValue        │
//│ 84 │ РастяжениеСтр                      │ getRowStretchValue             │
//│ 85 │ РастяжениеКол                      │ getColumnStretchValue          │
//└─────┴────────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtGridLayout (QtТабличнаяКомпоновка) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ТаблКомп1_1 = Новый QtТабличнаяКомпоновка()
    ТаблКомп1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ТаблКомп1_1.isValid()
    валидныйРус = ТаблКомп1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. КОЛИЧЕСТВО СТРОК И КОЛОНОК =====
    строкРус = ТаблКомп1_1.КоличествоСтрок()
    колонокРус = ТаблКомп1_1.КоличествоКолонок()
    ВывестиСтрокуВКонсоль(" КоличествоСтрок: " + строкРус + " (ожидается 0)")
    ВывестиСтрокуВКонсоль(" КоличествоКолонок: " + колонокРус + " (ожидается 0)")
    
    // ===== 4. ПРОМЕЖУТКИ =====
    Попытка
        ТаблКомп1_1.УстановитьГоризонтальныйПромежуток(15)
        горизРус = ТаблКомп1_1.ГоризонтальныйПромежуток()
        ТаблКомп1_1.УстановитьВертикальныйПромежуток(8)
        вертРус = ТаблКомп1_1.ВертикальныйПромежуток()
        ВывестиСтрокуВКонсоль(" ГоризонтальныйПромежуток(): " + горизРус + " (ожидается 15)")
        ВывестиСтрокуВКонсоль(" ВертикальныйПромежуток(): " + вертРус + " (ожидается 8)")
    Исключение
        ВывестиСтрокуВКонсоль("    Промежутки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ОТСТУПЫ И ДОСТУПНОСТЬ =====
    Попытка
        ТаблКомп1_1.УстановитьОтступ(15)
        отступРус = ТаблКомп1_1.Отступ()
        ТаблКомп1_1.УстановитьДоступен(false)
        доступенРус = ТаблКомп1_1.Доступен()
        ТаблКомп1_1.УстановитьДоступен(true)
        доступен2Рус = ТаблКомп1_1.Доступен()
        
        ВывестиСтрокуВКонсоль(" Отступ(): " + отступРус + " (ожидается 10 / 15)")
        ВывестиСтрокуВКонсоль(" Доступен(): " + доступенРус + "->" + доступен2Рус + " (ожидается false->true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. РАСТЯЖЕНИЕ =====
    Попытка
        ТаблКомп1_1.УстановитьРастяжениеСтроки(0, 4)
        растСтрРус = ТаблКомп1_1.РастяжениеСтроки(0)
        ТаблКомп1_1.УстановитьРастяжениеКолонки(1, 5)
        растКолРус = ТаблКомп1_1.РастяжениеКолонки(1)
        ВывестиСтрокуВКонсоль("  РастяжениеСтроки(0): " + растСтрРус + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  РастяжениеКолонки(1): " + растКолРус + " (ожидается 5)")
    Исключение
        ВывестиСтрокуВКонсоль("    Растяжение: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. МЕТОДЫ ДОБАВЛЕНИЯ ВИДЖЕТОВ =====
    имеетAddWidget = typeof ТаблКомп1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof ТаблКомп1_1.ДобавитьВиджет === 'function'
    имеетAddWidgetSimple = typeof ТаблКомп1_1.addWidgetSimple === 'function'
    имеетДобавитьВиджетПростой = typeof ТаблКомп1_1.ДобавитьВиджетПростой === 'function'
    имеетAddWidgetAlignment = typeof ТаблКомп1_1.addWidgetAlignment === 'function'
    имеетДобавитьВиджетСВыравниванием = typeof ТаблКомп1_1.ДобавитьВиджетСВыравниванием === 'function'
    
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌") + ", ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addWidgetSimple(): " + (имеетAddWidgetSimple ? "✅" : "❌") + ", ДобавитьВиджетПростой(): " + (имеетДобавитьВиджетПростой ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addWidgetAlignment(): " + (имеетAddWidgetAlignment ? "✅" : "❌") + ", ДобавитьВиджетСВыравниванием(): " + (имеетДобавитьВиджетСВыравниванием ? "✅" : "❌"))
    
    // ===== 8. МЕТОДЫ РАБОТЫ С РАСПОЛОЖЕНИЯМИ =====
    имеетAddLayout = typeof ТаблКомп1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof ТаблКомп1_1.ДобавитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌") + ", ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    
    // ===== 9. МИНИМАЛЬНЫЕ РАЗМЕРЫ =====
    имеетSetRowMinHeight = typeof ТаблКомп1_1.setRowMinimumHeight === 'function'
    имеетУстановитьMinHeight = typeof ТаблКомп1_1.УстановитьМинимальнуюВысотуСтроки === 'function'
    имеетSetColMinWidth = typeof ТаблКомп1_1.setColumnMinimumWidth === 'function'
    имеетУстановитьMinWidth = typeof ТаблКомп1_1.УстановитьМинимальнуюШиринуКолонки === 'function'
    
    ВывестиСтрокуВКонсоль("    setRowMinimumHeight(): " + (имеетSetRowMinHeight ? "✅" : "❌") + ", УстановитьМинимальнуюВысотуСтроки(): " + (имеетУстановитьMinHeight ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setColumnMinimumWidth(): " + (имеетSetColMinWidth ? "✅" : "❌") + ", УстановитьМинимальнуюШиринуКолонки(): " + (имеетУстановитьMinWidth ? "✅" : "❌"))
    
    // ===== 10. МЕТОДЫ ПОЛУЧЕНИЯ ЭЛЕМЕНТОВ =====
    имеетItemAtPosition = typeof ТаблКомп1_1.itemAtPosition === 'function'
    имеетЭлементПоПозиции = typeof ТаблКомп1_1.ЭлементПоПозиции === 'function'
    имеетItemAt = typeof ТаблКомп1_1.itemAt === 'function'
    имеетЭлементПоИндексу = typeof ТаблКомп1_1.ЭлементПоИндексу === 'function'
    имеетTakeAt = typeof ТаблКомп1_1.takeAt === 'function'
    имеетВзятьПоИндексу = typeof ТаблКомп1_1.ВзятьПоИндексу === 'function'
    
    ВывестиСтрокуВКонсоль("    itemAtPosition(): " + (имеетItemAtPosition ? "✅" : "❌") + ", ЭлементПоПозиции(): " + (имеетЭлементПоПозиции ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    itemAt(): " + (имеетItemAt ? "✅" : "❌") + ", ЭлементПоИндексу(): " + (имеетЭлементПоИндексу ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    takeAt(): " + (имеетTakeAt ? "✅" : "❌") + ", ВзятьПоИндексу(): " + (имеетВзятьПоИндексу ? "✅" : "❌"))
    
    // ===== 11. КОЛИЧЕСТВО И ПУСТОТА =====
    имеетКоличество = typeof ТаблКомп1_1.Количество === 'function'
    имеетПустой = typeof ТаблКомп1_1.Пустой === 'function'
    ВывестиСтрокуВКонсоль(" Количество(): " + (имеетКоличество ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль(" Пустой(): " + (имеетПустой ? "✅" : "❌"))
    
    // ===== 12. ГЕОМЕТРИЯ =====
    имеетГеометрия = typeof ТаблКомп1_1.Геометрия === 'function'
    имеетПрямоугольникСодержимого = typeof ТаблКомп1_1.ПрямоугольникСодержимого === 'function'
    ВывестиСтрокуВКонсоль(" Геометрия(): " + (имеетГеометрия ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль(" ПрямоугольникСодержимого(): " + (имеетПрямоугольникСодержимого ? "✅" : "❌"))
    
    // ===== 13. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = ТаблКомп1_1.getRealGridLayout()
    реальныйРус = ТаблКомп1_1.ПолучитьТабличнуюКомпоновку()
    реальныйLayout = ТаблКомп1_1.getRealLayout()
    реальныйLayoutРус = ТаблКомп1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealGridLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьТабличнуюКомпоновку(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 14. КОПИРОВАНИЕ =====
    Попытка
        ТаблКомп1_2 = Новый QtТабличнаяКомпоновка()
        ТаблКомп1_2.РежимОтладки(Режим_Отладки)
        результатКопия = ТаблКомп1_1.copyTo(ТаблКомп1_2)
        ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 15. ИМЯ ОБЪЕКТА =====
    имеетSetObjectName = typeof ТаблКомп1_1.setObjectName === 'function'
    имеетУстановитьИмяОбъекта = typeof ТаблКомп1_1.УстановитьИмяОбъекта === 'function'
    имеетObjectName = typeof ТаблКомп1_1.objectName === 'function'
    имеетИмяОбъекта = typeof ТаблКомп1_1.ИмяОбъекта === 'function'
    ВывестиСтрокуВКонсоль("    setObjectName(): " + (имеетSetObjectName ? "✅" : "❌") + ", УстановитьИмяОбъекта(): " + (имеетУстановитьИмяОбъекта ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    objectName(): " + (имеетObjectName ? "✅" : "❌") + ", ИмяОбъекта(): " + (имеетИмяОбъекта ? "✅" : "❌"))
    
    // ===== 16. РЕЖИМ ОТЛАДКИ =====
    имеетSetDebug = typeof ТаблКомп1_1.setDebug === 'function'
    имеетРежимОтладки = typeof ТаблКомп1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof ТаблКомп1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof ТаблКомп1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 17. ПРОВЕРКА RUSFUNC =====
    Если typeof ТаблКомп1_1.RusFunc === 'function' Тогда
        jsonStr = ТаблКомп1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 18. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем тестовый виджет
        тестВиджет4 = Новый QtВиджет()
        тестВиджет4.УстановитьФиксированныйРазмер(400, 300)
        тестВиджет4.Показать()
        
        // Создаем табличную компоновку
        тестСетка = Новый QtТабличнаяКомпоновка()
        тестСетка.РежимОтладки(Режим_Отладки)
        
        // Добавляем кнопки в сетку
        кнопка51 = Новый QtКнопка("Кнопка 1")
        кнопка52 = Новый QtКнопка("Кнопка 2")
        кнопка53 = Новый QtКнопка("Кнопка 3")
        кнопка54 = Новый QtКнопка("Кнопка 4")
        
        реальнаяКнопка1 = кнопка51.getRealWidget()
        реальнаяКнопка2 = кнопка52.getRealWidget()
        реальнаяКнопка3 = кнопка53.getRealWidget()
        реальнаяКнопка4 = кнопка54.getRealWidget()
        
        Если реальнаяКнопка1 != null И реальнаяКнопка2 != null И реальнаяКнопка3 != null И реальнаяКнопка4 != null Тогда
            тестСетка.ДобавитьВиджет(реальнаяКнопка1, 0, 0)  // строка 0, колонка 0
            тестСетка.ДобавитьВиджет(реальнаяКнопка2, 0, 1)  // строка 0, колонка 1
            тестСетка.ДобавитьВиджет(реальнаяКнопка3, 1, 0)  // строка 1, колонка 0
            тестСетка.ДобавитьВиджет(реальнаяКнопка4, 1, 1)  // строка 1, колонка 1
            
            реальныйВиджет = тестВиджет4.getRealWidget()
            Если реальныйВиджет != null Тогда
                тестСетка.УстановитьРодительскийВиджет(реальныйВиджет)
                
                строкПосле = тестСетка.КоличествоСтрок()
                колонокПосле = тестСетка.КоличествоКолонок()
                ВывестиСтрокуВКонсоль("    Практическое использование: строк=" + строкПосле + ", колонок=" + колонокПосле + " (ожидается 2,2)")
            КонецЕсли
        КонецЕсли
        
        тестВиджет4.Скрыть()
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== Тест QtGridLayout (QtТабличнаяКомпоновка) завершён.================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtДействиеИГруппа()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьРеальноеДействие       │ getRealAction                  │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ УстановитьТекст                │ setText                        │
//│ 22 │ Текст                          │ getText                        │
//│ 23 │ УстановитьИконку               │ setIcon                        │
//│ 24 │ Иконка                         │ getIcon                        │
//│ 25 │ УстановитьТекстИконки          │ setIconText                    │
//│ 26 │ ТекстИконки                    │ getIconText                    │
//│ 27 │ УстановитьПодсказку            │ setToolTip                     │
//│ 28 │ Подсказка                      │ getToolTip                     │
//│ 29 │ УстановитьСтатусПодсказку      │ setStatusTip                   │
//│ 30 │ СтатусПодсказка                │ getStatusTip                   │
//│ 31 │ УстановитьЧтоЭтоТекст          │ setWhatsThis                   │
//│ 32 │ ЧтоЭтоТекст                    │ getWhatsThis                   │
//│ 33 │ УстановитьКлавиши              │ setShortcut                    │
//│ 34 │ Клавиши                        │ getShortcut                    │
//│ 35 │ УстановитьКонтекстКлавиш       │ setShortcutContext             │
//│ 36 │ КонтекстКлавиш                 │ getShortcutContext             │
//│ 37 │ УстановитьПереключаемый        │ setCheckableValue              │
//│ 38 │ Переключаемый                  │ isCheckableValue               │
//│ 39 │ УстановитьВыбран               │ setCheckedValue                │
//│ 40 │ Выбран                         │ isCheckedValue                 │
//│ 41 │ Переключить                    │ toggle                         │
//│ 42 │ УстановитьДоступен             │ setEnabledValue                │
//│ 43 │ Доступен                       │ isEnabledValue                 │
//│ 44 │ УстановитьВидимый              │ setVisibleValue                │
//│ 45 │ Видимый                        │ isVisibleValue                 │
//│ 46 │ УстановитьГруппуДействий       │ setActionGroup                 │
//│ 47 │ ГруппаДействий                 │ getActionGroup                 │
//│ 48 │ УстановитьДанные               │ setData                        │
//│ 49 │ Данные                         │ getData                        │
//│ 50 │ УстановитьПриоритет            │ setPriorityValue               │
//│ 51 │ Приоритет                      │ getPriorityValue               │
//│ 52 │ УстановитьАвтоповтор           │ setAutoRepeatValue             │
//│ 53 │ Автоповтор                     │ autoRepeatValue                │
//│ 54 │ УстановитьШрифт                │ setFont                        │
//│ 55 │ Шрифт                          │ getFont                        │
//│ 56 │ Выполнить                      │ trigger                        │
//│ 57 │ Активировать                   │ activate                       │
//│ 58 │ УстановитьРодителя             │ setParentWrapper               │
//│ 59 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 60 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 61 │ ИмяОбъекта                     │ getObjectName                  │
//│ 62 │ РежимОтладки                   │ setDebug                       │
//│ 63 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 64 │ КопироватьВ                    │ copyTo                         │
//│ 65 │ Действие                       │ getRealAction                  │
//│ 66 │ ТекстДействия                  │ getText                        │
//│ 67 │ ИконкаДействия                 │ getIcon                        │
//│ 68 │ ПодсказкаДействия              │ getToolTip                     │
//│ 69 │ КлавишиДействия                │ getShortcut                    │
//│ 70 │ ВыбранДействие                 │ isCheckedValue                 │
//│ 71 │ ДоступноДействие               │ isEnabledValue                 │
//│ 72 │ ВидимоДействие                 │ isVisibleValue                 │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtAction (QtДействие) и QtActionGroup (QtГруппаДействий) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ========================================
    // ЧАСТЬ 1: ТЕСТИРОВАНИЕ QtДействие
    // ========================================
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("--- ТЕСТИРОВАНИЕ QtДействие (QtAction) ---")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ГрупДейст1_1 = Новый QtДействие()
    ГрупДейст1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ГрупДейст1_1.isValid()
    валидныйРус = ГрупДейст1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА ТЕКСТА =====
    Попытка
        ГрупДейст1_1.УстановитьТекст("Сохранить")
        текст = ГрупДейст1_1.Текст()
        ГрупДейст1_1.setIconText("Сохранить")
        ВывестиСтрокуВКонсоль("    Текст: " + текст)
    Исключение
        ВывестиСтрокуВКонсоль("    Установка текста: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. УСТАНОВКА КЛАВИШ =====
    Попытка
        ГрупДейст1_1.УстановитьКлавиши("Ctrl+S")
        клавиши = ГрупДейст1_1.Клавиши()
        ГрупДейст1_1.setShortcutContext(1)
        ВывестиСтрокуВКонсоль("    Клавиши: " + клавиши)
    Исключение
        ВывестиСтрокуВКонсоль("    Установка клавиш: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПЕРЕКЛЮЧАЕМОСТЬ И ВЫБРАННОСТЬ =====
    Попытка
        ГрупДейст1_1.УстановитьПереключаемый(ИСТИНА)
        перекл = ГрупДейст1_1.Переключаемый()
        ГрупДейст1_1.УстановитьВыбран(ИСТИНА)
        выбран = ГрупДейст1_1.Выбран()
        ВывестиСтрокуВКонсоль("    Переключаемый: " + перекл + ", Выбран: " + выбран)
    Исключение
        ВывестиСтрокуВКонсоль("    Переключаемость: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ДОСТУПНОСТЬ И ВИДИМОСТЬ =====
    Попытка
        ГрупДейст1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = ГрупДейст1_1.Доступен()
        ГрупДейст1_1.УстановитьВидимый(ЛОЖЬ)
        видим = ГрупДейст1_1.Видимый()
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + ", Видимый: " + видим)
    Исключение
        ВывестиСтрокуВКонсоль("    Доступность/видимость: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ДАННЫЕ =====
    Попытка
        ГрупДейст1_1.УстановитьДанные("Мои данные")
        данные = ГрупДейст1_1.Данные()
        ВывестиСтрокуВКонсоль("    Данные: " + данные)
    Исключение
        ВывестиСтрокуВКонсоль("    Данные: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ПРИОРИТЕТ =====
    Попытка
        ГрупДейст1_1.УстановитьПриоритет(1)
        приоритет = ГрупДейст1_1.Приоритет()
        ВывестиСтрокуВКонсоль("    Приоритет: " + приоритет)
    Исключение
        ВывестиСтрокуВКонсоль("    Приоритет: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. АВТОПОВТОР =====
    Попытка
        ГрупДейст1_1.УстановитьАвтоповтор(ИСТИНА)
        авто = ГрупДейст1_1.Автоповтор()
        ВывестиСтрокуВКонсоль("    Автоповтор: " + авто)
    Исключение
        ВывестиСтрокуВКонсоль("    Автоповтор: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ИМЯ ОБЪЕКТА =====
    Попытка
        ГрупДейст1_1.УстановитьИмяОбъекта("myAction")
        имя = ГрупДейст1_1.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    ИмяОбъекта: " + имя)
    Исключение
        ВывестиСтрокуВКонсоль("    Имя объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    Попытка
        реальный = ГрупДейст1_1.getRealAction()
        ВывестиСтрокуВКонсоль("    getRealAction(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("    Получение реального объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПРОВЕРКА RUSFUNC =====
    Если typeof ГрупДейст1_1.RusFunc === 'function' Тогда
        jsonStr = ГрупДейст1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 3 метода:")
            Для i = 0 По 2 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 13. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ QtДействие =====
    имеетSetIcon = typeof ГрупДейст1_1.setIcon === 'function'
    имеетУстановитьИконку = typeof ГрупДейст1_1.УстановитьИконку === 'function'
    имеетSetToolTip = typeof ГрупДейст1_1.setToolTip === 'function'
    имеетУстановитьПодсказку = typeof ГрупДейст1_1.УстановитьПодсказку === 'function'
    имеетSetStatusTip = typeof ГрупДейст1_1.setStatusTip === 'function'
    //имеетУстановитьПодсказкуСтатуса = typeof ГрупДейст1_1.УстановитьПодсказкуСтатуса === 'function'
    имеетSetWhatsThis = typeof ГрупДейст1_1.setWhatsThis === 'function'
    //имеетУстановитьЧто = typeof ГрупДейст1_1.УстановитьЧто === 'function'
    
    ВывестиСтрокуВКонсоль("    setIcon(): " + (имеетSetIcon ? "✅" : "❌") + ", УстановитьИконку(): " + (имеетУстановитьИконку ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setToolTip(): " + (имеетSetToolTip ? "✅" : "❌") + ", УстановитьПодсказку(): " + (имеетУстановитьПодсказку ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setStatusTip(): " + (имеетSetStatusTip ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setWhatsThis(): " + (имеетSetWhatsThis ? "✅" : "❌"))
    
    // ========================================
    // ЧАСТЬ 2: ТЕСТИРОВАНИЕ QtГруппаДействий
    // ========================================
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("--- ТЕСТИРОВАНИЕ QtГруппаДействий (QtActionGroup) ---")
    
    // ===== 14. СОЗДАНИЕ ОБЪЕКТА ГРУППЫ =====
    ГрупДейст1_2 = Новый QtГруппаДействий()
    ГрупДейст1_2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта группы: УСПЕШНО")
    
    // ===== 15. ПРОВЕРКА ВАЛИДНОСТИ ГРУППЫ =====
    валидныйГр = ГрупДейст1_2.isValid()
    валидныйГрРус = ГрупДейст1_2.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидныйГр + ", Действителен(): " + валидныйГрРус + " (ожидается true)")
    
    // ===== 16. ДОБАВЛЕНИЕ ДЕЙСТВИЙ В ГРУППУ =====
    Попытка
        дейст1 = Новый QtДействие("Действие 1")
        дейст2 = Новый QtДействие("Действие 2")
        дейст3 = Новый QtДействие("Действие 3")
        
        ГрупДейст1_2.ДобавитьДействие(дейст1)
        ГрупДейст1_2.ДобавитьДействие(дейст2)
        ГрупДейст1_2.ДобавитьДействие(дейст3)
        
        кол = ГрупДейст1_2.Количество()
        колРус = ГрупДейст1_2.Количество()
        ВывестиСтрокуВКонсоль("    Добавлено 3 действия -> Количество(): " + кол + " / " + колРус + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Добавление действий: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 17. ПОЛУЧЕНИЕ СПИСКА ДЕЙСТВИЙ =====
    Попытка
        список = ГрупДейст1_2.Действия()
        ВывестиСтрокуВКонсоль("    Действия() размер: " + список.length + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Получение списка действий: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 18. УДАЛЕНИЕ ДЕЙСТВИЯ =====
    Попытка
        ГрупДейст1_2.УдалитьДействие(дейст2)
        колПосле = ГрупДейст1_2.Количество()
        ВывестиСтрокуВКонсоль("    УдалитьДействие() -> Количество(): " + колПосле + " (ожидается 2)")
    Исключение
        ВывестиСтрокуВКонсоль("    Удаление действия: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 19. ПРОВЕРКА НА ПУСТОТУ =====
    Попытка
        пуст = ГрупДейст1_2.Пустой()
        ВывестиСтрокуВКонсоль("    Пустой(): " + пуст + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    Проверка на пустоту: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 20. ПОЛИТИКА ИСКЛЮЧЕНИЯ =====
    Попытка
        ГрупДейст1_2.УстановитьПолитикуИсключения(0)
        политика = ГрупДейст1_2.ПолитикаИсключения()
        ВывестиСтрокуВКонсоль("    ПолитикаИсключения: " + политика + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Политика исключения: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 21. ДОСТУПНОСТЬ И ВИДИМОСТЬ ГРУППЫ =====
    Попытка
        ГрупДейст1_2.УстановитьДоступен(ЛОЖЬ)
        доступенГр = ГрупДейст1_2.Доступен()
        ГрупДейст1_2.УстановитьВидимый(ЛОЖЬ)
        видимГр = ГрупДейст1_2.Видимый()
        ВывестиСтрокуВКонсоль("    Доступен: " + доступенГр + ", Видимый: " + видимГр)
    Исключение
        ВывестиСтрокуВКонсоль("    Доступность/видимость группы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 22. ИМЯ ОБЪЕКТА ГРУППЫ =====
    Попытка
        ГрупДейст1_2.УстановитьИмяОбъекта("myGroup")
        имяГр = ГрупДейст1_2.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    ИмяОбъекта группы: " + имяГр)
    Исключение
        ВывестиСтрокуВКонсоль("    Имя объекта группы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 23. ВЫБРАННОЕ ДЕЙСТВИЕ =====
    Попытка
        // Создаем переключаемые действия для теста
        дейстВыб1 = Новый QtДействие("Выб 1")
        дейстВыб2 = Новый QtДействие("Выб 2")
        дейстВыб1.УстановитьПереключаемый(ИСТИНА)
        дейстВыб2.УстановитьПереключаемый(ИСТИНА)
        
        ГрупВыб = Новый QtГруппаДействий()
        ГрупВыб.ДобавитьДействие(дейстВыб1)
        ГрупВыб.ДобавитьДействие(дейстВыб2)
        дейстВыб1.УстановитьВыбран(ИСТИНА)
        
        выбранное = ГрупВыб.ВыбранноеДействие()
        Если выбранное != null Тогда
            текстВыб = выбранное.getText()
            ВывестиСтрокуВКонсоль("    ВыбранноеДействие(): " + текстВыб + " (ожидается 'Выб 1')")
        Иначе
            ВывестиСтрокуВКонсоль("    ВыбранноеДействие(): null")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Выбранное действие: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 24. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА ГРУППЫ =====
    Попытка
        реальныйГр = ГрупДейст1_2.getRealActionGroup()
        ВывестиСтрокуВКонсоль("    getRealActionGroup(): " + (реальныйГр != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("    Получение реальной группы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 25. ПРОВЕРКА RUSFUNC ГРУППЫ =====
    Если typeof ГрупДейст1_2.RusFunc === 'function' Тогда
        jsonStrГр = ГрупДейст1_2.RusFunc()
        картаГр = JSON.parse(jsonStrГр)
        ВывестиСтрокуВКонсоль("    RusFunc() группы: " + картаГр.length + " методов")
        Если картаГр.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 3 метода группы:")
            Для i = 0 По 2 Цикл
                Если i < картаГр.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + картаГр[i].русскоеИмя + " -> " + картаГр[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc() группы: НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 26. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ ГРУППЫ =====
    имеетДобавитьДействие = typeof ГрупДейст1_2.ДобавитьДействие === 'function'
    имеетУдалитьДействие = typeof ГрупДейст1_2.УдалитьДействие === 'function'
    имеетДействия = typeof ГрупДейст1_2.Действия === 'function'
    имеетВыбранноеДействие = typeof ГрупДейст1_2.ВыбранноеДействие === 'function'
    
    ВывестиСтрокуВКонсоль(" ДобавитьДействие(): " + (имеетДобавитьДействие ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль(" УдалитьДействие(): " + (имеетУдалитьДействие ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль(" Действия(): " + (имеетДействия ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль(" ВыбранноеДействие(): " + (имеетВыбранноеДействие ? "✅" : "❌"))
    
    // ===== 27. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - КОПИРОВАНИЕ =====
    имеетCopyTo = typeof ГрупДейст1_1.copyTo === 'function'
    имеетКопироватьВ = typeof ГрупДейст1_1.КопироватьВ === 'function'
    ВывестиСтрокуВКонсоль("    copyTo(): " + (имеетCopyTo ? "✅" : "❌") + ", КопироватьВ(): " + (имеетКопироватьВ ? "✅" : "❌"))
    
    // ===== 28. ДОПОЛНИТЕЛЬНАЯ ПРОВЕРКА - РЕЖИМ ОТЛАДКИ =====
    имеетSetDebug = typeof ГрупДейст1_1.setDebug === 'function'
    имеетРежимОтладки = typeof ГрупДейст1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof ГрупДейст1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof ГрупДейст1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 29. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем меню для демонстрации
        меню = Новый QtМеню("Файл")
        действиеОткрыть = Новый QtДействие("Открыть")
        действиеСохранить = Новый QtДействие("Сохранить")
        действиеВыход = Новый QtДействие("Выход")
        
        действиеОткрыть.УстановитьКлавиши("Ctrl+O")
        действиеСохранить.УстановитьКлавиши("Ctrl+S")
        
        меню.ДобавитьДействие(действиеОткрыть)
        меню.ДобавитьДействие(действиеСохранить)
        меню.ДобавитьРазделитель()
        меню.ДобавитьДействие(действиеВыход)
        
        реальныйМеню = меню.getRealMenu()
        Если реальныйМеню != null Тогда
            ВывестиСтрокуВКонсоль("    Практическое использование: меню создано успешно")
        Иначе
            ВывестиСтрокуВКонсоль("    Практическое использование: меню не создано")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== Тест QtAction (QtДействие) и QtActionGroup (QtГруппаДействий) завершён.============") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtДействие()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьРеальноеДействие       │ getRealAction                  │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ УстановитьТекст                │ setText                        │
//│ 22 │ Текст                          │ getText                        │
//│ 23 │ УстановитьИконку               │ setIcon                        │
//│ 24 │ Иконка                         │ getIcon                        │
//│ 25 │ УстановитьТекстИконки          │ setIconText                    │
//│ 26 │ ТекстИконки                    │ getIconText                    │
//│ 27 │ УстановитьПодсказку            │ setToolTip                     │
//│ 28 │ Подсказка                      │ getToolTip                     │
//│ 29 │ УстановитьСтатусПодсказку      │ setStatusTip                   │
//│ 30 │ СтатусПодсказка                │ getStatusTip                   │
//│ 31 │ УстановитьЧтоЭтоТекст          │ setWhatsThis                   │
//│ 32 │ ЧтоЭтоТекст                    │ getWhatsThis                   │
//│ 33 │ УстановитьКлавиши              │ setShortcut                    │
//│ 34 │ Клавиши                        │ getShortcut                    │
//│ 35 │ УстановитьКонтекстКлавиш       │ setShortcutContext             │
//│ 36 │ КонтекстКлавиш                 │ getShortcutContext             │
//│ 37 │ УстановитьПереключаемый        │ setCheckableValue              │
//│ 38 │ Переключаемый                  │ isCheckableValue               │
//│ 39 │ УстановитьВыбран               │ setCheckedValue                │
//│ 40 │ Выбран                         │ isCheckedValue                 │
//│ 41 │ Переключить                    │ toggle                         │
//│ 42 │ УстановитьДоступен             │ setEnabledValue                │
//│ 43 │ Доступен                       │ isEnabledValue                 │
//│ 44 │ УстановитьВидимый              │ setVisibleValue                │
//│ 45 │ Видимый                        │ isVisibleValue                 │
//│ 46 │ УстановитьГруппуДействий       │ setActionGroup                 │
//│ 47 │ ГруппаДействий                 │ getActionGroup                 │
//│ 48 │ УстановитьДанные               │ setData                        │
//│ 49 │ Данные                         │ getData                        │
//│ 50 │ УстановитьПриоритет            │ setPriorityValue               │
//│ 51 │ Приоритет                      │ getPriorityValue               │
//│ 52 │ УстановитьАвтоповтор           │ setAutoRepeatValue             │
//│ 53 │ Автоповтор                     │ autoRepeatValue                │
//│ 54 │ УстановитьШрифт                │ setFont                        │
//│ 55 │ Шрифт                          │ getFont                        │
//│ 56 │ Выполнить                      │ trigger                        │
//│ 57 │ Активировать                   │ activate                       │
//│ 58 │ УстановитьРодителя             │ setParentWrapper               │
//│ 59 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 60 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 61 │ ИмяОбъекта                     │ getObjectName                  │
//│ 62 │ РежимОтладки                   │ setDebug                       │
//│ 63 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 64 │ КопироватьВ                    │ copyTo                         │
//│ 65 │ Действие                       │ getRealAction                  │
//│ 66 │ ТекстДействия                  │ getText                        │
//│ 67 │ ИконкаДействия                 │ getIcon                        │
//│ 68 │ ПодсказкаДействия              │ getToolTip                     │
//│ 69 │ КлавишиДействия                │ getShortcut                    │
//│ 70 │ ВыбранДействие                 │ isCheckedValue                 │
//│ 71 │ ДоступноДействие               │ isEnabledValue                 │
//│ 72 │ ВидимоДействие                 │ isVisibleValue                 │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtAction (QtДействие) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Действ1_1 = Новый QtДействие()
    Действ1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Действ1_1.isValid()
    валидныйРус = Действ1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА ТЕКСТА =====
    Попытка
        Действ1_1.УстановитьТекст("Сохранить")
        текст = Действ1_1.Текст()
        ВывестиСтрокуВКонсоль("    Текст: " + текст)
    Исключение
        ВывестиСтрокуВКонсоль("    Установка текста: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. УСТАНОВКА КЛАВИШ =====
    Попытка
        Действ1_1.УстановитьКлавиши("Ctrl+S")
        клавиши = Действ1_1.Клавиши()
        ВывестиСтрокуВКонсоль("    Клавиши: " + клавиши.toString())
    Исключение
        ВывестиСтрокуВКонсоль("    Установка клавиш: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПЕРЕКЛЮЧАЕМОСТЬ И ВЫБРАННОСТЬ =====
    Попытка
        Действ1_1.УстановитьПереключаемый(ИСТИНА)
        перекл = Действ1_1.Переключаемый()
        Действ1_1.УстановитьВыбран(ИСТИНА)
        выбран = Действ1_1.Выбран()
        ВывестиСтрокуВКонсоль("    Переключаемый: " + перекл + ", Выбран: " + выбран + " (ожидается true, true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Переключаемость: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ДОСТУПНОСТЬ И ВИДИМОСТЬ =====
    Попытка
        Действ1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = Действ1_1.Доступен()
        Действ1_1.УстановитьВидимый(ЛОЖЬ)
        видим = Действ1_1.Видимый()
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + ", Видимый: " + видим + " (ожидается false, false)")
    Исключение
        ВывестиСтрокуВКонсоль("    Доступность/видимость: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ДАННЫЕ =====
    Попытка
        Действ1_1.УстановитьДанные("Мои данные")
        данные = Действ1_1.Данные()
        ВывестиСтрокуВКонсоль("    Данные: " + данные.toString())
    Исключение
        ВывестиСтрокуВКонсоль("    Данные: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. ПРИОРИТЕТ =====
    Попытка
        Действ1_1.УстановитьПриоритет(1)
        приоритет = Действ1_1.Приоритет()
        ВывестиСтрокуВКонсоль("    Приоритет: " + приоритет + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    Приоритет: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. АВТОПОВТОР =====
    Попытка
        Действ1_1.УстановитьАвтоповтор(ИСТИНА)
        авто = Действ1_1.Автоповтор()
        ВывестиСтрокуВКонсоль("    Автоповтор: " + авто + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Автоповтор: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ИМЯ ОБЪЕКТА =====
    Попытка
        Действ1_1.УстановитьИмяОбъекта("myAction")
        имя = Действ1_1.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    ИмяОбъекта: " + имя + " (ожидается myAction)")
    Исключение
        ВывестиСтрокуВКонсоль("    Имя объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ИКОНКА, ПОДСКАЗКИ =====
    Попытка
        Действ1_1.УстановитьИконку("icon.png")
        иконка = Действ1_1.Иконка()
        Действ1_1.УстановитьПодсказку("Подсказка")
        подсказка = Действ1_1.Подсказка()
        ВывестиСтрокуВКонсоль("    Иконка, Подсказка ")
    Исключение
        ВывестиСтрокуВКонсоль("    Иконка/подсказки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    Попытка
        реальный = Действ1_1.getRealAction()
        ВывестиСтрокуВКонсоль("    getRealAction(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("    Получение реального объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 13. КОПИРОВАНИЕ =====
    Попытка
        Действ1_2 = Новый QtДействие()
        Действ1_2.РежимОтладки(Режим_Отладки)
        результатКопия = Действ1_1.copyTo(Действ1_2)
        ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 14. РЕЖИМ ОТЛАДКИ =====
    имеетSetDebug = typeof Действ1_1.setDebug === 'function'
    имеетРежимОтладки = typeof Действ1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof Действ1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof Действ1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 15. ПРОВЕРКА RUSFUNC =====
    Если typeof Действ1_1.RusFunc === 'function' Тогда
        jsonStr = Действ1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 16. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    имеетSetStatusTip = typeof Действ1_1.setStatusTip === 'function'
    имеетSetWhatsThis = typeof Действ1_1.setWhatsThis === 'function'
    имеетSetToolTip = typeof Действ1_1.setToolTip === 'function'
    имеетУстановитьПодсказку = typeof Действ1_1.УстановитьПодсказку === 'function'
    имеетSetIcon = typeof Действ1_1.setIcon === 'function'
    имеетУстановитьИконку = typeof Действ1_1.УстановитьИконку === 'function'
    
    ВывестиСтрокуВКонсоль("    setStatusTip(): " + (имеетSetStatusTip ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setWhatsThis(): " + (имеетSetWhatsThis ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setToolTip(): " + (имеетSetToolTip ? "✅" : "❌") + ", УстановитьПодсказку(): " + (имеетУстановитьПодсказку ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    setIcon(): " + (имеетSetIcon ? "✅" : "❌") + ", УстановитьИконку(): " + (имеетУстановитьИконку ? "✅" : "❌"))
    
    // ===== 18. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем меню и добавляем действия
        меню22 = Новый QtМеню("Файл")
        
        действиеОткрыть22 = Новый QtДействие("Открыть")
        действиеСохранить22 = Новый QtДействие("Сохранить")
        действиеВыход22 = Новый QtДействие("Выход")
        
        действиеОткрыть22.УстановитьКлавиши("Ctrl+O")
        действиеСохранить22.УстановитьКлавиши("Ctrl+S")
        действиеВыход22.УстановитьКлавиши("Ctrl+Q")
        
        меню22.ДобавитьДействие(действиеОткрыть22)
        меню22.ДобавитьДействие(действиеСохранить22)
        меню22.ДобавитьРазделитель()
        меню22.ДобавитьДействие(действиеВыход22)
        
        реальныйМеню = меню22.getRealMenu()
        Если реальныйМеню != null Тогда
            ВывестиСтрокуВКонсоль("    Практическое использование: меню создано успешно")
        Иначе
            ВывестиСтрокуВКонсоль("    Практическое использование: меню не создано")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== Тест QtAction (QtДействие) завершён.=============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtОбработчикОчистки()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Действителен                   │ isValidValue                   │
//│ 20 │ Добавить                       │ add                            │
//│ 21 │ ДобавитьНесколькоОбъектов      │ addObjects                     │
//│ 22 │ Удалить                        │ remove                         │
//│ 23 │ УдалитьНесколькоОбъектов       │ removeObjects                  │
//│ 24 │ Очистить                       │ clear                          │
//│ 25 │ Пусто                          │ isEmptyValue                   │
//│ 26 │ Количество                     │ getCountValue                  │
//│ 27 │ Объекты                        │ getObjectsValue                │
//│ 28 │ КопироватьВ                    │ copyTo                         │
//│ 29 │ ПолучитьОбработчик             │ getRealHandler                 │
//│ 30 │ Содержит                       │ contains                       │
//│ 31 │ ПроверитьОбъекты               │ checkObjects                   │
//│ 32 │ КолОбъектов                    │ getCountValue                  │
//│ 33 │ СписокОбъектов                 │ getObjectsValue                │
//│ 34 │ ЕстьОбъект                     │ contains                       │
//│ 35 │ Проверить                      │ checkObjects                   │
//│ 36 │ Действителен                   │ isValid                        │
//│ 37 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 38 │ РежимОтладки                   │ setDebug                       │
//│ 39 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 40 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 41 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtObjectCleanupHandler (QtОбработчикОчистки) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ОбрОч1_1 = Новый QtОбработчикОчистки()
    ОбрОч1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    пустоРус = ОбрОч1_1.Пусто()
    количествоРус = ОбрОч1_1.Количество()
    действителенРус = ОбрОч1_1.Действителен()
    ВывестиСтрокуВКонсоль("    Пусто(): " + пустоРус + ", Количество: " + количествоРус + ", Действителен: " + действителенРус + " (ожидается true,0,true)")
    
    // ===== 3. ДОБАВЛЕНИЕ ОБЪЕКТА =====
    Попытка
        тестОбъект = Новый QtObject()
        ОбрОч1_1.Добавить(тестОбъект)
        колПосле = ОбрОч1_1.Количество()
        содержит = ОбрОч1_1.Содержит(тестОбъект)
        ВывестиСтрокуВКонсоль("    Добавить() -> Количество: " + колПосле + ", Содержит: " + содержит + " (ожидается 1, true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Добавление объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. ДОБАВЛЕНИЕ НЕСКОЛЬКИХ ОБЪЕКТОВ =====
    Попытка
        объект1 = Новый QtObject()
        объект2 = Новый QtObject()
        объект3 = Новый QtObject()
        списокОбъектов = [объект1, объект2, объект3]
        ОбрОч1_1.ДобавитьНесколькоОбъектов(списокОбъектов)
        колПосле = ОбрОч1_1.Количество()
        ВывестиСтрокуВКонсоль("    ДобавитьНесколькоОбъектов(3) -> Количество: " + колПосле + " (ожидается 4)")
    Исключение
        ВывестиСтрокуВКонсоль("    Добавление нескольких объектов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОЛУЧЕНИЕ СПИСКА ОБЪЕКТОВ =====
    Попытка
        объекты = ОбрОч1_1.Объекты()
        колОбъектов = объекты.length
        ВывестиСтрокуВКонсоль("    Объекты() -> длина: " + колОбъектов + " (ожидается 4)")
    Исключение
        ВывестиСтрокуВКонсоль("    Получение списка объектов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПРОВЕРКА ОБЪЕКТОВ =====
    Попытка
        всеВалидны = ОбрОч1_1.ПроверитьОбъекты()
        ВывестиСтрокуВКонсоль("    ПроверитьОбъекты(): " + всеВалидны + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Проверка объектов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. УДАЛЕНИЕ ОБЪЕКТА =====
    Попытка
        ОбрОч1_1.Удалить(тестОбъект)
        колПосле = ОбрОч1_1.Количество()
        содержит = ОбрОч1_1.Содержит(тестОбъект)
        ВывестиСтрокуВКонсоль("    Удалить() -> Количество: " + колПосле + ", Содержит: " + содержит + " (ожидается 3, false)")
    Исключение
        ВывестиСтрокуВКонсоль("    Удаление объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. УДАЛЕНИЕ НЕСКОЛЬКИХ ОБЪЕКТОВ =====
    Попытка
        списокУдаления = [объект1, объект2]
        ОбрОч1_1.УдалитьНесколькоОбъектов(списокУдаления)
        колПосле = ОбрОч1_1.Количество()
        ВывестиСтрокуВКонсоль("    УдалитьНесколькоОбъектов(2) -> Количество: " + колПосле + " (ожидается 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    Удаление нескольких объектов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. КОПИРОВАНИЕ =====
    Попытка
        цель9 = Новый QtОбработчикОчистки()
        цель9.РежимОтладки(Режим_Отладки)
        результат = ОбрОч1_1.КопироватьВ(цель9)
        колЦель = цель9.Количество()
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + ", Количество целевого: " + колЦель + " (ожидается true, 1)")
    Исключение
        ВывестиСтрокуВКонсоль("    Копирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБРАБОТЧИКА =====
    Попытка
        реал = ОбрОч1_1.ПолучитьОбработчик()
        реалРус = ОбрОч1_1.ПолучитьОбработчик()
        ВывестиСтрокуВКонсоль("    ПолучитьОбработчик(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН") + " / " + (реалРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("    Получение реального обработчика: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 11. ОЧИСТКА =====
    Попытка
        ОбрОч1_1.Очистить()
        пусто = ОбрОч1_1.Пусто()
        количество = ОбрОч1_1.Количество()
        ВывестиСтрокуВКонсоль("    Очистить() -> Пусто: " + пусто + ", Количество: " + количество + " (ожидается true, 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Очистка: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 12. ПРОВЕРКА ИМЕНИ ОБЪЕКТА =====
    Попытка
        ОбрОч1_1.УстановитьИмяОбъекта("MyCleanupHandler")
        имя = ОбрОч1_1.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    ИмяОбъекта: " + имя + " (ожидается MyCleanupHandler)")
    Исключение
        ВывестиСтрокуВКонсоль("    Имя объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 13. ПРОВЕРКА РЕЖИМА ОТЛАДКИ =====
    имеетSetDebug = typeof ОбрОч1_1.setDebug === 'function'
    имеетРежимОтладки = typeof ОбрОч1_1.РежимОтладки === 'function'
    имеетGetDebug = typeof ОбрОч1_1.getDebug === 'function'
    имеетПолучитьРежимОтладки = typeof ОбрОч1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("    setDebug(): " + (имеетSetDebug ? "✅" : "❌") + ", РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getDebug(): " + (имеетGetDebug ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    
    // ===== 14. ПРОВЕРКА RUSFUNC =====
    Если typeof ОбрОч1_1.RusFunc === 'function' Тогда
        jsonStr = ОбрОч1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("      " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // ===== 15. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    имеетДействителен = typeof ОбрОч1_1.Действителен === 'function'
    имеетПустой = typeof ОбрОч1_1.Пусто === 'function'
    имеетКоличество = typeof ОбрОч1_1.Количество === 'function'
    имеетСодержит = typeof ОбрОч1_1.Содержит === 'function'
    имеетДобавить = typeof ОбрОч1_1.Добавить === 'function'
    имеетДобавитьНесколькоОбъектов = typeof ОбрОч1_1.ДобавитьНесколькоОбъектов === 'function'
    имеетУдалить = typeof ОбрОч1_1.Удалить === 'function'
    имеетУдалитьНесколькоОбъектов = typeof ОбрОч1_1.УдалитьНесколькоОбъектов === 'function'
    имеетОбъекты = typeof ОбрОч1_1.Объекты === 'function'
    имеетПроверитьОбъекты = typeof ОбрОч1_1.ПроверитьОбъекты === 'function'
    имеетОчистить = typeof ОбрОч1_1.Очистить === 'function'
    имеетКопироватьВ = typeof ОбрОч1_1.КопироватьВ === 'function'
    имеетПолучитьОбработчик = typeof ОбрОч1_1.ПолучитьОбработчик === 'function'
    
    ВывестиСтрокуВКонсоль("   Действителен(): " + (имеетДействителен ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Пустой(): " + (имеетПустой ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Количество(): " + (имеетКоличество ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Содержит(): " + (имеетСодержит ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("   Добавить(): " + (имеетДобавить ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  ДобавитьНесколькоОбъектов(): " + (имеетДобавитьНесколькоОбъектов ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  Удалить(): " + (имеетУдалить ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  УдалитьНесколькоОбъектов(): " + (имеетУдалитьНесколькоОбъектов ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  Объекты(): " + (имеетОбъекты ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  ПроверитьОбъекты(): " + (имеетПроверитьОбъекты ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  Очистить(): " + (имеетОчистить ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  КопироватьВ(): " + (имеетКопироватьВ ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("  ПолучитьОбработчик(): " + (имеетПолучитьОбработчик ? "✅" : "❌"))
    
    // ===== 16. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        // Создаем обработчик для управления объектами
        хендлер = Новый QtОбработчикОчистки()
        хендлер.РежимОтладки(Режим_Отладки)
        
        // Создаем несколько объектов
        виджет161 = Новый QtВиджет()
        виджет162 = Новый QtВиджет()
        таймер16 = Новый QtТаймер()
        
        // Добавляем объекты в обработчик
        хендлер.Добавить(виджет161)
        хендлер.Добавить(виджет162)
        хендлер.Добавить(таймер16)
        
        колОбъектов = хендлер.Количество()
        всеВалидны = хендлер.ПроверитьОбъекты()
        
        ВывестиСтрокуВКонсоль("    Практическое использование: добавлено " + колОбъектов + " объектов, все валидны: " + всеВалидны)
        
        // Очищаем обработчик
        хендлер.Очистить()
        колПосле = хендлер.Количество()
        ВывестиСтрокуВКонсоль("    После очистки: " + колПосле + " объектов")
    Исключение
        ВывестиСтрокуВКонсоль("    Практическое использование: ОШИБКА - " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== Тест QtObjectCleanupHandler (QtОбработчикОчистки) завершён.=========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtЦиклСобытий()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ exec                           │
//│ 20 │ ЗапуститьСФлагами              │ execWithFlags                  │
//│ 21 │ Выйти                          │ exit                           │
//│ 22 │ Остановить                     │ quit                           │
//│ 23 │ Запущен                        │ isRunningValue                 │
//│ 24 │ Действителен                   │ isValidValue                   │
//│ 25 │ ОбработатьСобытия              │ processEvents                  │
//│ 26 │ ОбработатьВсеСобытия           │ processAllEvents               │
//│ 27 │ ОбработатьОжидающиеСобытия     │ processPendingEvents           │
//│ 28 │ ПолучитьЦикл                   │ getRealLoop                    │
//│ 29 │ КопироватьВ                    │ copyTo                         │
//│ 30 │ Выполнить                      │ exec                           │
//│ 31 │ ЗапуститьЦикл                  │ exec                           │
//│ 32 │ ОстановитьЦикл                 │ quit                           │
//│ 33 │ ВыйтиИзЦикла                   │ exit                           │
//│ 34 │ ВсеСобытия                     │ AllEvents                      │
//│ 35 │ ИсключитьПользовательские      │ ExcludeUserInputEvents         │
//│ 36 │ ИсключитьСокеты                │ ExcludeSocketNotifiers         │
//│ 37 │ ОжиданиеСобытий                │ WaitForMoreEvents              │
//│ 38 │ ОбработкаВсехСобытий           │ ProcessAllEvents               │
//│ 39 │ Действителен                   │ isValid                        │
//│ 40 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 41 │ РежимОтладки                   │ setDebug                       │
//│ 42 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 43 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 44 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtEventLoop (QtЦиклСобытий) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ЦиклСоб1_1 = Новый QtЦиклСобытий()
    ЦиклСоб1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    запущен = ЦиклСоб1_1.Запущен()
    запущенРус = ЦиклСоб1_1.Запущен()
    действителен = ЦиклСоб1_1.Действителен()
    действителенРус = ЦиклСоб1_1.Действителен()
    ВывестиСтрокуВКонсоль("    Запущен: " + запущен + "/" + запущенРус + ", Действителен: " + действителен + "/" + действителенРус + " (ожидается false, true)")
    
    // ===== 3. ПРОВЕРКА ВАЛИДНОСТИ =====
    валид = ЦиклСоб1_1.isValid()
    валидРус = ЦиклСоб1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валид + ", Действителен(): " + валидРус + " (ожидается true)")
    
    // ===== 4. ЗАПУСК И ОСТАНОВКА =====
    Попытка
        ЦиклСоб1_1.Остановить()
        ВывестиСтрокуВКонсоль("    Остановить() - OK")
        
        ЦиклСоб1_1.Выйти(0)
        ВывестиСтрокуВКонсоль("    Выйти(0) - OK")
        
        запущенПосле = ЦиклСоб1_1.Запущен()
        ВывестиСтрокуВКонсоль("    Запущен после остановки: " + запущенПосле + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    Остановка/выход: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ЗАПУСК С ФЛАГАМИ =====
    Попытка
        Если typeof ЦиклСоб1_1.ЗапуститьСФлагами === 'function' Тогда
            ВывестиСтрокуВКонсоль("    ЗапуститьСФлагами: ДОСТУПЕН")
        Иначе
            ВывестиСтрокуВКонсоль("    ЗапуститьСФлагами: НЕ ДОСТУПЕН")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    Запуск с флагами: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОБРАБОТКА СОБЫТИЙ (русские методы) =====
    Попытка
        ЦиклСоб1_1.ОбработатьСобытия()
        ВывестиСтрокуВКонсоль("    ОбработатьСобытия() - OK")
        
        ЦиклСоб1_1.ОбработатьВсеСобытия()
        ВывестиСтрокуВКонсоль("    ОбработатьВсеСобытия() - OK")
        
        ЦиклСоб1_1.ОбработатьОжидающиеСобытия()
        ВывестиСтрокуВКонсоль("    ОбработатьОжидающиеСобытия() - OK")
    Исключение
        ВывестиСтрокуВКонсоль("    Обработка событий (рус): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. ОБРАБОТКА СОБЫТИЙ (английские методы) =====
    Попытка
        ЦиклСоб1_1.processAllEvents()
        ВывестиСтрокуВКонсоль("    processAllEvents() - OK")
        
        ЦиклСоб1_1.processPendingEvents()
        ВывестиСтрокуВКонсоль("    processPendingEvents() - OK")
    Исключение
        ВывестиСтрокуВКонсоль("    Обработка событий (eng): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. КОНСТАНТЫ ФЛАГОВ =====
    Попытка
        всеСобытия = ЦиклСоб1_1.ВсеСобытия()
        исключитьПольз = ЦиклСоб1_1.ИсключитьПользовательские()
        исключитьСокеты = ЦиклСоб1_1.ИсключитьСокеты()
        ожидание = ЦиклСоб1_1.ОжиданиеСобытий()
        
        ВывестиСтрокуВКонсоль("    ВсеСобытия: " + всеСобытия)
        ВывестиСтрокуВКонсоль("    ИсключитьПользовательские: " + исключитьПольз)
        ВывестиСтрокуВКонсоль("    ИсключитьСокеты: " + исключитьСокеты)
        ВывестиСтрокуВКонсоль("    ОжиданиеСобытий: " + ожидание)
    Исключение
        ВывестиСтрокуВКонсоль("    Константы флагов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    Попытка
        реал = ЦиклСоб1_1.ПолучитьЦикл()
        реалРус = ЦиклСоб1_1.ПолучитьЦикл()
        ВывестиСтрокуВКонсоль("    ПолучитьЦикл(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН") + " / " + (реалРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("    Получение реального объекта: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. КОПИРОВАНИЕ =====
    Попытка
        цель10 = Новый QtЦиклСобытий()
