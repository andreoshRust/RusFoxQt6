//│ 19 │ УстановитьУказательНаКурсор    │ setCursorWrapper               │
//│ 20 │ ПолучитьУказательНаКурсор      │ getCursorWrapper               │
//│ 21 │ УстановитьПростойТекст         │ setPlainTextValue              │
//│ 22 │ ПолучитьПростойТекст           │ getPlainTextValue              │
//│ 23 │ УстановитьHtml                 │ setHtmlValue                   │
//│ 24 │ ПолучитьHtml                   │ getHtmlValue                   │
//│ 25 │ УстановитьMarkdown             │ setMarkdownValue               │
//│ 26 │ ПолучитьMarkdown               │ getMarkdownValue               │
//│ 27 │ Очистить                       │ clearValue                     │
//│ 28 │ Пустой                         │ isEmptyValue                   │
//│ 29 │ УстановитьШрифт                │ setFontValue                   │
//│ 30 │ ПолучитьШрифт                  │ getFontValue                   │
//│ 31 │ УстановитьСемействоШрифта      │ setFontFamilyValue             │
//│ 32 │ УстановитьРазмерШрифта         │ setFontSizeValue               │
//│ 33 │ УстановитьЖирность             │ setFontBoldValue               │
//│ 34 │ УстановитьКурсив               │ setFontItalicValue             │
//│ 35 │ УстановитьЦветТекста           │ setTextColorValue              │
//│ 36 │ УстановитьЦветФона             │ setBackgroundColorValue        │
//│ 37 │ УстановитьРазмерСтраницы       │ setPageSizeValue               │
//│ 38 │ ПолучитьРазмерСтраницы         │ getPageSizeValue               │
//│ 39 │ УстановитьРазмерСтраницыММ     │ setPageSizeMM                  │
//│ 40 │ УстановитьОтступДокумента      │ setDocumentMarginValue         │
//│ 41 │ ПолучитьОтступДокумента        │ getDocumentMarginValue         │
//│ 42 │ УстановитьШиринуОтступа        │ setIndentWidthValue            │
//│ 43 │ ПолучитьШиринуОтступа          │ getIndentWidthValue            │
//│ 44 │ ПолучитьРазмер                 │ getSizeValue                   │
//│ 45 │ ПолучитьШирину                 │ getWidthValue                  │
//│ 46 │ ПолучитьВысоту                 │ getHeightValue                 │
//│ 47 │ КоличествоСтрок                │ getLineCountValue              │
//│ 48 │ КоличествоСимволов             │ getCharacterCountValue         │
//│ 49 │ КоличествоБлоков               │ getBlockCountValue             │
//│ 50 │ ПолучитьКурсор                 │ getCursorValue                 │
//│ 51 │ УстановитьПозициюКурсора       │ setCursorPositionValue         │
//│ 52 │ ПозицияКурсора                 │ getCursorPositionValue         │
//│ 53 │ Найти                          │ findValue                      │
//│ 54 │ НайтиИВыделить                 │ findAndSelectValue             │
//│ 55 │ ЗаменитьВсе                    │ replaceAllValue                │
//│ 56 │ Печать                         │ printValue                     │
//│ 57 │ ПечатьВPdf                     │ printToPdfValue                │
//│ 58 │ ПечатьВPdfСРазмером            │ printToPdfWithSizeValue        │
//│ 59 │ ПолучитьДокумент               │ getDocument                    │
//│ 60 │ ПолучитьDoc                    │ getDocumentObject              │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtTextDocument (QtТекстовыйДокумент) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ТекстДок1_1 = Новый QtТекстовыйДокумент()
    ТекстДок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С ТЕКСТОМ =====
    ТекстДок1_2 = Новый QtТекстовыйДокумент("Привет мир!")
    ТекстДок1_2.РежимОтладки(Режим_Отладки)
    текст2 = ТекстДок1_2.ПолучитьПростойТекст()
    ВывестиСтрокуВКонсоль("    Текст из конструктора: '" + текст2 + "' (ожидается 'Привет мир!')")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ ТЕКСТА =====
    ТекстДок1_1.УстановитьПростойТекст("Тестовый текст")
    текст3 = ТекстДок1_1.ПолучитьПростойТекст()
    ВывестиСтрокуВКонсоль("    УстановитьПростойТекст('Тестовый текст') -> ПолучитьПростойТекст(): '" + текст3 + "' (ожидается 'Тестовый текст')")
    ТекстДок1_1.УстановитьПростойТекст("Новый текст")
    текст4 = ТекстДок1_1.ПолучитьПростойТекст()
    ВывестиСтрокуВКонсоль("    Повторная установка -> ПолучитьПростойТекст(): '" + текст4 + "' (ожидается 'Новый текст')")
    
    // ===== 4. HTML =====
    ТекстДок1_1.УстановитьHtml("<b>Жирный</b> и <i>курсивный</i> текст")
    текст5 = ТекстДок1_1.ПолучитьПростойТекст()
    ВывестиСтрокуВКонсоль("    HTML -> ПолучитьПростойТекст(): '" + текст5 + "' (содержит 'Жирный' и 'курсивный')")
    
    // ===== 5. ИНФОРМАЦИЯ =====
    пустой = ТекстДок1_1.Пустой()
    строк = ТекстДок1_1.КоличествоСтрок()
    символов = ТекстДок1_1.КоличествоСимволов()
    блоков = ТекстДок1_1.КоличествоБлоков()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пустой + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    КоличествоСтрок(): " + строк + ", КоличествоСимволов(): " + символов + ", КоличествоБлоков(): " + блоков)
    
    // ===== 6. ОЧИСТКА =====
    пустойДо = ТекстДок1_1.Пустой()
    ВывестиСтрокуВКонсоль("    До очистки Пустой(): " + пустойДо + " (ожидается false)")
    ТекстДок1_1.Очистить()
    пустойПосле = ТекстДок1_1.Пустой()
    ВывестиСтрокуВКонсоль("    После Очистить() Пустой(): " + пустойПосле + " (ожидается true)")
    
    // ===== 7. ЗАМЕНА ТЕКСТА =====
    ТекстДок1_1.УстановитьПростойТекст("Кот ловит мышь. Кот спит. Кот ест.")
    результат = ТекстДок1_1.ЗаменитьВсе("Кот", "Пёс")
    текст6 = ТекстДок1_1.ПолучитьПростойТекст()
    ВывестиСтрокуВКонсоль("    ЗаменитьВсе('Кот','Пёс') -> результат: '" + результат + "', текст: '" + текст6 + "' (содержит 'Пёс', не содержит 'Кот')")
    
    // ===== 8. ПОИСК =====
    ТекстДок1_1.УстановитьПростойТекст("Тестовый текст для поиска")
    // Используем английский метод
    найдено = ТекстДок1_1.findValue("поиска", 0, 0)
    ВывестиСтрокуВКонсоль("    findValue('поиска'): " + найдено + " (ожидается true)")
    // Русский метод
    найдено2 = ТекстДок1_1.Найти("текст", 0, 0)
    ВывестиСтрокуВКонсоль("    Найти('текст'): " + найдено2 + " (ожидается true)")
    
    // ===== 9. RUSFUNC =====
    Если typeof ТекстДок1_1.RusFunc === 'function' Тогда
        jsonStr = ТекстДок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtTextDocument (QtТекстовыйДокумент) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtТекстовыйКурсор()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьРеальныйКурсор         │ getRealCursor                  │
//│ 20 │ УстановитьПозицию              │ setPosition                    │
//│ 21 │ Позиция                        │ position                       │
//│ 22 │ Якорь                          │ anchor                         │
//│ 23 │ Переместить                    │ movePosition                   │
//│ 24 │ ПереместитьЛогическое          │ movePositionBool               │
//│ 25 │ ВставитьТекст                  │ insertText                     │
//│ 26 │ ВставитьHtml                   │ insertHtml                     │
//│ 27 │ ВставитьБлок                   │ insertBlock                    │
//│ 28 │ ВставитьИзображение            │ insertImage                    │
//│ 29 │ ВставитьТаблицу                │ insertTable                    │
//│ 30 │ Выделить                       │ select                         │
//│ 31 │ СнятьВыделение                 │ clearSelection                 │
//│ 32 │ ЕстьВыделение                  │ hasSelection                   │
//│ 33 │ ВыделенныйТекст                │ selectedText                   │
//│ 34 │ НачалоВыделения                │ selectionStart                 │
//│ 35 │ КонецВыделения                 │ selectionEnd                   │
//│ 36 │ УдалитьВыделенное              │ removeSelectedText             │
//│ 37 │ УдалитьСимвол                  │ deleteChar                     │
//│ 38 │ УдалитьПредыдущийСимвол        │ deletePreviousChar             │
//│ 39 │ УстановитьФорматСимволов       │ setCharFormat                  │
//│ 40 │ ОбъединитьФорматСимволов       │ mergeCharFormat                │
//│ 41 │ УстановитьФорматБлока          │ setBlockFormat                 │
//│ 42 │ ОбъединитьФорматБлока          │ mergeBlockFormat               │
//│ 43 │ ФорматСимволов                 │ charFormat                     │
//│ 44 │ ФорматБлока                    │ blockFormat                    │
//│ 45 │ Документ                       │ document                       │
//│ 46 │ Пустой                         │ isNull                         │
//│ 47 │ Блок                           │ block                          │
//│ 48 │ НомерБлока                     │ blockNumber                    │
//│ 49 │ ПолучитьКурсор                 │ getCursor                      │
//│ 50 │ ПолучитьCursor                 │ getCursorObject                │
//│ 51 │ БезПеремещения                 │ NoMove                         │
//│ 52 │ Начало                         │ Start                          │
//│ 53 │ Конец                          │ End                            │
//│ 54 │ Вверх                          │ Up                             │
//│ 55 │ Вниз                           │ Down                           │
//│ 56 │ Влево                          │ Left                           │
//│ 57 │ Вправо                         │ Right                          │
//│ 58 │ СловоВлево                     │ WordLeft                       │
//│ 59 │ СловоВправо                    │ WordRight                      │
//│ 60 │ СледующееСлово                 │ NextWord                       │
//│ 61 │ ПредыдущееСлово                │ PreviousWord                   │
//│ 62 │ НачалоСлова                    │ StartOfWord                    │
//│ 63 │ КонецСлова                     │ EndOfWord                      │
//│ 64 │ НачалоСтроки                   │ StartOfLine                    │
//│ 65 │ КонецСтроки                    │ EndOfLine                      │
//│ 66 │ НачалоБлока                    │ StartOfBlock                   │
//│ 67 │ КонецБлока                     │ EndOfBlock                     │
//│ 68 │ ПереместитьЯкорь               │ MoveAnchor                     │
//│ 69 │ СохранитьЯкорь                 │ KeepAnchor                     │
//│ 70 │ Документ                       │ Document                       │
//│ 71 │ БлокПодКурсором                │ BlockUnderCursor               │
//│ 72 │ СтрокаПодКурсором              │ LineUnderCursor                │
//│ 73 │ СловоПодКурсором               │ WordUnderCursor                │
//│ 74 │ ВыбратьДокумент                │ SelectDocument                 │
//│ 75 │ ВыбратьБлокПодКурсором         │ SelectBlockUnderCursor         │
//│ 76 │ ВыбратьСтрокуПодКурсором       │ SelectLineUnderCursor          │
//│ 77 │ ВыбратьСловоПодКурсором        │ SelectWordUnderCursor          │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtTextCursor (QtТекстовыйКурсор) - КОМПАКТНАЯ ВЕРСИЯ ========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ТекстКурс1_1 = Новый QtТекстовыйКурсор()
    ТекстКурс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. КОНСТАНТЫ ОПЕРАЦИЙ ПЕРЕМЕЩЕНИЯ =====
    начало = ТекстКурс1_1.Start()
    конец = ТекстКурс1_1.End()
    вверх = ТекстКурс1_1.Up()
    вниз = ТекстКурс1_1.Down()
    влево = ТекстКурс1_1.Left()
    вправо = ТекстКурс1_1.Right()
    ВывестиСтрокуВКонсоль("    Start(): " + начало + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    End(): " + конец + " (ожидается 11)")
    ВывестиСтрокуВКонсоль("    Up(): " + вверх + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    Down(): " + вниз + " (ожидается 12)")
    ВывестиСтрокуВКонсоль("    Left(): " + влево + " (ожидается 9)")
    ВывестиСтрокуВКонсоль("    Right(): " + вправо + " (ожидается 19)")
    
    // ===== 3. РУССКИЕ КОНСТАНТЫ ОПЕРАЦИЙ ПЕРЕМЕЩЕНИЯ =====
    русНачало = ТекстКурс1_1.Начало()
    русКонец = ТекстКурс1_1.Конец()
    русВверх = ТекстКурс1_1.Вверх()
    русВниз = ТекстКурс1_1.Вниз()
    русВлево = ТекстКурс1_1.Влево()
    русВправо = ТекстКурс1_1.Вправо()
    ВывестиСтрокуВКонсоль("    Начало(): " + русНачало + ", Конец(): " + русКонец + ", Вверх(): " + русВверх + ", Вниз(): " + русВниз + ", Влево(): " + русВлево + ", Вправо(): " + русВправо)
    
    // ===== 4. КОНСТАНТЫ РЕЖИМОВ ПЕРЕМЕЩЕНИЯ =====
    якорь = ТекстКурс1_1.MoveAnchor()
    сохранить = ТекстКурс1_1.KeepAnchor()
    ВывестиСтрокуВКонсоль("    MoveAnchor(): " + якорь + " (ожидается 0), KeepAnchor(): " + сохранить + " (ожидается 1)")
    
    // ===== 5. КОНСТАНТЫ ТИПОВ ВЫДЕЛЕНИЯ =====
    докВыд = ТекстКурс1_1.SelectDocument()
    блокВыд = ТекстКурс1_1.SelectBlockUnderCursor()
    строкаВыд = ТекстКурс1_1.SelectLineUnderCursor()
    словоВыд = ТекстКурс1_1.SelectWordUnderCursor()
    ВывестиСтрокуВКонсоль("    SelectDocument(): " + докВыд + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    SelectBlockUnderCursor(): " + блокВыд + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    SelectLineUnderCursor(): " + строкаВыд + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    SelectWordUnderCursor(): " + словоВыд + " (ожидается 0)")
    
    // ===== 6. RUSFUNC =====
    Если typeof ТекстКурс1_1.RusFunc === 'function' Тогда
        jsonStr = ТекстКурс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
  
    ВывестиСтрокуВКонсоль("==== Тест QtTextCursor (QtТекстовыйКурсор) завершён.============================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtТекстовыйПоток()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ОткрытьУстройство              │ openDevice                     │
//│ 20 │ ЗакрытьУстройство              │ closeDevice                    │
//│ 21 │ УстройствоОткрыто              │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                │ readData                       │
//│ 23 │ ПрочитатьВсеДанные             │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//│ 49 │ ПрочитатьВсе                   │ readAllValue                   │
//│ 50 │ ПрочитатьСтроку                │ readLineValue                  │
//│ 51 │ Прочитать                      │ readValue                      │
//│ 52 │ ПрочитатьЧисло                 │ readIntValue                   │
//│ 53 │ ПрочитатьДробь                 │ readDoubleValue                │
//│ 54 │ ПрочитатьЛогику                │ readBoolValue                  │
//│ 55 │ ВКонце                         │ atEndValue                     │
//│ 56 │ Записать                       │ writeValue                     │
//│ 57 │ ЗаписатьСтроку                 │ writeLineValue                 │
//│ 58 │ ЗаписатьЧисло                  │ writeIntValue                  │
//│ 59 │ ЗаписатьДробь                  │ writeDoubleValue               │
//│ 60 │ ЗаписатьЛогику                 │ writeBoolValue                 │
//│ 61 │ СброситьБуфер                  │ flushValue                     │
//│ 62 │ УстановитьОснование            │ setIntegerBaseValue            │
//│ 63 │ ПолучитьОснование              │ getIntegerBaseValue            │
//│ 64 │ УстановитьФлагиЧисел           │ setNumberFlagsValue            │
//│ 65 │ ПолучитьФлагиЧисел             │ getNumberFlagsValue            │
//│ 66 │ УстановитьНотацию              │ setRealNumberNotationValue     │
//│ 67 │ ПолучитьНотацию                │ getRealNumberNotationValue     │
//│ 68 │ УстановитьТочность             │ setRealNumberPrecisionValue    │
//│ 69 │ ПолучитьТочность               │ getRealNumberPrecisionValue    │
//│ 70 │ УстановитьШиринуПоля           │ setFieldWidthValue             │
//│ 71 │ ПолучитьШиринуПоля             │ getFieldWidthValue             │
//│ 72 │ УстановитьВыравнивание         │ setFieldAlignmentValue         │
//│ 73 │ ПолучитьВыравнивание           │ getFieldAlignmentValue         │
//│ 74 │ УстановитьЗаполнитель          │ setPadCharValue                │
//│ 75 │ ПолучитьЗаполнитель            │ getPadCharValue                │
//│ 76 │ СброситьСтатус                 │ resetStatus                    │
//│ 77 │ ПолучитьСтатус                 │ status                         │
//│ 78 │ ПолучитьУстройство             │ getDeviceValue                 │
//│ 79 │ УстановитьУстройство           │ setDeviceValue                 │
//│ 80 │ ПолучитьСтроку                 │ getStringValue                 │
//│ 81 │ ПолучитьБуфер                  │ getBufferValue                 │
//│ 82 │ Позиция                        │ pos                            │
//│ 83 │ ПерейтиВ                       │ seek                           │
//│ 84 │ Сбросить                       │ resetDevice                    │
//│ 85 │ Размер                         │ size                           │
//│ 86 │ ПоказатьОснование              │ ShowBase                       │
//│ 87 │ ПринудительныйЗнак             │ ForceSign                      │
//│ 88 │ ПринудительнаяТочка            │ ForcePoint                     │
//│ 89 │ ВерхнийРегистрОснования        │ UppercaseBase                  │
//│ 90 │ ВерхнийРегистрЦифр             │ UppercaseDigits                │
//│ 91 │ Фиксированная                  │ FixedNotation                  │
//│ 92 │ Научная                        │ ScientificNotation             │
//│ 93 │ Умная                          │ SmartNotation                  │
//│ 94 │ ВыравниваниеВлево              │ AlignLeft                      │
//│ 95 │ ВыравниваниеВправо             │ AlignRight                     │
//│ 96 │ ВыравниваниеПоЦентру           │ AlignCenter                    │
//│ 97 │ Двоичная                       │ BaseBin                        │
//│ 98 │ Восьмеричная                   │ BaseOct                        │
//│ 99 │ Десятичная                     │ BaseDec                        │
//│ 100 │ Шестнадцатеричная              │ BaseHex                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtTextStream (QtТекстовыйПоток) - КОМПАКТНАЯ ВЕРСИЯ ==========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ТекстПоток1_1 = Новый QtТекстовыйПоток()
    ТекстПоток1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. МЕТОДЫ УПРАВЛЕНИЯ УСТРОЙСТВОМ =====
    открыт = ТекстПоток1_1.УстройствоОткрыто()
    уст = ТекстПоток1_1.ПолучитьУстройство()
    поз = ТекстПоток1_1.Позиция()
    разм = ТекстПоток1_1.Размер()
    вконце = ТекстПоток1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    УстройствоОткрыто(): " + открыт + ", ПолучитьУстройство(): " + (уст != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Позиция(): " + поз + ", Размер(): " + разм + ", ВКонце(): " + вконце)
    
    // ===== 3. КОНСТАНТЫ РЕЖИМОВ =====
    текст = ТекстПоток1_1.Текстовый()
    толькоЧтение = ТекстПоток1_1.ТолькоЧтение()
    толькоЗапись = ТекстПоток1_1.ТолькоЗапись()
    чтениеЗапись = ТекстПоток1_1.ЧтениеЗапись()
    добавление = ТекстПоток1_1.Добавление()
    обрезать = ТекстПоток1_1.Обрезать()
    безБуферизации = ТекстПоток1_1.БезБуферизации()
    ВывестиСтрокуВКонсоль("    Текстовый: " + текст + ", ТолькоЧтение: " + толькоЧтение + ", ТолькоЗапись: " + толькоЗапись)
    ВывестиСтрокуВКонсоль("    ЧтениеЗапись: " + чтениеЗапись + ", Добавление: " + добавление + ", Обрезать: " + обрезать + ", БезБуферизации: " + безБуферизации)
    
    // ===== 4. МЕТОДЫ ЗАПИСИ/ЧТЕНИЯ =====
    ТекстПоток1_2 = Новый QtТекстовыйПоток()
    ТекстПоток1_2.РежимОтладки(Режим_Отладки)
    методыПроверки = ["writeData", "writeLineData", "putCharData", "readAllData", "readData", "readLineData", "getCharData", "bytesToWriteData", "bytesAvailableData"]
    всеСуществуют = ИСТИНА
    Для i = 0 По методыПроверки.length - 1 Цикл
        Если typeof ТекстПоток1_2[методыПроверки[i]] !== 'function' Тогда
            всеСуществуют = ЛОЖЬ
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("    Методы записи/чтения: " + (всеСуществуют ? "ВСЕ ДОСТУПНЫ" : "НЕ ВСЕ ДОСТУПНЫ"))
    
    // ===== 5. МЕТОДЫ ПОЗИЦИОНИРОВАНИЯ =====
    ТекстПоток1_2.writeData("Test data for positioning")
    поз1 = ТекстПоток1_2.Позиция()
    ВывестиСтрокуВКонсоль("    Позиция() после записи: " + поз1)
    ТекстПоток1_2.ПерейтиВ(5)
    поз2 = ТекстПоток1_2.Позиция()
    ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + поз2)
    ТекстПоток1_2.СброситьУстройство()
    поз3 = ТекстПоток1_2.Позиция()
    ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + поз3)
    
    // ===== 6. МЕТОДЫ СТАТУСА =====
    ошибка = ТекстПоток1_1.ТекстОшибки()
    ВывестиСтрокуВКонсоль("    ТекстОшибки(): '" + ошибка + "'")
    ТекстПоток1_1.УстановитьТекстОшибки("Test error")
    ошибка2 = ТекстПоток1_1.ТекстОшибки()
    ВывестиСтрокуВКонсоль("    УстановитьТекстОшибки('Test error') -> ТекстОшибки(): '" + ошибка2 + "'")
    валидный = ТекстПоток1_1.Валидный()
    ВывестиСтрокуВКонсоль("    Валидный(): " + валидный)
    
    // ===== 7. ОТКРЫТИЕ/ЗАКРЫТИЕ =====
    открыт1 = ТекстПоток1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    УстройствоОткрыто() до: " + открыт1)
    ТекстПоток1_1.ЗакрытьУстройство()
    открыт2 = ТекстПоток1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ЗакрытьУстройство() -> УстройствоОткрыто(): " + открыт2)
    
    // ===== 8. RUSFUNC =====
    Если typeof ТекстПоток1_1.RusFunc === 'function' Тогда
        jsonStr = ТекстПоток1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtTextStream (QtТекстовыйПоток) завершён.=============================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtАдрес()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Установить                     │ setUrlValue                    │
//│ 20 │ Получить                       │ getUrlValue                    │
//│ 21 │ ВСтроку                        │ toStringValue                  │
//│ 22 │ ВОтображаемуюСтроку            │ toDisplayStringValue           │
//│ 23 │ ВЗакодированный                │ toEncodedValue                 │
//│ 24 │ Схема                          │ getScheme                      │
//│ 25 │ УстановитьСхему                │ setSchemeValue                 │
//│ 26 │ Хост                           │ getHost                        │
//│ 27 │ УстановитьХост                 │ setHostValue                   │
//│ 28 │ Порт                           │ getPort                        │
//│ 29 │ УстановитьПорт                 │ setPortValue                   │
//│ 30 │ Путь                           │ getPath                        │
//│ 31 │ УстановитьПуть                 │ setPathValue                   │
//│ 32 │ ИмяПользователя                │ getUserName                    │
//│ 33 │ УстановитьИмяПользователя      │ setUserNameValue               │
//│ 34 │ Пароль                         │ getPassword                    │
//│ 35 │ УстановитьПароль               │ setPasswordValue               │
//│ 36 │ Фрагмент                       │ getFragment                    │
//│ 37 │ УстановитьФрагмент             │ setFragmentValue               │
//│ 38 │ Запрос                         │ getQuery                       │
//│ 39 │ УстановитьЗапрос               │ setQueryValue                  │
//│ 40 │ ПараметрыЗапроса               │ getQueryItemsValue             │
//│ 41 │ УстановитьПараметрыЗапроса     │ setQueryItemsValue             │
//│ 42 │ Действителен                   │ isValidValue                   │
//│ 43 │ Пустой                         │ isEmptyValue                   │
//│ 44 │ ЛокальныйФайл                  │ isLocalFileValue               │
//│ 45 │ Относительный                  │ isRelativeValue                │
//│ 46 │ Родитель                       │ isParentOfValue                │
//│ 47 │ ЕстьФрагмент                   │ hasFragmentValue               │
//│ 48 │ ЕстьЗапрос                     │ hasQueryValue                  │
//│ 49 │ ВЛокальныйФайл                 │ toLocalFileValue               │
//│ 50 │ Разрешить                      │ resolvedValue                  │
//│ 51 │ РазрешитьСАдресом              │ resolvedValueWithUrl           │
//│ 52 │ Скорректировать                │ adjustedValue                  │
//│ 53 │ ИзЛокальногоФайла              │ fromLocalFileValue             │
//│ 54 │ ИзЛокальногоФайлаОбъект        │ fromLocalFile                  │
//│ 55 │ ПолучитьАдрес                  │ getUrl                         │
//│ 56 │ Никаких                        │ None                           │
//│ 57 │ УдалитьСхему                   │ RemoveScheme                   │
//│ 58 │ УдалитьПароль                  │ RemovePassword                 │
//│ 59 │ УдалитьИнфо                    │ RemoveUserInfo                 │
//│ 60 │ УдалитьПорт                    │ RemovePort                     │
//│ 61 │ УдалитьЗапрос                  │ RemoveQuery                    │
//│ 62 │ УдалитьФрагмент                │ RemoveFragment                 │
//│ 63 │ ПредпочитатьЛокальный          │ PreferLocalFile                │
//│ 64 │ УдалитьСлеш                    │ StripTrailingSlash             │
//│ 65 │ Нормализовать                  │ NormalizePathSegments          │
//│ 66 │ СтрогийРежим                   │ StrictMode                     │
//│ 67 │ Декодированный                 │ DecodedMode                    │
//│ 68 │ ЛояльныйРежим                  │ TolerantMode                   │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtUrl (QtАдрес) - КОМПАКТНАЯ ВЕРСИЯ ===========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Адрес1_1 = Новый QtАдрес()
    Адрес1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ АДРЕС =====
    пусто = Адрес1_1.Пустой()
    действителен = Адрес1_1.Действителен()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пусто + " (ожидается true), Действителен(): " + действителен + " (ожидается false)")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ АДРЕСА =====
    Адрес1_2 = Новый QtАдрес()
    Адрес1_2.РежимОтладки(Режим_Отладки)
    Адрес1_2.Установить("https://example.com:8080/path/to/page?param1=value1&param2=value2#fragment")
    полученный = Адрес1_2.Получить()
    ВывестиСтрокуВКонсоль("    Установить() -> Получить(): " + полученный)
    
    // ===== 4. КОМПОНЕНТЫ АДРЕСА =====
    Адрес1_3 = Новый QtАдрес()
    Адрес1_3.РежимОтладки(Режим_Отладки)
    Адрес1_3.Установить("https://user:pass@example.com:8080/path/to/page?param1=value1&param2=value2#fragment")
    схема = Адрес1_3.Схема()
    хост = Адрес1_3.Хост()
    порт = Адрес1_3.Порт()
    путь = Адрес1_3.Путь()
    имя = Адрес1_3.ИмяПользователя()
    пароль = Адрес1_3.Пароль()
    фрагмент = Адрес1_3.Фрагмент()
    запрос = Адрес1_3.Запрос()
    ВывестиСтрокуВКонсоль("    Схема(): " + схема + " (ожидается https)")
    ВывестиСтрокуВКонсоль("    Хост(): " + хост + " (ожидается example.com)")
    ВывестиСтрокуВКонсоль("    Порт(): " + порт + " (ожидается 8080)")
    ВывестиСтрокуВКонсоль("    Путь(): " + путь + " (ожидается /path/to/page)")
    ВывестиСтрокуВКонсоль("    ИмяПользователя(): " + имя + " (ожидается user)")
    ВывестиСтрокуВКонсоль("    Пароль(): " + пароль + " (ожидается pass)")
    ВывестиСтрокуВКонсоль("    Фрагмент(): " + фрагмент + " (ожидается fragment)")
    ВывестиСтрокуВКонсоль("    Запрос(): " + запрос + " (ожидается param1=value1&param2=value2)")
    
    // ===== 5. УСТАНОВКА КОМПОНЕНТОВ =====
    Адрес1_4 = Новый QtАдрес()
    Адрес1_4.РежимОтладки(Режим_Отладки)
    Адрес1_4.УстановитьСхему("http")
    Адрес1_4.УстановитьХост("test.com")
    Адрес1_4.УстановитьПорт(3000)
    Адрес1_4.УстановитьПуть("/api/data")
    Адрес1_4.УстановитьИмяПользователя("admin")
    Адрес1_4.УстановитьПароль("12345")
    Адрес1_4.УстановитьФрагмент("section")
    Адрес1_4.УстановитьЗапрос("key=value")
    стр4 = Адрес1_4.Получить()
    ВывестиСтрокуВКонсоль("    Установка компонентов -> Получить(): " + стр4)
    
    // ===== 6. ПАРАМЕТРЫ ЗАПРОСА =====
    Адрес1_5 = Новый QtАдрес()
    Адрес1_5.РежимОтладки(Режим_Отладки)
    параметры = {}
    параметры.name = "Иван"
    параметры.age = 30
    параметры.city = "Москва"
    Адрес1_5.УстановитьПараметрыЗапроса(параметры)
    полученные = Адрес1_5.ПараметрыЗапроса()
    ВывестиСтрокуВКонсоль("    УстановитьПараметрыЗапроса({name:'Иван', age:30, city:'Москва'})")
    ВывестиСтрокуВКонсоль("    ПараметрыЗапроса(): name=" + полученные.name + ", age=" + полученные.age + ", city=" + полученные.city)
    
    // ===== 7. ПРЕОБРАЗОВАНИЯ =====
    Адрес1_6 = Новый QtАдрес()
    Адрес1_6.РежимОтладки(Режим_Отладки)
    Адрес1_6.Установить("https://example.com/path/to/page")
    стр6_1 = Адрес1_6.ВСтроку()
    стр6_2 = Адрес1_6.ВОтображаемуюСтроку()
    стр6_3 = Адрес1_6.ВЗакодированный()
    ВывестиСтрокуВКонсоль("    ВСтроку(): " + стр6_1)
    ВывестиСтрокуВКонсоль("    ВОтображаемуюСтроку(): " + стр6_2)
    ВывестиСтрокуВКонсоль("    ВЗакодированный(): " + стр6_3)
    
    // ===== 8. РАЗРЕШЕНИЕ ОТНОСИТЕЛЬНОГО АДРЕСА =====
    Адрес1_7 = Новый QtАдрес()
    Адрес1_7.РежимОтладки(Режим_Отладки)
    Адрес1_7.Установить("https://example.com/path/")
    разрешенный = Адрес1_7.Разрешить("sub/page.html")
    стр8 = разрешенный.toStringValue()
    ВывестиСтрокуВКонсоль("    Разрешить('sub/page.html'): " + стр8 + " (ожидается https://example.com/path/sub/page.html)")
    
    // ===== 9. КОРРЕКТИРОВКА АДРЕСА =====
    Адрес1_8 = Новый QtАдрес()
    Адрес1_8.РежимОтладки(Режим_Отладки)
    Адрес1_8.Установить("https://user:pass@example.com:8080/path/page?query=value#fragment")
    опции = Адрес1_8.УдалитьПорт()
    скорректированный = Адрес1_8.Скорректировать(опции)
    стр9 = скорректированный.toStringValue()
    ВывестиСтрокуВКонсоль("    УдалитьПорт() -> Скорректировать(): " + стр9 + " (порт удален)")
    
    // ===== 10. ИЗ ЛОКАЛЬНОГО ФАЙЛА =====
    Адрес1_9 = Новый QtАдрес()
    Адрес1_9.РежимОтладки(Режим_Отладки)
    локальный = Адрес1_9.ИзЛокальногоФайла("C:/Users/Test/file.txt")
    ВывестиСтрокуВКонсоль("    ИзЛокальногоФайла('C:/Users/Test/file.txt'): " + локальный + " (ожидается file:///C:/Users/Test/file.txt)")
    
    // ===== 11. КОНСТАНТЫ =====
    none = Адрес1_1.Никаких()
    remScheme = Адрес1_1.УдалитьСхему()
    remPort = Адрес1_1.УдалитьПорт()
    remQuery = Адрес1_1.УдалитьЗапрос()
    remFrag = Адрес1_1.УдалитьФрагмент()
    ВывестиСтрокуВКонсоль("    Никаких(): " + none + ", УдалитьСхему(): " + remScheme + ", УдалитьПорт(): " + remPort + ", УдалитьЗапрос(): " + remQuery + ", УдалитьФрагмент(): " + remFrag)
    
    // ===== 12. RUSFUNC =====
    Если typeof Адрес1_1.RusFunc === 'function' Тогда
        jsonStr = Адрес1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
   ВывестиСтрокуВКонсоль("==== Тест QtUrl (QtАдрес) завершён.=============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВебСокет()
//
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Открыть                        │ openUrl                        │
//│ 20 │ Закрыть                        │ closeSocket                    │
//│ 21 │ Прервать                       │ abortSocket                    │
//│ 22 │ Подключено                     │ isConnected                    │
//│ 23 │ Действителен                   │ isValid                        │
//│ 24 │ Состояние                      │ getState                       │
//│ 25 │ СостояниеСтрокой               │ getStateString                 │
//│ 26 │ ОтправитьТекст                 │ sendText                       │
//│ 27 │ ОтправитьДанные                │ sendBinary                     │
//│ 28 │ ОтправитьПинг                  │ sendPing                       │
//│ 29 │ ОтправитьПонг                  │ sendPong                       │
//│ 30 │ ИмяУдаленного                  │ getPeerName                    │
//│ 31 │ ПортУдаленного                 │ getPeerPort                    │
//│ 32 │ ЛокальныйАдрес                 │ getLocalAddress                │
//│ 33 │ ЛокальныйПорт                  │ getLocalPort                   │
//│ 34 │ СтрокаОшибки                   │ getErrorString                 │
//│ 35 │ КодОшибки                      │ getError                       │
//│ 36 │ УстановитьРазмерБуфераЧтения   │ setReadBufferSize              │
//│ 37 │ РазмерБуфераЧтения             │ readBufferSize                 │
//│ 38 │ ПриПодключении                 │ onConnected                    │
//│ 39 │ ПриОтключении                  │ onDisconnected                 │
//│ 40 │ ПриПолученииТекста             │ onTextMessageReceived          │
//│ 41 │ ПриПолученииДанных             │ onBinaryMessageReceived        │
//│ 42 │ ПриОшибке                      │ onError                        │
//│ 43 │ ПриИзмененииСостояния          │ onStateChanged                 │
//│ 44 │ ПриОтправкеДанных              │ onBytesWritten                 │
//│ 45 │ ПолучитьWebСокет               │ getRealWebSocket               │
//│ 46 │ НеПодключено                   │ UnconnectedState               │
//│ 47 │ ПоискХоста                     │ HostLookupState                │
//│ 48 │ Подключается                   │ ConnectingState                │
//│ 49 │ Подключено                     │ ConnectedState                 │
//│ 50 │ Привязан                       │ BoundState                     │
//│ 51 │ Закрывается                    │ ClosingState                   │
//│ 52 │ Прослушивание                  │ ListeningState                 │
//│ 53 │ КодНормально                   │ CloseCodeNormal                │
//│ 54 │ КодУход                        │ CloseCodeGoingAway             │
//│ 55 │ КодОшибкаПротокола             │ CloseCodeProtocolError         │
//│ 56 │ КодПолитикаНарушена            │ CloseCodePolicyViolated        │
//│ 57 │ КодTLSОшибкаРукопожатия        │ CloseCodeTlsHandshakeFailed    │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtWebSocket (QtВебСокет) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ВебСок1_1 = Новый QtWebSocket()
    ВебСок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = ВебСок1_1.Состояние()
    состояниеСтр = ВебСок1_1.СостояниеСтрокой()
    подключено = ВебСок1_1.isConnected()
    действителен = ВебСок1_1.Действителен()
    неПодкл = ВебСок1_1.НеПодключено()
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + "), НеПодключено: " + неПодкл + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    isConnected(): " + подключено + " (ожидается false), Действителен(): " + действителен + " (ожидается false)")
    
    // ===== 3. МЕТОДЫ УПРАВЛЕНИЯ =====
    ВывестиСтрокуВКонсоль("    Открыть(): " + (typeof ВебСок1_1.Открыть === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Закрыть(): " + (typeof ВебСок1_1.Закрыть === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Прервать(): " + (typeof ВебСок1_1.Прервать === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. МЕТОДЫ ОТПРАВКИ =====
    ВывестиСтрокуВКонсоль("    ОтправитьТекст(): " + (typeof ВебСок1_1.ОтправитьТекст === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьДанные(): " + (typeof ВебСок1_1.ОтправитьДанные === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьПинг(): " + (typeof ВебСок1_1.ОтправитьПинг === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ОтправитьПонг(): " + (typeof ВебСок1_1.ОтправитьПонг === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    
    // ===== 5. ИНФОРМАЦИЯ ОБ АДРЕСЕ =====
    локАдрес = ВебСок1_1.ЛокальныйАдрес()
    локПорт = ВебСок1_1.ЛокальныйПорт()
    имяУдал = ВебСок1_1.ИмяУдаленного()
    портУдал = ВебСок1_1.ПортУдаленного()
    стрОшибки = ВебСок1_1.СтрокаОшибки()
    ВывестиСтрокуВКонсоль("    ЛокальныйАдрес(): " + локАдрес + ", ЛокальныйПорт(): " + локПорт)
    ВывестиСтрокуВКонсоль("    ИмяУдаленного(): " + имяУдал + ", ПортУдаленного(): " + портУдал)
    ВывестиСтрокуВКонсоль("    СтрокаОшибки(): " + стрОшибки)
    
    // ===== 6. КОНСТАНТЫ СОСТОЯНИЙ =====
    поиск = ВебСок1_1.ПоискХоста()
    подкл = ВебСок1_1.Подключается()
    подключ = ВебСок1_1.Подключено()
    прив = ВебСок1_1.Привязан()
    прослуш = ВебСок1_1.Прослушивание()
    закр = ВебСок1_1.Закрывается()
    ВывестиСтрокуВКонсоль("    ПоискХоста: " + поиск + " (ожидается 1), Подключается: " + подкл + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    Подключено: " + подключ + " (ожидается 3), Привязан: " + прив + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    Прослушивание: " + прослуш + " (ожидается 5), Закрывается: " + закр + " (ожидается 6)")
    
    // ===== 7. КОНСТАНТЫ КОДОВ ЗАКРЫТИЯ =====
    кодНорм = ВебСок1_1.КодНормально()
    кодУход = ВебСок1_1.КодУход()
    кодПротокол = ВебСок1_1.КодОшибкаПротокола()
    кодПолитика = ВебСок1_1.КодПолитикаНарушена()
    кодTLS = ВебСок1_1.КодTLSОшибкаРукопожатия()
    ВывестиСтрокуВКонсоль("    КодНормально: " + кодНорм + " (ожидается 1000)")
    ВывестиСтрокуВКонсоль("    КодУход: " + кодУход + " (ожидается 1001)")
    ВывестиСтрокуВКонсоль("    КодОшибкаПротокола: " + кодПротокол + " (ожидается 1002)")
    ВывестиСтрокуВКонсоль("    КодПолитикаНарушена: " + кодПолитика + " (ожидается 1008)")
    ВывестиСтрокуВКонсоль("    КодTLSОшибкаРукопожатия: " + кодTLS + " (ожидается 1015)")
    
    // ===== 8. ЗАКРЫТИЕ С КОДОМ =====
    Попытка
        ВебСок1_1.Закрыть(1000, "Нормальное закрытие")
        состояниеПосле = ВебСок1_1.Состояние()
        ВывестиСтрокуВКонсоль("    Закрыть(1000) -> Состояние: " + состояниеПосле + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Закрыть(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПРОВЕРКА ДЕЙСТВИТЕЛЕН =====
    действителен2 = ВебСок1_1.Действителен()
    ВебСок1_2 = Новый QtWebSocket()
    действителен3 = ВебСок1_2.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен (текущий): " + действителен2 + ", Действителен (новый): " + действителен3 + " (ожидается false)")
    
    // ===== 10. КОЛБЭКИ =====
    Проверка1 = typeof ВебСок1_1.ПриПодключении === 'function' && typeof ВебСок1_1.ПриОтключении === 'function' && typeof ВебСок1_1.ПриПолученииТекста === 'function'
    Проверка2 = typeof ВебСок1_1.ПриПолученииДанных === 'function' && typeof ВебСок1_1.ПриОшибке === 'function' && typeof ВебСок1_1.ПриИзмененииСостояния === 'function'
    Проверка3 = typeof ВебСок1_1.ПриОтправкеДанных === 'function'
    ВывестиСтрокуВКонсоль("    Колбэки: " + (Проверка1 && Проверка2 && Проверка3 ? "ВСЕ ДОСТУПНЫ" : "НЕ ВСЕ ДОСТУПНЫ"))
    
    // ===== 11. НАСТРОЙКА БУФЕРА ЧТЕНИЯ =====
    ВебСок1_1.УстановитьРазмерБуфераЧтения(8192)
    размер = ВебСок1_1.РазмерБуфераЧтения()
    ВывестиСтрокуВКонсоль("    УстановитьРазмерБуфераЧтения(8192) -> РазмерБуфераЧтения(): " + размер + " (ожидается 8192)")
    
    // ===== 12. RUSFUNC =====
    Если typeof ВебСок1_1.RusFunc === 'function' Тогда
        jsonStr = ВебСок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtWebSocket (QtВебСокет) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПроцесс()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ЗапуститьПроцесс               │ start                          │
//│ 20 │ ЗапуститьОтделенный            │ startDetached                  │
//│ 21 │ ЗавершитьПроцесс               │ terminate                      │
//│ 22 │ УбитьПроцесс                   │ kill                           │
//│ 23 │ ЖдатьЗапуска                   │ waitForStarted                 │
//│ 24 │ ЖдатьЗавершения                │ waitForFinished                │
//│ 25 │ ЖдатьГотовности                │ waitForReadyRead               │
//│ 26 │ ПрочитатьВывод                 │ readAllStandardOutput          │
//│ 27 │ ПрочитатьОшибки                │ readAllStandardError           │
//│ 28 │ ПрочитатьТекстВывода           │ readAllStandardOutputText      │
//│ 29 │ ПрочитатьТекстОшибок           │ readAllStandardErrorText       │
//│ 30 │ ЗаписатьТекст                  │ writeText                      │
//│ 31 │ ЗаписатьСтроку                 │ writeLineText                  │
//│ 32 │ ЗакрытьКаналЗаписи             │ closeWriteChannel              │
//│ 33 │ ПолучитьСостояние              │ state                          │
//│ 34 │ ПолучитьИдПроцесса             │ processId                      │
//│ 35 │ ПолучитьКодВыхода              │ exitCode                       │
//│ 36 │ ПолучитьСтатусВыхода           │ exitStatus                     │
//│ 37 │ ПолучитьОшибку                 │ error                          │
//│ 38 │ ПолучитьТекстОшибки            │ errorString                    │
//│ 39 │ УстановитьПрограмму            │ setProgram                     │
//│ 40 │ ПолучитьПрограмму              │ program                        │
//│ 41 │ УстановитьАргументы            │ setArguments                   │
//│ 42 │ ПолучитьАргументы              │ arguments                      │
//│ 43 │ УстановитьРабочийКаталог       │ setWorkingDirectory            │
//│ 44 │ ПолучитьРабочийКаталог         │ workingDirectory               │
//│ 45 │ УстановитьРежимКаналов         │ setProcessChannelMode          │
//│ 46 │ ПолучитьРежимКаналов           │ processChannelMode             │
//│ 47 │ Выполняется                    │ isRunning                      │
//│ 48 │ Запущен                        │ isStarted                      │
//│ 49 │ Завершен                       │ isFinished                     │
//│ 50 │ НормальныйВыход                │ isNormalExit                   │
//│ 51 │ МожноЧитатьСтроку              │ canReadLine                    │
//│ 52 │ ПолучитьПроцесс                │ getRealProcess                 │
//│ 53 │ РаздельныеКаналы               │ SeparateChannels               │
//│ 54 │ ОбъединенныеКаналы             │ MergedChannels                 │
//│ 55 │ ПрямыеКаналы                   │ ForwardedChannels              │
//│ 56 │ НеЗапущен                      │ NotRunning                     │
//│ 57 │ Запускается                    │ Starting                       │
//│ 58 │ Выполняется                    │ Running                        │
//│ 59 │ ОшибкаЗапуска                  │ FailedToStart                  │
//│ 60 │ ОшибкаКанала                   │ WriteError                     │
//│ 61 │ ОшибкаЧтения                   │ ReadError                      │
//│ 62 │ ОшибкаТаймаута                 │ Timedout                       │
//│ 63 │ НеизвестнаяОшибка              │ UnknownError                   │
//│ 64 │ НормальныйВыход                │ NormalExit                     │
//│ 65 │ АварийныйВыход                 │ CrashExit                      │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtProcess (QtПроцесс) - КОМПАКТНАЯ ВЕРСИЯ ======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Процесс1_1 = Новый QtПроцесс()
    Процесс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. УСТАНОВКА ПРОГРАММЫ И АРГУМЕНТОВ =====
    Процесс1_1.УстановитьПрограмму("cmd.exe")
    Процесс1_1.УстановитьАргументы(["/c", "echo", "Hello"])
    программа = Процесс1_1.ПолучитьПрограмму()
    аргументы = Процесс1_1.ПолучитьАргументы()
    ВывестиСтрокуВКонсоль("    Программа: " + программа + ", Аргументы: " + аргументы.join(", "))
    
    // ===== 3. ЗАПУСК ПРОЦЕССА =====
    Процесс1_2 = Новый QtПроцесс()
    Процесс1_2.РежимОтладки(Режим_Отладки)
    Процесс1_2.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Hello World"])
    Процесс1_2.ЖдатьЗавершения(5000)
    завершен = Процесс1_2.Завершен()
    состояние = Процесс1_2.ПолучитьСостояние()
    ВывестиСтрокуВКонсоль("    ЗапуститьПроцесс() -> Завершен: " + завершен + ", Состояние: " + состояние)
    
    // ===== 4. ЧТЕНИЕ ВЫВОДА =====
    Процесс1_3 = Новый QtПроцесс()
    Процесс1_3.РежимОтладки(Режим_Отладки)
    Процесс1_3.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Test Output"])
    Процесс1_3.ЖдатьЗавершения(5000)
    вывод = Процесс1_3.ПрочитатьТекстВывода()
    ВывестиСтрокуВКонсоль("    ПрочитатьТекстВывода(): " + вывод + " (содержит 'Test Output')")
    
    // ===== 5. КОД ВЫХОДА =====
    Процесс1_4 = Новый QtПроцесс()
    Процесс1_4.РежимОтладки(Режим_Отладки)
    Процесс1_4.ЗапуститьПроцесс("cmd.exe", ["/c", "exit 0"])
    Процесс1_4.ЖдатьЗавершения(5000)
    кодВыхода = Процесс1_4.ПолучитьКодВыхода()
    статусВыхода = Процесс1_4.ПолучитьСтатусВыхода()
    нормальный = (статусВыхода == 0)
    ВывестиСтрокуВКонсоль("    ПолучитьКодВыхода(): " + кодВыхода + " (ожидается 0), Нормальный выход: " + нормальный + " (ожидается true)")
    
    // ===== 6. ОБРАБОТКА ОШИБОК =====
    Процесс1_5 = Новый QtПроцесс()
    Процесс1_5.РежимОтладки(Режим_Отладки)
    Процесс1_5.ЗапуститьПроцесс("nonexistent_program.exe")
    Процесс1_5.ЖдатьЗавершения(5000)
    кодОшибки = Процесс1_5.ПолучитьОшибку()
    текстОшибки = Процесс1_5.ПолучитьТекстОшибки()
    ВывестиСтрокуВКонсоль("    ПолучитьОшибку(): " + кодОшибки + ", ПолучитьТекстОшибки(): " + текстОшибки + " (ожидается не пусто)")
    
    // ===== 7. ЗАПИСЬ В ПРОЦЕСС =====
    Процесс1_6 = Новый QtПроцесс()
    Процесс1_6.РежимОтладки(Режим_Отладки)
    Процесс1_6.ЗапуститьПроцесс("cmd.exe")
    Процесс1_6.ЖдатьЗапуска(5000)
    Если Процесс1_6.isRunning() Тогда
        Процесс1_6.ЗаписатьСтроку("echo Hello from process")
        Процесс1_6.ЗаписатьСтроку("exit")
        Процесс1_6.ЗакрытьКаналЗаписи()
        Процесс1_6.ЖдатьЗавершения(5000)
        вывод6 = Процесс1_6.ПрочитатьТекстВывода()
        ВывестиСтрокуВКонсоль("    ЗаписатьСтроку() -> вывод: " + вывод6 + " (содержит 'Hello from process')")
    Иначе
        ВывестиСтрокуВКонсоль("    Запись в процесс: ПРОПУЩЕНО (процесс не запустился)")
    КонецЕсли
    
    // ===== 8. РАБОЧАЯ ДИРЕКТОРИЯ =====
    Процесс1_7 = Новый QtПроцесс()
    Процесс1_7.РежимОтладки(Режим_Отладки)
    Процесс1_7.УстановитьРабочийКаталог("C:/")
    рабочий = Процесс1_7.ПолучитьРабочийКаталог()
    ВывестиСтрокуВКонсоль("    УстановитьРабочийКаталог('C:/') -> ПолучитьРабочийКаталог(): " + рабочий + " (ожидается C:/)")
    
    // ===== 9. РЕЖИМ КАНАЛОВ =====
    Процесс1_8 = Новый QtПроцесс()
    Процесс1_8.РежимОтладки(Режим_Отладки)
    режим = Процесс1_8.MergedChannels()
    Процесс1_8.УстановитьРежимКаналов(режим)
    получРежим = Процесс1_8.ПолучитьРежимКаналов()
    ВывестиСтрокуВКонсоль("    УстановитьРежимКаналов(" + режим + ") -> ПолучитьРежимКаналов(): " + получРежим)
    
    // ===== 10. ЗАПУСК ОТДЕЛЕННОГО ПРОЦЕССА =====
    Процесс1_9 = Новый QtПроцесс()
    Процесс1_9.РежимОтладки(Режим_Отладки)
    результат = Процесс1_9.ЗапуститьОтделенный("cmd.exe", ["/c", "echo detached"])
    ВывестиСтрокуВКонсоль("    ЗапуститьОтделенный(): " + результат + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Процесс1_1.RusFunc === 'function' Тогда
        jsonStr = Процесс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtProcess (QtПроцесс) завершён.=======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonRpcStdioКлиент()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ЗапуститьШлюз                  │ startGateway                   │
//│ 20 │ ОстановитьШлюз                 │ stopGateway                    │
//│ 21 │ Запущен                        │ isRunning                      │
//│ 22 │ ВызватьМетод                   │ callMethod                     │
//│ 23 │ ОтправитьУведомление           │ sendNotification               │
//│ 24 │ ПриУведомлении                 │ onNotification                 │
//│ 25 │ ПриОшибке                      │ onError                        │
//│ 26 │ ПриЗапуске                     │ onStarted                      │
//│ 27 │ ПриОстановке                   │ onStopped                      │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonRpcStdioClient - КОМПАКТНАЯ ВЕРСИЯ =======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    RpcStd1_1 = Новый QtJsonRpcStdioКлиент()
    RpcStd1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. НАСТРОЙКА КОЛБЭКОВ =====
    Попытка
        RpcStd1_1.ПриЗапуске(Функция() {
            ВывестиСтрокуВКонсоль("    >> Gateway запущен")
        })
        RpcStd1_1.ПриОстановке(Функция() {
            ВывестиСтрокуВКонсоль("    >> Gateway остановлен")
        })
        RpcStd1_1.ПриОшибке(Функция(ошибка) {
            ВывестиСтрокуВКонсоль("    >> Ошибка: " + ошибка)
        })
        RpcStd1_1.ПриУведомлении(Функция(метод, параметры) {
            ВывестиСтрокуВКонсоль("    >> Уведомление: " + метод)
        })
        ВывестиСтрокуВКонсоль("    Колбэки установлены: УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Колбэки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. ПРОВЕРКА СОСТОЯНИЯ =====
    запущен = RpcStd1_1.Запущен()
    ВывестиСтрокуВКонсоль("    Запущен(): " + запущен + " (ожидается false)")
    
    // ===== 4. ВЫЗОВ МЕТОДА БЕЗ ЗАПУСКА =====
    колбэкВызван = ЛОЖЬ
    id = RpcStd1_1.ВызватьМетод("test.method", null, Функция(успех, ошибка, результат) {
        колбэкВызван = ИСТИНА
    })
    ВывестиСтрокуВКонсоль("    ВызватьМетод('test.method') без запуска: " + id + " (ожидается -1)")
    
    // ===== 5. ОТПРАВКА УВЕДОМЛЕНИЯ =====
    Попытка
        RpcStd1_1.ОтправитьУведомление("test.notification", null)
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ОСТАНОВКА =====
    Попытка
        RpcStd1_1.ОстановитьШлюз()
        ВывестиСтрокуВКонсоль("    ОстановитьШлюз(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ОстановитьШлюз(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. RUSFUNC =====
    Если typeof RpcStd1_1.RusFunc === 'function' Тогда
        jsonStr = RpcStd1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtJsonRpcStdioClient завершён.========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtIOУстройство()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ОткрытьУстройство              │ openDevice                     │
//│ 20 │ ЗакрытьУстройство              │ closeDevice                    │
//│ 21 │ УстройствоОткрыто              │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                │ readData                       │
//│ 23 │ ПрочитатьВсеДанные             │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtIODevice (QtIOУстройство) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Устр1_1 = Новый QtIODeviceTest()
    Устр1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    режим = Устр1_1.ReadWrite()
    Устр1_1.ОткрытьУстройство(режим)
    открыто = Устр1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ОткрытьУстройство(ReadWrite) -> УстройствоОткрыто(): " + открыто + " (ожидается true)")
    Устр1_1.ЗакрытьУстройство()
    открытоПосле = Устр1_1.УстройствоОткрыто()
    ВывестиСтрокуВКонсоль("    ЗакрытьУстройство() -> УстройствоОткрыто(): " + открытоПосле + " (ожидается false)")
    
    // ===== 3. ЧТЕНИЕ =====
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    Устр1_1.ОчиститьБуфер()
    Устр1_1.ДобавитьВБуфер("Тестовые данные для чтения\nСтрока 2\nСтрока 3")
    Устр1_1.СброситьУстройство()
    размер = Устр1_1.Размер()
    доступно = Устр1_1.ДоступноДанных()
    прочитано = Устр1_1.ПрочитатьВсеДанные()
    прочитаноСтрока = прочитано.toString()
    ВывестиСтрокуВКонсоль("    Размер(): " + размер + ", ДоступноДанных(): " + доступно)
    ВывестиСтрокуВКонсоль("    ПрочитатьВсеДанные(): " + прочитаноСтрока + " (ожидается не пусто)")
    
    // ===== 4. ЗАПИСЬ =====
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    Устр1_1.ОчиститьБуфер()
    записано1 = Устр1_1.ЗаписатьДанные("Hello World")
    записано2 = Устр1_1.ЗаписатьСтроку("Line 2")
    записано3 = Устр1_1.ЗаписатьСимвол('!')
    буфер = Устр1_1.ПолучитьБуфер()
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('Hello World'): " + записано1 + " байт")
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('Line 2'): " + записано2 + " байт")
    ВывестиСтрокуВКонсоль("    ЗаписатьСимвол('!'): " + записано3)
    ВывестиСтрокуВКонсоль("    ПолучитьБуфер(): " + буфер + " (содержит 'Hello WorldLine 2!')")
    
    // ===== 5. ПОЗИЦИОНИРОВАНИЕ =====
    Устр1_1.ОчиститьБуфер()
    Устр1_1.ДобавитьВБуфер("0123456789")
    Устр1_1.ОткрытьУстройство(Устр1_1.ReadWrite())
    Устр1_1.СброситьУстройство()
    позиция = Устр1_1.Позиция()
    размер = Устр1_1.Размер()
    ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
    Устр1_1.ПерейтиВ(5)
    позиция2 = Устр1_1.Позиция()
    ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция2 + " (ожидается 5)")
    Устр1_1.СброситьУстройство()
    позиция3 = Устр1_1.Позиция()
    ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + позиция3 + " (ожидается 0)")
    вконце = Устр1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце(): " + вконце)
    
    // ===== 6. ОШИБКИ =====
    Устр1_1.УстановитьТекстОшибки("Тестовая ошибка")
    ошибка = Устр1_1.ТекстОшибки()
    ВывестиСтрокуВКонсоль("    УстановитьТекстОшибки('Тестовая ошибка') -> ТекстОшибки(): " + ошибка + " (ожидается 'Тестовая ошибка')")
    
    // ===== 7. RUSFUNC =====
    Если typeof Устр1_1.RusFunc === 'function' Тогда
        jsonStr = Устр1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtIODevice (QtIOУстройство) завершён.================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtSSLСокет()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬─────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                   │ Английский метод                │
//├─────┼─────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                    │ isValid                        │
//│ 2 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 3 │ УстановитьРодителя              │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 6 │ ИмяОбъекта                      │ objectName                     │
//│ 7 │ УстановитьСвойство              │ setProperty                    │
//│ 8 │ Свойство                        │ property                       │
//│ 9 │ ПодключитьСигнал                │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                 │ disconnectSignal               │
//│ 11 │ КопироватьВ                     │ copyTo                         │
//│ 12 │ РежимОтладки                    │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 14 │ ПолучитьТипКласса               │ getClassType                   │
//│ 15 │ УстановитьТипКласса             │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса               │ getClassName                   │
//│ 17 │ УстановитьИмяКласса             │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов           │ RusFunc                        │
//│ 19 │ ОткрытьУстройство               │ openDevice                     │
//│ 20 │ ЗакрытьУстройство               │ closeDevice                    │
//│ 21 │ УстройствоОткрыто               │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                 │ readData                       │
//│ 23 │ ПрочитатьВсеДанные              │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                 │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                 │ getCharData                    │
//│ 26 │ ДоступноДанных                  │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность               │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                  │ writeData                      │
//│ 29 │ ЗаписатьСтроку                  │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                  │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                 │ bytesToWriteData               │
//│ 32 │ Позиция                         │ posData                        │
//│ 33 │ Размер                          │ sizeData                       │
//│ 34 │ ПерейтиВ                        │ seekData                       │
//│ 35 │ ВКонце                          │ atEndData                      │
//│ 36 │ СброситьУстройство              │ resetDevice                    │
//│ 37 │ ТекстОшибки                     │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки           │ setErrorStringData             │
//│ 39 │ Валидный                        │ isValid                        │
//│ 40 │ ПолучитьУстройство              │ getDevice                      │
//│ 41 │ КопироватьВ                     │ copyTo                         │
//│ 42 │ ТолькоЧтение                    │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                    │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                    │ ReadWrite                      │
//│ 45 │ Добавление                      │ Append                         │
//│ 46 │ Обрезать                        │ Truncate                       │
//│ 47 │ Текстовый                       │ Text                           │
//│ 48 │ БезБуферизации                  │ Unbuffered                     │
//│ 49 │ ПодключитьсяКХосту              │ connectToHost                  │
//│ 50 │ ОтключитьсяОтХоста              │ disconnectFromHost             │
//│ 51 │ Прервать                        │ abort                          │
//│ 52 │ ЖдатьПодключения                │ waitForConnected               │
//│ 53 │ ЖдатьОтключения                 │ waitForDisconnected            │
//│ 54 │ ПолучитьСостояние               │ getState                       │
