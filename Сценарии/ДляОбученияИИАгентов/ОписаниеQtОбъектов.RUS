Функция Методы_QtРазмер()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSize (QtРазмер) - КОМПАКТНАЯ ВЕРСИЯ ==========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Размер1_1 = Новый QtРазмер()
    Размер1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С ПАРАМЕТРАМИ =====
    Размер1_2 = Новый QtРазмер(100, 50)
    Размер1_2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    QtРазмер(100, 50): УСПЕШНО")
    
    // ===== 3. ПОЛУЧЕНИЕ ШИРИНЫ И ВЫСОТЫ =====
    ширина = Размер1_2.width()
    высота = Размер1_2.height()
    ширинаРус = Размер1_2.Ширина()
    высотаРус = Размер1_2.Высота()
    ВывестиСтрокуВКонсоль("    width(): " + ширина + ", Ширина(): " + ширинаРус + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    height(): " + высота + ", Высота(): " + высотаРус + " (ожидается 50)")
    
    // ===== 4. УСТАНОВКА ШИРИНЫ И ВЫСОТЫ =====
    Размер1_1.setWidth(200)
    Размер1_1.setHeight(100)
    ширина2 = Размер1_1.width()
    высота2 = Размер1_1.height()
    ВывестиСтрокуВКонсоль("    setWidth(200), setHeight(100) -> " + ширина2 + "x" + высота2 + " (ожидается 200x100)")
    
    Размер1_1.УстановитьШирину(300)
    Размер1_1.УстановитьВысоту(150)
    ширина2Рус = Размер1_1.Ширина()
    высота2Рус = Размер1_1.Высота()
    ВывестиСтрокуВКонсоль("    УстановитьШирину(300), УстановитьВысоту(150) -> " + ширина2Рус + "x" + высота2Рус + " (ожидается 300x150)")
    
    // ===== 5. УСТАНОВКА РАЗМЕРА =====
    Размер1_3 = Новый QtРазмер(0, 0)
    Размер1_3.РежимОтладки(Режим_Отладки)
    Размер1_3.setSize(400, 200)
    ширина3 = Размер1_3.width()
    высота3 = Размер1_3.height()
    ВывестиСтрокуВКонсоль("    setSize(400, 200) -> " + ширина3 + "x" + высота3 + " (ожидается 400x200)")
    
    Размер1_3.УстановитьРазмер(600, 300)
    ширина3Рус = Размер1_3.Ширина()
    высота3Рус = Размер1_3.Высота()
    ВывестиСтрокуВКонсоль("    УстановитьРазмер(600, 300) -> " + ширина3Рус + "x" + высота3Рус + " (ожидается 600x300)")
    
    // ===== 6. ПРОВЕРКА ВАЛИДНОСТИ =====
    Размер1_4 = Новый QtРазмер(100, 50)
    Размер1_4.РежимОтладки(Режим_Отладки)
    Размер1_5 = Новый QtРазмер(-10, -5)
    Размер1_5.РежимОтладки(Режим_Отладки)
    валид1 = Размер1_4.isValid()
    валид2 = Размер1_5.isValid()
    валид1Рус = Размер1_4.Действителен()
    валид2Рус = Размер1_5.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(100,50): " + валид1 + ", isValid(-10,-5): " + валид2 + " (ожидается true, false)")
    ВывестиСтрокуВКонсоль("    Действителен(100,50): " + валид1Рус + ", Действителен(-10,-5): " + валид2Рус + " (ожидается true, false)")
    
    // ===== 7. ПРОВЕРКА ПУСТОТЫ И НУЛЕВОГО РАЗМЕРА =====
    Размер1_6 = Новый QtРазмер(100, 50)
    Размер1_6.РежимОтладки(Режим_Отладки)
    Размер1_7 = Новый QtРазмер(0, 0)
    Размер1_7.РежимОтладки(Режим_Отладки)
    Размер1_8 = Новый QtРазмер(0, 50)
    Размер1_8.РежимОтладки(Режим_Отладки)
    
    пуст1 = Размер1_6.isEmpty()
    пуст2 = Размер1_7.isEmpty()
    пуст3 = Размер1_8.isEmpty()
    нуль1 = Размер1_6.isNull()
    нуль2 = Размер1_7.isNull()
    нуль3 = Размер1_8.isNull()
    ВывестиСтрокуВКонсоль("    isEmpty: (100,50)=" + пуст1 + ", (0,0)=" + пуст2 + ", (0,50)=" + пуст3 + " (ожидается false, true, true)")
    ВывестиСтрокуВКонсоль("    isNull: (100,50)=" + нуль1 + ", (0,0)=" + нуль2 + ", (0,50)=" + нуль3 + " (ожидается false, true, false)")
    
    // ===== 8. МАСШТАБИРОВАНИЕ =====
    Размер1_9 = Новый QtРазмер(100, 50)
    Размер1_9.РежимОтладки(Режим_Отладки)
    scaled = Размер1_9.scaled(200, 100, 0)
    ширинаSc = scaled.width()
    высотаSc = scaled.height()
    ВывестиСтрокуВКонсоль("    scaled(200, 100) -> " + ширинаSc + "x" + высотаSc + " (ожидается 200x100)")
    
    scaledРус = Размер1_9.Масштабировать(300, 150, 0)
    ширинаScРус = scaledРус.width()
    высотаScРус = scaledРус.height()
    ВывестиСтрокуВКонсоль("    Масштабировать(300, 150) -> " + ширинаScРус + "x" + высотаScРус + " (ожидается 300x150)")
    
    // ===== 9. МАСШТАБИРОВАНИЕ ПО ШИРИНЕ И ВЫСОТЕ =====
    scaledW = Размер1_9.scaledToWidth(200, 0)
    scaledH = Размер1_9.scaledToHeight(100, 0)
    ВывестиСтрокуВКонсоль("    scaledToWidth(200): " + scaledW.width() + "x" + scaledW.height())
    ВывестиСтрокуВКонсоль("    scaledToHeight(100): " + scaledH.width() + "x" + scaledH.height())
    
    scaledWРус = Размер1_9.МасштабироватьПоШирине(250, 0)
    scaledHРус = Размер1_9.МасштабироватьПоВысоте(125, 0)
    ВывестиСтрокуВКонсоль("    МасштабироватьПоШирине(250): " + scaledWРус.width() + "x" + scaledWРус.height())
    ВывестиСтрокуВКонсоль("    МасштабироватьПоВысоте(125): " + scaledHРус.width() + "x" + scaledHРус.height())
    
    // ===== 10. ТРАНСПОНИРОВАНИЕ =====
    Размер1_10 = Новый QtРазмер(100, 50)
    Размер1_10.РежимОтладки(Режим_Отладки)
    трансп = Размер1_10.transposed()
    ширинаТр = трансп.width()
    высотаТр = трансп.height()
    ВывестиСтрокуВКонсоль("    transposed(100,50) -> " + ширинаТр + "x" + высотаТр + " (ожидается 50x100)")
    
    транспРус = Размер1_10.Транспонировать()
    ширинаТрРус = транспРус.width()
    высотаТрРус = транспРус.height()
    ВывестиСтрокуВКонсоль("    Транспонировать(100,50) -> " + ширинаТрРус + "x" + высотаТрРус + " (ожидается 50x100)")
    
    // ===== 11. СЛОЖЕНИЕ И ВЫЧИТАНИЕ =====
    Размер1_11 = Новый QtРазмер(100, 50)
    Размер1_11.РежимОтладки(Режим_Отладки)
    Размер1_12 = Новый QtРазмер(20, 10)
    Размер1_12.РежимОтладки(Режим_Отладки)
    сумма = Размер1_11.plus(Размер1_12)
    разность = Размер1_11.minus(Размер1_12)
    ВывестиСтрокуВКонсоль("    plus(20,10): " + сумма.width() + "x" + сумма.height() + " (ожидается 120x60)")
    ВывестиСтрокуВКонсоль("    minus(20,10): " + разность.width() + "x" + разность.height() + " (ожидается 80x40)")
    
    суммаРус = Размер1_11.Плюс(Размер1_12)
    разностьРус = Размер1_11.Минус(Размер1_12)
    ВывестиСтрокуВКонсоль("    Плюс(20,10): " + суммаРус.width() + "x" + суммаРус.height() + " (ожидается 120x60)")
    ВывестиСтрокуВКонсоль("    Минус(20,10): " + разностьРус.width() + "x" + разностьРус.height() + " (ожидается 80x40)")
    
    // ===== 12. УМНОЖЕНИЕ И ДЕЛЕНИЕ =====
    умнож = Размер1_11.multiply(2)
    дел = Размер1_11.divide(2)
    ВывестиСтрокуВКонсоль("    multiply(2): " + умнож.width() + "x" + умнож.height() + " (ожидается 200x100)")
    ВывестиСтрокуВКонсоль("    divide(2): " + дел.width() + "x" + дел.height() + " (ожидается 50x25)")
    
    умножРус = Размер1_11.Умножить(3)
    делРус = Размер1_11.Разделить(3)
    ВывестиСтрокуВКонсоль("    Умножить(3): " + умножРус.width() + "x" + умножРус.height() + " (ожидается 300x150)")
    ВывестиСтрокуВКонсоль("    Разделить(3): " + делРус.width() + "x" + делРус.height() + " (ожидается 33x16)")
    
    // ===== 13. ПРЕОБРАЗОВАНИЕ В СТРОКУ =====
    строка = Размер1_2.toString()
    строкаРус = Размер1_2.ВСтроку()
    ВывестиСтрокуВКонсоль("    toString(): " + строка + ", ВСтроку(): " + строкаРус + " (ожидается 100x50)")
    
    // ===== 14. КОПИРОВАНИЕ =====
    Размер1_13 = Новый QtРазмер()
    Размер1_13.РежимОтладки(Режим_Отладки)
    результатКопия = Размер1_2.copyTo(Размер1_13)
    ширинаКопия = Размер1_13.Ширина()
    высотаКопия = Размер1_13.Высота()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия: " + ширинаКопия + "x" + высотаКопия + " (ожидается true, 100x50)")
    
    Размер1_14 = Новый QtРазмер()
    Размер1_14.РежимОтладки(Режим_Отладки)
    результатКопияРус = Размер1_2.КопироватьВ(Размер1_14)
    ширинаКопияРус = Размер1_14.Ширина()
    высотаКопияРус = Размер1_14.Высота()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия: " + ширинаКопияРус + "x" + высотаКопияРус + " (ожидается true, 100x50)")
    
    // ===== 15. ПОЛУЧЕНИЕ РЕАЛЬНОГО РАЗМЕРА =====
    реальный = Размер1_2.getRealSize()
    реальныйРус = Размер1_2.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    getRealSize(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРазмер(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 16. RUSFUNC =====
    Если typeof Размер1_1.RusFunc === 'function' Тогда
        jsonStr = Размер1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSize (QtРазмер) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtНастройки()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSettings (QtНастройки) - КОМПАКТНАЯ ВЕРСИЯ ==================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Настр1_1 = Новый QtНастройки()
    Настр1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Настр1_1.isValid()
    валидныйРус = Настр1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ИНФОРМАЦИОННЫЕ МЕТОДЫ =====
    орг = Настр1_1.organizationName()
    прил = Настр1_1.applicationName()
    файл = Настр1_1.fileName()
    обл = Настр1_1.scope()
    доступ = Настр1_1.isWritable()
    оргРус = Настр1_1.ИмяОрганизации()
    прилРус = Настр1_1.ИмяПриложения()
    файлРус = Настр1_1.ИмяФайла()
    облРус = Настр1_1.Область()
    доступРус = Настр1_1.ДоступнаЗапись()
    ВывестиСтрокуВКонсоль("    organizationName(): " + орг + ", ИмяОрганизации(): " + оргРус)
    ВывестиСтрокуВКонсоль("    applicationName(): " + прил + ", ИмяПриложения(): " + прилРус)
    ВывестиСтрокуВКонсоль("    fileName(): " + файл + ", ИмяФайла(): " + файлРус)
    ВывестиСтрокуВКонсоль("    scope(): " + обл + ", Область(): " + облРус)
    ВывестиСтрокуВКонсоль("    isWritable(): " + доступ + ", ДоступнаЗапись(): " + доступРус)
    
    // ===== 4. УСТАНОВКА И ЧТЕНИЕ ЗНАЧЕНИЙ =====
    Настр1_1.setValue("test/string", "Hello World")
    Настр1_1.setValue("test/int", 42)
    Настр1_1.setValue("test/bool", ИСТИНА)
    стр = Настр1_1.stringValue("test/string", "")
    число = Настр1_1.intValue("test/int", 0)
    бул = Настр1_1.boolValue("test/bool", ЛОЖЬ)
    ВывестиСтрокуВКонсоль("    stringValue: " + стр + " (ожидается Hello World)")
    ВывестиСтрокуВКонсоль("    intValue: " + число + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    boolValue: " + бул + " (ожидается true)")
    
    Настр1_1.УстановитьЗначение("test/string_ru", "Привет Мир")
    Настр1_1.УстановитьЗначение("test/int_ru", 100)
    Настр1_1.УстановитьЗначение("test/bool_ru", ЛОЖЬ)
    стрРус = Настр1_1.ЗначениеСтрока("test/string_ru", "")
    числоРус = Настр1_1.ЗначениеЦелое("test/int_ru", 0)
    булРус = Настр1_1.ЗначениеЛогическое("test/bool_ru", ИСТИНА)
    ВывестиСтрокуВКонсоль("    ЗначениеСтрока: " + стрРус + " (ожидается Привет Мир)")
    ВывестиСтрокуВКонсоль("    ЗначениеЦелое: " + числоРус + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    ЗначениеЛогическое: " + булРус + " (ожидается false)")
    
    // ===== 5. ПРОВЕРКА СУЩЕСТВОВАНИЯ И УДАЛЕНИЕ =====
    Настр1_1.setValue("test/exists", "value")
    есть = Настр1_1.contains("test/exists")
    нет = Настр1_1.contains("test/not_exists")
    Настр1_1.remove("test/exists")
    естьПосле = Настр1_1.contains("test/exists")
    ВывестиСтрокуВКонсоль("    contains(exists): " + есть + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains(not_exists): " + нет + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    contains after remove: " + естьПосле + " (ожидается false)")
    
    Настр1_1.УстановитьЗначение("test/exists_ru", "value")
    естьРус = Настр1_1.Содержит("test/exists_ru")
    нетРус = Настр1_1.Содержит("test/not_exists_ru")
    Настр1_1.Удалить("test/exists_ru")
    естьПослеРус = Настр1_1.Содержит("test/exists_ru")
    ВывестиСтрокуВКонсоль("    Содержит(exists): " + естьРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Содержит(not_exists): " + нетРус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Содержит after remove: " + естьПослеРус + " (ожидается false)")
    
    // ===== 6. РАБОТА С ГРУППАМИ =====
    Настр1_1.beginGroup("group1")
    Настр1_1.setValue("key1", "value1")
    Настр1_1.setValue("key2", "value2")
    Настр1_1.endGroup()
    ключи = Настр1_1.childKeys()
    группы = Настр1_1.childGroups()
    ВывестиСтрокуВКонсоль("    childKeys: " + ключи.join(", "))
    ВывестиСтрокуВКонсоль("    childGroups: " + группы.join(", "))
    
    Настр1_1.НачатьГруппу("group2")
    Настр1_1.УстановитьЗначение("key1_ru", "value1_ru")
    Настр1_1.УстановитьЗначение("key2_ru", "value2_ru")
    Настр1_1.ЗакончитьГруппу()
    ключиРус = Настр1_1.ДочерниеКлючи()
    группыРус = Настр1_1.ДочерниеГруппы()
    ВывестиСтрокуВКонсоль("    ДочерниеКлючи: " + ключиРус.join(", "))
    ВывестиСтрокуВКонсоль("    ДочерниеГруппы: " + группыРус.join(", "))
    
    // ===== 7. СИНХРОНИЗАЦИЯ И ОЧИСТКА =====
    Настр1_1.setValue("test/sync", "value")
    Настр1_1.sync()
    естьSync = Настр1_1.contains("test/sync")
    Настр1_1.clear()
    естьПослеClear = Настр1_1.contains("test/sync")
    ВывестиСтрокуВКонсоль("    sync() -> contains: " + естьSync + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    clear() -> contains: " + естьПослеClear + " (ожидается false)")
    
    Настр1_1.УстановитьЗначение("test/sync_ru", "value")
    Настр1_1.Синхронизировать()
    естьSyncРус = Настр1_1.Содержит("test/sync_ru")
    Настр1_1.Очистить()
    естьПослеClearРус = Настр1_1.Содержит("test/sync_ru")
    ВывестиСтрокуВКонсоль("    Синхронизировать() -> содержит: " + естьSyncРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Очистить() -> содержит: " + естьПослеClearРус + " (ожидается false)")
    
    // ===== 8. ФОРМАТЫ И ОБЛАСТИ =====
    ini = Настр1_1.iniFormat()
    native = Настр1_1.nativeFormat()
    user = Настр1_1.userScope()
    system = Настр1_1.systemScope()
    iniРус = Настр1_1.ФорматINI()
    nativeРус = Настр1_1.ФорматNative()
    userРус = Настр1_1.ОбластьПользователя()
    systemРус = Настр1_1.ОбластьСистемы()
    ВывестиСтрокуВКонсоль("    iniFormat(): " + ini + ", ФорматINI(): " + iniРус + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    nativeFormat(): " + native + ", ФорматNative(): " + nativeРус + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    userScope(): " + user + ", ОбластьПользователя(): " + userРус + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    systemScope(): " + system + ", ОбластьСистемы(): " + systemРус + " (ожидается 1)")
    
    // ===== 9. КОПИРОВАНИЕ =====
    Настр1_2 = Новый QtНастройки()
    Настр1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Настр1_1.copyTo(Настр1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Настр1_3 = Новый QtНастройки()
    Настр1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Настр1_1.КопироватьВ(Настр1_3)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНЫХ НАСТРОЕК =====
    реальные = Настр1_1.getRealSettings()
    реальныеРус = Настр1_1.ПолучитьНастройки()
    ВывестиСтрокуВКонсоль("    getRealSettings(): " + (реальные != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьНастройки(): " + (реальныеРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. RUSFUNC =====
    Если typeof Настр1_1.RusFunc === 'function' Тогда
        jsonStr = Настр1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSettings (QtНастройки) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtКраткийВызов()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtShortcut (QtКраткийВызов) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // Создаём виджет для тестов
    виджет = Новый QtВиджет()
    виджет.Показать()
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    КраткВыз1_1 = Новый QtКраткийВызов(виджет)
    КраткВыз1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = КраткВыз1_1.isValid()
    валидныйРус = КраткВыз1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ КЛЮЧА =====
    КраткВыз1_1.setKey("Ctrl+Shift+S")
    ключ = КраткВыз1_1.getKey()
    текстКлюча = КраткВыз1_1.getKeyText()
    ВывестиСтрокуВКонсоль("    setKey(Ctrl+Shift+S) -> getKeyText(): " + текстКлюча)
    
    КраткВыз1_1.УстановитьКлюч("Ctrl+Alt+O")
    ключРус = КраткВыз1_1.Ключ()
    текстКлючаРус = КраткВыз1_1.ТекстКлюча()
    ВывестиСтрокуВКонсоль("    УстановитьКлюч(Ctrl+Alt+O) -> ТекстКлюча(): " + текстКлючаРус)
    
    // ===== 4. ДОСТУПНОСТЬ =====
    КраткВыз1_1.setEnabledValue(ЛОЖЬ)
    доступен1 = КраткВыз1_1.isEnabledValue()
    КраткВыз1_1.setEnabledValue(ИСТИНА)
    доступен2 = КраткВыз1_1.isEnabledValue()
    ВывестиСтрокуВКонсоль("    setEnabledValue(false) -> isEnabledValue(): " + доступен1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    setEnabledValue(true) -> isEnabledValue(): " + доступен2 + " (ожидается true)")
    
    КраткВыз1_1.УстановитьДоступен(ЛОЖЬ)
    доступен1Рус = КраткВыз1_1.Доступен()
    КраткВыз1_1.УстановитьДоступен(ИСТИНА)
    доступен2Рус = КраткВыз1_1.Доступен()
    ВывестиСтрокуВКонсоль("    УстановитьДоступен(false) -> Доступен(): " + доступен1Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    УстановитьДоступен(true) -> Доступен(): " + доступен2Рус + " (ожидается true)")
    
    // ===== 5. АВТОПОВТОР =====
    КраткВыз1_1.setAutoRepeatValue(ЛОЖЬ)
    повтор1 = КраткВыз1_1.autoRepeatValue()
    КраткВыз1_1.setAutoRepeatValue(ИСТИНА)
    повтор2 = КраткВыз1_1.autoRepeatValue()
    ВывестиСтрокуВКонсоль("    setAutoRepeatValue(false) -> autoRepeatValue(): " + повтор1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    setAutoRepeatValue(true) -> autoRepeatValue(): " + повтор2 + " (ожидается true)")
    
    КраткВыз1_1.УстановитьАвтоповтор(ЛОЖЬ)
    повтор1Рус = КраткВыз1_1.Автоповтор()
    КраткВыз1_1.УстановитьАвтоповтор(ИСТИНА)
    повтор2Рус = КраткВыз1_1.Автоповтор()
    ВывестиСтрокуВКонсоль("    УстановитьАвтоповтор(false) -> Автоповтор(): " + повтор1Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    УстановитьАвтоповтор(true) -> Автоповтор(): " + повтор2Рус + " (ожидается true)")
    
    // ===== 6. ПОДСКАЗКА =====
    КраткВыз1_1.setWhat("Сохранить документ")
    подсказка = КраткВыз1_1.getWhat()
    ВывестиСтрокуВКонсоль("    setWhat('Сохранить документ') -> getWhat(): " + подсказка + " (ожидается 'Сохранить документ')")
    
    КраткВыз1_1.УстановитьПодсказку("Открыть файл")
    подсказкаРус = КраткВыз1_1.Подсказка()
    ВывестиСтрокуВКонсоль("    УстановитьПодсказку('Открыть файл') -> Подсказка(): " + подсказкаРус + " (ожидается 'Открыть файл')")
    
    // ===== 7. ИДЕНТИФИКАТОР И РОДИТЕЛЬ =====
    ид = КраткВыз1_1.getIdValue()
    родитель = КраткВыз1_1.getParentWidgetValue()
    ВывестиСтрокуВКонсоль("    getIdValue(): " + ид + " (ожидается >= 0)")
    ВывестиСтрокуВКонсоль("    getParentWidgetValue(): " + (родитель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    идРус = КраткВыз1_1.Идентификатор()
    родительРус = КраткВыз1_1.РодительскийВиджет()
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + идРус + " (ожидается >= 0)")
    ВывестиСтрокуВКонсоль("    РодительскийВиджет(): " + (родительРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 8. ПОСЛЕДОВАТЕЛЬНОСТИ КЛЮЧЕЙ =====
    посл1 = КраткВыз1_1.keySequence("Ctrl+Shift+S")
    посл2 = КраткВыз1_1.standardKeyText(1)
    ВывестиСтрокуВКонсоль("    keySequence(Ctrl+Shift+S): " + посл1.toString())
    ВывестиСтрокуВКонсоль("    standardKeyText(Save): " + посл2)
    
    посл1Рус = КраткВыз1_1.ПоследовательностьКлючей("Ctrl+Shift+O")
    посл2Рус = КраткВыз1_1.СтандартныйКлюч(1)
    ВывестиСтрокуВКонсоль("    ПоследовательностьКлючей(Ctrl+Shift+O): " + посл1Рус.toString())
    ВывестиСтрокуВКонсоль("    СтандартныйКлюч(Save): " + посл2Рус)
    
    // ===== 9. СОЗДАНИЕ ПОСЛЕДОВАТЕЛЬНОСТИ ИЗ КЛЮЧЕЙ =====
    посл3 = КраткВыз1_1.keySequenceFromKeys("Ctrl", "Shift", "S")
    ВывестиСтрокуВКонсоль("    keySequenceFromKeys(Ctrl, Shift, S): " + посл3.toString())
    
    посл3Рус = КраткВыз1_1.ПоследовательностьИзКлючей("Ctrl", "Alt", "O")
    ВывестиСтрокуВКонсоль("    ПоследовательностьИзКлючей(Ctrl, Alt, O): " + посл3Рус.toString())
    
    // ===== 10. КОЛБЭК, КОПИРОВАНИЕ, РЕАЛЬНЫЙ ОБЪЕКТ =====
    вызвано = ЛОЖЬ
    КраткВыз1_1.setCallback(function() {
        вызвано = ИСТИНА
    })
    реальный = КраткВыз1_1.getRealShortcut()
    КраткВыз1_2 = Новый QtКраткийВызов(виджет)
    КраткВыз1_2.РежимОтладки(Режим_Отладки)
    результатКопия = КраткВыз1_1.copyTo(КраткВыз1_2)
    ВывестиСтрокуВКонсоль("    setCallback(): УСПЕШНО")
    ВывестиСтрокуВКонсоль("    getRealShortcut(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    вызвано2 = ЛОЖЬ
    КраткВыз1_1.УстановитьКолбэк(function() {
        вызвано2 = ИСТИНА
    })
    реальныйРус = КраткВыз1_1.ПолучитьКраткийВызов()
    КраткВыз1_3 = Новый QtКраткийВызов(виджет)
    КраткВыз1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = КраткВыз1_1.КопироватьВ(КраткВыз1_3)
    ВывестиСтрокуВКонсоль("    УстановитьКолбэк(): УСПЕШНО")
    ВывестиСтрокуВКонсоль("    ПолучитьКраткийВызов(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof КраткВыз1_1.RusFunc === 'function' Тогда
        jsonStr = КраткВыз1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // Закрываем виджет
    виджет.Скрыть()
    
    ВывестиСтрокуВКонсоль("==== Тест QtShortcut (QtКраткийВызов) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБлочноеРасположение()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBoxLayout (QtБлочноеРасположение) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    БлРасп1_1 = Новый QtБлочноеРасположение()
    БлРасп1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = БлРасп1_1.isValid()
    валидныйРус = БлРасп1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. НАПРАВЛЕНИЕ =====
    направление = БлРасп1_1.Направление()
    направлениеСтр = БлРасп1_1.НаправлениеСтрока()
    вертикальный = БлРасп1_1.Вертикальный()
    горизонтальный = БлРасп1_1.Горизонтальный()
    ВывестиСтрокуВКонсоль("    Направление(): " + направление + ", НаправлениеСтрока(): " + направлениеСтр)
    ВывестиСтрокуВКонсоль("    Вертикальный(): " + вертикальный + ", Горизонтальный(): " + горизонтальный)
    
    // ===== 4. МЕТОДЫ ДОБАВЛЕНИЯ =====
    имеетAddWidget = typeof БлРасп1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof БлРасп1_1.ДобавитьВиджет === 'function'
    имеетAddStretch = typeof БлРасп1_1.addStretch === 'function'
    имеетДобавитьРастяжение = typeof БлРасп1_1.ДобавитьРастяжение === 'function'
    имеетAddSpacing = typeof БлРасп1_1.addSpacing === 'function'
    имеетДобавитьОтступ = typeof БлРасп1_1.ДобавитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
    
    // ===== 5. МЕТОДЫ ВСТАВКИ =====
    имеетInsertWidget = typeof БлРасп1_1.insertWidget === 'function'
    имеетВставитьВиджет = typeof БлРасп1_1.ВставитьВиджет === 'function'
    имеетInsertStretch = typeof БлРасп1_1.insertStretch === 'function'
    имеетВставитьРастяжение = typeof БлРасп1_1.ВставитьРастяжение === 'function'
    имеетInsertSpacing = typeof БлРасп1_1.insertSpacing === 'function'
    имеетВставитьОтступ = typeof БлРасп1_1.ВставитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
    
    // ===== 6. УПРАВЛЕНИЕ РАСТЯЖЕНИЕМ =====
    Попытка
        БлРасп1_1.УстановитьРастяжение(0, 5)
        растяжение = БлРасп1_1.Растяжение(0)
        БлРасп1_1.УстановитьРастяжение(0, 3)
        растяжениеРус = БлРасп1_1.Растяжение(0)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,5) -> Растяжение(0): " + растяжение + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,3) -> Растяжение(0): " + растяжениеРус + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Управление растяжением: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. РАБОТА С ВЛОЖЕННЫМИ LAYOUT =====
    имеетAddLayout = typeof БлРасп1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof БлРасп1_1.ДобавитьРасположение === 'function'
    имеетInsertLayout = typeof БлРасп1_1.insertLayout === 'function'
    имеетВставитьРасположение = typeof БлРасп1_1.ВставитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertLayout(): " + (имеетInsertLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРасположение(): " + (имеетВставитьРасположение ? "✅" : "❌"))
    
    // ===== 8. ОТСТУПЫ, ПРОМЕЖУТКИ И ДОСТУПНОСТЬ =====
    Попытка
        БлРасп1_1.УстановитьОтступ(10)
        отступ = БлРасп1_1.Отступ()
        БлРасп1_1.УстановитьОтступ(15)
        отступРус = БлРасп1_1.Отступ()
        
        БлРасп1_1.УстановитьПромежуток(5)
        промежуток = БлРасп1_1.Промежуток()
        БлРасп1_1.УстановитьПромежуток(8)
        промежутокРус = БлРасп1_1.Промежуток()
        
        БлРасп1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = БлРасп1_1.Доступен()
        БлРасп1_1.УстановитьДоступен(ИСТИНА)
        доступен2 = БлРасп1_1.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус + " (ожидается 10 / 15)")
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус + " (ожидается 5 / 8)")
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + " -> " + доступен2 + " (ожидается false -> true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/промежутки/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = БлРасп1_1.getRealBoxLayout()
    реальныйРус = БлРасп1_1.ПолучитьБлочноеРасположение()
    реальныйLayout = БлРасп1_1.getRealLayout()
    реальныйLayoutРус = БлРасп1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    БлРасп1_2 = Новый QtБлочноеРасположение()
    БлРасп1_2.РежимОтладки(Режим_Отладки)
    результатКопия = БлРасп1_1.copyTo(БлРасп1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof БлРасп1_1.RusFunc === 'function' Тогда
        jsonStr = БлРасп1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBoxLayout (QtБлочноеРасположение) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

