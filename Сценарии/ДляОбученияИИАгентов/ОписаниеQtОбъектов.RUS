//│ 63 │ Копировать                     │ copy                           │
//│ 64 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBuffer (QtБуфер) - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Буф1_1 = Новый QtБуфер()
    Буф1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. БАЗОВЫЕ СВОЙСТВА =====
    размер = Буф1_1.Размер()
    ВывестиСтрокуВКонсоль("    Размер(): " + размер + " (ожидается 0)")
    
    // ===== 3. ОТКРЫТИЕ БУФЕРА =====
    результатОткрытия = Буф1_1.ОткрытьБуфер(Буф1_1.ReadOnly() | Буф1_1.ReadWrite())
    открыто = Буф1_1.БуферОткрыт()
    ВывестиСтрокуВКонсоль("    ОткрытьБуфер(ReadOnly|ReadWrite): " + результатОткрытия + ", БуферОткрыт(): " + открыто + " (ожидается true)")
    
    // ===== 4. ЗАПИСЬ СТРОКИ =====
    тестСтрока = "Hello World!"
    записано = Буф1_1.ЗаписатьДанные(тестСтрока)
    размер2 = Буф1_1.Размер()
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('" + тестСтрока + "'): " + записано + " байт, Размер(): " + размер2 + " (ожидается > 0)")
    
    // ===== 5. ЧТЕНИЕ ДАННЫХ =====
    Буф1_1.СброситьУстройство()
    текст = Буф1_1.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ПолучитьТекст(): '" + текст + "' (ожидается 'Hello World!')")
    
    // ===== 6. ЗАПИСЬ СИМВОЛА =====
    Буф1_1.СброситьУстройство()
    Буф1_1.ОчиститьБуфер()
    результатСимвол = Буф1_1.ЗаписатьСимвол('X')
    Буф1_1.СброситьУстройство()
    символ = Буф1_1.ПрочитатьСимвол()
    ВывестиСтрокуВКонсоль("    ЗаписатьСимвол('X'): " + результатСимвол + ", ПрочитатьСимвол(): '" + символ + "' (ожидается 'X')")
    
    // ===== 7. ПОЗИЦИОНИРОВАНИЕ =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьСтроку("0123456789")
    Буф1_1.СброситьУстройство()
    позицияНач = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    Позиция(): " + позицияНач + " (ожидается 0)")
    Буф1_1.ПерейтиВ(5)
    позиция5 = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция5 + " (ожидается 5)")
    Буф1_1.СброситьУстройство()
    позицияСброс = Буф1_1.Позиция()
    ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + позицияСброс + " (ожидается 0)")
    
    // ===== 8. КОНЕЦ БУФЕРА =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьДанные("12345")
    Буф1_1.СброситьУстройство()
    вКонце = Буф1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце() в начале: " + вКонце + " (ожидается false)")
    Буф1_1.ПерейтиВ(5)
    вКонце2 = Буф1_1.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце() в позиции 5: " + вКонце2 + " (ожидается true)")
    
    // ===== 9. ДОСТУПНЫЕ ДАННЫЕ =====
    Буф1_1.ОчиститьБуфер()
    Буф1_1.ЗаписатьСтроку("Test Data 123")
    Буф1_1.СброситьУстройство()
    доступно = Буф1_1.ДоступноДанных()
    ВывестиСтрокуВКонсоль("    ДоступноДанных(): " + доступно + " (ожидается > 0)")
    Буф1_1.ПрочитатьДанные(5)
    доступно2 = Буф1_1.ДоступноДанных()
    ВывестиСтрокуВКонсоль("    После чтения 5 байт: " + доступно2 + " (ожидается меньше " + доступно + ")")
    
    // ===== 10. ЗАКРЫТИЕ БУФЕРА =====
    Буф1_1.ЗакрытьБуфер()
    открыто2 = Буф1_1.БуферОткрыт()
    ВывестиСтрокуВКонсоль("    ЗакрытьБуфер() -> БуферОткрыт(): " + открыто2 + " (ожидается false)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Буф1_1.RusFunc === 'function' Тогда
        jsonStr = Буф1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBuffer (QtБуфер) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБуферУстройство()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ОткрытьУстройство              │ openDevice                     │
//│ 20 │ ЗакрытьУстройство              │ closeDevice                    │
//│ 21 │ УстройствоОткрыто              │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                │ readData                       │
//│ 23 │ ПрочитатьВсеДанные             │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//│ 49 │ УстановитьДанные               │ setData                        │
//│ 50 │ ПолучитьДанные                 │ getData                        │
//│ 51 │ УстановитьТекст                │ setText                        │
//│ 52 │ ПолучитьТекст                  │ getText                        │
//│ 53 │ ОчиститьДанные                 │ clearData                      │
//│ 54 │ ПолучитьРазмер                 │ getSize                        │
//│ 55 │ ПолучитьПозицию                │ getPosition                    │
//│ 56 │ Открыть                        │ openDevice                     │
//│ 57 │ Закрыть                        │ closeDevice                    │
//│ 58 │ Открыто                        │ isOpenDevice                   │
//│ 59 │ ВКонце                         │ isAtEnd                        │
//│ 60 │ Сбросить                       │ resetDevice                    │
//│ 61 │ Перейти                        │ seek                           │
//│ 62 │ Прочитать                      │ readBytes                      │
//│ 63 │ ПрочитатьСтроку                │ readString                     │
//│ 64 │ ПрочитатьВсе                   │ readAll                        │
//│ 65 │ ПрочитатьВесьТекст             │ readAllText                    │
//│ 66 │ ДоступноБайт                   │ bytesAvailable                 │
//│ 67 │ Записать                       │ writeBytes                     │
//│ 68 │ ЗаписатьСтроку                 │ writeString                    │
//│ 69 │ ЗаписатьСимвол                 │ writeChar                      │
//│ 70 │ ПолучитьДанныеПоток            │ getDataStream                  │
//│ 71 │ ПрочитатьЦелое8                │ readInt8                       │
//│ 72 │ ПрочитатьЦелое16               │ readInt16                      │
//│ 73 │ ПрочитатьЦелое32               │ readInt32                      │
//│ 74 │ ПрочитатьЦелое64               │ readInt64                      │
//│ 75 │ ПрочитатьДробь                 │ readDouble                     │
//│ 76 │ ПрочитатьЛогику                │ readBool                       │
//│ 77 │ ПрочитатьСтрокуQ               │ readQString                    │
//│ 78 │ ЗаписатьЦелое8                 │ writeInt8                      │
//│ 79 │ ЗаписатьЦелое16                │ writeInt16                     │
//│ 80 │ ЗаписатьЦелое32                │ writeInt32                     │
//│ 81 │ ЗаписатьЦелое64                │ writeInt64                     │
//│ 82 │ ЗаписатьДробь                  │ writeDouble                    │
//│ 83 │ ЗаписатьЛогику                 │ writeBool                      │
//│ 84 │ ЗаписатьСтрокуQ                │ writeQString                   │
//│ 85 │ ПолучитьQBuffer                │ getRealBuffer                  │
//│ 86 │ Режим_ТолькоЧтение             │ ReadOnly                       │
//│ 87 │ Режим_ТолькоЗапись             │ WriteOnly                      │
//│ 88 │ Режим_ЧтениеЗапись             │ ReadWrite                      │
//│ 89 │ Режим_Добавление               │ Append                         │
//│ 90 │ Режим_Очистка                  │ Truncate                       │
//│ 91 │ Режим_Текст                    │ Text                           │
//│ 92 │ Режим_НеБлокирующий            │ Unbuffered                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBufferDevice (QtБуферУстройство) - КОМПАКТНАЯ ВЕРСИЯ ======")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Буф2_1 = Новый QtБуферУстройство()
    Буф2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПОЛУЧЕНИЕ УСТРОЙСТВА =====
    устройство = Буф2_1.ПолучитьУстройство()
    ВывестиСтрокуВКонсоль("    ПолучитьУстройство(): " + (устройство != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 3. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    результат = Буф2_1.Открыть(Буф2_1.ReadWrite() | Буф2_1.Truncate())
    открыто = Буф2_1.Открыто()
    ВывестиСтрокуВКонсоль("    Открыть(ReadWrite|Truncate): " + результат + ", Открыто(): " + открыто + " (ожидается true)")
    Буф2_1.Закрыть()
    закрыто = Буф2_1.Открыто()
    ВывестиСтрокуВКонсоль("    Закрыть() -> Открыто(): " + закрыто + " (ожидается false)")
    
    // ===== 4. ЗАПИСЬ И ЧТЕНИЕ =====
    Буф2_2 = Новый QtБуферУстройство()
    Буф2_2.РежимОтладки(Режим_Отладки)
    Буф2_2.Открыть(Буф2_2.ReadWrite() | Буф2_2.Truncate())
    тестТекст = "Hello World!"
    записано = Буф2_2.ЗаписатьСтроку(тестТекст)
    размер = Буф2_2.ПолучитьРазмер()
    Буф2_2.Сбросить()
    прочитано = Буф2_2.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('" + тестТекст + "'): " + записано + " байт, Размер: " + размер + ", ПрочитатьВесьТекст(): '" + прочитано + "' (ожидается 'Hello World!')")
    Буф2_2.Закрыть()
    
    // ===== 5. ЗАПИСЬ СИМВОЛА (через строки) =====
    Буф2_3 = Новый QtБуферУстройство()
    Буф2_3.РежимОтладки(Режим_Отладки)
    Буф2_3.Открыть(Буф2_3.ReadWrite() | Буф2_3.Truncate())
    Буф2_3.ЗаписатьСтроку("A")
    Буф2_3.ЗаписатьСтроку("B")
    Буф2_3.ЗаписатьСтроку("C")
    Буф2_3.Сбросить()
    прочитано3 = Буф2_3.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('A'), ЗаписатьСтроку('B'), ЗаписатьСтроку('C') -> ПрочитатьВесьТекст(): '" + прочитано3 + "' (ожидается 'ABC')")
    Буф2_3.Закрыть()
    
    // ===== 6. ПОЗИЦИОНИРОВАНИЕ =====
    Буф2_4 = Новый QtБуферУстройство("0123456789")
    Буф2_4.РежимОтладки(Режим_Отладки)
    Буф2_4.Открыть(Буф2_4.ReadWrite())
    позицияНач = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    ПолучитьПозицию(): " + позицияНач + " (ожидается 0)")
    Буф2_4.Перейти(5)
    позиция5 = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    Перейти(5) -> ПолучитьПозицию(): " + позиция5 + " (ожидается 5)")
    вКонце = Буф2_4.ВКонце()
    ВывестиСтрокуВКонсоль("    ВКонце(): " + вКонце + " (ожидается false)")
    размер4 = Буф2_4.Размер()
    Буф2_4.Перейти(размер4)
    вКонце2 = Буф2_4.ВКонце()
    ВывестиСтрокуВКонсоль("    Перейти(Размер) -> ВКонце(): " + вКонце2 + " (ожидается true)")
    Буф2_4.Сбросить()
    позицияСброс = Буф2_4.ПолучитьПозицию()
    ВывестиСтрокуВКонсоль("    Сбросить() -> ПолучитьПозицию(): " + позицияСброс + " (ожидается 0)")
    Буф2_4.Закрыть()
    
    // ===== 7. БИНАРНЫЕ ДАННЫЕ =====
    Буф2_5 = Новый QtБуферУстройство()
    Буф2_5.РежимОтладки(Режим_Отладки)
    Буф2_5.Открыть(Буф2_5.ReadWrite() | Буф2_5.Truncate())
    байты = Новый QtБайтМассив()
    байты.ДобавитьСтроку("Binary Data")
    бинарныеДанные = байты.ПолучитьДанные()
    Буф2_5.Записать(бинарныеДанные)
    Буф2_5.Сбросить()
    прочитанныеБайты = Буф2_5.Прочитать(100)
    байтыРезультат = Новый QtБайтМассив(прочитанныеБайты)
    размерПрочитано = байтыРезультат.ПолучитьРазмер()
    текстРезультат = байтыРезультат.ПолучитьКакСтроку()
    ВывестиСтрокуВКонсоль("    Записать(бинарные) -> Прочитать(): '" + текстРезультат + "' (ожидается 'Binary Data'), Размер: " + размерПрочитано)
    Буф2_5.Закрыть()
    
    // ===== 8. ДОСТУПНЫЕ ДАННЫЕ =====
    Буф2_6 = Новый QtБуферУстройство("Test Data 1234567890")
    Буф2_6.РежимОтладки(Режим_Отладки)
    Буф2_6.Открыть(Буф2_6.ReadOnly())
    доступно = Буф2_6.ДоступноБайт()
    ВывестиСтрокуВКонсоль("    ДоступноБайт(): " + доступно + " (ожидается > 0)")
    Буф2_6.Прочитать(5)
    доступно2 = Буф2_6.ДоступноБайт()
    ВывестиСтрокуВКонсоль("    После чтения 5 байт: " + доступно2 + " (ожидается меньше " + доступно + ")")
    Буф2_6.Закрыть()
    
    // ===== 9. ОЧИСТКА ДАННЫХ =====
    Буф2_7 = Новый QtБуферУстройство("Data to clear")
    Буф2_7.РежимОтладки(Режим_Отладки)
    Буф2_7.Открыть(Буф2_7.ReadWrite())
    размерДо = Буф2_7.ПолучитьРазмер()
    текстДо = Буф2_7.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ПолучитьРазмер(): " + размерДо + ", ПолучитьТекст(): '" + текстДо + "'")
    Буф2_7.ОчиститьДанные()
    размерПосле = Буф2_7.ПолучитьРазмер()
    текстПосле = Буф2_7.ПолучитьТекст()
    ВывестиСтрокуВКонсоль("    ОчиститьДанные() -> Размер: " + размерПосле + " (ожидается 0), Текст: '" + текстПосле + "' (ожидается пусто)")
    Буф2_7.Закрыть()
    
    // ===== 10. УСТАНОВКА ДАННЫХ ИЗ СТРОКИ =====
    тестСтрока = "Строка для теста"
    Буф2_8 = Новый QtБуферУстройство(тестСтрока)
    Буф2_8.РежимОтладки(Режим_Отладки)
    Буф2_8.Открыть(Буф2_8.ReadOnly())
    текст8 = Буф2_8.ПолучитьТекст()
    размер8 = Буф2_8.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    Конструктор со строкой -> ПолучитьТекст(): '" + текст8 + "', Размер: " + размер8 + " (ожидается '" + тестСтрока + "')")
    Буф2_8.Закрыть()
    
    // ===== 11. КОНСТАНТЫ РЕЖИМОВ =====
    режимЧт = Буф2_1.ReadOnly()
    режимЗап = Буф2_1.WriteOnly()
    режимЧтЗап = Буф2_1.ReadWrite()
    режимДоб = Буф2_1.Append()
    режимОчист = Буф2_1.Truncate()
    ВывестиСтрокуВКонсоль("    ReadOnly: " + режимЧт + ", WriteOnly: " + режимЗап + ", ReadWrite: " + режимЧтЗап + ", Append: " + режимДоб + ", Truncate: " + режимОчист)
    
    // ===== 12. ЧТЕНИЕ ПО ЧАСТЯМ =====
    Буф2_9 = Новый QtБуферУстройство("0123456789")
    Буф2_9.РежимОтладки(Режим_Отладки)
    Буф2_9.Открыть(Буф2_9.ReadOnly())
    часть1 = Буф2_9.ПрочитатьСтроку(3)
    часть2 = Буф2_9.ПрочитатьСтроку(3)
    часть3 = Буф2_9.ПрочитатьВесьТекст()
    ВывестиСтрокуВКонсоль("    ПрочитатьСтроку(3): '" + часть1 + "', ПрочитатьСтроку(3): '" + часть2 + "', ПрочитатьВесьТекст(): '" + часть3 + "' (ожидается '012', '345', '6789')")
    Буф2_9.Закрыть()
    
    // ===== 13. УСТАНОВКА ДАННЫХ ЧЕРЕЗ SETDATA =====
    Буф2_10 = Новый QtБуферУстройство()
    Буф2_10.РежимОтладки(Режим_Отладки)
    Буф2_10.УстановитьДанные("SetData Test")
    Буф2_10.Открыть(Буф2_10.ReadOnly())
    текст10 = Буф2_10.ПолучитьТекст()
    размер10 = Буф2_10.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    УстановитьДанные('SetData Test') -> ПолучитьТекст(): '" + текст10 + "', Размер: " + размер10)
    Буф2_10.Закрыть()
    
    // ===== 14. RUSFUNC =====
    Если typeof Буф2_1.RusFunc === 'function' Тогда
        jsonStr = Буф2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBufferDevice (QtБуферУстройство) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСетевойМенеджер()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬───────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                   │
//├─────┼────────────────────────────────┼───────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                           │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                     │
//│ 3 │ УстановитьРодителя             │ setParentWrapper                  │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper                  │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                     │
//│ 6 │ ИмяОбъекта                     │ objectName                        │
//│ 7 │ УстановитьСвойство             │ setProperty                       │
//│ 8 │ Свойство                       │ property                          │
//│ 9 │ ПодключитьСигнал               │ connectSignal                     │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal                  │
//│ 11 │ КопироватьВ                    │ copyTo                            │
//│ 12 │ РежимОтладки                   │ setDebug                          │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                          │
//│ 14 │ ПолучитьТипКласса              │ getClassType                      │
//│ 15 │ УстановитьТипКласса            │ setClassType                      │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                      │
//│ 17 │ УстановитьИмяКласса            │ setClassName                      │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                           │
//│ 19 │ УстановитьПрокси               │ setProxyValue                     │
//│ 20 │ УстановитьПроксиАутентификация │ setProxyAuth                      │
//│ 21 │ ОчиститьПрокси                 │ clearProxyValue                   │
//│ 22 │ ОтправитьGET                   │ sendGet                           │
//│ 23 │ ОтправитьPOST                  │ sendPost                          │
//│ 24 │ ОтправитьPOST_JSON             │ sendPostJson                      │
//│ 25 │ ОтправитьPUT                   │ sendPut                           │
//│ 26 │ ОтправитьDELETE                │ sendDelete                        │
//│ 27 │ СинхронныйGET                  │ syncGet                           │
//│ 28 │ СинхронныйPOST                 │ syncPost                          │
//│ 29 │ СинхронныйPOST_JSON            │ syncPostJson                      │
//│ 30 │ СинхронныйPUT                  │ syncPut                           │
//│ 31 │ СинхронныйDELETE               │ syncDelete                        │
//│ 32 │ УстановитьHTTPЗаголовок        │ setHttpHeader                     │
//│ 33 │ ОчиститьHTTPЗаголовки          │ clearHttpHeaders                  │
//│ 34 │ УстановитьHTTPТаймаут          │ setHttpTimeout                    │
//│ 35 │ ПолучитьHTTPТаймаут            │ getHttpTimeout                    │
//│ 36 │ Получить                       │ getValue                          │
//│ 37 │ ПолучитьСЗаголовками           │ getWithHeaders                    │
//│ 38 │ ОтправитьPost                  │ postValue                         │
//│ 39 │ ОтправитьPostJson              │ postJsonValue                     │
//│ 40 │ ОтправитьPut                   │ putValue                          │
//│ 41 │ Удалить                        │ deleteValue                       │
//│ 42 │ ПриЗавершении                  │ onFinishedValue                   │
//│ 43 │ ПриОшибкеSSL                   │ onSslErrorsValue                  │
//│ 44 │ ПолучитьМенеджер               │ getManager                        │
//│ 45 │ НетОшибки                      │ NoError                           │
//│ 46 │ ОтказВПодключении              │ ConnectionRefusedError            │
//│ 47 │ ХостЗакрылСоединение           │ RemoteHostClosedError             │
//│ 48 │ ХостНеНайден                   │ HostNotFoundError                 │
//│ 49 │ Таймаут                        │ TimeoutError                      │
//│ 50 │ ОперацияОтменена               │ OperationCanceledError            │
//│ 51 │ ОшибкаSSL                      │ SslHandshakeFailedError           │
//│ 52 │ ВременныйСбойСети              │ TemporaryNetworkFailureError      │
//│ 53 │ СбойСессииСети                 │ NetworkSessionFailedError         │
//│ 54 │ ФоновыйЗапросЗапрещен          │ BackgroundRequestNotAllowedError  │
//│ 55 │ СлишкомМногоПеренаправлений    │ TooManyRedirectsError             │
//│ 56 │ НебезопасноеПеренаправление    │ InsecureRedirectError             │
//│ 57 │ ТребуетсяАутентификацияПрокси  │ ProxyAuthenticationRequiredError  │
//│ 58 │ ДоступЗапрещен                 │ ContentAccessDenied               │
//│ 59 │ ОперацияЗапрещена              │ ContentOperationNotPermittedError │
//│ 60 │ КонтентНеНайден                │ ContentNotFoundError              │
//│ 61 │ ТребуетсяАутентификация        │ AuthenticationRequiredError       │
//│ 62 │ ПовторнаяОтправка              │ ContentReSendError                │
//│ 63 │ Конфликт                       │ ContentConflictError              │
//│ 64 │ КонтентУдален                  │ ContentGoneError                  │
//│ 65 │ ВнутренняяОшибкаСервера        │ InternalServerError               │
//│ 66 │ ОперацияНеРеализована          │ OperationNotImplementedError      │
//│ 67 │ СервисНедоступен               │ ServiceUnavailableError           │
//│ 68 │ НеизвестнаяОшибкаСети          │ UnknownNetworkError               │
//│ 69 │ НеизвестнаяОшибкаПрокси        │ UnknownProxyError                 │
//│ 70 │ НеизвестнаяОшибкаКонтента      │ UnknownContentError               │
//│ 71 │ СбойПротокола                  │ ProtocolFailure                   │
//│ 72 │ НеизвестнаяОшибкаСервера       │ UnknownServerError                │
//└─────┴────────────────────────────────┴───────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtNetworkManager (QtСетевойМенеджер) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    СетьМен1_1 = Новый QtСетевойМенеджер()
    СетьМен1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКОВ И ТАЙМАУТА =====
    Попытка
        СетьМен1_1.УстановитьHTTPЗаголовок("X-Custom-Header", "TestValue")
        СетьМен1_1.УстановитьHTTPТаймаут(5000)
        таймаут = СетьМен1_1.ПолучитьHTTPТаймаут()
        ВывестиСтрокуВКонсоль("    УстановитьHTTPЗаголовок(): УСПЕШНО")
        ВывестиСтрокуВКонсоль("    УстановитьHTTPТаймаут(5000) -> ПолучитьHTTPТаймаут(): " + таймаут + " (ожидается 5000)")
        СетьМен1_1.ОчиститьHTTPЗаголовки()
        ВывестиСтрокуВКонсоль("    ОчиститьHTTPЗаголовки(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Настройка заголовков/таймаута: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 3. СИНХРОННЫЙ GET =====
    Попытка
        результат = СетьМен1_1.СинхронныйGET("http://httpbin.org/get")
        ВывестиСтрокуВКонсоль("    СинхронныйGET(): длина ответа " + результат.length + " (ожидается > 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    СинхронныйGET(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. СИНХРОННЫЙ POST =====
    Попытка
        результат = СетьМен1_1.СинхронныйPOST("http://httpbin.org/post", "key1=value1&key2=value2")
        ВывестиСтрокуВКонсоль("    СинхронныйPOST(): длина ответа " + resultado.length + " (ожидается > 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    СинхронныйPOST(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. АСИНХРОННЫЙ GET =====
    асинхронныйОтвет = ""
    Попытка
        СетьМен1_1.ОтправитьGET("http://httpbin.org/get", function(успех, ошибка, данные, код) {
            Если успех Тогда
                асинхронныйОтвет = данные
                ВывестиСтрокуВКонсоль("    Асинхронный GET: УСПЕШНО (длина " + данные.length + ")")
            Иначе
                ВывестиСтрокуВКонсоль("    Асинхронный GET: ОШИБКА - " + ошибка)
            КонецЕсли
        })
        Пауза(2000)
        ВывестиСтрокуВКонсоль("    ОтправитьGET(): отправлен (ожидание ответа)")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьGET(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. АСИНХРОННЫЙ POST =====
    асинхронныйОтвет2 = ""
    Попытка
        СетьМен1_1.ОтправитьPOST("http://httpbin.org/post", "test=data", function(успех, ошибка, данные, код) {
            Если успех Тогда
                асинхронныйОтвет2 = данные
                ВывестиСтрокуВКонсоль("    Асинхронный POST: УСПЕШНО (длина " + данные.length + ")")
            Иначе
                ВывестиСтрокуВКонсоль("    Асинхронный POST: ОШИБКА - " + ошибка)
            КонецЕсли
        })
        Пауза(2000)
        ВывестиСтрокуВКонсоль("    ОтправитьPOST(): отправлен (ожидание ответа)")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьPOST(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. АСИНХРОННЫЙ POST JSON =====
    асинхронныйОтвет3 = ""
    Попытка
        jsonData = '{"name":"John","age":30}'
        СетьМен1_1.ОтправитьPOST_JSON("http://httpbin.org/post", jsonData, function(успех, ошибка, данные, код) {
            Если успех Тогда
                асинхронныйОтвет3 = данные
                ВывестиСтрокуВКонсоль("    Асинхронный POST JSON: УСПЕШНО (длина " + данные.length + ")")
            Иначе
                ВывестиСтрокуВКонсоль("    Асинхронный POST JSON: ОШИБКА - " + ошибка)
            КонецЕсли
        })
        Пауза(2000)
        ВывестиСтрокуВКонсоль("    ОтправитьPOST_JSON(): отправлен (ожидание ответа)")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьPOST_JSON(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 8. НАСТРОЙКА ПРОКСИ =====
    Попытка
        СетьМен1_1.УстановитьПрокси("127.0.0.1", 8080)
        ВывестиСтрокуВКонсоль("    УстановитьПрокси('127.0.0.1', 8080): УСПЕШНО")
        СетьМен1_1.ОчиститьПрокси()
        ВывестиСтрокуВКонсоль("    ОчиститьПрокси(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Настройка прокси: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. RUSFUNC =====
    Если typeof СетьМен1_1.RusFunc === 'function' Тогда
        jsonStr = СетьМен1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtNetworkManager (QtСетевойМенеджер) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБлокировкаЧтенияЗаписи()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                            │ Английский метод                │
//├─────┼──────────────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                             │ isValid                        │
//│ 2 │ ПолучитьОбъект                           │ getRealObject                  │
//│ 3 │ УстановитьРодителя                       │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                         │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта                     │ setObjectName                  │
//│ 6 │ ИмяОбъекта                               │ objectName                     │
//│ 7 │ УстановитьСвойство                       │ setProperty                    │
//│ 8 │ Свойство                                 │ property                       │
//│ 9 │ ПодключитьСигнал                         │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                          │ disconnectSignal               │
//│ 11 │ КопироватьВ                              │ copyTo                         │
//│ 12 │ РежимОтладки                             │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки                     │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                        │ getClassType                   │
//│ 15 │ УстановитьТипКласса                      │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                        │ getClassName                   │
//│ 17 │ УстановитьИмяКласса                      │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов                    │ RusFunc                        │
//│ 19 │ ПолучитьБлокировку                       │ getRealLock                    │
//│ 20 │ ПолучитьОбъект                           │ getRealObject                  │
//│ 21 │ Нерекурсивный                            │ nonRecursive                   │
//│ 22 │ Рекурсивный                              │ recursive                      │
//│ 23 │ РекурсивнаяБлокировка                    │ isRecursive                    │
//│ 24 │ ЗаблокироватьДляЧтения                   │ lockForRead                    │
//│ 25 │ ПопробоватьЗаблокироватьДляЧтения        │ tryLockForRead                 │
//│ 26 │ ПопробоватьЗаблокироватьДляЧтенияТаймаут │ tryLockForReadTimeout          │
//│ 27 │ ЗаблокироватьДляЗаписи                   │ lockForWrite                   │
//│ 28 │ ПопробоватьЗаблокироватьДляЗаписи        │ tryLockForWrite                │
//│ 29 │ ПопробоватьЗаблокироватьДляЗаписиТаймаут │ tryLockForWriteTimeout         │
//│ 30 │ Разблокировать                           │ unlock                         │
//│ 31 │ РазблокироватьЧтение                     │ unlockRead                     │
//│ 32 │ РазблокироватьЗапись                     │ unlockWrite                    │
//│ 33 │ КоличествоБлокировок                     │ lockCount                      │
//│ 34 │ КоличествоБлокировокЧтения               │ readLockCount                  │
//│ 35 │ КоличествоБлокировокЗаписи               │ writeLockCount                 │
//│ 36 │ ЗаблокированДляЧтения                    │ isLockedForRead                │
//│ 37 │ ЗаблокированДляЗаписи                    │ isLockedForWrite               │
//│ 38 │ Заблокирован                             │ isLocked                       │
//│ 39 │ Действителен                             │ isValid                        │
//│ 40 │ КопироватьВ                              │ copyTo                         │
//│ 41 │ РежимОтладки                             │ setDebug                       │
//│ 42 │ ПолучитьРежимОтладки                     │ getDebug                       │
//│ 43 │ УстановитьИмяОбъекта                     │ setObjectName                  │
//│ 44 │ ИмяОбъекта                               │ objectName                     │
//└─────┴──────────────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtReadWriteLock (QtБлокировкаЧтенияЗаписи) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    БлокЧт1_1 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = БлокЧт1_1.isValid()
    валидныйРус = БлокЧт1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = БлокЧт1_1.isRecursive()
    рекурсивныйРус = БлокЧт1_1.РекурсивнаяБлокировка()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивнаяБлокировка(): " + рекурсивныйРус + " (ожидается false)")
    
    // ===== 4. БЛОКИРОВКА ДЛЯ ЧТЕНИЯ =====
    Попытка
        БлокЧт1_1.lockForRead()
        БлокЧт1_1.unlock()
        ВывестиСтрокуВКонсоль("    lockForRead/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lockForRead/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        БлокЧт1_1.ЗаблокироватьДляЧтения()
        БлокЧт1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЧтения/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЧтения/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. БЛОКИРОВКА ДЛЯ ЗАПИСИ =====
    Попытка
        БлокЧт1_1.lockForWrite()
        БлокЧт1_1.unlock()
        ВывестиСтрокуВКонсоль("    lockForWrite/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lockForWrite/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        БлокЧт1_1.ЗаблокироватьДляЗаписи()
        БлокЧт1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЗаписи/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ЗаблокироватьДляЗаписи/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЧТЕНИЯ =====
    результат1 = БлокЧт1_1.tryLockForRead()
    Если результат1 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат2 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЧтения()
    Если результат2 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForRead(): " + результат1 + ", ПопробоватьЗаблокироватьДляЧтения(): " + результат2 + " (ожидается true)")
    
    // ===== 7. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЗАПИСИ =====
    результат3 = БлокЧт1_1.tryLockForWrite()
    Если результат3 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат4 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЗаписи()
    Если результат4 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForWrite(): " + результат3 + ", ПопробоватьЗаблокироватьДляЗаписи(): " + результат4 + " (ожидается true)")
    
    // ===== 8. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЧТЕНИЯ С ТАЙМАУТОМ =====
    результат5 = БлокЧт1_1.tryLockForReadTimeout(100)
    Если результат5 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат6 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЧтенияТаймаут(100)
    Если результат6 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForReadTimeout(100): " + результат5 + ", ПопробоватьЗаблокироватьДляЧтенияТаймаут(100): " + результат6 + " (ожидается true)")
    
    // ===== 9. ПОПЫТКА БЛОКИРОВКИ ДЛЯ ЗАПИСИ С ТАЙМАУТОМ =====
    результат7 = БлокЧт1_1.tryLockForWriteTimeout(100)
    Если результат7 == ИСТИНА Тогда
        БлокЧт1_1.unlock()
    КонецЕсли
    результат8 = БлокЧт1_1.ПопробоватьЗаблокироватьДляЗаписиТаймаут(100)
    Если результат8 == ИСТИНА Тогда
        БлокЧт1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockForWriteTimeout(100): " + результат7 + ", ПопробоватьЗаблокироватьДляЗаписиТаймаут(100): " + результат8 + " (ожидается true)")
    
    // ===== 10. КОНСТАНТЫ =====
    нерек = БлокЧт1_1.nonRecursive()
    рек = БлокЧт1_1.recursive()
    нерекРус = БлокЧт1_1.Нерекурсивный()
    рекРус = БлокЧт1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 11. РЕКУРСИВНАЯ БЛОКИРОВКА =====
    БлокЧт1_2 = Новый QtБлокировкаЧтенияЗаписи(1)
    БлокЧт1_2.РежимОтладки(Режим_Отладки)
    рек2 = БлокЧт1_2.isRecursive()
    рекРус2 = БлокЧт1_2.РекурсивнаяБлокировка()
    ВывестиСтрокуВКонсоль("    Рекурсивная блокировка -> isRecursive(): " + рек2 + ", РекурсивнаяБлокировка(): " + рекРус2 + " (ожидается true)")
    
    // ===== 12. КОПИРОВАНИЕ =====
    БлокЧт1_3 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_3.РежимОтладки(Режим_Отладки)
    БлокЧт1_3.ЗаблокироватьДляЧтения()
    БлокЧт1_4 = Новый QtБлокировкаЧтенияЗаписи()
    БлокЧт1_4.РежимОтладки(Режим_Отладки)
    результатКопия = БлокЧт1_3.КопироватьВ(БлокЧт1_4)
    БлокЧт1_3.Разблокировать()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопия + " (ожидается true)")
    
    // ===== 13. RUSFUNC =====
    Если typeof БлокЧт1_1.RusFunc === 'function' Тогда
        jsonStr = БлокЧт1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtReadWriteLock (QtБлокировкаЧтенияЗаписи) завершён.===================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtМьютекс()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬─────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                   │ Английский метод                │
//├─────┼─────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                    │ isValid                        │
//│ 2 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 3 │ УстановитьРодителя              │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 6 │ ИмяОбъекта                      │ objectName                     │
//│ 7 │ УстановитьСвойство              │ setProperty                    │
//│ 8 │ Свойство                        │ property                       │
//│ 9 │ ПодключитьСигнал                │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                 │ disconnectSignal               │
//│ 11 │ КопироватьВ                     │ copyTo                         │
//│ 12 │ РежимОтладки                    │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 14 │ ПолучитьТипКласса               │ getClassType                   │
//│ 15 │ УстановитьТипКласса             │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса               │ getClassName                   │
//│ 17 │ УстановитьИмяКласса             │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов           │ RusFunc                        │
//│ 19 │ ПолучитьМьютекс                 │ getRealMutex                   │
//│ 20 │ ПолучитьРекурсивныйМьютекс      │ getRealRecursiveMutex          │
//│ 21 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 22 │ Нерекурсивный                   │ nonRecursive                   │
//│ 23 │ Рекурсивный                     │ recursive                      │
//│ 24 │ РекурсивныйМьютекс              │ isRecursive                    │
//│ 25 │ Заблокировать                   │ lock                           │
//│ 26 │ ПопробоватьЗаблокировать        │ tryLock                        │
//│ 27 │ ПопробоватьЗаблокироватьТаймаут │ tryLockTimeout                 │
//│ 28 │ Разблокировать                  │ unlock                         │
//│ 29 │ Заблокирован                    │ isLocked                       │
//│ 30 │ КоличествоБлокировок            │ lockCount                      │
//│ 31 │ Действителен                    │ isValid                        │
//│ 32 │ КопироватьВ                     │ copyTo                         │
//│ 33 │ РежимОтладки                    │ setDebug                       │
//│ 34 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 35 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 36 │ ИмяОбъекта                      │ objectName                     │
//└─────┴─────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtMutex (QtМьютекс) - КОМПАКТНАЯ ВЕРСИЯ ========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА (НЕРЕКУРСИВНЫЙ) =====
    Мьютекс1_1 = Новый QtМьютекс()
    Мьютекс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта (нерекурсивный): УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Мьютекс1_1.isValid()
    валидныйРус = Мьютекс1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = Мьютекс1_1.isRecursive()
    рекурсивныйРус = Мьютекс1_1.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивныйМьютекс(): " + рекурсивныйРус + " (ожидается false)")
    
    // ===== 4. БЛОКИРОВКА И РАЗБЛОКИРОВКА =====
    Попытка
        Мьютекс1_1.lock()
        Мьютекс1_1.unlock()
        ВывестиСтрокуВКонсоль("    lock/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lock/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Мьютекс1_1.Заблокировать()
        Мьютекс1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    Заблокировать/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Заблокировать/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОПЫТКА БЛОКИРОВКИ =====
    результат1 = Мьютекс1_1.tryLock()
    Если результат1 == ИСТИНА Тогда
        Мьютекс1_1.unlock()
    КонецЕсли
    результат2 = Мьютекс1_1.ПопробоватьЗаблокировать()
    Если результат2 == ИСТИНА Тогда
        Мьютекс1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLock(): " + результат1 + ", ПопробоватьЗаблокировать(): " + результат2 + " (ожидается true)")
    
    // ===== 6. ПОПЫТКА БЛОКИРОВКИ С ТАЙМАУТОМ =====
    результат3 = Мьютекс1_1.tryLockTimeout(100)
    Если результат3 == ИСТИНА Тогда
        Мьютекс1_1.unlock()
    КонецЕсли
    результат4 = Мьютекс1_1.ПопробоватьЗаблокироватьТаймаут(100)
    Если результат4 == ИСТИНА Тогда
        Мьютекс1_1.Разблокировать()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    tryLockTimeout(100): " + результат3 + ", ПопробоватьЗаблокироватьТаймаут(100): " + результат4 + " (ожидается true)")
    
    // ===== 7. КОНСТАНТЫ =====
    нерек = Мьютекс1_1.nonRecursive()
    рек = Мьютекс1_1.recursive()
    нерекРус = Мьютекс1_1.Нерекурсивный()
    рекРус = Мьютекс1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 8. РЕКУРСИВНЫЙ МЬЮТЕКС =====
    Мьютекс1_2 = Новый QtМьютекс(1)
    Мьютекс1_2.РежимОтладки(Режим_Отладки)
    Мьютекс1_2.lock()
    Мьютекс1_2.lock()
    Мьютекс1_2.unlock()
    Мьютекс1_2.unlock()
    рек2 = Мьютекс1_2.isRecursive()
    рекРус2 = Мьютекс1_2.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    Рекурсивный мьютекс -> isRecursive(): " + рек2 + ", РекурсивныйМьютекс(): " + рекРус2 + " (ожидается true)")
    
    // ===== 9. КОПИРОВАНИЕ =====
    Мьютекс1_3 = Новый QtМьютекс()
    Мьютекс1_3.РежимОтладки(Режим_Отладки)
    результатКопия = Мьютекс1_1.copyTo(Мьютекс1_3)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Мьютекс1_4 = Новый QtМьютекс()
    Мьютекс1_4.РежимОтладки(Режим_Отладки)
    результатКопияРус = Мьютекс1_1.КопироватьВ(Мьютекс1_4)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // Проверяем валидность копии
    валидныйКопия = Мьютекс1_3.isValid()
    валидныйКопияРус = Мьютекс1_4.Действителен()
    ВывестиСтрокуВКонсоль("    Копия isValid(): " + валидныйКопия + ", Копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 10. RUSFUNC =====
    Если typeof Мьютекс1_1.RusFunc === 'function' Тогда
        jsonStr = Мьютекс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtMutex (QtМьютекс) завершён.===========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtНаблюдательБудущего()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьНаблюдателя            │ getRealWatcher                 │
//│ 20 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 21 │ УстановитьБудущее              │ setFuture                      │
//│ 22 │ ОжидатьЗавершения              │ waitForFinished                │
//│ 23 │ Отменить                       │ cancel                         │
//│ 24 │ Приостановить                  │ pause                          │
//│ 25 │ Возобновить                    │ resume                         │
//│ 26 │ Выполняется                    │ isRunning                      │
//│ 27 │ Завершён                       │ isFinished                     │
//│ 28 │ Запущен                        │ isStarted                      │
//│ 29 │ Отменён                        │ isCanceled                     │
//│ 30 │ Приостановлен                  │ isPaused                       │
//│ 31 │ Прогресс                       │ progressValue                  │
//│ 32 │ ПрогрессМинимум                │ progressMinimum                │
//│ 33 │ ПрогрессМаксимум               │ progressMaximum                │
//│ 34 │ ТекстПрогресса                 │ progressText                   │
//│ 35 │ КоличествоРезультатов          │ resultCount                    │
//│ 36 │ РезультатГотов                 │ isResultReady                  │
//│ 37 │ ПриЗапуске                     │ onStarted                      │
//│ 38 │ ПриЗавершении                  │ onFinished                     │
//│ 39 │ ПриОтмене                      │ onCanceled                     │
//│ 40 │ ПриПаузе                       │ onPaused                       │
//│ 41 │ ПриВозобновлении               │ onResumed                      │
//│ 42 │ ПриИзмененииДиапазонаПрогресса │ onProgressRangeChanged         │
//│ 43 │ ПриИзмененииПрогресса          │ onProgressValueChanged         │
//│ 44 │ ПриИзмененииТекстаПрогресса    │ onProgressTextChanged          │
//│ 45 │ ПриГотовностиРезультата        │ onResultReadyAt                │
//│ 46 │ ПриГотовностиРезультатов       │ onResultsReady                 │
//│ 47 │ Действителен                   │ isValid                        │
//│ 48 │ КопироватьВ                    │ copyTo                         │
//│ 49 │ РежимОтладки                   │ setDebug                       │
//│ 50 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 51 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 52 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtFutureWatcher (QtНаблюдательБудущего) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Набл1_1 = Новый QtНаблюдательБудущего()
    Набл1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Набл1_1.isValid()
    валидныйРус = Набл1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. СОСТОЯНИЕ НОВОГО НАБЛЮДАТЕЛЯ =====
    запущен = Набл1_1.isStarted()
    выполняется = Набл1_1.isRunning()
    завершён = Набл1_1.isFinished()
    запущенРус = Набл1_1.Запущен()
    выполняетсяРус = Набл1_1.Выполняется()
    завершёнРус = Набл1_1.Завершён()
    ВывестиСтрокуВКонсоль("    isStarted(): " + запущен + ", isRunning(): " + выполняется + ", isFinished(): " + завершён + " (ожидается true, false, true)")
    ВывестиСтрокуВКонсоль("    Запущен(): " + запущенРус + ", Выполняется(): " + выполняетсяРус + ", Завершён(): " + завершёнРус + " (ожидается true, false, true)")
    
    // ===== 4. ПРОГРЕСС =====
    мин = Набл1_1.progressMinimum()
    макс = Набл1_1.progressMaximum()
    значение = Набл1_1.progressValue()
    текст = Набл1_1.progressText()
    минРус = Набл1_1.ПрогрессМинимум()
    максРус = Набл1_1.ПрогрессМаксимум()
    значениеРус = Набл1_1.Прогресс()
    текстРус = Набл1_1.ТекстПрогресса()
    ВывестиСтрокуВКонсоль("    progressMinimum(): " + мин + ", progressMaximum(): " + макс + ", progressValue(): " + значение + ", progressText(): '" + текст + "'")
    ВывестиСтрокуВКонсоль("    ПрогрессМинимум(): " + минРус + ", ПрогрессМаксимум(): " + максРус + ", Прогресс(): " + значениеРус + ", ТекстПрогресса(): '" + текстРус + "'")
    
    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО НАБЛЮДАТЕЛЯ =====
    реальный = Набл1_1.getRealWatcher()
    реальныйРус = Набл1_1.ПолучитьНаблюдателя()
    ВывестиСтрокуВКонсоль("    getRealWatcher(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьНаблюдателя(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. УСТАНОВКА КОЛБЭКОВ =====
    Попытка
        Набл1_1.onStarted(function() {
            // Пустой колбэк
        })
        Набл1_1.onFinished(function() {
            // Пустой колбэк
        })
        Набл1_1.onProgressValueChanged(function(value) {
            // Пустой колбэк
        })
        ВывестиСтрокуВКонсоль("    onStarted(), onFinished(), onProgressValueChanged(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    onStarted/onFinished/onProgressValueChanged: ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Набл1_1.ПриЗапуске(function() {
            // Пустой колбэк
        })
        Набл1_1.ПриЗавершении(function() {
            // Пустой колбэк
        })
        Набл1_1.ПриИзмененииПрогресса(function(value) {
            // Пустой колбэк
        })
        ВывестиСтрокуВКонсоль("    ПриЗапуске(), ПриЗавершении(), ПриИзмененииПрогресса(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ПриЗапуске/ПриЗавершении/ПриИзмененииПрогресса: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. КОПИРОВАНИЕ =====
    Набл1_2 = Новый QtНаблюдательБудущего()
    Набл1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Набл1_1.copyTo(Набл1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Набл1_3 = Новый QtНаблюдательБудущего()
    Набл1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Набл1_1.КопироватьВ(Набл1_3)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // Проверяем валидность копии
    валидныйКопия = Набл1_2.isValid()
    валидныйКопияРус = Набл1_3.Действителен()
    ВывестиСтрокуВКонсоль("    Копия isValid(): " + валидныйКопия + ", Копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof Набл1_1.RusFunc === 'function' Тогда
        jsonStr = Набл1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtFutureWatcher (QtНаблюдательБудущего) завершён.=====================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПараллельный()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬─────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                   │ Английский метод                │
//├─────┼─────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                    │ isValid                        │
//│ 2 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 3 │ УстановитьРодителя              │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 6 │ ИмяОбъекта                      │ objectName                     │
//│ 7 │ УстановитьСвойство              │ setProperty                    │
//│ 8 │ Свойство                        │ property                       │
//│ 9 │ ПодключитьСигнал                │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                 │ disconnectSignal               │
//│ 11 │ КопироватьВ                     │ copyTo                         │
//│ 12 │ РежимОтладки                    │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 14 │ ПолучитьТипКласса               │ getClassType                   │
//│ 15 │ УстановитьТипКласса             │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса               │ getClassName                   │
//│ 17 │ УстановитьИмяКласса             │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов           │ RusFunc                        │
//│ 19 │ ЗапуститьАсинхронно             │ runAsync                       │
//│ 20 │ ЗапуститьАсинхронноСАргументом  │ runAsyncWithArg                │
//│ 21 │ ЗапуститьАсинхронноСАргументами │ runAsyncWithArgs               │
//│ 22 │ ОбработатьМассив                │ processArray                   │
//│ 23 │ ОбработатьМассивСРезультатом    │ processArrayWithResult         │
//│ 24 │ ОбработатьМассивПараллельно     │ processArrayParallel           │
//│ 25 │ УстановитьМаксимумПотоков       │ setMaxThreadCount              │
//│ 26 │ МаксимумПотоков                 │ maxThreadCount                 │
//│ 27 │ Действителен                    │ isValid                        │
//│ 28 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 29 │ КопироватьВ                     │ copyTo                         │
//│ 30 │ РежимОтладки                    │ setDebug                       │
//│ 31 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 32 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 33 │ ИмяОбъекта                      │ objectName                     │
//└─────┴─────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtConcurrentRunner (QtПараллельный) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Парал1_1 = Новый QtПараллельный()
    Парал1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Парал1_1.isValid()
    валидныйРус = Парал1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ЗАПУСК АСИНХРОННО =====
    выполнено = ЛОЖЬ
    функция1 = function() {
        выполнено = ИСТИНА
    }
    watcher1 = Парал1_1.runAsync(функция1)
    Если watcher1 != null Тогда
        watcher1.waitForFinished()
    КонецЕсли
    
    выполненоРус = ЛОЖЬ
    функцияРус = function() {        выполненоРус = ИСТИНА    }
    watcher2 = Парал1_1.ЗапуститьАсинхронно(функцияРус)
    Если watcher2 != null Тогда
        watcher2.waitForFinished()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("    runAsync(): " + (выполнено == ИСТИНА ? "УСПЕШНО" : "НЕ ВЫПОЛНЕНО") + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ЗапуститьАсинхронно(): " + (выполненоРус == ИСТИНА ? "УСПЕШНО" : "НЕ ВЫПОЛНЕНО") + " (ожидается true)")
    
    // ===== 4. ОБРАБОТКА МАССИВА =====
    обработаноИндексов = 0
    массив = [1, 2, 3, 4, 5]
    функцияМассив = function(item, index) {        обработаноИндексов = обработаноИндексов + 1    }
    watcher3 = Парал1_1.processArray(массив, функцияМассив)
    Если watcher3 != null Тогда
        watcher3.waitForFinished()
    КонецЕсли
    ВывестиСтрокуВКонсоль("    processArray(): обработано " + обработаноИндексов + " элементов (ожидается 5)")
    
    обработаноИндексовРус = 0
    массивРус = [10, 20, 30, 40, 50]
    функцияМассивРус = function(item, index) {        обработаноИндексовРус = обработаноИндексовРус + 1    }
    watcher4 = Парал1_1.ОбработатьМассив(массивРус, функцияМассивРус)
    Если watcher4 != null Тогда
        watcher4.waitForFinished()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("    ОбработатьМассив(): обработано " + обработаноИндексовРус + " элементов (ожидается 5)")
    
    // ===== 5. КОПИРОВАНИЕ =====
    Парал1_2 = Новый QtПараллельный()
    Парал1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Парал1_1.copyTo(Парал1_2)
    валидныйКопия = Парал1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): , копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Парал1_3 = Новый QtПараллельный()
    Парал1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Парал1_1.КопироватьВ(Парал1_3)
    валидныйКопияРус = Парал1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 6. RUSFUNC =====
    Если typeof Парал1_1.RusFunc === 'function' Тогда
        jsonStr = Парал1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("==== Тест QtConcurrentRunner (QtПараллельный) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtРекурсивныйМьютекс()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬─────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                   │ Английский метод                │
//├─────┼─────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                    │ isValid                        │
//│ 2 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 3 │ УстановитьРодителя              │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 6 │ ИмяОбъекта                      │ objectName                     │
//│ 7 │ УстановитьСвойство              │ setProperty                    │
//│ 8 │ Свойство                        │ property                       │
//│ 9 │ ПодключитьСигнал                │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                 │ disconnectSignal               │
//│ 11 │ КопироватьВ                     │ copyTo                         │
//│ 12 │ РежимОтладки                    │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 14 │ ПолучитьТипКласса               │ getClassType                   │
//│ 15 │ УстановитьТипКласса             │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса               │ getClassName                   │
//│ 17 │ УстановитьИмяКласса             │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов           │ RusFunc                        │
//│ 19 │ ПолучитьМьютекс                 │ getRealMutex                   │
//│ 20 │ ПолучитьРекурсивныйМьютекс      │ getRealRecursiveMutex          │
//│ 21 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 22 │ Нерекурсивный                   │ nonRecursive                   │
//│ 23 │ Рекурсивный                     │ recursive                      │
//│ 24 │ РекурсивныйМьютекс              │ isRecursive                    │
//│ 25 │ Заблокировать                   │ lock                           │
//│ 26 │ ПопробоватьЗаблокировать        │ tryLock                        │
//│ 27 │ ПопробоватьЗаблокироватьТаймаут │ tryLockTimeout                 │
//│ 28 │ Разблокировать                  │ unlock                         │
//│ 29 │ Заблокирован                    │ isLocked                       │
//│ 30 │ КоличествоБлокировок            │ lockCount                      │
//│ 31 │ Действителен                    │ isValid                        │
//│ 32 │ КопироватьВ                     │ copyTo                         │
//│ 33 │ РежимОтладки                    │ setDebug                       │
//│ 34 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 35 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 36 │ ИмяОбъекта                      │ objectName                     │
//│ 37 │ ПолучитьРекурсивныйМьютекс      │ getRealRecursiveMutex          │
//│ 38 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 39 │ Заблокировать                   │ lock                           │
//│ 40 │ ПопробоватьЗаблокировать        │ tryLock                        │
//│ 41 │ ПопробоватьЗаблокироватьТаймаут │ tryLockTimeout                 │
//│ 42 │ Разблокировать                  │ unlock                         │
//│ 43 │ Заблокирован                    │ isLocked                       │
//│ 44 │ КоличествоБлокировок            │ lockCount                      │
//│ 45 │ Действителен                    │ isValid                        │
//│ 46 │ КопироватьВ                     │ copyTo                         │
//│ 47 │ РежимОтладки                    │ setDebug                       │
//│ 48 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 49 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 50 │ ИмяОбъекта                      │ objectName                     │
//│ 51 │ РекурсивныйМьютекс              │ isRecursive                    │
//└─────┴─────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtRecursiveMutex (QtРекурсивныйМьютекс) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Рекурс1_1 = Новый QtРекурсивныйМьютекс()
    Рекурс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Рекурс1_1.isValid()
    валидныйРус = Рекурс1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    рекурсивный = Рекурс1_1.isRecursive()
    рекурсивныйРус = Рекурс1_1.РекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    isRecursive(): " + рекурсивный + ", РекурсивныйМьютекс(): " + рекурсивныйРус + " (ожидается true)")
    
    // ===== 4. МНОЖЕСТВЕННАЯ БЛОКИРОВКА (РЕКУРСИВНАЯ) =====
    Попытка
        Рекурс1_1.lock()
        Рекурс1_1.lock()
        Рекурс1_1.unlock()
        Рекурс1_1.unlock()
        ВывестиСтрокуВКонсоль("    lock/lock/unlock/unlock(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    lock/lock/unlock/unlock(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Рекурс1_1.Заблокировать()
        Рекурс1_1.Заблокировать()
        Рекурс1_1.Разблокировать()
        Рекурс1_1.Разблокировать()
        ВывестиСтрокуВКонсоль("    Заблокировать/Заблокировать/Разблокировать/Разблокировать(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Заблокировать/Заблокировать/Разблокировать/Разблокировать(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО РЕКУРСИВНОГО МЬЮТЕКСА =====
    реальный = Рекурс1_1.getRealRecursiveMutex()
    реальныйРус = Рекурс1_1.ПолучитьРекурсивныйМьютекс()
    ВывестиСтрокуВКонсоль("    getRealRecursiveMutex(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРекурсивныйМьютекс(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. КОНСТАНТЫ =====
    нерек = Рекурс1_1.nonRecursive()
    рек = Рекурс1_1.recursive()
    нерекРус = Рекурс1_1.Нерекурсивный()
    рекРус = Рекурс1_1.Рекурсивный()
    ВывестиСтрокуВКонсоль("    nonRecursive(): " + нерек + ", recursive(): " + рек + " (ожидается 0, 1)")
    ВывестиСтрокуВКонсоль("    Нерекурсивный(): " + нерекРус + ", Рекурсивный(): " + рекРус + " (ожидается 0, 1)")
    
    // ===== 7. КОПИРОВАНИЕ =====
    Рекурс1_2 = Новый QtРекурсивныйМьютекс()
    Рекурс1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Рекурс1_1.copyTo(Рекурс1_2)
    валидныйКопия = Рекурс1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Рекурс1_3 = Новый QtРекурсивныйМьютекс()
    Рекурс1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Рекурс1_1.КопироватьВ(Рекурс1_3)
    валидныйКопияРус = Рекурс1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof Рекурс1_1.RusFunc === 'function' Тогда
        jsonStr = Рекурс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
   
    ВывестиСтрокуВКонсоль("==== Тест QtRecursiveMutex (QtРекурсивныйМьютекс) завершён.======================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСемафор()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьСемафор                │ getRealSemaphore               │
//│ 20 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 21 │ Захватить                      │ acquire                        │
//│ 22 │ ПопробоватьЗахватить           │ tryAcquire                     │
//│ 23 │ ПопробоватьЗахватитьТаймаут    │ tryAcquireTimeout              │
//│ 24 │ Освободить                     │ release                        │
//│ 25 │ ОсвободитьВсе                  │ releaseAll                     │
//│ 26 │ Доступно                       │ available                      │
//│ 27 │ Емкость                        │ capacity                       │
//│ 28 │ УстановитьЕмкость              │ setCapacity                    │
//│ 29 │ КоличествоЗахватов             │ acquireCount                   │
//│ 30 │ Пустой                         │ isEmpty                        │
//│ 31 │ Полный                         │ isFull                         │
//│ 32 │ КоличествоОжидающих            │ waitingCount                   │
//│ 33 │ Действителен                   │ isValid                        │
//│ 34 │ КопироватьВ                    │ copyTo                         │
//│ 35 │ РежимОтладки                   │ setDebug                       │
//│ 36 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 37 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 38 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSemaphore (QtСемафор) - КОМПАКТНАЯ ВЕРСИЯ ====================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Семаф1_1 = Новый QtСемафор()
    Семаф1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Семаф1_1.isValid()
    валидныйРус = Семаф1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ДОСТУПНО РЕСУРСОВ =====
    доступно = Семаф1_1.available()
    доступноРус = Семаф1_1.Доступно()
    ВывестиСтрокуВКонсоль("    available(): " + доступно + ", Доступно(): " + доступноРус + " (ожидается 0)")
    
    // ===== 4. ОСВОБОЖДЕНИЕ РЕСУРСОВ =====
    Попытка
        Семаф1_1.release()
        Семаф1_1.release(2)
        доступно = Семаф1_1.available()
        ВывестиСтрокуВКонсоль("    release() + release(2) -> available(): " + доступно + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    release(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Семаф1_1.Освободить()
        Семаф1_1.Освободить(2)
        доступноРус = Семаф1_1.Доступно()
        ВывестиСтрокуВКонсоль("    Освободить() + Освободить(2) -> Доступно(): " + доступноРус + " (ожидается 6)")
    Исключение
        ВывестиСтрокуВКонсоль("    Освободить(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ЗАХВАТ РЕСУРСОВ =====
    Попытка
        Семаф1_1.acquire()
        Семаф1_1.acquire(2)
        доступно = Семаф1_1.available()
        ВывестиСтрокуВКонсоль("    acquire() + acquire(2) -> available(): " + доступно + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    acquire(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        Семаф1_1.Захватить()
        Семаф1_1.Захватить(2)
        доступноРус = Семаф1_1.Доступно()
        ВывестиСтрокуВКонсоль("    Захватить() + Захватить(2) -> Доступно(): " + доступноРус + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("    Захватить(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. ПОПЫТКА ЗАХВАТА =====
    Семаф1_1.release(3)
    результат = Семаф1_1.tryAcquire()
    ВывестиСтрокуВКонсоль("    tryAcquire(): " + результат + " (ожидается true)")
    Семаф1_1.Освободить(3)
    результатРус = Семаф1_1.ПопробоватьЗахватить()
    ВывестиСтрокуВКонсоль("    ПопробоватьЗахватить(): " + результатРус + " (ожидается true)")
    
    // ===== 7. ПОПЫТКА ЗАХВАТА С ТАЙМАУТОМ =====
    Семаф1_1.release(2)
    результат = Семаф1_1.tryAcquireTimeout(1, 100)
    ВывестиСтрокуВКонсоль("    tryAcquireTimeout(1,100): " + результат + " (ожидается true)")
    Семаф1_1.Освободить(2)
    результатРус = Семаф1_1.ПопробоватьЗахватитьТаймаут(1, 100)
    ВывестиСтрокуВКонсоль("    ПопробоватьЗахватитьТаймаут(1,100): " + результатРус + " (ожидается true)")
    
    // ===== 8. СОЗДАНИЕ С НАЧАЛЬНЫМ ЗНАЧЕНИЕМ =====
    Семаф1_2 = Новый QtСемафор(5)
    Семаф1_2.РежимОтладки(Режим_Отладки)
    доступно2 = Семаф1_2.available()
    ВывестиСтрокуВКонсоль("    QtSemaphore(5) -> available(): " + доступно2 + " (ожидается 5)")
    
    Семаф1_3 = Новый QtСемафор(10)
    Семаф1_3.РежимОтладки(Режим_Отладки)
    доступноРус2 = Семаф1_3.Доступно()
    ВывестиСтрокуВКонсоль("    QtСемафор(10) -> Доступно(): " + доступноРус2 + " (ожидается 10)")
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СЕМАФОРА =====
    реальный = Семаф1_1.getRealSemaphore()
    реальныйРус = Семаф1_1.ПолучитьСемафор()
    ВывестиСтрокуВКонсоль("    getRealSemaphore(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьСемафор(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    Семаф1_4 = Новый QtСемафор()
    Семаф1_4.РежимОтладки(Режим_Отладки)
    результатКопия = Семаф1_1.copyTo(Семаф1_4)
    валидныйКопия = Семаф1_4.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Семаф1_5 = Новый QtСемафор()
    Семаф1_5.РежимОтладки(Режим_Отладки)
    результатКопияРус = Семаф1_1.КопироватьВ(Семаф1_5)
    валидныйКопияРус = Семаф1_5.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Семаф1_1.RusFunc === 'function' Тогда
        jsonStr = Семаф1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSemaphore (QtСемафор) завершён.======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtУсловнаяПеременная()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьУсловнуюПеременную     │ getRealCondition               │
//│ 20 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 21 │ Ожидать                        │ wait                           │
//│ 22 │ ОжидатьТаймаут                 │ waitTimeout                    │
//│ 23 │ РазбудитьОдного                │ wakeOne                        │
//│ 24 │ РазбудитьВсех                  │ wakeAll                        │
//│ 25 │ Ожидающих                      │ waitingCount                   │
//│ 26 │ ЕстьОжидающие                  │ hasWaitingThreads              │
//│ 27 │ Ожидает                        │ isWaiting                      │
//│ 28 │ Действителен                   │ isValid                        │
//│ 29 │ КопироватьВ                    │ copyTo                         │
//│ 30 │ РежимОтладки                   │ setDebug                       │
//│ 31 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 32 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 33 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtWaitCondition (QtУсловнаяПеременная) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    УслПерем1_1 = Новый QtУсловнаяПеременная()
    УслПерем1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = УслПерем1_1.isValid()
    валидныйРус = УслПерем1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ РЕАЛЬНОЙ УСЛОВНОЙ ПЕРЕМЕННОЙ =====
    реальная = УслПерем1_1.getRealCondition()
    реальнаяРус = УслПерем1_1.ПолучитьУсловнуюПеременную()
    ВывестиСтрокуВКонсоль("    getRealCondition(): " + (реальная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьУсловнуюПеременную(): " + (реальнаяРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. РАЗБУДИТЬ ОДНОГО И ВСЕХ =====
    Попытка
        УслПерем1_1.wakeOne()
        УслПерем1_1.wakeAll()
        ВывестиСтрокуВКонсоль("    wakeOne/wakeAll(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    wakeOne/wakeAll(): ОШИБКА - " + e)
    КонецПопытки
    
    Попытка
        УслПерем1_1.РазбудитьОдного()
        УслПерем1_1.РазбудитьВсех()
        ВывестиСтрокуВКонсоль("    РазбудитьОдного/РазбудитьВсех(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    РазбудитьОдного/РазбудитьВсех(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ОЖИДАНИЕ (С МЬЮТЕКСОМ) =====
    тестМьютекс = Новый QtМьютекс()
    тестМьютекс.РежимОтладки(Режим_Отладки)
    реальныйМьютекс = тестМьютекс.getRealMutex()
    Если реальныйМьютекс != null Тогда
        ВывестиСтрокуВКонсоль("    wait(): метод " + (typeof УслПерем1_1.wait === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    wait(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    тестМьютексРус = Новый QtМьютекс()
    тестМьютексРус.РежимОтладки(Режим_Отладки)
    реальныйМьютексРус = тестМьютексРус.ПолучитьМьютекс()
    Если реальныйМьютексРус != null Тогда
        ВывестиСтрокуВКонсоль("    Ожидать(): метод " + (typeof УслПерем1_1.Ожидать === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    Ожидать(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    // ===== 6. ОЖИДАНИЕ С ТАЙМАУТОМ =====
    тестМьютекс2 = Новый QtМьютекс()
    тестМьютекс2.РежимОтладки(Режим_Отладки)
    реальныйМьютекс2 = тестМьютекс2.getRealMutex()
    Если реальныйМьютекс2 != null Тогда
        ВывестиСтрокуВКонсоль("    waitTimeout(): метод " + (typeof УслПерем1_1.waitTimeout === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    waitTimeout(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    тестМьютекс2Рус = Новый QtМьютекс()
    тестМьютекс2Рус.РежимОтладки(Режим_Отладки)
    реальныйМьютекс2Рус = тестМьютекс2Рус.ПолучитьМьютекс()
    Если реальныйМьютекс2Рус != null Тогда
        ВывестиСтрокуВКонсоль("    ОжидатьТаймаут(): метод " + (typeof УслПерем1_1.ОжидатьТаймаут === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    Иначе
        ВывестиСтрокуВКонсоль("    ОжидатьТаймаут(): НЕ УДАЛОСЬ ПОЛУЧИТЬ МЬЮТЕКС")
    КонецЕсли
    
    // ===== 7. КОПИРОВАНИЕ =====
    УслПерем1_2 = Новый QtУсловнаяПеременная()
    УслПерем1_2.РежимОтладки(Режим_Отладки)
    результатКопия = УслПерем1_1.copyTo(УслПерем1_2)
    валидныйКопия = УслПерем1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    УслПерем1_3 = Новый QtУсловнаяПеременная()
    УслПерем1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = УслПерем1_1.КопироватьВ(УслПерем1_3)
    валидныйКопияРус = УслПерем1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. RUSFUNC =====
    Если typeof УслПерем1_1.RusFunc === 'function' Тогда
        jsonStr = УслПерем1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtWaitCondition (QtУсловнаяПеременная) завершён.======================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtОбщийСтиль()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьСтиль                  │ getRealStyle                   │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ Имя                            │ getName                        │
//│ 22 │ СтандартнаяИконка              │ standardIcon                   │
//│ 23 │ ПиксельныйРазмер               │ pixelMetric                    │
//│ 24 │ РазмерИзСодержимого            │ sizeFromContents               │
//│ 25 │ НарисоватьПримитив             │ drawPrimitive                  │
//│ 26 │ НарисоватьКонтрол              │ drawControl                    │
//│ 27 │ НарисоватьСложныйКонтрол       │ drawComplexControl             │
//│ 28 │ ПопаданиеСложногоКонтрола      │ hitTestComplexControl          │
//│ 29 │ ПрямоугольникПодэлемента       │ subElementRect                 │
//│ 30 │ ПрямоугольникПодконтрола       │ subControlRect                 │
//│ 31 │ СтильДляВиджета                │ getStyleForWidget              │
//│ 32 │ НативныйСтиль                  │ isNativeStyleValue             │
//│ 33 │ УстановитьСтильПриложения      │ setApplicationStyle            │
//│ 34 │ СтандартныйСтиль               │ getStandardStyle               │
//│ 35 │ КопироватьВ                    │ copyTo                         │
//│ 36 │ ДоступныеСтили                 │ getAvailableStyles             │
//│ 37 │ СоздатьСтиль                   │ createStyle                    │
//│ 38 │ СтандартныйСтиль               │ isStandardStyle                │
//│ 39 │ ИмяСтиля                       │ getName                        │
//│ 40 │ Нативный                       │ isNativeStyleValue             │
//│ 41 │ ПолучитьРеальныйСтиль          │ getRealStyle                   │
//│ 42 │ Стиль                          │ getRealStyle                   │
//│ 43 │ СписокСтилей                   │ getAvailableStyles             │
//│ 44 │ ПолучитьОбщийСтиль             │ getRealCommonStyle             │
//│ 45 │ Действителен                   │ isValidValue                   │
//│ 46 │ КопироватьВ                    │ copyTo                         │
//│ 47 │ ОбщийСтиль                     │ getRealCommonStyle             │
//│ 48 │ СтандартныйОбщийСтиль          │ getRealCommonStyle             │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtCommonStyle (QtОбщийСтиль) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ОбщСтиль1_1 = Новый QtОбщийСтиль()
    ОбщСтиль1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ОбщСтиль1_1.isValid()
    валидныйРус = ОбщСтиль1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ ИМЕНИ СТИЛЯ =====
    имя = ОбщСтиль1_1.getName()
    имяРус = ОбщСтиль1_1.Имя()
    ВывестиСтрокуВКонсоль("    getName(): " + имя + ", Имя(): " + имяРус + " (ожидается не пусто)")
    
    // ===== 4. ПИКСЕЛЬНЫЙ РАЗМЕР =====
    размер = ОбщСтиль1_1.pixelMetric(0)
    размерРус = ОбщСтиль1_1.ПиксельныйРазмер(0)
    ВывестиСтрокуВКонсоль("    pixelMetric(0): " + размер + ", ПиксельныйРазмер(0): " + размерРус + " (ожидается >= 0)")
    
    // ===== 5. ПРОВЕРКА НАТИВНОСТИ СТИЛЯ =====
    нативный = ОбщСтиль1_1.isNativeStyleValue()
    нативныйРус = ОбщСтиль1_1.Нативный()
    ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный + ", Нативный(): " + нативныйРус + " (ожидается false)")
    
    // ===== 6. СТАНДАРТНАЯ ИКОНКА =====
    иконка = ОбщСтиль1_1.standardIcon(0)
    иконкаРус = ОбщСтиль1_1.СтандартнаяИконка(0)
    ВывестиСтрокуВКонсоль("    standardIcon(0): " + (иконка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН") + ", СтандартнаяИконка(0): " + (иконкаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 7. КОПИРОВАНИЕ =====
    ОбщСтиль1_2 = Новый QtОбщийСтиль()
    ОбщСтиль1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ОбщСтиль1_1.copyTo(ОбщСтиль1_2)
    валидныйКопия = ОбщСтиль1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    ОбщСтиль1_3 = Новый QtОбщийСтиль()
    ОбщСтиль1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = ОбщСтиль1_1.КопироватьВ(ОбщСтиль1_3)
    валидныйКопияРус = ОбщСтиль1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 8. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЩЕГО СТИЛЯ =====
    реальный = ОбщСтиль1_1.getRealCommonStyle()
    реальныйРус = ОбщСтиль1_1.ПолучитьОбщийСтиль()
    ВывестиСтрокуВКонсоль("    getRealCommonStyle(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьОбщийСтиль(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СТИЛЯ (QStyle) =====
    реальныйСтиль = ОбщСтиль1_1.getRealStyle()
    реальныйСтильРус = ОбщСтиль1_1.ПолучитьСтиль()
    ВывестиСтрокуВКонсоль("    getRealStyle(): " + (реальныйСтиль != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьСтиль(): " + (реальныйСтильРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. РАЗМЕР ИЗ СОДЕРЖИМОГО =====
    Попытка
        размерQt = Новый QtРазмер(50, 20)
        результатРазмер = ОбщСтиль1_1.sizeFromContents(0, null, размерQt)
        ширина = результатРазмер.Ширина()
        высота = результатРазмер.Высота()
        ВывестиСтрокуВКонсоль("    sizeFromContents(0): " + ширина + "x" + высота)
    Исключение
        ВывестиСтрокуВКонсоль("    sizeFromContents(): " + (typeof ОбщСтиль1_1.sizeFromContents === 'function' ? "МЕТОД СУЩЕСТВУЕТ (тест пропущен)" : "НЕ ДОСТУПЕН"))
    КонецПопытки
    
    Попытка
        размерQtРус = Новый QtРазмер(50, 20)
        результатРазмерРус = ОбщСтиль1_1.РазмерИзСодержимого(0, null, размерQtРус)
        ширинаРус = результатРазмерРус.Ширина()
        высотаРус = результатРазмерРус.Высота()
        ВывестиСтрокуВКонсоль("    РазмерИзСодержимого(0): " + ширинаРус + "x" + высотаРус)
    Исключение
        ВывестиСтрокуВКонсоль("    РазмерИзСодержимого(): " + (typeof ОбщСтиль1_1.РазмерИзСодержимого === 'function' ? "МЕТОД СУЩЕСТВУЕТ (тест пропущен)" : "НЕ ДОСТУПЕН"))
    КонецПопытки
    
    // ===== 11. RUSFUNC =====
    Если typeof ОбщСтиль1_1.RusFunc === 'function' Тогда
        jsonStr = ОбщСтиль1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtCommonStyle (QtОбщийСтиль) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПроксиСтиль()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьСтиль                  │ getRealStyle                   │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ Имя                            │ getName                        │
//│ 22 │ СтандартнаяИконка              │ standardIcon                   │
//│ 23 │ ПиксельныйРазмер               │ pixelMetric                    │
//│ 24 │ РазмерИзСодержимого            │ sizeFromContents               │
//│ 25 │ НарисоватьПримитив             │ drawPrimitive                  │
//│ 26 │ НарисоватьКонтрол              │ drawControl                    │
//│ 27 │ НарисоватьСложныйКонтрол       │ drawComplexControl             │
//│ 28 │ ПопаданиеСложногоКонтрола      │ hitTestComplexControl          │
//│ 29 │ ПрямоугольникПодэлемента       │ subElementRect                 │
//│ 30 │ ПрямоугольникПодконтрола       │ subControlRect                 │
//│ 31 │ СтильДляВиджета                │ getStyleForWidget              │
//│ 32 │ НативныйСтиль                  │ isNativeStyleValue             │
//│ 33 │ УстановитьСтильПриложения      │ setApplicationStyle            │
//│ 34 │ СтандартныйСтиль               │ getStandardStyle               │
//│ 35 │ КопироватьВ                    │ copyTo                         │
//│ 36 │ ДоступныеСтили                 │ getAvailableStyles             │
//│ 37 │ СоздатьСтиль                   │ createStyle                    │
//│ 38 │ СтандартныйСтиль               │ isStandardStyle                │
//│ 39 │ ИмяСтиля                       │ getName                        │
//│ 40 │ Нативный                       │ isNativeStyleValue             │
//│ 41 │ ПолучитьРеальныйСтиль          │ getRealStyle                   │
//│ 42 │ Стиль                          │ getRealStyle                   │
//│ 43 │ СписокСтилей                   │ getAvailableStyles             │
//│ 44 │ ПолучитьПроксиСтиль            │ getRealProxyStyle              │
//│ 45 │ УстановитьБазовыйСтиль         │ setBaseStyle                   │
//│ 46 │ БазовыйСтиль                   │ getBaseStyle                   │
//│ 47 │ УстановитьБазовыйСтильОбёртку  │ setBaseStyleWrapper            │
//│ 48 │ БазовыйСтильОбёртка            │ getBaseStyleWrapper            │
//│ 49 │ Действителен                   │ isValidValue                   │
//│ 50 │ КопироватьВ                    │ copyTo                         │
//│ 51 │ ПроксиСтиль                    │ getRealProxyStyle              │
//│ 52 │ Базовый                        │ getBaseStyle                   │
//│ 53 │ УстановитьБазовый              │ setBaseStyle                   │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtProxyStyle (QtПроксиСтиль) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ПроксиСтиль1_1 = Новый QtПроксиСтиль()
    ПроксиСтиль1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = ПроксиСтиль1_1.isValid()
    валидныйРус = ПроксиСтиль1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ ИМЕНИ СТИЛЯ =====
    имя = ПроксиСтиль1_1.getName()
    имяРус = ПроксиСтиль1_1.Имя()
    ВывестиСтрокуВКонсоль("    getName(): " + имя + ", Имя(): " + имяРус + " (ожидается не пусто)")
    
    // ===== 4. РАБОТА С БАЗОВЫМ СТИЛЕМ =====
    базовый = ПроксиСтиль1_1.getBaseStyle()
    базовыйРус = ПроксиСтиль1_1.БазовыйСтиль()
    ВывестиСтрокуВКонсоль("    getBaseStyle(): " + (базовый != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    БазовыйСтиль(): " + (базовыйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 5. ОБЁРТКА БАЗОВОГО СТИЛЯ =====
    обёртка = ПроксиСтиль1_1.getBaseStyleWrapper()
    обёрткаРус = ПроксиСтиль1_1.БазовыйСтильОбёртка()
    ВывестиСтрокуВКонсоль("    getBaseStyleWrapper(): " + (обёртка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    БазовыйСтильОбёртка(): " + (обёрткаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. ПИКСЕЛЬНЫЙ РАЗМЕР =====
    размер = ПроксиСтиль1_1.pixelMetric(0)
    размерРус = ПроксиСтиль1_1.ПиксельныйРазмер(0)
    ВывестиСтрокуВКонсоль("    pixelMetric(0): " + размер + ", ПиксельныйРазмер(0): " + размерРус + " (ожидается >= 0)")
    
    // ===== 7. ПРОВЕРКА НАТИВНОСТИ СТИЛЯ =====
    нативный = ПроксиСтиль1_1.isNativeStyleValue()
    нативныйРус = ПроксиСтиль1_1.НативныйСтиль()
    ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный + ", НативныйСтиль(): " + нативныйРус)
    
    // ===== 8. СТАНДАРТНАЯ ИКОНКА =====
    иконка = ПроксиСтиль1_1.standardIcon(0)
    иконкаРус = ПроксиСтиль1_1.СтандартнаяИконка(0)
    ВывестиСтрокуВКонсоль("    standardIcon(0): " + (иконка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    СтандартнаяИконка(0): " + (иконкаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. КОПИРОВАНИЕ =====
    ПроксиСтиль1_2 = Новый QtПроксиСтиль()
    ПроксиСтиль1_2.РежимОтладки(Режим_Отладки)
    результатКопия = ПроксиСтиль1_1.copyTo(ПроксиСтиль1_2)
    валидныйКопия = ПроксиСтиль1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    ПроксиСтиль1_3 = Новый QtПроксиСтиль()
    ПроксиСтиль1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = ПроксиСтиль1_1.КопироватьВ(ПроксиСтиль1_3)
    валидныйКопияРус = ПроксиСтиль1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ПРОКСИ-СТИЛЯ =====
    реальный = ПроксиСтиль1_1.getRealProxyStyle()
    реальныйРус = ПроксиСтиль1_1.ПолучитьПроксиСтиль()
    ВывестиСтрокуВКонсоль("    getRealProxyStyle(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьПроксиСтиль(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
   
    // ===== 12. RUSFUNC =====
    Если typeof ПроксиСтиль1_1.RusFunc === 'function' Тогда
        jsonStr = ПроксиСтиль1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtProxyStyle (QtПроксиСтиль) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСтиль()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьСтиль                  │ getRealStyle                   │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ Имя                            │ getName                        │
//│ 22 │ СтандартнаяИконка              │ standardIcon                   │
//│ 23 │ ПиксельныйРазмер               │ pixelMetric                    │
//│ 24 │ РазмерИзСодержимого            │ sizeFromContents               │
//│ 25 │ НарисоватьПримитив             │ drawPrimitive                  │
//│ 26 │ НарисоватьКонтрол              │ drawControl                    │
//│ 27 │ НарисоватьСложныйКонтрол       │ drawComplexControl             │
//│ 28 │ ПопаданиеСложногоКонтрола      │ hitTestComplexControl          │
//│ 29 │ ПрямоугольникПодэлемента       │ subElementRect                 │
//│ 30 │ ПрямоугольникПодконтрола       │ subControlRect                 │
//│ 31 │ СтильДляВиджета                │ getStyleForWidget              │
//│ 32 │ НативныйСтиль                  │ isNativeStyleValue             │
//│ 33 │ УстановитьСтильПриложения      │ setApplicationStyle            │
//│ 34 │ СтандартныйСтиль               │ getStandardStyle               │
//│ 35 │ КопироватьВ                    │ copyTo                         │
//│ 36 │ ДоступныеСтили                 │ getAvailableStyles             │
//│ 37 │ СоздатьСтиль                   │ createStyle                    │
//│ 38 │ СтандартныйСтиль               │ isStandardStyle                │
//│ 39 │ ИмяСтиля                       │ getName                        │
//│ 40 │ Нативный                       │ isNativeStyleValue             │
//│ 41 │ ПолучитьРеальныйСтиль          │ getRealStyle                   │
//│ 42 │ Стиль                          │ getRealStyle                   │
//│ 43 │ СписокСтилей                   │ getAvailableStyles             │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtStyle (QtСтиль) - КОМПАКТНАЯ ВЕРСИЯ ===========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Стиль1_1 = Новый QtСтиль()
    Стиль1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Стиль1_1.isValid()
    валидныйРус = Стиль1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ ИМЕНИ СТИЛЯ =====
    имя = Стиль1_1.getName()
    имяРус = Стиль1_1.Имя()
    ВывестиСтрокуВКонсоль("    getName(): " + имя + ", Имя(): " + имяРус + " (ожидается не пусто)")
    
    // ===== 4. ПИКСЕЛЬНЫЙ РАЗМЕР =====
    размер = Стиль1_1.pixelMetric(0)
    размерРус = Стиль1_1.ПиксельныйРазмер(0)
    ВывестиСтрокуВКонсоль("    pixelMetric(0): " + размер + ", ПиксельныйРазмер(0): " + размерРус + " (ожидается > 0)")
    
    // ===== 5. ПРОВЕРКА НАТИВНОСТИ СТИЛЯ =====
    нативный = Стиль1_1.isNativeStyleValue()
    нативныйРус = Стиль1_1.НативныйСтиль()
    ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный + ", НативныйСтиль(): " + нативныйРус)
    
    // ===== 6. СТАНДАРТНАЯ ИКОНКА =====
    иконка = Стиль1_1.standardIcon(0)
    иконкаРус = Стиль1_1.СтандартнаяИконка(0)
    ВывестиСтрокуВКонсоль("    standardIcon(0): " + (иконка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    СтандартнаяИконка(0): " + (иконкаРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 7. СТАНДАРТНЫЙ СТИЛЬ =====
    стандартный = Стиль1_1.getStandardStyle()
    стандартныйРус = Стиль1_1.СтандартныйСтиль()
    ВывестиСтрокуВКонсоль("    getStandardStyle(): " + (стандартный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    СтандартныйСтиль(): " + (стандартныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 8. КОПИРОВАНИЕ =====
    Стиль1_2 = Новый QtСтиль()
    Стиль1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Стиль1_1.copyTo(Стиль1_2)
    валидныйКопия = Стиль1_2.isValid()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Стиль1_3 = Новый QtСтиль()
    Стиль1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Стиль1_1.КопироватьВ(Стиль1_3)
    валидныйКопияРус = Стиль1_3.Действителен()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия Действителен(): " + валидныйКопияРус + " (ожидается true)")
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СТИЛЯ =====
    реальный = Стиль1_1.getRealStyle()
    реальныйРус = Стиль1_1.ПолучитьСтиль()
    ВывестиСтрокуВКонсоль("    getRealStyle(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьСтиль(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    //// ===== 10. РАЗМЕР ИЗ СОДЕРЖИМОГО =====
    имеетАнгл = typeof Стиль1_1.sizeFromContents === 'function'
    имеетРус = typeof Стиль1_1.РазмерИзСодержимого === 'function'
    ВывестиСтрокуВКонсоль("    sizeFromContents(): " + (имеетАнгл ? "МЕТОД СУЩЕСТВУЕТ" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    РазмерИзСодержимого(): " + (имеетРус ? "МЕТОД СУЩЕСТВУЕТ" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. RUSFUNC =====
    Если typeof Стиль1_1.RusFunc === 'function' Тогда
        jsonStr = Стиль1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtStyle (QtСтиль) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtРазмер()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьРазмер                 │ getRealSize                    │
//│ 20 │ Действителен                   │ isValid                        │
//│ 21 │ Ширина                         │ width                          │
//│ 22 │ Высота                         │ height                         │
//│ 23 │ УстановитьШирину               │ setWidth                       │
//│ 24 │ УстановитьВысоту               │ setHeight                      │
//│ 25 │ УстановитьРазмер               │ setSize                        │
//│ 26 │ Пустой                         │ isEmpty                        │
//│ 27 │ Нулевой                        │ isNull                         │
//│ 28 │ Масштабировать                 │ scaled                         │
//│ 29 │ МасштабироватьПоШирине         │ scaledToWidth                  │
//│ 30 │ МасштабироватьПоВысоте         │ scaledToHeight                 │
//│ 31 │ Транспонировать                │ transposed                     │
//│ 32 │ РасширитьДо                    │ expandedTo                     │
//│ 33 │ ОграничитьДо                   │ boundedTo                      │
//│ 34 │ Плюс                           │ plus                           │
//│ 35 │ Минус                          │ minus                          │
//│ 36 │ Умножить                       │ multiply                       │
//│ 37 │ Разделить                      │ divide                         │
//│ 38 │ ВСтроку                        │ toString                       │
//│ 39 │ КопироватьВ                    │ copyTo                         │
//│ 40 │ Клонировать                    │ clone                          │
//│ 41 │ ИгнорироватьСоотношение        │ IgnoreAspectRatio              │
//│ 42 │ СохранятьСоотношение           │ KeepAspectRatio                │
//│ 43 │ СохранятьСоотношениеПоМинимуму │ KeepAspectRatioByExpanding     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSize (QtРазмер) - КОМПАКТНАЯ ВЕРСИЯ ==========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Размер1_1 = Новый QtРазмер()
    Размер1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С ПАРАМЕТРАМИ =====
    Размер1_2 = Новый QtРазмер(100, 50)
    Размер1_2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    QtРазмер(100, 50): УСПЕШНО")
    
    // ===== 3. ПОЛУЧЕНИЕ ШИРИНЫ И ВЫСОТЫ =====
    ширина = Размер1_2.width()
    высота = Размер1_2.height()
    ширинаРус = Размер1_2.Ширина()
    высотаРус = Размер1_2.Высота()
    ВывестиСтрокуВКонсоль("    width(): " + ширина + ", Ширина(): " + ширинаРус + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    height(): " + высота + ", Высота(): " + высотаРус + " (ожидается 50)")
    
    // ===== 4. УСТАНОВКА ШИРИНЫ И ВЫСОТЫ =====
    Размер1_1.setWidth(200)
    Размер1_1.setHeight(100)
    ширина2 = Размер1_1.width()
    высота2 = Размер1_1.height()
    ВывестиСтрокуВКонсоль("    setWidth(200), setHeight(100) -> " + ширина2 + "x" + высота2 + " (ожидается 200x100)")
    
    Размер1_1.УстановитьШирину(300)
    Размер1_1.УстановитьВысоту(150)
    ширина2Рус = Размер1_1.Ширина()
    высота2Рус = Размер1_1.Высота()
    ВывестиСтрокуВКонсоль("    УстановитьШирину(300), УстановитьВысоту(150) -> " + ширина2Рус + "x" + высота2Рус + " (ожидается 300x150)")
    
    // ===== 5. УСТАНОВКА РАЗМЕРА =====
    Размер1_3 = Новый QtРазмер(0, 0)
    Размер1_3.РежимОтладки(Режим_Отладки)
    Размер1_3.setSize(400, 200)
    ширина3 = Размер1_3.width()
    высота3 = Размер1_3.height()
    ВывестиСтрокуВКонсоль("    setSize(400, 200) -> " + ширина3 + "x" + высота3 + " (ожидается 400x200)")
    
    Размер1_3.УстановитьРазмер(600, 300)
    ширина3Рус = Размер1_3.Ширина()
    высота3Рус = Размер1_3.Высота()
    ВывестиСтрокуВКонсоль("    УстановитьРазмер(600, 300) -> " + ширина3Рус + "x" + высота3Рус + " (ожидается 600x300)")
    
    // ===== 6. ПРОВЕРКА ВАЛИДНОСТИ =====
    Размер1_4 = Новый QtРазмер(100, 50)
    Размер1_4.РежимОтладки(Режим_Отладки)
    Размер1_5 = Новый QtРазмер(-10, -5)
    Размер1_5.РежимОтладки(Режим_Отладки)
    валид1 = Размер1_4.isValid()
    валид2 = Размер1_5.isValid()
    валид1Рус = Размер1_4.Действителен()
    валид2Рус = Размер1_5.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(100,50): " + валид1 + ", isValid(-10,-5): " + валид2 + " (ожидается true, false)")
    ВывестиСтрокуВКонсоль("    Действителен(100,50): " + валид1Рус + ", Действителен(-10,-5): " + валид2Рус + " (ожидается true, false)")
    
    // ===== 7. ПРОВЕРКА ПУСТОТЫ И НУЛЕВОГО РАЗМЕРА =====
    Размер1_6 = Новый QtРазмер(100, 50)
    Размер1_6.РежимОтладки(Режим_Отладки)
    Размер1_7 = Новый QtРазмер(0, 0)
    Размер1_7.РежимОтладки(Режим_Отладки)
    Размер1_8 = Новый QtРазмер(0, 50)
    Размер1_8.РежимОтладки(Режим_Отладки)
    
    пуст1 = Размер1_6.isEmpty()
    пуст2 = Размер1_7.isEmpty()
    пуст3 = Размер1_8.isEmpty()
    нуль1 = Размер1_6.isNull()
    нуль2 = Размер1_7.isNull()
    нуль3 = Размер1_8.isNull()
    ВывестиСтрокуВКонсоль("    isEmpty: (100,50)=" + пуст1 + ", (0,0)=" + пуст2 + ", (0,50)=" + пуст3 + " (ожидается false, true, true)")
    ВывестиСтрокуВКонсоль("    isNull: (100,50)=" + нуль1 + ", (0,0)=" + нуль2 + ", (0,50)=" + нуль3 + " (ожидается false, true, false)")
    
    // ===== 8. МАСШТАБИРОВАНИЕ =====
    Размер1_9 = Новый QtРазмер(100, 50)
    Размер1_9.РежимОтладки(Режим_Отладки)
    scaled = Размер1_9.scaled(200, 100, 0)
    ширинаSc = scaled.width()
    высотаSc = scaled.height()
    ВывестиСтрокуВКонсоль("    scaled(200, 100) -> " + ширинаSc + "x" + высотаSc + " (ожидается 200x100)")
    
    scaledРус = Размер1_9.Масштабировать(300, 150, 0)
    ширинаScРус = scaledРус.width()
    высотаScРус = scaledРус.height()
    ВывестиСтрокуВКонсоль("    Масштабировать(300, 150) -> " + ширинаScРус + "x" + высотаScРус + " (ожидается 300x150)")
    
    // ===== 9. МАСШТАБИРОВАНИЕ ПО ШИРИНЕ И ВЫСОТЕ =====
    scaledW = Размер1_9.scaledToWidth(200, 0)
    scaledH = Размер1_9.scaledToHeight(100, 0)
    ВывестиСтрокуВКонсоль("    scaledToWidth(200): " + scaledW.width() + "x" + scaledW.height())
    ВывестиСтрокуВКонсоль("    scaledToHeight(100): " + scaledH.width() + "x" + scaledH.height())
    
    scaledWРус = Размер1_9.МасштабироватьПоШирине(250, 0)
    scaledHРус = Размер1_9.МасштабироватьПоВысоте(125, 0)
    ВывестиСтрокуВКонсоль("    МасштабироватьПоШирине(250): " + scaledWРус.width() + "x" + scaledWРус.height())
    ВывестиСтрокуВКонсоль("    МасштабироватьПоВысоте(125): " + scaledHРус.width() + "x" + scaledHРус.height())
    
    // ===== 10. ТРАНСПОНИРОВАНИЕ =====
    Размер1_10 = Новый QtРазмер(100, 50)
    Размер1_10.РежимОтладки(Режим_Отладки)
    трансп = Размер1_10.transposed()
    ширинаТр = трансп.width()
    высотаТр = трансп.height()
    ВывестиСтрокуВКонсоль("    transposed(100,50) -> " + ширинаТр + "x" + высотаТр + " (ожидается 50x100)")
    
    транспРус = Размер1_10.Транспонировать()
    ширинаТрРус = транспРус.width()
    высотаТрРус = транспРус.height()
    ВывестиСтрокуВКонсоль("    Транспонировать(100,50) -> " + ширинаТрРус + "x" + высотаТрРус + " (ожидается 50x100)")
    
    // ===== 11. СЛОЖЕНИЕ И ВЫЧИТАНИЕ =====
    Размер1_11 = Новый QtРазмер(100, 50)
    Размер1_11.РежимОтладки(Режим_Отладки)
    Размер1_12 = Новый QtРазмер(20, 10)
    Размер1_12.РежимОтладки(Режим_Отладки)
    сумма = Размер1_11.plus(Размер1_12)
    разность = Размер1_11.minus(Размер1_12)
    ВывестиСтрокуВКонсоль("    plus(20,10): " + сумма.width() + "x" + сумма.height() + " (ожидается 120x60)")
    ВывестиСтрокуВКонсоль("    minus(20,10): " + разность.width() + "x" + разность.height() + " (ожидается 80x40)")
    
    суммаРус = Размер1_11.Плюс(Размер1_12)
    разностьРус = Размер1_11.Минус(Размер1_12)
    ВывестиСтрокуВКонсоль("    Плюс(20,10): " + суммаРус.width() + "x" + суммаРус.height() + " (ожидается 120x60)")
    ВывестиСтрокуВКонсоль("    Минус(20,10): " + разностьРус.width() + "x" + разностьРус.height() + " (ожидается 80x40)")
    
    // ===== 12. УМНОЖЕНИЕ И ДЕЛЕНИЕ =====
    умнож = Размер1_11.multiply(2)
    дел = Размер1_11.divide(2)
    ВывестиСтрокуВКонсоль("    multiply(2): " + умнож.width() + "x" + умнож.height() + " (ожидается 200x100)")
    ВывестиСтрокуВКонсоль("    divide(2): " + дел.width() + "x" + дел.height() + " (ожидается 50x25)")
    
    умножРус = Размер1_11.Умножить(3)
    делРус = Размер1_11.Разделить(3)
    ВывестиСтрокуВКонсоль("    Умножить(3): " + умножРус.width() + "x" + умножРус.height() + " (ожидается 300x150)")
    ВывестиСтрокуВКонсоль("    Разделить(3): " + делРус.width() + "x" + делРус.height() + " (ожидается 33x16)")
    
    // ===== 13. ПРЕОБРАЗОВАНИЕ В СТРОКУ =====
    строка = Размер1_2.toString()
    строкаРус = Размер1_2.ВСтроку()
    ВывестиСтрокуВКонсоль("    toString(): " + строка + ", ВСтроку(): " + строкаРус + " (ожидается 100x50)")
    
    // ===== 14. КОПИРОВАНИЕ =====
    Размер1_13 = Новый QtРазмер()
    Размер1_13.РежимОтладки(Режим_Отладки)
    результатКопия = Размер1_2.copyTo(Размер1_13)
    ширинаКопия = Размер1_13.Ширина()
    высотаКопия = Размер1_13.Высота()
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия: " + ширинаКопия + "x" + высотаКопия + " (ожидается true, 100x50)")
    
    Размер1_14 = Новый QtРазмер()
    Размер1_14.РежимОтладки(Режим_Отладки)
    результатКопияРус = Размер1_2.КопироватьВ(Размер1_14)
    ширинаКопияРус = Размер1_14.Ширина()
    высотаКопияРус = Размер1_14.Высота()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + ", копия: " + ширинаКопияРус + "x" + высотаКопияРус + " (ожидается true, 100x50)")
    
    // ===== 15. ПОЛУЧЕНИЕ РЕАЛЬНОГО РАЗМЕРА =====
    реальный = Размер1_2.getRealSize()
    реальныйРус = Размер1_2.ПолучитьРазмер()
    ВывестиСтрокуВКонсоль("    getRealSize(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРазмер(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 16. RUSFUNC =====
    Если typeof Размер1_1.RusFunc === 'function' Тогда
        jsonStr = Размер1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSize (QtРазмер) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtНастройки()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьНастройки              │ getRealSettings                │
//│ 20 │ Действителен                   │ isValid                        │
//│ 21 │ ИмяОрганизации                 │ organizationName               │
//│ 22 │ ИмяПриложения                  │ applicationName                │
//│ 23 │ ИмяФайла                       │ fileName                       │
//│ 24 │ Область                        │ scope                          │
//│ 25 │ ДоступнаЗапись                 │ isWritable                     │
//│ 26 │ УстановитьЗначение             │ setValue                       │
//│ 27 │ Значение                       │ value                          │
//│ 28 │ ЗначениеСтрока                 │ stringValue                    │
//│ 29 │ ЗначениеЦелое                  │ intValue                       │
//│ 30 │ ЗначениеЛогическое             │ boolValue                      │
//│ 31 │ ЗначениеСписокСтрок            │ stringListValue                │
//│ 32 │ ЗначениеРазмер                 │ sizeValue                      │
//│ 33 │ ЗначениеТочка                  │ pointValue                     │
//│ 34 │ ЗначениеПрямоугольник          │ rectValue                      │
//│ 35 │ Содержит                       │ contains                       │
//│ 36 │ Удалить                        │ remove                         │
//│ 37 │ Очистить                       │ clear                          │
//│ 38 │ Синхронизировать               │ sync                           │
//│ 39 │ НачатьГруппу                   │ beginGroup                     │
//│ 40 │ ЗакончитьГруппу                │ endGroup                       │
//│ 41 │ ДочерниеКлючи                  │ childKeys                      │
//│ 42 │ ДочерниеГруппы                 │ childGroups                    │
//│ 43 │ ВсеКлючи                       │ allKeys                        │
//│ 44 │ ФорматINI                      │ iniFormat                      │
//│ 45 │ ФорматNative                   │ nativeFormat                   │
//│ 46 │ ОбластьПользователя            │ userScope                      │
//│ 47 │ ОбластьСистемы                 │ systemScope                    │
//│ 48 │ КопироватьВ                    │ copyTo                         │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSettings (QtНастройки) - КОМПАКТНАЯ ВЕРСИЯ ==================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Настр1_1 = Новый QtНастройки()
    Настр1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Настр1_1.isValid()
    валидныйРус = Настр1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ИНФОРМАЦИОННЫЕ МЕТОДЫ =====
    орг = Настр1_1.organizationName()
    прил = Настр1_1.applicationName()
    файл = Настр1_1.fileName()
    обл = Настр1_1.scope()
    доступ = Настр1_1.isWritable()
    оргРус = Настр1_1.ИмяОрганизации()
    прилРус = Настр1_1.ИмяПриложения()
    файлРус = Настр1_1.ИмяФайла()
    облРус = Настр1_1.Область()
    доступРус = Настр1_1.ДоступнаЗапись()
    ВывестиСтрокуВКонсоль("    organizationName(): " + орг + ", ИмяОрганизации(): " + оргРус)
    ВывестиСтрокуВКонсоль("    applicationName(): " + прил + ", ИмяПриложения(): " + прилРус)
    ВывестиСтрокуВКонсоль("    fileName(): " + файл + ", ИмяФайла(): " + файлРус)
    ВывестиСтрокуВКонсоль("    scope(): " + обл + ", Область(): " + облРус)
    ВывестиСтрокуВКонсоль("    isWritable(): " + доступ + ", ДоступнаЗапись(): " + доступРус)
    
    // ===== 4. УСТАНОВКА И ЧТЕНИЕ ЗНАЧЕНИЙ =====
    Настр1_1.setValue("test/string", "Hello World")
    Настр1_1.setValue("test/int", 42)
    Настр1_1.setValue("test/bool", ИСТИНА)
    стр = Настр1_1.stringValue("test/string", "")
    число = Настр1_1.intValue("test/int", 0)
    бул = Настр1_1.boolValue("test/bool", ЛОЖЬ)
    ВывестиСтрокуВКонсоль("    stringValue: " + стр + " (ожидается Hello World)")
    ВывестиСтрокуВКонсоль("    intValue: " + число + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    boolValue: " + бул + " (ожидается true)")
    
    Настр1_1.УстановитьЗначение("test/string_ru", "Привет Мир")
    Настр1_1.УстановитьЗначение("test/int_ru", 100)
    Настр1_1.УстановитьЗначение("test/bool_ru", ЛОЖЬ)
    стрРус = Настр1_1.ЗначениеСтрока("test/string_ru", "")
    числоРус = Настр1_1.ЗначениеЦелое("test/int_ru", 0)
    булРус = Настр1_1.ЗначениеЛогическое("test/bool_ru", ИСТИНА)
    ВывестиСтрокуВКонсоль("    ЗначениеСтрока: " + стрРус + " (ожидается Привет Мир)")
    ВывестиСтрокуВКонсоль("    ЗначениеЦелое: " + числоРус + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    ЗначениеЛогическое: " + булРус + " (ожидается false)")
    
    // ===== 5. ПРОВЕРКА СУЩЕСТВОВАНИЯ И УДАЛЕНИЕ =====
    Настр1_1.setValue("test/exists", "value")
    есть = Настр1_1.contains("test/exists")
    нет = Настр1_1.contains("test/not_exists")
    Настр1_1.remove("test/exists")
    естьПосле = Настр1_1.contains("test/exists")
    ВывестиСтрокуВКонсоль("    contains(exists): " + есть + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains(not_exists): " + нет + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    contains after remove: " + естьПосле + " (ожидается false)")
    
    Настр1_1.УстановитьЗначение("test/exists_ru", "value")
    естьРус = Настр1_1.Содержит("test/exists_ru")
    нетРус = Настр1_1.Содержит("test/not_exists_ru")
    Настр1_1.Удалить("test/exists_ru")
    естьПослеРус = Настр1_1.Содержит("test/exists_ru")
    ВывестиСтрокуВКонсоль("    Содержит(exists): " + естьРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Содержит(not_exists): " + нетРус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Содержит after remove: " + естьПослеРус + " (ожидается false)")
    
    // ===== 6. РАБОТА С ГРУППАМИ =====
    Настр1_1.beginGroup("group1")
    Настр1_1.setValue("key1", "value1")
    Настр1_1.setValue("key2", "value2")
    Настр1_1.endGroup()
    ключи = Настр1_1.childKeys()
    группы = Настр1_1.childGroups()
    ВывестиСтрокуВКонсоль("    childKeys: " + ключи.join(", "))
    ВывестиСтрокуВКонсоль("    childGroups: " + группы.join(", "))
    
    Настр1_1.НачатьГруппу("group2")
    Настр1_1.УстановитьЗначение("key1_ru", "value1_ru")
    Настр1_1.УстановитьЗначение("key2_ru", "value2_ru")
    Настр1_1.ЗакончитьГруппу()
    ключиРус = Настр1_1.ДочерниеКлючи()
    группыРус = Настр1_1.ДочерниеГруппы()
    ВывестиСтрокуВКонсоль("    ДочерниеКлючи: " + ключиРус.join(", "))
    ВывестиСтрокуВКонсоль("    ДочерниеГруппы: " + группыРус.join(", "))
    
    // ===== 7. СИНХРОНИЗАЦИЯ И ОЧИСТКА =====
    Настр1_1.setValue("test/sync", "value")
    Настр1_1.sync()
    естьSync = Настр1_1.contains("test/sync")
    Настр1_1.clear()
    естьПослеClear = Настр1_1.contains("test/sync")
    ВывестиСтрокуВКонсоль("    sync() -> contains: " + естьSync + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    clear() -> contains: " + естьПослеClear + " (ожидается false)")
    
    Настр1_1.УстановитьЗначение("test/sync_ru", "value")
    Настр1_1.Синхронизировать()
    естьSyncРус = Настр1_1.Содержит("test/sync_ru")
    Настр1_1.Очистить()
    естьПослеClearРус = Настр1_1.Содержит("test/sync_ru")
    ВывестиСтрокуВКонсоль("    Синхронизировать() -> содержит: " + естьSyncРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Очистить() -> содержит: " + естьПослеClearРус + " (ожидается false)")
    
    // ===== 8. ФОРМАТЫ И ОБЛАСТИ =====
    ini = Настр1_1.iniFormat()
    native = Настр1_1.nativeFormat()
    user = Настр1_1.userScope()
    system = Настр1_1.systemScope()
    iniРус = Настр1_1.ФорматINI()
    nativeРус = Настр1_1.ФорматNative()
    userРус = Настр1_1.ОбластьПользователя()
    systemРус = Настр1_1.ОбластьСистемы()
    ВывестиСтрокуВКонсоль("    iniFormat(): " + ini + ", ФорматINI(): " + iniРус + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    nativeFormat(): " + native + ", ФорматNative(): " + nativeРус + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    userScope(): " + user + ", ОбластьПользователя(): " + userРус + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    systemScope(): " + system + ", ОбластьСистемы(): " + systemРус + " (ожидается 1)")
    
    // ===== 9. КОПИРОВАНИЕ =====
    Настр1_2 = Новый QtНастройки()
    Настр1_2.РежимОтладки(Режим_Отладки)
    результатКопия = Настр1_1.copyTo(Настр1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    Настр1_3 = Новый QtНастройки()
    Настр1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = Настр1_1.КопироватьВ(Настр1_3)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНЫХ НАСТРОЕК =====
    реальные = Настр1_1.getRealSettings()
    реальныеРус = Настр1_1.ПолучитьНастройки()
    ВывестиСтрокуВКонсоль("    getRealSettings(): " + (реальные != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьНастройки(): " + (реальныеРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. RUSFUNC =====
    Если typeof Настр1_1.RusFunc === 'function' Тогда
        jsonStr = Настр1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSettings (QtНастройки) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtКраткийВызов()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьКраткийВызов           │ getRealShortcut                │
//│ 20 │ Действителен                   │ isValidValue                   │
//│ 21 │ УстановитьКлюч                 │ setKey                         │
//│ 22 │ Ключ                           │ getKey                         │
//│ 23 │ ТекстКлюча                     │ getKeyText                     │
//│ 24 │ УстановитьКолбэк               │ setCallback                    │
//│ 25 │ УстановитьДоступен             │ setEnabledValue                │
//│ 26 │ Доступен                       │ isEnabledValue                 │
//│ 27 │ УстановитьАвтоповтор           │ setAutoRepeatValue             │
//│ 28 │ Автоповтор                     │ autoRepeatValue                │
//│ 29 │ УстановитьПодсказку            │ setWhat                        │
//│ 30 │ Подсказка                      │ getWhat                        │
//│ 31 │ Идентификатор                  │ getIdValue                     │
//│ 32 │ РодительскийВиджет             │ getParentWidgetValue           │
//│ 33 │ ПоследовательностьКлючей       │ keySequence                    │
//│ 34 │ ПоследовательностьИзКлючей     │ keySequenceFromKeys            │
//│ 35 │ СтандартныйКлюч                │ standardKeyText                │
//│ 36 │ КопироватьВ                    │ copyTo                         │
//│ 37 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 38 │ ИмяОбъекта                     │ getObjectName                  │
//│ 39 │ РежимОтладки                   │ setDebug                       │
//│ 40 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 41 │ КраткийВызов                   │ getRealShortcut                │
//│ 42 │ КлючеваяПоследовательность     │ getKey                         │
//│ 43 │ ТекстКлюча                     │ getKeyText                     │
//│ 44 │ Включен                        │ isEnabledValue                 │
//│ 45 │ ID                             │ getIdValue                     │
//│ 46 │ Родитель                       │ getParentWidgetValue           │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtShortcut (QtКраткийВызов) - КОМПАКТНАЯ ВЕРСИЯ ===============")
    
    // Создаём виджет для тестов
    виджет = Новый QtВиджет()
    виджет.Показать()
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    КраткВыз1_1 = Новый QtКраткийВызов(виджет)
    КраткВыз1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = КраткВыз1_1.isValid()
    валидныйРус = КраткВыз1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ КЛЮЧА =====
    КраткВыз1_1.setKey("Ctrl+Shift+S")
    ключ = КраткВыз1_1.getKey()
    текстКлюча = КраткВыз1_1.getKeyText()
    ВывестиСтрокуВКонсоль("    setKey(Ctrl+Shift+S) -> getKeyText(): " + текстКлюча)
    
    КраткВыз1_1.УстановитьКлюч("Ctrl+Alt+O")
    ключРус = КраткВыз1_1.Ключ()
    текстКлючаРус = КраткВыз1_1.ТекстКлюча()
    ВывестиСтрокуВКонсоль("    УстановитьКлюч(Ctrl+Alt+O) -> ТекстКлюча(): " + текстКлючаРус)
    
    // ===== 4. ДОСТУПНОСТЬ =====
    КраткВыз1_1.setEnabledValue(ЛОЖЬ)
    доступен1 = КраткВыз1_1.isEnabledValue()
    КраткВыз1_1.setEnabledValue(ИСТИНА)
    доступен2 = КраткВыз1_1.isEnabledValue()
    ВывестиСтрокуВКонсоль("    setEnabledValue(false) -> isEnabledValue(): " + доступен1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    setEnabledValue(true) -> isEnabledValue(): " + доступен2 + " (ожидается true)")
    
    КраткВыз1_1.УстановитьДоступен(ЛОЖЬ)
    доступен1Рус = КраткВыз1_1.Доступен()
    КраткВыз1_1.УстановитьДоступен(ИСТИНА)
    доступен2Рус = КраткВыз1_1.Доступен()
    ВывестиСтрокуВКонсоль("    УстановитьДоступен(false) -> Доступен(): " + доступен1Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    УстановитьДоступен(true) -> Доступен(): " + доступен2Рус + " (ожидается true)")
    
    // ===== 5. АВТОПОВТОР =====
    КраткВыз1_1.setAutoRepeatValue(ЛОЖЬ)
    повтор1 = КраткВыз1_1.autoRepeatValue()
    КраткВыз1_1.setAutoRepeatValue(ИСТИНА)
    повтор2 = КраткВыз1_1.autoRepeatValue()
    ВывестиСтрокуВКонсоль("    setAutoRepeatValue(false) -> autoRepeatValue(): " + повтор1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    setAutoRepeatValue(true) -> autoRepeatValue(): " + повтор2 + " (ожидается true)")
    
    КраткВыз1_1.УстановитьАвтоповтор(ЛОЖЬ)
    повтор1Рус = КраткВыз1_1.Автоповтор()
    КраткВыз1_1.УстановитьАвтоповтор(ИСТИНА)
    повтор2Рус = КраткВыз1_1.Автоповтор()
    ВывестиСтрокуВКонсоль("    УстановитьАвтоповтор(false) -> Автоповтор(): " + повтор1Рус + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    УстановитьАвтоповтор(true) -> Автоповтор(): " + повтор2Рус + " (ожидается true)")
    
    // ===== 6. ПОДСКАЗКА =====
    КраткВыз1_1.setWhat("Сохранить документ")
    подсказка = КраткВыз1_1.getWhat()
    ВывестиСтрокуВКонсоль("    setWhat('Сохранить документ') -> getWhat(): " + подсказка + " (ожидается 'Сохранить документ')")
    
    КраткВыз1_1.УстановитьПодсказку("Открыть файл")
    подсказкаРус = КраткВыз1_1.Подсказка()
    ВывестиСтрокуВКонсоль("    УстановитьПодсказку('Открыть файл') -> Подсказка(): " + подсказкаРус + " (ожидается 'Открыть файл')")
    
    // ===== 7. ИДЕНТИФИКАТОР И РОДИТЕЛЬ =====
    ид = КраткВыз1_1.getIdValue()
    родитель = КраткВыз1_1.getParentWidgetValue()
    ВывестиСтрокуВКонсоль("    getIdValue(): " + ид + " (ожидается >= 0)")
    ВывестиСтрокуВКонсоль("    getParentWidgetValue(): " + (родитель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    идРус = КраткВыз1_1.Идентификатор()
    родительРус = КраткВыз1_1.РодительскийВиджет()
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + идРус + " (ожидается >= 0)")
    ВывестиСтрокуВКонсоль("    РодительскийВиджет(): " + (родительРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 8. ПОСЛЕДОВАТЕЛЬНОСТИ КЛЮЧЕЙ =====
    посл1 = КраткВыз1_1.keySequence("Ctrl+Shift+S")
    посл2 = КраткВыз1_1.standardKeyText(1)
    ВывестиСтрокуВКонсоль("    keySequence(Ctrl+Shift+S): " + посл1.toString())
    ВывестиСтрокуВКонсоль("    standardKeyText(Save): " + посл2)
    
    посл1Рус = КраткВыз1_1.ПоследовательностьКлючей("Ctrl+Shift+O")
    посл2Рус = КраткВыз1_1.СтандартныйКлюч(1)
    ВывестиСтрокуВКонсоль("    ПоследовательностьКлючей(Ctrl+Shift+O): " + посл1Рус.toString())
    ВывестиСтрокуВКонсоль("    СтандартныйКлюч(Save): " + посл2Рус)
    
    // ===== 9. СОЗДАНИЕ ПОСЛЕДОВАТЕЛЬНОСТИ ИЗ КЛЮЧЕЙ =====
    посл3 = КраткВыз1_1.keySequenceFromKeys("Ctrl", "Shift", "S")
    ВывестиСтрокуВКонсоль("    keySequenceFromKeys(Ctrl, Shift, S): " + посл3.toString())
    
    посл3Рус = КраткВыз1_1.ПоследовательностьИзКлючей("Ctrl", "Alt", "O")
    ВывестиСтрокуВКонсоль("    ПоследовательностьИзКлючей(Ctrl, Alt, O): " + посл3Рус.toString())
    
    // ===== 10. КОЛБЭК, КОПИРОВАНИЕ, РЕАЛЬНЫЙ ОБЪЕКТ =====
    вызвано = ЛОЖЬ
    КраткВыз1_1.setCallback(function() {
        вызвано = ИСТИНА
    })
    реальный = КраткВыз1_1.getRealShortcut()
    КраткВыз1_2 = Новый QtКраткийВызов(виджет)
    КраткВыз1_2.РежимОтладки(Режим_Отладки)
    результатКопия = КраткВыз1_1.copyTo(КраткВыз1_2)
    ВывестиСтрокуВКонсоль("    setCallback(): УСПЕШНО")
    ВывестиСтрокуВКонсоль("    getRealShortcut(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    вызвано2 = ЛОЖЬ
    КраткВыз1_1.УстановитьКолбэк(function() {
        вызвано2 = ИСТИНА
    })
    реальныйРус = КраткВыз1_1.ПолучитьКраткийВызов()
    КраткВыз1_3 = Новый QtКраткийВызов(виджет)
    КраткВыз1_3.РежимОтладки(Режим_Отладки)
    результатКопияРус = КраткВыз1_1.КопироватьВ(КраткВыз1_3)
    ВывестиСтрокуВКонсоль("    УстановитьКолбэк(): УСПЕШНО")
    ВывестиСтрокуВКонсоль("    ПолучитьКраткийВызов(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результатКопияРус + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof КраткВыз1_1.RusFunc === 'function' Тогда
        jsonStr = КраткВыз1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // Закрываем виджет
    виджет.Скрыть()
    
    ВывестиСтрокуВКонсоль("==== Тест QtShortcut (QtКраткийВызов) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБлочноеРасположение()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
