    КонецЕсли
    
    // ===== 14. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ =====
    имеетЗапущен = typeof ЦиклСоб1_1.Запущен === 'function'
    имеетДействителен = typeof ЦиклСоб1_1.Действителен === 'function'
