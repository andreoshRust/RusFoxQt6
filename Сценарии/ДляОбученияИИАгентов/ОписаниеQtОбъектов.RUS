//│ 33 │ Пустой                         │ isEmptyValue                   │
//│ 34 │ Геометрия                      │ getGeometryValue               │
//│ 35 │ ПрямоугольникСодержимого       │ getContentsRectValue           │
//│ 36 │ УстановитьОтступ               │ setMarginValue                 │
//│ 37 │ Отступ                         │ getMarginValue                 │
//│ 38 │ УстановитьЛевыйОтступ          │ setLeftMarginValue             │
//│ 39 │ ЛевыйОтступ                    │ getLeftMarginValue             │
//│ 40 │ УстановитьПравыйОтступ         │ setRightMarginValue            │
//│ 41 │ ПравыйОтступ                   │ getRightMarginValue            │
//│ 42 │ УстановитьВерхнийОтступ        │ setTopMarginValue              │
//│ 43 │ ВерхнийОтступ                  │ getTopMarginValue              │
//│ 44 │ УстановитьНижнийОтступ         │ setBottomMarginValue           │
//│ 45 │ НижнийОтступ                   │ getBottomMarginValue           │
//│ 46 │ УстановитьПромежуток           │ setSpacingValue                │
//│ 47 │ Промежуток                     │ getSpacingValue                │
//│ 48 │ УстановитьДоступен             │ setEnabledValue                │
//│ 49 │ Доступен                       │ isEnabledValue                 │
//│ 50 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 51 │ ИмяОбъекта                     │ getObjectName                  │
//│ 52 │ ТипРасположения                │ getLayoutTypeValue             │
//│ 53 │ ТипРасположенияСтрока          │ layoutTypeString               │
//│ 54 │ КопироватьВ                    │ copyTo                         │
//│ 55 │ Расположение                   │ getRealLayout                  │
//│ 56 │ КолЭлементов                   │ getCountValue                  │
//│ 57 │ Пусто                          │ isEmptyValue                   │
//│ 58 │ Отступы                        │ getMarginValue                 │
//│ 59 │ Промежутки                     │ getSpacingValue                │
//│ 60 │ Тип                            │ getLayoutTypeValue             │
//│ 61 │ Направление                    │ direction                      │
//│ 62 │ УстановитьНаправление          │ setDirection                   │
//│ 63 │ НаправлениеСтрока              │ directionString                │
//│ 64 │ Вертикальный                   │ isVertical                     │
//│ 65 │ Горизонтальный                 │ isHorizontal                   │
//│ 66 │ Верт                           │ isVertical                     │
//│ 67 │ Гориз                          │ isHorizontal                   │
//│ 68 │ Напр                           │ direction                      │
//│ 69 │ ДобавитьВиджет                 │ addWidget                      │
//│ 70 │ ДобавитьВиджетВКонец           │ addWidgetEnd                   │
//│ 71 │ ДобавитьОтступ                 │ addSpacing                     │
//│ 72 │ ДобавитьРастяжение             │ addStretch                     │
//│ 73 │ ДобавитьРасположение           │ addLayout                      │
//│ 74 │ ВставитьВиджет                 │ insertWidget                   │
//│ 75 │ ВставитьОтступ                 │ insertSpacing                  │
//│ 76 │ ВставитьРастяжение             │ insertStretch                  │
//│ 77 │ ВставитьРасположение           │ insertLayout                   │
//│ 78 │ УстановитьРастяжение           │ setStretch                     │
//│ 79 │ Растяжение                     │ stretch                        │
//│ 80 │ Раст                           │ stretch                        │
//│ 81 │ УстановитьПромежуток           │ setSpacing                     │
//│ 82 │ Промежуток                     │ spacing                        │
//│ 83 │ Промежутки                     │ spacing                        │
//│ 84 │ УстановитьОтступ               │ setMargin                      │
//│ 85 │ Отступ                         │ margin                         │
//│ 86 │ Отступы                        │ margin                         │
//│ 87 │ УстановитьВерхнийОтступ        │ setTopMarginValue              │
//│ 88 │ ВерхнийОтступ                  │ getTopMarginValue              │
//│ 89 │ УстановитьНижнийОтступ         │ setBottomMarginValue           │
//│ 90 │ НижнийОтступ                   │ getBottomMarginValue           │
//│ 91 │ УстановитьЛевыйОтступ          │ setLeftMarginValue             │
//│ 92 │ ЛевыйОтступ                    │ getLeftMarginValue             │
//│ 93 │ УстановитьПравыйОтступ         │ setRightMarginValue            │
//│ 94 │ ПравыйОтступ                   │ getRightMarginValue            │
//│ 95 │ Количество                     │ getCountValue                  │
//│ 96 │ КолЭлементов                   │ getCountValue                  │
//│ 97 │ Пустой                         │ isEmptyValue                   │
//│ 98 │ Пусто                          │ isEmptyValue                   │
//│ 99 │ Геометрия                      │ getGeometryValue               │
//│ 100 │ ПрямоугольникСодержимого       │ getContentsRectValue           │
//│ 101 │ Тип                            │ getLayoutTypeValue             │
//│ 102 │ ТипРасположения                │ getLayoutTypeValue             │
//│ 103 │ ТипРасположенияСтрока          │ layoutTypeString               │
//│ 104 │ УстановитьДоступен             │ setEnabled                     │
//│ 105 │ Доступен                       │ isEnabled                      │
//│ 106 │ Активировать                   │ activate                       │
//│ 107 │ Инвалидировать                 │ invalidate                     │
//│ 108 │ Обновить                       │ updateLayout                   │
//│ 109 │ Очистить                       │ clear                          │
//│ 110 │ УдалитьВиджет                  │ removeWidget                   │
//│ 111 │ ВзятьПоИндексу                 │ takeAt                         │
//│ 112 │ ЭлементПоИндексу               │ itemAt                         │
//│ 113 │ РодительскийВиджет             │ getParentWidget                │
//│ 114 │ УстановитьРодительскийВиджет   │ setParentWidget                │
//│ 115 │ ПолучитьБлочноеРасположение    │ getRealBoxLayout               │
//│ 116 │ ПолучитьРасположение           │ getRealLayout                  │
//│ 117 │ Расположение                   │ getRealLayout                  │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtBoxLayout (QtБлочноеРасположение) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    БлРасп1_1 = Новый QtБлочноеРасположение()
    БлРасп1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = БлРасп1_1.isValid()
    валидныйРус = БлРасп1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. НАПРАВЛЕНИЕ =====
    направление = БлРасп1_1.Направление()
    направлениеСтр = БлРасп1_1.НаправлениеСтрока()
    вертикальный = БлРасп1_1.Вертикальный()
    горизонтальный = БлРасп1_1.Горизонтальный()
    ВывестиСтрокуВКонсоль("    Направление(): " + направление + ", НаправлениеСтрока(): " + направлениеСтр)
    ВывестиСтрокуВКонсоль("    Вертикальный(): " + вертикальный + ", Горизонтальный(): " + горизонтальный)
    
    // ===== 4. МЕТОДЫ ДОБАВЛЕНИЯ =====
    имеетAddWidget = typeof БлРасп1_1.addWidget === 'function'
    имеетДобавитьВиджет = typeof БлРасп1_1.ДобавитьВиджет === 'function'
    имеетAddStretch = typeof БлРасп1_1.addStretch === 'function'
    имеетДобавитьРастяжение = typeof БлРасп1_1.ДобавитьРастяжение === 'function'
    имеетAddSpacing = typeof БлРасп1_1.addSpacing === 'function'
    имеетДобавитьОтступ = typeof БлРасп1_1.ДобавитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
    
    // ===== 5. МЕТОДЫ ВСТАВКИ =====
    имеетInsertWidget = typeof БлРасп1_1.insertWidget === 'function'
    имеетВставитьВиджет = typeof БлРасп1_1.ВставитьВиджет === 'function'
    имеетInsertStretch = typeof БлРасп1_1.insertStretch === 'function'
    имеетВставитьРастяжение = typeof БлРасп1_1.ВставитьРастяжение === 'function'
    имеетInsertSpacing = typeof БлРасп1_1.insertSpacing === 'function'
    имеетВставитьОтступ = typeof БлРасп1_1.ВставитьОтступ === 'function'
    ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
    
    // ===== 6. УПРАВЛЕНИЕ РАСТЯЖЕНИЕМ =====
    Попытка
        БлРасп1_1.УстановитьРастяжение(0, 5)
        растяжение = БлРасп1_1.Растяжение(0)
        БлРасп1_1.УстановитьРастяжение(0, 3)
        растяжениеРус = БлРасп1_1.Растяжение(0)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,5) -> Растяжение(0): " + растяжение + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0,3) -> Растяжение(0): " + растяжениеРус + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("    Управление растяжением: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. РАБОТА С ВЛОЖЕННЫМИ LAYOUT =====
    имеетAddLayout = typeof БлРасп1_1.addLayout === 'function'
    имеетДобавитьРасположение = typeof БлРасп1_1.ДобавитьРасположение === 'function'
    имеетInsertLayout = typeof БлРасп1_1.insertLayout === 'function'
    имеетВставитьРасположение = typeof БлРасп1_1.ВставитьРасположение === 'function'
    ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    insertLayout(): " + (имеетInsertLayout ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ВставитьРасположение(): " + (имеетВставитьРасположение ? "✅" : "❌"))
    
    // ===== 8. ОТСТУПЫ, ПРОМЕЖУТКИ И ДОСТУПНОСТЬ =====
    Попытка
        БлРасп1_1.УстановитьОтступ(10)
        отступ = БлРасп1_1.Отступ()
        БлРасп1_1.УстановитьОтступ(15)
        отступРус = БлРасп1_1.Отступ()
        
        БлРасп1_1.УстановитьПромежуток(5)
        промежуток = БлРасп1_1.Промежуток()
        БлРасп1_1.УстановитьПромежуток(8)
        промежутокРус = БлРасп1_1.Промежуток()
        
        БлРасп1_1.УстановитьДоступен(ЛОЖЬ)
        доступен = БлРасп1_1.Доступен()
        БлРасп1_1.УстановитьДоступен(ИСТИНА)
        доступен2 = БлРасп1_1.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус + " (ожидается 10 / 15)")
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус + " (ожидается 5 / 8)")
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + " -> " + доступен2 + " (ожидается false -> true)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы/промежутки/доступность: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    реальный = БлРасп1_1.getRealBoxLayout()
    реальныйРус = БлРасп1_1.ПолучитьБлочноеРасположение()
    реальныйLayout = БлРасп1_1.getRealLayout()
    реальныйLayoutРус = БлРасп1_1.ПолучитьРасположение()
    ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. КОПИРОВАНИЕ =====
    БлРасп1_2 = Новый QtБлочноеРасположение()
    БлРасп1_2.РежимОтладки(Режим_Отладки)
    результатКопия = БлРасп1_1.copyTo(БлРасп1_2)
    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof БлРасп1_1.RusFunc === 'function' Тогда
        jsonStr = БлРасп1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtBoxLayout (QtБлочноеРасположение) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВертикальнаяКомпоновка()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                    │ Английский метод                │
//├─────┼──────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                     │ isValid                        │
//│ 2 │ ПолучитьОбъект                   │ getRealObject                  │
//│ 3 │ УстановитьРодителя               │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                 │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта             │ setObjectName                  │
//│ 6 │ ИмяОбъекта                       │ objectName                     │
//│ 7 │ УстановитьСвойство               │ setProperty                    │
//│ 8 │ Свойство                         │ property                       │
//│ 9 │ ПодключитьСигнал                 │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                  │ disconnectSignal               │
//│ 11 │ КопироватьВ                      │ copyTo                         │
//│ 12 │ РежимОтладки                     │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки             │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                │ getClassType                   │
//│ 15 │ УстановитьТипКласса              │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                │ getClassName                   │
//│ 17 │ УстановитьИмяКласса              │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов            │ RusFunc                        │
