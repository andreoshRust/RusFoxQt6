// Правила для опрераторов языка программирования:
// 1) Конструкция Если ... Тогда  должна располагаться на одной строке.
// 2) Все указатели на объекты в сценарии должны иметь уникальные имена.
// 3) Указатели, созданные не через оператор "Новый" или "new" имеют только английские имена методов.

Пусть Режим_Отладки = ИСТИНА
Функция Методы_QtString()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Установить                     │ setString                      │
//│ 20 │ Получить                       │ getString                      │
//│ 21 │ ВСтроку                        │ toString                       │
//│ 22 │ Длина                          │ length                         │
//│ 23 │ Размер                         │ size                           │
//│ 24 │ Пустой                         │ isEmpty                        │
//│ 25 │ Пусто                          │ isNull                         │
//│ 26 │ Очистить                       │ clear                          │
//│ 27 │ Копировать                     │ copy                           │
//│ 28 │ СимволИзКода                   │ charFromCode                   │
//│ 29 │ СимволИзПозиции                │ at                             │
//│ 30 │ КодСимвола                     │ charCodeAt                     │
//│ 31 │ Лев                            │ left                           │
//│ 32 │ Прав                           │ right                          │
//│ 33 │ Сред                           │ mid                            │
//│ 34 │ ВНижнийРегистр                 │ toLower                        │
//│ 35 │ ВВерхнийРегистр                │ toUpper                        │
//│ 36 │ Сократить                      │ trimmed                        │
//│ 37 │ Упростить                      │ simplified                     │
//│ 38 │ Найти                          │ indexOf                        │
//│ 39 │ НайтиПоследний                 │ lastIndexOf                    │
//│ 40 │ Содержит                       │ contains                       │
//│ 41 │ НачинаетсяС                    │ startsWith                     │
//│ 42 │ ЗаканчиваетсяНа                │ endsWith                       │
//│ 43 │ КоличествоВхождений            │ count                          │
//│ 44 │ Заменить                       │ replace                        │
//│ 45 │ Удалить                        │ remove                         │
//│ 46 │ Добавить                       │ append                         │
//│ 47 │ ДобавитьВНачало                │ prepend                        │
//│ 48 │ Вставить                       │ insert                         │
//│ 49 │ Разделить                      │ split                          │
//│ 50 │ Секция                         │ section                        │
//│ 51 │ Арг                            │ arg                            │
//│ 52 │ Арг2                           │ arg2                           │
//│ 53 │ Арг3                           │ arg3                           │
//│ 54 │ ВЧисло                         │ toInt                          │
//│ 55 │ ВДробь                         │ toDouble                       │
//│ 56 │ ВFloat                         │ toFloat                        │
//│ 57 │ Сравнить                       │ compare                        │
//│ 58 │ ЗаполнитьСлева                 │ leftJustified                  │
//│ 59 │ ЗаполнитьСправа                │ rightJustified                 │
//│ 60 │ Повторить                      │ repeated                       │
//│ 61 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("Примеры вызова методов объектов. Если обнаружаться ошибки, то запускайте тест объекта с ошибкой.")
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtString ===================================================")
    mQtString = Новый QtString("Тестовая строка для проверки методов QtString")
    mQtString.РежимОтладки(Режим_Отладки)
    
    mQtString.setString("Новое значение")                            // Новое значиние
    ВывестиСтрокуВКонсоль("  getString(): " + mQtString.getString())
    ВывестиСтрокуВКонсоль("  Получить():  "  + mQtString.Получить())
    ВывестиСтрокуВКонсоль("  toString():  "  + mQtString.toString())
    ВывестиСтрокуВКонсоль("  ВСтроку():   "   + mQtString.ВСтроку())
    
    mQtString.setString("Привет мир")
    ВывестиСтрокуВКонсоль("  length(): " + mQtString.length())
    ВывестиСтрокуВКонсоль("  Длина():  " + mQtString.Длина())
    ВывестиСтрокуВКонсоль("  size():   " + mQtString.size())
    ВывестиСтрокуВКонсоль("  Размер(): " + mQtString.Размер())
    
    mQtString.setString("")
    ВывестиСтрокуВКонсоль("  isEmpty(): " + mQtString.isEmpty())
    ВывестиСтрокуВКонсоль("  isNull(): "  + mQtString.isNull())
    ВывестиСтрокуВКонсоль("  Пустой() для пустой строки: " + mQtString.Пустой())
    ВывестиСтрокуВКонсоль("  Пусто() для пустой строки: " + mQtString.Пусто())
    mQtString.clear()
    mQtString.Очистить()
    ВывестиСтрокуВКонсоль("  Очистить(): строка очищена, длина=" + mQtString.Длина())
    
    mQtString.setString("Восстановлено")
    ВывестиСтрокуВКонсоль("  at(0): " + mQtString.at(0))
    ВывестиСтрокуВКонсоль("  at(5): " + mQtString.at(5))
    ВывестиСтрокуВКонсоль("  left(5): " + mQtString.left(5))
    ВывестиСтрокуВКонсоль("  right(5): " + mQtString.right(5))
    ВывестиСтрокуВКонсоль("  mid(5): " + mQtString.mid(5))
    ВывестиСтрокуВКонсоль("  mid(5, 10): " + mQtString.mid(5, 10))
    ВывестиСтрокуВКонсоль("  СимволИзПозиции(0): " + mQtString.СимволИзПозиции(0))
    ВывестиСтрокуВКонсоль("  СимволИзПозиции(5): " + mQtString.СимволИзПозиции(5))
    ВывестиСтрокуВКонсоль("  Лев(5): " + mQtString.Лев(5))
    ВывестиСтрокуВКонсоль("  Прав(5): " + mQtString.Прав(5))
    ВывестиСтрокуВКонсоль("  Сред(5): " + mQtString.Сред(5))
    ВывестиСтрокуВКонсоль("  Сред(5, 10): " + mQtString.Сред(5, 10))
    
    mQtString.setString("Test String For Check")
    ВывестиСтрокуВКонсоль("  Исходная: " + mQtString.getString())
    ВывестиСтрокуВКонсоль("  toUpper(): " + mQtString.toUpper())
    ВывестиСтрокуВКонсоль("  toLower(): " + mQtString.toLower())
    ВывестиСтрокуВКонсоль("  Исходная: "  + mQtString.Получить())
    ВывестиСтрокуВКонсоль("  ВВерхнийРегистр(): " + mQtString.ВВерхнийРегистр())
    ВывестиСтрокуВКонсоль("  ВНижнийРегистр(): "  + mQtString.ВНижнийРегистр())
    
    mQtString.setString("   Текст   с   пробелами   ")
    ВывестиСтрокуВКонсоль("  Исходная с пробелами: '" + mQtString.getString() + "'")
    ВывестиСтрокуВКонсоль("  trimmed(): '" + mQtString.trimmed() + "'")
    ВывестиСтрокуВКонсоль("  simplified(): '" + mQtString.simplified() + "'")
    mQtString.setString("   Текст   с   пробелами  рус ")
    ВывестиСтрокуВКонсоль("  Исходная с пробелами: '" + mQtString.Получить() + "'")
    ВывестиСтрокуВКонсоль("  Сократить(): '" + mQtString.Сократить() + "'")
    ВывестиСтрокуВКонсоль("  Упростить(): '" + mQtString.Упростить() + "'")  
    
    mQtString.setString("The quick brown fox jumps over the lazy dog")
    ВывестиСтрокуВКонсоль("    indexOf('quick')  : " + mQtString.indexOf("quick"))
    ВывестиСтрокуВКонсоль("    indexOf('fox')    : " + mQtString.indexOf("fox"))
    ВывестиСтрокуВКонсоль("    indexOf('the', 20): " + mQtString.indexOf("the", 20))
    ВывестиСтрокуВКонсоль("    lastIndexOf('the'): " + mQtString.lastIndexOf("the")) 
    ВывестиСтрокуВКонсоль("    contains('fox')        : " + mQtString.contains("fox"))
    ВывестиСтрокуВКонсоль("    contains('CAT', ЛОЖЬ)  : " + mQtString.contains("CAT", ЛОЖЬ))
    ВывестиСтрокуВКонсоль("    startsWith('The')      : " + mQtString.startsWith("The"))
    ВывестиСтрокуВКонсоль("    startsWith('the', ЛОЖЬ): " + mQtString.startsWith("the", ЛОЖЬ))
    ВывестиСтрокуВКонсоль("    endsWith('dog')        : " + mQtString.endsWith("dog"))
    
    mQtString.setString("The quick brown fox jumps over the lazy dog")
    ВывестиСтрокуВКонсоль("  Найти('quick') : " + mQtString.Найти("quick"))
    ВывестиСтрокуВКонсоль("  Найти('fox')   : " + mQtString.Найти("fox"))
    ВывестиСтрокуВКонсоль("  Найти('zebra') : " + mQtString.Найти("zebra")) 
    ВывестиСтрокуВКонсоль("  НайтиПоследний('e'): " + mQtString.НайтиПоследний("e"))
    ВывестиСтрокуВКонсоль("  Содержит('fox')       : " + mQtString.Содержит("fox"))
    ВывестиСтрокуВКонсоль("  Содержит('CAT', ЛОЖЬ) : " + mQtString.Содержит("CAT", ЛОЖЬ))
    ВывестиСтрокуВКонсоль("  НачинаетсяС('The')    : " + mQtString.НачинаетсяС("The"))
    ВывестиСтрокуВКонсоль("  ЗаканчиваетсяНа('dog'): " + mQtString.ЗаканчиваетсяНа("dog"))
    
    mQtString.setString("Быстрая коричневая лиса прыгает через ленивую собаку")
    ВывестиСтрокуВКонсоль("    indexOf('лиса')      : " + mQtString.indexOf("лиса"))
    ВывестиСтрокуВКонсоль("    indexOf('собаку')    : " + mQtString.indexOf("собаку"))
    ВывестиСтрокуВКонсоль("    indexOf('зебра')     : " + mQtString.indexOf("зебра"))
    ВывестиСтрокуВКонсоль("    lastIndexOf('а')     : " + mQtString.lastIndexOf("а"))
    ВывестиСтрокуВКонсоль("    contains('лиса')     : " + mQtString.contains("лиса"))
    ВывестиСтрокуВКонсоль("    contains('КОТ', ЛОЖЬ): " + mQtString.contains("КОТ", ЛОЖЬ))
    ВывестиСтрокуВКонсоль("    startsWith('Быстрая'): " + mQtString.startsWith("Быстрая"))
    ВывестиСтрокуВКонсоль("    endsWith('собаку')   : " + mQtString.endsWith("собаку"))
    
    mQtString.setString("Быстрая коричневая лиса прыгает через ленивую собаку")
    ВывестиСтрокуВКонсоль("  Найти('лиса'): " + mQtString.Найти("лиса"))
    ВывестиСтрокуВКонсоль("  Найти('собаку'): " + mQtString.Найти("собаку"))
    ВывестиСтрокуВКонсоль("  Найти('зебра'): " + mQtString.Найти("зебра"))
    ВывестиСтрокуВКонсоль("  Содержит('лиса'): " + mQtString.Содержит("лиса"))
    ВывестиСтрокуВКонсоль("  Содержит('КОТ', ЛОЖЬ): " + mQtString.Содержит("КОТ", ЛОЖЬ))
    ВывестиСтрокуВКонсоль("  НачинаетсяС('Быстрая'): " + mQtString.НачинаетсяС("Быстрая"))
    ВывестиСтрокуВКонсоль("  ЗаканчиваетсяНа('собаку'): " + mQtString.ЗаканчиваетсяНа("собаку")) 
    
    mQtString.setString("Hello World")
    mQtString.replace("World", "Qt")
    ВывестиСтрокуВКонсоль("  replace: " + mQtString.getString())
    
    mQtString.setString("Hello World")
    mQtString.Заменить("World", "Qt")
    ВывестиСтрокуВКонсоль("  Заменить('World', 'Qt'): " + mQtString.Получить())
    
    mQtString.setString("Hello!!! World!!!")
    mQtString.remove("!!!")
    ВывестиСтрокуВКонсоль("  remove: " + mQtString.getString())
    
    mQtString.setString("Hello!!! World!!!")
    mQtString.Удалить("!!!")
    ВывестиСтрокуВКонсоль("  Удалить('!!!'): " + mQtString.Получить())
    
    mQtString.setString("Hello")
    mQtString.append(" World")
    ВывестиСтрокуВКонсоль("  append: " + mQtString.getString())
    
    mQtString.setString("Hello")
    mQtString.Добавить(" World")
    ВывестиСтрокуВКонсоль("  Добавить(' World'): " + mQtString.Получить())
    
    mQtString.setString("World")
    mQtString.prepend("Hello ")
    ВывестиСтрокуВКонсоль("  prepend: " + mQtString.getString())
    
    mQtString.setString("World")
    mQtString.ДобавитьВНачало("Hello ")
    ВывестиСтрокуВКонсоль("  ДобавитьВНачало('Hello '): " + mQtString.Получить())   
    
    mQtString.setString("HelloWorld")
    mQtString.insert(5, " ")
    ВывестиСтрокуВКонсоль("  insert: " + mQtString.getString())
    mQtString.setString("HelloWorld")
    mQtString.Вставить(5, " ")
    ВывестиСтрокуВКонсоль("  Вставить(5, ' '): " + mQtString.Получить())        
    
    mQtString.setString("яблоко,банан,вишня,апельсин")
    части = mQtString.split(",")
    ВывестиСтрокуВКонсоль("  split(','):")
    ВывестиСтрокуВКонсоль("    [0]=" + части[0])
    ВывестиСтрокуВКонсоль("    [1]=" + части[1])
    ВывестиСтрокуВКонсоль("    [2]=" + части[2])
    ВывестиСтрокуВКонсоль("    [3]=" + части[3])
    части = mQtString.Разделить(",")
    ВывестиСтрокуВКонсоль("  Разделить(','):")
    ВывестиСтрокуВКонсоль("    [0]=" + части[0])
    ВывестиСтрокуВКонсоль("    [1]=" + части[1])
    ВывестиСтрокуВКонсоль("    [2]=" + части[2])
    ВывестиСтрокуВКонсоль("    [3]=" + части[3])    

    mQtString.setString("a,b,c,d,e,f,g")
    ВывестиСтрокуВКонсоль("  section(',', 2): "     + mQtString.section(",", 2))
    ВывестиСтрокуВКонсоль("  section(',', 2, 4): "  + mQtString.section(",", 2, 4))
    ВывестиСтрокуВКонсоль("  Секция(',', 2): "      + mQtString.Секция(",", 2))
    ВывестиСтрокуВКонсоль("  Секция(',', 2, 4): "   + mQtString.Секция(",", 2, 4))
    
    mQtString.setString("%1 + %2 = %3")
    результат = mQtString.arg3(2, 3, 5)
    ВывестиСтрокуВКонсоль("  arg3(2, 3, 5): " + результат)
    результат = mQtString.Арг3(2, 3, 5)
    ВывестиСтрокуВКонсоль("  Арг3(2, 3, 5): " + результат)
    
    mQtString.setString("User: %1, Age: %2")
    результат = mQtString.Арг2("John", "30")
    ВывестиСтрокуВКонсоль("  Арг2('John', '30'): " + результат)
    
    имя = "Иван"
    возраст = 25
    результат = "User: " + имя + ", Age: " + возраст
    ВывестиСтрокуВКонсоль("  конкатенация: " + результат)   
    
    mQtString.setString("123")
    ВывестиСтрокуВКонсоль("  toInt('123'): "  + mQtString.toInt())   
    ВывестиСтрокуВКонсоль("  ВЧисло('123'): " + mQtString.ВЧисло())
    
    mQtString.setString("3.14159")
    ВывестиСтрокуВКонсоль("  toDouble('3.14159'): " + mQtString.toDouble())
    ВывестиСтрокуВКонсоль("  ВДробь('3.14159'): "   + mQtString.ВДробь())
    ВывестиСтрокуВКонсоль("  ВFloat('3.14159'): "   + mQtString.ВFloat())
    
    mQtString.setString(String(42))
    ВывестиСтрокуВКонсоль("  Из числа 42: " + mQtString.getString())
    ВывестиСтрокуВКонсоль("  Из числа 42: " + mQtString.Получить())
    
    mQtString.setString(String(3.14159))
    ВывестиСтрокуВКонсоль("  Из дроби 3.14159: " + mQtString.getString())
    ВывестиСтрокуВКонсоль("  Из дроби 3.14159: " + mQtString.Получить())

    mQtString.setString("  Hello   World  ")
    ВывестиСтрокуВКонсоль("  Исходная: '" + mQtString.getString() + "'")
    новаяСтрока = mQtString.trimmed()
    новаяСтрока = mQtString.Сократить()  // Объекты, создаваемые не через Новый не имеют русских методов
    ВывестиСтрокуВКонсоль("  после trimmed(): '" + новаяСтрока + "'")
    mQtString.replace(" ", "_")
    ВывестиСтрокуВКонсоль("  после replace(' ', '_'): '" + mQtString.getString() + "'")
    новаяСтрока2 = mQtString.toUpper()
    ВывестиСтрокуВКонсоль("  после toUpper(): '" + новаяСтрока2 + "'")
    
    шаг2 = Новый QtString(новаяСтрока)  // этот имеет русские методы
    шаг2.Заменить(" ", "_")
    ВывестиСтрокуВКонсоль("  после Заменить(' ', '_'): '" + шаг2.getString() + "'")
    шаг3 = шаг2.ВВерхнийРегистр()
    ВывестиСтрокуВКонсоль("  после ВВерхнийРегистр(): '" + шаг3 + "'")

  ВывестиСтрокуВКонсоль("===  Тест QtString завершён.====================================================") 
  ВывестиСтрокуВКонсоль("") 

КонецФункции

Функция Методы_СпецСимволы()
  ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА СпецСимволы =====================================================")
  ВывестиСтрокуВКонсоль("  ✅ Chars.CR (Возврат каретки) = " + КодСимвола(Chars.CR)) // 13
  ВывестиСтрокуВКонсоль("  ✅ Chars.ВК (Возврат каретки) = " + КодСимвола(Chars.ВК)) // 13

  ВывестиСтрокуВКонсоль("  ✅ Chars.LF (Перенос строки) = " + КодСимвола(Chars.LF))  // 10
  ВывестиСтрокуВКонсоль("  ✅ Chars.ПС (Перенос строки) = " + КодСимвола(Chars.ПС))  // 10
  
  ВывестиСтрокуВКонсоль("  ✅ Chars.TAB (Горизонтальная табуляция) = " + КодСимвола(Chars.TAB))  // 9
  ВывестиСтрокуВКонсоль("  ✅ Chars.Таб (Горизонтальная табуляция) = " + КодСимвола(Chars.Таб))  // 9
  
  ВывестиСтрокуВКонсоль("  ✅ Chars.VTAB (Вертикальная табуляция) = " + КодСимвола(Chars.VTAB))  // 11
  ВывестиСтрокуВКонсоль("  ✅ Chars.ВТаб (Вертикальная табуляция) = " + КодСимвола(Chars.ВТаб))  // 11
  
  ВывестиСтрокуВКонсоль("  ✅ Chars.FF (Перевод страницы) = " + КодСимвола(Chars.FF)) // 12
  ВывестиСтрокуВКонсоль("  ✅ Chars.ПФ (Перевод страницы) = " + КодСимвола(Chars.ПФ)) // 12
  
  ВывестиСтрокуВКонсоль("  ✅ Chars.NBSP (Неразрывный пробел) = " + КодСимвола(Chars.NBSP))  // 160
  ВывестиСтрокуВКонсоль("  ✅ Chars.НПП (Неразрывный пробел) = " + КодСимвола(Chars.НПП))  // 160
  
  латиница = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()"
  списокСимволов = Символы(латиница)
  длинаСписка = списокСимволов.length
  ВывестиСтрокуВКонсоль("  Проверка " + длинаСписка + " символов латиницы.")
  
  кириллица = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя"
  списокСимволов = Символы(кириллица)
  длинаСписка = списокСимволов.length
  ВывестиСтрокуВКонсоль("  Проверка " + длинаСписка + " символов кириллицы.")
  
  ВывестиСтрокуВКонсоль("  ✅ КодСимвола('A') = " + КодСимвола("A"))
  ВывестиСтрокуВКонсоль("  ✅ КодСимвола('Z') = " + КодСимвола("Z"))
  ВывестиСтрокуВКонсоль("  ✅ КодСимвола('Я') = " + КодСимвола("Я"))
  ВывестиСтрокуВКонсоль("  ✅ КодСимвола('ё') = " + КодСимвола("ё"))
  
  ВывестиСтрокуВКонсоль("  ✅ Символ(65) = '" + Символ(65) + "'")
  ВывестиСтрокуВКонсоль("  ✅ Chars[\"Таб\"] = " + КодСимвола(Chars["Таб"]))
  
  ВывестиСтрокуВКонсоль("===  Тест СпецСимволы завершён.================================================") 
  ВывестиСтрокуВКонсоль("") 
  
КонецФункции

Функция Методы_QtБазовыйТаймер()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startValue                     │
//│ 20 │ ЗапуститьСИнтервалом           │ startWithInterval              │
//│ 21 │ Остановить                     │ stopValue                      │
//│ 22 │ Активен                        │ isActiveValue                  │
//│ 23 │ ОставшеесяВремя                │ getRemainingTimeValue          │
//│ 24 │ УстановитьИнтервал             │ setIntervalValue               │
//│ 25 │ ПолучитьИнтервал               │ getIntervalValue               │
//│ 26 │ УстановитьОднократный          │ setSingleShotValue             │
//│ 27 │ Однократный                    │ isSingleShotValue              │
//│ 28 │ УстановитьКолбэк               │ setCallback                    │
//│ 29 │ ОднократныйЗапуск              │ singleShotValue                │
//│ 30 │ ПолучитьТаймер                 │ getRealTimer                   │
//│ 31 │ КопироватьВ                    │ copyTo                         │
//│ 32 │ Действителен                   │ isValidValue                   │
//│ 33 │ Запуск                         │ startValue                     │
//│ 34 │ Стоп                           │ stopValue                      │
//│ 35 │ Интервал                       │ getIntervalValue               │
//│ 36 │ ВремяОжидания                  │ getRemainingTimeValue          │
//│ 37 │ Действителен                   │ isValid                        │
//│ 38 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 39 │ РежимОтладки                   │ setDebug                       │
//│ 40 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 41 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 42 │ ИмяОбъекта                     │ objectName                     │
//│ 43 │ Запустить                      │ startValue                     │
//│ 44 │ ЗапуститьСМетодом              │ startWithMethod                │
//│ 45 │ Остановить                     │ stopValue                      │
//│ 46 │ Активен                        │ isActiveValue                  │
//│ 47 │ Идентификатор                  │ getTimerIdValue                │
//│ 48 │ Интервал                       │ getIntervalValue               │
//│ 49 │ Действителен                   │ isValidValue                   │
//│ 50 │ КопироватьВ                    │ copyTo                         │
//│ 51 │ УстановитьОднократный          │ setSingleShotValue             │
//│ 52 │ Однократный                    │ isSingleShotValue              │
//│ 53 │ ОсталосьДо                     │ remainingTime                  │
//│ 54 │ Истек                          │ hasExpired                     │
//│ 55 │ ПолучитьТаймер                 │ getRealTimer                   │
//│ 56 │ Запуск                         │ startValue                     │
//│ 57 │ Стоп                           │ stopValue                      │
//│ 58 │ IDТаймера                      │ getTimerIdValue                │
//│ 59 │ ВремяОжидания                  │ remainingTime                  │
//└─────┴────────────────────────────────┴────────────────────────────────┘

   ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtБазовыйТаймер() ===============================================")
   таймер = Новый QtБазовыйТаймер()
   таймер.РежимОтладки(Режим_Отладки)
    активен = таймер.Активен()
    идентификатор = таймер.Идентификатор()
    ВывестиСтрокуВКонсоль("    Активен(): " + активен + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается 0)")
    
    цикл1 = Новый QtЦиклСобытий()
    таймер.Запустить(300, Функция() { сработал = ИСТИНА; цикл1.Выйти()        })
    активен = таймер.Активен()
    идентификатор = таймер.Идентификатор()
    ВывестиСтрокуВКонсоль("    После запуска Активен(): " + активен + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается > 0)")
    цикл1.Запустить()
    таймер.Остановить()  
    ВывестиСтрокуВКонсоль("    Колбэк сработал: " + сработал + " (ожидается true)")
    
    сработалМетод = false
    цикл2 = Новый QtЦиклСобытий()
    таймер.Запустить(300, Функция() {   сработалМетод = ИСТИНА;     цикл2.Выйти()    })
    цикл2.Запустить()
    таймер.Остановить()
    ВывестиСтрокуВКонсоль("    Метод сработал: " + сработалМетод + " (ожидается true)")    
    
    таймер.Запустить(1000, Функция() {})
    таймер.Остановить()
    активен = таймер.Активен()
    идентификатор = таймер.Идентификатор()
    ВывестиСтрокуВКонсоль("    После остановки Активен(): " + активен + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается 0)")  
    
    тестИнтервал = 1500
    таймер.Запустить(тестИнтервал, Функция() {})
    интервал = таймер.Интервал()
    таймер.Остановить()
    ВывестиСтрокуВКонсоль("    Интервал(): " + интервал + " (ожидается " + тестИнтервал + ")")
    действителен = таймер.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен(): " + действителен + " (ожидается true)")  
    
    цель = Новый QtБазовыйТаймер()
    цель.РежимОтладки(Режим_Отладки)
    результат = таймер.КопироватьВ(цель)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат)
    
    таймер.УстановитьОднократный(ИСТИНА)
    однократный = таймер.Однократный()
    ВывестиСтрокуВКонсоль("    УстановитьОднократный(true) -> Однократный(): " + однократный + " (ожидается true)")
 
    таймер.УстановитьОднократный(ЛОЖЬ)
    однократный2 = таймер.Однократный()
    ВывестиСтрокуВКонсоль("    УстановитьОднократный(false) -> Однократный(): " + однократный2 + " (ожидается false)") 

    сработалПовтор = ЛОЖЬ
    циклПовтор = Новый QtЦиклСобытий()
    таймер.Запустить(200, Функция() {  сработалПовтор = ИСТИНА;   циклПовтор.Выйти()  })
    циклПовтор.Запустить()
    таймер.Остановить()
    сработалПовтор2 = ЛОЖЬ
    циклПовтор2 = Новый QtЦиклСобытий()
    таймер.Запустить(200, Функция() {    сработалПовтор2 = ИСТИНА;  циклПовтор2.Выйти() })
    циклПовтор2.Запустить()
    таймер.Остановить()
    ВывестиСтрокуВКонсоль("    Первый запуск сработал: " + сработалПовтор + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Второй запуск сработал: " + сработалПовтор2 + " (ожидается true)")

    таймер.Остановить()
    таймер.Запустить(500, Функция() {})
    активен = таймер.Активен()
    ид = таймер.Идентификатор()
    интервал = таймер.Интервал()
    таймер.Остановить()
    ВывестиСтрокуВКонсоль("    Активен(): " + активен + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Идентификатор(): " + ид + " (ожидается > 0)")
    ВывестиСтрокуВКонсоль("    Интервал(): " + интервал + " (ожидается 500)")    
    
    ВывестиСтрокуВКонсоль("==== Тест QtБазовыйТаймер завершён.=============================================") 
    ВывестиСтрокуВКонсоль("") 

КонецФункции

Функция Методы_QtДедлайнТаймер()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬─────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                   │ Английский метод                │
//├─────┼─────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                    │ isValid                        │
//│ 2 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 3 │ УстановитьРодителя              │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 6 │ ИмяОбъекта                      │ objectName                     │
//│ 7 │ УстановитьСвойство              │ setProperty                    │
//│ 8 │ Свойство                        │ property                       │
//│ 9 │ ПодключитьСигнал                │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                 │ disconnectSignal               │
//│ 11 │ КопироватьВ                     │ copyTo                         │
//│ 12 │ РежимОтладки                    │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 14 │ ПолучитьТипКласса               │ getClassType                   │
//│ 15 │ УстановитьТипКласса             │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса               │ getClassName                   │
//│ 17 │ УстановитьИмяКласса             │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов           │ RusFunc                        │
//│ 19 │ Запустить                       │ startValue                     │
//│ 20 │ ЗапуститьСИнтервалом            │ startWithInterval              │
//│ 21 │ Остановить                      │ stopValue                      │
//│ 22 │ Активен                         │ isActiveValue                  │
//│ 23 │ ОставшеесяВремя                 │ getRemainingTimeValue          │
//│ 24 │ УстановитьИнтервал              │ setIntervalValue               │
//│ 25 │ ПолучитьИнтервал                │ getIntervalValue               │
//│ 26 │ УстановитьОднократный           │ setSingleShotValue             │
//│ 27 │ Однократный                     │ isSingleShotValue              │
//│ 28 │ УстановитьКолбэк                │ setCallback                    │
//│ 29 │ ОднократныйЗапуск               │ singleShotValue                │
//│ 30 │ ПолучитьТаймер                  │ getRealTimer                   │
//│ 31 │ КопироватьВ                     │ copyTo                         │
//│ 32 │ Действителен                    │ isValidValue                   │
//│ 33 │ Запуск                          │ startValue                     │
//│ 34 │ Стоп                            │ stopValue                      │
//│ 35 │ Интервал                        │ getIntervalValue               │
//│ 36 │ ВремяОжидания                   │ getRemainingTimeValue          │
//│ 37 │ Действителен                    │ isValid                        │
//│ 38 │ ПолучитьОбъект                  │ getRealObject                  │
//│ 39 │ РежимОтладки                    │ setDebug                       │
//│ 40 │ ПолучитьРежимОтладки            │ getDebug                       │
//│ 41 │ УстановитьИмяОбъекта            │ setObjectName                  │
//│ 42 │ ИмяОбъекта                      │ objectName                     │
//│ 43 │ УстановитьДедлайн               │ setDeadlineValue               │
//│ 44 │ УстановитьОставшеесяВремя       │ setRemainingTimeValue          │
//│ 45 │ УстановитьОставшеесяВремяСТипом │ setRemainingTimeWithType       │
//│ 46 │ Дедлайн                         │ getDeadlineValue               │
//│ 47 │ ОставшеесяВремя                 │ getRemainingTimeInt64          │
//│ 48 │ ОставшеесяВремяНс               │ remainingTimeNSecs             │
//│ 49 │ Истек                           │ hasExpiredValue                │
//│ 50 │ Истёк                           │ hasExpiredValue                │
//│ 51 │ Очистить                        │ clearValue                     │
//│ 52 │ Перезапустить                   │ restartValue                   │
//│ 53 │ ПерезапуститьСТипом             │ restartWithType                │
//│ 54 │ Бесконечный                     │ isForeverValue                 │
//│ 55 │ ПолучитьТаймер                  │ getRealTimer                   │
//│ 56 │ Бесконечность                   │ getForever                     │
//│ 57 │ ТочныйТаймер                    │ getPreciseTimer                │
//│ 58 │ ГрубыйТаймер                    │ getCoarseTimer                 │
//│ 59 │ ОченьГрубыйТаймер               │ getVeryCoarseTimer             │
//│ 60 │ Действителен                    │ isValidValue                   │
//│ 61 │ Дедлайн                         │ getDeadlineValue               │
//│ 62 │ Осталось                        │ getRemainingTimeInt64          │
//│ 63 │ ОсталосьНс                      │ remainingTimeNSecs             │
//│ 64 │ ПроверитьИстек                  │ hasExpiredValue                │
//│ 65 │ Сбросить                        │ clearValue                     │
//│ 66 │ Перезапуск                      │ restartValue                   │
//│ 67 │ Бесконечно                      │ isForeverValue                 │
//└─────┴─────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtДедлайнТаймер() =============================================")
    
    // Создание объекта
    таймерДедлайн2 = Новый QtДедлайнТаймер()
    таймерДедлайн2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // Тест 1: Бесконечный()
    бесконечный = таймерДедлайн2.Бесконечный()
    ВывестиСтрокуВКонсоль("    Бесконечный(): " + бесконечный + " (ожидается true)")
    
    // Тест 2: УстановитьДедлайн() и Дедлайн()
    таймерДедлайн2.УстановитьДедлайн(1000)
    дедлайн = таймерДедлайн2.Дедлайн()
    ВывестиСтрокуВКонсоль("    УстановитьДедлайн(1000) -> Дедлайн(): " + дедлайн + "мс")
    
    // Тест 3: УстановитьОставшеесяВремя() и ОставшеесяВремя()
    таймер3 = Новый QtДедлайнТаймер()
    таймер3.РежимОтладки(Режим_Отладки)
    таймер3.УстановитьОставшеесяВремя(500)
    осталось = таймер3.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    УстановитьОставшеесяВремя(500) -> ОставшеесяВремя(): " + осталось + "мс")
    
    // Тест 4: Истек()
    таймер4 = Новый QtДедлайнТаймер()
    таймер4.РежимОтладки(Режим_Отладки)
    таймер4.УстановитьОставшеесяВремя(100)
    ВывестиСтрокуВКонсоль("    Установлено 100мс")
    Пауза(150)
    истек = таймер4.Истек()
    ВывестиСтрокуВКонсоль("    Истек(): " + истек + " (ожидается true)")
    
    // Тест 5: Перезапустить()
    таймер5 = Новый QtДедлайнТаймер()
    таймер5.РежимОтладки(Режим_Отладки)
    таймер5.УстановитьОставшеесяВремя(100)
    Пауза(150)
    таймер5.Перезапустить(300)
    осталось = таймер5.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    Перезапустить(300) -> ОставшеесяВремя(): " + осталось + "мс")
    
    // Тест 6: Очистить()
    таймер6 = Новый QtДедлайнТаймер()
    таймер6.РежимОтладки(Режим_Отладки)
    таймер6.УстановитьОставшеесяВремя(500)
    таймер6.Очистить()
    бесконечный = таймер6.Бесконечный()
    ВывестиСтрокуВКонсоль("    Очистить() -> Бесконечный(): " + бесконечный + " (ожидается true)")
    
    // Тест 7: УстановитьОставшеесяВремяСТипом()
    таймер7 = Новый QtДедлайнТаймер()
    таймер7.РежимОтладки(Режим_Отладки)
    таймер7.УстановитьОставшеесяВремяСТипом(1000, 0)
    осталось = таймер7.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    УстановитьОставшеесяВремяСТипом(1000, 0) -> ОставшеесяВремя(): " + осталось + "мс")
    
    // Тест 8: Уменьшение оставшегося времени
    таймер8 = Новый QtДедлайнТаймер()
    таймер8.РежимОтладки(Режим_Отладки)
    таймер8.УстановитьОставшеесяВремя(3000)
    ост1 = таймер8.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    ОставшеесяВремя() сразу: " + ост1 + "мс")
    Пауза(500)
    ост2 = таймер8.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    ОставшеесяВремя() через 500мс: " + ост2 + "мс")
    Пауза(500)
    ост3 = таймер8.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    ОставшеесяВремя() ещё через 500мс: " + ост3 + "мс")
    ВывестиСтрокуВКонсоль("    Уменьшение времени: " + (ост1 > ост2 && ост2 > ост3 ? "КОРРЕКТНО" : "НЕКОРРЕКТНО"))
    
    // Тест 9: ПерезапуститьСТипом()
    таймер9 = Новый QtДедлайнТаймер()
    таймер9.РежимОтладки(Режим_Отладки)
    таймер9.УстановитьОставшеесяВремя(100)
    Пауза(150)
    таймер9.ПерезапуститьСТипом(500, 1)
    осталось = таймер9.ОставшеесяВремя()
    ВывестиСтрокуВКонсоль("    ПерезапуститьСТипом(500, 1) -> ОставшеесяВремя(): " + осталось + "мс")
    
    // Тест 10: КопироватьВ()
    таймер10 = Новый QtДедлайнТаймер()
    таймер10.РежимОтладки(Режим_Отладки)
    таймер10.УстановитьОставшеесяВремя(1500)
    копия = Новый QtДедлайнТаймер()
    копия.РежимОтладки(Режим_Отладки)
    успех = таймер10.КопироватьВ(копия)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успех + " (ожидается true)")
    
    // Тест 11: Действителен()
    валидный = таймерДедлайн2.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    
    // Тест 12: RusFunc()
    Если typeof таймерДедлайн2.RusFunc === 'function' Тогда
        jsonStr = таймерДедлайн2.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtДедлайнТаймер завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtЗамерВремени()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startValue                     │
//│ 20 │ ЗапуститьСИнтервалом           │ startWithInterval              │
//│ 21 │ Остановить                     │ stopValue                      │
//│ 22 │ Активен                        │ isActiveValue                  │
//│ 23 │ ОставшеесяВремя                │ getRemainingTimeValue          │
//│ 24 │ УстановитьИнтервал             │ setIntervalValue               │
//│ 25 │ ПолучитьИнтервал               │ getIntervalValue               │
//│ 26 │ УстановитьОднократный          │ setSingleShotValue             │
//│ 27 │ Однократный                    │ isSingleShotValue              │
//│ 28 │ УстановитьКолбэк               │ setCallback                    │
//│ 29 │ ОднократныйЗапуск              │ singleShotValue                │
//│ 30 │ ПолучитьТаймер                 │ getRealTimer                   │
//│ 31 │ КопироватьВ                    │ copyTo                         │
//│ 32 │ Действителен                   │ isValidValue                   │
//│ 33 │ Запуск                         │ startValue                     │
//│ 34 │ Стоп                           │ stopValue                      │
//│ 35 │ Интервал                       │ getIntervalValue               │
//│ 36 │ ВремяОжидания                  │ getRemainingTimeValue          │
//│ 37 │ Действителен                   │ isValid                        │
//│ 38 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 39 │ РежимОтладки                   │ setDebug                       │
//│ 40 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 41 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 42 │ ИмяОбъекта                     │ objectName                     │
//│ 43 │ Запустить                      │ startValue                     │
//│ 44 │ Перезапустить                  │ restartValue                   │
//│ 45 │ Сбросить                       │ invalidateValue                │
//│ 46 │ ПрошлоВремени                  │ getElapsedValue                │
//│ 47 │ ПрошлоМиллисекунд              │ getElapsedMillisecondsValue    │
//│ 48 │ ПрошлоСекунд                   │ getElapsedSecondsValue         │
//│ 49 │ Действителен                   │ isValidValue                   │
//│ 50 │ Истек                          │ hasExpired                     │
//│ 51 │ ОсталосьВремени                │ getRemainingTimeValue          │
//│ 52 │ КопироватьВ                    │ copyTo                         │
//│ 53 │ ПолучитьТаймер                 │ getRealTimer                   │
//│ 54 │ СброситьВремя                  │ resetValue                     │
//│ 55 │ ПолучитьНаносекунды            │ getElapsedNanosecondsValue     │
//│ 56 │ ПолучитьМикросекунды           │ getElapsedMicrosecondsValue    │
//│ 57 │ ПрошлоИПерезапустить           │ elapsedAndRestart              │
//│ 58 │ Прошло                         │ getElapsedValue                │
//│ 59 │ ПрошлоВремениМс                │ getElapsedMillisecondsValue    │
//│ 60 │ ПрошлоВремениСек               │ getElapsedSecondsValue         │
//│ 61 │ Осталось                       │ getRemainingTimeValue          │
//│ 62 │ ПроверитьИстек                 │ hasExpired                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtЗамерВремени() ==============================================")
    
    // Создание объекта
    Замер = Новый QtЗамерВремени()
    Замер.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // Тест 1: Действителен()
    Замер.Запустить()
    валидный = Замер.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    
    // Тест 2: ПрошлоВремени() - измерение в миллисекундах
    Замер2 = Новый QtЗамерВремени()
    Замер2.РежимОтладки(Режим_Отладки)
    Замер2.Запустить()
    старт = Замер2.ПрошлоВремени()
    Пауза(50)
    финиш = Замер2.ПрошлоВремени()
    разница = финиш - старт
    ВывестиСтрокуВКонсоль("    ПрошлоВремени(): старт=" + старт + "мс, финиш=" + финиш + "мс, разница=" + разница + "мс")
    
    // Тест 3: ПрошлоСекунд() - измерение в секундах
    Замер3 = Новый QtЗамерВремени()
    Замер3.РежимОтладки(Режим_Отладки)
    Замер3.Запустить()
    секСтарт = Замер3.ПрошлоСекунд()
    Пауза(50)
    секФиниш = Замер3.ПрошлоСекунд()
    секРазница = секФиниш - секСтарт
    ВывестиСтрокуВКонсоль("    ПрошлоСекунд(): старт=" + секСтарт + "с, финиш=" + секФиниш + "с, разница=" + секРазница + "с")
    
    // Тест 4: Истек()
    Замер4 = Новый QtЗамерВремени()
    Замер4.РежимОтладки(Режим_Отладки)
    Замер4.Запустить()
    Пауза(100)
    реальноеВремя = Замер4.ПрошлоВремени()
    истек1 = Замер4.Истек(реальноеВремя + 50)  // должно быть false
    истек2 = Замер4.Истек(реальноеВремя - 50)  // должно быть true
    ВывестиСтрокуВКонсоль("    Реальное время: " + реальноеВремя + "мс")
    ВывестиСтрокуВКонсоль("    Истек(" + (реальноеВремя + 50) + "): " + истек1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Истек(" + (реальноеВремя - 50) + "): " + истек2 + " (ожидается true)")
    
    // Тест 5: ОсталосьВремени()
    Замер5 = Новый QtЗамерВремени()
    Замер5.РежимОтладки(Режим_Отладки)
    Замер5.Запустить()
    Пауза(100)
    реальноеВремя = Замер5.ПрошлоВремени()
    осталось1 = Замер5.ОсталосьВремени(реальноеВремя + 50)  // должно быть > 0
    осталось2 = Замер5.ОсталосьВремени(реальноеВремя - 10)  // должно быть 0
    ВывестиСтрокуВКонсоль("    Реальное время: " + реальноеВремя + "мс")
    ВывестиСтрокуВКонсоль("    ОсталосьВремени(" + (реальноеВремя + 50) + "): " + осталось1 + "мс (ожидается > 0)")
    ВывестиСтрокуВКонсоль("    ОсталосьВремени(" + (реальноеВремя - 10) + "): " + осталось2 + "мс (ожидается 0)")
    
    // Тест 6: Перезапустить()
    Замер6 = Новый QtЗамерВремени()
    Замер6.РежимОтладки(Режим_Отладки)
    Замер6.Запустить()
    Пауза(50)
    времяДо = Замер6.ПрошлоВремени()
    Замер6.Перезапустить()
    времяСразу = Замер6.ПрошлоВремени()
    ВывестиСтрокуВКонсоль("    Время до перезапуска: " + времяДо + "мс")
    ВывестиСтрокуВКонсоль("    Время сразу после: " + времяСразу + "мс (ожидается < 20)")
    
    // Тест 7: Сбросить()
    Замер7 = Новый QtЗамерВремени()
    Замер7.РежимОтладки(Режим_Отладки)
    Замер7.Запустить()
    валидДо = Замер7.Действителен()
    Замер7.Сбросить()
    валидПосле = Замер7.Действителен()
    Замер7.Запустить()
    валидПослеСтарта = Замер7.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен до сброса: " + валидДо + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Действителен после сброса: " + валидПосле + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Действителен после запуска: " + валидПослеСтарта + " (ожидается true)")
    
    // Тест 8: Запустить()
    Замер8 = Новый QtЗамерВремени()
    Замер8.РежимОтладки(Режим_Отладки)
    Замер8.Сбросить()
    валидДо = Замер8.Действителен()
    Замер8.Запустить()
    валидПосле = Замер8.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен до запуска: " + валидДо + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Действителен после запуска: " + валидПосле + " (ожидается true)")
    
    // Тест 9: КопироватьВ()
    Замер9 = Новый QtЗамерВремени()
    Замер9.РежимОтладки(Режим_Отладки)
    Замер9.Запустить()
    Пауза(50)
    Копия = Новый QtЗамерВремени()
    Копия.РежимОтладки(Режим_Отладки)
    Копия.Запустить()
    результат = Замер9.КопироватьВ(Копия)
    времяОригинала = Замер9.ПрошлоВремени()
    времяКопии = Копия.ПрошлоВремени()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Время оригинала: " + времяОригинала + "мс")
    ВывестиСтрокуВКонсоль("    Время копии: " + времяКопии + "мс")
    
    // Тест 10: ПолучитьМикросекунды()
    Замер10 = Новый QtЗамерВремени()
    Замер10.РежимОтладки(Режим_Отладки)
    Замер10.Запустить()
    Пауза(10)
    мкс = Замер10.ПолучитьМикросекунды()
    мс = Замер10.ПрошлоВремени()
    ВывестиСтрокуВКонсоль("    ПолучитьМикросекунды(): " + мкс + " мкс")
    ВывестиСтрокуВКонсоль("    ПрошлоВремени(): " + мс + " мс")
    ВывестиСтрокуВКонсоль("    Микросекунды > миллисекунд: " + (мкс >= мс ? "ДА" : "НЕТ"))
    
    // Тест 11: RusFunc()
    Если typeof Замер.RusFunc === 'function' Тогда
        jsonStr = Замер.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtЗамерВремени завершён.=============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtТаймер()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startValue                     │
//│ 20 │ ЗапуститьСИнтервалом           │ startWithInterval              │
//│ 21 │ Остановить                     │ stopValue                      │
//│ 22 │ Активен                        │ isActiveValue                  │
//│ 23 │ ОставшеесяВремя                │ getRemainingTimeValue          │
//│ 24 │ УстановитьИнтервал             │ setIntervalValue               │
//│ 25 │ ПолучитьИнтервал               │ getIntervalValue               │
//│ 26 │ УстановитьОднократный          │ setSingleShotValue             │
//│ 27 │ Однократный                    │ isSingleShotValue              │
//│ 28 │ УстановитьКолбэк               │ setCallback                    │
//│ 29 │ ОднократныйЗапуск              │ singleShotValue                │
//│ 30 │ ПолучитьТаймер                 │ getRealTimer                   │
//│ 31 │ КопироватьВ                    │ copyTo                         │
//│ 32 │ Действителен                   │ isValidValue                   │
//│ 33 │ Запуск                         │ startValue                     │
//│ 34 │ Стоп                           │ stopValue                      │
//│ 35 │ Интервал                       │ getIntervalValue               │
//│ 36 │ ВремяОжидания                  │ getRemainingTimeValue          │
//│ 37 │ Действителен                   │ isValid                        │
//│ 38 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 39 │ РежимОтладки                   │ setDebug                       │
//│ 40 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 41 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 42 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtТаймер() ===================================================")
    
    // Создание объекта
    Таймер_1 = Новый QtТаймер()
    Таймер_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // Тест 1: Действителен()
    валидный = Таймер_1.Действителен()
    ВывестиСтрокуВКонсоль("    Действителен(): " + валидный + " (ожидается true)")
    
    // Тест 2: ПолучитьТаймер()
    реал = Таймер_1.ПолучитьТаймер()
    ВывестиСтрокуВКонсоль("    ПолучитьТаймер(): " + (реал != null ? "успешно" : "неудачно"))
    
    // Тест 3: УстановитьИнтервал() и Интервал()
    Таймер_1.УстановитьИнтервал(1000)
    интервал = Таймер_1.Интервал()
    ВывестиСтрокуВКонсоль("    УстановитьИнтервал(1000) -> Интервал(): " + интервал + " (ожидается 1000)")
    
    // Тест 4: УстановитьОднократный() и Однократный()
    Таймер_1.УстановитьОднократный(ИСТИНА)
    однократный = Таймер_1.Однократный()
    ВывестиСтрокуВКонсоль("    УстановитьОднократный(true) -> Однократный(): " + однократный + " (ожидается true)")
    
    Таймер_1.УстановитьОднократный(ЛОЖЬ)
    однократный2 = Таймер_1.Однократный()
    ВывестиСтрокуВКонсоль("    УстановитьОднократный(false) -> Однократный(): " + однократный2 + " (ожидается false)")
    
    // Тест 5: Запустить() и Остановить() и Активен()
    Таймер_1.УстановитьОднократный(ЛОЖЬ)
    Таймер_1.Запустить()
    активен = Таймер_1.Активен()
    ВывестиСтрокуВКонсоль("    Запустить() -> Активен(): " + активен + " (ожидается true)")
    
    Таймер_1.Остановить()
    активенПосле = Таймер_1.Активен()
    ВывестиСтрокуВКонсоль("    Остановить() -> Активен(): " + активенПосле + " (ожидается false)")
    
    // Тест 6: ЗапуститьСИнтервалом()
    Таймер_1.Остановить()
    Таймер_1.ЗапуститьСИнтервалом(1500)
    интервал = Таймер_1.Интервал()
    активен = Таймер_1.Активен()
    Таймер_1.Остановить()
    ВывестиСтрокуВКонсоль("    ЗапуститьСИнтервалом(1500) -> Интервал(): " + интервал + " (ожидается 1500)")
    ВывестиСтрокуВКонсоль("    Активен(): " + активен + " (ожидается true)")
    
    // Тест 7: УстановитьКолбэк()
    Таймер_2 = Новый QtТаймер()
    Таймер_2.РежимОтладки(Режим_Отладки)
    вызвано = ЛОЖЬ
    цикл = Новый QtЦиклСобытий()
    Таймер_2.УстановитьКолбэк(Функция() {
        вызвано = ИСТИНА
        цикл.Выйти()
    })
    Таймер_2.УстановитьОднократный(ИСТИНА)
    Таймер_2.Запустить(100)
    цикл.Запустить()
    Таймер_2.Остановить()
    ВывестиСтрокуВКонсоль("    УстановитьКолбэк() -> вызвано: " + вызвано + " (ожидается true)")
    
    // Тест 8: ОднократныйЗапуск()
    Таймер_3 = Новый QtТаймер()
    Таймер_3.РежимОтладки(Режим_Отладки)
    вызвано2 = ЛОЖЬ
    Таймер_цикл2 = Новый QtЦиклСобытий()
    Таймер_3.ОднократныйЗапуск(100, Функция() {
        вызвано2 = ИСТИНА
        Таймер_цикл2.Выйти()
    })
    Таймер_цикл2.Запустить()
    ВывестиСтрокуВКонсоль("    ОднократныйЗапуск(100) -> вызвано: " + вызвано2 + " (ожидается true)")
    
    // Тест 9: ОставшеесяВремя()
    Таймер_1.Остановить()
    Таймер_1.УстановитьОднократный(ИСТИНА)
    Таймер_1.Запустить(1000)
    осталось = Таймер_1.ОставшеесяВремя()
    Таймер_1.Остановить()
    ВывестиСтрокуВКонсоль("    ОставшеесяВремя(): " + осталось + " (ожидается > 0)")
    
    // Тест 10: КопироватьВ()
    Таймер_4 = Новый QtТаймер()
    Таймер_4.РежимОтладки(Режим_Отладки)
    Таймер_4.УстановитьИнтервал(2000)
    Таймер_4.УстановитьОднократный(ИСТИНА)
    Таймер_Копия = Новый QtТаймер()
    Таймер_Копия.РежимОтладки(Режим_Отладки)
    результат = Таймер_4.КопироватьВ(Таймер_Копия)
    интервалКопии = Таймер_Копия.Интервал()
    однократныйКопии = Таймер_Копия.Однократный()
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Интервал копии: " + интервалКопии + " (ожидается 2000)")
    ВывестиСтрокуВКонсоль("    Однократный копии: " + однократныйКопии + " (ожидается true)")
    
    // Тест 11: RusFunc()
    Если typeof Таймер_1.RusFunc === 'function' Тогда
        jsonStr = Таймер_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // Тест 12: Проверка дополнительных русских методов
    Таймер_5 = Новый QtТаймер()
    Таймер_5.РежимОтладки(Режим_Отладки)
    Таймер_5.УстановитьИнтервал(500)
    интервал = Таймер_5.Интервал()
    Таймер_5.УстановитьОднократный(ИСТИНА)
    однократный = Таймер_5.Однократный()
    Таймер_5.Запустить()
    активен = Таймер_5.Активен()
    Таймер_5.Остановить()
    ВывестиСтрокуВКонсоль("    УстановитьИнтервал(500) -> Интервал(): " + интервал + " (ожидается 500)")
    ВывестиСтрокуВКонсоль("    УстановитьОднократный(true) -> Однократный(): " + однократный + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Запустить() -> Активен(): " + активен + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Состояние методов: " + (интервал == 500 && однократный == ИСТИНА && активен == ИСТИНА ? "ВСЕ РАБОТАЮТ" : "ЕСТЬ ПРОБЛЕМЫ"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtТаймер завершён.====================================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВремя()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ УстановитьВремя                │ setTime                        │
//│ 20 │ ПолучитьЧас                    │ getHour                        │
//│ 21 │ ПолучитьМинуту                 │ getMinute                      │
//│ 22 │ ПолучитьСекунду                │ getSecond                      │
//│ 23 │ ПолучитьМиллисекунду           │ getMillisecond                 │
//│ 24 │ Корректен                      │ getIsValid                     │
//│ 25 │ Пустой                         │ getIsNull                      │
//│ 26 │ ВСтроку                        │ getToString                    │
//│ 27 │ ДобавитьСекунды                │ addSeconds                     │
//│ 28 │ ДобавитьМиллисекунды           │ addMilliseconds                │
//│ 29 │ СекундДо                       │ secondsTo                      │
//│ 30 │ МиллисекундДо                  │ millisecondsTo                 │
//│ 31 │ Равно                          │ equals                         │
//│ 32 │ Меньше                         │ lessThan                       │
//│ 33 │ Больше                         │ greaterThan                    │
//│ 34 │ ТекущееВремя                   │ currentTime                    │
//│ 35 │ ИзСтроки                       │ fromString                     │
//│ 36 │ ПолучитьРеальноеВремя          │ getRealTime                    │
//│ 37 │ Копировать                     │ copy                           │
//│ 38 │ КопироватьВ                    │ copyTo                         │
//│ 39 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtВремя() ====================================================")
    
    // Создание объекта
    Время_1 = Новый QtВремя()
    Время_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    ВывестиСтрокуВКонсоль("    Текущее время: " + Время_1.ВСтроку())
    
    // Тест 1: УстановитьВремя() и ВСтроку()
    Время_2 = Новый QtВремя()
    Время_2.РежимОтладки(Режим_Отладки)
    Время_2.УстановитьВремя(14, 30, 45, 500)
    строка = Время_2.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьВремя(14,30,45,500) -> ВСтроку(): " + строка + " (ожидается 14:30:45)")
    
    // Тест 2: Получение компонентов времени
    Время_3 = Новый QtВремя()
    Время_3.РежимОтладки(Режим_Отладки)
    Время_3.УстановитьВремя(10, 25, 30, 250)
    час = Время_3.ПолучитьЧас()
    минута = Время_3.ПолучитьМинуту()
    секунда = Время_3.ПолучитьСекунду()
    миллисекунда = Время_3.ПолучитьМиллисекунду()
    ВывестиСтрокуВКонсоль("    ПолучитьЧас(): " + час + " (ожидается 10)")
    ВывестиСтрокуВКонсоль("    ПолучитьМинуту(): " + минута + " (ожидается 25)")
    ВывестиСтрокуВКонсоль("    ПолучитьСекунду(): " + секунда + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    ПолучитьМиллисекунду(): " + миллисекунда + " (ожидается 250)")
    
    // Тест 3: Корректен()
    Время_4 = Новый QtВремя()
    Время_4.РежимОтладки(Режим_Отладки)
    Время_4.УстановитьВремя(12, 30, 45, 0)
    валид1 = Время_4.Корректен()
    ВывестиСтрокуВКонсоль("    Корректен() для 12:30:45 = " + валид1 + " (ожидается true)")
    
    Время_5 = Новый QtВремя()
    Время_5.РежимОтладки(Режим_Отладки)
    Время_5.УстановитьВремя(25, 30, 45, 0)
    валид2 = Время_5.Корректен()
    ВывестиСтрокуВКонсоль("    Корректен() для 25 часа = " + валид2 + " (ожидается false)")
    
    // Тест 4: Пустой()
    Время_6 = Новый QtВремя()
    Время_6.РежимОтладки(Режим_Отладки)
    Время_6.УстановитьВремя(12, 0, 0, 0)
    пусто1 = Время_6.Пустой()
    ВывестиСтрокуВКонсоль("    Пустой() для 12:00:00 = " + пусто1 + " (ожидается false)")
    
    // Тест 5: ДобавитьСекунды()
    Время_7 = Новый QtВремя()
    Время_7.РежимОтладки(Режим_Отладки)
    Время_7.УстановитьВремя(10, 0, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходное: " + Время_7.ВСтроку())
    
    Время_8 = Время_7.ДобавитьСекунды(65)
    Время_8.setDebug(Режим_Отладки)
    час8 = Время_8.getHour()
    мин8 = Время_8.getMinute()
    сек8 = Время_8.getSecond()
    ВывестиСтрокуВКонсоль("    ДобавитьСекунды(65): " + час8 + ":" + мин8 + ":" + сек8 + " (ожидается 10:01:05)")
    
    Время_9 = Время_7.ДобавитьСекунды(3600)
    Время_9.setDebug(Режим_Отладки)
    час9 = Время_9.getHour()
    мин9 = Время_9.getMinute()
    сек9 = Время_9.getSecond()
    ВывестиСтрокуВКонсоль("    ДобавитьСекунды(3600): " + час9 + ":" + мин9 + ":" + сек9 + " (ожидается 11:00:00)")
    
    // Тест 6: ДобавитьСекунды с переходом через сутки
    Время_10 = Новый QtВремя()
    Время_10.РежимОтладки(Режим_Отладки)
    Время_10.УстановитьВремя(23, 30, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходное (переход): " + Время_10.ВСтроку())
    
    Время_11 = Время_10.ДобавитьСекунды(3600)
    Время_11.setDebug(Режим_Отладки)
    час11 = Время_11.getHour()
    мин11 = Время_11.getMinute()
    сек11 = Время_11.getSecond()
    ВывестиСтрокуВКонсоль("    ДобавитьСекунды(3600): " + час11 + ":" + мин11 + ":" + сек11 + " (ожидается 00:30:00)")
    
    // Тест 7: СекундДо()
    Время_12 = Новый QtВремя()
    Время_12.РежимОтладки(Режим_Отладки)
    Время_12.УстановитьВремя(10, 0, 0, 0)
    Время_13 = Новый QtВремя()
    Время_13.РежимОтладки(Режим_Отладки)
    Время_13.УстановитьВремя(10, 5, 30, 0)
    секунд = Время_12.СекундДо(Время_13)
    ВывестиСтрокуВКонсоль("    СекундДо(10:00:00, 10:05:30): " + секунд + " сек (ожидается 330)")
    секунд2 = Время_13.СекундДо(Время_12)
    ВывестиСтрокуВКонсоль("    СекундДо(10:05:30, 10:00:00): " + секунд2 + " сек (ожидается -330)")
    
    // Тест 8: МиллисекундДо()
    Время_14 = Новый QtВремя()
    Время_14.РежимОтладки(Режим_Отладки)
    Время_14.УстановитьВремя(10, 0, 0, 500)
    Время_15 = Новый QtВремя()
    Время_15.РежимОтладки(Режим_Отладки)
    Время_15.УстановитьВремя(10, 0, 2, 750)
    миллисекунд = Время_14.МиллисекундДо(Время_15)
    ВывестиСтрокуВКонсоль("    МиллисекундДо(10:00:00.500, 10:00:02.750): " + миллисекунд + " мс (ожидается 2250)")
    миллисекунд2 = Время_15.МиллисекундДо(Время_14)
    ВывестиСтрокуВКонсоль("    МиллисекундДо(10:00:02.750, 10:00:00.500): " + миллисекунд2 + " мс (ожидается -2250)")
    
    // Тест 9: Сравнение времени
    Время_16 = Новый QtВремя()
    Время_16.РежимОтладки(Режим_Отладки)
    Время_16.УстановитьВремя(12, 30, 0, 0)
    Время_17 = Новый QtВремя()
    Время_17.РежимОтладки(Режим_Отладки)
    Время_17.УстановитьВремя(12, 30, 0, 0)
    Время_18 = Новый QtВремя()
    Время_18.РежимОтладки(Режим_Отладки)
    Время_18.УстановитьВремя(13, 0, 0, 0)
    равно1 = Время_16.Равно(Время_17)
    равно2 = Время_16.Равно(Время_18)
    меньше = Время_16.Меньше(Время_18)
    больше = Время_18.Больше(Время_16)
    ВывестиСтрокуВКонсоль("    Равно(12:30, 12:30): " + равно1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Равно(12:30, 13:00): " + равно2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Меньше(12:30, 13:00): " + меньше + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Больше(13:00, 12:30): " + больше + " (ожидается true)")
    
    // Тест 10: ТекущееВремя()
    Время_19 = Время_1.ТекущееВремя()
    Время_19.setDebug(Режим_Отладки)
    часТек = Время_19.getHour()
    минТек = Время_19.getMinute()
    секТек = Время_19.getSecond()
    мсТек = Время_19.getMillisecond()
    ВывестиСтрокуВКонсоль("    ТекущееВремя(): " + часТек + ":" + минТек + ":" + секТек + "." + мсТек)
    ВывестиСтрокуВКонсоль("    Время корректно: " + (часТек >= 0 && часТек <= 23 && минТек >= 0 && минТек <= 59 ? "ДА" : "НЕТ"))
    
    // Тест 11: ИзСтроки()
    Время_20 = Время_1.ИзСтроки("15:30:45", "hh:mm:ss")
    Время_20.setDebug(Режим_Отладки)
    час20 = Время_20.getHour()
    мин20 = Время_20.getMinute()
    сек20 = Время_20.getSecond()
    ВывестиСтрокуВКонсоль("    ИзСтроки('15:30:45'): " + час20 + ":" + мин20 + ":" + сек20 + " (ожидается 15:30:45)")
    
    // Тест 12: Создание с конкретным временем
    Время_21 = Новый QtВремя()
    Время_21.РежимОтладки(Режим_Отладки)
    Время_21.УстановитьВремя(9, 45, 30, 125)
    строка21 = Время_21.ВСтроку()
    мс21 = Время_21.ПолучитьМиллисекунду()
    ВывестиСтрокуВКонсоль("    УстановитьВремя(9,45,30,125): " + строка21 + " (ожидается 09:45:30)")
    ВывестиСтрокуВКонсоль("    ПолучитьМиллисекунду(): " + мс21 + " (ожидается 125)")
    
    // Тест 13: Проверка дополнительных русских методов
    Время_22 = Новый QtВремя()
    Время_22.РежимОтладки(Режим_Отладки)
    Время_22.УстановитьВремя(8, 15, 20, 0)
    Время_23 = Новый QtВремя()
    Время_23.РежимОтладки(Режим_Отладки)
    Время_23.УстановитьВремя(8, 15, 20, 0)
    Время_24 = Новый QtВремя()
    Время_24.РежимОтладки(Режим_Отладки)
    Время_24.УстановитьВремя(9, 0, 0, 0)
    равно3 = Время_22.Равно(Время_23)
    равно4 = Время_22.Равно(Время_24)
    ВывестиСтрокуВКонсоль("    Равно(08:15, 08:15): " + равно3 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Равно(08:15, 09:00): " + равно4 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Методы сравнения: " + (равно3 == ИСТИНА && равно4 == ЛОЖЬ ? "ВСЕ РАБОТАЮТ" : "ЕСТЬ ПРОБЛЕМЫ"))
    
    // Тест 14: RusFunc()
    Если typeof Время_1.RusFunc === 'function' Тогда
        jsonStr = Время_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    // Итоговый результат всех тестов
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("    ИТОГОВЫЙ РЕЗУЛЬТАТ ТЕСТИРОВАНИЯ:")
    ВывестиСтрокуВКонсоль("    Всего проверено: 14 тестов")
    ВывестиСтрокуВКонсоль("    Статус: " + (валид1 == ИСТИНА && валид2 == ЛОЖЬ && 
        час8 == 10 && мин8 == 1 && сек8 == 5 &&
        час9 == 11 && мин9 == 0 && сек9 == 0 &&
        час11 == 0 && мин11 == 30 && сек11 == 0 &&
        секунд == 330 && секунд2 == -330 &&
        миллисекунд == 2250 && миллисекунд2 == -2250 &&
        равно1 == ИСТИНА && равно2 == ЛОЖЬ && меньше == ИСТИНА && больше == ИСТИНА &&
        час20 == 15 && мин20 == 30 && сек20 == 45 &&
        строка21 == "09:45:30" && мс21 == 125 ? "✅ ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО" : "⚠️ ЕСТЬ ОШИБКИ"))
    
    ВывестиСтрокуВКонсоль("==== Тест QtВремя завершён.====================================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВремя2()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtTime (QtВремя) - КОМПАКТНАЯ ВЕРСИЯ ===========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Время2_1 = Новый QtВремя()
    Время2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    ВывестиСтрокуВКонсоль("    Текущее время: " + Время2_1.ВСтроку())
    
    // ===== 2. УСТАНОВКА ВРЕМЕНИ =====
    Время2_2 = Новый QtВремя()
    Время2_2.РежимОтладки(Режим_Отладки)
    Время2_2.УстановитьВремя(14, 30, 45, 500)
    строка2 = Время2_2.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьВремя(14,30,45,500) -> ВСтроку(): " + строка2 + " (ожидается 14:30:45)")
    
    // ===== 3. ПОЛУЧЕНИЕ КОМПОНЕНТОВ =====
    Время2_3 = Новый QtВремя()
    Время2_3.РежимОтладки(Режим_Отладки)
    Время2_3.УстановитьВремя(10, 25, 30, 250)
    час = Время2_3.ПолучитьЧас()
    минута = Время2_3.ПолучитьМинуту()
    секунда = Время2_3.ПолучитьСекунду()
    миллисекунда = Время2_3.ПолучитьМиллисекунду()
    ВывестиСтрокуВКонсоль("    ПолучитьЧас(): " + час + " (ожидается 10)")
    ВывестиСтрокуВКонсоль("    ПолучитьМинуту(): " + минута + " (ожидается 25)")
    ВывестиСтрокуВКонсоль("    ПолучитьСекунду(): " + секунда + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    ПолучитьМиллисекунду(): " + миллисекунда + " (ожидается 250)")
    
    // ===== 4. ПРОВЕРКА КОРРЕКТНОСТИ =====
    Время2_4 = Новый QtВремя()
    Время2_4.РежимОтладки(Режим_Отладки)
    Время2_4.УстановитьВремя(12, 30, 45, 0)
    валид1 = Время2_4.Корректен()
    ВывестиСтрокуВКонсоль("    Корректен() для 12:30:45 = " + валид1 + " (ожидается true)")
    
    Время2_5 = Новый QtВремя()
    Время2_5.РежимОтладки(Режим_Отладки)
    Время2_5.УстановитьВремя(25, 30, 45, 0)
    валид2 = Время2_5.Корректен()
    ВывестиСтрокуВКонсоль("    Корректен() для 25 часа = " + валид2 + " (ожидается false)")
    
    // ===== 5. ПРОВЕРКА ПУСТОГО ВРЕМЕНИ =====
    Время2_6 = Новый QtВремя()
    Время2_6.РежимОтладки(Режим_Отладки)
    Время2_6.УстановитьВремя(0, 0, 0, 0)
    пусто1 = Время2_6.Пустой()
    ВывестиСтрокуВКонсоль("    Пустой() для 00:00:00 = " + пусто1 + " (ожидается false)")
    
    // ===== 6. ДОБАВЛЕНИЕ СЕКУНД =====
    Время2_7 = Новый QtВремя()
    Время2_7.РежимОтладки(Режим_Отладки)
    Время2_7.УстановитьВремя(10, 0, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходное: " + Время2_7.ВСтроку())
    
    Время2_8 = Время2_7.ДобавитьСекунды(65)
    Время2_8.setDebug(Режим_Отладки)
    час8 = Время2_8.getHour()
    мин8 = Время2_8.getMinute()
    сек8 = Время2_8.getSecond()
    ВывестиСтрокуВКонсоль("    ДобавитьСекунды(65): " + час8 + ":" + мин8 + ":" + сек8 + " (ожидается 10:01:05)")
    
    // ===== 7. ДОБАВЛЕНИЕ СЕКУНД С ПЕРЕХОДОМ =====
    Время2_9 = Новый QtВремя()
    Время2_9.РежимОтладки(Режим_Отладки)
    Время2_9.УстановитьВремя(23, 30, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходное (переход): " + Время2_9.ВСтроку())
    
    Время2_10 = Время2_9.ДобавитьСекунды(3600)
    Время2_10.setDebug(Режим_Отладки)
    час10 = Время2_10.getHour()
    мин10 = Время2_10.getMinute()
    сек10 = Время2_10.getSecond()
    ВывестиСтрокуВКонсоль("    ДобавитьСекунды(3600): " + час10 + ":" + мин10 + ":" + сек10 + " (ожидается 00:30:00)")
    
    // ===== 8. РАЗНИЦА В СЕКУНДАХ =====
    Время2_11 = Новый QtВремя()
    Время2_11.РежимОтладки(Режим_Отладки)
    Время2_11.УстановитьВремя(10, 0, 0, 0)
    Время2_12 = Новый QtВремя()
    Время2_12.РежимОтладки(Режим_Отладки)
    Время2_12.УстановитьВремя(10, 5, 30, 0)
    секунд = Время2_11.СекундДо(Время2_12)
    ВывестиСтрокуВКонсоль("    СекундДо(10:00:00 -> 10:05:30): " + секунд + " сек (ожидается 330)")
    
    // ===== 9. РАЗНИЦА В МИЛЛИСЕКУНДАХ =====
    Время2_13 = Новый QtВремя()
    Время2_13.РежимОтладки(Режим_Отладки)
    Время2_13.УстановитьВремя(10, 0, 0, 500)
    Время2_14 = Новый QtВремя()
    Время2_14.РежимОтладки(Режим_Отладки)
    Время2_14.УстановитьВремя(10, 0, 2, 750)
    миллисекунд = Время2_13.МиллисекундДо(Время2_14)
    ВывестиСтрокуВКонсоль("    МиллисекундДо(10:00:00.500 -> 10:00:02.750): " + миллисекунд + " мс (ожидается 2250)")
    
    // ===== 10. СРАВНЕНИЕ =====
    Время2_15 = Новый QtВремя()
    Время2_15.РежимОтладки(Режим_Отладки)
    Время2_15.УстановитьВремя(12, 30, 0, 0)
    Время2_16 = Новый QtВремя()
    Время2_16.РежимОтладки(Режим_Отладки)
    Время2_16.УстановитьВремя(12, 30, 0, 0)
    Время2_17 = Новый QtВремя()
    Время2_17.РежимОтладки(Режим_Отладки)
    Время2_17.УстановитьВремя(13, 0, 0, 0)
    равно1 = Время2_15.Равно(Время2_16)
    равно2 = Время2_15.Равно(Время2_17)
    меньше = Время2_15.Меньше(Время2_17)
    больше = Время2_17.Больше(Время2_15)
    ВывестиСтрокуВКонсоль("    Равно(12:30, 12:30): " + равно1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Равно(12:30, 13:00): " + равно2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Меньше(12:30, 13:00): " + меньше + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Больше(13:00, 12:30): " + больше + " (ожидается true)")
    
    // ===== 11. ТЕКУЩЕЕ ВРЕМЯ =====
    Время2_18 = Время2_1.ТекущееВремя()
    Время2_18.setDebug(Режим_Отладки)
    часТек = Время2_18.getHour()
    минТек = Время2_18.getMinute()
    секТек = Время2_18.getSecond()
    мсТек = Время2_18.getMillisecond()
    ВывестиСтрокуВКонсоль("    ТекущееВремя(): " + часТек + ":" + минТек + ":" + секТек + "." + мсТек)
    
    // ===== 12. СОЗДАНИЕ ИЗ СТРОКИ =====
    Время2_19 = Время2_1.ИзСтроки("15:30:45", "hh:mm:ss")
    Время2_19.setDebug(Режим_Отладки)
    час19 = Время2_19.getHour()
    мин19 = Время2_19.getMinute()
    сек19 = Время2_19.getSecond()
    ВывестиСтрокуВКонсоль("    ИзСтроки('15:30:45'): " + час19 + ":" + мин19 + ":" + сек19 + " (ожидается 15:30:45)")
    
    // ===== 13. КОПИРОВАНИЕ =====
    Время2_20 = Новый QtВремя()
    Время2_20.РежимОтладки(Режим_Отладки)
    Время2_20.УстановитьВремя(8, 15, 20, 0)
    Время2_21 = Новый QtВремя()
    Время2_21.РежимОтладки(Режим_Отладки)
    результат = Время2_20.КопироватьВ(Время2_21)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Оригинал: " + Время2_20.ВСтроку() + ", Копия: " + Время2_21.ВСтроку())
    
    // ===== 14. RUSFUNC =====
    Если typeof Время2_1.RusFunc === 'function' Тогда
        jsonStr = Время2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtTime (QtВремя) завершён.===========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtДата()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Январь                         │ January                        │
//│ 20 │ Февраль                        │ February                       │
//│ 21 │ Март                           │ March                          │
//│ 22 │ Апрель                         │ April                          │
//│ 23 │ Май                            │ May                            │
//│ 24 │ Июнь                           │ June                           │
//│ 25 │ Июль                           │ July                           │
//│ 26 │ Август                         │ August                         │
//│ 27 │ Сентябрь                       │ September                      │
//│ 28 │ Октябрь                        │ October                        │
//│ 29 │ Ноябрь                         │ November                       │
//│ 30 │ Декабрь                        │ December                       │
//│ 31 │ Понедельник                    │ Monday                         │
//│ 32 │ Вторник                        │ Tuesday                        │
//│ 33 │ Среда                          │ Wednesday                      │
//│ 34 │ Четверг                        │ Thursday                       │
//│ 35 │ Пятница                        │ Friday                         │
//│ 36 │ Суббота                        │ Saturday                       │
//│ 37 │ Воскресенье                    │ Sunday                         │
//│ 38 │ УстановитьДату                 │ setDate                        │
//│ 39 │ Год                            │ year                           │
//│ 40 │ Месяц                          │ month                          │
//│ 41 │ День                           │ day                            │
//│ 42 │ ДеньНедели                     │ dayOfWeek                      │
//│ 43 │ ДеньГода                       │ dayOfYear                      │
//│ 44 │ ДнейВМесяце                    │ daysInMonth                    │
//│ 45 │ ДнейВГоду                      │ daysInYear                     │
//│ 46 │ НомерНедели                    │ weekNumber                     │
//│ 47 │ Корректен                      │ isValid                        │
//│ 48 │ Пустой                         │ isNull                         │
//│ 49 │ ВСтроку                        │ toString                       │
//│ 50 │ ДобавитьДни                    │ addDays                        │
//│ 51 │ ДобавитьМесяцы                 │ addMonths                      │
//│ 52 │ ДобавитьГоды                   │ addYears                       │
//│ 53 │ ДнейДо                         │ daysTo                         │
//│ 54 │ Равно                          │ equals                         │
//│ 55 │ Меньше                         │ lessThan                       │
//│ 56 │ Больше                         │ greaterThan                    │
//│ 57 │ ТекущаяДата                    │ currentDate                    │
//│ 58 │ ИзСтроки                       │ fromString                     │
//│ 59 │ ВисокосныйГод                  │ isLeapYear                     │
//│ 60 │ МесяцевВГоду                   │ monthsInYear                   │
//│ 61 │ ПолучитьРеальнуюДату           │ getRealDate                    │
//│ 62 │ Копировать                     │ copy                           │
//│ 63 │ КопироватьВ                    │ copyTo                         │
//│ 64 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtDate (QtДата) - КОМПАКТНАЯ ВЕРСИЯ ============================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Дата1_1 = Новый QtДата()
    Дата1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    ВывестиСтрокуВКонсоль("    Текущая дата: " + Дата1_1.toString())
    
    // ===== 2. КОНСТАНТЫ МЕСЯЦЕВ =====
    янв = Дата1_1.January()
    фев = Дата1_1.February()
    мар = Дата1_1.March()
    апр = Дата1_1.April()
    май = Дата1_1.May()
    июн = Дата1_1.June()
    июл = Дата1_1.July()
    авг = Дата1_1.August()
    сен = Дата1_1.September()
    окт = Дата1_1.October()
    ноя = Дата1_1.November()
    дек = Дата1_1.December()
    ВывестиСтрокуВКонсоль("    Константы месяцев: Янв=" + янв + ", Фев=" + фев + ", Мар=" + мар + ", Апр=" + апр + ", Май=" + май + ", Июн=" + июн + ", Июл=" + июл + ", Авг=" + авг + ", Сен=" + сен + ", Окт=" + окт + ", Ноя=" + ноя + ", Дек=" + дек + " (ожидается 1-12)")
    
    // ===== 3. КОНСТАНТЫ ДНЕЙ НЕДЕЛИ =====
    пн = Дата1_1.Monday()
    вт = Дата1_1.Tuesday()
    ср = Дата1_1.Wednesday()
    чт = Дата1_1.Thursday()
    пт = Дата1_1.Friday()
    сб = Дата1_1.Saturday()
    вс = Дата1_1.Sunday()
    ВывестиСтрокуВКонсоль("    Константы дней недели: Пн=" + пн + ", Вт=" + вт + ", Ср=" + ср + ", Чт=" + чт + ", Пт=" + пт + ", Сб=" + сб + ", Вс=" + вс + " (ожидается 1-7)")
    
    // ===== 4. УСТАНОВКА ДАТЫ =====
    Дата1_2 = Новый QtДата()
    Дата1_2.РежимОтладки(Режим_Отладки)
    Дата1_2.setDate(2025, 12, 25)
    строка1 = Дата1_2.toString()
    ВывестиСтрокуВКонсоль("    setDate(2025,12,25) -> toString(): " + строка1 + " (ожидается 25.12.2025)")
    
    Дата1_2.УстановитьДату(2024, 7, 15)
    строка2 = Дата1_2.toString()
    ВывестиСтрокуВКонсоль("    УстановитьДату(2024,7,15) -> toString(): " + строка2 + " (ожидается 15.07.2024)")
    
    // ===== 5. ПОЛУЧЕНИЕ КОМПОНЕНТОВ =====
    Дата1_3 = Новый QtДата()
    Дата1_3.РежимОтладки(Режим_Отладки)
    Дата1_3.setDate(2025, 3, 10)
    год = Дата1_3.year()
    месяц = Дата1_3.month()
    день = Дата1_3.day()
    деньНедели = Дата1_3.dayOfWeek()
    деньГода = Дата1_3.dayOfYear()
    ВывестиСтрокуВКонсоль("    year(): " + год + " (ожидается 2025)")
    ВывестиСтрокуВКонсоль("    month(): " + месяц + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    day(): " + день + " (ожидается 10)")
    ВывестиСтрокуВКонсоль("    dayOfWeek(): " + деньНедели + " (понедельник=1)")
    ВывестиСтрокуВКонсоль("    dayOfYear(): " + деньГода)
    
    // ===== 6. ДНИ В МЕСЯЦЕ/ГОДУ =====
    Дата1_4 = Новый QtДата()
    Дата1_4.РежимОтладки(Режим_Отладки)
    Дата1_4.setDate(2024, 2, 1)
    днейВМесяце = Дата1_4.daysInMonth()
    днейВГоду = Дата1_4.daysInYear()
    ВывестиСтрокуВКонсоль("    daysInMonth() для фев 2024: " + днейВМесяце + " (ожидается 29)")
    ВывестиСтрокуВКонсоль("    daysInYear() для 2024: " + днейВГоду + " (ожидается 366)")
    
    Дата1_5 = Новый QtДата()
    Дата1_5.РежимОтладки(Режим_Отладки)
    Дата1_5.setDate(2023, 2, 1)
    днейВМесяце2 = Дата1_5.daysInMonth()
    днейВГоду2 = Дата1_5.daysInYear()
    ВывестиСтрокуВКонсоль("    daysInMonth() для фев 2023: " + днейВМесяце2 + " (ожидается 28)")
    ВывестиСтрокуВКонсоль("    daysInYear() для 2023: " + днейВГоду2 + " (ожидается 365)")
    
    // ===== 7. КОРРЕКТНОСТЬ =====
    Дата1_6 = Новый QtДата()
    Дата1_6.РежимОтладки(Режим_Отладки)
    Дата1_6.setDate(2025, 6, 15)
    валид1 = Дата1_6.isValid()
    ВывестиСтрокуВКонсоль("    isValid() для 15.06.2025: " + валид1 + " (ожидается true)")
    
    Дата1_7 = Новый QtДата()
    Дата1_7.РежимОтладки(Режим_Отладки)
    Дата1_7.setDate(2025, 13, 1)
    валид2 = Дата1_7.isValid()
    ВывестиСтрокуВКонсоль("    isValid() для 13 месяца: " + валид2 + " (ожидается false)")
    
    // ===== 8. ПУСТАЯ ДАТА =====
    Дата1_8 = Новый QtДата()
    Дата1_8.РежимОтладки(Режим_Отладки)
    Дата1_8.setDate(2025, 1, 1)
    нулл1 = Дата1_8.isNull()
    ВывестиСтрокуВКонсоль("    isNull() для корректной даты: " + нулл1 + " (ожидается false)")
    
    // ===== 9. ДОБАВЛЕНИЕ ДНЕЙ/МЕСЯЦЕВ/ЛЕТ =====
    Дата1_9 = Новый QtДата()
    Дата1_9.РежимОтладки(Режим_Отладки)
    Дата1_9.setDate(2025, 1, 1)
    ВывестиСтрокуВКонсоль("    Исходная: " + Дата1_9.toString())
    
    Дата1_10 = Дата1_9.addDays(10)
    строка10 = Дата1_10.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    addDays(10): " + строка10 + " (ожидается 11.01.2025)")
    
    Дата1_11 = Дата1_9.addMonths(2)
    строка11 = Дата1_11.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    addMonths(2): " + строка11 + " (ожидается 01.03.2025)")
    
    Дата1_12 = Дата1_9.addYears(1)
    строка12 = Дата1_12.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    addYears(1): " + строка12 + " (ожидается 01.01.2026)")
    
    // ===== 10. РАЗНИЦА В ДНЯХ =====
    Дата1_13 = Новый QtДата()
    Дата1_13.РежимОтладки(Режим_Отладки)
    Дата1_13.setDate(2025, 1, 1)
    Дата1_14 = Новый QtДата()
    Дата1_14.РежимОтладки(Режим_Отладки)
    Дата1_14.setDate(2025, 1, 10)
    //дней = Дата1_13.daysTo(Дата1_14)
    //дней2 = Дата1_14.daysTo(Дата1_13)
    //ВывестиСтрокуВКонсоль("    daysTo(01.01 -> 10.01): " + дней + " (ожидается 9)")
    //ВывестиСтрокуВКонсоль("    daysTo(10.01 -> 01.01): " + дней2 + " (ожидается -9)")
    
    // ===== 11. СРАВНЕНИЕ =====
    Дата1_15 = Новый QtДата()
    Дата1_15.РежимОтладки(Режим_Отладки)
    Дата1_15.setDate(2025, 5, 10)
    Дата1_16 = Новый QtДата()
    Дата1_16.РежимОтладки(Режим_Отладки)
    Дата1_16.setDate(2025, 5, 10)
    Дата1_17 = Новый QtДата()
    Дата1_17.РежимОтладки(Режим_Отладки)
    Дата1_17.setDate(2025, 6, 1)
    //равно1 = Дата1_15.equals(Дата1_16)
    //равно2 = Дата1_15.equals(Дата1_17)
    //меньше = Дата1_15.lessThan(Дата1_17)
    //больше = Дата1_17.greaterThan(Дата1_15)
    //ВывестиСтрокуВКонсоль("    equals(10.05, 10.05): " + равно1 + " (ожидается true)")
    //ВывестиСтрокуВКонсоль("    equals(10.05, 01.06): " + равно2 + " (ожидается false)")
    //ВывестиСтрокуВКонсоль("    lessThan(10.05, 01.06): " + меньше + " (ожидается true)")
    //ВывестиСтрокуВКонсоль("    greaterThan(01.06, 10.05): " + больше + " (ожидается true)")
    
    // ===== 12. ТЕКУЩАЯ ДАТА =====
    Дата1_18 = Дата1_1.currentDate()
    строка18 = Дата1_18.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    currentDate(): " + строка18)
    
    // ===== 13. ИЗ СТРОКИ =====
    Дата1_19 = Дата1_1.fromString("25.12.2025", "dd.MM.yyyy")
    строка19 = Дата1_19.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    fromString('25.12.2025'): " + строка19 + " (ожидается 25.12.2025)")
    
    Дата1_20 = Дата1_1.fromString("2025-07-15", "yyyy-MM-dd")
    строка20 = Дата1_20.toString("dd.MM.yyyy")
    ВывестиСтрокуВКонсоль("    fromString('2025-07-15'): " + строка20 + " (ожидается 15.07.2025)")
    
    // ===== 14. ВИСОКОСНЫЙ ГОД =====
    високосный1 = Дата1_1.isLeapYear(2024)
    високосный2 = Дата1_1.isLeapYear(2025)
    високосный3 = Дата1_1.isLeapYear(2000)
    високосный4 = Дата1_1.isLeapYear(1900)
    ВывестиСтрокуВКонсоль("    isLeapYear(2024): " + високосный1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isLeapYear(2025): " + високосный2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isLeapYear(2000): " + високосный3 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isLeapYear(1900): " + високосный4 + " (ожидается false)")
    
    // ===== 15. МЕСЯЦЕВ В ГОДУ =====
    месяцев = Дата1_1.monthsInYear()
    ВывестиСтрокуВКонсоль("    monthsInYear(): " + месяцев + " (ожидается 12)")
    
    // ===== 16. ФОРМАТИРОВАНИЕ =====
    Дата1_21 = Новый QtДата()
    Дата1_21.РежимОтладки(Режим_Отладки)
    Дата1_21.setDate(2025, 8, 20)
    формат1 = Дата1_21.toString()
    ВывестиСтрокуВКонсоль("    toString() по умолчанию: " + формат1 + " (ожидается 20.08.2025)")
    
    // ===== 17. ДЕНЬ НЕДЕЛИ =====
    Дата1_22 = Новый QtДата()
    Дата1_22.РежимОтладки(Режим_Отладки)
    Дата1_22.setDate(2025, 1, 1)
    деньНедели2 = Дата1_22.dayOfWeek()
    ВывестиСтрокуВКонсоль("    dayOfWeek(01.01.2025): " + деньНедели2 + " (среда=3)")
    
    Дата1_23 = Новый QtДата()
    Дата1_23.РежимОтладки(Режим_Отладки)
    Дата1_23.setDate(2025, 1, 6)
    деньНедели3 = Дата1_23.dayOfWeek()
    ВывестиСтрокуВКонсоль("    dayOfWeek(06.01.2025): " + деньНедели3 + " (понедельник=1)")
    
    // ===== 18. RUSFUNC =====
    Если typeof Дата1_1.RusFunc === 'function' Тогда
        jsonStr = Дата1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
      
    ВывестиСтрокуВКонсоль("==== Тест QtDate (QtДата) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtДатаВремя()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ УстановитьДатуВремя            │ setDateTime                    │
//│ 20 │ УстановитьДату                 │ setDate                        │
//│ 21 │ УстановитьВремя                │ setTime                        │
//│ 22 │ Год                            │ year                           │
//│ 23 │ Месяц                          │ month                          │
//│ 24 │ День                           │ day                            │
//│ 25 │ Час                            │ hour                           │
//│ 26 │ Минута                         │ minute                         │
//│ 27 │ Секунда                        │ second                         │
//│ 28 │ Миллисекунда                   │ millisecond                    │
//│ 29 │ ДеньНедели                     │ dayOfWeek                      │
//│ 30 │ ДеньГода                       │ dayOfYear                      │
//│ 31 │ ДнейВМесяце                    │ daysInMonth                    │
//│ 32 │ ДнейВГоду                      │ daysInYear                     │
//│ 33 │ Корректен                      │ isValid                        │
//│ 34 │ Пустой                         │ isNull                         │
//│ 35 │ ВСтроку                        │ toString                       │
//│ 36 │ ВISOСтроку                     │ toIsoString                    │
//│ 37 │ ДобавитьДни                    │ addDays                        │
//│ 38 │ ДобавитьМесяцы                 │ addMonths                      │
//│ 39 │ ДобавитьГоды                   │ addYears                       │
//│ 40 │ ДобавитьСекунды                │ addSeconds                     │
//│ 41 │ ДобавитьМиллисекунды           │ addMilliseconds                │
//│ 42 │ ДнейДо                         │ daysTo                         │
//│ 43 │ СекундДо                       │ secondsTo                      │
//│ 44 │ МиллисекундДо                  │ millisecondsTo                 │
//│ 45 │ Равно                          │ equals                         │
//│ 46 │ Меньше                         │ lessThan                       │
//│ 47 │ Больше                         │ greaterThan                    │
//│ 48 │ ТекущаяДатаВремя               │ currentDateTime                │
//│ 49 │ ТекущаяДатаВремяUTC            │ currentDateTimeUtc             │
//│ 50 │ ИзСтроки                       │ fromString                     │
//│ 51 │ ИзISOСтроки                    │ fromIsoString                  │
//│ 52 │ ВисокосныйГод                  │ isLeapYear                     │
//│ 53 │ ТекущееВремяМс                 │ currentTime                    │
//│ 54 │ ПолучитьРеальнуюДатуВремя      │ getRealDateTime                │
//│ 55 │ Копировать                     │ copy                           │
//│ 56 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtDateTime (QtДатаВремя) - КОМПАКТНАЯ ВЕРСИЯ ===================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Дата2_1 = Новый QtДатаВремя()
    Дата2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    ВывестиСтрокуВКонсоль("    Текущие дата и время: " + Дата2_1.toString())
    
    // ===== 2. УСТАНОВКА ДАТЫ =====
    Дата2_2 = Новый QtДатаВремя()
    Дата2_2.РежимОтладки(Режим_Отладки)
    Дата2_2.setDateTime(2025, 1, 1, 12, 0, 0, 0)
    Дата2_2.setDate(2025, 12, 25)
    строка1 = Дата2_2.toString()
    ВывестиСтрокуВКонсоль("    setDate(2025,12,25) -> " + строка1 + " (время 12:00:00)")
    
    Дата2_2.УстановитьДату(2024, 7, 15)
    строка2 = Дата2_2.toString()
    ВывестиСтрокуВКонсоль("    УстановитьДату(2024,7,15) -> " + строка2 + " (время 12:00:00)")
    
    // ===== 3. УСТАНОВКА ВРЕМЕНИ =====
    Дата2_3 = Новый QtДатаВремя()
    Дата2_3.РежимОтладки(Режим_Отладки)
    Дата2_3.setDateTime(2025, 1, 1, 0, 0, 0, 0)
    Дата2_3.setTime(14, 30, 45, 500)
    строка3 = Дата2_3.toString()
    ВывестиСтрокуВКонсоль("    setTime(14,30,45,500) -> " + строка3)
    
    Дата2_3.УстановитьВремя(8, 15, 0, 0)
    строка4 = Дата2_3.toString()
    ВывестиСтрокуВКонсоль("    УстановитьВремя(8,15,0,0) -> " + строка4)
    
    // ===== 4. УСТАНОВКА ДАТЫ+ВРЕМЕНИ =====
    Дата2_4 = Новый QtДатаВремя()
    Дата2_4.РежимОтладки(Режим_Отладки)
    Дата2_4.setDateTime(2025, 6, 15, 10, 30, 0, 0)
    строка5 = Дата2_4.toString()
    ВывестиСтрокуВКонсоль("    setDateTime(2025,6,15,10,30,0,0) -> " + строка5)
    
    Дата2_4.УстановитьДатуВремя(2024, 12, 25, 23, 59, 59, 999)
    строка6 = Дата2_4.toString()
    ВывестиСтрокуВКонсоль("    УстановитьДатуВремя(2024,12,25,23,59,59,999) -> " + строка6)
    
    // ===== 5. ПОЛУЧЕНИЕ КОМПОНЕНТОВ =====
    Дата2_5 = Новый QtДатаВремя()
    Дата2_5.РежимОтладки(Режим_Отладки)
    Дата2_5.setDateTime(2025, 3, 10, 14, 25, 30, 250)
    год = Дата2_5.year()
    месяц = Дата2_5.month()
    день = Дата2_5.day()
    час = Дата2_5.hour()
    минута = Дата2_5.minute()
    секунда = Дата2_5.second()
    миллисекунда = Дата2_5.millisecond()
    ВывестиСтрокуВКонсоль("    year(): " + год + " (ожидается 2025)")
    ВывестиСтрокуВКонсоль("    month(): " + месяц + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    day(): " + день + " (ожидается 10)")
    ВывестиСтрокуВКонсоль("    hour(): " + час + " (ожидается 14)")
    ВывестиСтрокуВКонсоль("    minute(): " + минута + " (ожидается 25)")
    ВывестиСтрокуВКонсоль("    second(): " + секунда + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    millisecond(): " + миллисекунда + " (ожидается 250)")
    
    // ===== 6. ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ ДАТЫ =====
    Дата2_6 = Новый QtДатаВремя()
    Дата2_6.РежимОтладки(Режим_Отладки)
    Дата2_6.setDate(2025, 1, 1)
    деньНедели = Дата2_6.dayOfWeek()
    деньГода = Дата2_6.dayOfYear()
    днейВМесяце = Дата2_6.daysInMonth()
    днейВГоду = Дата2_6.daysInYear()
    ВывестиСтрокуВКонсоль("    dayOfWeek(01.01.2025): " + деньНедели + " (среда=3)")
    ВывестиСтрокуВКонсоль("    dayOfYear(01.01.2025): " + деньГода + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    daysInMonth(янв 2025): " + днейВМесяце + " (ожидается 31)")
    ВывестиСтрокуВКонсоль("    daysInYear(2025): " + днейВГоду + " (ожидается 365)")
    
    Дата2_7 = Новый QtДатаВремя()
    Дата2_7.РежимОтладки(Режим_Отладки)
    Дата2_7.setDate(2024, 2, 1)
    днейВМесяце2 = Дата2_7.daysInMonth()
    днейВГоду2 = Дата2_7.daysInYear()
    ВывестиСтрокуВКонсоль("    daysInMonth(фев 2024): " + днейВМесяце2 + " (ожидается 29)")
    ВывестиСтрокуВКонсоль("    daysInYear(2024): " + днейВГоду2 + " (ожидается 366)")
    
    // ===== 7. КОРРЕКТНОСТЬ =====
    Дата2_8 = Новый QtДатаВремя()
    Дата2_8.РежимОтладки(Режим_Отладки)
    Дата2_8.setDateTime(2025, 6, 15, 12, 30, 45, 0)
    валид1 = Дата2_8.isValid()
    ВывестиСтрокуВКонсоль("    isValid() для 15.06.2025 12:30:45: " + валид1 + " (ожидается true)")
    
    Дата2_9 = Новый QtДатаВремя()
    Дата2_9.РежимОтладки(Режим_Отладки)
    Дата2_9.setDateTime(2025, 13, 1, 0, 0, 0, 0)
    валид2 = Дата2_9.isValid()
    ВывестиСтрокуВКонсоль("    isValid() для 13 месяца: " + валид2 + " (ожидается false)")
    
    // ===== 8. ПУСТАЯ ДАТА+ВРЕМЯ =====
    Дата2_10 = Новый QtДатаВремя()
    Дата2_10.РежимОтладки(Режим_Отладки)
    Дата2_10.setDateTime(2025, 1, 1, 0, 0, 0, 0)
    нулл1 = Дата2_10.isNull()
    ВывестиСтрокуВКонсоль("    isNull() для корректной даты+времени: " + нулл1 + " (ожидается false)")
    
    // ===== 9. ДОБАВЛЕНИЕ ДНЕЙ/МЕСЯЦЕВ/ЛЕТ =====
    Дата2_11 = Новый QtДатаВремя()
    Дата2_11.РежимОтладки(Режим_Отладки)
    Дата2_11.setDateTime(2025, 1, 1, 0, 0, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходная: " + Дата2_11.toString())
    
    Дата2_12 = Дата2_11.addDays(10)
    Дата2_12.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    addDays(10): " + Дата2_12.toString() + " (ожидается 11.01.2025 00:00:00)")
    
    Дата2_13 = Дата2_11.addMonths(2)
    Дата2_13.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    addMonths(2): " + Дата2_13.toString() + " (ожидается 01.03.2025 00:00:00)")
    
    Дата2_14 = Дата2_11.addYears(1)
    Дата2_14.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    addYears(1): " + Дата2_14.toString() + " (ожидается 01.01.2026 00:00:00)")
    
    // ===== 10. ДОБАВЛЕНИЕ СЕКУНД/МИЛЛИСЕКУНД =====
    Дата2_15 = Новый QtДатаВремя()
    Дата2_15.РежимОтладки(Режим_Отладки)
    Дата2_15.setDateTime(2025, 1, 1, 10, 0, 0, 0)
    ВывестиСтрокуВКонсоль("    Исходная: " + Дата2_15.toString())
    
    Дата2_16 = Дата2_15.addSeconds(65)
    Дата2_16.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    addSeconds(65): " + Дата2_16.toString() + " (ожидается 01.01.2025 10:01:05)")
    
    Дата2_17 = Дата2_15.addMilliseconds(1500)
    Дата2_17.setDebug(Режим_Отладки)
    мс17 = Дата2_17.millisecond()
    ВывестиСтрокуВКонсоль("    addMilliseconds(1500): " + Дата2_17.toString() + " (мс=" + мс17 + ", ожидается 500)")
    
    // ===== 11. РАЗНИЦА =====
    Дата2_18 = Новый QtДатаВремя()
    Дата2_18.РежимОтладки(Режим_Отладки)
    Дата2_18.setDateTime(2025, 1, 1, 10, 0, 0, 0)
    Дата2_19 = Новый QtДатаВремя()
    Дата2_19.РежимОтладки(Режим_Отладки)
    Дата2_19.setDateTime(2025, 1, 10, 10, 5, 30, 500)
    дней = Дата2_18.daysTo(Дата2_19)
    секунд = Дата2_18.secondsTo(Дата2_19)
    миллисекунд = Дата2_18.millisecondsTo(Дата2_19)
    ВывестиСтрокуВКонсоль("    daysTo(): " + дней + " (ожидается 9)")
    ВывестиСтрокуВКонсоль("    secondsTo(): " + секунд + " (ожидается 777930)")
    ВывестиСтрокуВКонсоль("    millisecondsTo(): " + миллисекунд + " (ожидается 777930500)")
    
    // ===== 12. СРАВНЕНИЕ =====
    Дата2_20 = Новый QtДатаВремя()
    Дата2_20.РежимОтладки(Режим_Отладки)
    Дата2_20.setDateTime(2025, 5, 10, 12, 30, 0, 0)
    Дата2_21 = Новый QtДатаВремя()
    Дата2_21.РежимОтладки(Режим_Отладки)
    Дата2_21.setDateTime(2025, 5, 10, 12, 30, 0, 0)
    Дата2_22 = Новый QtДатаВремя()
    Дата2_22.РежимОтладки(Режим_Отладки)
    Дата2_22.setDateTime(2025, 6, 1, 0, 0, 0, 0)
    равно1 = Дата2_20.equals(Дата2_21)
    равно2 = Дата2_20.equals(Дата2_22)
    меньше = Дата2_20.lessThan(Дата2_22)
    больше = Дата2_22.greaterThan(Дата2_20)
    ВывестиСтрокуВКонсоль("    equals(10.05, 10.05): " + равно1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    equals(10.05, 01.06): " + равно2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    lessThan(10.05, 01.06): " + меньше + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    greaterThan(01.06, 10.05): " + больше + " (ожидается true)")
    
    // ===== 13. ТЕКУЩАЯ ДАТА+ВРЕМЯ =====
    Дата2_23 = Дата2_1.currentDateTime()
    Дата2_23.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    currentDateTime(): " + Дата2_23.toString())
    
    // ===== 14. ИЗ СТРОКИ =====
    Дата2_24 = Дата2_1.fromString("25.12.2025 15:30:45", "dd.MM.yyyy hh:mm:ss")
    Дата2_24.setDebug(Режим_Отладки)
    строка24 = Дата2_24.toString()
    ВывестиСтрокуВКонсоль("    fromString('25.12.2025 15:30:45'): " + строка24 + " (ожидается 25.12.2025 15:30:45)")
    
    Дата2_25 = Дата2_1.fromString("2025-07-15 08:15:30", "yyyy-MM-dd hh:mm:ss")
    Дата2_25.setDebug(Режим_Отладки)
    строка25 = Дата2_25.toString()
    ВывестиСтрокуВКонсоль("    fromString('2025-07-15 08:15:30'): " + строка25 + " (ожидается 15.07.2025 08:15:30)")
    
    // ===== 15. ISO ФОРМАТ =====
    Дата2_26 = Новый QtДатаВремя()
    Дата2_26.РежимОтладки(Режим_Отладки)
    Дата2_26.setDateTime(2025, 8, 20, 14, 30, 45, 500)
    iso = Дата2_26.toIsoString()
    ВывестиСтрокуВКонсоль("    toIsoString(): " + iso)
    
    Дата2_27 = Дата2_1.fromIsoString(iso)
    Дата2_27.setDebug(Режим_Отладки)
    строка27 = Дата2_27.toString()
    ВывестиСтрокуВКонсоль("    fromIsoString() -> " + строка27 + " (ожидается 20.08.2025 14:30:45)")
    
    // ===== 16. ВИСОКОСНЫЙ ГОД =====
    високосный1 = Дата2_1.isLeapYear(2024)
    високосный2 = Дата2_1.isLeapYear(2025)
    високосный3 = Дата2_1.isLeapYear(2000)
    високосный4 = Дата2_1.isLeapYear(1900)
    ВывестиСтрокуВКонсоль("    isLeapYear(2024): " + високосный1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isLeapYear(2025): " + високосный2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isLeapYear(2000): " + високосный3 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isLeapYear(1900): " + високосный4 + " (ожидается false)")
    
    // ===== 17. ТЕКУЩЕЕ ВРЕМЯ В МС =====
    текМс = Дата2_1.currentTime()
    ВывестиСтрокуВКонсоль("    currentTime(): " + текМс + " мс с начала эпохи (ожидается > 0)")
    
    // ===== 18. ФОРМАТИРОВАНИЕ =====
    Дата2_28 = Новый QtДатаВремя()
    Дата2_28.РежимОтладки(Режим_Отладки)
    Дата2_28.setDateTime(2025, 8, 20, 14, 5, 30, 250)
    формат = Дата2_28.toString()
    ВывестиСтрокуВКонсоль("    toString() по умолчанию: " + формат + " (ожидается 20.08.2025 14:05:30)")
    
    // ===== 19. UTC ВРЕМЯ =====
    Дата2_29 = Дата2_1.currentDateTimeUtc()
    Дата2_29.setDebug(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    currentDateTimeUtc(): " + Дата2_29.toString())
    
    // ===== 20. RUSFUNC =====
    Если typeof Дата2_1.RusFunc === 'function' Тогда
        jsonStr = Дата2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
  
    ВывестиСтрокуВКонсоль("==== Тест QtDateTime (QtДатаВремя) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtБайтМассив()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ПолучитьДанные                 │ getData                        │
//│ 20 │ ПолучитьКакСтроку              │ getAsString                    │
//│ 21 │ ПолучитьДлину                  │ getLength                      │
//│ 22 │ ПолучитьРазмер                 │ getSize                        │
//│ 23 │ ПолучитьПусто                  │ getIsEmpty                     │
//│ 24 │ ПолучитьСимвол                 │ getCharAt                      │
//│ 25 │ ПолучитьСередину               │ getMid                         │
//│ 26 │ ПолучитьЛевуюЧасть             │ getLeft                        │
//│ 27 │ ПолучитьПравуюЧасть            │ getRight                       │
//│ 28 │ ПолучитьHex                    │ getHex                         │
//│ 29 │ ПолучитьBase64                 │ getBase64                      │
//│ 30 │ ДобавитьДанные                 │ appendData                     │
//│ 31 │ ДобавитьСтроку                 │ appendString                   │
//│ 32 │ ДобавитьСимвол                 │ appendChar                     │
//│ 33 │ ВставитьВНачало                │ prependData                    │
//│ 34 │ ВставитьВНачалоСтроку          │ prependString                  │
//│ 35 │ ВставитьВНачалоСимвол          │ prependChar                    │
//│ 36 │ ВставитьДанные                 │ insertData                     │
//│ 37 │ ВставитьСтроку                 │ insertString                   │
//│ 38 │ ВставитьСимвол                 │ insertChar                     │
//│ 39 │ УдалитьДанные                  │ removeData                     │
//│ 40 │ ЗаменитьДанные                 │ replaceData                    │
//│ 41 │ ЗаменитьСтроку                 │ replaceString                  │
//│ 42 │ ЗаменитьСимвол                 │ replaceChar                    │
//│ 43 │ ЗаменитьПоИндексу              │ replaceAt                      │
//│ 44 │ ОчиститьДанные                 │ clearData                      │
//│ 45 │ ИзменитьРазмер                 │ resizeData                     │
//│ 46 │ ОбрезатьДанные                 │ truncateData                   │
//│ 47 │ ОтрезатьДанные                 │ chopData                       │
//│ 48 │ НайтиДанные                    │ findData                       │
//│ 49 │ НайтиСтроку                    │ findString                     │
//│ 50 │ НайтиСимвол                    │ findChar                       │
//│ 51 │ НайтиПоследниеДанные           │ findLastData                   │
//│ 52 │ НайтиПоследнююСтроку           │ findLastString                 │
//│ 53 │ НайтиПоследнийСимвол           │ findLastChar                   │
//│ 54 │ СодержитДанные                 │ containsData                   │
//│ 55 │ СодержитСтроку                 │ containsString                 │
//│ 56 │ СодержитСимвол                 │ containsChar                   │
//│ 57 │ НачинаетсяСДанных              │ startsWithData                 │
//│ 58 │ НачинаетсяСоСтрокой            │ startsWithString               │
//│ 59 │ НачинаетсяССимволом            │ startsWithChar                 │
//│ 60 │ ЗаканчиваетсяНаДанные          │ endsWithData                   │
//│ 61 │ ЗаканчиваетсяНаСтроку          │ endsWithString                 │
//│ 62 │ ЗаканчиваетсяНаСимвол          │ endsWithChar                   │
//│ 63 │ КоличествоДанных               │ countData                      │
//│ 64 │ КоличествоСтрок                │ countString                    │
//│ 65 │ КоличествоСимволов             │ countChar                      │
//│ 66 │ ВHexСтроку                     │ toHexString                    │
//│ 67 │ ВBase64Строку                  │ toBase64String                 │
//│ 68 │ ВPercentEncodingСтроку         │ toPercentEncodingString        │
//│ 69 │ ВLatin1Строку                  │ toLatin1String                 │
//│ 70 │ ВUtf8Строку                    │ toUtf8String                   │
//│ 71 │ ПолучитьСжатые                 │ getCompressed                  │
//│ 72 │ ПолучитьРаспакованные          │ getDecompressed                │
//│ 73 │ ВBase64БезРавных               │ toBase64WithoutEquals          │
//│ 74 │ ЯвляетсяНулевым                │ isNull                         │
//│ 75 │ ЗаполнитьСимволом              │ fillWithChar                   │
//│ 76 │ ПолучитьУпрощенные             │ getSimplified                  │
//│ 77 │ ПолучитьОбрезанные             │ getTrimmed                     │
//│ 78 │ ПолучитьНижнийРегистр          │ getLower                       │
//│ 79 │ ПолучитьВерхнийРегистр         │ getUpper                       │
//│ 80 │ ПолучитьПовторенные            │ getRepeated                    │
//│ 81 │ ПолучитьЕмкость                │ getCapacity                    │
//│ 82 │ ЗарезервироватьПамять          │ reserveSpace                   │
//│ 83 │ СжатьПамять                    │ shrinkMemory                   │
//│ 84 │ РавноДанным                    │ equalsData                     │
//│ 85 │ РавноСтроке                    │ equalsString                   │
//│ 86 │ МеньшеЧем                      │ isLessThan                     │
//│ 87 │ БольшеЧем                      │ isGreaterThan                  │
//│ 88 │ СравнитьДанные                 │ compareData                    │
//│ 89 │ СравнитьСоСтрокой              │ compareString                  │
//│ 90 │ ЧислоВСтроку                   │ numberToStr                    │
//│ 91 │ ДлинноеЧислоВСтроку            │ numberLongToStr                │
//│ 92 │ ЧислоСПлавающейТочкойВСтроку   │ numberDoubleToStr              │
//│ 93 │ ИзHexСтроки                    │ fromHexString                  │
//│ 94 │ ИзBase64Строки                 │ fromBase64String               │
//│ 95 │ ИзPercentEncodingСтроки        │ fromPercentEncodingString      │
//│ 96 │ ПолучитьQByteArray             │ getRealByteArray               │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtByteArray (QtБайтМассив) - КОМПАКТНАЯ ВЕРСИЯ ================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Байт_1 = Новый QtБайтМассив()
    Байт_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. РАЗМЕР И ДЛИНА =====
    размер = Байт_1.getSize()
    длина = Байт_1.getLength()
    пусто = Байт_1.getIsEmpty()
    ВывестиСтрокуВКонсоль("    getSize(): " + размер + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    getLength(): " + длина + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    getIsEmpty(): " + пусто + " (ожидается true)")
    
    // ===== 3. ДОБАВЛЕНИЕ ДАННЫХ =====
    Байт_2 = Новый QtБайтМассив()
    Байт_2.РежимОтладки(Режим_Отладки)
    Байт_2.appendString("Hello")
    Байт_2.appendChar(32)
    Байт_2.appendString("World")
    результат2 = Байт_2.getAsString()
    размер2 = Байт_2.getSize()
    ВывестиСтрокуВКонсоль("    appendString('Hello'), appendChar(32), appendString('World') -> getAsString(): " + результат2 + " (ожидается Hello World)")
    ВывестиСтрокуВКонсоль("    getSize(): " + размер2 + " (ожидается 11)")
    
    // ===== 4. ВСТАВКА ДАННЫХ =====
    Байт_3 = Новый QtБайтМассив("HelloWorld")
    Байт_3.РежимОтладки(Режим_Отладки)
    Байт_3.insertString(5, " ")
    Байт_3.prependString("Start: ")
    Байт_3.insertChar(Байт_3.getSize(), 33)
    результат3 = Байт_3.getAsString()
    ВывестиСтрокуВКонсоль("    insertString(5,' '), prependString('Start: '), insertChar(end,'!') -> getAsString(): " + результат3 + " (ожидается Start: Hello World!)")
    
    // ===== 5. ДОСТУП К СИМВОЛАМ =====
    Байт_4 = Новый QtБайтМассив("ABCDEFG")
    Байт_4.РежимОтладки(Режим_Отладки)
    символ = String.fromCharCode(Байт_4.getCharAt(3))
    левая = Байт_4.getLeft(3)
    правая = Байт_4.getRight(3)
    середина = Байт_4.getMid(2, 3)
    ВывестиСтрокуВКонсоль("    getCharAt(3): " + символ + " (ожидается D)")
    ВывестиСтрокуВКонсоль("    getLeft(3): " + левая + " (ожидается ABC)")
    ВывестиСтрокуВКонсоль("    getRight(3): " + правая + " (ожидается EFG)")
    ВывестиСтрокуВКонсоль("    getMid(2,3): " + середина + " (ожидается CDE)")
    
    // ===== 6. УДАЛЕНИЕ ДАННЫХ =====
    Байт_5 = Новый QtБайтМассив("Hello World!")
    Байт_5.РежимОтладки(Режим_Отладки)
    Байт_5.removeData(5, 6)
    результат5 = Байт_5.getAsString()
    размер5 = Байт_5.getSize()
    ВывестиСтрокуВКонсоль("    removeData(5,6) из 'Hello World!' -> getAsString(): " + результат5 + " (ожидается Hello!)")
    ВывестиСтрокуВКонсоль("    getSize(): " + размер5 + " (ожидается 6)")
    
    // ===== 7. ЗАМЕНА ДАННЫХ =====
    Байт_6 = Новый QtБайтМассив("Hello World")
    Байт_6.РежимОтладки(Режим_Отладки)
    Байт_6.replaceString("World", "Qt")
    Байт_6.replaceChar(108, 76)
    Байт_6.replaceString("H", "h")
    результат6 = Байт_6.getAsString()
    ВывестиСтрокуВКонсоль("    replaceString('World','Qt'), replaceChar('l','L'), replaceString('H','h') -> getAsString(): " + результат6 + " (ожидается heLLo Qt)")
    
    // ===== 8. ПОИСК =====
    Байт_7 = Новый QtБайтМассив("The quick brown fox jumps over the lazy dog")
    Байт_7.РежимОтладки(Режим_Отладки)
    позиция1 = Байт_7.findString("fox")
    позиция2 = Байт_7.findChar(113)
    содержит = Байт_7.containsString("brown")
    начало = Байт_7.startsWithString("The")
    конец = Байт_7.endsWithString("dog")
    ВывестиСтрокуВКонсоль("    findString('fox'): " + позиция1 + " (ожидается 16)")
    ВывестиСтрокуВКонсоль("    findChar('q'): " + позиция2 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    containsString('brown'): " + содержит + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    startsWithString('The'): " + начало + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    endsWithString('dog'): " + конец + " (ожидается true)")
    
    // ===== 9. ПРЕОБРАЗОВАНИЕ =====
    Байт_8 = Новый QtБайтМассив("Hello")
    Байт_8.РежимОтладки(Режим_Отладки)
    hex = Байт_8.toHexString()
    base64 = Байт_8.toBase64String()
    utf8 = Байт_8.toUtf8String()
    latin1 = Байт_8.toLatin1String()
    ВывестиСтрокуВКонсоль("    toHexString(): " + hex + " (ожидается 48656C6C6F)")
    ВывестиСтрокуВКонсоль("    toBase64String(): " + base64 + " (ожидается SGVsbG8=)")
    ВывестиСтрокуВКонсоль("    toUtf8String(): " + utf8 + " (ожидается Hello)")
    ВывестиСтрокуВКонсоль("    toLatin1String(): " + latin1 + " (ожидается Hello)")
    
    // ===== 10. СРАВНЕНИЕ =====
    Байт_9 = Новый QtБайтМассив("ABC")
    Байт_10 = Новый QtБайтМассив("ABC")
    Байт_11 = Новый QtБайтМассив("ABD")
    Байт_9.РежимОтладки(Режим_Отладки)
    Байт_10.РежимОтладки(Режим_Отладки)
    Байт_11.РежимОтладки(Режим_Отладки)
    равны = Байт_9.equalsData(Байт_10.getData())
    меньше = Байт_9.isLessThan(Байт_11.getData())
    сравнение = Байт_9.compareData(Байт_10.getData())
    ВывестиСтрокуВКонсоль("    equalsData(ABC vs ABC): " + равны + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isLessThan(ABC vs ABD): " + меньше + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    compareData(ABC vs ABC): " + сравнение + " (ожидается 0)")
    
    // ===== 11. ПРЕОБРАЗОВАНИЕ ЧИСЕЛ =====
    Байт_12 = Новый QtБайтМассив()
    Байт_12.РежимОтладки(Режим_Отладки)
    число1 = Байт_12.numberToStr(42)
    число2 = Байт_12.numberDoubleToStr(3.14159, 4)
    hexStr = Байт_12.fromHexString("48656C6C6F")
    base64Str = Байт_12.fromBase64String("SGVsbG8=")
    ВывестиСтрокуВКонсоль("    numberToStr(42): " + число1 + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    numberDoubleToStr(3.14159,4): " + число2 + " (ожидается 3.142)")
    ВывестиСтрокуВКонсоль("    fromHexString('48656C6C6F'): " + hexStr + " (ожидается Hello)")
    ВывестиСтрокуВКонсоль("    fromBase64String('SGVsbG8='): " + base64Str + " (ожидается Hello)")
    
    // ===== 12. ОПЕРАЦИИ СО СТАТУСОМ =====
    Байт_13 = Новый QtБайтМассив()
    Байт_13.РежимОтладки(Режим_Отладки)
    isNull = Байт_13.isNull()
    Байт_13.fillWithChar(88, 10)
    размер13 = Байт_13.getSize()
    результат13 = Байт_13.getAsString()
    ВывестиСтрокуВКонсоль("    isNull(): " + isNull + " (ожидается true для пустого)")
    ВывестиСтрокуВКонсоль("    fillWithChar('X',10) -> getSize(): " + размер13 + " (ожидается 10)")
    ВывестиСтрокуВКонсоль("    getAsString(): " + результат13 + " (ожидается XXXXXXXXXX)")
    
    Байт_13.clearData()
    Байт_13.appendString("  Hello  World  ")
    упрощ = Байт_13.getSimplified()
    обрез = Байт_13.getTrimmed()
    ВывестиСтрокуВКонсоль("    getSimplified() из '  Hello  World  ': " + упрощ + " (ожидается Hello World)")
    ВывестиСтрокуВКонсоль("    getTrimmed() из '  Hello  World  ': " + обрез + " (ожидается Hello  World)")
    
    // ===== 13. ОЧИСТКА ДАННЫХ =====
    Байт_14 = Новый QtБайтМассив("Test data")
    Байт_14.РежимОтладки(Режим_Отладки)
    Байт_14.clearData()
    размер14 = Байт_14.getSize()
    пусто14 = Байт_14.getIsEmpty()
    ВывестиСтрокуВКонсоль("    clearData() -> getSize(): " + размер14 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    getIsEmpty(): " + пусто14 + " (ожидается true)")
    
    // ===== 14. RUSFUNC =====
    Если typeof Байт_1.RusFunc === 'function' Тогда
        jsonStr = Байт_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtByteArray (QtБайтМассив) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВариант()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ УстановитьЗначение             │ setValue                       │
//│ 20 │ УстановитьСтроку               │ setString                      │
//│ 21 │ УстановитьЧисло                │ setNumber                      │
//│ 22 │ УстановитьЛогику               │ setBool                        │
//│ 23 │ Очистить                       │ clear                          │
//│ 24 │ ПолучитьЗначение               │ getValue                       │
//│ 25 │ ВСтроку                        │ asString                       │
//│ 26 │ ВЧисло                         │ toInt                          │
//│ 27 │ ВДробь                         │ toDouble                       │
//│ 28 │ ВЛогику                        │ toBool                         │
//│ 29 │ Корректен                      │ getIsValid                     │
//│ 30 │ Пустой                         │ getIsNull                      │
//│ 31 │ Тип                            │ getTypeName                    │
//│ 32 │ ЭтоСтрока                      │ getIsString                    │
//│ 33 │ ЭтоЧисло                       │ getIsNumber                    │
//│ 34 │ ЭтоЛогика                      │ getIsBool                      │
//│ 35 │ МожетПреобразовать             │ canConvert                     │
//│ 36 │ ВЧислоПоУмолчанию              │ toIntOrDefault                 │
//│ 37 │ ВДробьПоУмолчанию              │ toDoubleOrDefault              │
//│ 38 │ ВЛогикуПоУмолчанию             │ toBoolOrDefault                │
//│ 39 │ ВСтрокуПоУмолчанию             │ toStringOrDefault              │
//│ 40 │ Копировать                     │ copy                           │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ Отладка                        │ debugInfo                      │
//│ 43 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtVariant (QtВариант) - КОМПАКТНАЯ ВЕРСИЯ =======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Вариант1_1 = Новый QtВариант()
    Вариант1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. НЕИНИЦИАЛИЗИРОВАННЫЙ ВАРИАНТ =====
    тип = Вариант1_1.Тип()
    валид = Вариант1_1.Корректен()
    нулл = Вариант1_1.Пустой()
    строка = Вариант1_1.ЭтоСтрока()
    число = Вариант1_1.ЭтоЧисло()
    логика = Вариант1_1.ЭтоЛогика()
    ВывестиСтрокуВКонсоль("    Тип(): " + тип + " (ожидается undefined)")
    ВывестиСтрокуВКонсоль("    Корректен(): " + валид + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Пустой(): " + нулл + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ЭтоСтрока(): " + строка + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    ЭтоЧисло(): " + число + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    ЭтоЛогика(): " + логика + " (ожидается false)")
    
    // ===== 3. СОЗДАНИЕ С РАЗНЫМИ ТИПАМИ =====
    Вариант1_2 = Новый QtВариант("Привет")
    Вариант1_2.РежимОтладки(Режим_Отладки)
    Вариант1_3 = Новый QtВариант(42)
    Вариант1_3.РежимОтладки(Режим_Отладки)
    Вариант1_4 = Новый QtВариант(3.14)
    Вариант1_4.РежимОтладки(Режим_Отладки)
    Вариант1_5 = Новый QtВариант(ИСТИНА)
    Вариант1_5.РежимОтладки(Режим_Отладки)
    
    тип2 = Вариант1_2.Тип()
    тип3 = Вариант1_3.Тип()
    тип4 = Вариант1_4.Тип()
    тип5 = Вариант1_5.Тип()
    ВывестиСтрокуВКонсоль("    QtВариант('Привет') -> Тип(): " + тип2 + " (ожидается string)")
    ВывестиСтрокуВКонсоль("    QtВариант(42) -> Тип(): " + тип3 + " (ожидается number)")
    ВывестиСтрокуВКонсоль("    QtВариант(3.14) -> Тип(): " + тип4 + " (ожидается number)")
    ВывестиСтрокуВКонсоль("    QtВариант(true) -> Тип(): " + тип5 + " (ожидается boolean)")
    
    // ===== 4. УстановитьЗначение() =====
    Вариант1_6 = Новый QtВариант()
    Вариант1_6.РежимОтладки(Режим_Отладки)
    Вариант1_6.УстановитьЗначение("Тест")
    тип6 = Вариант1_6.Тип()
    знач6 = Вариант1_6.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьЗначение('Тест') -> Тип(): " + тип6 + ", ВСтроку(): " + знач6)
    
    Вариант1_6.УстановитьЗначение(123)
    тип6b = Вариант1_6.Тип()
    знач6b = Вариант1_6.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(123) -> Тип(): " + тип6b + ", ВСтроку(): " + знач6b)
    
    Вариант1_6.УстановитьЗначение(ИСТИНА)
    тип6c = Вариант1_6.Тип()
    знач6c = Вариант1_6.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(true) -> Тип(): " + тип6c + ", ВСтроку(): " + знач6c)
    
    // ===== 5. УстановитьСтроку() / УстановитьЧисло() / УстановитьЛогику() =====
    Вариант1_7 = Новый QtВариант()
    Вариант1_7.РежимОтладки(Режим_Отладки)
    Вариант1_7.УстановитьСтроку("Привет мир")
    тип7 = Вариант1_7.Тип()
    знач7 = Вариант1_7.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьСтроку('Привет мир') -> Тип(): " + тип7 + ", ВСтроку(): " + знач7)
    
    Вариант1_7.УстановитьЧисло(99.9)
    тип7b = Вариант1_7.Тип()
    знач7b = Вариант1_7.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьЧисло(99.9) -> Тип(): " + тип7b + ", ВСтроку(): " + знач7b)
    
    Вариант1_7.УстановитьЛогику(ЛОЖЬ)
    тип7c = Вариант1_7.Тип()
    знач7c = Вариант1_7.ВСтроку()
    ВывестиСтрокуВКонсоль("    УстановитьЛогику(false) -> Тип(): " + тип7c + ", ВСтроку(): " + знач7c)
    
    // ===== 6. ПРЕОБРАЗОВАНИЕ ТИПОВ =====
    Вариант1_8 = Новый QtВариант("123")
    Вариант1_8.РежимОтладки(Режим_Отладки)
    стр8 = Вариант1_8.ВСтроку()
    инт8 = Вариант1_8.ВЧисло()
    дробь8 = Вариант1_8.ВДробь()
    лог8 = Вариант1_8.ВЛогику()
    ВывестиСтрокуВКонсоль("    QtВариант('123') -> ВСтроку(): " + стр8 + ", ВЧисло(): " + инт8 + ", ВДробь(): " + дробь8 + ", ВЛогику(): " + лог8)
    
    Вариант1_8.УстановитьЧисло(42)
    стр8b = Вариант1_8.ВСтроку()
    инт8b = Вариант1_8.ВЧисло()
    дробь8b = Вариант1_8.ВДробь()
    лог8b = Вариант1_8.ВЛогику()
    ВывестиСтрокуВКонсоль("    УстановитьЧисло(42) -> ВСтроку(): " + стр8b + ", ВЧисло(): " + инт8b + ", ВДробь(): " + дробь8b + ", ВЛогику(): " + лог8b)
    
    Вариант1_8.УстановитьЛогику(ЛОЖЬ)
    стр8c = Вариант1_8.ВСтроку()
    инт8c = Вариант1_8.ВЧисло()
    дробь8c = Вариант1_8.ВДробь()
    лог8c = Вариант1_8.ВЛогику()
    ВывестиСтрокуВКонсоль("    УстановитьЛогику(false) -> ВСтроку(): " + стр8c + ", ВЧисло(): " + инт8c + ", ВДробь(): " + дробь8c + ", ВЛогику(): " + лог8c)
    
    // ===== 7. МЕТОДЫ С УМОЛЧАНИЕМ =====
    Вариант1_9 = Новый QtВариант()
    Вариант1_9.РежимОтладки(Режим_Отладки)
    инт9 = Вариант1_9.ВЧислоПоУмолчанию(999)
    дробь9 = Вариант1_9.ВДробьПоУмолчанию(9.99)
    лог9 = Вариант1_9.ВЛогикуПоУмолчанию(ИСТИНА)
    стр9 = Вариант1_9.ВСтрокуПоУмолчанию("по умолчанию")
    ВывестиСтрокуВКонсоль("    Неинициализированный -> ВЧислоПоУмолчанию(999): " + инт9 + " (ожидается 999)")
    ВывестиСтрокуВКонсоль("    ВДробьПоУмолчанию(9.99): " + дробь9 + " (ожидается 9.99)")
    ВывестиСтрокуВКонсоль("    ВЛогикуПоУмолчанию(true): " + лог9 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ВСтрокуПоУмолчанию('по умолчанию'): " + стр9 + " (ожидается по умолчанию)")
    
    Вариант1_9.УстановитьЧисло(100)
    инт9b = Вариант1_9.ВЧислоПоУмолчанию(999)
    дробь9b = Вариант1_9.ВДробьПоУмолчанию(9.99)
    лог9b = Вариант1_9.ВЛогикуПоУмолчанию(ИСТИНА)
    стр9b = Вариант1_9.ВСтрокуПоУмолчанию("по умолчанию")
    ВывестиСтрокуВКонсоль("    После УстановитьЧисло(100) -> ВЧислоПоУмолчанию(999): " + инт9b + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    ВДробьПоУмолчанию(9.99): " + дробь9b + " (ожидается 100)")
    ВывестиСтрокуВКонсоль("    ВЛогикуПоУмолчанию(true): " + лог9b + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ВСтрокуПоУмолчанию('по умолчанию'): " + стр9b + " (ожидается 100)")
    
    // ===== 8. МожетПреобразовать() =====
    Вариант1_10 = Новый QtВариант("123")
    Вариант1_10.РежимОтладки(Режим_Отладки)
    кан1 = Вариант1_10.МожетПреобразовать(0)
    кан2 = Вариант1_10.МожетПреобразовать(1)
    кан3 = Вариант1_10.МожетПреобразовать(2)
    ВывестиСтрокуВКонсоль("    МожетПреобразовать(0) [string]: " + кан1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    МожетПреобразовать(1) [number]: " + кан2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    МожетПреобразовать(2) [boolean]: " + кан3 + " (ожидается true)")
    
    // ===== 9. Очистить() =====
    Вариант1_11 = Новый QtВариант("Значение")
    Вариант1_11.РежимОтладки(Режим_Отладки)
    типДо = Вариант1_11.Тип()
    валидДо = Вариант1_11.Корректен()
    Вариант1_11.Очистить()
    типПосле = Вариант1_11.Тип()
    валидПосле = Вариант1_11.Корректен()
    ВывестиСтрокуВКонсоль("    До Очистить(): Тип(): " + типДо + " (ожидается string), Корректен(): " + валидДо)
    ВывестиСтрокуВКонсоль("    После Очистить(): Тип(): " + типПосле + " (ожидается undefined), Корректен(): " + валидПосле + " (ожидается false)")
    
    // ===== 10. ПолучитьРежимОтладки() =====
    Вариант1_12 = Новый QtВариант(42)
    Вариант1_12.РежимОтладки(Режим_Отладки)
    инфо = Вариант1_12.ПолучитьРежимОтладки()
    ВывестиСтрокуВКонсоль("    ПолучитьРежимОтладки(): " + инфо)
    
    // ===== 11. ПолучитьЗначение() =====
    Вариант1_13 = Новый QtВариант(3.14)
    Вариант1_13.РежимОтладки(Режим_Отладки)
    знач13 = Вариант1_13.ПолучитьЗначение()
    стр13 = знач13.toString()
    ВывестиСтрокуВКонсоль("    ПолучитьЗначение(): " + стр13 + " (ожидается 3.14)")
    
    // ===== 12. RUSFUNC =====
    Если typeof Вариант1_1.RusFunc === 'function' Тогда
        jsonStr = Вариант1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtVariant (QtВариант) завершён.========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtВектор()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Добавить                       │ append                         │
//│ 20 │ ДобавитьВНачало                │ prepend                        │
//│ 21 │ Вставить                       │ insert                         │
//│ 22 │ Удалить                        │ remove                         │
//│ 23 │ УдалитьПервый                  │ removeFirst                    │
//│ 24 │ УдалитьПоследний               │ removeLast                     │
//│ 25 │ Очистить                       │ clear                          │
//│ 26 │ Получить                       │ at                             │
//│ 27 │ Первый                         │ first                          │
//│ 28 │ Последний                      │ last                           │
//│ 29 │ ИзвлечьПоИндексу               │ takeAt                         │
//│ 30 │ ИзвлечьПервый                  │ takeFirst                      │
//│ 31 │ ИзвлечьПоследний               │ takeLast                       │
//│ 32 │ Заполнить                      │ fill                           │
//│ 33 │ Соединить                      │ join                           │
//│ 34 │ ВМассив                        │ toArray                        │
//│ 35 │ ВСтроки                        │ toQStringList                  │
//│ 36 │ ИзменитьРазмер                 │ resize                         │
//│ 37 │ Зарезервировать                │ reserve                        │
//│ 38 │ Ёмкость                        │ capacity                       │
//│ 39 │ Содержит                       │ contains                       │
//│ 40 │ Индекс                         │ indexOf                        │
//│ 41 │ ПоследнийИндекс                │ lastIndexOf                    │
//│ 42 │ Установить                     │ setValue                       │
//│ 43 │ Размер                         │ len                            │
//│ 44 │ Количество                     │ cnt                            │
//│ 45 │ Пустой                         │ empty                          │
//│ 46 │ Копировать                     │ copy                           │
//│ 47 │ КопироватьВ                    │ copyTo                         │
//│ 48 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtVector (QtВектор) - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Вектор1_1 = Новый QtВектор()
    Вектор1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ ВЕКТОР =====
    пуст = Вектор1_1.Пустой()
    размер = Вектор1_1.Размер()
    колво = Вектор1_1.Количество()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + колво + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ =====
    Вектор1_2 = Новый QtВектор()
    Вектор1_2.РежимОтладки(Режим_Отладки)
    Вектор1_2.Добавить("Первый")
    Вектор1_2.Добавить("Второй")
    Вектор1_2.Добавить("Третий")
    размер2 = Вектор1_2.Размер()
    первый2 = Вектор1_2.Первый()
    последний2 = Вектор1_2.Последний()
    ВывестиСтрокуВКонсоль("    Добавить('Первый'), Добавить('Второй'), Добавить('Третий')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер2 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый2 + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний2 + " (ожидается Третий)")
    
    // ===== 4. ДОБАВЛЕНИЕ В НАЧАЛО =====
    Вектор1_3 = Новый QtВектор()
    Вектор1_3.РежимОтладки(Режим_Отладки)
    Вектор1_3.Добавить("Второй")
    Вектор1_3.Добавить("Третий")
    Вектор1_3.ДобавитьВНачало("Первый")
    Вектор1_3.ДобавитьВНачало("Нулевой")
    первый3 = Вектор1_3.Первый()
    размер3 = Вектор1_3.Размер()
    ВывестиСтрокуВКонсоль("    ДобавитьВНачало('Первый'), ДобавитьВНачало('Нулевой')")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый3 + " (ожидается Нулевой)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 4)")
    
    // ===== 5. ВСТАВКА =====
    Вектор1_4 = Новый QtВектор()
    Вектор1_4.РежимОтладки(Режим_Отладки)
    Вектор1_4.Добавить("Первый")
    Вектор1_4.Добавить("Третий")
    Вектор1_4.Вставить(1, "Второй")
    Вектор1_4.Вставить(3, "Четвертый")
    эл0 = Вектор1_4.Получить(0)
    эл1 = Вектор1_4.Получить(1)
    эл2 = Вектор1_4.Получить(2)
    эл3 = Вектор1_4.Получить(3)
    размер4 = Вектор1_4.Размер()
    ВывестиСтрокуВКонсоль("    Вставить(1,'Второй'), Вставить(3,'Четвертый')")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0 + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1 + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2 + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Получить(3): " + эл3 + " (ожидается Четвертый)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер4 + " (ожидается 4)")
    
    // ===== 6. ПОЛУЧЕНИЕ ЭЛЕМЕНТОВ =====
    Вектор1_5 = Новый QtВектор()
    Вектор1_5.РежимОтладки(Режим_Отладки)
    Вектор1_5.Добавить("A")
    Вектор1_5.Добавить("B")
    Вектор1_5.Добавить("C")
    эл1_5 = Вектор1_5.Получить(1)
    эл2_5 = Вектор1_5.Получить(2)
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_5 + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2_5 + " (ожидается C)")
    
    // ===== 7. ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Вектор1_6 = Новый QtВектор()
    Вектор1_6.РежимОтладки(Режим_Отладки)
    Вектор1_6.Добавить("Начало")
    Вектор1_6.Добавить("Середина")
    Вектор1_6.Добавить("Конец")
    первый6 = Вектор1_6.Первый()
    последний6 = Вектор1_6.Последний()
    ВывестиСтрокуВКонсоль("    Первый(): " + первый6 + " (ожидается Начало)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний6 + " (ожидается Конец)")
    
    // ===== 8. УДАЛЕНИЕ =====
    Вектор1_7 = Новый QtВектор()
    Вектор1_7.РежимОтладки(Режим_Отладки)
    Вектор1_7.Добавить("A")
    Вектор1_7.Добавить("B")
    Вектор1_7.Добавить("C")
    Вектор1_7.Добавить("D")
    Вектор1_7.Удалить(1)
    Вектор1_7.Удалить(1)
    эл0_7 = Вектор1_7.Получить(0)
    эл1_7 = Вектор1_7.Получить(1)
    размер7 = Вектор1_7.Размер()
    ВывестиСтрокуВКонсоль("    Удалить(1), Удалить(1)")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_7 + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_7 + " (ожидается D)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер7 + " (ожидается 2)")
    
    // ===== 9. УДАЛИТЬ ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Вектор1_8 = Новый QtВектор()
    Вектор1_8.РежимОтладки(Режим_Отладки)
    Вектор1_8.Добавить("Первый")
    Вектор1_8.Добавить("Второй")
    Вектор1_8.Добавить("Третий")
    Вектор1_8.Добавить("Четвертый")
    Вектор1_8.УдалитьПервый()
    Вектор1_8.УдалитьПоследний()
    первый8 = Вектор1_8.Первый()
    последний8 = Вектор1_8.Последний()
    размер8 = Вектор1_8.Размер()
    ВывестиСтрокуВКонсоль("    УдалитьПервый(), УдалитьПоследний()")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый8 + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний8 + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер8 + " (ожидается 2)")
    
    // ===== 10. ИЗВЛЕЧЬ ПО ИНДЕКСУ =====
    Вектор1_9 = Новый QtВектор()
    Вектор1_9.РежимОтладки(Режим_Отладки)
    Вектор1_9.Добавить("A")
    Вектор1_9.Добавить("B")
    Вектор1_9.Добавить("C")
    Вектор1_9.Добавить("D")
    изв1 = Вектор1_9.ИзвлечьПоИндексу(1)
    изв2 = Вектор1_9.ИзвлечьПоИндексу(1)
    размер9 = Вектор1_9.Размер()
    ВывестиСтрокуВКонсоль("    ИзвлечьПоИндексу(1): " + изв1 + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    ИзвлечьПоИндексу(1): " + изв2 + " (ожидается C)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер9 + " (ожидается 2)")
    
    // ===== 11. ИЗВЛЕЧЬ ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Вектор1_10 = Новый QtВектор()
    Вектор1_10.РежимОтладки(Режим_Отладки)
    Вектор1_10.Добавить("Первый")
    Вектор1_10.Добавить("Второй")
    Вектор1_10.Добавить("Третий")
    Вектор1_10.Добавить("Четвертый")
    изв1_10 = Вектор1_10.ИзвлечьПервый()
    изв2_10 = Вектор1_10.ИзвлечьПоследний()
    первый10 = Вектор1_10.Первый()
    последний10 = Вектор1_10.Последний()
    размер10 = Вектор1_10.Размер()
    ВывестиСтрокуВКонсоль("    ИзвлечьПервый(): " + изв1_10 + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    ИзвлечьПоследний(): " + изв2_10 + " (ожидается Четвертый)")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый10 + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний10 + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер10 + " (ожидается 2)")
    
    // ===== 12. ОЧИСТИТЬ =====
    Вектор1_11 = Новый QtВектор()
    Вектор1_11.РежимОтладки(Режим_Отладки)
    Вектор1_11.Добавить("A")
    Вектор1_11.Добавить("B")
    Вектор1_11.Добавить("C")
    Вектор1_11.Очистить()
    пуст11 = Вектор1_11.Пустой()
    размер11 = Вектор1_11.Размер()
    ВывестиСтрокуВКонсоль("    Очистить() -> Пустой(): " + пуст11 + " (ожидается true), Размер(): " + размер11 + " (ожидается 0)")
    
    // ===== 13. СОЕДИНИТЬ =====
    Вектор1_12 = Новый QtВектор()
    Вектор1_12.РежимОтладки(Режим_Отладки)
    Вектор1_12.Добавить("Один")
    Вектор1_12.Добавить("Два")
    Вектор1_12.Добавить("Три")
    строка12 = Вектор1_12.Соединить(", ")
    ВывестиСтрокуВКонсоль("    Соединить(', '): '" + строка12 + "' (ожидается 'Один, Два, Три')")
    
    // ===== 14. ЗАПОЛНИТЬ =====
    Вектор1_13 = Новый QtВектор()
    Вектор1_13.РежимОтладки(Режим_Отладки)
    Вектор1_13.Добавить("A")
    Вектор1_13.Добавить("B")
    Вектор1_13.Добавить("C")
    Вектор1_13.Заполнить("X")
    эл0_13 = Вектор1_13.Получить(0)
    эл1_13 = Вектор1_13.Получить(1)
    эл2_13 = Вектор1_13.Получить(2)
    размер13 = Вектор1_13.Размер()
    ВывестиСтрокуВКонсоль("    Заполнить('X')")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_13 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_13 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2_13 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер13 + " (ожидается 3)")
    
    // ===== 15. ИЗМЕНИТЬ РАЗМЕР =====
    Вектор1_14 = Новый QtВектор()
    Вектор1_14.РежимОтладки(Режим_Отладки)
    Вектор1_14.Добавить("A")
    Вектор1_14.Добавить("B")
    Вектор1_14.Добавить("C")
    Вектор1_14.ИзменитьРазмер(5)
    размер14 = Вектор1_14.Размер()
    ВывестиСтрокуВКонсоль("    ИзменитьРазмер(5) -> Размер(): " + размер14 + " (ожидается 5)")
    Вектор1_14.ИзменитьРазмер(2)
    размер14b = Вектор1_14.Размер()
    эл0_14 = Вектор1_14.Получить(0)
    эл1_14 = Вектор1_14.Получить(1)
    ВывестиСтрокуВКонсоль("    ИзменитьРазмер(2) -> Размер(): " + размер14b + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_14 + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_14 + " (ожидается B)")
    
    // ===== 16. ЗАРЕЗЕРВИРОВАТЬ И ЁМКОСТЬ =====
    Вектор1_15 = Новый QtВектор()
    Вектор1_15.РежимОтладки(Режим_Отладки)
    ёмкость0 = Вектор1_15.Ёмкость()
    ВывестиСтрокуВКонсоль("    Исходная ёмкость: " + ёмкость0)
    Вектор1_15.Зарезервировать(10)
    ёмкость1 = Вектор1_15.Ёмкость()
    ВывестиСтрокуВКонсоль("    Зарезервировать(10) -> Ёмкость(): " + ёмкость1 + " (ожидается >= 10)")
    Вектор1_15.Зарезервировать(20)
    ёмкость2 = Вектор1_15.Ёмкость()
    ВывестиСтрокуВКонсоль("    Зарезервировать(20) -> Ёмкость(): " + ёмкость2 + " (ожидается >= 20)")
    
    // ===== 17. В МАССИВ =====
    Вектор1_16 = Новый QtВектор()
    Вектор1_16.РежимОтладки(Режим_Отладки)
    Вектор1_16.Добавить("A")
    Вектор1_16.Добавить("B")
    Вектор1_16.Добавить("C")
    массив = Вектор1_16.ВМассив()
    ВывестиСтрокуВКонсоль("    ВМассив().length: " + массив.length + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    ВМассив()[0]: " + массив[0] + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    ВМассив()[1]: " + массив[1] + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    ВМассив()[2]: " + массив[2] + " (ожидается C)")
    
    // ===== 18. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    Вектор1_17 = Новый QtВектор()
    Вектор1_17.РежимОтладки(Режим_Отладки)
    Вектор1_17.Добавить(42)
    Вектор1_17.Добавить("Строка")
    Вектор1_17.Добавить(ИСТИНА)
    Вектор1_17.Добавить(3.14)
    эл0_17 = Вектор1_17.Получить(0)
    эл1_17 = Вектор1_17.Получить(1)
    эл2_17 = Вектор1_17.Получить(2)
    эл3_17 = Вектор1_17.Получить(3)
    размер17 = Вектор1_17.Размер()
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_17 + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_17 + " (ожидается Строка)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2_17 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Получить(3): " + эл3_17 + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер17 + " (ожидается 4)")
    
    // ===== 19. RUSFUNC =====
    Если typeof Вектор1_1.RusFunc === 'function' Тогда
        jsonStr = Вектор1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
   
    ВывестиСтрокуВКонсоль("==== Тест QtVector (QtВектор) завершён.=========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtМножество()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Добавить                       │ insert                         │
//│ 20 │ Удалить                        │ remove                         │
//│ 21 │ Очистить                       │ clear                          │
//│ 22 │ Содержит                       │ contains                       │
//│ 23 │ Значения                       │ values                         │
//│ 24 │ ВМассив                        │ toArray                        │
//│ 25 │ Объединить                     │ unite                          │
//│ 26 │ Пересечение                    │ intersect                      │
//│ 27 │ Вычитание                      │ subtract                       │
//│ 28 │ Размер                         │ len                            │
//│ 29 │ Количество                     │ cnt                            │
//│ 30 │ Пустой                         │ empty                          │
//│ 31 │ Копировать                     │ copy                           │
//│ 32 │ КопироватьВ                    │ copyTo                         │
//│ 33 │ Действителен                   │ isValid                        │
//│ 34 │ Равно                          │ equals                         │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSet (QtМножество) - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Множество1_1 = Новый QtМножество()
    Множество1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЕ МНОЖЕСТВО =====
    пуст1 = Множество1_1.Пустой()
    пуст2 = Множество1_1.empty()
    размер1 = Множество1_1.Размер()
    размер2 = Множество1_1.len()
    кол1 = Множество1_1.Количество()
    кол2 = Множество1_1.cnt()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст1 + ", empty(): " + пуст2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер1 + ", len(): " + размер2 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + кол1 + ", cnt(): " + кол2 + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ =====
    Множество1_2 = Новый QtМножество()
    Множество1_2.РежимОтладки(Режим_Отладки)
    Множество1_2.Добавить("Первый")
    Множество1_2.Добавить("Второй")
    Множество1_2.Добавить("Третий")
    размер3 = Множество1_2.Размер()
    знач3 = Множество1_2.values()
    знач3.sort()
    ВывестиСтрокуВКонсоль("    Добавить('Первый'), Добавить('Второй'), Добавить('Третий')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    values(): " + знач3.join(", ") + " (ожидается Первый, Второй, Третий)")
    
    // ===== 4. СОДЕРЖИТ =====
    Множество1_3 = Новый QtМножество()
    Множество1_3.РежимОтладки(Режим_Отладки)
    Множество1_3.Добавить("значение")
    сод1 = Множество1_3.contains("значение")
    сод2 = Множество1_3.Содержит("значение")
    сод3 = Множество1_3.contains("нет")
    ВывестиСтрокуВКонсоль("    contains('значение'): " + сод1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Содержит('значение'): " + сод2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('нет'): " + сод3 + " (ожидается false)")
    
    // ===== 5. УНИКАЛЬНОСТЬ ЭЛЕМЕНТОВ =====
    Множество1_4 = Новый QtМножество()
    Множество1_4.РежимОтладки(Режим_Отладки)
    Множество1_4.Добавить("A")
    Множество1_4.Добавить("B")
    Множество1_4.Добавить("A")
    Множество1_4.Добавить("B")
    Множество1_4.Добавить("C")
    размер4 = Множество1_4.Размер()
    знач4 = Множество1_4.values()
    знач4.sort()
    ВывестиСтрокуВКонсоль("    Добавить('A'), Добавить('B'), Добавить('A'), Добавить('B'), Добавить('C')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер4 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    values(): " + знач4.join(", ") + " (ожидается A, B, C)")
    
    // ===== 6. УДАЛЕНИЕ =====
    Множество1_5 = Новый QtМножество()
    Множество1_5.РежимОтладки(Режим_Отладки)
    Множество1_5.Добавить("A")
    Множество1_5.Добавить("B")
    Множество1_5.Добавить("C")
    Множество1_5.remove("B")
    Множество1_5.Удалить("C")
    размер5 = Множество1_5.Размер()
    содA = Множество1_5.contains("A")
    содB = Множество1_5.contains("B")
    содC = Множество1_5.contains("C")
    ВывестиСтрокуВКонсоль("    remove('B'), Удалить('C')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер5 + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    contains('A'): " + содA + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('B'): " + содB + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    contains('C'): " + содC + " (ожидается false)")
    
    // ===== 7. ЗНАЧЕНИЯ =====
    Множество1_6 = Новый QtМножество()
    Множество1_6.РежимОтладки(Режим_Отладки)
    Множество1_6.Добавить("X")
    Множество1_6.Добавить("Y")
    Множество1_6.Добавить("Z")
    знач6_1 = Множество1_6.values()
    знач6_2 = Множество1_6.Значения()
    знач6_1.sort()
    знач6_2.sort()
    ВывестиСтрокуВКонсоль("    values(): " + знач6_1.join(", ") + " (ожидается X, Y, Z)")
    ВывестиСтрокуВКонсоль("    Значения(): " + знач6_2.join(", ") + " (ожидается X, Y, Z)")
    
    // ===== 8. В МАССИВ =====
    Множество1_7 = Новый QtМножество()
    Множество1_7.РежимОтладки(Режим_Отладки)
    Множество1_7.Добавить("A")
    Множество1_7.Добавить("B")
    Множество1_7.Добавить("C")
    массив1 = Множество1_7.toArray()
    массив2 = Множество1_7.ВМассив()
    стрМассив1 = []
    Для i = 0 По массив1.length - 1 Цикл
        стрМассив1.push(массив1[i].toString())
    КонецЦикла
    стрМассив1.sort()
    стрМассив2 = []
    Для i = 0 По массив2.length - 1 Цикл
        стрМассив2.push(массив2[i].toString())
    КонецЦикла
    стрМассив2.sort()
    ВывестиСтрокуВКонсоль("    toArray(): " + стрМассив1.join(", ") + " (ожидается A, B, C)")
    ВывестиСтрокуВКонсоль("    ВМассив(): " + стрМассив2.join(", ") + " (ожидается A, B, C)")
    
    // ===== 9. ОЧИСТКА =====
    Множество1_8 = Новый QtМножество()
    Множество1_8.РежимОтладки(Режим_Отладки)
    Множество1_8.Добавить("A")
    Множество1_8.Добавить("B")
    Множество1_8.Добавить("C")
    Множество1_8.clear()
    размер8_1 = Множество1_8.Размер()
    пусто8_1 = Множество1_8.Пустой()
    Множество1_8.Добавить("D")
    Множество1_8.Добавить("E")
    Множество1_8.Очистить()
    размер8_2 = Множество1_8.Размер()
    пусто8_2 = Множество1_8.Пустой()
    ВывестиСтрокуВКонсоль("    clear() -> Размер(): " + размер8_1 + " (ожидается 0), Пустой(): " + пусто8_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> Размер(): " + размер8_2 + " (ожидается 0), Пустой(): " + пусто8_2)
    
    // ===== 10. ОБЪЕДИНЕНИЕ =====
    Множество1_9 = Новый QtМножество()
    Множество1_9.РежимОтладки(Режим_Отладки)
    Множество1_9.Добавить("A")
    Множество1_9.Добавить("B")
    Множество1_10 = Новый QtМножество()
    Множество1_10.РежимОтладки(Режим_Отладки)
    Множество1_10.Добавить("B")
    Множество1_10.Добавить("C")
    Множество1_10.Добавить("D")
    Множество1_9.unite(Множество1_10)
    размер9 = Множество1_9.Размер()
    знач9 = Множество1_9.values()
    знач9.sort()
    ВывестиСтрокуВКонсоль("    unite(множество {B,C,D}) -> Размер(): " + размер9 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    values(): " + знач9.join(", ") + " (ожидается A, B, C, D)")
    
    Множество1_11 = Новый QtМножество()
    Множество1_11.РежимОтладки(Режим_Отладки)
    Множество1_11.Добавить("A")
    Множество1_11.Добавить("B")
    Множество1_12 = Новый QtМножество()
    Множество1_12.РежимОтладки(Режим_Отладки)
    Множество1_12.Добавить("B")
    Множество1_12.Добавить("C")
    Множество1_12.Добавить("D")
    Множество1_11.Объединить(Множество1_12)
    размер11 = Множество1_11.Размер()
    знач11 = Множество1_11.values()
    знач11.sort()
    ВывестиСтрокуВКонсоль("    Объединить(множество {B,C,D}) -> Размер(): " + размер11 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    values(): " + знач11.join(", ") + " (ожидается A, B, C, D)")
    
    // ===== 11. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    Множество1_13 = Новый QtМножество()
    Множество1_13.РежимОтладки(Режим_Отладки)
    Множество1_13.Добавить(42)
    Множество1_13.Добавить("Строка")
    Множество1_13.Добавить(ИСТИНА)
    Множество1_13.Добавить(3.14)
    размер13 = Множество1_13.Размер()
    сод13_1 = Множество1_13.contains(42)
    сод13_2 = Множество1_13.contains("Строка")
    сод13_3 = Множество1_13.contains(ИСТИНА)
    сод13_4 = Множество1_13.contains(3.14)
    ВывестиСтрокуВКонсоль("    Добавить(42), Добавить('Строка'), Добавить(true), Добавить(3.14)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер13 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    contains(42): " + сод13_1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('Строка'): " + сод13_2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains(true): " + сод13_3 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains(3.14): " + сод13_4 + " (ожидается true)")
    
    // ===== 12. RUSFUNC =====
    Если typeof Множество1_1.RusFunc === 'function' Тогда
        jsonStr = Множество1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtSet (QtМножество) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtОчередь()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ВОчередь                       │ enqueue                        │
//│ 20 │ ВОчередь                       │ push                           │
//│ 21 │ ИзОчереди                      │ dequeue                        │
//│ 22 │ ИзОчереди                      │ pop                            │
//│ 23 │ Голова                         │ head                           │
//│ 24 │ Голова                         │ front                          │
//│ 25 │ Хвост                          │ back                           │
//│ 26 │ Получить                       │ at                             │
//│ 27 │ Очистить                       │ clear                          │
//│ 28 │ ВМассив                        │ toArray                        │
//│ 29 │ ВСтроки                        │ toQStringList                  │
//│ 30 │ Размер                         │ len                            │
//│ 31 │ Количество                     │ cnt                            │
//│ 32 │ Пустой                         │ empty                          │
//│ 33 │ Копировать                     │ copy                           │
//│ 34 │ КопироватьВ                    │ copyTo                         │
//│ 35 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtQueue (QtОчередь) - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    очередь1_1 = Новый QtОчередь()
    очередь1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТАЯ ОЧЕРЕДЬ =====
    пуст1 = очередь1_1.Пустой()
    пуст2 = очередь1_1.empty()
    размер1 = очередь1_1.Размер()
    размер2 = очередь1_1.len()
    кол1 = очередь1_1.Количество()
    кол2 = очередь1_1.cnt()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст1 + ", empty(): " + пуст2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер1 + ", len(): " + размер2 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + кол1 + ", cnt(): " + кол2 + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ В ОЧЕРЕДЬ =====
    очередь1_2 = Новый QtОчередь()
    очередь1_2.РежимОтладки(Режим_Отладки)
    очередь1_2.ВОчередь("Первый")
    очередь1_2.ВОчередь("Второй")
    очередь1_2.ВОчередь("Третий")
    размер3 = очередь1_2.Размер()
    голова3 = очередь1_2.head()
    ВывестиСтрокуВКонсоль("    ВОчередь('Первый'), ВОчередь('Второй'), ВОчередь('Третий')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    head(): " + голова3.toString() + " (ожидается Первый)")
    
    // ===== 4. ГОЛОВА ОЧЕРЕДИ =====
    очередь1_3 = Новый QtОчередь()
    очередь1_3.РежимОтладки(Режим_Отладки)
    очередь1_3.ВОчередь("A")
    очередь1_3.ВОчередь("B")
    очередь1_3.ВОчередь("C")
    голова1 = очередь1_3.head()
    голова2 = очередь1_3.Голова()
    ВывестиСтрокуВКонсоль("    head(): " + голова1.toString() + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    Голова(): " + голова2.toString() + " (ожидается A)")
    
    // ===== 5. ИЗВЛЕЧЕНИЕ ИЗ ОЧЕРЕДИ (FIFO) =====
    очередь1_4 = Новый QtОчередь()
    очередь1_4.РежимОтладки(Режим_Отладки)
    очередь1_4.ВОчередь("Первый")
    очередь1_4.ВОчередь("Второй")
    очередь1_4.ВОчередь("Третий")
    изв1 = очередь1_4.dequeue()
    изв2 = очередь1_4.ИзОчереди()
    изв3 = очередь1_4.dequeue()
    размер4 = очередь1_4.Размер()
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв1.toString() + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    ИзОчереди(): " + изв2.toString() + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв3.toString() + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер4 + " (ожидается 0)")
    
    // ===== 6. ОЧИСТКА =====
    очередь1_5 = Новый QtОчередь()
    очередь1_5.РежимОтладки(Режим_Отладки)
    очередь1_5.ВОчередь("A")
    очередь1_5.ВОчередь("B")
    очередь1_5.ВОчередь("C")
    очередь1_5.clear()
    размер5_1 = очередь1_5.Размер()
    пусто5_1 = очередь1_5.Пустой()
    очередь1_5.ВОчередь("D")
    очередь1_5.ВОчередь("E")
    очередь1_5.Очистить()
    размер5_2 = очередь1_5.Размер()
    пусто5_2 = очередь1_5.Пустой()
    ВывестиСтрокуВКонсоль("    clear() -> Размер(): " + размер5_1 + " (ожидается 0), Пустой(): " + пусто5_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> Размер(): " + размер5_2 + " (ожидается 0), Пустой(): " + пусто5_2)
    
    // ===== 7. В МАССИВ =====
    очередь1_6 = Новый QtОчередь()
    очередь1_6.РежимОтладки(Режим_Отладки)
    очередь1_6.ВОчередь("X")
    очередь1_6.ВОчередь("Y")
    очередь1_6.ВОчередь("Z")
    массив1 = очередь1_6.toArray()
    массив2 = очередь1_6.ВМассив()
    стрМассив1 = []
    Для i = 0 По массив1.length - 1 Цикл
        стрМассив1.push(массив1[i].toString())
    КонецЦикла
    стрМассив2 = []
    Для i = 0 По массив2.length - 1 Цикл
        стрМассив2.push(массив2[i].toString())
    КонецЦикла
    ВывестиСтрокуВКонсоль("    toArray(): " + стрМассив1.join(", ") + " (ожидается X, Y, Z)")
    ВывестиСтрокуВКонсоль("    ВМассив(): " + стрМассив2.join(", ") + " (ожидается X, Y, Z)")
    
    // ===== 8. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    очередь1_7 = Новый QtОчередь()
    очередь1_7.РежимОтладки(Режим_Отладки)
    очередь1_7.ВОчередь(42)
    очередь1_7.ВОчередь("Строка")
    очередь1_7.ВОчередь(ИСТИНА)
    очередь1_7.ВОчередь(3.14)
    размер7 = очередь1_7.Размер()
    голова7 = очередь1_7.head()
    изв7_1 = очередь1_7.dequeue()
    изв7_2 = очередь1_7.dequeue()
    изв7_3 = очередь1_7.dequeue()
    изв7_4 = очередь1_7.dequeue()
    ВывестиСтрокуВКонсоль("    ВОчередь(42), ВОчередь('Строка'), ВОчередь(true), ВОчередь(3.14)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер7 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    head(): " + голова7.toString() + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв7_1.toString() + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв7_2.toString() + " (ожидается Строка)")
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв7_3.toString() + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    dequeue(): " + изв7_4.toString() + " (ожидается 3.14)")
    
    // ===== 9. ПОРЯДОК FIFO =====
    очередь1_8 = Новый QtОчередь()
    очередь1_8.РежимОтладки(Режим_Отладки)
    очередь1_8.ВОчередь("1")
    очередь1_8.ВОчередь("2")
    очередь1_8.ВОчередь("3")
    очередь1_8.ВОчередь("4")
    очередь1_8.ВОчередь("5")
    изв8_1 = очередь1_8.dequeue()
    изв8_2 = очередь1_8.dequeue()
    изв8_3 = очередь1_8.dequeue()
    изв8_4 = очередь1_8.dequeue()
    изв8_5 = очередь1_8.dequeue()
    ВывестиСтрокуВКонсоль("    enqueue: 1, 2, 3, 4, 5")
    ВывестиСтрокуВКонсоль("    dequeue: " + изв8_1.toString() + ", " + изв8_2.toString() + ", " + изв8_3.toString() + ", " + изв8_4.toString() + ", " + изв8_5.toString())
    ВывестиСтрокуВКонсоль("    FIFO порядок: " + (изв8_1.toString() == "1" && изв8_2.toString() == "2" && изв8_3.toString() == "3" && изв8_4.toString() == "4" && изв8_5.toString() == "5" ? "КОРРЕКТЕН" : "НАРУШЕН"))
    
    // ===== 10. RUSFUNC =====
    Если typeof очередь1_1.RusFunc === 'function' Тогда
        jsonStr = очередь1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtQueue (QtОчередь) завершён.==========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСписок()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Добавить                       │ append                         │
//│ 20 │ ДобавитьВНачало                │ prepend                        │
//│ 21 │ Вставить                       │ insert                         │
//│ 22 │ УдалитьПоИндексу               │ removeAt                       │
//│ 23 │ УдалитьПервый                  │ removeFirst                    │
//│ 24 │ УдалитьПоследний               │ removeLast                     │
//│ 25 │ Очистить                       │ clear                          │
//│ 26 │ Получить                       │ at                             │
//│ 27 │ Первый                         │ first                          │
//│ 28 │ Последний                      │ last                           │
//│ 29 │ ИзвлечьПоИндексу               │ takeAt                         │
//│ 30 │ ИзвлечьПервый                  │ takeFirst                      │
//│ 31 │ ИзвлечьПоследний               │ takeLast                       │
//│ 32 │ ВМассив                        │ toArray                        │
//│ 33 │ ВСтроки                        │ toQStringList                  │
//│ 34 │ Соединить                      │ join                           │
//│ 35 │ Содержит                       │ contains                       │
//│ 36 │ Индекс                         │ indexOf                        │
//│ 37 │ ПоследнийИндекс                │ lastIndexOf                    │
//│ 38 │ Установить                     │ setValue                       │
//│ 39 │ Пустой                         │ isEmpty                        │
//│ 40 │ Длина                          │ length                         │
//│ 41 │ Количество                     │ count                          │
//│ 42 │ Копировать                     │ copy                           │
//│ 43 │ КопироватьВ                    │ copyTo                         │
//│ 44 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtList (QtСписок) - КОМПАКТНАЯ ВЕРСИЯ ===========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Список1_1 = Новый QtСписок()
    Список1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ СПИСОК =====
    пуст1 = Список1_1.Пустой()
    пуст2 = Список1_1.isEmpty()
    размер1 = Список1_1.Длина()
    размер2 = Список1_1.length()
    кол1 = Список1_1.Количество()
    кол2 = Список1_1.count()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст1 + ", isEmpty(): " + пуст2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер1 + ", length(): " + размер2 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + кол1 + ", count(): " + кол2 + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ =====
    Список1_2 = Новый QtСписок()
    Список1_2.РежимОтладки(Режим_Отладки)
    Список1_2.Добавить("Первый")
    Список1_2.Добавить("Второй")
    Список1_2.Добавить("Третий")
    размер3 = Список1_2.Длина()
    первый3 = Список1_2.Первый()
    последний3 = Список1_2.Последний()
    ВывестиСтрокуВКонсоль("    Добавить('Первый'), Добавить('Второй'), Добавить('Третий')")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый3.toString() + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний3.toString() + " (ожидается Третий)")
    
    // ===== 4. ДОБАВЛЕНИЕ В НАЧАЛО =====
    Список1_3 = Новый QtСписок()
    Список1_3.РежимОтладки(Режим_Отладки)
    Список1_3.Добавить("Второй")
    Список1_3.Добавить("Третий")
    Список1_3.ДобавитьВНачало("Первый")
    Список1_3.ДобавитьВНачало("Нулевой")
    первый4 = Список1_3.Первый()
    размер4 = Список1_3.Длина()
    ВывестиСтрокуВКонсоль("    ДобавитьВНачало('Первый'), ДобавитьВНачало('Нулевой')")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый4.toString() + " (ожидается Нулевой)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер4 + " (ожидается 4)")
    
    // ===== 5. ВСТАВКА =====
    Список1_4 = Новый QtСписок()
    Список1_4.РежимОтладки(Режим_Отладки)
    Список1_4.Добавить("Первый")
    Список1_4.Добавить("Третий")
    Список1_4.Вставить(1, "Второй")
    Список1_4.Вставить(3, "Четвертый")
    эл0 = Список1_4.Получить(0)
    эл1 = Список1_4.Получить(1)
    эл2 = Список1_4.Получить(2)
    эл3 = Список1_4.Получить(3)
    размер5 = Список1_4.Длина()
    ВывестиСтрокуВКонсоль("    Вставить(1,'Второй'), Вставить(3,'Четвертый')")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0.toString() + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1.toString() + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2.toString() + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Получить(3): " + эл3.toString() + " (ожидается Четвертый)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер5 + " (ожидается 4)")
    
    // ===== 6. ПОЛУЧЕНИЕ ЭЛЕМЕНТОВ =====
    Список1_5 = Новый QtСписок()
    Список1_5.РежимОтладки(Режим_Отладки)
    Список1_5.Добавить("A")
    Список1_5.Добавить("B")
    Список1_5.Добавить("C")
    эл1_5 = Список1_5.Получить(1)
    эл2_5 = Список1_5.Получить(2)
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_5.toString() + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2_5.toString() + " (ожидается C)")
    
    // ===== 7. ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Список1_6 = Новый QtСписок()
    Список1_6.РежимОтладки(Режим_Отладки)
    Список1_6.Добавить("Начало")
    Список1_6.Добавить("Середина")
    Список1_6.Добавить("Конец")
    первый6 = Список1_6.Первый()
    последний6 = Список1_6.Последний()
    ВывестиСтрокуВКонсоль("    Первый(): " + первый6.toString() + " (ожидается Начало)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний6.toString() + " (ожидается Конец)")
    
    // ===== 8. УДАЛЕНИЕ ПО ИНДЕКСУ =====
    Список1_7 = Новый QtСписок()
    Список1_7.РежимОтладки(Режим_Отладки)
    Список1_7.Добавить("A")
    Список1_7.Добавить("B")
    Список1_7.Добавить("C")
    Список1_7.Добавить("D")
    Список1_7.УдалитьПоИндексу(1)
    Список1_7.УдалитьПоИндексу(1)
    эл0_7 = Список1_7.Получить(0)
    эл1_7 = Список1_7.Получить(1)
    размер7 = Список1_7.Длина()
    ВывестиСтрокуВКонсоль("    УдалитьПоИндексу(1), УдалитьПоИндексу(1)")
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_7.toString() + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_7.toString() + " (ожидается D)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер7 + " (ожидается 2)")
    
    // ===== 9. УДАЛИТЬ ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Список1_8 = Новый QtСписок()
    Список1_8.РежимОтладки(Режим_Отладки)
    Список1_8.Добавить("Первый")
    Список1_8.Добавить("Второй")
    Список1_8.Добавить("Третий")
    Список1_8.Добавить("Четвертый")
    Список1_8.УдалитьПервый()
    Список1_8.УдалитьПоследний()
    первый8 = Список1_8.Первый()
    последний8 = Список1_8.Последний()
    размер8 = Список1_8.Длина()
    ВывестиСтрокуВКонсоль("    УдалитьПервый(), УдалитьПоследний()")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый8.toString() + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний8.toString() + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер8 + " (ожидается 2)")
    
    // ===== 10. ИЗВЛЕЧЬ ПО ИНДЕКСУ =====
    Список1_9 = Новый QtСписок()
    Список1_9.РежимОтладки(Режим_Отладки)
    Список1_9.Добавить("A")
    Список1_9.Добавить("B")
    Список1_9.Добавить("C")
    Список1_9.Добавить("D")
    изв1 = Список1_9.ИзвлечьПоИндексу(1)
    изв2 = Список1_9.ИзвлечьПоИндексу(1)
    размер9 = Список1_9.Длина()
    ВывестиСтрокуВКонсоль("    ИзвлечьПоИндексу(1): " + изв1.toString() + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    ИзвлечьПоИндексу(1): " + изв2.toString() + " (ожидается C)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер9 + " (ожидается 2)")
    
    // ===== 11. ИЗВЛЕЧЬ ПЕРВЫЙ / ПОСЛЕДНИЙ =====
    Список1_10 = Новый QtСписок()
    Список1_10.РежимОтладки(Режим_Отладки)
    Список1_10.Добавить("Первый")
    Список1_10.Добавить("Второй")
    Список1_10.Добавить("Третий")
    Список1_10.Добавить("Четвертый")
    изв1_10 = Список1_10.ИзвлечьПервый()
    изв2_10 = Список1_10.ИзвлечьПоследний()
    первый10 = Список1_10.Первый()
    последний10 = Список1_10.Последний()
    размер10 = Список1_10.Длина()
    ВывестиСтрокуВКонсоль("    ИзвлечьПервый(): " + изв1_10.toString() + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    ИзвлечьПоследний(): " + изв2_10.toString() + " (ожидается Четвертый)")
    ВывестиСтрокуВКонсоль("    Первый(): " + первый10.toString() + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    Последний(): " + последний10.toString() + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер10 + " (ожидается 2)")
    
    // ===== 12. ОЧИСТКА =====
    Список1_11 = Новый QtСписок()
    Список1_11.РежимОтладки(Режим_Отладки)
    Список1_11.Добавить("A")
    Список1_11.Добавить("B")
    Список1_11.Добавить("C")
    Список1_11.Очистить()
    пуст11 = Список1_11.Пустой()
    размер11 = Список1_11.Длина()
    ВывестиСтрокуВКонсоль("    Очистить() -> Пустой(): " + пуст11 + " (ожидается true), Длина(): " + размер11 + " (ожидается 0)")
    
    // ===== 13. СОЕДИНИТЬ =====
    Список1_12 = Новый QtСписок()
    Список1_12.РежимОтладки(Режим_Отладки)
    Список1_12.Добавить("Один")
    Список1_12.Добавить("Два")
    Список1_12.Добавить("Три")
    строка12 = Список1_12.Соединить(", ")
    ВывестиСтрокуВКонсоль("    Соединить(', '): '" + строка12 + "' (ожидается 'Один, Два, Три')")
    
    // ===== 14. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    Список1_13 = Новый QtСписок()
    Список1_13.РежимОтладки(Режим_Отладки)
    Список1_13.Добавить(42)
    Список1_13.Добавить("Строка")
    Список1_13.Добавить(ИСТИНА)
    Список1_13.Добавить(3.14)
    эл0_13 = Список1_13.Получить(0)
    эл1_13 = Список1_13.Получить(1)
    эл2_13 = Список1_13.Получить(2)
    эл3_13 = Список1_13.Получить(3)
    размер13 = Список1_13.Длина()
    ВывестиСтрокуВКонсоль("    Получить(0): " + эл0_13.toString() + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    Получить(1): " + эл1_13.toString() + " (ожидается Строка)")
    ВывестиСтрокуВКонсоль("    Получить(2): " + эл2_13.toString() + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Получить(3): " + эл3_13.toString() + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    Длина(): " + размер13 + " (ожидается 4)")
    
    // ===== 15. В МАССИВ =====
    Список1_14 = Новый QtСписок()
    Список1_14.РежимОтладки(Режим_Отладки)
    Список1_14.Добавить("A")
    Список1_14.Добавить("B")
    Список1_14.Добавить("C")
    массив = Список1_14.ВМассив()
    стрМассив = []
    Для i = 0 По массив.length - 1 Цикл
        стрМассив.push(массив[i].toString())
    КонецЦикла
    ВывестиСтрокуВКонсоль("    ВМассив().length: " + массив.length + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    ВМассив()[0]: " + стрМассив[0] + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    ВМассив()[1]: " + стрМассив[1] + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    ВМассив()[2]: " + стрМассив[2] + " (ожидается C)")
    
    // ===== 16. RUSFUNC =====
    Если typeof Список1_1.RusFunc === 'function' Тогда
        jsonStr = Список1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtList (QtСписок) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСтек()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ВСтек                          │ push                           │
//│ 20 │ ВСтек                          │ pushValue                      │
//│ 21 │ ИзСтека                        │ pop                            │
//│ 22 │ Вершина                        │ top                            │
//│ 23 │ Вершина                        │ peek                           │
//│ 24 │ Получить                       │ at                             │
//│ 25 │ Очистить                       │ clear                          │
//│ 26 │ ВМассив                        │ toArray                        │
//│ 27 │ ВСтроки                        │ toQStringList                  │
//│ 28 │ Зарезервировать                │ reserve                        │
//│ 29 │ Обменять                       │ swap                           │
//│ 30 │ Размер                         │ len                            │
//│ 31 │ Количество                     │ cnt                            │
//│ 32 │ Пустой                         │ empty                          │
//│ 33 │ Копировать                     │ copy                           │
//│ 34 │ КопироватьВ                    │ copyTo                         │
//│ 35 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtStack (QtСтек) - КОМПАКТНАЯ ВЕРСИЯ ===========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Стек1_1 = Новый QtСтек()
    Стек1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ СТЕК =====
    пуст1 = Стек1_1.Пустой()
    пуст2 = Стек1_1.empty()
    размер1 = Стек1_1.Размер()
    размер2 = Стек1_1.len()
    кол1 = Стек1_1.Количество()
    кол2 = Стек1_1.cnt()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст1 + ", empty(): " + пуст2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер1 + ", len(): " + размер2 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + кол1 + ", cnt(): " + кол2 + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ В СТЕК =====
    Стек1_2 = Новый QtСтек()
    Стек1_2.РежимОтладки(Режим_Отладки)
    Стек1_2.ВСтек("Первый")
    Стек1_2.ВСтек("Второй")
    Стек1_2.ВСтек("Третий")
    размер3 = Стек1_2.Размер()
    вершина3 = Стек1_2.top()
    ВывестиСтрокуВКонсоль("    ВСтек('Первый'), ВСтек('Второй'), ВСтек('Третий')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    top(): " + вершина3.toString() + " (ожидается Третий)")
    
    // ===== 4. ВЕРШИНА СТЕКА =====
    Стек1_3 = Новый QtСтек()
    Стек1_3.РежимОтладки(Режим_Отладки)
    Стек1_3.ВСтек("A")
    Стек1_3.ВСтек("B")
    Стек1_3.ВСтек("C")
    вершина1 = Стек1_3.top()
    вершина2 = Стек1_3.Вершина()
    ВывестиСтрокуВКонсоль("    top(): " + вершина1.toString() + " (ожидается C)")
    ВывестиСтрокуВКонсоль("    Вершина(): " + вершина2.toString() + " (ожидается C)")
    
    // ===== 5. ИЗВЛЕЧЕНИЕ ИЗ СТЕКА (LIFO) =====
    Стек1_4 = Новый QtСтек()
    Стек1_4.РежимОтладки(Режим_Отладки)
    Стек1_4.ВСтек("Первый")
    Стек1_4.ВСтек("Второй")
    Стек1_4.ВСтек("Третий")
    изв1 = Стек1_4.pop()
    изв2 = Стек1_4.ИзСтека()
    изв3 = Стек1_4.pop()
    размер4 = Стек1_4.Размер()
    ВывестиСтрокуВКонсоль("    pop(): " + изв1.toString() + " (ожидается Третий)")
    ВывестиСтрокуВКонсоль("    ИзСтека(): " + изв2.toString() + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    pop(): " + изв3.toString() + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер4 + " (ожидается 0)")
    
    // ===== 6. ОЧИСТКА =====
    Стек1_5 = Новый QtСтек()
    Стек1_5.РежимОтладки(Режим_Отладки)
    Стек1_5.ВСтек("A")
    Стек1_5.ВСтек("B")
    Стек1_5.ВСтек("C")
    Стек1_5.clear()
    размер5_1 = Стек1_5.Размер()
    пусто5_1 = Стек1_5.Пустой()
    Стек1_5.ВСтек("D")
    Стек1_5.ВСтек("E")
    Стек1_5.Очистить()
    размер5_2 = Стек1_5.Размер()
    пусто5_2 = Стек1_5.Пустой()
    ВывестиСтрокуВКонсоль("    clear() -> Размер(): " + размер5_1 + " (ожидается 0), Пустой(): " + пусто5_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> Размер(): " + размер5_2 + " (ожидается 0), Пустой(): " + пусто5_2)
    
    // ===== 7. В МАССИВ =====
    Стек1_6 = Новый QtСтек()
    Стек1_6.РежимОтладки(Режим_Отладки)
    Стек1_6.ВСтек("X")
    Стек1_6.ВСтек("Y")
    Стек1_6.ВСтек("Z")
    массив1 = Стек1_6.toArray()
    массив2 = Стек1_6.ВМассив()
    стрМассив1 = []
    Для i = 0 По массив1.length - 1 Цикл
        стрМассив1.push(массив1[i].toString())
    КонецЦикла
    стрМассив2 = []
    Для i = 0 По массив2.length - 1 Цикл
        стрМассив2.push(массив2[i].toString())
    КонецЦикла
    ВывестиСтрокуВКонсоль("    toArray(): " + стрМассив1.join(", ") + " (ожидается X, Y, Z)")
    ВывестиСтрокуВКонсоль("    ВМассив(): " + стрМассив2.join(", ") + " (ожидается X, Y, Z)")
    
    // ===== 8. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    Стек1_7 = Новый QtСтек()
    Стек1_7.РежимОтладки(Режим_Отладки)
    Стек1_7.ВСтек(42)
    Стек1_7.ВСтек("Строка")
    Стек1_7.ВСтек(ИСТИНА)
    Стек1_7.ВСтек(3.14)
    размер7 = Стек1_7.Размер()
    вершина7 = Стек1_7.top()
    изв7_1 = Стек1_7.pop()
    изв7_2 = Стек1_7.pop()
    изв7_3 = Стек1_7.pop()
    изв7_4 = Стек1_7.pop()
    ВывестиСтрокуВКонсоль("    ВСтек(42), ВСтек('Строка'), ВСтек(true), ВСтек(3.14)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер7 + " (ожидается 4)")
    ВывестиСтрокуВКонсоль("    top(): " + вершина7.toString() + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    pop(): " + изв7_1.toString() + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    pop(): " + изв7_2.toString() + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    pop(): " + изв7_3.toString() + " (ожидается Строка)")
    ВывестиСтрокуВКонсоль("    pop(): " + изв7_4.toString() + " (ожидается 42)")
    
    // ===== 9. ПОРЯДОК LIFO =====
    Стек1_8 = Новый QtСтек()
    Стек1_8.РежимОтладки(Режим_Отладки)
    Стек1_8.ВСтек("1")
    Стек1_8.ВСтек("2")
    Стек1_8.ВСтек("3")
    Стек1_8.ВСтек("4")
    Стек1_8.ВСтек("5")
    изв8_1 = Стек1_8.pop()
    изв8_2 = Стек1_8.pop()
    изв8_3 = Стек1_8.pop()
    изв8_4 = Стек1_8.pop()
    изв8_5 = Стек1_8.pop()
    ВывестиСтрокуВКонсоль("    push: 1, 2, 3, 4, 5")
    ВывестиСтрокуВКонсоль("    pop: " + изв8_1.toString() + ", " + изв8_2.toString() + ", " + изв8_3.toString() + ", " + изв8_4.toString() + ", " + изв8_5.toString())
    ВывестиСтрокуВКонсоль("    LIFO порядок: " + (изв8_1.toString() == "5" && изв8_2.toString() == "4" && изв8_3.toString() == "3" && изв8_4.toString() == "2" && изв8_5.toString() == "1" ? "КОРРЕКТЕН" : "НАРУШЕН"))
    
    // ===== 10. RUSFUNC =====
    Если typeof Стек1_1.RusFunc === 'function' Тогда
        jsonStr = Стек1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtStack (QtСтек) завершён.============================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtХешТаблица()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Вставить                       │ insert                         │
//│ 20 │ Удалить                        │ remove                         │
//│ 21 │ Очистить                       │ clear                          │
//│ 22 │ Получить                       │ value                          │
//│ 23 │ ПолучитьЗначение               │ value                          │
//│ 24 │ Содержит                       │ contains                       │
//│ 25 │ Ключи                          │ keys                           │
//│ 26 │ Значения                       │ values                         │
//│ 27 │ Извлечь                        │ take                           │
//│ 28 │ Установить                     │ setValue                       │
//│ 29 │ Размер                         │ len                            │
//│ 30 │ Количество                     │ cnt                            │
//│ 31 │ Пустой                         │ empty                          │
//│ 32 │ Копировать                     │ copy                           │
//│ 33 │ КопироватьВ                    │ copyTo                         │
//│ 34 │ Действителен                   │ isValid                        │
//│ 35 │ КлючПоИндексу                  │ keyAt                          │
//│ 36 │ ЗначениеПоИндексу              │ valueAt                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtHash (QtХешТаблица) - КОМПАКТНАЯ ВЕРСИЯ =======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Хеш1_1 = Новый QtХешТаблица()
    Хеш1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТАЯ ХЕШ-ТАБЛИЦА =====
    пуст1 = Хеш1_1.Пустой()
    пуст2 = Хеш1_1.empty()
    размер1 = Хеш1_1.Размер()
    размер2 = Хеш1_1.len()
    кол1 = Хеш1_1.Количество()
    кол2 = Хеш1_1.cnt()
    ВывестиСтрокуВКонсоль("    Пустой(): " + пуст1 + ", empty(): " + пуст2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер1 + ", len(): " + размер2 + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    Количество(): " + кол1 + ", cnt(): " + кол2 + " (ожидается 0)")
    
    // ===== 3. ВСТАВКА =====
    Хеш1_2 = Новый QtХешТаблица()
    Хеш1_2.РежимОтладки(Режим_Отладки)
    Хеш1_2.Вставить("ключ1", "значение1")
    Хеш1_2.Вставить("ключ2", "значение2")
    Хеш1_2.Вставить("ключ3", "значение3")
    размер3 = Хеш1_2.Размер()
    знач1 = Хеш1_2.value("ключ1")
    знач2 = Хеш1_2.value("ключ2")
    знач3 = Хеш1_2.value("ключ3")
    ВывестиСтрокуВКонсоль("    Вставить('ключ1','значение1'), Вставить('ключ2','значение2'), Вставить('ключ3','значение3')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    value('ключ1'): " + знач1.toString() + " (ожидается значение1)")
    ВывестиСтрокуВКонсоль("    value('ключ2'): " + знач2.toString() + " (ожидается значение2)")
    ВывестиСтрокуВКонсоль("    value('ключ3'): " + знач3.toString() + " (ожидается значение3)")
    
    // ===== 4. ПОЛУЧЕНИЕ =====
    Хеш1_3 = Новый QtХешТаблица()
    Хеш1_3.РежимОтладки(Режим_Отладки)
    Хеш1_3.Вставить("a", "A")
    Хеш1_3.Вставить("b", "B")
    Хеш1_3.Вставить("c", "C")
    знач4 = Хеш1_3.value("b")
    знач5 = Хеш1_3.Получить("c")
    знач6 = Хеш1_3.value("несуществует")
    ВывестиСтрокуВКонсоль("    value('b'): " + знач4.toString() + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    Получить('c'): " + знач5.toString() + " (ожидается C)")
    ВывестиСтрокуВКонсоль("    value('несуществует'): " + (знач6 === undefined ? "undefined" : знач6.toString()) + " (ожидается undefined)")
    
    // ===== 5. СОДЕРЖИТ =====
    Хеш1_4 = Новый QtХешТаблица()
    Хеш1_4.РежимОтладки(Режим_Отладки)
    Хеш1_4.Вставить("ключ", "значение")
    сод1 = Хеш1_4.contains("ключ")
    сод2 = Хеш1_4.Содержит("ключ")
    сод3 = Хеш1_4.contains("нет")
    ВывестиСтрокуВКонсоль("    contains('ключ'): " + сод1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Содержит('ключ'): " + сод2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('нет'): " + сод3 + " (ожидается false)")
    
    // ===== 6. УДАЛЕНИЕ =====
    Хеш1_5 = Новый QtХешТаблица()
    Хеш1_5.РежимОтладки(Режим_Отладки)
    Хеш1_5.Вставить("a", 1)
    Хеш1_5.Вставить("b", 2)
    Хеш1_5.Вставить("c", 3)
    Хеш1_5.remove("b")
    Хеш1_5.Удалить("c")
    размер5 = Хеш1_5.Размер()
    содA = Хеш1_5.contains("a")
    содB = Хеш1_5.contains("b")
    содC = Хеш1_5.contains("c")
    ВывестиСтрокуВКонсоль("    remove('b'), Удалить('c')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер5 + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    contains('a'): " + содA + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('b'): " + содB + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    contains('c'): " + содC + " (ожидается false)")
    
    // ===== 7. КЛЮЧИ =====
    Хеш1_6 = Новый QtХешТаблица()
    Хеш1_6.РежимОтладки(Режим_Отладки)
    Хеш1_6.Вставить("ключ1", 1)
    Хеш1_6.Вставить("ключ2", 2)
    Хеш1_6.Вставить("ключ3", 3)
    ключи1 = Хеш1_6.keys()
    ключи2 = Хеш1_6.Ключи()
    ключи1.sort()
    ключи2.sort()
    ВывестиСтрокуВКонсоль("    keys(): " + ключи1.join(", ") + " (ожидается ключ1, ключ2, ключ3)")
    ВывестиСтрокуВКонсоль("    Ключи(): " + ключи2.join(", ") + " (ожидается ключ1, ключ2, ключ3)")
    
    // ===== 8. ЗНАЧЕНИЯ =====
    Хеш1_7 = Новый QtХешТаблица()
    Хеш1_7.РежимОтладки(Режим_Отладки)
    Хеш1_7.Вставить("a", "A")
    Хеш1_7.Вставить("b", "B")
    Хеш1_7.Вставить("c", "C")
    значения1 = Хеш1_7.values()
    значения2 = Хеш1_7.Значения()
    стрЗнач1 = []
    Для i = 0 По значения1.length - 1 Цикл
        стрЗнач1.push(значения1[i].toString())
    КонецЦикла
    стрЗнач1.sort()
    стрЗнач2 = []
    Для i = 0 По значения2.length - 1 Цикл
        стрЗнач2.push(значения2[i].toString())
    КонецЦикла
    стрЗнач2.sort()
    ВывестиСтрокуВКонсоль("    values(): " + стрЗнач1.join(", ") + " (ожидается A, B, C)")
    ВывестиСтрокуВКонсоль("    Значения(): " + стрЗнач2.join(", ") + " (ожидается A, B, C)")
    
    // ===== 9. ИЗВЛЕЧЕНИЕ =====
    Хеш1_8 = Новый QtХешТаблица()
    Хеш1_8.РежимОтладки(Режим_Отладки)
    Хеш1_8.Вставить("x", 100)
    Хеш1_8.Вставить("y", 200)
    Хеш1_8.Вставить("z", 300)
    изв1 = Хеш1_8.take("y")
    изв2 = Хеш1_8.Извлечь("z")
    размер8 = Хеш1_8.Размер()
    содX = Хеш1_8.contains("x")
    содY = Хеш1_8.contains("y")
    содZ = Хеш1_8.contains("z")
    ВывестиСтрокуВКонсоль("    take('y'): " + изв1.toString() + " (ожидается 200)")
    ВывестиСтрокуВКонсоль("    Извлечь('z'): " + изв2.toString() + " (ожидается 300)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер8 + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    contains('x'): " + содX + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    contains('y'): " + содY + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    contains('z'): " + содZ + " (ожидается false)")
    
    // ===== 10. ОЧИСТКА =====
    Хеш1_9 = Новый QtХешТаблица()
    Хеш1_9.РежимОтладки(Режим_Отладки)
    Хеш1_9.Вставить("a", 1)
    Хеш1_9.Вставить("b", 2)
    Хеш1_9.Вставить("c", 3)
    Хеш1_9.clear()
    размер9_1 = Хеш1_9.Размер()
    пусто9_1 = Хеш1_9.Пустой()
    Хеш1_9.Вставить("d", 4)
    Хеш1_9.Вставить("e", 5)
    Хеш1_9.Очистить()
    размер9_2 = Хеш1_9.Размер()
    пусто9_2 = Хеш1_9.Пустой()
    ВывестиСтрокуВКонсоль("    clear() -> Размер(): " + размер9_1 + " (ожидается 0), Пустой(): " + пусто9_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> Размер(): " + размер9_2 + " (ожидается 0), Пустой(): " + пусто9_2)
    
    // ===== 11. РАБОТА С РАЗНЫМИ ТИПАМИ =====
    Хеш1_10 = Новый QtХешТаблица()
    Хеш1_10.РежимОтладки(Режим_Отладки)
    Хеш1_10.Вставить("число", 42)
    Хеш1_10.Вставить("строка", "Привет")
    Хеш1_10.Вставить("булево", ИСТИНА)
    Хеш1_10.Вставить("дробь", 3.14)
    значЧисло = Хеш1_10.value("число")
    значСтрока = Хеш1_10.value("строка")
    значБулево = Хеш1_10.value("булево")
    значДробь = Хеш1_10.value("дробь")
    размер10 = Хеш1_10.Размер()
    ВывестиСтрокуВКонсоль("    value('число'): " + значЧисло.toString() + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    value('строка'): " + значСтрока.toString() + " (ожидается Привет)")
    ВывестиСтрокуВКонсоль("    value('булево'): " + значБулево.toString() + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    value('дробь'): " + значДробь.toString() + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер10 + " (ожидается 4)")
    
    // ===== 12. ЗАМЕНА ЗНАЧЕНИЯ =====
    Хеш1_11 = Новый QtХешТаблица()
    Хеш1_11.РежимОтладки(Режим_Отладки)
    Хеш1_11.Вставить("ключ", "старое значение")
    Хеш1_11.Вставить("ключ", "новое значение")
    знач11 = Хеш1_11.value("ключ")
    размер11 = Хеш1_11.Размер()
    ВывестиСтрокуВКонсоль("    Вставить('ключ','старое'), Вставить('ключ','новое')")
    ВывестиСтрокуВКонсоль("    value('ключ'): " + знач11.toString() + " (ожидается новое значение)")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер11 + " (ожидается 1)")
    
    // ===== 13. RUSFUNC =====
    Если typeof Хеш1_1.RusFunc === 'function' Тогда
        jsonStr = Хеш1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtHash (QtХешТаблица) завершён.========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtЗадача()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startThread                    │
//│ 20 │ ЗапуститьСКолбэком             │ startWithCallback              │
//│ 21 │ ЗапуститьСФункцией             │ startWithFunction              │
//│ 22 │ Остановить                     │ quitThread                     │
//│ 23 │ Ожидать                        │ waitThread                     │
//│ 24 │ ОжидатьМс                      │ waitThreadMs                   │
//│ 25 │ Запущен                        │ isRunningThread                │
//│ 26 │ Завершён                       │ isFinishedThread               │
//│ 27 │ УровеньЦикла                   │ loopLevel                      │
//│ 28 │ ЦиклСобытий                    │ eventLoop                      │
//│ 29 │ Приоритет                      │ getPriority                    │
//│ 30 │ УстановитьПриоритет            │ setPriority                    │
//│ 31 │ Спать                          │ sleepThread                    │
//│ 32 │ СпатьМс                        │ msleepThread                   │
//│ 33 │ СпатьМкс                       │ usleepThread                   │
//│ 34 │ ЗапроситьПрерывание            │ requestInterruption            │
//│ 35 │ ПрерываниеЗапрошено            │ isInterruptionRequested        │
//│ 36 │ УстановитьРазмерСтека          │ setStackSize                   │
//│ 37 │ РазмерСтека                    │ getStackSize                   │
//│ 38 │ ИдеальноеКоличествоПотоков     │ getIdealThreadCount            │
//│ 39 │ УступитьВремя                  │ yieldCurrentThread             │
//│ 40 │ ТекущийПоток                   │ currentThread                  │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ПолучитьПоток                  │ getRealThread                  │
//│ 43 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 44 │ КопироватьВ                    │ copyTo                         │
//│ 45 │ РежимОтладки                   │ setDebug                       │
//│ 46 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 47 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 48 │ ИмяОбъекта                     │ objectName                     │
//│ 49 │ ПриоритетХолостой              │ IdlePriority                   │
//│ 50 │ ПриоритетСамыйНизкий           │ LowestPriority                 │
//│ 51 │ ПриоритетНизкий                │ LowPriority                    │
//│ 52 │ ПриоритетНормальный            │ NormalPriority                 │
//│ 53 │ ПриоритетВысокий               │ HighPriority                   │
//│ 54 │ ПриоритетСамыйВысокий          │ HighestPriority                │
//│ 55 │ ПриоритетВремениРеального      │ TimeCriticalPriority           │
//│ 56 │ ПриоритетИнверсии              │ InheritPriority                │
//│ 57 │ ПолучитьЗадачу                 │ getRealRunnable                │
//│ 58 │ УстановитьФункцию              │ setFunction                    │
//│ 59 │ УстановитьКолбэк               │ setCallback                    │
//│ 60 │ УстановитьАвтоудаление         │ setAutoDelete                  │
//│ 61 │ Автоудаление                   │ isAutoDelete                   │
//│ 62 │ Выполнить                      │ runTask                        │
//│ 63 │ Выполняется                    │ isRunning                      │
//│ 64 │ Завершена                      │ isFinished                     │
//│ 65 │ Отменить                       │ cancel                         │
//│ 66 │ Отменена                       │ isCancelled                    │
//│ 67 │ Действителен                   │ isValid                        │
//│ 68 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 69 │ КопироватьВ                    │ copyTo                         │
//│ 70 │ РежимОтладки                   │ setDebug                       │
//│ 71 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 72 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 73 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtRunnable (QtЗадача) - КОМПАКТНАЯ ВЕРСИЯ =======================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Задача1_1 = Новый QtЗадача()
    Задача1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    ВывестиСтрокуВКонсоль("    Автоудаление(): " + Задача1_1.Автоудаление())
    
    // ===== 2. СОЗДАНИЕ С ФУНКЦИЕЙ =====
    тестФункция = function() {
        ВывестиСтрокуВКонсоль("    >> Функция из конструктора выполнена")
    }
    Задача1_2 = Новый QtЗадача(тестФункция)
    Задача1_2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание с функцией: УСПЕШНО")
    Задача1_2.Выполнить()
    ВывестиСтрокуВКонсоль("    Выполнить(): УСПЕШНО")
    
    // ===== 3. СОЗДАНИЕ С ФУНКЦИЕЙ И КОЛБЭКОМ =====
    оснФункция = function() {
        ВывестиСтрокуВКонсоль("    >> Основная функция выполнена")
    }
    колбэкФункция = function(рез) {
        ВывестиСтрокуВКонсоль("    >> Колбэк выполнен, результат: " + рез)
    }
    Задача1_3 = Новый QtЗадача(оснФункция, колбэкФункция)
    Задача1_3.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание с функцией и колбэком: УСПЕШНО")
    Задача1_3.Выполнить()
    ВывестиСтрокуВКонсоль("    Выполнить(): УСПЕШНО")
    
    // ===== 4. УСТАНОВКА ФУНКЦИИ И КОЛБЭКА ЧЕРЕЗ МЕТОДЫ =====
    Задача1_4 = Новый QtЗадача()
    Задача1_4.РежимОтладки(Режим_Отладки)
    Задача1_4.УстановитьФункцию(function() {
        ВывестиСтрокуВКонсоль("    >> Функция через УстановитьФункцию")
    })
    Задача1_4.УстановитьКолбэк(function(рез) {
        ВывестиСтрокуВКонсоль("    >> Колбэк через УстановитьКолбэк, рез: " + рез)
    })
    ВывестиСтрокуВКонсоль("    УстановитьФункцию(): УСПЕШНО")
    ВывестиСтрокуВКонсоль("    УстановитьКолбэк(): УСПЕШНО")
    Задача1_4.Выполнить()
    ВывестиСтрокуВКонсоль("    Выполнить(): УСПЕШНО")
    
    // ===== 5. РАБОТА С АВТОУДАЛЕНИЕМ =====
    Задача1_5 = Новый QtЗадача()
    Задача1_5.РежимОтладки(Режим_Отладки)
    авто1 = Задача1_5.Автоудаление()
    ВывестиСтрокуВКонсоль("    Автоудаление() начальное: " + авто1)
    Задача1_5.УстановитьАвтоудаление(ЛОЖЬ)
    авто2 = Задача1_5.Автоудаление()
    ВывестиСтрокуВКонсоль("    УстановитьАвтоудаление(ЛОЖЬ) -> Автоудаление(): " + авто2 + " (ожидается false)")
    Задача1_5.УстановитьАвтоудаление(ИСТИНА)
    авто3 = Задача1_5.Автоудаление()
    ВывестиСтрокуВКонсоль("    УстановитьАвтоудаление(ИСТИНА) -> Автоудаление(): " + авто3 + " (ожидается true)")
    
    // ===== 6. МНОЖЕСТВЕННОЕ СОЗДАНИЕ =====
    Задача1_6 = []
    Для i = 0 По 4 Цикл
        задача = Новый QtЗадача()
        задача.РежимОтладки(Режим_Отладки)
        Задача1_6.push(задача)
    КонецЦикла
    ВывестиСтрокуВКонсоль("    Множественное создание: " + Задача1_6.length + " задач (ожидается 5)")
    
    // ===== 7. ПРОВЕРКА РУССКИХ МЕТОДОВ =====
    Задача1_7 = Новый QtЗадача()
    Задача1_7.РежимОтладки(Режим_Отладки)
    русМетоды = ["УстановитьФункцию", "УстановитьКолбэк", "УстановитьАвтоудаление", "Автоудаление", "Выполнить"]
    доступно = 0
    Для i = 0 По русМетоды.length - 1 Цикл
        имя = русМетоды[i]
        Если typeof Задача1_7[имя] === 'function' Тогда
            доступно = доступно + 1
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("    Русских методов доступно: " + доступно + " из " + русМетоды.length + " (ожидается 5)")
    
    // ===== 8. RUSFUNC =====
    Если typeof Задача1_1.RusFunc === 'function' Тогда
        jsonStr = Задача1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtRunnable (QtЗадача) завершён.=======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПоток()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startThread                    │
//│ 20 │ ЗапуститьСКолбэком             │ startWithCallback              │
//│ 21 │ ЗапуститьСФункцией             │ startWithFunction              │
//│ 22 │ Остановить                     │ quitThread                     │
//│ 23 │ Ожидать                        │ waitThread                     │
//│ 24 │ ОжидатьМс                      │ waitThreadMs                   │
//│ 25 │ Запущен                        │ isRunningThread                │
//│ 26 │ Завершён                       │ isFinishedThread               │
//│ 27 │ УровеньЦикла                   │ loopLevel                      │
//│ 28 │ ЦиклСобытий                    │ eventLoop                      │
//│ 29 │ Приоритет                      │ getPriority                    │
//│ 30 │ УстановитьПриоритет            │ setPriority                    │
//│ 31 │ Спать                          │ sleepThread                    │
//│ 32 │ СпатьМс                        │ msleepThread                   │
//│ 33 │ СпатьМкс                       │ usleepThread                   │
//│ 34 │ ЗапроситьПрерывание            │ requestInterruption            │
//│ 35 │ ПрерываниеЗапрошено            │ isInterruptionRequested        │
//│ 36 │ УстановитьРазмерСтека          │ setStackSize                   │
//│ 37 │ РазмерСтека                    │ getStackSize                   │
//│ 38 │ ИдеальноеКоличествоПотоков     │ getIdealThreadCount            │
//│ 39 │ УступитьВремя                  │ yieldCurrentThread             │
//│ 40 │ ТекущийПоток                   │ currentThread                  │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ПолучитьПоток                  │ getRealThread                  │
//│ 43 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 44 │ КопироватьВ                    │ copyTo                         │
//│ 45 │ РежимОтладки                   │ setDebug                       │
//│ 46 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 47 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 48 │ ИмяОбъекта                     │ objectName                     │
//│ 49 │ ПриоритетХолостой              │ IdlePriority                   │
//│ 50 │ ПриоритетСамыйНизкий           │ LowestPriority                 │
//│ 51 │ ПриоритетНизкий                │ LowPriority                    │
//│ 52 │ ПриоритетНормальный            │ NormalPriority                 │
//│ 53 │ ПриоритетВысокий               │ HighPriority                   │
//│ 54 │ ПриоритетСамыйВысокий          │ HighestPriority                │
//│ 55 │ ПриоритетВремениРеального      │ TimeCriticalPriority           │
//│ 56 │ ПриоритетИнверсии              │ InheritPriority                │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtThread (QtПоток) - КОМПАКТНАЯ ВЕРСИЯ ==========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Поток_1 = Новый QtПоток()
    Поток_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ НОВОГО ПОТОКА =====
    запущен = Поток_1.isRunningThread()
    завершён = Поток_1.isFinishedThread()
    ВывестиСтрокуВКонсоль("    isRunningThread(): " + запущен + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isFinishedThread(): " + завершён + " (ожидается false)")
    
    // ===== 3. ЗАПУСК И ОСТАНОВКА =====
    Поток_2 = Новый QtПоток()
    Поток_2.РежимОтладки(Режим_Отладки)
    Поток_2.startThread()
    Пауза(50)
    запущен2 = Поток_2.isRunningThread()
    ВывестиСтрокуВКонсоль("    startThread() -> isRunningThread(): " + запущен2 + " (ожидается true)")
    Поток_2.quitThread()
    Поток_2.waitThread()
    запущен2b = Поток_2.isRunningThread()
    завершён2b = Поток_2.isFinishedThread()
    ВывестиСтрокуВКонсоль("    quitThread(), waitThread() -> isRunningThread(): " + запущен2b + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isFinishedThread(): " + завершён2b + " (ожидается true)")
    
    // ===== 4. ЗАПУСК С КОЛБЭКОМ =====
    колбэкВызван = ЛОЖЬ
    Функция ТестКолбэк()
        колбэкВызван = ИСТИНА
    КонецФункции
    Поток_3 = Новый QtПоток()
    Поток_3.РежимОтладки(Режим_Отладки)
    Поток_3.startWithCallback(ТестКолбэк)
    Пауза(200)
    запущен3 = Поток_3.isRunningThread()
    ВывестиСтрокуВКонсоль("    startWithCallback() -> isRunningThread(): " + запущен3 + " (ожидается true)")
    Поток_3.quitThread()
    Поток_3.waitThread()
    ВывестиСтрокуВКонсоль("    колбэкВызван: " + колбэкВызван + " (ожидается true)")
    
    // ===== 5. ЗАПУСК С ФУНКЦИЕЙ =====
    функцияВызвана = ЛОЖЬ
    Функция ТестФункция2()
        функцияВызвана = ИСТИНА
    КонецФункции
    Поток_4 = Новый QtПоток()
    Поток_4.РежимОтладки(Режим_Отладки)
    Поток_4.startWithFunction(ТестФункция2)
    Пауза(200)
    запущен4 = Поток_4.isRunningThread()
    ВывестиСтрокуВКонсоль("    startWithFunction() -> isRunningThread(): " + запущен4 + " (ожидается true)")
    Поток_4.quitThread()
    Поток_4.waitThread()
    ВывестиСтрокуВКонсоль("    функцияВызвана: " + функцияВызвана + " (ожидается true)")
    
    // ===== 6. ЗАДЕРЖКИ =====
    задержкаВыполнена = ЛОЖЬ
    Функция ТестЗадержки()
        Поток_5.msleepThread(100)
        задержкаВыполнена = ИСТИНА
    КонецФункции
    Поток_5 = Новый QtПоток()
    Поток_5.РежимОтладки(Режим_Отладки)
    Поток_5.startWithFunction(ТестЗадержки)
    Пауза(50)
    запущен5 = Поток_5.isRunningThread()
    ВывестиСтрокуВКонсоль("    msleepThread(100) в потоке -> isRunningThread(): " + запущен5 + " (ожидается true)")
    Поток_5.waitThread()
    ВывестиСтрокуВКонсоль("    задержкаВыполнена: " + задержкаВыполнена + " (ожидается true)")
    
    // ===== 7. СТАТИЧЕСКИЕ МЕТОДЫ =====
    идеал = Поток_1.getIdealThreadCount()
    ВывестиСтрокуВКонсоль("    getIdealThreadCount(): " + идеал + " (ожидается >= 1)")
    Поток_1.yieldCurrentThread()
    ВывестиСтрокуВКонсоль("    yieldCurrentThread(): УСПЕШНО")
    
    // ===== 8. ТЕКУЩИЙ ПОТОК =====
    текПоток = Поток_1.currentThread()
    текПоток2 = Поток_1.ТекущийПоток()
    ВывестиСтрокуВКонсоль("    currentThread(): " + (текПоток != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ТекущийПоток(): " + (текПоток2 != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. ОЖИДАНИЕ С ТАЙМАУТОМ =====
    Функция ДолгийЗапуск()
        Поток_6.msleepThread(200)
    КонецФункции
    Поток_6 = Новый QtПоток()
    Поток_6.РежимОтладки(Режим_Отладки)
    Поток_6.startWithFunction(ДолгийЗапуск)
    Пауза(50)
    запущен6 = Поток_6.isRunningThread()
    ВывестиСтрокуВКонсоль("    Поток запущен: " + запущен6)
    Поток_6.waitThreadMs(100)
    запущен6b = Поток_6.isRunningThread()
    ВывестиСтрокуВКонсоль("    waitThreadMs(100) -> isRunningThread(): " + запущен6b)
    Поток_6.waitThread()
    запущен6c = Поток_6.isRunningThread()
    ВывестиСтрокуВКонсоль("    waitThread() -> isRunningThread(): " + запущен6c + " (ожидается false)")
    
    // ===== 10. RUSFUNC =====
    Если typeof Поток_1.RusFunc === 'function' Тогда
        jsonStr = Поток_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtThread (QtПоток) завершён.===========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПотокПул()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startThread                    │
//│ 20 │ ЗапуститьСКолбэком             │ startWithCallback              │
//│ 21 │ ЗапуститьСФункцией             │ startWithFunction              │
//│ 22 │ Остановить                     │ quitThread                     │
//│ 23 │ Ожидать                        │ waitThread                     │
//│ 24 │ ОжидатьМс                      │ waitThreadMs                   │
//│ 25 │ Запущен                        │ isRunningThread                │
//│ 26 │ Завершён                       │ isFinishedThread               │
//│ 27 │ УровеньЦикла                   │ loopLevel                      │
//│ 28 │ ЦиклСобытий                    │ eventLoop                      │
//│ 29 │ Приоритет                      │ getPriority                    │
//│ 30 │ УстановитьПриоритет            │ setPriority                    │
//│ 31 │ Спать                          │ sleepThread                    │
//│ 32 │ СпатьМс                        │ msleepThread                   │
//│ 33 │ СпатьМкс                       │ usleepThread                   │
//│ 34 │ ЗапроситьПрерывание            │ requestInterruption            │
//│ 35 │ ПрерываниеЗапрошено            │ isInterruptionRequested        │
//│ 36 │ УстановитьРазмерСтека          │ setStackSize                   │
//│ 37 │ РазмерСтека                    │ getStackSize                   │
//│ 38 │ ИдеальноеКоличествоПотоков     │ getIdealThreadCount            │
//│ 39 │ УступитьВремя                  │ yieldCurrentThread             │
//│ 40 │ ТекущийПоток                   │ currentThread                  │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ПолучитьПоток                  │ getRealThread                  │
//│ 43 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 44 │ КопироватьВ                    │ copyTo                         │
//│ 45 │ РежимОтладки                   │ setDebug                       │
//│ 46 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 47 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 48 │ ИмяОбъекта                     │ objectName                     │
//│ 49 │ ПриоритетХолостой              │ IdlePriority                   │
//│ 50 │ ПриоритетСамыйНизкий           │ LowestPriority                 │
//│ 51 │ ПриоритетНизкий                │ LowPriority                    │
//│ 52 │ ПриоритетНормальный            │ NormalPriority                 │
//│ 53 │ ПриоритетВысокий               │ HighPriority                   │
//│ 54 │ ПриоритетСамыйВысокий          │ HighestPriority                │
//│ 55 │ ПриоритетВремениРеального      │ TimeCriticalPriority           │
//│ 56 │ ПриоритетИнверсии              │ InheritPriority                │
//│ 57 │ Запустить                      │ start                          │
//│ 58 │ ЗапуститьЗадачу                │ startTask                      │
//│ 59 │ ЗапуститьФункцию               │ startFunction                  │
//│ 60 │ ЗапуститьФункциюИС             │ startFunctionWithData          │
//│ 61 │ Ожидать                        │ waitForDone                    │
//│ 62 │ ОжидатьМс                      │ waitForDoneMs                  │
//│ 63 │ АктивныхПотоков                │ activeThreadCount              │
//│ 64 │ УстановитьМаксимумПотоков      │ setMaxThreadCount              │
//│ 65 │ МаксимумПотоков                │ maxThreadCount                 │
//│ 66 │ УстановитьТаймаут              │ setExpiryTimeout               │
//│ 67 │ Таймаут                        │ expiryTimeout                  │
//│ 68 │ УстановитьРазмерСтека          │ setStackSize                   │
//│ 69 │ РазмерСтека                    │ stackSize                      │
//│ 70 │ Очистить                       │ clear                          │
//│ 71 │ ОсвободитьПоток                │ releaseThread                  │
//│ 72 │ ЗарезервироватьПоток           │ reserveThread                  │
//│ 73 │ ГлобальныйПул                  │ globalInstance                 │
//│ 74 │ Действителен                   │ isValid                        │
//│ 75 │ ПолучитьПул                    │ getRealPool                    │
//│ 76 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 77 │ КопироватьВ                    │ copyTo                         │
//│ 78 │ РежимОтладки                   │ setDebug                       │
//│ 79 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 80 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 81 │ ИмяОбъекта                     │ objectName                     │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtThreadPool (QtПотокПул) - КОМПАКТНАЯ ВЕРСИЯ ==================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Поток2_1 = Новый QtПотокПул()
    Поток2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидный = Поток2_1.isValid()
    валидныйРус = Поток2_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валидный + ", Действителен(): " + валидныйРус + " (ожидается true)")
    
    // ===== 3. ПОЛУЧЕНИЕ РЕАЛЬНОГО ПУЛА =====
    реальный = Поток2_1.getRealPool()
    реальныйРус = Поток2_1.ПолучитьПул()
    ВывестиСтрокуВКонсоль("    getRealPool(): " + (реальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьПул(): " + (реальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. УСТАНОВКА МАКСИМУМА ПОТОКОВ =====
    Поток2_1.setMaxThreadCount(4)
    максимум = Поток2_1.maxThreadCount()
    ВывестиСтрокуВКонсоль("    setMaxThreadCount(4) -> maxThreadCount(): " + максимум + " (ожидается 4)")
    Поток2_1.УстановитьМаксимумПотоков(8)
    максимумРус = Поток2_1.МаксимумПотоков()
    ВывестиСтрокуВКонсоль("    УстановитьМаксимумПотоков(8) -> МаксимумПотоков(): " + максимумРус + " (ожидается 8)")
    
    // ===== 5. УСТАНОВКА ТАЙМАУТА =====
    Поток2_1.setExpiryTimeout(5000)
    таймаут = Поток2_1.expiryTimeout()
    ВывестиСтрокуВКонсоль("    setExpiryTimeout(5000) -> expiryTimeout(): " + таймаут + " (ожидается 5000)")
    Поток2_1.УстановитьТаймаут(10000)
    таймаутРус = Поток2_1.Таймаут()
    ВывестиСтрокуВКонсоль("    УстановитьТаймаут(10000) -> Таймаут(): " + таймаутРус + " (ожидается 10000)")
    
    // ===== 6. ГЛОБАЛЬНЫЙ ПУЛ =====
    глобальный = Поток2_1.globalInstance()
    глобальныйРус = Поток2_1.ГлобальныйПул()
    ВывестиСтрокуВКонсоль("    globalInstance(): " + (глобальный != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ГлобальныйПул(): " + (глобальныйРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 7. ЗАПУСК ЗАДАЧ =====
    // АНГЛИЙСКИЙ
    Поток2_2 = Новый QtПотокПул()
    Поток2_2.РежимОтладки(Режим_Отладки)
    выполнено = ЛОЖЬ
    задача = function() {
        выполнено = ИСТИНА
    }
    Поток2_2.startTask(задача)
    Поток2_2.waitForDone()
    ВывестиСтрокуВКонсоль("    [ENG] startTask/waitForDone: задача выполнена = " + выполнено + " (ожидается true)")
    
    // РУССКИЙ
    Поток2_3 = Новый QtПотокПул()
    Поток2_3.РежимОтладки(Режим_Отладки)
    выполноРус = ЛОЖЬ
    задачаРус = function() {
        выполноРус = ИСТИНА
    }
    Поток2_3.ЗапуститьЗадачу(задачаРус)
    Поток2_3.Ожидать()
    ВывестиСтрокуВКонсоль("    [RUS] ЗапуститьЗадачу/Ожидать: задача выполнена = " + выполноРус + " (ожидается true)")
    
    // ===== 8. ОЧИСТКА =====
    Поток2_1.clear()
    ВывестиСтрокуВКонсоль("    clear(): УСПЕШНО")
    Поток2_1.Очистить()
    ВывестиСтрокуВКонсоль("    Очистить(): УСПЕШНО")
    
    // ===== 9. КОПИРОВАНИЕ =====
    Поток2_4 = Новый QtПотокПул()
    Поток2_4.РежимОтладки(Режим_Отладки)
    результат = Поток2_1.КопироватьВ(Поток2_4)
    ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат + " (ожидается true)")
    
    // ===== 10. RUSFUNC =====
    Если typeof Поток2_1.RusFunc === 'function' Тогда
        jsonStr = Поток2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtThreadPool (QtПотокПул) завершён.====================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtИдентичнаяПроксиМодель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                    │ Английский метод                │
//├─────┼──────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                     │ isValid                        │
//│ 2 │ ПолучитьОбъект                   │ getRealObject                  │
//│ 3 │ УстановитьРодителя               │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                 │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта             │ setObjectName                  │
//│ 6 │ ИмяОбъекта                       │ objectName                     │
//│ 7 │ УстановитьСвойство               │ setProperty                    │
//│ 8 │ Свойство                         │ property                       │
//│ 9 │ ПодключитьСигнал                 │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                  │ disconnectSignal               │
//│ 11 │ КопироватьВ                      │ copyTo                         │
//│ 12 │ РежимОтладки                     │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки             │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                │ getClassType                   │
//│ 15 │ УстановитьТипКласса              │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                │ getClassName                   │
//│ 17 │ УстановитьИмяКласса              │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов            │ RusFunc                        │
//│ 19 │ КоличествоСтрок                  │ rowCount                       │
//│ 20 │ КоличествоКолонок                │ columnCount                    │
//│ 21 │ ПолучитьДанные                   │ data                           │
//│ 22 │ УстановитьДанные                 │ setData                        │
//│ 23 │ ПолучитьЗаголовок                │ headerData                     │
//│ 24 │ УстановитьЗаголовок              │ setHeaderData                  │
//│ 25 │ Индекс                           │ index                          │
//│ 26 │ ИндексСРодителем                 │ indexWithParent                │
//│ 27 │ Родитель                         │ parent                         │
//│ 28 │ Флаги                            │ flags                          │
//│ 29 │ ПолучитьМодель                   │ getModel                       │
//│ 30 │ УстановитьМодель                 │ setModel                       │
//│ 31 │ НачатьСбросМодели                │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели             │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок               │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок            │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок              │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок           │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок             │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок          │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок            │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок         │ endRemoveColumns               │
//│ 41 │ Действителен                     │ isValid                        │
//│ 42 │ УстановитьИсходнуюМодель         │ setSourceModelModel            │
//│ 43 │ ПолучитьИсходнуюМодель           │ getSourceModel                 │
//│ 44 │ ОтобразитьНаИсходную             │ mapToSource                    │
//│ 45 │ ОтобразитьСИсходной              │ mapFromSource                  │
//│ 46 │ ПолучитьПроксиМодель             │ getProxyModel                  │
//│ 47 │ УстановитьФильтр                 │ setFilterRegExpModel           │
//│ 48 │ ПолучитьФильтр                   │ getFilterRegExp                │
//│ 49 │ УстановитьКолонкуФильтра         │ setFilterKeyColumn             │
//│ 50 │ ПолучитьКолонкуФильтра           │ getFilterKeyColumn             │
//│ 51 │ УстановитьЧувствительность       │ setFilterCaseSensitivity       │
//│ 52 │ ПолучитьЧувствительность         │ getFilterCaseSensitivity       │
//│ 53 │ УстановитьРольФильтра            │ setFilterRole                  │
//│ 54 │ ПолучитьРольФильтра              │ getFilterRole                  │
//│ 55 │ УстановитьРольСортировки         │ setSortRole                    │
//│ 56 │ ПолучитьРольСортировки           │ getSortRole                    │
//│ 57 │ Сортировать                      │ sortModel                      │
//│ 58 │ УстановитьДинамическуюСортировку │ setDynamicSortFilter           │
//│ 59 │ ПолучитьДинамическуюСортировку   │ getDynamicSortFilter           │
//│ 60 │ Обновить                         │ refreshProxy                   │
//│ 61 │ ОбновитьФильтр                   │ invalidateFilter               │
//│ 62 │ Действителен                     │ isProxyValid                   │
//│ 63 │ УстановитьИсходнуюМодель         │ setSourceModelToProxy          │
//│ 64 │ ПолучитьИсходнуюМодель           │ getSourceModelFromProxy        │
//│ 65 │ ПроброситьИзПрокси               │ mapToSourceFromProxy           │
//│ 66 │ ПроброситьВПрокси                │ mapFromSourceToProxy           │
//│ 67 │ ИндексИсходнойМоделиКорректен    │ isValidSourceIndex             │
//│ 68 │ ИндексПроксиКорректен            │ isValidProxyIndex              │
//│ 69 │ ПолучитьДанныеИзИсходной         │ getSourceData                  │
//│ 70 │ ПолучитьДанныеИзПрокси           │ getProxyData                   │
//│ 71 │ КоличествоСтрокИсходной          │ getSourceRowCount              │
//│ 72 │ КоличествоСтрокПрокси            │ getProxyRowCount               │
//│ 73 │ КоличествоКолонокИсходной        │ getSourceColumnCount           │
//│ 74 │ КоличествоКолонокПрокси          │ getProxyColumnCount            │
//│ 75 │ ИндексИсходнойМодели             │ getSourceIndex                 │
//│ 76 │ ИндексПрокси                     │ getProxyIndex                  │
//│ 77 │ ПолучитьИдентичнуюМодель         │ getIdentityModel               │
//│ 78 │ ОбновитьИдентичнуюМодель         │ refreshIdentityProxy           │
//│ 79 │ Копировать                       │ copy                           │
//│ 80 │ Действителен                     │ isIdentityProxyValid           │
//└─────┴──────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtIdentityProxyModel - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Идент1_1 = Новый QtIdentityProxyModel()
    Идент1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ =====
    исходнаяМодель = Новый QtСписокСтрокМодель(["Яблоко", "Банан", "Апельсин", "Груша", "Киви"])
    Идент1_1.setSourceModelToProxy(исходнаяМодель.getStringListModel())
    исходнаяПолученная = Идент1_1.getSourceModelFromProxy()
    ВывестиСтрокуВКонсоль("    setSourceModelToProxy(): " + (исходнаяПолученная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 3. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ =====
    всеДанные = []
    колСтрок = Идент1_1.rowCount()
    Для i = 0 По колСтрок - 1 Цикл
        значение = Идент1_1.data(i, 0, 0).toString()
        всеДанные.push(значение)
    КонецЦикла
    ВывестиСтрокуВКонсоль("    Получено элементов: " + всеДанные.length + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    Данные: " + всеДанные.join(", "))
    
    // ===== 4. ПРОВЕРКА ПРОБРОСА ИНДЕКСОВ =====
    Попытка
        индекс = Идент1_1.getProxyIndex(0, 0)
        Идент1_1.mapToSourceFromProxy(индекс)
        Идент1_1.mapFromSourceToProxy(индекс)
        ВывестиСтрокуВКонсоль("    Проброс индексов: УСПЕШНО (методы вызваны без ошибок)")
    Исключение
        ВывестиСтрокуВКонсоль("    Проброс индексов: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ПРОВЕРКА ИНДЕКСОВ =====
    невалидный = JSON.parse('{"row": -1, "column": -1, "isValid": false}')
    валидность1 = Идент1_1.isValidProxyIndex(невалидный)
    валидность2 = Идент1_1.isValidSourceIndex(невалидный)
    ВывестиСтрокуВКонсоль("    isValidProxyIndex(невалидный): " + валидность1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isValidSourceIndex(невалидный): " + валидность2 + " (ожидается false)")
    
    // ===== 6. ПОЛУЧЕНИЕ ДАННЫХ ПО ИНДЕКСУ =====
    Попытка
        данные0 = Идент1_1.data(0, 0, 0).toString()
        данные2 = Идент1_1.data(2, 0, 0).toString()
        данные4 = Идент1_1.data(4, 0, 0).toString()
        ВывестиСтрокуВКонсоль("    data(0,0): " + данные0)
        ВывестиСтрокуВКонсоль("    data(2,0): " + данные2)
        ВывестиСтрокуВКонсоль("    data(4,0): " + данные4)
    Исключение
        ВывестиСтрокуВКонсоль("    data(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 7. КОЛИЧЕСТВО СТРОК И КОЛОНОК =====
    строкПрокси = Идент1_1.getProxyRowCount()
    строкИсходной = Идент1_1.getSourceRowCount()
    колонокПрокси = Идент1_1.getProxyColumnCount()
    колонокИсходной = Идент1_1.getSourceColumnCount()
    ВывестиСтрокуВКонсоль("    getProxyRowCount(): " + строкПрокси + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    getSourceRowCount(): " + строкИсходной + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    getProxyColumnCount(): " + колонокПрокси + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    getSourceColumnCount(): " + колонокИсходной + " (ожидается 1)")
    
    // ===== 8. ПОЛУЧЕНИЕ ИДЕНТИЧНОЙ МОДЕЛИ =====
    идентичнаяМодель = Идент1_1.getIdentityModel()
    ВывестиСтрокуВКонсоль("    getIdentityModel(): " + (идентичнаяМодель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. ОБНОВЛЕНИЕ МОДЕЛИ =====
    Попытка
        Идент1_1.refreshIdentityProxy()
        ВывестиСтрокуВКонсоль("    refreshIdentityProxy(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    refreshIdentityProxy(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. ПРОВЕРКА ВАЛИДНОСТИ =====
    валидность = Идент1_1.isIdentityProxyValid()
    ВывестиСтрокуВКонсоль("    isIdentityProxyValid(): " + валидность + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Идент1_1.RusFunc === 'function' Тогда
        jsonStr = Идент1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtIdentityProxyModel завершён.========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtМодельДанных()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ КоличествоСтрок                │ rowCount                       │
//│ 20 │ КоличествоКолонок              │ columnCount                    │
//│ 21 │ ПолучитьДанные                 │ data                           │
//│ 22 │ УстановитьДанные               │ setData                        │
//│ 23 │ ПолучитьЗаголовок              │ headerData                     │
//│ 24 │ УстановитьЗаголовок            │ setHeaderData                  │
//│ 25 │ Индекс                         │ index                          │
//│ 26 │ ИндексСРодителем               │ indexWithParent                │
//│ 27 │ Родитель                       │ parent                         │
//│ 28 │ Флаги                          │ flags                          │
//│ 29 │ ПолучитьМодель                 │ getModel                       │
//│ 30 │ УстановитьМодель               │ setModel                       │
//│ 31 │ НачатьСбросМодели              │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели           │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок             │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок          │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок            │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок         │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок           │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок        │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок          │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок       │ endRemoveColumns               │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ВставитьСтроку                 │ insertRow                      │
//│ 43 │ ВставитьСтроки                 │ insertRows                     │
//│ 44 │ ВставитьКолонку                │ insertColumn                   │
//│ 45 │ ВставитьКолонки                │ insertColumns                  │
//│ 46 │ УдалитьСтроку                  │ removeRow                      │
//│ 47 │ УдалитьСтроки                  │ removeRows                     │
//│ 48 │ УдалитьКолонку                 │ removeColumn                   │
//│ 49 │ УдалитьКолонки                 │ removeColumns                  │
//│ 50 │ Очистить                       │ clear                          │
//│ 51 │ УстановитьЗаголовокКолонки     │ setHorizontalHeader            │
//│ 52 │ УстановитьЗаголовкиКолонок     │ setHorizontalHeaders           │
//│ 53 │ УстановитьЗаголовокСтроки      │ setVerticalHeader              │
//│ 54 │ УстановитьЗаголовкиСтрок       │ setVerticalHeaders             │
//│ 55 │ ЗаголовокКолонки               │ horizontalHeader               │
//│ 56 │ ЗаголовокСтроки                │ verticalHeader                 │
//│ 57 │ УстановитьЭлемент              │ setItem                        │
//│ 58 │ ПолучитьЭлемент                │ item                           │
//│ 59 │ Элемент                        │ item                           │
//│ 60 │ ТекстЭлемента                  │ itemText                       │
//│ 61 │ УстановитьДанныеПоИндексу      │ setData                        │
//│ 62 │ ПолучитьДанныеПоИндексу        │ data                           │
//│ 63 │ ПолучитьСтандартнуюМодель      │ getStandardModel               │
//│ 64 │ Копировать                     │ copy                           │
//│ 65 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtStandardItemModel - КОМПАКТНАЯ ВЕРСИЯ =========================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Модель2_1 = Новый QtStandardItemModel()
    Модель2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валид = Модель2_1.isValid()
    ВывестиСтрокуВКонсоль("    isValid(): " + валид + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ ДАННЫХ =====
    Модель2_2 = Новый QtStandardItemModel()
    Модель2_2.РежимОтладки(Режим_Отладки)
    Модель2_2.setItem(0, 0, "Тест")
    Модель2_2.setItem(0, 1, "Значение")
    Модель2_2.setItem(1, 0, "Строка2")
    Модель2_2.setItem(1, 1, "Значение2")
    данные1 = Модель2_2.itemText(0, 0)
    данные2 = Модель2_2.itemText(0, 1)
    данные3 = Модель2_2.itemText(1, 0)
    данные4 = Модель2_2.itemText(1, 1)
    ВывестиСтрокуВКонсоль("    setItem(0,0,'Тест') -> itemText(0,0): " + данные1 + " (ожидается Тест)")
    ВывестиСтрокуВКонсоль("    setItem(0,1,'Значение') -> itemText(0,1): " + данные2 + " (ожидается Значение)")
    ВывестиСтрокуВКонсоль("    setItem(1,0,'Строка2') -> itemText(1,0): " + данные3 + " (ожидается Строка2)")
    ВывестиСтрокуВКонсоль("    setItem(1,1,'Значение2') -> itemText(1,1): " + данные4 + " (ожидается Значение2)")
    
    // ===== 4. ЗАГОЛОВКИ =====
    Модель2_3 = Новый QtStandardItemModel()
    Модель2_3.РежимОтладки(Режим_Отладки)
    Модель2_3.setHorizontalHeader(0, "Колонка 1")
    Модель2_3.setHorizontalHeader(1, "Колонка 2")
    Модель2_3.setVerticalHeader(0, "Строка 1")
    Модель2_3.setVerticalHeader(1, "Строка 2")
    заг1 = Модель2_3.horizontalHeader(0)
    заг2 = Модель2_3.horizontalHeader(1)
    заг3 = Модель2_3.verticalHeader(0)
    заг4 = Модель2_3.verticalHeader(1)
    ВывестиСтрокуВКонсоль("    horizontalHeader(0): " + заг1 + " (ожидается Колонка 1)")
    ВывестиСтрокуВКонсоль("    horizontalHeader(1): " + заг2 + " (ожидается Колонка 2)")
    ВывестиСтрокуВКонсоль("    verticalHeader(0): " + заг3 + " (ожидается Строка 1)")
    ВывестиСтрокуВКонсоль("    verticalHeader(1): " + заг4 + " (ожидается Строка 2)")
    
    // ===== 5. ЗАГОЛОВКИ СПИСКАМИ =====
    Модель2_4 = Новый QtStandardItemModel()
    Модель2_4.РежимОтладки(Режим_Отладки)
    Модель2_4.setHorizontalHeaders(["A", "B", "C"])
    Модель2_4.setVerticalHeaders(["1", "2", "3"])
    загКол = Модель2_4.horizontalHeader(1)
    загСтр = Модель2_4.verticalHeader(1)
    ВывестиСтрокуВКонсоль("    setHorizontalHeaders(['A','B','C']) -> horizontalHeader(1): " + загКол + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    setVerticalHeaders(['1','2','3']) -> verticalHeader(1): " + загСтр + " (ожидается 2)")
    
    // ===== 6. ОЧИСТКА =====
    Модель2_5 = Новый QtStandardItemModel()
    Модель2_5.РежимОтладки(Режим_Отладки)
    Модель2_5.setItem(0, 0, "Данные")
    данныеДо = Модель2_5.itemText(0, 0)
    ВывестиСтрокуВКонсоль("    До очистки: itemText(0,0): " + данныеДо)
    Модель2_5.clear()
    данныеПосле = Модель2_5.itemText(0, 0)
    ВывестиСтрокуВКонсоль("    После clear(): itemText(0,0): " + (данныеПосле != "" ? данныеПосле : "(пусто)") + " (ожидается пусто)")
    
    // ===== 7. СОЗДАНИЕ ИЗ ЗАГОЛОВКОВ =====
    Модель2_6 = Новый QtStandardItemModel(["Заголовок1", "Заголовок2", "Заголовок3"])
    Модель2_6.РежимОтладки(Режим_Отладки)
    заг6 = Модель2_6.horizontalHeader(1)
    ВывестиСтрокуВКонсоль("    horizontalHeader(1) из конструктора: " + заг6 + " (ожидается Заголовок2)")
    
    // ===== 8. ПОЛУЧЕНИЕ СТАНДАРТНОЙ МОДЕЛИ =====
    стандартная = Модель2_1.getStandardModel()
    ВывестиСтрокуВКонсоль("    getStandardModel(): " + (стандартная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 9. RUSFUNC =====
    Если typeof Модель2_1.RusFunc === 'function' Тогда
        jsonStr = Модель2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
   
    ВывестиСтрокуВКонсоль("==== Тест QtStandardItemModel завершён.=========================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСортФильтрПроксиМодель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                    │ Английский метод                │
//├─────┼──────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                     │ isValid                        │
//│ 2 │ ПолучитьОбъект                   │ getRealObject                  │
//│ 3 │ УстановитьРодителя               │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя                 │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта             │ setObjectName                  │
//│ 6 │ ИмяОбъекта                       │ objectName                     │
//│ 7 │ УстановитьСвойство               │ setProperty                    │
//│ 8 │ Свойство                         │ property                       │
//│ 9 │ ПодключитьСигнал                 │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                  │ disconnectSignal               │
//│ 11 │ КопироватьВ                      │ copyTo                         │
//│ 12 │ РежимОтладки                     │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки             │ getDebug                       │
//│ 14 │ ПолучитьТипКласса                │ getClassType                   │
//│ 15 │ УстановитьТипКласса              │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса                │ getClassName                   │
//│ 17 │ УстановитьИмяКласса              │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов            │ RusFunc                        │
//│ 19 │ КоличествоСтрок                  │ rowCount                       │
//│ 20 │ КоличествоКолонок                │ columnCount                    │
//│ 21 │ ПолучитьДанные                   │ data                           │
//│ 22 │ УстановитьДанные                 │ setData                        │
//│ 23 │ ПолучитьЗаголовок                │ headerData                     │
//│ 24 │ УстановитьЗаголовок              │ setHeaderData                  │
//│ 25 │ Индекс                           │ index                          │
//│ 26 │ ИндексСРодителем                 │ indexWithParent                │
//│ 27 │ Родитель                         │ parent                         │
//│ 28 │ Флаги                            │ flags                          │
//│ 29 │ ПолучитьМодель                   │ getModel                       │
//│ 30 │ УстановитьМодель                 │ setModel                       │
//│ 31 │ НачатьСбросМодели                │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели             │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок               │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок            │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок              │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок           │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок             │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок          │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок            │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок         │ endRemoveColumns               │
//│ 41 │ Действителен                     │ isValid                        │
//│ 42 │ УстановитьИсходнуюМодель         │ setSourceModelModel            │
//│ 43 │ ПолучитьИсходнуюМодель           │ getSourceModel                 │
//│ 44 │ ОтобразитьНаИсходную             │ mapToSource                    │
//│ 45 │ ОтобразитьСИсходной              │ mapFromSource                  │
//│ 46 │ ПолучитьПроксиМодель             │ getProxyModel                  │
//│ 47 │ УстановитьФильтр                 │ setFilterRegExpModel           │
//│ 48 │ ПолучитьФильтр                   │ getFilterRegExp                │
//│ 49 │ УстановитьКолонкуФильтра         │ setFilterKeyColumn             │
//│ 50 │ ПолучитьКолонкуФильтра           │ getFilterKeyColumn             │
//│ 51 │ УстановитьЧувствительность       │ setFilterCaseSensitivity       │
//│ 52 │ ПолучитьЧувствительность         │ getFilterCaseSensitivity       │
//│ 53 │ УстановитьРольФильтра            │ setFilterRole                  │
//│ 54 │ ПолучитьРольФильтра              │ getFilterRole                  │
//│ 55 │ УстановитьРольСортировки         │ setSortRole                    │
//│ 56 │ ПолучитьРольСортировки           │ getSortRole                    │
//│ 57 │ Сортировать                      │ sortModel                      │
//│ 58 │ УстановитьДинамическуюСортировку │ setDynamicSortFilter           │
//│ 59 │ ПолучитьДинамическуюСортировку   │ getDynamicSortFilter           │
//│ 60 │ Обновить                         │ refreshProxy                   │
//│ 61 │ ОбновитьФильтр                   │ invalidateFilter               │
//│ 62 │ Действителен                     │ isProxyValid                   │
//│ 63 │ УстановитьИсходнуюМодель         │ setSourceModelToProxy          │
//│ 64 │ ПолучитьИсходнуюМодель           │ getSourceModelFromProxy        │
//│ 65 │ СортироватьПоКолонке             │ setSortColumn                  │
//│ 66 │ СортироватьПоКолонкеСПорядком    │ setSortColumnOrder             │
//│ 67 │ УстановитьПорядокСортировки      │ setSortOrder                   │
//│ 68 │ КолонкаСортировки                │ getSortColumn                  │
//│ 69 │ ПорядокСортировки                │ getSortOrder                   │
//│ 70 │ УстановитьРольСортировки         │ setSortRole                    │
//│ 71 │ ПолучитьРольСортировки           │ getSortRole                    │
//│ 72 │ УстановитьФильтр                 │ setFilterPattern               │
//│ 73 │ УстановитьФильтрWildcard         │ setFilterWildcardPattern       │
//│ 74 │ УстановитьФильтрСтрока           │ setFilterFixedStringPattern    │
//│ 75 │ УстановитьКолонкуФильтра         │ setFilterKeyColumn             │
//│ 76 │ КолонкаФильтра                   │ getFilterKeyColumn             │
//│ 77 │ УстановитьУчётРегистра           │ setFilterCaseSensitivity       │
//│ 78 │ УстановитьРольФильтра            │ setFilterRole                  │
//│ 79 │ РольФильтра                      │ getFilterRole                  │
//│ 80 │ ОчиститьФильтр                   │ clearFilter                    │
//│ 81 │ ФильтрВключён                    │ isFilterEnabled                │
//│ 82 │ ПолучитьФильтр                   │ getFilterPattern               │
//│ 83 │ УстановитьДинамический           │ setDynamicSortFilter           │
//│ 84 │ ДинамическийВключён              │ isDynamicSortFilterEnabled     │
//│ 85 │ ОбновитьМодель                   │ invalidateModel                │
//│ 86 │ ОбновитьФильтр                   │ invalidateFilterModel          │
//│ 87 │ ПоВозрастанию                    │ ascending                      │
//│ 88 │ ПоУбыванию                       │ descending                     │
//│ 89 │ Копировать                       │ copy                           │
//└─────┴──────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtSortFilterProxyModel - КОМПАКТНАЯ ВЕРСИЯ =====================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Прокси2_1 = Новый QtSortFilterProxyModel()
    Прокси2_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА КОНСТАНТ =====
    восх = Прокси2_1.ascending()
    нисх = Прокси2_1.descending()
    ВывестиСтрокуВКонсоль("    ascending(): " + восх + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    descending(): " + нисх + " (ожидается 1)")
    
    // ===== 3. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ =====
    исходнаяМодель2 = Новый QtСписокСтрокМодель(["Яблоко", "Банан", "Апельсин", "Груша", "Киви"])
    Прокси2_1.setSourceModelToProxy(исходнаяМодель2.getStringListModel())
    исходнаяПолученная = Прокси2_1.getSourceModelFromProxy()
    ВывестиСтрокуВКонсоль("    setSourceModelToProxy(): " + (исходнаяПолученная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. ПОЛУЧЕНИЕ ДАННЫХ =====
    Пауза(200)
    всеДанные = []
    колСтрок = Прокси2_1.rowCount()
    Для i = 0 По колСтрок - 1 Цикл
        значение = Прокси2_1.data(i, 0, 0).toString()
        всеДанные.push(значение)
    КонецЦикла
    ВывестиСтрокуВКонсоль("    Получено элементов: " + всеДанные.length + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    Данные: " + всеДанные.join(", "))
    
    // ===== 5. ФИЛЬТРАЦИЯ =====
    Прокси2_1.setFilterPattern("а")
    Прокси2_1.invalidateFilterModel()
    Пауза(200)
    отфильтрованные = []
    колСтрокФ = Прокси2_1.rowCount()
    Для i = 0 По колСтрокФ - 1 Цикл
        значение = Прокси2_1.data(i, 0, 0).toString()
        отфильтрованные.push(значение)
    КонецЦикла
    ВывестиСтрокуВКонсоль("    setFilterPattern('а') -> элементов: " + отфильтрованные.length + " (ожидается < 5)")
    ВывестиСтрокуВКонсоль("    Отфильтрованные: " + отфильтрованные.join(", "))
    
    // ===== 6. ОЧИСТКА ФИЛЬТРА =====
    Прокси2_1.clearFilter()
    Прокси2_1.invalidateFilterModel()
    Пауза(200)
    фильтрВключен = Прокси2_1.isFilterEnabled()
    ВывестиСтрокуВКонсоль("    clearFilter() -> isFilterEnabled(): " + фильтрВключен + " (ожидается false)")
    
    // ===== 7. ПОЛУЧЕНИЕ ПРОКСИ МОДЕЛИ =====
    проксиМодель = Прокси2_1.getProxyModel()
    ВывестиСтрокуВКонсоль("    getProxyModel(): " + (проксиМодель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 8. ДИНАМИЧЕСКАЯ СОРТИРОВКА =====
    Прокси2_1.setDynamicSortFilter(ИСТИНА)
    динамический1 = Прокси2_1.isDynamicSortFilterEnabled()
    ВывестиСтрокуВКонсоль("    setDynamicSortFilter(true) -> isDynamicSortFilterEnabled(): " + динамический1 + " (ожидается true)")
    Прокси2_1.setDynamicSortFilter(ЛОЖЬ)
    динамический2 = Прокси2_1.isDynamicSortFilterEnabled()
    ВывестиСтрокуВКонсоль("    setDynamicSortFilter(false) -> isDynamicSortFilterEnabled(): " + динамический2 + " (ожидается false)")
    
    // ===== 9. ОБНОВЛЕНИЕ МОДЕЛИ =====
    Попытка
        Прокси2_1.invalidateModel()
        ВывестиСтрокуВКонсоль("    invalidateModel(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    invalidateModel(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. RUSFUNC =====
    Если typeof Прокси2_1.RusFunc === 'function' Тогда
        jsonStr = Прокси2_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
  
    ВывестиСтрокуВКонсоль("==== Тест QtSortFilterProxyModel завершён.======================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСписокМодель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ КоличествоСтрок                │ rowCount                       │
//│ 20 │ КоличествоКолонок              │ columnCount                    │
//│ 21 │ ПолучитьДанные                 │ data                           │
//│ 22 │ УстановитьДанные               │ setData                        │
//│ 23 │ ПолучитьЗаголовок              │ headerData                     │
//│ 24 │ УстановитьЗаголовок            │ setHeaderData                  │
//│ 25 │ Индекс                         │ index                          │
//│ 26 │ ИндексСРодителем               │ indexWithParent                │
//│ 27 │ Родитель                       │ parent                         │
//│ 28 │ Флаги                          │ flags                          │
//│ 29 │ ПолучитьМодель                 │ getModel                       │
//│ 30 │ УстановитьМодель               │ setModel                       │
//│ 31 │ НачатьСбросМодели              │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели           │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок             │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок          │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок            │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок         │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок           │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок        │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок          │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок       │ endRemoveColumns               │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ УстановитьЭлемент              │ setItem                        │
//│ 43 │ ПолучитьЭлемент                │ getItem                        │
//│ 44 │ ДобавитьЭлемент                │ addItem                        │
//│ 45 │ ДобавитьЭлементы               │ addItems                       │
//│ 46 │ ВставитьЭлемент                │ insertItemAt                   │
//│ 47 │ УдалитьЭлемент                 │ removeItemAt                   │
//│ 48 │ Очистить                       │ clearAll                       │
//│ 49 │ Размер                         │ size                           │
//│ 50 │ Количество                     │ count                          │
//│ 51 │ Пустой                         │ isEmpty                        │
//│ 52 │ Обновить                       │ refresh                        │
//│ 53 │ ВСписок                        │ toList                         │
//│ 54 │ ИзСписка                       │ fromList                       │
//│ 55 │ ПолучитьМодельСписка           │ getListModel                   │
//│ 56 │ Копировать                     │ copy                           │
//│ 57 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtAbstractListModel (QtСписокМодель) - КОМПАКТНАЯ ВЕРСИЯ ======")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Модель5_1 = Новый QtСписокМодель()
    Модель5_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТАЯ МОДЕЛЬ =====
    размер = Модель5_1.size()
    количество = Модель5_1.count()
    пусто = Модель5_1.isEmpty()
    ВывестиСтрокуВКонсоль("    size(): " + размер + ", count(): " + количество + ", isEmpty(): " + пусто + " (ожидается 0, 0, true)")
    
    // ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ (английские методы) =====
    Модель5_2 = Новый QtСписокМодель()
    Модель5_2.РежимОтладки(Режим_Отладки)
    Модель5_2.addItem("Первый")
    Модель5_2.addItem("Второй")
    Модель5_2.addItem("Третий")
    размер2 = Модель5_2.size()
    эл1 = Модель5_2.getItem(0)
    эл2 = Модель5_2.getItem(1)
    эл3 = Модель5_2.getItem(2)
    ВывестиСтрокуВКонсоль("    addItem('Первый'), addItem('Второй'), addItem('Третий')")
    ВывестиСтрокуВКонсоль("    size(): " + размер2 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getItem(0): " + эл1 + ", getItem(1): " + эл2 + ", getItem(2): " + эл3)
    
    // ===== 4. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ (русские методы) =====
    Модель5_3 = Новый QtСписокМодель()
    Модель5_3.РежимОтладки(Режим_Отладки)
    Модель5_3.ДобавитьЭлемент("Русский1")
    Модель5_3.ДобавитьЭлемент("Русский2")
    Модель5_3.ДобавитьЭлемент("Русский3")
    размер3 = Модель5_3.Размер()
    элР1 = Модель5_3.ПолучитьЭлемент(0)
    элР2 = Модель5_3.ПолучитьЭлемент(1)
    элР3 = Модель5_3.ПолучитьЭлемент(2)
    ВывестиСтрокуВКонсоль("    ДобавитьЭлемент('Русский1'), ДобавитьЭлемент('Русский2'), ДобавитьЭлемент('Русский3')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    ПолучитьЭлемент(0): " + элР1 + ", ПолучитьЭлемент(1): " + элР2 + ", ПолучитьЭлемент(2): " + элР3)
    
    // ===== 5. ДОБАВЛЕНИЕ НЕСКОЛЬКИХ ЭЛЕМЕНТОВ =====
    Модель5_4 = Новый QtСписокМодель()
    Модель5_4.РежимОтладки(Режим_Отладки)
    Модель5_4.addItems(["A", "B", "C"])
    Модель5_4.ДобавитьЭлементы(["D", "E"])
    размер4 = Модель5_4.size()
    список4 = Модель5_4.toList()
    ВывестиСтрокуВКонсоль("    addItems(['A','B','C']) + ДобавитьЭлементы(['D','E'])")
    ВывестиСтрокуВКонсоль("    size(): " + размер4 + " (ожидается 5), toList(): " + список4.join(", ") + " (ожидается A, B, C, D, E)")
    
    // ===== 6. ВСТАВКА ЭЛЕМЕНТА =====
    Модель5_5 = Новый QtСписокМодель()
    Модель5_5.РежимОтладки(Режим_Отладки)
    Модель5_5.addItems(["0", "2", "3"])
    Модель5_5.insertItemAt(1, "1")
    Модель5_5.ВставитьЭлемент(0, "Начало")
    размер5 = Модель5_5.size()
    эл5_0 = Модель5_5.getItem(0)
    эл5_1 = Модель5_5.getItem(1)
    эл5_2 = Модель5_5.getItem(2)
    эл5_3 = Модель5_5.getItem(3)
    ВывестиСтрокуВКонсоль("    insertItemAt(1,'1'), ВставитьЭлемент(0,'Начало')")
    ВывестиСтрокуВКонсоль("    size(): " + размер5 + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    getItem(0): " + эл5_0 + ", getItem(1): " + эл5_1 + ", getItem(2): " + эл5_2 + ", getItem(3): " + эл5_3)
    
    // ===== 7. УСТАНОВКА ЭЛЕМЕНТА =====
    Модель5_6 = Новый QtСписокМодель()
    Модель5_6.РежимОтладки(Режим_Отладки)
    Модель5_6.addItems(["A", "B", "C"])
    Модель5_6.setItem(1, "X")
    Модель5_6.УстановитьЭлемент(2, "Y")
    эл6_1 = Модель5_6.getItem(1)
    эл6_2 = Модель5_6.getItem(2)
    ВывестиСтрокуВКонсоль("    setItem(1,'X') -> getItem(1): " + эл6_1 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    УстановитьЭлемент(2,'Y') -> getItem(2): " + эл6_2 + " (ожидается Y)")
    
    // ===== 8. УДАЛЕНИЕ ЭЛЕМЕНТА =====
    Модель5_7 = Новый QtСписокМодель()
    Модель5_7.РежимОтладки(Режим_Отладки)
    Модель5_7.addItems(["0", "1", "2", "3", "4"])
    Модель5_7.removeItemAt(2)
    Модель5_7.УдалитьЭлемент(0)
    размер7 = Модель5_7.size()
    эл7_0 = Модель5_7.getItem(0)
    эл7_1 = Модель5_7.getItem(1)
    эл7_2 = Модель5_7.getItem(2)
    ВывестиСтрокуВКонсоль("    removeItemAt(2), УдалитьЭлемент(0)")
    ВывестиСтрокуВКонсоль("    size(): " + размер7 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getItem(0): " + эл7_0 + ", getItem(1): " + эл7_1 + ", getItem(2): " + эл7_2)
    
    // ===== 9. toList() / ВСписок() =====
    Модель5_8 = Новый QtСписокМодель()
    Модель5_8.РежимОтладки(Режим_Отладки)
    Модель5_8.addItems(["X", "Y", "Z"])
    список8_1 = Модель5_8.toList()
    список8_2 = Модель5_8.ВСписок()
    ВывестиСтрокуВКонсоль("    toList(): " + список8_1.join(", ") + " (ожидается X, Y, Z)")
    ВывестиСтрокуВКонсоль("    ВСписок(): " + список8_2.join(", ") + " (ожидается X, Y, Z)")
    
    // ===== 10. fromList() / ИзСписка() =====
    Модель5_9 = Новый QtСписокМодель()
    Модель5_9.РежимОтладки(Режим_Отладки)
    Модель5_9.fromList(["A", "B", "C"])
    размер9 = Модель5_9.size()
    эл9_0 = Модель5_9.getItem(0)
    эл9_1 = Модель5_9.getItem(1)
    эл9_2 = Модель5_9.getItem(2)
    ВывестиСтрокуВКонсоль("    fromList(['A','B','C']) -> size(): " + размер9 + ", getItem(0): " + эл9_0 + ", getItem(1): " + эл9_1 + ", getItem(2): " + эл9_2)
    Модель5_9.ИзСписка(["X", "Y"])
    размер9b = Модель5_9.size()
    эл9X = Модель5_9.getItem(0)
    эл9Y = Модель5_9.getItem(1)
    ВывестиСтрокуВКонсоль("    ИзСписка(['X','Y']) -> size(): " + размер9b + ", getItem(0): " + эл9X + ", getItem(1): " + эл9Y)
    
    // ===== 11. ОЧИСТКА =====
    Модель5_10 = Новый QtСписокМодель()
    Модель5_10.РежимОтладки(Режим_Отладки)
    Модель5_10.addItems(["A", "B", "C"])
    Модель5_10.clearAll()
    размер10_1 = Модель5_10.size()
    пусто10_1 = Модель5_10.isEmpty()
    Модель5_10.addItems(["D", "E"])
    Модель5_10.Очистить()
    размер10_2 = Модель5_10.size()
    пусто10_2 = Модель5_10.isEmpty()
    ВывестиСтрокуВКонсоль("    clearAll() -> size(): " + размер10_1 + ", isEmpty(): " + пусто10_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> size(): " + размер10_2 + ", isEmpty(): " + пусто10_2 + " (ожидается 0, true)")
    
    // ===== 12. ОБНОВЛЕНИЕ =====
    Модель5_11 = Новый QtСписокМодель()
    Модель5_11.РежимОтладки(Режим_Отладки)
    Модель5_11.addItem("Тест")
    Модель5_11.refresh()
    Модель5_11.Обновить()
    эл11 = Модель5_11.getItem(0)
    ВывестиСтрокуВКонсоль("    refresh() и Обновить() выполнены, getItem(0): " + эл11 + " (ожидается Тест)")
    
    // ===== 13. ПОЛУЧЕНИЕ МОДЕЛИ СПИСКА =====
    Модель5_12 = Новый QtСписокМодель()
    Модель5_12.РежимОтладки(Режим_Отладки)
    Модель5_12.addItem("Тест модели")
    модельСписка = Модель5_12.getListModel()
    русМодельСписка = Модель5_12.ПолучитьМодельСписка()
    ВывестиСтрокуВКонсоль("    getListModel(): " + (модельСписка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьМодельСписка(): " + (русМодельСписка != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 14. RUSFUNC =====
    Если typeof Модель5_1.RusFunc === 'function' Тогда
        jsonStr = Модель5_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtAbstractListModel (QtСписокМодель) завершён.========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСписокСтрокМодель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ КоличествоСтрок                │ rowCount                       │
//│ 20 │ КоличествоКолонок              │ columnCount                    │
//│ 21 │ ПолучитьДанные                 │ data                           │
//│ 22 │ УстановитьДанные               │ setData                        │
//│ 23 │ ПолучитьЗаголовок              │ headerData                     │
//│ 24 │ УстановитьЗаголовок            │ setHeaderData                  │
//│ 25 │ Индекс                         │ index                          │
//│ 26 │ ИндексСРодителем               │ indexWithParent                │
//│ 27 │ Родитель                       │ parent                         │
//│ 28 │ Флаги                          │ flags                          │
//│ 29 │ ПолучитьМодель                 │ getModel                       │
//│ 30 │ УстановитьМодель               │ setModel                       │
//│ 31 │ НачатьСбросМодели              │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели           │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок             │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок          │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок            │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок         │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок           │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок        │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок          │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок       │ endRemoveColumns               │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ УстановитьЭлемент              │ setItem                        │
//│ 43 │ ПолучитьЭлемент                │ getItem                        │
//│ 44 │ ДобавитьЭлемент                │ addItem                        │
//│ 45 │ ДобавитьЭлементы               │ addItems                       │
//│ 46 │ ВставитьЭлемент                │ insertItemAt                   │
//│ 47 │ УдалитьЭлемент                 │ removeItemAt                   │
//│ 48 │ Очистить                       │ clearAll                       │
//│ 49 │ Размер                         │ size                           │
//│ 50 │ Количество                     │ count                          │
//│ 51 │ Пустой                         │ isEmpty                        │
//│ 52 │ Обновить                       │ refresh                        │
//│ 53 │ ВСписок                        │ toList                         │
//│ 54 │ ИзСписка                       │ fromList                       │
//│ 55 │ ПолучитьМодельСписка           │ getListModel                   │
//│ 56 │ Копировать                     │ copy                           │
//│ 57 │ Действителен                   │ isValid                        │
//│ 58 │ ПоВозрастанию                  │ ascending                      │
//│ 59 │ ПоУбыванию                     │ descending                     │
//│ 60 │ УстановитьСписок               │ setStringList                  │
//│ 61 │ ПолучитьСписок                 │ getStringList                  │
//│ 62 │ УстановитьСтроку               │ setString                      │
//│ 63 │ ПолучитьСтроку                 │ getString                      │
//│ 64 │ ДобавитьСтроку                 │ addString                      │
//│ 65 │ ДобавитьСтроки                 │ addStrings                     │
//│ 66 │ ВставитьСтроку                 │ insertStringAt                 │
//│ 67 │ УдалитьСтроку                  │ removeStringAt                 │
//│ 68 │ Очистить                       │ clearAll                       │
//│ 69 │ Размер                         │ size                           │
//│ 70 │ Количество                     │ count                          │
//│ 71 │ Пустой                         │ isEmpty                        │
//│ 72 │ Обновить                       │ refresh                        │
//│ 73 │ ИндексПоЗначению               │ indexOf                        │
//│ 74 │ Содержит                       │ contains                       │
//│ 75 │ Сортировать                    │ sortModel                      │
//│ 76 │ ПолучитьМодельСтрок            │ getStringListModel             │
//│ 77 │ Копировать                     │ copy                           │
//│ 78 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtStringListModel (QtСписокСтрокМодель) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    СтрМодель1_1 = Новый QtСписокСтрокМодель()
    СтрМодель1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С СПИСКОМ =====
    СтрМодель1_2 = Новый QtСписокСтрокМодель(["A", "B", "C"])
    СтрМодель1_2.РежимОтладки(Режим_Отладки)
    размер2 = СтрМодель1_2.size()
    стр2_0 = СтрМодель1_2.getString(0)
    стр2_1 = СтрМодель1_2.getString(1)
    стр2_2 = СтрМодель1_2.getString(2)
    ВывестиСтрокуВКонсоль("    Новый QtСписокСтрокМодель(['A','B','C']) -> size(): " + размер2 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getString(0): " + стр2_0 + ", getString(1): " + стр2_1 + ", getString(2): " + стр2_2)
    
    // ===== 3. ПУСТАЯ МОДЕЛЬ =====
    размер = СтрМодель1_1.size()
    количество = СтрМодель1_1.count()
    пусто = СтрМодель1_1.isEmpty()
    ВывестиСтрокуВКонсоль("    size(): " + размер + ", count(): " + количество + ", isEmpty(): " + пусто + " (ожидается 0, 0, true)")
    
    // ===== 4. ДОБАВЛЕНИЕ СТРОК (английские методы) =====
    СтрМодель1_3 = Новый QtСписокСтрокМодель()
    СтрМодель1_3.РежимОтладки(Режим_Отладки)
    СтрМодель1_3.addString("Первый")
    СтрМодель1_3.addString("Второй")
    СтрМодель1_3.addString("Третий")
    размер3 = СтрМодель1_3.size()
    стр3_0 = СтрМодель1_3.getString(0)
    стр3_1 = СтрМодель1_3.getString(1)
    стр3_2 = СтрМодель1_3.getString(2)
    ВывестиСтрокуВКонсоль("    addString('Первый'), addString('Второй'), addString('Третий')")
    ВывестиСтрокуВКонсоль("    size(): " + размер3 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getString(0): " + стр3_0 + ", getString(1): " + стр3_1 + ", getString(2): " + стр3_2)
    
    // ===== 5. ДОБАВЛЕНИЕ СТРОК (русские методы) =====
    СтрМодель1_4 = Новый QtСписокСтрокМодель()
    СтрМодель1_4.РежимОтладки(Режим_Отладки)
    СтрМодель1_4.ДобавитьСтроку("Русский1")
    СтрМодель1_4.ДобавитьСтроку("Русский2")
    СтрМодель1_4.ДобавитьСтроку("Русский3")
    размер4 = СтрМодель1_4.Размер()
    стр4_0 = СтрМодель1_4.ПолучитьСтроку(0)
    стр4_1 = СтрМодель1_4.ПолучитьСтроку(1)
    стр4_2 = СтрМодель1_4.ПолучитьСтроку(2)
    ВывестиСтрокуВКонсоль("    ДобавитьСтроку('Русский1'), ДобавитьСтроку('Русский2'), ДобавитьСтроку('Русский3')")
    ВывестиСтрокуВКонсоль("    Размер(): " + размер4 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку(0): " + стр4_0 + ", ПолучитьСтроку(1): " + стр4_1 + ", ПолучитьСтроку(2): " + стр4_2)
    
    // ===== 6. ДОБАВЛЕНИЕ НЕСКОЛЬКИХ СТРОК =====
    СтрМодель1_5 = Новый QtСписокСтрокМодель()
    СтрМодель1_5.РежимОтладки(Режим_Отладки)
    СтрМодель1_5.addStrings(["A", "B", "C"])
    СтрМодель1_5.ДобавитьСтроки(["D", "E"])
    размер5 = СтрМодель1_5.size()
    список5 = СтрМодель1_5.getStringList()
    ВывестиСтрокуВКонсоль("    addStrings(['A','B','C']) + ДобавитьСтроки(['D','E'])")
    ВывестиСтрокуВКонсоль("    size(): " + размер5 + " (ожидается 5), getStringList(): " + список5.join(", "))
    
    // ===== 7. ВСТАВКА СТРОКИ =====
    СтрМодель1_6 = Новый QtСписокСтрокМодель(["0", "2", "3"])
    СтрМодель1_6.РежимОтладки(Режим_Отладки)
    СтрМодель1_6.insertStringAt(1, "1")
    СтрМодель1_6.ВставитьСтроку(0, "Начало")
    размер6 = СтрМодель1_6.size()
    стр6_0 = СтрМодель1_6.getString(0)
    стр6_1 = СтрМодель1_6.getString(1)
    стр6_2 = СтрМодель1_6.getString(2)
    стр6_3 = СтрМодель1_6.getString(3)
    ВывестиСтрокуВКонсоль("    insertStringAt(1,'1'), ВставитьСтроку(0,'Начало')")
    ВывестиСтрокуВКонсоль("    size(): " + размер6 + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    getString(0): " + стр6_0 + ", getString(1): " + стр6_1 + ", getString(2): " + стр6_2 + ", getString(3): " + стр6_3)
    
    // ===== 8. УСТАНОВКА СТРОКИ =====
    СтрМодель1_7 = Новый QtСписокСтрокМодель(["A", "B", "C"])
    СтрМодель1_7.РежимОтладки(Режим_Отладки)
    СтрМодель1_7.setString(1, "X")
    СтрМодель1_7.УстановитьСтроку(2, "Y")
    стр7_1 = СтрМодель1_7.getString(1)
    стр7_2 = СтрМодель1_7.getString(2)
    ВывестиСтрокуВКонсоль("    setString(1,'X') -> getString(1): " + стр7_1 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    УстановитьСтроку(2,'Y') -> getString(2): " + стр7_2 + " (ожидается Y)")
    
    // ===== 9. УДАЛЕНИЕ СТРОКИ =====
    СтрМодель1_8 = Новый QtСписокСтрокМодель(["0", "1", "2", "3", "4"])
    СтрМодель1_8.РежимОтладки(Режим_Отладки)
    СтрМодель1_8.removeStringAt(2)
    СтрМодель1_8.УдалитьСтроку(0)
    размер8 = СтрМодель1_8.size()
    стр8_0 = СтрМодель1_8.getString(0)
    стр8_1 = СтрМодель1_8.getString(1)
    стр8_2 = СтрМодель1_8.getString(2)
    ВывестиСтрокуВКонсоль("    removeStringAt(2), УдалитьСтроку(0)")
    ВывестиСтрокуВКонсоль("    size(): " + размер8 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getString(0): " + стр8_0 + ", getString(1): " + стр8_1 + ", getString(2): " + стр8_2)
    
    // ===== 10. УСТАНОВКА/ПОЛУЧЕНИЕ СПИСКА =====
    СтрМодель1_9 = Новый QtСписокСтрокМодель()
    СтрМодель1_9.РежимОтладки(Режим_Отладки)
    СтрМодель1_9.setStringList(["X", "Y", "Z"])
    список9_1 = СтрМодель1_9.getStringList()
    ВывестиСтрокуВКонсоль("    setStringList(['X','Y','Z']) -> getStringList(): " + список9_1.join(", "))
    СтрМодель1_9.УстановитьСписок(["A", "B"])
    список9_2 = СтрМодель1_9.ПолучитьСписок()
    ВывестиСтрокуВКонсоль("    УстановитьСписок(['A','B']) -> ПолучитьСписок(): " + список9_2.join(", "))
    
    // ===== 11. ПОИСК =====
    СтрМодель1_10 = Новый QtСписокСтрокМодель(["Яблоко", "Банан", "Апельсин", "Банан"])
    СтрМодель1_10.РежимОтладки(Режим_Отладки)
    индекс1 = СтрМодель1_10.indexOf("Банан")
    индекс2 = СтрМодель1_10.ИндексПоЗначению("Апельсин")
    содержит1 = СтрМодель1_10.contains("Яблоко")
    содержит2 = СтрМодель1_10.Содержит("Груша")
    ВывестиСтрокуВКонсоль("    indexOf('Банан'): " + индекс1 + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    ИндексПоЗначению('Апельсин'): " + индекс2 + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    contains('Яблоко'): " + содержит1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Содержит('Груша'): " + содержит2 + " (ожидается false)")
    
    // ===== 12. СОРТИРОВКА =====
    СтрМодель1_11 = Новый QtСписокСтрокМодель(["Банан", "Апельсин", "Яблоко"])
    СтрМодель1_11.РежимОтладки(Режим_Отладки)
    восх = СтрМодель1_11.ascending()
    нисх = СтрМодель1_11.ПоУбыванию()
    ВывестиСтрокуВКонсоль("    ascending(): " + восх + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    ПоУбыванию(): " + нисх + " (ожидается 1)")
    СтрМодель1_11.sortModel(восх)
    список11_1 = СтрМодель1_11.getStringList()
    ВывестиСтрокуВКонсоль("    sortModel(0) -> " + список11_1.join(", "))
    СтрМодель1_11.Сортировать(нисх)
    список11_2 = СтрМодель1_11.getStringList()
    ВывестиСтрокуВКонсоль("    Сортировать(1) -> " + список11_2.join(", "))
    
    // ===== 13. ОЧИСТКА =====
    СтрМодель1_12 = Новый QtСписокСтрокМодель(["A", "B", "C"])
    СтрМодель1_12.РежимОтладки(Режим_Отладки)
    СтрМодель1_12.clearAll()
    размер12_1 = СтрМодель1_12.size()
    пусто12_1 = СтрМодель1_12.isEmpty()
    СтрМодель1_12.addStrings(["D", "E"])
    СтрМодель1_12.Очистить()
    размер12_2 = СтрМодель1_12.size()
    пусто12_2 = СтрМодель1_12.isEmpty()
    ВывестиСтрокуВКонсоль("    clearAll() -> size(): " + размер12_1 + ", isEmpty(): " + пусто12_1)
    ВывестиСтрокуВКонсоль("    Очистить() -> size(): " + размер12_2 + ", isEmpty(): " + пусто12_2 + " (ожидается 0, true)")
    
    // ===== 14. ОБНОВЛЕНИЕ =====
    СтрМодель1_13 = Новый QtСписокСтрокМодель(["Тест"])
    СтрМодель1_13.РежимОтладки(Режим_Отладки)
    СтрМодель1_13.refresh()
    СтрМодель1_13.Обновить()
    стр13 = СтрМодель1_13.getString(0)
    ВывестиСтрокуВКонсоль("    refresh() и Обновить() выполнены, getString(0): " + стр13 + " (ожидается Тест)")
    
    // ===== 15. ПОЛУЧЕНИЕ МОДЕЛИ =====
    СтрМодель1_14 = Новый QtСписокСтрокМодель(["Тест модели"])
    СтрМодель1_14.РежимОтладки(Режим_Отладки)
    модельСтрок = СтрМодель1_14.getStringListModel()
    русМодельСтрок = СтрМодель1_14.ПолучитьМодельСтрок()
    ВывестиСтрокуВКонсоль("    getStringListModel(): " + (модельСтрок != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьМодельСтрок(): " + (русМодельСтрок != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 16. RUSFUNC =====
    Если typeof СтрМодель1_1.RusFunc === 'function' Тогда
        jsonStr = СтрМодель1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtStringListModel (QtСписокСтрокМодель) завершён.====================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtСтандартнаяМодель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ КоличествоСтрок                │ rowCount                       │
//│ 20 │ КоличествоКолонок              │ columnCount                    │
//│ 21 │ ПолучитьДанные                 │ data                           │
//│ 22 │ УстановитьДанные               │ setData                        │
//│ 23 │ ПолучитьЗаголовок              │ headerData                     │
//│ 24 │ УстановитьЗаголовок            │ setHeaderData                  │
//│ 25 │ Индекс                         │ index                          │
//│ 26 │ ИндексСРодителем               │ indexWithParent                │
//│ 27 │ Родитель                       │ parent                         │
//│ 28 │ Флаги                          │ flags                          │
//│ 29 │ ПолучитьМодель                 │ getModel                       │
//│ 30 │ УстановитьМодель               │ setModel                       │
//│ 31 │ НачатьСбросМодели              │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели           │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок             │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок          │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок            │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок         │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок           │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок        │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок          │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок       │ endRemoveColumns               │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ВставитьСтроку                 │ insertRow                      │
//│ 43 │ ВставитьСтроки                 │ insertRows                     │
//│ 44 │ ВставитьКолонку                │ insertColumn                   │
//│ 45 │ ВставитьКолонки                │ insertColumns                  │
//│ 46 │ УдалитьСтроку                  │ removeRow                      │
//│ 47 │ УдалитьСтроки                  │ removeRows                     │
//│ 48 │ УдалитьКолонку                 │ removeColumn                   │
//│ 49 │ УдалитьКолонки                 │ removeColumns                  │
//│ 50 │ Очистить                       │ clear                          │
//│ 51 │ УстановитьЗаголовокКолонки     │ setHorizontalHeader            │
//│ 52 │ УстановитьЗаголовкиКолонок     │ setHorizontalHeaders           │
//│ 53 │ УстановитьЗаголовокСтроки      │ setVerticalHeader              │
//│ 54 │ УстановитьЗаголовкиСтрок       │ setVerticalHeaders             │
//│ 55 │ ЗаголовокКолонки               │ horizontalHeader               │
//│ 56 │ ЗаголовокСтроки                │ verticalHeader                 │
//│ 57 │ УстановитьЭлемент              │ setItem                        │
//│ 58 │ ПолучитьЭлемент                │ item                           │
//│ 59 │ Элемент                        │ item                           │
//│ 60 │ ТекстЭлемента                  │ itemText                       │
//│ 61 │ УстановитьДанныеПоИндексу      │ setData                        │
//│ 62 │ ПолучитьДанныеПоИндексу        │ data                           │
//│ 63 │ ПолучитьСтандартнуюМодель      │ getStandardModel               │
//│ 64 │ Копировать                     │ copy                           │
//│ 65 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtStandardItemModel (QtСтандартнаяМодель) - КОМПАКТНАЯ ВЕРСИЯ ===")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Станд1_1 = Новый QtСтандартнаяМодель()
    Станд1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ЗАГОЛОВКИ =====
    Станд1_2 = Новый QtСтандартнаяМодель()
    Станд1_2.РежимОтладки(Режим_Отладки)
    Станд1_2.setHorizontalHeaders(["A", "B", "C"])
    Станд1_2.setVerticalHeaders(["X", "Y"])
    загКол0 = Станд1_2.horizontalHeader(0)
    загКол1 = Станд1_2.horizontalHeader(1)
    загКол2 = Станд1_2.horizontalHeader(2)
    загСтр0 = Станд1_2.verticalHeader(0)
    загСтр1 = Станд1_2.verticalHeader(1)
    ВывестиСтрокуВКонсоль("    setHorizontalHeaders(['A','B','C']), setVerticalHeaders(['X','Y'])")
    ВывестиСтрокуВКонсоль("    horizontalHeader(0): " + загКол0 + " (ожидается A)")
    ВывестиСтрокуВКонсоль("    horizontalHeader(1): " + загКол1 + " (ожидается B)")
    ВывестиСтрокуВКонсоль("    horizontalHeader(2): " + загКол2 + " (ожидается C)")
    ВывестиСтрокуВКонсоль("    verticalHeader(0): " + загСтр0 + " (ожидается X)")
    ВывестиСтрокуВКонсоль("    verticalHeader(1): " + загСтр1 + " (ожидается Y)")
    
    // ===== 3. УСТАНОВКА И ПОЛУЧЕНИЕ ДАННЫХ =====
    Станд1_3 = Новый QtСтандартнаяМодель()
    Станд1_3.РежимОтладки(Режим_Отладки)
    Станд1_3.setItem(0, 0, "Тест")
    Станд1_3.setItem(0, 1, "Значение")
    знач1 = Станд1_3.itemText(0, 0)
    знач2 = Станд1_3.itemText(0, 1)
    ВывестиСтрокуВКонсоль("    setItem(0,0,'Тест') -> itemText(0,0): " + знач1 + " (ожидается Тест)")
    ВывестиСтрокуВКонсоль("    setItem(0,1,'Значение') -> itemText(0,1): " + знач2 + " (ожидается Значение)")
    
    // ===== 4. ВАЛИДНОСТЬ =====
    Станд1_4 = Новый QtСтандартнаяМодель()
    Станд1_4.РежимОтладки(Режим_Отладки)
    валид = Станд1_4.isValid()
    ВывестиСтрокуВКонсоль("    isValid(): " + валид + " (ожидается true)")
    
    // ===== 5. ПОЛУЧЕНИЕ СТАНДАРТНОЙ МОДЕЛИ =====
    Станд1_5 = Новый QtСтандартнаяМодель()
    Станд1_5.РежимОтладки(Режим_Отладки)
    стандартная = Станд1_5.getStandardModel()
    ВывестиСтрокуВКонсоль("    getStandardModel(): " + (стандартная != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. RUSFUNC =====
    Если typeof Станд1_1.RusFunc === 'function' Тогда
        jsonStr = Станд1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtStandardItemModel (QtСтандартнаяМодель) завершён.==================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtТаблицаМодель()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ КоличествоСтрок                │ rowCount                       │
//│ 20 │ КоличествоКолонок              │ columnCount                    │
//│ 21 │ ПолучитьДанные                 │ data                           │
//│ 22 │ УстановитьДанные               │ setData                        │
//│ 23 │ ПолучитьЗаголовок              │ headerData                     │
//│ 24 │ УстановитьЗаголовок            │ setHeaderData                  │
//│ 25 │ Индекс                         │ index                          │
//│ 26 │ ИндексСРодителем               │ indexWithParent                │
//│ 27 │ Родитель                       │ parent                         │
//│ 28 │ Флаги                          │ flags                          │
//│ 29 │ ПолучитьМодель                 │ getModel                       │
//│ 30 │ УстановитьМодель               │ setModel                       │
//│ 31 │ НачатьСбросМодели              │ beginResetModel                │
//│ 32 │ ЗавершитьСбросМодели           │ endResetModel                  │
//│ 33 │ НачатьВставкуСтрок             │ beginInsertRows                │
//│ 34 │ ЗавершитьВставкуСтрок          │ endInsertRows                  │
//│ 35 │ НачатьУдалениеСтрок            │ beginRemoveRows                │
//│ 36 │ ЗавершитьУдалениеСтрок         │ endRemoveRows                  │
//│ 37 │ НачатьВставкуКолонок           │ beginInsertColumns             │
//│ 38 │ ЗавершитьВставкуКолонок        │ endInsertColumns               │
//│ 39 │ НачатьУдалениеКолонок          │ beginRemoveColumns             │
//│ 40 │ ЗавершитьУдалениеКолонок       │ endRemoveColumns               │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ УстановитьЗначение             │ setDataValue                   │
//│ 43 │ ПолучитьЗначение               │ getDataValue                   │
//│ 44 │ УстановитьЗаголовок            │ setHeaderDataValue             │
//│ 45 │ ПолучитьЗаголовок              │ getHeaderDataValue             │
//│ 46 │ УстановитьЗаголовки            │ setHeaders                     │
//│ 47 │ ПолучитьЗаголовки              │ getHeaders                     │
//│ 48 │ УстановитьКоличествоСтрок      │ setRowCount                    │
//│ 49 │ УстановитьКоличествоКолонок    │ setColumnCount                 │
//│ 50 │ ДобавитьСтроку                 │ addRow                         │
//│ 51 │ ВставитьСтроку                 │ insertRowAt                    │
//│ 52 │ УдалитьСтроку                  │ removeRowAt                    │
//│ 53 │ Очистить                       │ clearAll                       │
//│ 54 │ Обновить                       │ refresh                        │
//│ 55 │ ПолучитьТабличнуюМодель        │ getTableModel                  │
//│ 56 │ Действителен                   │ isValid                        │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtAbstractTableModel (QtТаблицаМодель) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ТаблМод1_1 = Новый QtТаблицаМодель()
    ТаблМод1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТАЯ МОДЕЛЬ =====
    строк = ТаблМод1_1.rowCount()
    колонок = ТаблМод1_1.columnCount()
    ВывестиСтрокуВКонсоль("    rowCount(): " + строк + ", columnCount(): " + колонок + " (ожидается 0, 0)")
    
    // ===== 3. УСТАНОВКА РАЗМЕРОВ =====
    ТаблМод1_2 = Новый QtТаблицаМодель()
    ТаблМод1_2.РежимОтладки(Режим_Отладки)
    ТаблМод1_2.setRowCount(3)
    ТаблМод1_2.setColumnCount(4)
    строк2 = ТаблМод1_2.rowCount()
    колонок2 = ТаблМод1_2.columnCount()
    ВывестиСтрокуВКонсоль("    setRowCount(3), setColumnCount(4) -> rowCount(): " + строк2 + " (ожидается 3), columnCount(): " + колонок2 + " (ожидается 4)")
    
    // ===== 4. УСТАНОВКА ДАННЫХ (английские методы) =====
    ТаблМод1_3 = Новый QtТаблицаМодель()
    ТаблМод1_3.РежимОтладки(Режим_Отладки)
    ТаблМод1_3.setRowCount(2)
    ТаблМод1_3.setColumnCount(3)
    ТаблМод1_3.setDataValue(0, 0, "Тест")
    ТаблМод1_3.setDataValue(0, 1, "Значение")
    ТаблМод1_3.setDataValue(0, 2, "Данные")
    ТаблМод1_3.setDataValue(1, 0, "Строка 2")
    ТаблМод1_3.setDataValue(1, 1, "42")
    ТаблМод1_3.setDataValue(1, 2, "3.14")
    д4_00 = ТаблМод1_3.getDataValue(0, 0)
    д4_01 = ТаблМод1_3.getDataValue(0, 1)
    д4_02 = ТаблМод1_3.getDataValue(0, 2)
    д4_10 = ТаблМод1_3.getDataValue(1, 0)
    д4_11 = ТаблМод1_3.getDataValue(1, 1)
    д4_12 = ТаблМод1_3.getDataValue(1, 2)
    ВывестиСтрокуВКонсоль("    setDataValue(0,0,'Тест') -> getDataValue(0,0): " + д4_00 + " (ожидается Тест)")
    ВывестиСтрокуВКонсоль("    setDataValue(0,1,'Значение') -> getDataValue(0,1): " + д4_01 + " (ожидается Значение)")
    ВывестиСтрокуВКонсоль("    setDataValue(0,2,'Данные') -> getDataValue(0,2): " + д4_02 + " (ожидается Данные)")
    ВывестиСтрокуВКонсоль("    setDataValue(1,0,'Строка 2') -> getDataValue(1,0): " + д4_10 + " (ожидается Строка 2)")
    ВывестиСтрокуВКонсоль("    setDataValue(1,1,'42') -> getDataValue(1,1): " + д4_11 + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    setDataValue(1,2,'3.14') -> getDataValue(1,2): " + д4_12 + " (ожидается 3.14)")
    
    // ===== 5. УСТАНОВКА ДАННЫХ (русские методы) =====
    ТаблМод1_4 = Новый QtТаблицаМодель()
    ТаблМод1_4.РежимОтладки(Режим_Отладки)
    ТаблМод1_4.УстановитьКоличествоСтрок(2)
    ТаблМод1_4.УстановитьКоличествоКолонок(2)
    ТаблМод1_4.УстановитьЗначение(0, 0, "Русский")
    ТаблМод1_4.УстановитьЗначение(0, 1, "Тест")
    ТаблМод1_4.УстановитьЗначение(1, 0, "Пример")
    ТаблМод1_4.УстановитьЗначение(1, 1, "2024")
    д5_00 = ТаблМод1_4.ПолучитьЗначение(0, 0)
    д5_01 = ТаблМод1_4.ПолучитьЗначение(0, 1)
    д5_10 = ТаблМод1_4.ПолучитьЗначение(1, 0)
    д5_11 = ТаблМод1_4.ПолучитьЗначение(1, 1)
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(0,0,'Русский') -> ПолучитьЗначение(0,0): " + д5_00 + " (ожидается Русский)")
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(0,1,'Тест') -> ПолучитьЗначение(0,1): " + д5_01 + " (ожидается Тест)")
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(1,0,'Пример') -> ПолучитьЗначение(1,0): " + д5_10 + " (ожидается Пример)")
    ВывестиСтрокуВКонсоль("    УстановитьЗначение(1,1,'2024') -> ПолучитьЗначение(1,1): " + д5_11 + " (ожидается 2024)")
    
    // ===== 6. ЗАГОЛОВКИ (английские) =====
    ТаблМод1_5 = Новый QtТаблицаМодель()
    ТаблМод1_5.РежимОтладки(Режим_Отладки)
    ТаблМод1_5.setColumnCount(4)
    ТаблМод1_5.setHeaders(["Кол1", "Кол2", "Кол3", "Кол4"])
    ТаблМод1_5.setHeaderDataValue(1, "Заголовок2")
    ТаблМод1_5.setHeaderDataValue(3, "Заголовок4")
    заг1 = ТаблМод1_5.getHeaderDataValue(0)
    заг2 = ТаблМод1_5.getHeaderDataValue(1)
    заг3 = ТаблМод1_5.getHeaderDataValue(2)
    заг4 = ТаблМод1_5.getHeaderDataValue(3)
    ВывестиСтрокуВКонсоль("    setHeaders(['Кол1','Кол2','Кол3','Кол4']), setHeaderDataValue(1,'Заголовок2'), setHeaderDataValue(3,'Заголовок4')")
    ВывестиСтрокуВКонсоль("    getHeaderDataValue(0): " + заг1 + " (ожидается Кол1)")
    ВывестиСтрокуВКонсоль("    getHeaderDataValue(1): " + заг2 + " (ожидается Заголовок2)")
    ВывестиСтрокуВКонсоль("    getHeaderDataValue(2): " + заг3 + " (ожидается Кол3)")
    ВывестиСтрокуВКонсоль("    getHeaderDataValue(3): " + заг4 + " (ожидается Заголовок4)")
    
    // ===== 7. ЗАГОЛОВКИ (русские) =====
    ТаблМод1_6 = Новый QtТаблицаМодель()
    ТаблМод1_6.РежимОтладки(Режим_Отладки)
    ТаблМод1_6.setColumnCount(3)
    ТаблМод1_6.УстановитьЗаголовки(["Рус1", "Рус2", "Рус3"])
    ТаблМод1_6.УстановитьЗаголовок(1, "ЗаголовокРус2")
    загР1 = ТаблМод1_6.ПолучитьЗаголовок(0)
    загР2 = ТаблМод1_6.ПолучитьЗаголовок(1)
    загР3 = ТаблМод1_6.ПолучитьЗаголовок(2)
    ВывестиСтрокуВКонсоль("    УстановитьЗаголовки(['Рус1','Рус2','Рус3']), УстановитьЗаголовок(1,'ЗаголовокРус2')")
    ВывестиСтрокуВКонсоль("    ПолучитьЗаголовок(0): " + загР1 + " (ожидается Рус1)")
    ВывестиСтрокуВКонсоль("    ПолучитьЗаголовок(1): " + загР2 + " (ожидается ЗаголовокРус2)")
    ВывестиСтрокуВКонсоль("    ПолучитьЗаголовок(2): " + загР3 + " (ожидается Рус3)")
    
    // ===== 8. ДОБАВЛЕНИЕ СТРОК =====
    ТаблМод1_7 = Новый QtТаблицаМодель()
    ТаблМод1_7.РежимОтладки(Режим_Отладки)
    ТаблМод1_7.setColumnCount(3)
    ТаблМод1_7.addRow(["A1", "B1", "C1"])
    ТаблМод1_7.ДобавитьСтроку(["A2", "B2", "C2"])
    ТаблМод1_7.addRow(["A3", "B3", "C3"])
    строк7 = ТаблМод1_7.rowCount()
    д7_00 = ТаблМод1_7.getDataValue(0, 0)
    д7_11 = ТаблМод1_7.getDataValue(1, 1)
    д7_22 = ТаблМод1_7.getDataValue(2, 2)
    ВывестиСтрокуВКонсоль("    addRow(['A1','B1','C1']), ДобавитьСтроку(['A2','B2','C2']), addRow(['A3','B3','C3'])")
    ВывестиСтрокуВКонсоль("    rowCount(): " + строк7 + " (ожидается 3), getDataValue(0,0): " + д7_00 + ", getDataValue(1,1): " + д7_11 + ", getDataValue(2,2): " + д7_22)
    
    // ===== 9. ВСТАВКА СТРОК =====
    ТаблМод1_8 = Новый QtТаблицаМодель()
    ТаблМод1_8.РежимОтладки(Режим_Отладки)
    ТаблМод1_8.setColumnCount(3)
    ТаблМод1_8.addRow(["0", "0", "0"])
    ТаблМод1_8.addRow(["2", "2", "2"])
    ТаблМод1_8.insertRowAt(1, ["X1", "Y1", "Z1"])
    ТаблМод1_8.ВставитьСтроку(0, ["X0", "Y0", "Z0"])
    ТаблМод1_8.insertRowAt(3, ["X3", "Y3", "Z3"])
    строк8 = ТаблМод1_8.rowCount()
    д8_0 = ТаблМод1_8.getDataValue(0, 0)
    д8_1 = ТаблМод1_8.getDataValue(1, 0)
    д8_2 = ТаблМод1_8.getDataValue(2, 0)
    д8_3 = ТаблМод1_8.getDataValue(3, 0)
    д8_4 = ТаблМод1_8.getDataValue(4, 0)
    ВывестиСтрокуВКонсоль("    insertRowAt(1,['X1','Y1','Z1']), ВставитьСтроку(0,['X0','Y0','Z0']), insertRowAt(3,['X3','Y3','Z3'])")
    ВывестиСтрокуВКонсоль("    rowCount(): " + строк8 + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    getDataValue(0,0): " + д8_0 + ", getDataValue(1,0): " + д8_1 + ", getDataValue(2,0): " + д8_2 + ", getDataValue(3,0): " + д8_3 + ", getDataValue(4,0): " + д8_4)
    
    // ===== 10. УДАЛЕНИЕ СТРОК =====
    ТаблМод1_9 = Новый QtТаблицаМодель()
    ТаблМод1_9.РежимОтладки(Режим_Отладки)
    ТаблМод1_9.setColumnCount(2)
    ТаблМод1_9.addRow(["0", "0"])
    ТаблМод1_9.addRow(["1", "1"])
    ТаблМод1_9.addRow(["2", "2"])
    ТаблМод1_9.addRow(["3", "3"])
    ТаблМод1_9.addRow(["4", "4"])
    ТаблМод1_9.addRow(["5", "5"])
    ТаблМод1_9.removeRowAt(2)
    ТаблМод1_9.УдалитьСтроку(0)
    ТаблМод1_9.removeRowAt(2)
    строк9 = ТаблМод1_9.rowCount()
    д9_0 = ТаблМод1_9.getDataValue(0, 0)
    д9_1 = ТаблМод1_9.getDataValue(1, 0)
    д9_2 = ТаблМод1_9.getDataValue(2, 0)
    ВывестиСтрокуВКонсоль("    removeRowAt(2), УдалитьСтроку(0), removeRowAt(2)")
    ВывестиСтрокуВКонсоль("    rowCount(): " + строк9 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getDataValue(0,0): " + д9_0 + ", getDataValue(1,0): " + д9_1 + ", getDataValue(2,0): " + д9_2)
    
    // ===== 11. ОЧИСТКА =====
    ТаблМод1_10 = Новый QtТаблицаМодель()
    ТаблМод1_10.РежимОтладки(Режим_Отладки)
    ТаблМод1_10.setRowCount(3)
    ТаблМод1_10.setColumnCount(3)
    ТаблМод1_10.setDataValue(0, 0, "Данные1")
    ТаблМод1_10.setHeaders(["A", "B", "C"])
    ТаблМод1_10.clearAll()
    строк10_1 = ТаблМод1_10.rowCount()
    колонок10_1 = ТаблМод1_10.columnCount()
    ТаблМод1_10.setRowCount(2)
    ТаблМод1_10.setColumnCount(2)
    ТаблМод1_10.setDataValue(0, 0, "Новые данные")
    ТаблМод1_10.Очистить()
    строк10_2 = ТаблМод1_10.rowCount()
    колонок10_2 = ТаблМод1_10.columnCount()
    ВывестиСтрокуВКонсоль("    clearAll() -> rowCount(): " + строк10_1 + ", columnCount(): " + колонок10_1 + " (ожидается 0, 0)")
    ВывестиСтрокуВКонсоль("    Очистить() -> rowCount(): " + строк10_2 + ", columnCount(): " + колонок10_2 + " (ожидается 0, 0)")
    
    // ===== 12. ОБНОВЛЕНИЕ =====
    ТаблМод1_11 = Новый QtТаблицаМодель()
    ТаблМод1_11.РежимОтладки(Режим_Отладки)
    ТаблМод1_11.setRowCount(1)
    ТаблМод1_11.setColumnCount(1)
    ТаблМод1_11.setDataValue(0, 0, "Тест")
    ТаблМод1_11.refresh()
    ТаблМод1_11.Обновить()
    д11 = ТаблМод1_11.getDataValue(0, 0)
    ВывестиСтрокуВКонсоль("    refresh() и Обновить() выполнены, getDataValue(0,0): " + д11 + " (ожидается Тест)")
    
    // ===== 13. ПОЛУЧЕНИЕ ТАБЛИЧНОЙ МОДЕЛИ =====
    ТаблМод1_12 = Новый QtТаблицаМодель()
    ТаблМод1_12.РежимОтладки(Режим_Отладки)
    ТаблМод1_12.setRowCount(1)
    ТаблМод1_12.setColumnCount(1)
    ТаблМод1_12.setDataValue(0, 0, "Тест модели")
    табличнаяМодель = ТаблМод1_12.getTableModel()
    русТабличнаяМодель = ТаблМод1_12.ПолучитьТабличнуюМодель()
    ВывестиСтрокуВКонсоль("    getTableModel(): " + (табличнаяМодель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    ПолучитьТабличнуюМодель(): " + (русТабличнаяМодель != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 14. RUSFUNC =====
    Если typeof ТаблМод1_1.RusFunc === 'function' Тогда
        jsonStr = ТаблМод1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
   
    ВывестиСтрокуВКонсоль("==== Тест QtAbstractTableModel (QtТаблицаМодель) завершён.======================") 
    //ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtDomДокумент()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬───────────────────────────────────┬──────────────────────────────────┐
//│  №  │ Русский метод                     │ Английский метод                  │
//├─────┼───────────────────────────────────┼──────────────────────────────────┤
//│ 1 │ Действителен                      │ isValid                          │
//│ 2 │ ПолучитьОбъект                    │ getRealObject                    │
//│ 3 │ УстановитьРодителя                │ setParentWrapper                 │
//│ 4 │ ПолучитьРодителя                  │ getParentWrapper                 │
//│ 5 │ УстановитьИмяОбъекта              │ setObjectName                    │
//│ 6 │ ИмяОбъекта                        │ objectName                       │
//│ 7 │ УстановитьСвойство                │ setProperty                      │
//│ 8 │ Свойство                          │ property                         │
//│ 9 │ ПодключитьСигнал                  │ connectSignal                    │
//│ 10 │ ОтключитьСигнал                   │ disconnectSignal                 │
//│ 11 │ КопироватьВ                       │ copyTo                           │
//│ 12 │ РежимОтладки                      │ setDebug                         │
//│ 13 │ ПолучитьРежимОтладки              │ getDebug                         │
//│ 14 │ ПолучитьТипКласса                 │ getClassType                     │
//│ 15 │ УстановитьТипКласса               │ setClassType                     │
//│ 16 │ ПолучитьИмяКласса                 │ getClassName                     │
//│ 17 │ УстановитьИмяКласса               │ setClassName                     │
//│ 18 │ ПолучитьСписокМетодов             │ RusFunc                          │
//│ 19 │ УстановитьСодержимое              │ setContentValue                  │
//│ 20 │ УстановитьСодержимоеИзУстройства  │ setContentFromDevice             │
//│ 21 │ УстановитьСодержимоеИзФайла       │ setContentFromFile               │
//│ 22 │ КорневойЭлемент                   │ documentElementValue             │
//│ 23 │ СоздатьЭлемент                    │ createElementValue               │
//│ 24 │ СоздатьЭлементСПространством      │ createElementWithNs              │
//│ 25 │ СоздатьТекст                      │ createTextNodeValue              │
//│ 26 │ СоздатьКомментарий                │ createCommentValue               │
//│ 27 │ СоздатьCDATA                      │ createCDATASectionValue          │
//│ 28 │ СоздатьИнструкцию                 │ createProcessingInstructionValue │
//│ 29 │ СоздатьАтрибут                    │ createAttributeValue             │
//│ 30 │ СоздатьАтрибутСПространством      │ createAttributeWithNs            │
//│ 31 │ ЭлементПоИд                       │ elementByIdValue                 │
//│ 32 │ ЭлементыПоИмениТега               │ elementsByTagNameValue           │
//│ 33 │ ЭлементыПоИмениТегаСПространством │ elementsByTagNameNsValue         │
//│ 34 │ УстановитьКорневойЭлемент         │ setRootElementValue              │
//│ 35 │ ДобавитьДочерний                  │ appendChildValue                 │
//│ 36 │ ВставитьДо                        │ insertBeforeValue                │
//│ 37 │ ВставитьПосле                     │ insertAfterValue                 │
//│ 38 │ УдалитьДочерний                   │ removeChildValue                 │
//│ 39 │ Клонировать                       │ cloneNodeValue                   │
//│ 40 │ Пустой                            │ isNullValue                      │
//│ 41 │ ВСтроку                           │ toStringValue                    │
//│ 42 │ ВМассивБайт                       │ toByteArrayValue                 │
//│ 43 │ ПоследняяОшибка                   │ getLastErrorValue                │
//│ 44 │ СтрокаОшибки                      │ getLastErrorLineValue            │
//│ 45 │ КолонкаОшибки                     │ getLastErrorColumnValue          │
//│ 46 │ ОчиститьОшибку                    │ clearErrorValue                  │
//│ 47 │ ПолучитьДокумент                  │ getDocumentValue                 │
//│ 48 │ ПолучитьDoc                       │ getDocumentObject                │
//└─────┴───────────────────────────────────┴──────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtDomDocument (QtDomДокумент) - КОМПАКТНАЯ ВЕРСИЯ =============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ДомДок1_1 = Новый QtDomДокумент()
    ДомДок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОЗДАНИЕ С ИМЕНЕМ =====
    ДомДок1_2 = Новый QtDomДокумент("root")
    ДомДок1_2.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание с именем 'root': УСПЕШНО")
    
    // ===== 3. ЗАГРУЗКА XML =====
    ДомДок1_3 = Новый QtDomДокумент()
    ДомДок1_3.РежимОтладки(Режим_Отладки)
    xml = "<?xml version='1.0'?><root><item id='1'>Значение</item></root>"
    результат = ДомДок1_3.setContentValue(xml)
    ВывестиСтрокуВКонсоль("    setContentValue(xml): " + результат + " (ожидается true)")
    
    // ===== 4. ОШИБКИ ЗАГРУЗКИ =====
    ДомДок1_4 = Новый QtDomДокумент()
    ДомДок1_4.РежимОтладки(Режим_Отладки)
    некорректныйXml = "<root><item>Текст</root>"
    результатОш = ДомДок1_4.setContentValue(некорректныйXml)
    ошибка = ДомДок1_4.getLastErrorValue()
    строкаОш = ДомДок1_4.getLastErrorLineValue()
    ВывестиСтрокуВКонсоль("    setContentValue(некорректный XML): " + результатОш + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    getLastErrorValue(): " + ошибка)
    ВывестиСтрокуВКонсоль("    getLastErrorLineValue(): " + строкаОш)
    
    // ===== 5. СОЗДАНИЕ ЭЛЕМЕНТОВ =====
    ДомДок1_5 = Новый QtDomДокумент()
    ДомДок1_5.РежимОтладки(Режим_Отладки)
    корень = ДомДок1_5.createElementValue("root")
    дочерний = ДомДок1_5.createElementValue("child")
    текст = ДомДок1_5.createTextNodeValue("Содержимое")
    ВывестиСтрокуВКонсоль("    createElementValue('root'): " + (корень != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    createElementValue('child'): " + (дочерний != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    createTextNodeValue('Содержимое'): " + (текст != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 6. КОММЕНТАРИЙ И CDATA =====
    ДомДок1_6 = Новый QtDomДокумент()
    ДомДок1_6.РежимОтладки(Режим_Отладки)
    коммент = ДомДок1_6.createCommentValue("Это комментарий")
    cdata = ДомДок1_6.createCDATASectionValue("Это CDATA секция")
    ВывестиСтрокуВКонсоль("    createCommentValue(): " + (коммент != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    createCDATASectionValue(): " + (cdata != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 7. ПОИСК ЭЛЕМЕНТОВ =====
    ДомДок1_7 = Новый QtDomДокумент()
    ДомДок1_7.РежимОтладки(Режим_Отладки)
    xml2 = "<?xml version='1.0'?><root><item>1</item><item>2</item><item>3</item></root>"
    ДомДок1_7.setContentValue(xml2)
    список = ДомДок1_7.elementsByTagNameValue("item")
    ВывестиСтрокуВКонсоль("    elementsByTagNameValue('item'): " + (список != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 8. isNullValue() / Пустой() =====
    ДомДок1_8 = Новый QtDomДокумент()
    ДомДок1_8.РежимОтладки(Режим_Отладки)
    ДомДок1_8.setContentValue("<root/>")
    нулл1 = ДомДок1_8.isNullValue()
    нулл2 = ДомДок1_8.Пустой()
    ВывестиСтрокуВКонсоль("    isNullValue(): " + нулл1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Пустой(): " + нулл2 + " (ожидается false)")
    
    // ===== 9. ОЧИСТКА ОШИБКИ =====
    ДомДок1_9 = Новый QtDomДокумент()
    ДомДок1_9.РежимОтладки(Режим_Отладки)
    ДомДок1_9.setContentValue(некорректныйXml)
    ошибкаДо = ДомДок1_9.getLastErrorValue()
    ВывестиСтрокуВКонсоль("    Ошибка до очистки: " + ошибкаДо)
    ДомДок1_9.clearErrorValue()
    ошибкаПосле = ДомДок1_9.getLastErrorValue()
    строкаОшПосле = ДомДок1_9.getLastErrorLineValue()
    ВывестиСтрокуВКонсоль("    clearErrorValue() -> ошибка: '" + ошибкаПосле + "', строка: " + строкаОшПосле + " (ожидается '', 0)")
    
    // ===== 10. РУССКИЕ МЕТОДЫ =====
    ДомДок1_10 = Новый QtDomДокумент()
    ДомДок1_10.РежимОтладки(Режим_Отладки)
    xmlРус = "<?xml version='1.0'?><root><item>Тест</item></root>"
    результатРус = ДомДок1_10.УстановитьСодержимое(xmlРус)
    кореньРус = ДомДок1_10.КорневойЭлемент()
    ВывестиСтрокуВКонсоль("    УстановитьСодержимое(xml): " + результатРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    КорневойЭлемент(): " + (кореньРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 11. RUSFUNC =====
    Если typeof ДомДок1_1.RusFunc === 'function' Тогда
        jsonStr = ДомДок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtDomDocument (QtDomДокумент) завершён.===============================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonRpcКлиент()
//                  ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Подключиться                   │ connectToGateway               │
//│ 20 │ Отключиться                    │ disconnectFromGateway          │
//│ 21 │ Подключен                      │ isConnected                    │
//│ 22 │ ВызватьМетод                   │ callMethod                     │
//│ 23 │ ОтправитьУведомление           │ sendNotification               │
//│ 24 │ СоздатьСессию                  │ createSession                  │
//│ 25 │ СписокСессий                   │ listSessions                   │
//│ 26 │ АктивироватьСессию             │ activateSession                │
//│ 27 │ ЗакрытьСессию                  │ closeSession                   │
//│ 28 │ ОтправитьЗапрос                │ sendPrompt                     │
//│ 29 │ ПриУведомлении                 │ onNotification                 │
//│ 30 │ ПриОшибке                      │ onError                        │
//│ 31 │ ПриПодключении                 │ onConnectedEvent               │
//│ 32 │ ПриОтключении                  │ onDisconnectedEvent            │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonRpcClient (QtJsonRpcКлиент) - КОМПАКТНАЯ ВЕРСИЯ ========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    RpcКл1_1 = Новый QtJsonRpcКлиент()
    RpcКл1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПОДКЛЮЧЕН =====
    подключен = RpcКл1_1.Подключен()
    ВывестиСтрокуВКонсоль("    Подключен(): " + подключен + " (ожидается false)")
    
    // ===== 3. МЕТОДЫ УПРАВЛЕНИЯ =====
    ВывестиСтрокуВКонсоль("    Подключиться(): " + (typeof RpcКл1_1.Подключиться === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    ВывестиСтрокуВКонсоль("    Отключиться(): " + (typeof RpcКл1_1.Отключиться === 'function' ? "ДОСТУПЕН" : "НЕ ДОСТУПЕН"))
    
    // ===== 4. ВЫЗОВ МЕТОДА =====
    колбэк = function(success, error, result) {}
    id1 = RpcКл1_1.ВызватьМетод("test.method", null, колбэк)
    ВывестиСтрокуВКонсоль("    ВызватьМетод('test.method') без подключения: " + id1 + " (ожидается -1)")
    
    // ===== 5. УВЕДОМЛЕНИЕ =====
    Попытка
        RpcКл1_1.ОтправитьУведомление("test.notification", null)
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    ОтправитьУведомление(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 6. СЕССИИ =====
    колбэкСессия = function(success, error, result) {}
    id2 = RpcКл1_1.СоздатьСессию(колбэкСессия)
    ВывестиСтрокуВКонсоль("    СоздатьСессию(): " + id2 + " (ожидается -1)")
    
    id3 = RpcКл1_1.СписокСессий(колбэкСессия)
    ВывестиСтрокуВКонсоль("    СписокСессий(): " + id3 + " (ожидается -1)")
    
    // ===== 7. СЕССИИ С ПАРАМЕТРАМИ =====
    id4 = RpcКл1_1.АктивироватьСессию("test-session-id", колбэкСессия)
    ВывестиСтрокуВКонсоль("    АктивироватьСессию(): " + id4 + " (ожидается -1)")
    
    id5 = RpcКл1_1.ЗакрытьСессию("test-session-id", колбэкСессия)
    ВывестиСтрокуВКонсоль("    ЗакрытьСессию(): " + id5 + " (ожидается -1)")
    
    id6 = RpcКл1_1.ОтправитьЗапрос("test-session-id", "test message", колбэкСессия)
    ВывестиСтрокуВКонсоль("    ОтправитьЗапрос(): " + id6 + " (ожидается -1)")
    
    // ===== 8. КОЛБЭКИ =====
    Попытка
        RpcКл1_1.ПриУведомлении(function(method, params) {})
        RpcКл1_1.ПриОшибке(function(error) {})
        RpcКл1_1.ПриПодключении(function() {})
        RpcКл1_1.ПриОтключении(function() {})
        ВывестиСтрокуВКонсоль("    ПриУведомлении(), ПриОшибке(), ПриПодключении(), ПриОтключении(): УСПЕШНО")
    Исключение
        ВывестиСтрокуВКонсоль("    Колбэки: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 9. ОТКЛЮЧЕНИЕ =====
    Попытка
        RpcКл1_1.Отключиться()
        подключен2 = RpcКл1_1.Подключен()
        ВывестиСтрокуВКонсоль("    Отключиться() -> Подключен(): " + подключен2 + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отключиться(): ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 10. RUSFUNC =====
    Если typeof RpcКл1_1.RusFunc === 'function' Тогда
        jsonStr = RpcКл1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtJsonRpcClient (QtJsonRpcКлиент) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonДокумент()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────────┬─────────────────────────────────┐
//│  №  │ Русский метод                        │ Английский метод                 │
//├─────┼──────────────────────────────────────┼─────────────────────────────────┤
//│ 1 │ Действителен                         │ isValid                         │
//│ 2 │ ПолучитьОбъект                       │ getRealObject                   │
//│ 3 │ УстановитьРодителя                   │ setParentWrapper                │
//│ 4 │ ПолучитьРодителя                     │ getParentWrapper                │
//│ 5 │ УстановитьИмяОбъекта                 │ setObjectName                   │
//│ 6 │ ИмяОбъекта                           │ objectName                      │
//│ 7 │ УстановитьСвойство                   │ setProperty                     │
//│ 8 │ Свойство                             │ property                        │
//│ 9 │ ПодключитьСигнал                     │ connectSignal                   │
//│ 10 │ ОтключитьСигнал                      │ disconnectSignal                │
//│ 11 │ КопироватьВ                          │ copyTo                          │
//│ 12 │ РежимОтладки                         │ setDebug                        │
//│ 13 │ ПолучитьРежимОтладки                 │ getDebug                        │
//│ 14 │ ПолучитьТипКласса                    │ getClassType                    │
//│ 15 │ УстановитьТипКласса                  │ setClassType                    │
//│ 16 │ ПолучитьИмяКласса                    │ getClassName                    │
//│ 17 │ УстановитьИмяКласса                  │ setClassName                    │
//│ 18 │ ПолучитьСписокМетодов                │ RusFunc                         │
//│ 19 │ ЗагрузитьИзСтроки                    │ fromJsonValue                   │
//│ 20 │ ЗагрузитьИзФайла                     │ fromJsonFileValue               │
//│ 21 │ ЗагрузитьИзVariant                   │ fromVariantValue                │
//│ 22 │ ВJson                                │ toJsonValue                     │
//│ 23 │ ВJsonСтроку                          │ toJsonStringValue               │
//│ 24 │ ВVariant                             │ toVariantValue                  │
//│ 25 │ ВJsValue                             │ toJsValue                       │
//│ 26 │ СохранитьВФайл                       │ saveToFileValue                 │
//│ 27 │ ЭтоОбъект                            │ isObjectValue                   │
//│ 28 │ ЭтоМассив                            │ isArrayValue                    │
//│ 29 │ Пустой                               │ isEmptyValue                    │
//│ 30 │ Нулевой                              │ isNullValue                     │
//│ 31 │ Объект                               │ objectValue                     │
//│ 32 │ Массив                               │ arrayValue                      │
//│ 33 │ РазмерМассива                        │ arraySizeValue                  │
//│ 34 │ ПолучитьСтроку                       │ getStringValue                  │
//│ 35 │ ПолучитьЧисло                        │ getIntValue                     │
//│ 36 │ ПолучитьДробь                        │ getDoubleValue                  │
//│ 37 │ ПолучитьЛогику                       │ getBoolValue                    │
//│ 38 │ ПолучитьЗначение                     │ getValueValue                   │
//│ 39 │ ПолучитьЭлементМассива               │ getArrayItemValue               │
//│ 40 │ УстановитьОбъект                     │ setObjectValue                  │
//│ 41 │ УстановитьМассив                     │ setArrayValue                   │
//│ 42 │ УстановитьПустой                     │ setEmptyValue                   │
//│ 43 │ СоздатьОбъект                        │ createObjectValue               │
//│ 44 │ СоздатьМассив                        │ createArrayValue                │
//│ 45 │ ПоследняяОшибка                      │ getLastErrorValue               │
//│ 46 │ КодОшибки                            │ getErrorCodeValue               │
//│ 47 │ ПозицияОшибки                        │ getErrorOffsetValue             │
//│ 48 │ ОчиститьОшибку                       │ clearErrorValue                 │
//│ 49 │ ПолучитьДокумент                     │ getDocumentValue                │
//│ 50 │ ПолучитьDoc                          │ getDocumentObject               │
//│ 51 │ СОтступами                           │ Indented                        │
//│ 52 │ Компактный                           │ Compact                         │
//│ 53 │ НетОшибки                            │ ParseErrorNoError               │
//│ 54 │ НезавершенныйОбъект                  │ ParseErrorUnterminatedObject    │
//│ 55 │ ОтсутствуетРазделительИмени          │ ParseErrorMissingNameSeparator  │
//│ 56 │ НезавершенныйМассив                  │ ParseErrorUnterminatedArray     │
//│ 57 │ ОтсутствуетРазделительЗначений       │ ParseErrorMissingValueSeparator │
//│ 58 │ НедопустимоеЗначение                 │ ParseErrorIllegalValue          │
//│ 59 │ ЗавершениеЧислом                     │ ParseErrorTerminationByNumber   │
//│ 60 │ НедопустимоеЧисло                    │ ParseErrorIllegalNumber         │
//│ 61 │ НедопустимаяEscapeПоследовательность │ ParseErrorIllegalEscapeSequence │
//│ 62 │ НедопустимаяUTF8Строка               │ ParseErrorIllegalUTF8String     │
//│ 63 │ НезавершеннаяСтрока                  │ ParseErrorUnterminatedString    │
//│ 64 │ ОтсутствуетОбъект                    │ ParseErrorMissingObject         │
//│ 65 │ ГлубокаяВложенность                  │ ParseErrorDeepNesting           │
//│ 66 │ ДокументСлишкомБольшой               │ ParseErrorDocumentTooLarge      │
//│ 67 │ МусорВКонце                          │ ParseErrorGarbageAtEnd          │
//└─────┴──────────────────────────────────────┴─────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonDocument (QtJsonДокумент) - КОМПАКТНАЯ ВЕРСИЯ ===========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    JSON1_1 = Новый QtJsonДокумент()
    JSON1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. КОНСТАНТЫ ФОРМАТОВ =====
    инд = JSON1_1.Indented()
    комп = JSON1_1.Compact()
    ВывестиСтрокуВКонсоль("    Indented(): " + инд + ", Compact(): " + комп + " (значения разные)")
    
    // ===== 3. ЗАГРУЗКА JSON =====
    JSON1_2 = Новый QtJsonДокумент()
    JSON1_2.РежимОтладки(Режим_Отладки)
    json = '{"name":"Иван","age":30,"active":true}'
    результат = JSON1_2.fromJsonValue(json)
    строкаJson = JSON1_2.toJsonStringValue()
    ВывестиСтрокуВКонсоль("    fromJsonValue(): " + результат + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    toJsonStringValue(): " + строкаJson)
    
    // ===== 4. НЕКОРРЕКТНЫЙ JSON =====
    JSON1_3 = Новый QtJsonДокумент()
    JSON1_3.РежимОтладки(Режим_Отладки)
    некорректныйJson = '{"name":"Иван","age":30,}'
    результатОш = JSON1_3.fromJsonValue(некорректныйJson)
    ошибка = JSON1_3.getLastErrorValue()
    кодОш = JSON1_3.getErrorCodeValue()
    ВывестиСтрокуВКонсоль("    fromJsonValue(некорректный): " + результатОш + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    getLastErrorValue(): " + ошибка)
    ВывестиСтрокуВКонсоль("    getErrorCodeValue(): " + кодОш)
    
    // ===== 5. ПОЛУЧЕНИЕ ДАННЫХ =====
    JSON1_4 = Новый QtJsonДокумент()
    JSON1_4.РежимОтладки(Режим_Отладки)
    JSON1_4.fromJsonValue('{"name":"Иван","age":30,"active":true,"pi":3.14}')
    имя = JSON1_4.getStringValue("name")
    возраст = JSON1_4.getIntValue("age")
    активен = JSON1_4.getBoolValue("active")
    пи = JSON1_4.getDoubleValue("pi")
    ВывестиСтрокуВКонсоль("    getStringValue('name'): " + имя + " (ожидается Иван)")
    ВывестиСтрокуВКонсоль("    getIntValue('age'): " + возраст + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    getBoolValue('active'): " + активен + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    getDoubleValue('pi'): " + пи + " (ожидается 3.14)")
    
    // ===== 6. РАБОТА С МАССИВОМ =====
    JSON1_5 = Новый QtJsonДокумент()
    JSON1_5.РежимОтладки(Режим_Отладки)
    JSON1_5.fromJsonValue('["apple","banana","cherry"]')
    этоМассив = JSON1_5.isArrayValue()
    размер = JSON1_5.arraySizeValue()
    элемент1 = JSON1_5.getArrayItemValue(0)
    ВывестиСтрокуВКонсоль("    isArrayValue(): " + этоМассив + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    arraySizeValue(): " + размер + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getArrayItemValue(0): " + элемент1.toString() + " (ожидается apple)")
    
    // ===== 7. ПРОВЕРКА ТИПОВ =====
    JSON1_6 = Новый QtJsonДокумент()
    JSON1_6.РежимОтладки(Режим_Отладки)
    JSON1_6.fromJsonValue('{"key":"value"}')
    этоОб = JSON1_6.isObjectValue()
    этоМас2 = JSON1_6.isArrayValue()
    пусто = JSON1_6.isEmptyValue()
    нул = JSON1_6.isNullValue()
    ВывестиСтрокуВКонсоль("    isObjectValue(): " + этоОб + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    isArrayValue(): " + этоМас2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isEmptyValue(): " + пусто + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    isNullValue(): " + нул + " (ожидается false)")
    
    // ===== 8. СОЗДАНИЕ И УСТАНОВКА ОБЪЕКТА =====
    JSON1_7 = Новый QtJsonДокумент()
    JSON1_7.РежимОтладки(Режим_Отладки)
    JSON1_7.fromJsonValue('{"ключ":"значение","номер":123}')
    строкаJson2 = JSON1_7.toJsonStringValue()
    ВывестиСтрокуВКонсоль("    toJsonStringValue(): " + строкаJson2)
    
    // ===== 9. РАЗНЫЕ ФОРМАТЫ =====
    JSON1_8 = Новый QtJsonДокумент()
    JSON1_8.РежимОтладки(Режим_Отладки)
    JSON1_8.fromJsonValue('{"a":1,"b":2}')
    компактный = JSON1_8.toJsonStringValue(0)
    сОтступами = JSON1_8.toJsonStringValue(1)
    ВывестиСтрокуВКонсоль("    Compact (format=0): " + компактный)
    ВывестиСтрокуВКонсоль("    Indented (format=1): " + сОтступами)
    
    // ===== 10. РУССКИЕ МЕТОДЫ =====
    JSON1_9 = Новый QtJsonДокумент()
    JSON1_9.РежимОтладки(Режим_Отладки)
    jsonРус = '{"город":"Москва","население":12600000}'
    результатРус = JSON1_9.ЗагрузитьИзСтроки(jsonРус)
    город = JSON1_9.ПолучитьСтроку("город")
    население = JSON1_9.ПолучитьЧисло("население")
    строкаВывода = JSON1_9.ВJsonСтроку()
    ВывестиСтрокуВКонсоль("    ЗагрузитьИзСтроки(): " + результатРус + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку('город'): " + город + " (ожидается Москва)")
    ВывестиСтрокуВКонсоль("    ПолучитьЧисло('население'): " + население + " (ожидается 12600000)")
    ВывестиСтрокуВКонсоль("    ВJsonСтроку(): " + строкаВывода)
    
    // ===== 11. RUSFUNC =====
    Если typeof JSON1_1.RusFunc === 'function' Тогда
        jsonStr = JSON1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли

    ВывестиСтрокуВКонсоль("==== Тест QtJsonDocument (QtJsonДокумент) завершён.=============================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonМассив()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Добавить                       │ append                         │
//│ 20 │ ДобавитьСтроку                 │ appendString                   │
//│ 21 │ ДобавитьЧисло                  │ appendNumber                   │
//│ 22 │ ДобавитьЛогику                 │ appendBool                     │
//│ 23 │ ДобавитьОбъект                 │ appendObject                   │
//│ 24 │ ДобавитьМассив                 │ appendArray                    │
//│ 25 │ ДобавитьNull                   │ appendNull                     │
//│ 26 │ Вставить                       │ insert                         │
//│ 27 │ ВставитьСтроку                 │ insertString                   │
//│ 28 │ ВставитьЧисло                  │ insertNumber                   │
//│ 29 │ ВставитьЛогику                 │ insertBool                     │
//│ 30 │ ВставитьОбъект                 │ insertObject                   │
//│ 31 │ ВставитьМассив                 │ insertArray                    │
//│ 32 │ Получить                       │ getValue                       │
//│ 33 │ ПолучитьСтроку                 │ getString                      │
//│ 34 │ ПолучитьЧисло                  │ getNumber                      │
//│ 35 │ ПолучитьЛогику                 │ getBool                        │
//│ 36 │ ПолучитьОбъект                 │ getObject                      │
//│ 37 │ ПолучитьМассив                 │ getArray                       │
//│ 38 │ Установить                     │ setValue                       │
//│ 39 │ УстановитьСтроку               │ setString                      │
//│ 40 │ УстановитьЧисло                │ setNumber                      │
//│ 41 │ УстановитьЛогику               │ setBool                        │
//│ 42 │ УстановитьОбъект               │ setObject                      │
//│ 43 │ УстановитьМассив               │ setArray                       │
//│ 44 │ Удалить                        │ removeAt                       │
//│ 45 │ Очистить                       │ clear                          │
//│ 46 │ Количество                     │ count                          │
//│ 47 │ Размер                         │ size                           │
//│ 48 │ Пустой                         │ isEmpty                        │
//│ 49 │ Содержит                       │ contains                       │
//│ 50 │ СодержитСтроку                 │ containsString                 │
//│ 51 │ Найти                          │ indexOf                        │
//│ 52 │ НайтиСтроку                    │ indexOfString                  │
//│ 53 │ ВМассивVariant                 │ toVariantList                  │
//│ 54 │ ВJsonМассив                    │ toJsonArray                    │
//│ 55 │ ВСтроку                        │ toStringValue                  │
//│ 56 │ ВСтрокуСОтступами              │ toStringIndentedValue          │
//│ 57 │ Объединить                     │ concat                         │
//│ 58 │ ОбъединитьС                    │ concatFrom                     │
//│ 59 │ Вырезать                       │ slice                          │
//│ 60 │ Клонировать                    │ clone                          │
//│ 61 │ ИзСтроки                       │ fromString                     │
//│ 62 │ ИзVariantList                  │ fromVariantList                │
//│ 63 │ ПолучитьМассив                 │ getArray                       │
//│ 64 │ ПолучитьArray                  │ getArrayPtr                    │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonArray (QtJsonМассив) - КОМПАКТНАЯ ВЕРСИЯ ================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    JSONМасс1_1 = Новый QtJsonМассив()
    JSONМасс1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ МАССИВ =====
    кол1 = JSONМасс1_1.Размер()
    ВывестиСтрокуВКонсоль("    Размер(): " + кол1 + " (ожидается 0)")
    
    // ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ =====
    JSONМасс1_2 = Новый QtJsonМассив()
    JSONМасс1_2.РежимОтладки(Режим_Отладки)
    JSONМасс1_2.ДобавитьСтроку("Первый")
    JSONМасс1_2.ДобавитьСтроку("Второй")
    JSONМасс1_2.ДобавитьЧисло(42)
    JSONМасс1_2.ДобавитьЧисло(3.14)
    JSONМасс1_2.ДобавитьЛогику(ИСТИНА)
    JSONМасс1_2.ДобавитьNull()
    кол2 = JSONМасс1_2.Размер()
    ВывестиСтрокуВКонсоль("    ДобавитьСтроку('Первый'), ДобавитьСтроку('Второй'), ДобавитьЧисло(42), ДобавитьЧисло(3.14), ДобавитьЛогику(true), ДобавитьNull()")
    ВывестиСтрокуВКонсоль("    Размер(): " + кол2 + " (ожидается 6)")
    
    // ===== 4. ПОЛУЧЕНИЕ ЭЛЕМЕНТОВ =====
    JSONМасс1_3 = Новый QtJsonМассив()
    JSONМасс1_3.РежимОтладки(Режим_Отладки)
    JSONМасс1_3.ДобавитьСтроку("Тест")
    JSONМасс1_3.ДобавитьЧисло(123)
    JSONМасс1_3.ДобавитьЛогику(ИСТИНА)
    стр3 = JSONМасс1_3.ПолучитьСтроку(0)
    чис3 = JSONМасс1_3.ПолучитьЧисло(1)
    лог3 = JSONМасс1_3.ПолучитьЛогику(2)
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку(0): " + стр3 + " (ожидается Тест)")
    ВывестиСтрокуВКонсоль("    ПолучитьЧисло(1): " + чис3 + " (ожидается 123)")
    ВывестиСтрокуВКонсоль("    ПолучитьЛогику(2): " + лог3 + " (ожидается true)")
    
    // ===== 5. УСТАНОВКА ЭЛЕМЕНТОВ =====
    JSONМасс1_4 = Новый QtJsonМассив()
    JSONМасс1_4.РежимОтладки(Режим_Отладки)
    JSONМасс1_4.ДобавитьСтроку("Старое")
    JSONМасс1_4.ДобавитьЧисло(0)
    JSONМасс1_4.УстановитьСтроку(0, "Новое")
    JSONМасс1_4.УстановитьЧисло(1, 999)
    стр4 = JSONМасс1_4.ПолучитьСтроку(0)
    чис4 = JSONМасс1_4.ПолучитьЧисло(1)
    ВывестиСтрокуВКонсоль("    УстановитьСтроку(0,'Новое'), УстановитьЧисло(1,999)")
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку(0): " + стр4 + " (ожидается Новое)")
    ВывестиСтрокуВКонсоль("    ПолучитьЧисло(1): " + чис4 + " (ожидается 999)")
    
    // ===== 6. УДАЛЕНИЕ ЭЛЕМЕНТОВ =====
    JSONМасс1_5 = Новый QtJsonМассив()
    JSONМасс1_5.РежимОтладки(Режим_Отладки)
    JSONМасс1_5.ДобавитьСтроку("a")
    JSONМасс1_5.ДобавитьСтроку("b")
    JSONМасс1_5.ДобавитьСтроку("c")
    колДо = JSONМасс1_5.Размер()
    ВывестиСтрокуВКонсоль("    До удаления: Размер = " + колДо + " (ожидается 3)")
    JSONМасс1_5.removeAt(1)
    колПосле = JSONМасс1_5.Размер()
    стр5_0 = JSONМасс1_5.ПолучитьСтроку(0)
    стр5_1 = JSONМасс1_5.ПолучитьСтроку(1)
    ВывестиСтрокуВКонсоль("    removeAt(1) -> Размер: " + колПосле + " (ожидается 2)")
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку(0): " + стр5_0 + " (ожидается a)")
    ВывестиСтрокуВКонсоль("    ПолучитьСтроку(1): " + стр5_1 + " (ожидается c)")
    
    // ===== 7. ОЧИСТКА =====
    JSONМасс1_6 = Новый QtJsonМассив()
    JSONМасс1_6.РежимОтладки(Режим_Отладки)
    JSONМасс1_6.ДобавитьСтроку("a")
    JSONМасс1_6.ДобавитьСтроку("b")
    JSONМасс1_6.ДобавитьСтроку("c")
    колДо6 = JSONМасс1_6.Размер()
    ВывестиСтрокуВКонсоль("    До очистки: Размер = " + колДо6 + " (ожидается 3)")
    JSONМасс1_6.Очистить()
    колПосле6 = JSONМасс1_6.Размер()
    ВывестиСтрокуВКонсоль("    Очистить() -> Размер: " + колПосле6 + " (ожидается 0)")
    
    // ===== 8. ПРЕОБРАЗОВАНИЕ В СТРОКУ =====
    JSONМасс1_7 = Новый QtJsonМассив()
    JSONМасс1_7.РежимОтладки(Режим_Отладки)
    JSONМасс1_7.ДобавитьСтроку("a")
    JSONМасс1_7.ДобавитьЧисло(123)
    стр7_1 = JSONМасс1_7.ВСтроку()
    стр7_2 = JSONМасс1_7.ВСтрокуСОтступами()
    ВывестиСтрокуВКонсоль("    ВСтроку(): " + стр7_1)
    ВывестиСтрокуВКонсоль("    ВСтрокуСОтступами(): " + стр7_2)
    
    // ===== 9. КЛОНИРОВАНИЕ =====
    JSONМасс1_8 = Новый QtJsonМассив()
    JSONМасс1_8.РежимОтладки(Режим_Отладки)
    JSONМасс1_8.ДобавитьСтроку("original")
    клон = JSONМасс1_8.Клонировать()
    стр8 = клон.getString(0)
    ВывестиСтрокуВКонсоль("    Клонировать().getString(0): " + стр8 + " (ожидается original)")
    
    // ===== 10. СОЗДАНИЕ ИЗ СТРОКИ =====
    json = '["первый","второй",3,true]'
    JSONМасс1_9 = Новый QtJsonМассив()
    JSONМасс1_9.РежимОтладки(Режим_Отладки)
    JSONМасс1_9 = JSONМасс1_9.ИзСтроки(json)
    стр9_0 = JSONМасс1_9.getString(0)
    стр9_1 = JSONМасс1_9.getString(1)
    чис9 = JSONМасс1_9.getNumber(2)
    лог9 = JSONМасс1_9.getBool(3)
    ВывестиСтрокуВКонсоль("    ИзСтроки('" + json + "')")
    ВывестиСтрокуВКонсоль("    getString(0): " + стр9_0 + " (ожидается первый)")
    ВывестиСтрокуВКонсоль("    getString(1): " + стр9_1 + " (ожидается второй)")
    ВывестиСтрокуВКонсоль("    getNumber(2): " + чис9 + " (ожидается 3)")
    ВывестиСтрокуВКонсоль("    getBool(3): " + лог9 + " (ожидается true)")
    
    // ===== 11. RUSFUNC =====
    Если typeof JSONМасс1_1.RusFunc === 'function' Тогда
        jsonStr = JSONМасс1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtJsonArray (QtJsonМассив) завершён.==================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtJsonОбъект()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ВставитьСтроку                 │ InsertString                   │
//│ 20 │ ВставитьЧисло                  │ InsertNumber                   │
//│ 21 │ ВставитьЛогику                 │ InsertBool                     │
//│ 22 │ ВставитьNull                   │ InsertNull                     │
//│ 23 │ ВставитьОбъект                 │ InsertObject                   │
//│ 24 │ ВставитьМассив                 │ InsertArray                    │
//│ 25 │ ПолучитьСтроку                 │ GetString                      │
//│ 26 │ ПолучитьЧисло                  │ GetNumber                      │
//│ 27 │ ПолучитьЛогику                 │ GetBool                        │
//│ 28 │ ПолучитьОбъект                 │ GetObject                      │
//│ 29 │ ПолучитьМассив                 │ GetArray                       │
//│ 30 │ Содержит                       │ Contains                       │
//│ 31 │ Удалить                        │ Remove                         │
//│ 32 │ Очистить                       │ Clear                          │
//│ 33 │ Количество                     │ GetCount                       │
//│ 34 │ Пустой                         │ IsEmpty                        │
//│ 35 │ Ключи                          │ GetKeys                        │
//│ 36 │ ВVariantMap                    │ ToVariantMap                   │
//│ 37 │ ВJson                          │ ToJson                         │
//│ 38 │ ВСтроку                        │ ToString                       │
//│ 39 │ ВСтрокуСОтступами              │ ToStringIndented               │
//│ 40 │ Объединить                     │ Merge                          │
//│ 41 │ ОбъединитьС                    │ MergeWith                      │
//│ 42 │ Клонировать                    │ Clone                          │
//│ 43 │ ИзСтроки                       │ FromString                     │
//│ 44 │ ПолучитьОбъект                 │ getObject                      │
//│ 45 │ ПолучитьObject                 │ getObjectPtr                   │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtJsonObject (QtJsonОбъект) - КОМПАКТНАЯ ВЕРСИЯ ================")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    JSONОб1_1 = Новый QtJsonОбъект()
    JSONОб1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ПУСТОЙ ОБЪЕКТ =====
    кол = JSONОб1_1.GetCount()
    пусто = JSONОб1_1.IsEmpty()
    ключи = JSONОб1_1.GetKeys()
    ВывестиСтрокуВКонсоль("    GetCount(): " + кол + " (ожидается 0)")
    ВывестиСтрокуВКонсоль("    IsEmpty(): " + пусто + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    GetKeys(): " + ключи.join(", ") + " (ожидается пустой)")
    
    // ===== 3. ВСТАВКА И ПОЛУЧЕНИЕ ПРОСТЫХ ТИПОВ =====
    JSONОб1_2 = Новый QtJsonОбъект()
    JSONОб1_2.РежимОтладки(Режим_Отладки)
    JSONОб1_2.InsertString("name", "Иван")
    JSONОб1_2.InsertString("city", "Москва")
    JSONОб1_2.InsertNumber("age", 30)
    JSONОб1_2.InsertNumber("pi", 3.14)
    JSONОб1_2.InsertBool("active", ИСТИНА)
    JSONОб1_2.InsertBool("verified", ЛОЖЬ)
    JSONОб1_2.InsertNull("empty")
    имя = JSONОб1_2.GetString("name")
    город = JSONОб1_2.GetString("city")
    возраст = JSONОб1_2.GetNumber("age")
    пи = JSONОб1_2.GetNumber("pi")
    активен = JSONОб1_2.GetBool("active")
    проверен = JSONОб1_2.GetBool("verified")
    ВывестиСтрокуВКонсоль("    InsertString/InsertNumber/InsertBool/InsertNull")
    ВывестиСтрокуВКонсоль("    GetString('name'): " + имя + " (ожидается Иван)")
    ВывестиСтрокуВКонсоль("    GetString('city'): " + город + " (ожидается Москва)")
    ВывестиСтрокуВКонсоль("    GetNumber('age'): " + возраст + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    GetNumber('pi'): " + пи + " (ожидается 3.14)")
    ВывестиСтрокуВКонсоль("    GetBool('active'): " + активен + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    GetBool('verified'): " + проверен + " (ожидается false)")
    
     //===== 4. ВЛОЖЕННЫЕ ОБЪЕКТЫ =====
    JSONОб1_3 = Новый QtJsonОбъект()
    JSONОб1_3.РежимОтладки(Режим_Отладки)
    вложенный = Новый QtJsonОбъект()
    вложенный.InsertString("street", "Тверская")
    вложенный.InsertString("building", "15")
    вложенный.InsertNumber("floor", 5)
    JSONОб1_3.InsertObject("address", вложенный.ToJson())
    JSONОб1_3.InsertObject("work", вложенный.ToJson())
    адрес = JSONОб1_3.GetObject("address")
    улица = адрес.GetString("street")
    этаж = адрес.GetNumber("floor")
    работа = JSONОб1_3.GetObject("work")
    здание = работа.GetString("building")
    ВывестиСтрокуВКонсоль("    InsertObject/GetObject")
    ВывестиСтрокуВКонсоль("    address.street: " + улица + " (ожидается Тверская)")
    ВывестиСтрокуВКонсоль("    address.floor: " + этаж + " (ожидается 5)")
    ВывестиСтрокуВКонсоль("    work.building: " + здание + " (ожидается 15)")
    
    // ===== 5. ВЛОЖЕННЫЕ МАССИВЫ =====
    JSONОб1_4 = Новый QtJsonОбъект()
    JSONОб1_4.РежимОтладки(Режим_Отладки)
    массив12 = Новый QtJsonМассив()
    массив12.appendString("Первый")
    массив12.appendString("Второй")
    массив12.appendNumber(42)
    массив12.appendNumber(3.14)
    JSONОб1_4.InsertArray("items", массив12.toJsonArray())
    JSONОб1_4.InsertArray("values", массив12.toJsonArray())
    jsonStr = JSONОб1_4.ToString()
    jsonObj = JSON.parse(jsonStr)
    ВывестиСтрокуВКонсоль("    InsertArray/ToString")
    ВывестиСтрокуВКонсоль("    items[0]: " + jsonObj.items[0] + " (ожидается Первый)")
    ВывестиСтрокуВКонсоль("    items[1]: " + jsonObj.items[1] + " (ожидается Второй)")
    ВывестиСтрокуВКонсоль("    items[2]: " + jsonObj.items[2] + " (ожидается 42)")
    ВывестиСтрокуВКонсоль("    values[3]: " + jsonObj.values[3] + " (ожидается 3.14)")
    
    // ===== 6. CONTAINS =====
    JSONОб1_5 = Новый QtJsonОбъект()
    JSONОб1_5.РежимОтладки(Режим_Отладки)
    JSONОб1_5.InsertString("key1", "value1")
    JSONОб1_5.InsertString("key2", "value2")
    сод1 = JSONОб1_5.Contains("key1")
    сод2 = JSONОб1_5.Contains("key2")
    сод3 = JSONОб1_5.Contains("key3")
    ВывестиСтрокуВКонсоль("    Contains('key1'): " + сод1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Contains('key2'): " + сод2 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Contains('key3'): " + сод3 + " (ожидается false)")
    
    // ===== 7. GETKEYS =====
    JSONОб1_6 = Новый QtJsonОбъект()
    JSONОб1_6.РежимОтладки(Режим_Отладки)
    JSONОб1_6.InsertString("a", "1")
    JSONОб1_6.InsertString("b", "2")
    JSONОб1_6.InsertNumber("c", 3)
    ключи6 = JSONОб1_6.GetKeys()
    ключи6.sort()
    ВывестиСтрокуВКонсоль("    GetKeys(): " + ключи6.join(", ") + " (ожидается a, b, c)")
    
    // ===== 8. REMOVE =====
    JSONОб1_7 = Новый QtJsonОбъект()
    JSONОб1_7.РежимОтладки(Режим_Отладки)
    JSONОб1_7.InsertString("a", "1")
    JSONОб1_7.InsertString("b", "2")
    JSONОб1_7.InsertNumber("c", 3)
    колДо = JSONОб1_7.GetCount()
    ВывестиСтрокуВКонсоль("    До удаления: GetCount = " + колДо + " (ожидается 3)")
    JSONОб1_7.Remove("b")
    JSONОб1_7.Remove("c")
    колПосле = JSONОб1_7.GetCount()
    содA = JSONОб1_7.Contains("a")
    содB = JSONОб1_7.Contains("b")
    содC = JSONОб1_7.Contains("c")
    ВывестиСтрокуВКонсоль("    Remove('b'), Remove('c')")
    ВывестиСтрокуВКонсоль("    После удаления: GetCount = " + колПосле + " (ожидается 1)")
    ВывестиСтрокуВКонсоль("    Contains('a'): " + содA + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Contains('b'): " + содB + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Contains('c'): " + содC + " (ожидается false)")
    
    // ===== 9. CLEAR =====
    JSONОб1_8 = Новый QtJsonОбъект()
    JSONОб1_8.РежимОтладки(Режим_Отладки)
    JSONОб1_8.InsertString("a", "1")
    JSONОб1_8.InsertString("b", "2")
    JSONОб1_8.InsertNumber("c", 3)
    JSONОб1_8.Clear()
    колПосле1 = JSONОб1_8.GetCount()
    пусто1 = JSONОб1_8.IsEmpty()
    ВывестиСтрокуВКонсоль("    Clear() -> GetCount: " + колПосле1 + " (ожидается 0), IsEmpty: " + пусто1 + " (ожидается true)")
    JSONОб1_8.InsertString("d", "4")
    JSONОб1_8.Clear()
    колПосле2 = JSONОб1_8.GetCount()
    пусто2 = JSONОб1_8.IsEmpty()
    ВывестиСтрокуВКонсоль("    Повторный Clear() -> GetCount: " + колПосле2 + " (ожидается 0), IsEmpty: " + пусто2 + " (ожидается true)")
    
    // ===== 10. TOSTRING =====
    JSONОб1_9 = Новый QtJsonОбъект()
    JSONОб1_9.РежимОтладки(Режим_Отладки)
    JSONОб1_9.InsertString("name", "Тест")
    JSONОб1_9.InsertNumber("value", 123)
    строка1 = JSONОб1_9.ToString()
    строка2 = JSONОб1_9.ToStringIndented()
    ВывестиСтрокуВКонсоль("    ToString(): " + строка1)
    ВывестиСтрокуВКонсоль("    ToStringIndented(): " + строка2)
    
    // ===== 11. CLONE =====
    JSONОб1_10 = Новый QtJsonОбъект()
    JSONОб1_10.РежимОтладки(Режим_Отладки)
    JSONОб1_10.InsertString("original", "value")
    клон = JSONОб1_10.Clone()
    стрКлон = клон.GetString("original")
    ВывестиСтрокуВКонсоль("    Clone().GetString('original'): " + стрКлон + " (ожидается value)")
    
    // ===== 12. FROMSTRING =====
    json = '{"name":"Иван","age":30,"active":true}'
    JSONОб1_11 = Новый QtJsonОбъект()
    JSONОб1_11.РежимОтладки(Режим_Отладки)
    JSONОб1_11 = JSONОб1_11.FromString(json)
    имяФ = JSONОб1_11.GetString("name")
    возрастФ = JSONОб1_11.GetNumber("age")
    активенФ = JSONОб1_11.GetBool("active")
    ВывестиСтрокуВКонсоль("    FromString('" + json + "')")
    ВывестиСтрокуВКонсоль("    GetString('name'): " + имяФ + " (ожидается Иван)")
    ВывестиСтрокуВКонсоль("    GetNumber('age'): " + возрастФ + " (ожидается 30)")
    ВывестиСтрокуВКонсоль("    GetBool('active'): " + активенФ + " (ожидается true)")
    
    // ===== 13. MERGE =====
    JSONОб1_12 = Новый QtJsonОбъект()
    JSONОб1_12.РежимОтладки(Режим_Отладки)
    JSONОб1_13 = Новый QtJsonОбъект()
    JSONОб1_13.РежимОтладки(Режим_Отладки)
    JSONОб1_12.InsertString("a", "1")
    JSONОб1_12.InsertNumber("b", 2)
    JSONОб1_13.InsertString("c", "3")
    JSONОб1_13.InsertNumber("d", 4)
    объединенный = JSONОб1_12.Merge(JSONОб1_13)
    стрМ1 = объединенный.GetString("a")
    стрМ2 = объединенный.GetString("c")
    ВывестиСтрокуВКонсоль("    Merge() -> a: " + стрМ1 + ", c: " + стрМ2)
    JSONОб1_12.MergeWith(JSONОб1_13)
    стрМ3 = JSONОб1_12.GetString("a")
    стрМ4 = JSONОб1_12.GetString("c")
    ВывестиСтрокуВКонсоль("    MergeWith() -> a: " + стрМ3 + ", c: " + стрМ4)
    
    // ===== 14. RUSFUNC =====
    Если typeof JSONОб1_1.RusFunc === 'function' Тогда
        jsonStr = JSONОб1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли

    ВывестиСтрокуВКонсоль("==== Тест QtJsonObject (QtJsonОбъект) завершён.=================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtXmlЧитатель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬──────────────────────────────────────────┬──────────────────────────────────┐
//│  №  │ Русский метод                            │ Английский метод                  │
//├─────┼──────────────────────────────────────────┼──────────────────────────────────┤
//│ 1 │ Действителен                             │ isValid                          │
//│ 2 │ ПолучитьОбъект                           │ getRealObject                    │
//│ 3 │ УстановитьРодителя                       │ setParentWrapper                 │
//│ 4 │ ПолучитьРодителя                         │ getParentWrapper                 │
//│ 5 │ УстановитьИмяОбъекта                     │ setObjectName                    │
//│ 6 │ ИмяОбъекта                               │ objectName                       │
//│ 7 │ УстановитьСвойство                       │ setProperty                      │
//│ 8 │ Свойство                                 │ property                         │
//│ 9 │ ПодключитьСигнал                         │ connectSignal                    │
//│ 10 │ ОтключитьСигнал                          │ disconnectSignal                 │
//│ 11 │ КопироватьВ                              │ copyTo                           │
//│ 12 │ РежимОтладки                             │ setDebug                         │
//│ 13 │ ПолучитьРежимОтладки                     │ getDebug                         │
//│ 14 │ ПолучитьТипКласса                        │ getClassType                     │
//│ 15 │ УстановитьТипКласса                      │ setClassType                     │
//│ 16 │ ПолучитьИмяКласса                        │ getClassName                     │
//│ 17 │ УстановитьИмяКласса                      │ setClassName                     │
//│ 18 │ ПолучитьСписокМетодов                    │ RusFunc                          │
//│ 19 │ УстановитьУстройство                     │ setDeviceValue                   │
//│ 20 │ ПолучитьУстройство                       │ getDeviceValue                   │
//│ 21 │ ДобавитьДанные                           │ addDataValue                     │
//│ 22 │ ДобавитьДанныеСтрокой                    │ addDataStringValue               │
//│ 23 │ Очистить                                 │ clearValue                       │
//│ 24 │ ПрочитатьСледующий                       │ readNextValue                    │
//│ 25 │ ПрочитатьСледующийЭлемент                │ readNextStartElementValue        │
//│ 26 │ ПропуститьТекущийЭлемент                 │ skipCurrentElementValue          │
//│ 27 │ ВызватьОшибку                            │ raiseErrorValue                  │
//│ 28 │ ТипТокена                                │ tokenTypeValue                   │
//│ 29 │ ТипТокенаСтрокой                         │ tokenStringValue                 │
//│ 30 │ НачалоЭлемента                           │ isStartElementValue              │
//│ 31 │ КонецЭлемента                            │ isEndElementValue                │
//│ 32 │ Текст                                    │ isCharactersValue                │
//│ 33 │ Пробелы                                  │ isWhitespaceValue                │
//│ 34 │ Комментарий                              │ isCommentValue                   │
//│ 35 │ DTD                                      │ isDTDValue                       │
//│ 36 │ СсылкаНаСущность                         │ isEntityReferenceValue           │
//│ 37 │ ИнструкцияОбработки                      │ isProcessingInstructionValue     │
//│ 38 │ ВКонце                                   │ atEndValue                       │
//│ 39 │ ЕстьОшибка                               │ hasErrorValue                    │
//│ 40 │ Имя                                      │ nameValue                        │
//│ 41 │ КвалифицированноеИмя                     │ qualifiedNameValue               │
//│ 42 │ URIПространстваИмён                      │ namespaceUriValue                │
//│ 43 │ Префикс                                  │ prefixValue                      │
//│ 44 │ Текст                                    │ textValue                        │
//│ 45 │ ТекстТокена                              │ tokenTextValue                   │
//│ 46 │ ЕстьАтрибуты                             │ hasAttributesValue               │
//│ 47 │ КоличествоАтрибутов                      │ attributesCountValue             │
//│ 48 │ ПолучитьАтрибут                          │ getAttributeValue                │
//│ 49 │ ПолучитьАтрибутПоИмени                   │ getAttributeValueByName          │
//│ 50 │ ПолучитьАтрибутПоКвалифицированномуИмени │ getAttributeValueByQualifiedName │
//│ 51 │ ПолучитьАтрибутПоПространству            │ getAttributeValueByNs            │
//│ 52 │ ПолучитьВсеАтрибуты                      │ getAllAttributesValue            │
//│ 53 │ ЕстьОбъявленияПространств                │ hasNamespaceDeclarationsValue    │
//│ 54 │ КоличествоОбъявленийПространств          │ namespaceDeclarationsCountValue  │
//│ 55 │ ПолучитьОбъявлениеПространства           │ getNamespaceDeclarationValue     │
//│ 56 │ ОшибкаСтрокой                            │ getErrorStringValue              │
//│ 57 │ КодОшибки                                │ getErrorValue                    │
//│ 58 │ НомерСтроки                              │ getLineNumberValue               │
//│ 59 │ НомерКолонки                             │ getColumnNumberValue             │
//│ 60 │ Смещение                                 │ getCharacterOffsetValue          │
//│ 61 │ ПолучитьЧитатель                         │ getReader                        │
//│ 62 │ НетТокена                                │ NoToken                          │
//│ 63 │ Неверный                                 │ Invalid                          │
//│ 64 │ НачалоДокумента                          │ StartDocument                    │
//│ 65 │ КонецДокумента                           │ EndDocument                      │
//│ 66 │ НачалоЭлемента                           │ StartElement                     │
//│ 67 │ КонецЭлемента                            │ EndElement                       │
//│ 68 │ Текст                                    │ Characters                       │
//│ 69 │ Комментарий                              │ Comment                          │
//│ 70 │ DTD                                      │ DTD                              │
//│ 71 │ СсылкаНаСущность                         │ EntityReference                  │
//│ 72 │ ИнструкцияОбработки                      │ ProcessingInstruction            │
//│ 73 │ НетОшибки                                │ NoError                          │
//│ 74 │ ПользовательскаяОшибка                   │ CustomError                      │
//│ 75 │ ПреждевременныйКонецДокумента            │ PrematureEndOfDocumentError      │
//│ 76 │ НеожиданныйЭлемент                       │ UnexpectedElementError           │
//│ 77 │ НеWellFormed                             │ NotWellFormedError               │
//└─────┴──────────────────────────────────────────┴──────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtXmlStreamReader (QtXmlЧитатель) - КОМПАКТНАЯ ВЕРСИЯ ========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Писат1_1 = Новый QtXmlЧитатель()
    Писат1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. ДОБАВЛЕНИЕ ДАННЫХ =====
    Писат1_2 = Новый QtXmlЧитатель()
    Писат1_2.РежимОтладки(Режим_Отладки)
    Писат1_2.addDataValue("<root>")
    Писат1_2.ДобавитьДанныеСтрокой("<child>Текст</child>")
    Писат1_2.addDataValue("</root>")
    ВывестиСтрокуВКонсоль("    addDataValue/ДобавитьДанныеСтрокой: УСПЕШНО")
    
    // ===== 3. КОНСТАНТЫ ТИПОВ ТОКЕНОВ =====
    нет = 0
    невер = 1
    стартДок = 2
    конецДок = 3
    стартЭл = 4
    конецЭл = 5
    текст = 6
    коммент = 7
    dtd = 8
    ссылка = 9
    инстр = 10
    ВывестиСтрокуВКонсоль("    NoToken: " + нет + ", Invalid: " + невер + ", StartDocument: " + стартДок)
    ВывестиСтрокуВКонсоль("    EndDocument: " + конецДок + ", StartElement: " + стартЭл + ", EndElement: " + конецЭл)
    ВывестиСтрокуВКонсоль("    Characters: " + текст + ", Comment: " + коммент + ", DTD: " + dtd)
    ВывестиСтрокуВКонсоль("    EntityReference: " + ссылка + ", ProcessingInstruction: " + инстр)
    
    // ===== 4. КОНСТАНТЫ ОШИБОК =====
    нетОш = 0
    пользОш = 1
    преждеврем = 2
    неожЭл = 3
    неWell = 4
    ВывестиСтрокуВКонсоль("    NoError: " + нетОш + ", CustomError: " + пользОш + ", PrematureEndOfDocumentError: " + преждеврем)
    ВывестиСтрокуВКонсоль("    UnexpectedElementError: " + неожЭл + ", NotWellFormedError: " + неWell)
    
    // ===== 5. ЧТЕНИЕ XML =====
    Писат1_3 = Новый QtXmlЧитатель()
    Писат1_3.РежимОтладки(Режим_Отладки)
    Писат1_3.addDataValue("<?xml version='1.0'?><root><item id='1'>Значение</item></root>")
    Писат1_3.readNextValue()
    Писат1_3.readNextStartElementValue()
    имяRoot = Писат1_3.nameValue()
    isStart = Писат1_3.isStartElementValue()
    ВывестиСтрокуВКонсоль("    readNextStartElementValue -> nameValue(): " + имяRoot + ", isStartElementValue(): " + isStart)
    Писат1_3.readNextStartElementValue()
    имяДочер = Писат1_3.nameValue()
    текстДочер = Писат1_3.textValue()
    ВывестиСтрокуВКонсоль("    Дочерний: nameValue(): " + имяДочер + ", textValue(): " + текстДочер)
    естьАтр = Писат1_3.hasAttributesValue()
    колАтр = Писат1_3.attributesCountValue()
    атр1 = Писат1_3.getAttributeValueByName("id")
    ВывестиСтрокуВКонсоль("    hasAttributesValue(): " + естьАтр + ", attributesCountValue(): " + колАтр + ", getAttributeValueByName('id'): " + атр1)
    
    // ===== 6. РАБОТА С АТРИБУТАМИ =====
    Писат1_4 = Новый QtXmlЧитатель()
    Писат1_4.РежимОтладки(Режим_Отладки)
    Писат1_4.addDataValue("<book title='Война и мир' author='Толстой' year='1869'/>")
    Писат1_4.readNextStartElementValue()
    знач0 = Писат1_4.getAttributeValueByName("title")
    знач1 = Писат1_4.getAttributeValueByName("author")
    знач2 = Писат1_4.getAttributeValueByName("year")
    ВывестиСтрокуВКонсоль("    getAttributeValueByName('title'): " + знач0 + " (ожидается Война и мир)")
    ВывестиСтрокуВКонсоль("    getAttributeValueByName('author'): " + знач1 + " (ожидается Толстой)")
    ВывестиСтрокуВКонсоль("    getAttributeValueByName('year'): " + знач2 + " (ожидается 1869)")
    
    // ===== 7. ПРОВЕРКА СОСТОЯНИЙ =====
    Писат1_5 = Новый QtXmlЧитатель()
    Писат1_5.РежимОтладки(Режим_Отладки)
    Писат1_5.addDataValue("<root/>")
    вКонце1 = Писат1_5.atEndValue()
    естьОш1 = Писат1_5.hasErrorValue()
    ВывестиСтрокуВКонсоль("    До чтения: atEndValue(): " + вКонце1 + ", hasErrorValue(): " + естьОш1)
    Писат1_5.readNextStartElementValue()
    вКонце2 = Писат1_5.atEndValue()
    естьОш2 = Писат1_5.hasErrorValue()
    ВывестиСтрокуВКонсоль("    После чтения: atEndValue(): " + вКонце2 + ", hasErrorValue(): " + естьОш2)
    
    // ===== 8. ОБРАБОТКА ОШИБОК =====
    Писат1_6 = Новый QtXmlЧитатель()
    Писат1_6.РежимОтладки(Режим_Отладки)
    Писат1_6.raiseErrorValue("Тестовая ошибка")
    Писат1_6.ВызватьОшибку("Ещё одна ошибка")
    ошСтр = Писат1_6.getErrorStringValue()
    кодОш = Писат1_6.getErrorValue()
    ВывестиСтрокуВКонсоль("    raiseErrorValue/ВызватьОшибку -> getErrorStringValue(): " + ошСтр + ", getErrorValue(): " + кодОш + " (ожидается > 0)")
    
    // ===== 9. ПОЛУЧЕНИЕ ПОЗИЦИИ =====
    Писат1_7 = Новый QtXmlЧитатель()
    Писат1_7.РежимОтладки(Режим_Отладки)
    Писат1_7.addDataValue("<root>\n  <item>\n    Текст\n  </item>\n</root>")
    Писат1_7.readNextStartElementValue()
    строка = Писат1_7.getLineNumberValue()
    колонка = Писат1_7.getColumnNumberValue()
    ВывестиСтрокуВКонсоль("    getLineNumberValue(): " + строка + ", getColumnNumberValue(): " + колонка + " (ожидается > 0)")
    
    // ===== 10. РАБОТА С РУССКИМИ МЕТОДАМИ =====
    Писат1_8 = Новый QtXmlЧитатель()
    Писат1_8.РежимОтладки(Режим_Отладки)
    Писат1_8.addDataValue("<тест>содержимое</тест>")
    Писат1_8.readNextStartElementValue()
    имяРус = Писат1_8.nameValue()
    ВывестиСтрокуВКонсоль("    nameValue() для русского тега: " + имяРус + " (ожидается тест)")
    
    // ===== 11. RUSFUNC =====
    Если typeof Писат1_1.RusFunc === 'function' Тогда
        jsonStr = Писат1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtXmlStreamReader (QtXmlЧитатель) завершён.==========================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtXmlПисатель()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ Запустить                      │ startThread                    │
//│ 20 │ ЗапуститьСКолбэком             │ startWithCallback              │
//│ 21 │ ЗапуститьСФункцией             │ startWithFunction              │
//│ 22 │ Остановить                     │ quitThread                     │
//│ 23 │ Ожидать                        │ waitThread                     │
//│ 24 │ ОжидатьМс                      │ waitThreadMs                   │
//│ 25 │ Запущен                        │ isRunningThread                │
//│ 26 │ Завершён                       │ isFinishedThread               │
//│ 27 │ УровеньЦикла                   │ loopLevel                      │
//│ 28 │ ЦиклСобытий                    │ eventLoop                      │
//│ 29 │ Приоритет                      │ getPriority                    │
//│ 30 │ УстановитьПриоритет            │ setPriority                    │
//│ 31 │ Спать                          │ sleepThread                    │
//│ 32 │ СпатьМс                        │ msleepThread                   │
//│ 33 │ СпатьМкс                       │ usleepThread                   │
//│ 34 │ ЗапроситьПрерывание            │ requestInterruption            │
//│ 35 │ ПрерываниеЗапрошено            │ isInterruptionRequested        │
//│ 36 │ УстановитьРазмерСтека          │ setStackSize                   │
//│ 37 │ РазмерСтека                    │ getStackSize                   │
//│ 38 │ ИдеальноеКоличествоПотоков     │ getIdealThreadCount            │
//│ 39 │ УступитьВремя                  │ yieldCurrentThread             │
//│ 40 │ ТекущийПоток                   │ currentThread                  │
//│ 41 │ Действителен                   │ isValid                        │
//│ 42 │ ПолучитьПоток                  │ getRealThread                  │
//│ 43 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 44 │ КопироватьВ                    │ copyTo                         │
//│ 45 │ РежимОтладки                   │ setDebug                       │
//│ 46 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 47 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 48 │ ИмяОбъекта                     │ objectName                     │
//│ 49 │ ПриоритетХолостой              │ IdlePriority                   │
//│ 50 │ ПриоритетСамыйНизкий           │ LowestPriority                 │
//│ 51 │ ПриоритетНизкий                │ LowPriority                    │
//│ 52 │ ПриоритетНормальный            │ NormalPriority                 │
//│ 53 │ ПриоритетВысокий               │ HighPriority                   │
//│ 54 │ ПриоритетСамыйВысокий          │ HighestPriority                │
//│ 55 │ ПриоритетВремениРеального      │ TimeCriticalPriority           │
//│ 56 │ ПриоритетИнверсии              │ InheritPriority                │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    //ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtXmlStreamWriter (QtXmlПисатель) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
     //===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Пис1_1 = Новый QtXmlПисатель()
    Пис1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    //// ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    валид = Пис1_1.isValid()
    валидРус = Пис1_1.Действителен()
    ВывестиСтрокуВКонсоль("    isValid(): " + валид + ", Действителен(): " + валидРус + " (ожидается true)")
    
    // ===== 3. УСТАНОВКА АВТОФОРМАТИРОВАНИЯ =====
    Попытка
        Пис1_1.УстановитьАвтоформатирование(true)
        авто = Пис1_1.ПолучитьАвтоформатирование()
        Пис1_1.УстановитьАвтоформатирование(false)
        автоРус = Пис1_1.ПолучитьАвтоформатирование()
        ВывестиСтрокуВКонсоль("    Автоформатирование: " + авто + " / " + автоРус)
    Исключение
        ВывестиСтрокуВКонсоль("    Автоформатирование: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 4. УСТАНОВКА ОТСТУПА =====
    Попытка
        Пис1_1.УстановитьОтступАвтоформатирования(4)
        отступ = Пис1_1.ПолучитьОтступАвтоформатирования()
        Пис1_1.УстановитьОтступАвтоформатирования(2)
        отступРус = Пис1_1.ПолучитьОтступАвтоформатирования()
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус + " (ожидается 4 / 2)")
    Исключение
        ВывестиСтрокуВКонсоль("    Отступы: ОШИБКА - " + e)
    КонецПопытки
    
    // ===== 5. ЗАПИСЬ ПРОСТОГО XML ДОКУМЕНТА =====
    Попытка
        п5 = Новый QtXmlПисатель()
        п5.РежимОтладки(Режим_Отладки)
        п5.УстановитьАвтоформатирование(ИСТИНА)
        п5.УстановитьОтступАвтоформатирования(2)
        
        п5.НачатьДокумент()
        п5.НачатьЭлемент("root")
        п5.НаписатьПустойЭлемент("empty")
        п5.НаписатьТекстовыйЭлемент("name", "value")
        п5.НаписатьТекстовыйЭлемент("русский", "текст")
        п5.ЗакончитьЭлемент()
        п5.ЗакончитьДокумент()
        
        результатСтрока5 = п5.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока5)
        
        Если результатСтрока5.indexOf("root") > -1 И результатСтрока5.indexOf("empty") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись простого XML документа работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись простого XML документа работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи XML: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 6. ЗАПИСЬ С АТРИБУТАМИ =====
    Попытка
        п6 = Новый QtXmlПисатель()
        п6.РежимОтладки(Режим_Отладки)
        
        п6.НачатьЭлемент("book")
        п6.НаписатьАтрибут("title", "Война и мир")
        п6.НаписатьАтрибут("author", "Толстой")
        п6.НаписатьАтрибут("year", "1869")
        п6.НаписатьТекст("Роман-эпопея")
        п6.ЗакончитьЭлемент()
        
        результатСтрока6 = п6.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи с атрибутами:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока6)
        
        Если результатСтрока6.indexOf("title") > -1 И результатСтрока6.indexOf("author") > -1 И результатСтрока6.indexOf("Война и мир") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись с атрибутами работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись с атрибутами работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи с атрибутами: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 7. ЗАПИСЬ CDATA И КОММЕНТАРИЕВ =====
    Попытка
        п7 = Новый QtXmlПисатель()
        п7.РежимОтладки(Режим_Отладки)
        
        п7.НачатьЭлемент("data")
        п7.НаписатьCDATA("<special> & \n text</special>")
        п7.НаписатьКомментарий("Это комментарий")
        п7.НаписатьКомментарий("Ещё один комментарий")
        п7.ЗакончитьЭлемент()
        
        результатСтрока7 = п7.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи CDATA и комментариев:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока7)
        
        Если результатСтрока7.indexOf("CDATA") > -1 И результатСтрока7.indexOf("комментарий") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись CDATA и комментариев работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись CDATA и комментариев работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи CDATA/комментариев: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 8. ЗАПИСЬ ИНСТРУКЦИЙ ОБРАБОТКИ =====
    Попытка
        п8 = Новый QtXmlПисатель()
        п8.РежимОтладки(Режим_Отладки)
        
        п8.НаписатьИнструкцию("xml-stylesheet", "type='text/xsl' href='style.xsl'")
        п8.НаписатьИнструкцию("php", "echo 'Hello';")
        п8.НачатьЭлемент("root")
        п8.ЗакончитьЭлемент()
        
        результатСтрока8 = п8.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи инструкций обработки:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока8)
        
        Если результатСтрока8.indexOf("xml-stylesheet") > -1 ИЛИ результатСтрока8.indexOf("php") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись инструкций обработки работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись инструкций обработки работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи инструкций обработки: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 9. ЗАПИСЬ DTD =====
    Попытка
        п9 = Новый QtXmlПисатель()
        п9.РежимОтладки(Режим_Отладки)
        
        п9.НаписатьDTD("<!DOCTYPE root [<!ELEMENT root ANY>]>")
        п9.НаписатьDTD("<!ENTITY author 'Толстой'>")
        п9.НачатьЭлемент("root")
        п9.ЗакончитьЭлемент()
        
        результатСтрока9 = п9.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи DTD:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока9)
        
        Если результатСтрока9.indexOf("DOCTYPE") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись DTD работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись DTD работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи DTD: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 10. ЗАПИСЬ С ПРОСТРАНСТВАМИ ИМЁН =====
    Попытка
        п10 = Новый QtXmlПисатель()
        п10.РежимОтладки(Режим_Отладки)
        
        п10.НачатьЭлементСПространством("http://example.com/ns", "ns:root")
        п10.НаписатьПространство("http://example.com/ns", "ns")
        п10.НаписатьПространство("http://example.com/ns2", "ns2")
        п10.НаписатьАтрибутСПространством("http://example.com/ns", "attr", "value")
        п10.ЗакончитьЭлемент()
        
        результатСтрока10 = п10.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи с пространствами имён:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока10)
        
        Если результатСтрока10.indexOf("xmlns:ns") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись с пространствами имён работает корректно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись с пространствами имён работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи с пространствами имён: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 11. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    Попытка
        реал = Пис1_1.ПолучитьПисатель()
        реалРус = Пис1_1.ПолучитьПисатель()
        ВывестиСтрокуВКонсоль("  ПолучитьПисатель(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН") + " / " + (реалРус != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    Исключение
        ВывестиСтрокуВКонсоль("  Получение реального объекта: ОШИБКА - " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 12. ИМЯ ОБЪЕКТА =====
    Попытка
        Пис1_1.УстановитьИмяОбъекта("MyXmlWriter")
        имя = Пис1_1.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("  ИмяОбъекта: " + имя + " (ожидается MyXmlWriter)")
    Исключение
        ВывестиСтрокуВКонсоль("  Имя объекта: ОШИБКА - " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ===== 13. РЕЖИМ ОТЛАДКИ =====
    имеетРежимОтладки = typeof Пис1_1.РежимОтладки === 'function'
    имеетПолучитьРежимОтладки = typeof Пис1_1.ПолучитьРежимОтладки === 'function'
    ВывестиСтрокуВКонсоль("  РежимОтладки(): " + (имеетРежимОтладки ? "✅" : "❌") + ", ПолучитьРежимОтладки(): " + (имеетПолучитьРежимОтладки ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("")
    
    // ===== 14. ПРОВЕРКА RUSFUNC =====
    Если typeof Пис1_1.RusFunc === 'function' Тогда
        jsonStr = Пис1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("  RusFunc(): " + карта.length + " методов")
        
        Если карта.length > 0 Тогда
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    ВывестиСтрокуВКонсоль("    " + (i+1) + ". " + карта[i].русскоеИмя + " -> " + карта[i].латинскоеИмя)
                КонецЕсли
            КонецЦикла
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("  RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    ВывестиСтрокуВКонсоль("")
    
    // ===== 15. ПРОВЕРКА НАЛИЧИЯ МЕТОДОВ =====
    ВывестиСтрокуВКонсоль("  Проверка наличия методов:")
    ВывестиСтрокуВКонсоль("    НачатьДокумент: " + (typeof Пис1_1.НачатьДокумент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ЗакончитьДокумент: " + (typeof Пис1_1.ЗакончитьДокумент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НачатьЭлемент: " + (typeof Пис1_1.НачатьЭлемент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ЗакончитьЭлемент: " + (typeof Пис1_1.ЗакончитьЭлемент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьПустойЭлемент: " + (typeof Пис1_1.НаписатьПустойЭлемент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьТекстовыйЭлемент: " + (typeof Пис1_1.НаписатьТекстовыйЭлемент === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьТекст: " + (typeof Пис1_1.НаписатьТекст === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьАтрибут: " + (typeof Пис1_1.НаписатьАтрибут === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьCDATA: " + (typeof Пис1_1.НаписатьCDATA === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьКомментарий: " + (typeof Пис1_1.НаписатьКомментарий === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьИнструкцию: " + (typeof Пис1_1.НаписатьИнструкцию === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьDTD: " + (typeof Пис1_1.НаписатьDTD === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьПространство: " + (typeof Пис1_1.НаписатьПространство === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НачатьЭлементСПространством: " + (typeof Пис1_1.НачатьЭлементСПространством === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    НаписатьАтрибутСПространством: " + (typeof Пис1_1.НаписатьАтрибутСПространством === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    УстановитьАвтоформатирование: " + (typeof Пис1_1.УстановитьАвтоформатирование === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ПолучитьАвтоформатирование: " + (typeof Пис1_1.ПолучитьАвтоформатирование === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    УстановитьОтступАвтоформатирования: " + (typeof Пис1_1.УстановитьОтступАвтоформатирования === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ПолучитьОтступАвтоформатирования: " + (typeof Пис1_1.ПолучитьОтступАвтоформатирования === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    ПолучитьПисатель: " + (typeof Пис1_1.ПолучитьПисатель === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    КопироватьВ: " + (typeof Пис1_1.КопироватьВ === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("")
    
    // ===== 16. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        пФин = Новый QtXmlПисатель()
        пФин.РежимОтладки(Режим_Отладки)
        пФин.УстановитьАвтоформатирование(ИСТИНА)
        пФин.УстановитьОтступАвтоформатирования(2)
        
        пФин.НачатьДокумент()
        пФин.НачатьЭлемент("library")
        пФин.НаписатьАтрибут("name", "My Library")
        пФин.НаписатьАтрибут("version", "1.0")
        
        пФин.НаписатьКомментарий("Список книг")
        
        пФин.НачатьЭлемент("book")
        пФин.НаписатьАтрибут("id", "1")
        пФин.НаписатьТекстовыйЭлемент("title", "Война и мир")
        пФин.НаписатьТекстовыйЭлемент("author", "Толстой")
        пФин.НаписатьТекстовыйЭлемент("year", "1869")
        пФин.НаписатьТекстовыйЭлемент("description", "Роман-эпопея")
        пФин.ЗакончитьЭлемент()
        
        пФин.НачатьЭлемент("book")
        пФин.НаписатьАтрибут("id", "2")
        пФин.НаписатьТекстовыйЭлемент("title", "Преступление и наказание")
        пФин.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин.НаписатьТекстовыйЭлемент("year", "1866")
        пФин.НаписатьCDATA("<annotation>Роман о преступлении</annotation>")
        пФин.ЗакончитьЭлемент()
        
        пФин.НачатьЭлементСПространством("http://example.com/ns", "ns:book")
        пФин.НаписатьАтрибут("id", "3")
        пФин.НаписатьТекстовыйЭлемент("title", "Идиот")
        пФин.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин.НаписатьТекстовыйЭлемент("year", "1868")
        пФин.ЗакончитьЭлемент()
        
        пФин.ЗакончитьЭлемент()
        
        пФин.НаписатьИнструкцию("xsp", "echo 'XML document generated'")
        
        пФин.ЗакончитьДокумент()
        
        финальныйXML = пФин.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Полный XML документ:")
        ВывестиСтрокуВКонсоль("  " + финальныйXML)
        ВывестиСтрокуВКонсоль("  Длина документа: " + финальныйXML.length + " символов")
        
        Если финальныйXML.indexOf("library") > -1 И финальныйXML.indexOf("book") > -1 И финальныйXML.indexOf("Толстой") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Практическое использование работает успешно")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Практическое использование не работает")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при практическом использовании: " + e)
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("==== Тест QtXmlStreamWriter (QtXmlПисатель) завершён.===================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtДанныеПоток()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ОткрытьУстройство              │ openDevice                     │
//│ 20 │ ЗакрытьУстройство              │ closeDevice                    │
//│ 21 │ УстройствоОткрыто              │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                │ readData                       │
//│ 23 │ ПрочитатьВсеДанные             │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//│ 49 │ ПрочитатьЦелое8                │ readInt8                       │
//│ 50 │ ПрочитатьЦелое16               │ readInt16                      │
//│ 51 │ ПрочитатьЦелое32               │ readInt32                      │
//│ 52 │ ПрочитатьЦелое64               │ readInt64                      │
//│ 53 │ ПрочитатьБеззнаковое8          │ readUInt8                      │
//│ 54 │ ПрочитатьБеззнаковое16         │ readUInt16                     │
//│ 55 │ ПрочитатьБеззнаковое32         │ readUInt32                     │
//│ 56 │ ПрочитатьБеззнаковое64         │ readUInt64                     │
//│ 57 │ ПрочитатьДробь                 │ readDouble                     │
//│ 58 │ ПрочитатьДробьОдинарную        │ readFloat                      │
//│ 59 │ ПрочитатьЛогику                │ readBool                       │
//│ 60 │ ПрочитатьСтроку                │ readString                     │
//│ 61 │ ПрочитатьБайты                 │ readBytes                      │
//│ 62 │ ПрочитатьВсеБайты              │ readAllBytes                   │
//│ 63 │ ПрочитатьQString               │ readQString                    │
//│ 64 │ ВКонце                         │ atEndValue                     │
//│ 65 │ ЗаписатьЦелое8                 │ writeInt8                      │
//│ 66 │ ЗаписатьЦелое16                │ writeInt16                     │
//│ 67 │ ЗаписатьЦелое32                │ writeInt32                     │
//│ 68 │ ЗаписатьЦелое64                │ writeInt64                     │
//│ 69 │ ЗаписатьБеззнаковое8           │ writeUInt8                     │
//│ 70 │ ЗаписатьБеззнаковое16          │ writeUInt16                    │
//│ 71 │ ЗаписатьБеззнаковое32          │ writeUInt32                    │
//│ 72 │ ЗаписатьБеззнаковое64          │ writeUInt64                    │
//│ 73 │ ЗаписатьДробь                  │ writeDouble                    │
//│ 74 │ ЗаписатьДробьОдинарную         │ writeFloat                     │
//│ 75 │ ЗаписатьЛогику                 │ writeBool                      │
//│ 76 │ ЗаписатьСтроку                 │ writeString                    │
//│ 77 │ ЗаписатьБайты                  │ writeBytes                     │
//│ 78 │ ЗаписатьQString                │ writeQString                   │
//│ 79 │ УстановитьПорядокБайт          │ setByteOrderValue              │
//│ 80 │ ПолучитьПорядокБайт            │ getByteOrderValue              │
//│ 81 │ УстановитьТочность             │ setFloatingPointPrecisionValue │
//│ 82 │ ПолучитьТочность               │ getFloatingPointPrecisionValue │
//│ 83 │ СброситьСтатус                 │ resetStatus                    │
//│ 84 │ ПолучитьСтатус                 │ status                         │
//│ 85 │ ПолучитьУстройство             │ getDeviceValue                 │
//│ 86 │ УстановитьУстройство           │ setDeviceValue                 │
//│ 87 │ ПолучитьБуфер                  │ getBufferValue                 │
//│ 88 │ ПолучитьРазмер                 │ getSize                        │
//│ 89 │ БольшойПорядок                 │ BigEndian                      │
//│ 90 │ МаленькийПорядок               │ LittleEndian                   │
//│ 91 │ ТочностьОдинарная              │ SinglePrecision                │
//│ 92 │ ТочностьДвойная                │ DoublePrecision                │
//│ 93 │ Ок                             │ Ok                             │
//│ 94 │ ЧтениеЗаКонец                  │ ReadPastEnd                    │
//│ 95 │ ОшибкаЧтения                   │ ReadCorruptData                │
//│ 96 │ ОшибкаЗаписи                   │ WriteFailed                    │
//└─────┴────────────────────────────────┴────────────────────────────────┘
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtDataStream (QtДанныеПоток) - КОМПАКТНАЯ ВЕРСИЯ ==============")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ДанПоток1_1 = Новый QtДанныеПоток()
    ДанПоток1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. КОНСТАНТЫ ПОРЯДКА БАЙТ =====
    большой = ДанПоток1_1.BigEndian()
    маленький = ДанПоток1_1.LittleEndian()
    ВывестиСтрокуВКонсоль("    BigEndian(): " + большой + " (ожидается 0), LittleEndian(): " + маленький + " (ожидается 1)")
    
    // ===== 3. КОНСТАНТЫ ТОЧНОСТИ =====
    одинарная = ДанПоток1_1.SinglePrecision()
    двойная = ДанПоток1_1.DoublePrecision()
    ВывестиСтрокуВКонсоль("    SinglePrecision(): " + одинарная + " (ожидается 0), DoublePrecision(): " + двойная + " (ожидается 1)")
    
    // ===== 4. КОНСТАНТЫ СТАТУСОВ =====
    ок = ДанПоток1_1.Ok()
    пастЕнд = ДанПоток1_1.ReadPastEnd()
    коррупт = ДанПоток1_1.ReadCorruptData()
    врайтФейл = ДанПоток1_1.WriteFailed()
    ВывестиСтрокуВКонсоль("    Ok(): " + ок + ", ReadPastEnd(): " + пастЕнд + ", ReadCorruptData(): " + коррупт + ", WriteFailed(): " + врайтФейл + " (ожидается 0, 1, 2, 3)")
    
    // ===== 5. ЗАПИСЬ ЦЕЛЫХ ЧИСЕЛ =====
    ДанПоток1_2 = Новый QtДанныеПоток()
    ДанПоток1_2.РежимОтладки(Режим_Отладки)
    ДанПоток1_2.writeInt32(42)
    ДанПоток1_2.ЗаписатьЦелое32(100)
    ДанПоток1_2.writeInt64(1234567890)
    ВывестиСтрокуВКонсоль("    writeInt32(42), ЗаписатьЦелое32(100), writeInt64(1234567890): УСПЕШНО")
    
    // ===== 6. ЗАПИСЬ БЕЗЗНАКОВЫХ ЧИСЕЛ =====
    ДанПоток1_3 = Новый QtДанныеПоток()
    ДанПоток1_3.РежимОтладки(Режим_Отладки)
    ДанПоток1_3.writeUInt32(255)
    ДанПоток1_3.ЗаписатьБеззнаковое32(65535)
    ВывестиСтрокуВКонсоль("    writeUInt32(255), ЗаписатьБеззнаковое32(65535): УСПЕШНО")
    
    // ===== 7. ЗАПИСЬ ДРОБЕЙ =====
    ДанПоток1_4 = Новый QtДанныеПоток()
    ДанПоток1_4.РежимОтладки(Режим_Отладки)
    ДанПоток1_4.writeDouble(3.1415926535)
    ДанПоток1_4.ЗаписатьДробь(2.7182818284)
    ДанПоток1_4.writeFloat(1.618)
    ВывестиСтрокуВКонсоль("    writeDouble(3.14159), ЗаписатьДробь(2.71828), writeFloat(1.618): УСПЕШНО")
    
    // ===== 8. ЗАПИСЬ ЛОГИКИ =====
    ДанПоток1_5 = Новый QtДанныеПоток()
    ДанПоток1_5.РежимОтладки(Режим_Отладки)
    ДанПоток1_5.writeBool(ИСТИНА)
    ДанПоток1_5.ЗаписатьЛогику(ЛОЖЬ)
    ДанПоток1_5.writeBool(ИСТИНА)
    ВывестиСтрокуВКонсоль("    writeBool(true), ЗаписатьЛогику(false), writeBool(true): УСПЕШНО")
    
    // ===== 9. ЗАПИСЬ СТРОК =====
    ДанПоток1_6 = Новый QtДанныеПоток()
    ДанПоток1_6.РежимОтладки(Режим_Отладки)
    ДанПоток1_6.writeString("Hello")
    ДанПоток1_6.ЗаписатьСтроку(" World")
    ДанПоток1_6.writeQString(" Qt")
    ВывестиСтрокуВКонсоль("    writeString('Hello'), ЗаписатьСтроку(' World'), writeQString(' Qt'): УСПЕШНО")
    
    // ===== 10. ЗАПИСЬ БАЙТОВ =====
    ДанПоток1_7 = Новый QtДанныеПоток()
    ДанПоток1_7.РежимОтладки(Режим_Отладки)
    ДанПоток1_7.writeBytes("Hello")
    ДанПоток1_7.ЗаписатьБайты(" World")
    ВывестиСтрокуВКонсоль("    writeBytes('Hello'), ЗаписатьБайты(' World'): УСПЕШНО")
    
    // ===== 11. УСТАНОВКА И ПОЛУЧЕНИЕ ПОРЯДКА БАЙТ =====
    ДанПоток1_8 = Новый QtДанныеПоток()
    ДанПоток1_8.РежимОтладки(Режим_Отладки)
    ДанПоток1_8.setByteOrderValue(ДанПоток1_8.LittleEndian())
    порядок = ДанПоток1_8.getByteOrderValue()
    ВывестиСтрокуВКонсоль("    setByteOrderValue(LittleEndian) -> getByteOrderValue(): " + порядок + " (ожидается 1)")
    ДанПоток1_8.УстановитьПорядокБайт(ДанПоток1_8.BigEndian())
    порядок2 = ДанПоток1_8.ПолучитьПорядокБайт()
    ВывестиСтрокуВКонсоль("    УстановитьПорядокБайт(BigEndian) -> ПолучитьПорядокБайт(): " + порядок2 + " (ожидается 0)")
    
    // ===== 12. УСТАНОВКА И ПОЛУЧЕНИЕ ТОЧНОСТИ =====
    ДанПоток1_9 = Новый QtДанныеПоток()
    ДанПоток1_9.РежимОтладки(Режим_Отладки)
    ДанПоток1_9.setFloatingPointPrecisionValue(ДанПоток1_9.SinglePrecision())
    точность = ДанПоток1_9.getFloatingPointPrecisionValue()
    ВывестиСтрокуВКонсоль("    setFloatingPointPrecisionValue(SinglePrecision) -> getFloatingPointPrecisionValue(): " + точность + " (ожидается 0)")
    ДанПоток1_9.УстановитьТочность(ДанПоток1_9.DoublePrecision())
    точность2 = ДанПоток1_9.ПолучитьТочность()
    ВывестиСтрокуВКонсоль("    УстановитьТочность(DoublePrecision) -> ПолучитьТочность(): " + точность2 + " (ожидается 1)")
    
    // ===== 13. СТАТУС =====
    ДанПоток1_10 = Новый QtДанныеПоток()
    ДанПоток1_10.РежимОтладки(Режим_Отладки)
    статус1 = ДанПоток1_10.status()
    ВывестиСтрокуВКонсоль("    status(): " + статус1 + " (ожидается 0 - Ok)")
    ДанПоток1_10.resetStatus()
    статус2 = ДанПоток1_10.ПолучитьСтатус()
    ВывестиСтрокуВКонсоль("    resetStatus() -> ПолучитьСтатус(): " + статус2 + " (ожидается 0 - Ok)")
    
    // ===== 14. RUSFUNC =====
    Если typeof ДанПоток1_1.RusFunc === 'function' Тогда
        jsonStr = ДанПоток1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtDataStream (QtДанныеПоток) завершён.================================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtЛокальныйСокет()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
//│ 9 │ ПодключитьСигнал               │ connectSignal                  │
//│ 10 │ ОтключитьСигнал                │ disconnectSignal               │
//│ 11 │ КопироватьВ                    │ copyTo                         │
//│ 12 │ РежимОтладки                   │ setDebug                       │
//│ 13 │ ПолучитьРежимОтладки           │ getDebug                       │
//│ 14 │ ПолучитьТипКласса              │ getClassType                   │
//│ 15 │ УстановитьТипКласса            │ setClassType                   │
//│ 16 │ ПолучитьИмяКласса              │ getClassName                   │
//│ 17 │ УстановитьИмяКласса            │ setClassName                   │
//│ 18 │ ПолучитьСписокМетодов          │ RusFunc                        │
//│ 19 │ ОткрытьУстройство              │ openDevice                     │
//│ 20 │ ЗакрытьУстройство              │ closeDevice                    │
//│ 21 │ УстройствоОткрыто              │ isOpenDevice                   │
//│ 22 │ ПрочитатьДанные                │ readData                       │
//│ 23 │ ПрочитатьВсеДанные             │ readAllData                    │
//│ 24 │ ПрочитатьСтроку                │ readLineData                   │
//│ 25 │ ПрочитатьСимвол                │ getCharData                    │
//│ 26 │ ДоступноДанных                 │ bytesAvailableData             │
//│ 27 │ ОжидатьГотовность              │ waitForReadyReadData           │
//│ 28 │ ЗаписатьДанные                 │ writeData                      │
//│ 29 │ ЗаписатьСтроку                 │ writeLineData                  │
//│ 30 │ ЗаписатьСимвол                 │ putCharData                    │
//│ 31 │ ДанныхДляЗаписи                │ bytesToWriteData               │
//│ 32 │ Позиция                        │ posData                        │
//│ 33 │ Размер                         │ sizeData                       │
//│ 34 │ ПерейтиВ                       │ seekData                       │
//│ 35 │ ВКонце                         │ atEndData                      │
//│ 36 │ СброситьУстройство             │ resetDevice                    │
//│ 37 │ ТекстОшибки                    │ errorStringData                │
//│ 38 │ УстановитьТекстОшибки          │ setErrorStringData             │
//│ 39 │ Валидный                       │ isValid                        │
//│ 40 │ ПолучитьУстройство             │ getDevice                      │
//│ 41 │ КопироватьВ                    │ copyTo                         │
//│ 42 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 43 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 44 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 45 │ Добавление                     │ Append                         │
//│ 46 │ Обрезать                       │ Truncate                       │
//│ 47 │ Текстовый                      │ Text                           │
//│ 48 │ БезБуферизации                 │ Unbuffered                     │
//│ 49 │ ПодключитьсяКХосту             │ connectToHost                  │
//│ 50 │ ОтключитьсяОтХоста             │ disconnectFromHost             │
//│ 51 │ Прервать                       │ abort                          │
//│ 52 │ ЖдатьПодключения               │ waitForConnected               │
//│ 53 │ ЖдатьОтключения                │ waitForDisconnected            │
//│ 54 │ ПолучитьСостояние              │ getState                       │
//│ 55 │ ПолучитьСостояниеСтрокой       │ getStateString                 │
//│ 56 │ ПолучитьТипСокета              │ getSocketType                  │
//│ 57 │ ПолучитьТипСокетаСтрокой       │ getSocketTypeString            │
//│ 58 │ ПолучитьАдресПиера             │ getPeerAddress                 │
//│ 59 │ ПолучитьПортПиера              │ getPeerPort                    │
//│ 60 │ ПолучитьЛокальныйАдрес         │ getLocalAddress                │
//│ 61 │ ПолучитьЛокальныйПорт          │ getLocalPort                   │
//│ 62 │ ПолучитьОшибку                 │ getError                       │
//│ 63 │ ПолучитьТекстОшибки            │ getErrorStringValue            │
//│ 64 │ ПолучитьОшибкуСтрокой          │ getErrorStringByCode           │
//│ 65 │ УстановитьРазмерБуфераЧтения   │ setReadBufferSize              │
//│ 66 │ ПолучитьРазмерБуфераЧтения     │ getReadBufferSize              │
//│ 67 │ УстановитьОпциюСокета          │ setSocketOption                │
//│ 68 │ ПолучитьОпциюСокета            │ socketOption                   │
//│ 69 │ Привязать                      │ bind                           │
//│ 70 │ Валидный                       │ isValid                        │
//│ 71 │ Подключен                      │ isConnected                    │
//│ 72 │ ПолучитьСокет                  │ getRealSocket                  │
//│ 73 │ ПодключитьсяКСерверу           │ connectToServerValue           │
//│ 74 │ ПодключитьсяСРежимом           │ connectToServerWithMode        │
//│ 75 │ ОтключитьсяОтСервера           │ disconnectFromServerValue      │
//│ 76 │ Прервать                       │ abortValue                     │
//│ 77 │ Подключен                      │ isConnectedValue               │
//│ 78 │ ПолучитьСостояние              │ getStateValue                  │
//│ 79 │ СостояниеСтрокой               │ getStateString                 │
//│ 80 │ ИмяСервера                     │ getServerNameValue             │
//│ 81 │ ПолноеИмяСервера               │ getFullServerNameValue         │
//│ 82 │ ЗаписатьДанные                 │ writeData                      │
//│ 83 │ ЗаписатьСтроку                 │ writeLine                      │
//│ 84 │ СброситьБуфер                  │ flushValue                     │
//│ 85 │ ДоступноБайт                   │ bytesAvailableValue            │
//│ 86 │ БайтНаОтправку                 │ bytesToWriteValue              │
//│ 87 │ ПрочитатьВсе                   │ readAllValue                   │
//│ 88 │ Прочитать                      │ readValue                      │
//│ 89 │ ПрочитатьСтроку                │ readLineValue                  │
//│ 90 │ МожноЧитатьСтроку              │ canReadLineValue               │
//│ 91 │ ВКонце                         │ atEndValue                     │
//│ 92 │ УстановитьИмяСервера           │ setServerNameValue             │
//│ 93 │ УстановитьРазмерБуфераЧтения   │ setReadBufferSizeValue         │
//│ 94 │ РазмерБуфераЧтения             │ getReadBufferSizeValue         │
//│ 95 │ ОжидатьПодключения             │ waitForConnectedValue          │
//│ 96 │ ОжидатьОтключения              │ waitForDisconnectedValue       │
//│ 97 │ ОжидатьГотовностиЧтения        │ waitForReadyReadValue          │
//│ 98 │ ОжидатьОтправки                │ waitForBytesWrittenValue       │
//│ 99 │ ПриПодключении                 │ onConnectedValue               │
//│ 100 │ ПриОтключении                  │ onDisconnectedValue            │
//│ 101 │ ПриГотовностиЧтения            │ onReadyReadValue               │
//│ 102 │ ПриОшибке                      │ onErrorValue                   │
//│ 103 │ ПриИзмененииСостояния          │ onStateChangedValue            │
//│ 104 │ ПриОтправкеДанных              │ onBytesWrittenValue            │
//│ 105 │ ОшибкаСтрокой                  │ getErrorStringValue            │
//│ 106 │ КодОшибки                      │ getErrorValue                  │
//│ 107 │ ПолучитьЛокальныйСокет         │ getRealLocalSocket             │
//│ 108 │ НеПодключен                    │ UnconnectedState               │
//│ 109 │ Подключение                    │ ConnectingState                │
//│ 110 │ Подключен                      │ ConnectedState                 │
//│ 111 │ Закрытие                       │ ClosingState                   │
//│ 112 │ НеОткрыт                       │ NotOpen                        │
//│ 113 │ ТолькоЧтение                   │ ReadOnly                       │
//│ 114 │ ТолькоЗапись                   │ WriteOnly                      │
//│ 115 │ ЧтениеЗапись                   │ ReadWrite                      │
//│ 116 │ Добавление                     │ Append                         │
//│ 117 │ Очистить                       │ Truncate                       │
//│ 118 │ Текст                          │ Text                           │
//└─────┴────────────────────────────────┴────────────────────────────────┘

    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtLocalSocket (QtЛокальныйСокет) - КОМПАКТНАЯ ВЕРСИЯ =========")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    ЛокСок1_1 = Новый QtLocalSocket()
    ЛокСок1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("    Создание объекта: УСПЕШНО")
    
    // ===== 2. СОСТОЯНИЕ =====
    состояние = ЛокСок1_1.ПолучитьСостояние()
    состояниеСтр = ЛокСок1_1.СостояниеСтрокой()
    isConnected = ЛокСок1_1.isConnectedValue()
    валидный = ЛокСок1_1.Валидный()
    неПодключен = ЛокСок1_1.UnconnectedState()
    ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + "), UnconnectedState: " + неПодключен)
    ВывестиСтрокуВКонсоль("    isConnectedValue(): " + isConnected + " (ожидается false), Валидный(): " + валидный + " (ожидается true)")
    
    // ===== 3. ИМЯ СЕРВЕРА =====
    имяСервера = ЛокСок1_1.ИмяСервера()
    полноеИмя = ЛокСок1_1.ПолноеИмяСервера()
    ВывестиСтрокуВКонсоль("    ИмяСервера(): " + имяСервера + ", ПолноеИмяСервера(): " + полноеИмя)
    ЛокСок1_1.УстановитьИмяСервера("test_socket")
    имяПосле = ЛокСок1_1.ИмяСервера()
    ВывестиСтрокуВКонсоль("    УстановитьИмяСервера('test_socket') -> ИмяСервера(): " + имяПосле + " (ожидается test_socket)")
    
    // ===== 4. ЗАПИСЬ (без подключения) =====
    результатЗапись = ЛокСок1_1.ЗаписатьДанные("test")
    ВывестиСтрокуВКонсоль("    ЗаписатьДанные('test'): " + результатЗапись + " (ожидается -1)")
    
    // ===== 5. ЧТЕНИЕ (без подключения) =====
    данные = ЛокСок1_1.ПрочитатьВсе()
    ВывестиСтрокуВКонсоль("    ПрочитатьВсе(): '" + данные + "' (ожидается пустая строка)")
    
    // ===== 6. БУФЕР ЧТЕНИЯ =====
    размер = ЛокСок1_1.РазмерБуфераЧтения()
    ВывестиСтрокуВКонсоль("    РазмерБуфераЧтения(): " + размер)
    ЛокСок1_1.УстановитьРазмерБуфераЧтения(8192)
    новыйРазмер = ЛокСок1_1.РазмерБуфераЧтения()
    ВывестиСтрокуВКонсоль("    УстановитьРазмерБуфераЧтения(8192) -> РазмерБуфераЧтения(): " + новыйРазмер)
    
    // ===== 7. КОНСТАНТЫ СОСТОЯНИЙ =====
    подключение = ЛокСок1_1.ConnectingState()
    подключен = ЛокСок1_1.ConnectedState()
    закрытие = ЛокСок1_1.ClosingState()
    ВывестиСтрокуВКонсоль("    ConnectingState: " + подключение + ", ConnectedState: " + подключен + ", ClosingState: " + закрытие)
    
    // ===== 8. КОНСТАНТЫ РЕЖИМОВ =====
    неОткрыт = ЛокСок1_1.NotOpen()
    толькоЧтение = ЛокСок1_1.ReadOnly()
    толькоЗапись = ЛокСок1_1.WriteOnly()
    чтениеЗапись = ЛокСок1_1.ReadWrite()
    добавление = ЛокСок1_1.Append()
    очистить = ЛокСок1_1.Truncate()
    текст = ЛокСок1_1.Text()
    ВывестиСтрокуВКонсоль("    NotOpen: " + неОткрыт + ", ReadOnly: " + толькоЧтение + ", WriteOnly: " + толькоЗапись)
    ВывестиСтрокуВКонсоль("    ReadWrite: " + чтениеЗапись + ", Append: " + добавление + ", Truncate: " + очистить + ", Text: " + текст)
    
    // ===== 9. РЕАЛЬНЫЙ ОБЪЕКТ =====
    реал = ЛокСок1_1.ПолучитьЛокальныйСокет()
    ВывестиСтрокуВКонсоль("    ПолучитьЛокальныйСокет(): " + (реал != null ? "УСПЕШНО" : "НЕ ДОСТУПЕН"))
    
    // ===== 10. ОЖИДАНИЯ =====
    ожид1 = ЛокСок1_1.ОжидатьПодключения(100)
    ожид2 = ЛокСок1_1.ОжидатьОтключения(100)
    ожид3 = ЛокСок1_1.ОжидатьГотовностиЧтения(100)
    ожид4 = ЛокСок1_1.ОжидатьОтправки(100)
    ВывестиСтрокуВКонсоль("    ОжидатьПодключения(100): " + ожид1 + ", ОжидатьОтключения(100): " + ожид2)
    ВывестиСтрокуВКонсоль("    ОжидатьГотовностиЧтения(100): " + ожид3 + ", ОжидатьОтправки(100): " + ожид4)
    
    // ===== 11. RUSFUNC =====
    Если typeof ЛокСок1_1.RusFunc === 'function' Тогда
        jsonStr = ЛокСок1_1.RusFunc()
        карта = JSON.parse(jsonStr)
        ВывестиСтрокуВКонсоль("    RusFunc(): " + карта.length + " методов")
    Иначе
        ВывестиСтрокуВКонсоль("    RusFunc(): НЕ СУЩЕСТВУЕТ")
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("==== Тест QtLocalSocket (QtЛокальныйСокет) завершён.============================") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции

Функция Методы_QtПоследовательныйПорт()
//                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)
//═══════════════════════════════════════════════════════════════════════════════════════
//┌─────┬────────────────────────────────┬────────────────────────────────┐
//│  №  │ Русский метод                  │ Английский метод                │
//├─────┼────────────────────────────────┼────────────────────────────────┤
//│ 1 │ Действителен                   │ isValid                        │
//│ 2 │ ПолучитьОбъект                 │ getRealObject                  │
//│ 3 │ УстановитьРодителя             │ setParentWrapper               │
//│ 4 │ ПолучитьРодителя               │ getParentWrapper               │
//│ 5 │ УстановитьИмяОбъекта           │ setObjectName                  │
//│ 6 │ ИмяОбъекта                     │ objectName                     │
//│ 7 │ УстановитьСвойство             │ setProperty                    │
//│ 8 │ Свойство                       │ property                       │
