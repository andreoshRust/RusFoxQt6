    ВывестиСтрокуВКонсоль("    copyTo(): " + результатКопия + ", копия isValid(): " + валидныйКопия + " (ожидается true)")
    
    Стиль1_3 = Новый QtСтиль()
    Стиль1_3.РежимОтладки(Режим_Отладки)
