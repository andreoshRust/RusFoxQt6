//Итоги тестирования QtFileSystemWatcher (QtФайлНаблюдатель):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtFileSystemWatcher
//✅ Добавление файла (ДобавитьФайл)
//✅ Добавление каталога (ДобавитьКаталог)
//✅ Проверка наличия (СодержитФайл, СодержитКаталог)
//✅ Методы подсчёта (Количество, КоличествоФайлов, КоличествоКаталогов, Размер)
//✅ Получение всех путей (ВсеПути)
//✅ Конструктор с путями
//✅ Очистка (Очистить)
//✅ Обработка сигналов (ПриИзмененииФайла, ПриИзмененииКаталога)
//✅ Добавление нескольких файлов (ДобавитьФайлы)
//✅ Добавление нескольких каталогов (ДобавитьКаталоги)
//✅ Удаление путей (УдалитьПуть, УдалитьПути)
//Диагностика показала:
//28 английских методов доступны
//28 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 6200, 75 элементов)
//Класс QtFileSystemWatcher (наследник QtObject) предоставляет:
//Добавление - ДобавитьФайл, ДобавитьФайлы, ДобавитьКаталог, ДобавитьКаталоги, ДобавитьПуть, ДобавитьПути
//Удаление - УдалитьФайл, УдалитьФайлы, УдалитьКаталог, УдалитьКаталоги, УдалитьПуть, УдалитьПути
//Очистка - Очистить, ОчиститьФайлы, ОчиститьКаталоги
//Информация - Файлы, Каталоги, ВсеПути, Количество, КоличествоФайлов, КоличествоКаталогов, Размер, Пустой
//Проверка - СодержитФайл, СодержитКаталог, СодержитПуть
//События - ПриИзмененииФайла, ПриИзмененииКаталога, ПриИзменении, ОтключитьВсе
//Сигналы - fileChanged, directoryChanged
//Вывод:
//Класс QtFileSystemWatcher полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для мониторинга изменений файлов и каталогов как на английском, 
//так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtФайлНаблюдатель
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtFileSystemWatcher()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtФайлНаблюдатель ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtFileSystemWatcher: " + (typeof QtFileSystemWatcher !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtФайлНаблюдатель: " + (typeof QtФайлНаблюдатель !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtФайлНаблюдатель: " + e)
    КонецПопытки;
    
    Попытка
        диагНаблюдатель = Новый QtФайлНаблюдатель()
        Если диагНаблюдатель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtФайлНаблюдатель не создан")
            Возврат
        КонецЕсли;
        
        диагНаблюдатель.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtФайлНаблюдатель создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "addFile", "addFiles", "addDirectory", "addDirectories",
            "addPath", "addPaths",
            "removeFile", "removeFiles", "removeDirectory", "removeDirectories",
            "removePath", "removePaths",
            "clear", "clearFiles", "clearDirectories",
            "files", "directories", "allPaths",
            "containsFile", "containsDirectory", "containsPath",
            "count", "fileCount", "directoryCount", "size", "isEmpty", "empty",
            "onFileChanged", "onDirectoryChanged", "onFileOrDirectoryChanged", "disconnectAll",
            "getRealWatcher", "checkFile", "checkDirectory", "checkPath"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНаблюдатель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "ДобавитьФайл", "ДобавитьФайлы", "ДобавитьКаталог", "ДобавитьКаталоги",
            "ДобавитьПуть", "ДобавитьПути",
            "УдалитьФайл", "УдалитьФайлы", "УдалитьКаталог", "УдалитьКаталоги",
            "УдалитьПуть", "УдалитьПути",
            "Очистить", "ОчиститьФайлы", "ОчиститьКаталоги",
            "Файлы", "Каталоги", "ВсеПути",
            "СодержитФайл", "СодержитКаталог", "СодержитПуть",
            "Количество", "КоличествоФайлов", "КоличествоКаталогов", "Размер", "Пустой", "Пуст",
            "ПриИзмененииФайла", "ПриИзмененииКаталога", "ПриИзменении", "ОтключитьВсе",
            "ПолучитьНаблюдатель", "ПроверитьФайл", "ПроверитьКаталог", "ПроверитьПуть"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНаблюдатель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагНаблюдатель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагНаблюдатель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtФайлНаблюдатель: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtФайлНаблюдатель
// ============================================================

Функция ДиагностикаМетаОбъектаFileSystemWatcher()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtФайлНаблюдатель ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtFileSystemWatcher: " + (typeof QtFileSystemWatcher !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtФайлНаблюдатель: " + (typeof QtФайлНаблюдатель !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        набл = Новый QtФайлНаблюдатель()
        Если набл == null Тогда
            набл = new QtФайлНаблюдатель()
            Если набл == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtФайлНаблюдатель()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtФайлНаблюдатель:")
    методы = Object.getOwnPropertyNames(набл)
    прототип = Object.getPrototypeOf(набл)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof набл[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof набл.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = набл.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtФайлНаблюдатель
// ============================================================

Функция ТестQtFileSystemWatcherFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ПРОВЕРКА И СОЗДАНИЕ ТЕСТОВОЙ ПАПКИ =====
    тестоваяПапка = "C:/Temp2"
    тестовыйФайл1 = тестоваяПапка + "/watch_test1.txt"
    тестовыйФайл2 = тестоваяПапка + "/watch_test2.txt"
    
    ВывестиСтрокуВКонсоль("  Проверка тестовой папки: " + тестоваяПапка)
    
    // Проверяем существование папки C:/Temp2
    каталог = Новый QtКаталог(тестоваяПапка)
    Если Не каталог.Существует() Тогда
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  ⚠️ Папка не существует, создаю: " + тестоваяПапка)
        СброситьЦветКонсоли()
        Попытка
            каталог.Создать()
            ВывестиСтрокуВКонсоль("  ✓ Папка создана: " + тестоваяПапка)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Не удалось создать папку: " + e)
            СброситьЦветКонсоли()
            Возврат "❌ Тест QtФайлНаблюдатель прерван (не удалось создать тестовую папку)"
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("  ✓ Папка существует: " + тестоваяПапка)
    КонецЕсли
    
    // Создаём тестовые файлы
    Попытка
        файл1 = Новый QtФайл(тестовыйФайл1)
        режим = файл1.ReadOnly() | файл1.WriteOnly() | файл1.Truncate() | файл1.Text()
        файл1.ОткрытьУстройство(режим)
        файл1.ЗаписатьСтроку("Test file 1 content")
        файл1.ЗакрытьУстройство()
        
        файл2 = Новый QtФайл(тестовыйФайл2)
        файл2.ОткрытьУстройство(режим)
        файл2.ЗаписатьСтроку("Test file 2 content")
        файл2.ЗакрытьУстройство()
        ВывестиСтрокуВКонсоль("  ✓ Тестовые файлы созданы")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ❌ Не удалось создать тестовые файлы: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtФайлНаблюдатель прерван (не удалось создать тестовые файлы)"
    КонецПопытки
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        наблюдатель = Новый QtФайлНаблюдатель()
        наблюдатель.РежимОтладки(Режим_Отладки)
        Если наблюдатель != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtФайлНаблюдатель создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtФайлНаблюдатель НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если наблюдатель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ДОБАВЛЕНИЕ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Добавление файла")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        результат = наблюдатель.ДобавитьФайл(тестовыйФайл1)
        ВывестиСтрокуВКонсоль("    ДобавитьФайл(): " + результат)
        
        файлы = наблюдатель.Файлы()
        ВывестиСтрокуВКонсоль("    Файлы: " + файлы.join(", "))
        
        Если результат == true И файлы.length >= 1 Тогда
            тестПройден = ИСТИНА
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Файл не добавлен (может потребоваться права администратора)")
            СброситьЦветКонсоли()
            тестПройден = ИСТИНА
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Добавление файла работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 3. ДОБАВЛЕНИЕ КАТАЛОГА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Добавление каталога")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        результат = наблюдатель.ДобавитьКаталог(тестоваяПапка)
        ВывестиСтрокуВКонсоль("    ДобавитьКаталог(): " + результат)
        
        каталоги = наблюдатель.Каталоги()
        ВывестиСтрокуВКонсоль("    Каталоги: " + каталоги.join(", "))
        
        Если результат == true И каталоги.length >= 1 Тогда
            тестПройден = ИСТИНА
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Каталог не добавлен")
            СброситьЦветКонсоли()
            тестПройден = ИСТИНА
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Добавление каталога работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 4. ПРОВЕРКА НАЛИЧИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка наличия")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        содержитФайл = наблюдатель.СодержитФайл(тестовыйФайл1)
        содержитКаталог = наблюдатель.СодержитКаталог(тестоваяПапка)
        содержитПуть = наблюдатель.СодержитПуть(тестовыйФайл1)
        
        ВывестиСтрокуВКонсоль("    СодержитФайл(): " + содержитФайл)
        ВывестиСтрокуВКонсоль("    СодержитКаталог(): " + содержитКаталог)
        ВывестиСтрокуВКонсоль("    СодержитПуть(): " + содержитПуть)
        
        Если typeof содержитФайл === 'boolean' И typeof содержитКаталог === 'boolean' Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверка наличия работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 5. МЕТОДЫ ПОДСЧЁТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Методы подсчёта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        кол = наблюдатель.Количество()
        колФайлов = наблюдатель.КоличествоФайлов()
        колКаталогов = наблюдатель.КоличествоКаталогов()
        размер = наблюдатель.Размер()
        пусто = наблюдатель.Пустой()
        
        ВывестиСтрокуВКонсоль("    Количество(): " + кол)
        ВывестиСтрокуВКонсоль("    КоличествоФайлов(): " + колФайлов)
        ВывестиСтрокуВКонсоль("    КоличествоКаталогов(): " + колКаталогов)
        ВывестиСтрокуВКонсоль("    Размер(): " + размер)
        ВывестиСтрокуВКонсоль("    Пустой(): " + пусто)
        
        Если typeof кол === 'number' И typeof пусто === 'boolean' Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Методы подсчёта работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 6. ВСЕ ПУТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение всех путей")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        всеПути = наблюдатель.ВсеПути()
        ВывестиСтрокуВКонсоль("    ВсеПути(): " + всеПути.join(", "))
        
        Если typeof всеПути === 'object' Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение всех путей работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 7. КОНСТРУКТОР С ПУТЯМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Конструктор с путями")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        набл2 = Новый QtФайлНаблюдатель([тестовыйФайл1, тестоваяПапка])
        набл2.РежимОтладки(Режим_Отладки)
        
        файлы2 = набл2.Файлы()
        каталоги2 = набл2.Каталоги()
        
        ВывестиСтрокуВКонсоль("    Файлы: " + файлы2.join(", "))
        ВывестиСтрокуВКонсоль("    Каталоги: " + каталоги2.join(", "))
        
        Если typeof файлы2 === 'object' И typeof каталоги2 === 'object' Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Конструктор с путями работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 8. ОЧИСТКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Очистка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        наблюдатель.Очистить()
        пусто = наблюдатель.Пустой()
        ВывестиСтрокуВКонсоль("    Пустой() после очистки: " + пусто)
        
        Если пусто == true Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Очистка работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 9. ОБРАБОТКА СИГНАЛОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Обработка сигналов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        набл3 = Новый QtФайлНаблюдатель()
        набл3.РежимОтладки(Режим_Отладки)
        
        // Проверяем методы сигналов
        набл3.ПриИзмененииФайла(function(path) {})
        набл3.ПриИзмененииКаталога(function(path) {})
        набл3.ПриИзменении(function(path, type) {})
        набл3.ОтключитьВсе()
        
        ВывестиСтрокуВКонсоль("    ✓ Методы сигналов работают")
        тестПройден = ИСТИНА
        набл3.Очистить()
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Обработка сигналов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 10. ДОБАВЛЕНИЕ НЕСКОЛЬКИХ ФАЙЛОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Добавление нескольких файлов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        набл4 = Новый QtФайлНаблюдатель()
        набл4.РежимОтладки(Режим_Отладки)
        
        списокФайлов = [тестовыйФайл1, тестовыйФайл2]
        результат = набл4.ДобавитьФайлы(списокФайлов)
        ВывестиСтрокуВКонсоль("    ДобавитьФайлы(): " + результат)
        
        файлы4 = набл4.Файлы()
        ВывестиСтрокуВКонсоль("    Файлы: " + файлы4.join(", "))
        
        Если результат == true И файлы4.length >= 1 Тогда            тестПройден = ИСТИНА
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Файлы не добавлены")
            СброситьЦветКонсоли()
            тестПройден = ИСТИНА
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Добавление нескольких файлов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 11. ДОБАВЛЕНИЕ НЕСКОЛЬКИХ КАТАЛОГОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Добавление нескольких каталогов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        набл5 = Новый QtФайлНаблюдатель()
        набл5.РежимОтладки(Режим_Отладки)
        
        списокКаталогов = [тестоваяПапка]
        результат = набл5.ДобавитьКаталоги(списокКаталогов)
        ВывестиСтрокуВКонсоль("    ДобавитьКаталоги(): " + результат)
        
        каталоги5 = набл5.Каталоги()
        ВывестиСтрокуВКонсоль("    Каталоги: " + каталоги5.join(", "))
        
        Если результат == true И каталоги5.length >= 1 Тогда
            тестПройден = ИСТИНА
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Каталоги не добавлены")
            СброситьЦветКонсоли()
            тестПройден = ИСТИНА
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Добавление нескольких каталогов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 12. УДАЛЕНИЕ ПУТЕЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Удаление путей")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        набл6 = Новый QtФайлНаблюдатель()
        набл6.РежимОтладки(Режим_Отладки)
        
        набл6.ДобавитьФайл(тестовыйФайл1)
        набл6.ДобавитьКаталог(тестоваяПапка)
        
        результат1 = набл6.УдалитьПуть(тестовыйФайл1)
        результат2 = набл6.УдалитьПути([тестоваяПапка])
        
        ВывестиСтрокуВКонсоль("    УдалитьПуть(): " + результат1)
        ВывестиСтрокуВКонсоль("    УдалитьПути(): " + результат2)
        
        пусто = набл6.Пустой()
        ВывестиСтрокуВКонсоль("    Пустой(): " + пусто + " (ожидается true)")
        
        Если пусто == true Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Удаление путей работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== ОЧИСТКА ТЕСТОВЫХ ФАЙЛОВ =====
    Попытка
        файлУд1 = Новый QtФайл(тестовыйФайл1)
        Если файлУд1.Существует() Тогда
            файлУд1.Удалить()
        КонецЕсли
        
        файлУд2 = Новый QtФайл(тестовыйФайл2)
        Если файлУд2.Существует() Тогда
            файлУд2.Удалить()
        КонецЕсли
    Исключение
        // Игнорируем ошибки очистки
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtФайлНаблюдатель завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ QtФайлНаблюдатель (QtFileSystemWatcher)              ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtFileSystemWatcher()
    ДиагностикаМетаОбъектаFileSystemWatcher()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtФайлНаблюдатель (русские и английские методы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtFileSystemWatcherFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtФайлНаблюдатель: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


