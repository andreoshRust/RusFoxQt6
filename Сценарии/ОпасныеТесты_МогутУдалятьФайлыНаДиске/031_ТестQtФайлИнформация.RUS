//Итоги тестирования QtFileInfo (QtФайлИнформация):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtFileInfo
//✅ Установка файла (УстановитьФайл)
//✅ Проверка существования (Существует)
//✅ Информация о пути (АбсолютныйПуть, АбсолютныйПутьКФайлу, КаноническийПуть, ИмяКаталога, ИмяФайла, ИмяБезРасширения, Расширение)
//✅ Информация о размере (Размер, РазмерВКб, РазмерВМб, РазмерВГб, РазмерСтрокой)
//✅ Информация о времени (ВремяСоздания, ВремяИзменения, ВремяЧтения, ВремяМетаданных, строковые представления)
//✅ Проверки свойств (ДоступенДляЧтения, ДоступенДляЗаписи, Исполняемый, Скрытый, СимволическаяСсылка, ЯвляетсяФайлом, ЯвляетсяКаталогом, Абсолютный, Относительный, Пустой, Действителен)
//✅ Обновление информации (Обновить)
//✅ Очистка (удаление файла)
//✅ Дополнительная информация (ПолучитьВладельца, ПолучитьГруппу, ПолучитьРазрешения, ПолучитьРазрешенияСтрокой)
//✅ RusFunc (56 методов в JSON)
//✅ Конструктор с путем


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtФайлИнформация
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtFileInfo()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtФайлИнформация ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtFileInfo: " + (typeof QtFileInfo !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtФайлИнформация: " + (typeof QtФайлИнформация !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtФайлИнформация: " + e)
    КонецПопытки;
    
    Попытка
        диагИнфо = Новый QtФайлИнформация()
        Если диагИнфо == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtФайлИнформация не создан")
            Возврат
        КонецЕсли;
        
        диагИнфо.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtФайлИнформация создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setFile", "refresh", "getFilePath",
            "getAbsolutePath", "getAbsoluteFilePath", "getCanonicalPath",
            "getPath", "getFileName", "getBaseName",
            "getCompleteBaseName", "getSuffix", "getBundleName",
            "getBirthTime", "getLastModified", "getLastRead",
            "getMetadataChangeTime", "getBirthTimeString", "getLastModifiedString",
            "getLastReadString", "getMetadataChangeTimeString",
            "getSize", "getSizeInKb", "getSizeInMb", "getSizeInGb", "getSizeString",
            "existsFile", "isReadable", "isWritable", "isExecutable",
            "isHidden", "isSymLink", "isFileCheck", "isDirCheck",
            "isRoot", "isAbsolute", "isRelative", "isEmpty", "isValid",
            "getOwner", "getGroup", "getPermissions", "getPermissionsString"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагИнфо[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            // Управление
            "УстановитьФайл", "Обновить", "ПолучитьПуть",
            // Информация о пути
            "АбсолютныйПуть", "АбсолютныйПутьКФайлу", "КаноническийПуть",
            "ИмяКаталога", "ИмяФайла", "ИмяБезРасширения",
            "ПолноеИмяБезРасширения", "Расширение", "ИмяБандла",
            // Информация о времени
            "ВремяСоздания", "ВремяИзменения", "ВремяЧтения",
            "ВремяИзмененияМетаданных", "ВремяСозданияСтрокой", "ВремяИзмененияСтрокой",
            "ВремяЧтенияСтрокой", "ВремяМетаданныхСтрокой",
            // Информация о размере
            "Размер", "РазмерВКб", "РазмерВМб", "РазмерВГб", "РазмерСтрокой",
            // Проверки
            "Существует", "ДоступенДляЧтения", "ДоступенДляЗаписи",
            "Исполняемый", "Скрытый", "СимволическаяСсылка",
            "ЯвляетсяФайлом", "ЯвляетсяКаталогом", "ЯвляетсяКорневым",
            "Абсолютный", "Относительный", "Пустой", "Действителен",
            // Дополнительно
            "ПолучитьВладельца", "ПолучитьГруппу", "ПолучитьРазрешения", "ПолучитьРазрешенияСтрокой"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагИнфо[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагИнфо.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагИнфо.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtФайлИнформация: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtФайлИнформация
// ============================================================

Функция ДиагностикаМетаОбъектаFileInfo()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtФайлИнформация ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtFileInfo: " + (typeof QtFileInfo !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtФайлИнформация: " + (typeof QtФайлИнформация !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        инфо = Новый QtФайлИнформация()
        Если инфо == null Тогда
            инфо = new QtФайлИнформация()
            Если инфо == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtФайлИнформация()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtФайлИнформация:")
    методы = Object.getOwnPropertyNames(инфо)
    прототип = Object.getPrototypeOf(инфо)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof инфо[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof инфо.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = инфо.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtФайлИнформация (QtFileInfo)
// ============================================================

Функция ТестQtFileInfoFull()
    всегоТестов = 0
    успешноТестов = 0
    
    тестоваяПапка = "C:/Temp2"
    тестовыйФайл = тестоваяПапка + "/test_info.txt"
    
    // ===== ПРОВЕРКА КАТАЛОГА =====
    Попытка
        каталог = Новый QtКаталог(тестоваяПапка)
        Если каталог != null Тогда
            существует = каталог.Существует()
            Если НЕ существует Тогда
                каталог.Создать()
                Если каталог.Существует() Тогда
                    ВывестиСтрокуВКонсоль("✓ Каталог создан: " + тестоваяПапка)
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("✗ Не удалось создать каталог")
                    СброситьЦветКонсоли()
                    Возврат "❌ Тест QtФайлИнформация прерван"
                КонецЕсли
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ Не удалось создать объект QtКаталог")
            СброситьЦветКонсоли()
            Возврат "❌ Тест QtФайлИнформация прерван"
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке каталога: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtФайлИнформация прерван"
    КонецПопытки
    
    // ===== СОЗДАНИЕ ТЕСТОВОГО ФАЙЛА =====
    Попытка
        файл = Новый QtФайл(тестовыйФайл)
        // Используем правильные методы из QtFile
        режим = файл.ReadOnly() | файл.WriteOnly() | файл.Truncate() | файл.Text()
        файл.ОткрытьУстройство(режим)
        файл.ЗаписатьСтроку("Тестовая строка 1")
        файл.ЗаписатьСтроку("Тестовая строка 2")
        файл.ЗаписатьСтроку("Тестовая строка 3")
        файл.ЗакрытьУстройство()
        ВывестиСтрокуВКонсоль("✓ Тестовый файл создан: " + тестовыйФайл)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Не удалось создать тестовый файл: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtФайлИнформация прерван"
    КонецПопытки

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА (без пути) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта (без пути)")
    СброситьЦветКонсоли()
    
    инфо = null
    Попытка
        инфо = Новый QtФайлИнформация()
        инфо.РежимОтладки(Режим_Отладки)
        Если инфо != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtФайлИнформация создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtФайлИнформация НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если инфо == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка файла")
    СброситьЦветКонсоли()
    
    Попытка
        инфо.УстановитьФайл(тестовыйФайл)
        путь = инфо.ПолучитьПуть()
        ВывестиСтрокуВКонсоль("    УстановитьФайл() -> ПолучитьПуть(): " + путь)
        
        Если путь == тестовыйФайл Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Файл установлен корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Файл установлен некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА СУЩЕСТВОВАНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка существования")
    СброситьЦветКонсоли()
    
    Попытка
        существует = инфо.Существует()
        ВывестиСтрокуВКонсоль("    Существует(): " + существует + " (ожидается true)")
        
        Если существует == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка существования работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Файл не найден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ИНФОРМАЦИЯ О ПУТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Информация о пути")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    абсПуть = ""
    имяФайла = ""
    имяБезРасш = ""
    расширение = ""
    
    Попытка
        абсПуть = инфо.АбсолютныйПуть()
        имяФайла = инфо.ИмяФайла()
        имяБезРасш = инфо.ИмяБезРасширения()
        расширение = инфо.Расширение()
        полноеИмя = инфо.ПолноеИмяБезРасширения()
        имяКаталога = инфо.ИмяКаталога()
        
        ВывестиСтрокуВКонсоль("    АбсолютныйПуть(): " + абсПуть)
        ВывестиСтрокуВКонсоль("    ИмяКаталога(): " + имяКаталога)
        ВывестиСтрокуВКонсоль("    ИмяФайла(): " + имяФайла)
        ВывестиСтрокуВКонсоль("    ИмяБезРасширения(): " + имяБезРасш)
        ВывестиСтрокуВКонсоль("    ПолноеИмяБезРасширения(): " + полноеИмя)
        ВывестиСтрокуВКонсоль("    Расширение(): " + расширение)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при получении информации о пути: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И абсПуть != "" И имяФайла != "" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Информация о пути работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Информация о пути не работает")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 5. ИНФОРМАЦИЯ О РАЗМЕРЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Информация о размере")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        размер = инфо.Размер()
        размерКб = инфо.РазмерВКб()
        размерМб = инфо.РазмерВМб()
        размерСтр = инфо.РазмерСтрокой()
        ВывестиСтрокуВКонсоль("    Размер(): " + размер + " байт")
        ВывестиСтрокуВКонсоль("    РазмерВКб(): " + размерКб + " КБ")
        ВывестиСтрокуВКонсоль("    РазмерВМб(): " + размерМб + " МБ")
        ВывестиСтрокуВКонсоль("    РазмерСтрокой(): " + размерСтр)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при получении размера: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И размер > 0 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Информация о размере работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Информация о размере не работает")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 6. ИНФОРМАЦИЯ О ВРЕМЕНИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Информация о времени")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        времяСозд = инфо.ВремяСоздания()
        времяИзм = инфо.ВремяИзменения()
        времяЧт = инфо.ВремяЧтения()
        времяСоздСтр = инфо.ВремяСозданияСтрокой()
        времяИзмСтр = инфо.ВремяИзмененияСтрокой()
        ВывестиСтрокуВКонсоль("    ВремяСоздания(): " + времяСозд)
        ВывестиСтрокуВКонсоль("    ВремяИзменения(): " + времяИзм)
        ВывестиСтрокуВКонсоль("    ВремяЧтения(): " + времяЧт)
        ВывестиСтрокуВКонсоль("    ВремяСозданияСтрокой(): " + времяСоздСтр)
        ВывестиСтрокуВКонсоль("    ВремяИзмененияСтрокой(): " + времяИзмСтр)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при получении времени: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И времяСозд > 0 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Информация о времени работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Информация о времени не работает")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 7. ПРОВЕРКИ СВОЙСТВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверки свойств")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        доступенЧт = инфо.ДоступенДляЧтения()
        доступенЗап = инфо.ДоступенДляЗаписи()
        исполняемый = инфо.Исполняемый()
        скрытый = инфо.Скрытый()
        симлинк = инфо.СимволическаяСсылка()
        явлФайлом = инфо.ЯвляетсяФайлом()
        явлКаталогом = инфо.ЯвляетсяКаталогом()
        абсолютный = инфо.Абсолютный()
        относительный = инфо.Относительный()
        действителен = инфо.Действителен()
        
        ВывестиСтрокуВКонсоль("    ДоступенДляЧтения(): " + доступенЧт)
        ВывестиСтрокуВКонсоль("    ДоступенДляЗаписи(): " + доступенЗап)
        ВывестиСтрокуВКонсоль("    Исполняемый(): " + исполняемый)
        ВывестиСтрокуВКонсоль("    Скрытый(): " + скрытый)
        ВывестиСтрокуВКонсоль("    СимволическаяСсылка(): " + симлинк)
        ВывестиСтрокуВКонсоль("    ЯвляетсяФайлом(): " + явлФайлом)
        ВывестиСтрокуВКонсоль("    ЯвляетсяКаталогом(): " + явлКаталогом)
        ВывестиСтрокуВКонсоль("    Абсолютный(): " + абсолютный)
        ВывестиСтрокуВКонсоль("    Относительный(): " + относительный)
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при проверке свойств: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И доступенЧт == true И явлФайлом == true Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверки свойств работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Проверки свойств не работают")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 8. ОБНОВЛЕНИЕ ИНФОРМАЦИИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Обновление информации")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        размерДо = инфо.Размер()
        ВывестиСтрокуВКонсоль("    Размер до обновления: " + размерДо)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при получении размера: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    // Изменяем файл
    Если тестПройден Тогда
        Попытка
            файл2 = Новый QtФайл(тестовыйФайл)
            режим = файл2.ReadOnly() | файл2.WriteOnly() | файл2.Append() | файл2.Text()
            файл2.ОткрытьУстройство(режим)
            файл2.ЗаписатьСтроку("Новая строка для обновления")
            файл2.ЗакрытьУстройство()
            ВывестиСтрокуВКонсоль("    Файл изменён")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ошибка при изменении файла: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            инфо.Обновить()
            размерПосле = инфо.Размер()
            ВывестиСтрокуВКонсоль("    Размер после обновления: " + размерПосле)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ошибка при Обновить(): " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
    КонецЕсли
    
    Если тестПройден И размерПосле > размерДо Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Обновление информации работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Обновление информации не работает")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 9. ОЧИСТКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Очистка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        // Удаляем тестовый файл
        файл3 = Новый QtФайл(тестовыйФайл)
        результат = файл3.УдалитьФайл()
        ВывестиСтрокуВКонсоль("    УдалитьФайл(): " + результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при удалении: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            инфо.Обновить()
            существуетПосле = инфо.Существует()
            ВывестиСтрокуВКонсоль("    Существует после удаления: " + существуетПосле + " (ожидается false)")
            
            Если существуетПосле == false Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Файл удалён")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Файл не удалён")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ошибка при проверке: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    КонецЕсли

    // ===== 10. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof инфо.RusFunc === 'function' Тогда
            jsonStr = инфо.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtФайлИнформация завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtФайлИнформация (QtFileInfo)                  ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtFileInfo()
    ДиагностикаМетаОбъектаFileInfo()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtФайлИнформация (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtFileInfoFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtФайлИнформация: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


