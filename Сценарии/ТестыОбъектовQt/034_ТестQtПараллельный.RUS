//№    Тест    Статус
//1    Создание объекта    ✅
//2    Проверка валидности    ✅
//3    Запуск асинхронно (runAsync/ЗапуститьАсинхронно)    ✅
//5    Обработка массива (processArray/ОбработатьМассив)    ✅
//6    Копирование (copyTo/КопироватьВ)    ✅



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПараллельный
// ============================================================

Функция ДиагностикаМетодовQtConcurrentRunner()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПараллельный ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПараллельный: " + (typeof QtПараллельный !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПараллельный: " + e)
    КонецПопытки;
    
    Попытка
        диагРаннер = Новый QtПараллельный()
        Если диагРаннер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПараллельный не создан")
            Возврат
        КонецЕсли;
        
        диагРаннер.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПараллельный создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "runAsync", "runAsyncWithArg", "processArray", "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРаннер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ЗапуститьАсинхронно", "ЗапуститьАсинхронноСАргументом", "ОбработатьМассив", "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРаннер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагРаннер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагРаннер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПараллельный: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtПараллельный
// ============================================================
Функция ТестQtConcurrentRunnerFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        раннер = Новый QtПараллельный()
        Если раннер != null Тогда
            раннер.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПараллельный создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПараллельный НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtПараллельный провален (ошибка создания)"
    КонецПопытки;
    
    Если раннер == null Тогда
        Возврат "❌ Тест QtПараллельный провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        валидный = раннер.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = раннер.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

// ===== 3. ЗАПУСК АСИНХРОННО =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Запуск асинхронно")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

Попытка
    выполнено = ЛОЖЬ
    функция1 = Функция() {       выполнено = ИСТИНА   }
    watcher = раннер.runAsync(функция1)
    Если watcher != null Тогда
        watcher.waitForFinished()
        ВывестиСтрокуВКонсоль("    [ENG] runAsync: задача выполнена, выполнено=" + выполнено)
        
        Если выполнено == ИСТИНА Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Запуск асинхронно работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Задача не выполнена")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] watcher не создан")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецПопытки

Если тестПройден Тогда
    Попытка
        выполненоРус = ЛОЖЬ
        функцияРус = function() {
            выполненоРус = ИСТИНА
        }
        watcherРус = раннер.ЗапуститьАсинхронно(функцияРус)
        Если watcherРус != null Тогда
            // Используем английский метод waitForFinished, так как русские методы не добавлены
            watcherРус.waitForFinished()
            ВывестиСтрокуВКонсоль("    [RUS] ЗапуститьАсинхронно: задача выполнена, выполнено=" + выполненоРус)
            
            Если выполненоРус == ИСТИНА Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Запуск асинхронно работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Задача не выполнена")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] watcher не создан")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
    КонецПопытки
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли

Если тестРусский И англУспех И русУспех Тогда
    успешноТестов = успешноТестов + 1
КонецЕсли

// ===== 5. ОБРАБОТКА МАССИВА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Обработка массива")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

Попытка
    обработаноИндексов = 0
    массив = [1, 2, 3, 4, 5]
    функцияМассив = function(item, index) {
        обработаноИндексов = обработаноИндексов + 1
    }
    watcher3 = раннер.processArray(массив, функцияМассив)
    Если watcher3 != null Тогда
        watcher3.waitForFinished()
        ВывестиСтрокуВКонсоль("    [ENG] processArray: обработано элементов=" + обработаноИндексов + " (ожидается 5)")
        
        Если обработаноИндексов == 5 Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Обработка массива работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 5, получено " + обработаноИндексов)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] watcher не создан")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецПопытки

Если тестПройден Тогда
    Попытка
        обработаноИндексовРус = 0
        массивРус = [10, 20, 30, 40, 50]
        функцияМассивРус = function(item, index) {
            обработаноИндексовРус = обработаноИндексовРус + 1
        }
        watcher3Рус = раннер.ОбработатьМассив(массивРус, функцияМассивРус)
        Если watcher3Рус != null Тогда
            // Используем английский метод waitForFinished
            watcher3Рус.waitForFinished()
            ВывестиСтрокуВКонсоль("    [RUS] ОбработатьМассив: обработано элементов=" + обработаноИндексовРус + " (ожидается 5)")
            
            Если обработаноИндексовРус == 5 Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Обработка массива работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 5, получено " + обработаноИндексовРус)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] watcher не создан")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
    КонецПопытки
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли

Если тестРусский И англУспех И русУспех Тогда
    успешноТестов = успешноТестов + 1
КонецЕсли


    // ===== 6. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        копияЦель = НовыйОбъект("QtПараллельный")
        Если копияЦель != null Тогда
            успех = раннер.copyTo(копияЦель)
            Если успех Тогда
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: копия isValid: " + валидность)
                Если валидность == ИСТИНА Тогда
                    англУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [ENG] Копирование работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [ENG] Копирование не работает")
                    СброситьЦветКонсоли()
                    тестПройден = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            копияЦельРус = НовыйОбъект("QtПараллельный")
            Если копияЦельРус != null Тогда
                успехРус = раннер.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    валидностьРус = копияЦельРус.Действителен()
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: копия Действителен: " + валидностьРус)
                    Если валидностьРус == ИСТИНА Тогда
                        русУспех = ИСТИНА
                        УстановитьЦветКонсоли("green")
                        ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
                        СброситьЦветКонсоли()
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ [RUS] Копирование не работает")
                        СброситьЦветКонсоли()
                        тестРусский = ЛОЖЬ
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПараллельный завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.14  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtПараллельный (QtConcurrentRunner)                  ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtConcurrentRunner()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПараллельный (русские и английские методы)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtConcurrentRunnerFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПараллельный: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

