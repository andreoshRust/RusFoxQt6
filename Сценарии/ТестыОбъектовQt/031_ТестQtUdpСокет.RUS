//Итоги тестирования QtUdpSocket (QtUdpСокет):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtUdpSocket
//✅ Проверка состояния (ПолучитьСостояние, СостояниеСтрокой, Привязан, Валидный)
//✅ Проверка адресов (ЛокальныйАдрес, ЛокальныйПорт)
//✅ Проверка привязки к порту (bindValue)
//✅ Проверка записи без привязки (возвращает -1)
//✅ Проверка чтения без привязки (возвращает пустую строку)
//✅ Проверка дескриптора (возвращает -1 для не открытого сокета)
//✅ Проверка констант состояний
//✅ Проверка мультикаст групп (joinMulticastGroup, leaveMulticastGroup)
//✅ Получение реального объекта (ПолучитьUdpСокет)
//✅ Проверка RusFunc (93 метода в JSON)
//✅ Проверка ожиданий (все возвращают false для не привязанного сокета)
//Диагностика показала:
//30 английских методов доступны
//30 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 7850, 93 элемента)
//Класс QtUdpSocket (наследник QtAbstractSocket) предоставляет:
//Управление привязкой - ПривязатьКПорту, ПривязатьКАдресуПорту, ПривязатьСОпциями, Закрыть, Привязан
//Отправка данных - ОтправитьДатаграмму, ОтправитьНаАдрес, ОтправитьНаХост, ОтправитьДатаграммуБайты
//Чтение данных - ЕстьДатаграммы, РазмерДатаграммы, ПрочитатьДатаграмму, ПрочитатьДатаграммуСАдресом, ПрочитатьВсеДатаграммы, ДоступноБайт
//Мультикаст - ПрисоединитьсяКГруппе, ПрисоединитьсяКГруппеИнтерфейс, ПокинутьГруппу, ПокинутьГруппуИнтерфейс, УстановитьМультикастИнтерфейс
//Информация о сокете - ЛокальныйАдрес, ЛокальныйПорт, Дескриптор, РазмерБуфера
//Ожидание событий - ОжидатьГотовностиЧтения, ОжидатьОтправки
//Настройки - УстановитьДескриптор, УстановитьРазмерБуфера
//Колбэки - ПриГотовностиЧтения, ПриОшибке, ПриИзмененииСостояния, ПриОтправкеДанных
//Сигналы - readyRead, bytesWritten, stateChanged, errorOccurred
//Константы - состояния, режимы привязки, режимы открытия
//Вывод:
//Класс QtUdpSocket полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с UDP сокетами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtAbstractSocket, который в свою очередь наследуется от QtIODevice и QtObject, что обеспечивает 
//полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtUdpSocket
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtUdpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtUdpSocket ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtUdpSocket: " + (typeof QtUdpSocket !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtUdpSocket: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtUdpSocket()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtUdpSocket не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtUdpSocket создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtUdpSocket: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtUdpSocket
// ============================================================

Функция ДиагностикаМетаОбъектаUdpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtUdpСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtUdpSocket: " + (typeof QtUdpSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtUdpСокет: " + (typeof QtUdpСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        сокет1 = Новый QtUdpSocket()
        Если сокет1 == null Тогда
            сокет2 = new QtUdpSocket()
            Если сокет2 == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                сокет = сокет2
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtUdpSocket()")
            КонецЕсли;
        Иначе
            сокет = сокет1
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtUdpСокет:")
    методы = Object.getOwnPropertyNames(сокет)
    прототип = Object.getPrototypeOf(сокет)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof сокет[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtUdpSocket (QtUdpСокет) - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtUdpSocketFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    сокет = null
    Попытка
        сокет = Новый QtUdpSocket()
        Если сокет != null Тогда
            сокет.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtUDPСокет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtUDPСокет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если сокет == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = сокет.ПолучитьСостояние()
        состояниеСтр = сокет.СостояниеСтрокой()
        подключен = сокет.Подключен()
        валидный = сокет.Валидный()
        
        ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ")")
        ВывестиСтрокуВКонсоль("    Подключен: " + подключен)
        ВывестиСтрокуВКонсоль("    Валидный: " + валидный)
        
        // Для не подключенного сокета: состояние 0 (UnconnectedState), подключен false, валидный true
        Если состояние == 0 И подключен == false И валидный == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ПРИВЯЗКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка привязки")
    СброситьЦветКонсоли()
    
    Попытка
        // Привязываем к порту 0 (система выберет свободный порт)
        результат = сокет.ПривязатьКПорту(0)
        привязан = сокет.Привязан()
        локПорт = сокет.ЛокальныйПорт()
        
        ВывестиСтрокуВКонсоль("    ПривязатьКПорту(0): " + результат)
        ВывестиСтрокуВКонсоль("    Привязан: " + привязан)
        ВывестиСтрокуВКонсоль("    Локальный порт: " + локПорт)
        
        Если привязан == true И локПорт > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Привязка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Привязка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 4. ПРОВЕРКА ОТПРАВКИ (используя ОтправитьНаАдрес) =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Проверка отправки")
СброситьЦветКонсоли()

Попытка
    // Создаем новый сокет для теста
    сокет4 = Новый QtUdpSocket()
    сокет4.РежимОтладки(Режим_Отладки)
    
    // Привязываем к порту 0
    результатПривязки = сокет4.ПривязатьКПорту(0)
    ВывестиСтрокуВКонсоль("    ПривязатьКПорту(0): " + результатПривязки)
    
    Если результатПривязки == true Тогда
        // Создаем объект адреса
        адрес = "127.0.0.1"
        порт = 9999
        
        // Отправляем датаграмму
        результат = сокет4.ОтправитьНаАдрес(адрес, порт, "test message")
        ВывестиСтрокуВКонсоль("    ОтправитьНаАдрес('127.0.0.1', 9999, 'test message') = " + результат)
        
        Если результат >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отправка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отправка выполнена (возврат " + результат + ")")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("    ⚠ Не удалось привязать сокет, пропускаем тест")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли
    
    // Закрываем сокет
    сокет4.Закрыть()
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
    
    // Пытаемся закрыть сокет
    Попытка
        сокет4.Закрыть()
    Исключение
        // Игнорируем
    КонецПопытки
КонецПопытки

    // ===== 5. ПРОВЕРКА ЧТЕНИЯ (после привязки) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка чтения")
    СброситьЦветКонсоли()
    
    Попытка
        // Сначала привязываем сокет
        сокет.ПривязатьКПорту(0)
        
        // Проверяем наличие датаграмм
        естьДатаграммы = сокет.ЕстьДатаграммы()
        ВывестиСтрокуВКонсоль("    ЕстьДатаграммы() = " + естьДатаграммы + " (ожидается false)")
        
        // Пытаемся прочитать
        данные = сокет.ПрочитатьВсеДанные()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсеДанные() = " + данные + " (ожидается пустая строка)")
        
        Если данные == "" И естьДатаграммы == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПРОВЕРКА ДЕСКРИПТОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка дескриптора")
    СброситьЦветКонсоли()
    
    Попытка
        дескриптор = сокет.ПолучитьДескриптор()
        ВывестиСтрокуВКонсоль("    ПолучитьДескриптор() = " + дескриптор)
        
        Если дескриптор == -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор возвращает -1 для не открытого сокета")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор получен: " + дескриптор)
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА МУЛЬТИКАСТ МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка мультикаст методов")
    СброситьЦветКонсоли()
    
    Попытка
        // Сначала привязываем сокет для мультикаста
        сокет.ПривязатьКПорту(0)
        
        // Проверяем установку мультикаст интерфейса
        сокет.УстановитьМультикастИнтерфейс("0.0.0.0")
        ВывестиСтрокуВКонсоль("    УстановитьМультикастИнтерфейс() - OK")
        
        // Проверяем размер буфера (может не работать в виртуальной среде)
        размерБуфера = сокет.РазмерБуфера()
        ВывестиСтрокуВКонсоль("    РазмерБуфера() = " + размерБуфера)
        
        // Устанавливаем размер буфера
        сокет.УстановитьРазмерБуфера(65536)
        размерБуфера2 = сокет.РазмерБуфера()
        ВывестиСтрокуВКонсоль("    УстановитьРазмерБуфера(65536) -> РазмерБуфера() = " + размерБуфера2)
        
        // Проверяем, что методы существуют (даже если размер не изменился)
        Если размерБуфера >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Мультикаст методы существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Мультикаст методы не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА ПОЛУЧЕНИЯ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = сокет.ПолучитьUdpСокет()
        ВывестиСтрокуВКонсоль("    ПолучитьUdpСокет(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // Закрываем сокет
    Попытка
        сокет.Закрыть()
    Исключение
        // Игнорируем
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtUDPСокет завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtUdpSocket (QtUdpСокет)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtUdpSocket()
    ДиагностикаМетаОбъектаUdpSocket()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtUdpСокет (русские и английские методы)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtUdpSocketFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtUdpСокет: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

