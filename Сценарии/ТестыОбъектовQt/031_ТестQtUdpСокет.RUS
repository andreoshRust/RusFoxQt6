//Итоги тестирования QtUdpSocket (QtUdpСокет):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtUdpSocket
//✅ Проверка состояния (ПолучитьСостояние, СостояниеСтрокой, Привязан, Валидный)
//✅ Проверка адресов (ЛокальныйАдрес, ЛокальныйПорт)
//✅ Проверка привязки к порту (bindValue)
//✅ Проверка записи без привязки (возвращает -1)
//✅ Проверка чтения без привязки (возвращает пустую строку)
//✅ Проверка дескриптора (возвращает -1 для не открытого сокета)
//✅ Проверка констант состояний
//✅ Проверка мультикаст групп (joinMulticastGroup, leaveMulticastGroup)
//✅ Получение реального объекта (ПолучитьUdpСокет)
//✅ Проверка RusFunc (93 метода в JSON)
//✅ Проверка ожиданий (все возвращают false для не привязанного сокета)
//Диагностика показала:
//30 английских методов доступны
//30 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 7850, 93 элемента)
//Класс QtUdpSocket (наследник QtAbstractSocket) предоставляет:
//Управление привязкой - ПривязатьКПорту, ПривязатьКАдресуПорту, ПривязатьСОпциями, Закрыть, Привязан
//Отправка данных - ОтправитьДатаграмму, ОтправитьНаАдрес, ОтправитьНаХост, ОтправитьДатаграммуБайты
//Чтение данных - ЕстьДатаграммы, РазмерДатаграммы, ПрочитатьДатаграмму, ПрочитатьДатаграммуСАдресом, ПрочитатьВсеДатаграммы, ДоступноБайт
//Мультикаст - ПрисоединитьсяКГруппе, ПрисоединитьсяКГруппеИнтерфейс, ПокинутьГруппу, ПокинутьГруппуИнтерфейс, УстановитьМультикастИнтерфейс
//Информация о сокете - ЛокальныйАдрес, ЛокальныйПорт, Дескриптор, РазмерБуфера
//Ожидание событий - ОжидатьГотовностиЧтения, ОжидатьОтправки
//Настройки - УстановитьДескриптор, УстановитьРазмерБуфера
//Колбэки - ПриГотовностиЧтения, ПриОшибке, ПриИзмененииСостояния, ПриОтправкеДанных
//Сигналы - readyRead, bytesWritten, stateChanged, errorOccurred
//Константы - состояния, режимы привязки, режимы открытия
//Вывод:
//Класс QtUdpSocket полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с UDP сокетами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtAbstractSocket, который в свою очередь наследуется от QtIODevice и QtObject, что обеспечивает 
//полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtUdpSocket
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtUdpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtUdpСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtUdpSocket: " + (typeof QtUdpSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtUdpСокет: " + (typeof QtUdpСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtUdpСокет: " + e)
    КонецПопытки;
    
    Попытка
        диагСокет = Новый QtUdpSocket()
        Если диагСокет == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtUdpСокет не создан")
            Возврат
        КонецЕсли;
        
        диагСокет.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtUdpСокет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "bindValue", "bindAddressPort", "bindOptions", "closeValue", "isBoundValue",
            "writeDatagram", "writeDatagramToAddress", "writeDatagramToHost", "writeDatagramBytes",
            "hasPendingDatagramsValue", "pendingDatagramSizeValue", "readDatagramValue", 
            "readDatagramWithAddress", "readAllDatagramValue", "bytesAvailableValue",
            "setSocketDescriptorValue", "getSocketDescriptorValue",
            "getStateValue", "getStateString", "getLocalAddressValue", "getLocalPortValue",
            "socketBufferSize", "setSocketBufferSize",
            "setMulticastInterfaceValue", "joinMulticastGroupValue", "joinMulticastGroupInterface",
            "leaveMulticastGroupValue", "leaveMulticastGroupInterface",
            "waitForReadyReadValue", "waitForBytesWrittenValue",
            "getRealUdpSocket", "isValid"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ПривязатьКПорту", "ПривязатьКАдресуПорту", "ПривязатьСОпциями", "Закрыть", "Привязан",
            "ОтправитьДатаграмму", "ОтправитьНаАдрес", "ОтправитьНаХост", "ОтправитьДатаграммуБайты",
            "ЕстьДатаграммы", "РазмерДатаграммы", "ПрочитатьДатаграмму", 
            "ПрочитатьДатаграммуСАдресом", "ПрочитатьВсеДатаграммы", "ДоступноБайт",
            "УстановитьДескриптор", "ПолучитьДескриптор",
            "ПолучитьСостояние", "СостояниеСтрокой", "ЛокальныйАдрес", "ЛокальныйПорт",
            "РазмерБуфера", "УстановитьРазмерБуфера",
            "УстановитьМультикастИнтерфейс", "ПрисоединитьсяКГруппе", "ПрисоединитьсяКГруппеИнтерфейс",
            "ПокинутьГруппу", "ПокинутьГруппуИнтерфейс",
            "ОжидатьГотовностиЧтения", "ОжидатьОтправки",
            "ПолучитьUdpСокет", "Валидный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСокет.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСокет.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtUdpСокет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtUdpSocket
// ============================================================

Функция ДиагностикаМетаОбъектаUdpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtUdpСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtUdpSocket: " + (typeof QtUdpSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtUdpСокет: " + (typeof QtUdpСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        сокет = Новый QtUdpSocket()
        Если сокет == null Тогда
            сокет = new QtUdpSocket()
            Если сокет == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtUdpSocket()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtUdpСокет:")
    методы = Object.getOwnPropertyNames(сокет)
    прототип = Object.getPrototypeOf(сокет)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof сокет[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtUdpSocket (QtUdpСокет) - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtUdpSocketFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    сокет = null
    Попытка
        сокет = Новый QtUdpSocket()
        Если сокет != null Тогда
            сокет.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtUdpСокет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtUdpСокет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если сокет == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = сокет.ПолучитьСостояние()
        состояниеСтр = сокет.СостояниеСтрокой()
        привязан = сокет.Привязан()
        валидный = сокет.Валидный()
        
        ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ")")
        ВывестиСтрокуВКонсоль("    Привязан: " + привязан)
        ВывестиСтрокуВКонсоль("    Валидный: " + валидный)
        
        Если состояние == сокет.UnconnectedState() И привязан == false И валидный == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА АДРЕСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка адресов")
    СброситьЦветКонсоли()
    
    Попытка
        локАдрес = сокет.ЛокальныйАдрес()
        локПорт = сокет.ЛокальныйПорт()
        
        ВывестиСтрокуВКонсоль("    Локальный адрес: " + локАдрес)
        ВывестиСтрокуВКонсоль("    Локальный порт: " + локПорт)
        
        // Адреса могут быть пустыми для не привязанного сокета
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверка адресов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ПРИВЯЗКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка привязки к порту")
    СброситьЦветКонсоли()
    
    Попытка
        порт = 55555
        результат = сокет.ПривязатьКПорту(порт)
        ВывестиСтрокуВКонсоль("    ПривязатьКПорту(" + порт + ") = " + результат)
        
        // Проверяем состояние после привязки
        привязан = сокет.Привязан()
        ВывестиСтрокуВКонсоль("    Привязан: " + привязан)
        
        // Закрываем сокет после теста
        сокет.Закрыть()
        
        Если результат == true И привязан == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Привязка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Привязка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 5. ПРОВЕРКА ЗАПИСИ (без привязки) =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Проверка записи (без привязки)")
СброситьЦветКонсоли()

Попытка
    // Создаем новый сокет для теста
    сокет5 = Новый QtUdpSocket()
    сокет5.РежимОтладки(Режим_Отладки)
    
    // Тест 5a: Отправка без привязки должна вернуть -1
    результат = сокет5.ОтправитьДатаграмму("test", "localhost", 55555)
    ВывестиСтрокуВКонсоль("    ОтправитьДатаграмму('test', 'localhost', 55555) = " + результат + " (ожидается -1)")
    
    // Тест 5b: Привязка к порту
    // Закрываем сокет перед привязкой, чтобы сбросить состояние
    сокет5.Закрыть()
    
    // Привязываемся к любому свободному порту
    результатBind = сокет5.ПривязатьКПорту(0)
    ВывестиСтрокуВКонсоль("    ПривязатьКПорту(0) = " + результатBind)
    
    Если результатBind Тогда
        // Тест 5c: Отправка после привязки должна работать
        результат2 = сокет5.ОтправитьДатаграмму("test", "localhost", 55555)
        ВывестиСтрокуВКонсоль("    ОтправитьДатаграмму после привязки = " + результат2)
    КонецЕсли
    
    сокет5.Закрыть()
    
    // Проверяем результаты
    Если результат == -1 И результатBind == true Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись работает корректно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Запись работает некорректно (отправка без привязки: " + результат + ", привязка: " + результатBind + ")")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

    // ===== 6. ПРОВЕРКА ЧТЕНИЯ (без привязки) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка чтения (без привязки)")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаем новый сокет без привязки
        сокет2 = Новый QtUdpSocket()
        сокет2.РежимОтладки(Режим_Отладки)
        данные = сокет2.ПрочитатьВсеДатаграммы()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсеДатаграммы() = " + данные + " (ожидается пустая строка)")
        
        Если данные == "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение правильно возвращает пустую строку")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение должно вернуть пустую строку")
            СброситьЦветКонсоли()
        КонецЕсли
        сокет2.Закрыть()
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА ДЕСКРИПТОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка дескриптора")
    СброситьЦветКонсоли()
    
    Попытка
        дескриптор = сокет.ПолучитьДескриптор()
        ВывестиСтрокуВКонсоль("    ПолучитьДескриптор() = " + дескриптор)
        
        // Дескриптор может быть -1 для не открытого сокета
        Если дескриптор == -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор возвращает -1 для не открытого сокета")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА КОНСТАНТ СОСТОЯНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка констант состояний")
    СброситьЦветКонсоли()
    
    Попытка
        неПодключен = сокет.UnconnectedState()
        поискХоста = сокет.HostLookupState()
        подключение = сокет.ConnectingState()
        подключен = сокет.ConnectedState()
        связан = сокет.BoundState()
        закрытие = сокет.ClosingState()
        
        ВывестиСтрокуВКонсоль("    UnconnectedState: " + неПодключен)
        ВывестиСтрокуВКонсоль("    HostLookupState: " + поискХоста)
        ВывестиСтрокуВКонсоль("    ConnectingState: " + подключение)
        ВывестиСтрокуВКонсоль("    ConnectedState: " + подключен)
        ВывестиСтрокуВКонсоль("    BoundState: " + связан)
        ВывестиСтрокуВКонсоль("    ClosingState: " + закрытие)
        
        Если неПодключен >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы состояний работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы состояний не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА МУЛЬТИКАСТ ГРУПП =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка мультикаст групп")
    СброситьЦветКонсоли()
    
    Попытка
        // Для мультикаста нужно привязать сокет к AnyIPv4
        сокет.Закрыть()
        сокет.ПривязатьКАдресуПорту("0.0.0.0", 0)
        
        группа = "224.0.0.1"
        результатJoin = сокет.ПрисоединитьсяКГруппе(группа)
        ВывестиСтрокуВКонсоль("    ПрисоединитьсяКГруппе('" + группа + "') = " + результатJoin)
        
        результатLeave = сокет.ПокинутьГруппу(группа)
        ВывестиСтрокуВКонсоль("    ПокинутьГруппу('" + группа + "') = " + результатLeave)
        
        // Проверяем, что методы не вызывают ошибок
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Мультикаст группы работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА ПОЛУЧЕНИЯ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = сокет.ПолучитьUdpСокет()
        ВывестиСтрокуВКонсоль("    ПолучитьUdpСокет(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА ОЖИДАНИЙ (без привязки) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка ожиданий")
    СброситьЦветКонсоли()
    
    Попытка
        // Проверяем, что методы ожидания не вызывают ошибок
        результат1 = сокет.ОжидатьГотовностиЧтения(100)
        результат2 = сокет.ОжидатьОтправки(100)
        
        ВывестиСтрокуВКонсоль("    ОжидатьГотовностиЧтения(100): " + результат1)
        ВывестиСтрокуВКонсоль("    ОжидатьОтправки(100): " + результат2)
        
        // Все методы должны вернуть false для не привязанного сокета
        Если результат1 == false И результат2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Ожидания работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ожидания работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtUdpСокет завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtUdpSocket (QtUdpСокет)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtUdpSocket()
    ДиагностикаМетаОбъектаUdpSocket()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtUdpСокет (русские и английские методы)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtUdpSocketFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtUdpСокет: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

