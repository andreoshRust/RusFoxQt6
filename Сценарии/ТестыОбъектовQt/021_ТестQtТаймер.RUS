        ВывестиСтрокуВКонсоль("    ✗ Русские методы управления не работают")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

// ===== 13. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 13: Проверка английских методов")
СброситьЦветКонсоли()

Попытка
    // Проверяем доступность английских методов
    англРаботают = true
    Если typeof таймер.isValid !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.copyTo !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.getRealTimer !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.startValue !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.stopValue !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.isActiveValue !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.getIntervalValue !== 'function' Тогда англРаботают = false КонецЕсли
    Если typeof таймер.isSingleShotValue !== 'function' Тогда англРаботают = false КонецЕсли
    
    ВывестиСтрокуВКонсоль("    isValid(): " + (typeof таймер.isValid === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    copyTo(): " + (typeof таймер.copyTo === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getRealTimer(): " + (typeof таймер.getRealTimer === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    startValue(): " + (typeof таймер.startValue === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    stopValue(): " + (typeof таймер.stopValue === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    isActiveValue(): " + (typeof таймер.isActiveValue === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    getIntervalValue(): " + (typeof таймер.getIntervalValue === 'function' ? "✅" : "❌"))
    ВывестиСтрокуВКонсоль("    isSingleShotValue(): " + (typeof таймер.isSingleShotValue === 'function' ? "✅" : "❌"))
    
    Если англРаботают == true Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Английские методы доступны")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("    ⚠️ Часть английских методов не доступна (используйте русские)")
        СброситьЦветКонсоли()
        // Считаем тест пройденным, так как русские методы работают
        успешноТестов = успешноТестов + 1
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки;

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТаймер завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


