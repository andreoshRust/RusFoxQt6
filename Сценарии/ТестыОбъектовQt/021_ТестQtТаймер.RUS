    ВывестиСтрокуВКонсоль("    УстановитьОднократный(true) -> Однократный(): " + однократный + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    Запустить() -> Активен(): " + активен + " (ожидается true)")
    
    Если интервал == 500 И однократный == true И активен == true Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Русские методы управления работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
