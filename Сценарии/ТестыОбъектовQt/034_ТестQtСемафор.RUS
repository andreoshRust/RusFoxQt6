//№    Тест    Статус
//1    Создание объекта    ✅
//2    Проверка валидности    ✅
//3    Доступно ресурсов (available)    ✅
//4    Освобождение ресурсов (release)    ✅
//5    Захват ресурсов (acquire)    ✅
//6    Попытка захвата (tryAcquire)    ✅
//7    Попытка захвата с таймаутом (tryAcquireTimeout)    ✅
//8    Создание с начальным значением    ✅
//9    Получение реального семафора    ✅
//10    Копирование    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtСемафор
// ============================================================

Функция ДиагностикаМетодовQtSemaphore()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtСемафор ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtСемафор: " + (typeof QtСемафор !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtСемафор: " + e)
    КонецПопытки;
    
    Попытка
        диагСемафор = Новый QtСемафор()
        Если диагСемафор == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtСемафор не создан")
            Возврат
        КонецЕсли;
        
        диагСемафор.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtСемафор создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealSemaphore", 
            "acquire", "tryAcquire", "tryAcquireTimeout", "release", "available",
            "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСемафор[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьСемафор",
            "Захватить", "ПопробоватьЗахватить", "ПопробоватьЗахватитьТаймаут", "Освободить", "Доступно",
            "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСемафор[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСемафор.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСемафор.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtСемафор: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtСемафор
// ============================================================
Функция ТестQtSemaphoreFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        семафор = Новый QtСемафор()
        Если семафор != null Тогда
            семафор.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtСемафор создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtСемафор НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtСемафор провален (ошибка создания)"
    КонецПопытки;
    
    Если семафор == null Тогда
        Возврат "❌ Тест QtСемафор провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        валидный = семафор.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = семафор.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 3. ДОСТУПНО РЕСУРСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Доступно ресурсов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        доступно = семафор.available()
        ВывестиСтрокуВКонсоль("    [ENG] available: " + доступно + " (ожидается 0)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И доступно == 0 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] available работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 0, получено " + доступно)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            доступноРус = семафор.Доступно()
            ВывестиСтрокуВКонсоль("    [RUS] Доступно: " + доступноРус + " (ожидается 0)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И доступноРус == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступно работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0, получено " + доступноРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 4. ОСВОБОЖДЕНИЕ РЕСУРСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Освобождение ресурсов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        семафор.release()
        семафор.release(2)
        доступно = семафор.available()
        ВывестиСтрокуВКонсоль("    [ENG] release/release(2)/available: " + доступно + " (ожидается 3)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И доступно == 3 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Освобождение работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 3, получено " + доступно)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            семафор.Освободить()
            семафор.Освободить(2)
            доступноРус = семафор.Доступно()
            ВывестиСтрокуВКонсоль("    [RUS] Освободить/Освободить(2)/Доступно: " + доступноРус + " (ожидается 6)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И доступноРус == 6 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Освобождение работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 6, получено " + доступноРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 5. ЗАХВАТ РЕСУРСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Захват ресурсов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        семафор.acquire()
        семафор.acquire(2)
        доступно = семафор.available()
        ВывестиСтрокуВКонсоль("    [ENG] acquire/acquire(2)/available: " + доступно + " (ожидается 3)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И доступно == 3 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Захват работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 3, получено " + доступно)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            семафор.Захватить()
            семафор.Захватить(2)
            доступноРус = семафор.Доступно()
            ВывестиСтрокуВКонсоль("    [RUS] Захватить/Захватить(2)/Доступно: " + доступноРус + " (ожидается 0)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И доступноРус == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Захват работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0, получено " + доступноРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 6. ПОПЫТКА ЗАХВАТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Попытка захвата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        // Освобождаем ресурсы, чтобы было что захватывать
        семафор.release(3)
        результат = семафор.tryAcquire()
        доступно = семафор.available()
        ВывестиСтрокуВКонсоль("    [ENG] tryAcquire: " + результат + ", available: " + доступно)
        
        Если результат == ИСТИНА Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Попытка захвата работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + результат)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            семафор.Освободить(3)
            результатРус = семафор.ПопробоватьЗахватить()
            доступноРус = семафор.Доступно()
            ВывестиСтрокуВКонсоль("    [RUS] ПопробоватьЗахватить: " + результатРус + ", Доступно: " + доступноРус)
            
            Если результатРус == ИСТИНА Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Попытка захвата работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + результатРус)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 7. ПОПЫТКА ЗАХВАТА С ТАЙМАУТОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Попытка захвата с таймаутом")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        // Освобождаем ресурсы, чтобы было что захватывать
        семафор.release(2)
        результат = семафор.tryAcquireTimeout(1, 100)
        доступно = семафор.available()
        ВывестиСтрокуВКонсоль("    [ENG] tryAcquireTimeout(1, 100): " + результат + ", available: " + доступно)
        
        Если результат == ИСТИНА Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Попытка захвата с таймаутом работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + результат)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            семафор.Освободить(2)
            результатРус = семафор.ПопробоватьЗахватитьТаймаут(1, 100)
            доступноРус = семафор.Доступно()
            ВывестиСтрокуВКонсоль("    [RUS] ПопробоватьЗахватитьТаймаут(1, 100): " + результатРус + ", Доступно: " + доступноРус)
            
            Если результатРус == ИСТИНА Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Попытка захвата с таймаутом работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + результатРус)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 8. СОЗДАНИЕ С НАЧАЛЬНЫМ ЗНАЧЕНИЕМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Создание с начальным значением")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        семафор2 = Новый QtСемафор(5)
        Если семафор2 != null Тогда
            доступно = семафор2.available()
            ВывестиСтрокуВКонсоль("    [ENG] new QtSemaphore(5), available: " + доступно + " (ожидается 5)")
            
            Если доступно == 5 Тогда
                англУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Создание с начальным значением работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 5, получено " + доступно)
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Семафор не создан")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            семафор2Рус = Новый QtСемафор(10)
            Если семафор2Рус != null Тогда
                доступноРус = семафор2Рус.Доступно()
                ВывестиСтрокуВКонсоль("    [RUS] Новый QtСемафор(10), Доступно: " + доступноРус + " (ожидается 10)")
                
                Если доступноРус == 10 Тогда
                    русУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с начальным значением работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10, получено " + доступноРус)
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Семафор не создан")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 9. ПОЛУЧЕНИЕ РЕАЛЬНОГО СЕМАФОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Получение реального семафора")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        реальный = семафор.getRealSemaphore()
        Если реальный != null Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    [ENG] getRealSemaphore: семафор получен")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getRealSemaphore: семафор НЕ получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            реальныйРус = семафор.ПолучитьСемафор()
            Если реальныйРус != null Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьСемафор: семафор получен")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПолучитьСемафор: семафор НЕ получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Получение реального семафора работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Получение реального семафора не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        копияЦель = НовыйОбъект("QtСемафор")
        Если копияЦель != null Тогда
            успех = семафор.copyTo(копияЦель)
            Если успех Тогда
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: копия isValid: " + валидность)
                Если валидность == ИСТИНА Тогда
                    англУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [ENG] Копирование работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [ENG] Копирование не работает")
                    СброситьЦветКонсоли()
                    тестПройден = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            копияЦельРус = НовыйОбъект("QtСемафор")
            Если копияЦельРус != null Тогда
                успехРус = семафор.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    валидностьРус = копияЦельРус.Действителен()
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: копия Действителен: " + валидностьРус)
                    Если валидностьРус == ИСТИНА Тогда
                        русУспех = ИСТИНА
                        УстановитьЦветКонсоли("green")
                        ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
                        СброситьЦветКонсоли()
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ [RUS] Копирование не работает")
                        СброситьЦветКонсоли()
                        тестРусский = ЛОЖЬ
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtСемафор завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


