// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtСписокСтрокМодель
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtStringListModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtStringListModel ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtStringListModel: " + (typeof QtStringListModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtStringListModel: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtStringListModel()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtStringListModel не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtStringListModel создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtStringListModel: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ТЕСТ QtСписокСтрокМодель (QtStringListModel)
// ============================================================

Функция ТестQtStringListModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtСписокСтрокМодель                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtСписокСтрокМодель()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtСписокСтрокМодель создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ СОЗДАНИЯ С СПИСКОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ СОЗДАНИЯ С СПИСКОМ (конструктор с QStringList)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м1 = Новый QtСписокСтрокМодель(["A", "B", "C"])
        м1.РежимОтладки(Режим_Отладки)
        размер = м1.size()
        строка0 = м1.getString(0)
        строка1 = м1.getString(1)
        строка2 = м1.getString(2)
        
        ВывестиСтрокуВКонсоль("  Новый QtСписокСтрокМодель(['A', 'B', 'C'])")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  getString(0) = " + строка0 + " (ожидается A)")
        ВывестиСтрокуВКонсоль("  getString(1) = " + строка1 + " (ожидается B)")
        ВывестиСтрокуВКонсоль("  getString(2) = " + строка2 + " (ожидается C)")
        
        Если размер == 3 И строка0 == "A" И строка1 == "B" И строка2 == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Создание с списком работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Создание с списком работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании с списком: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ ПУСТОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ПУСТОЙ МОДЕЛИ (size, count, isEmpty)                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        размер = модель.size()
        количество = модель.count()
        пусто = модель.isEmpty()
        
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  count() = " + количество + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  isEmpty() = " + пусто + " (ожидается true)")
        
        // Проверка получения строки из пустой модели
        Попытка
            пустаяСтрока = модель.getString(0)
            ВывестиСтрокуВКонсоль("  getString(0) для пустой модели = '" + пустаяСтрока + "' (должна быть пустая строка)")
        Исключение
            ВывестиСтрокуВКонсоль("  ⚠️ getString(0) для пустой модели: " + e)
        КонецПопытки
        
        Если размер == 0 И количество == 0 И пусто == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Пустая модель корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Пустая модель некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой модели: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ ДОБАВЛЕНИЯ СТРОК (английские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ addString() / getString() (английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м2 = Новый QtСписокСтрокМодель()
        м2.РежимОтладки(Режим_Отладки)
        м2.addString("Первый")
        м2.addString("Второй")
        м2.addString("Третий")
        
        размер = м2.size()
        строка0 = м2.getString(0)
        строка1 = м2.getString(1)
        строка2 = м2.getString(2)
        
        ВывестиСтрокуВКонсоль("  addString('Первый'), addString('Второй'), addString('Третий')")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  getString(0) = " + строка0 + " (ожидается Первый)")
        ВывестиСтрокуВКонсоль("  getString(1) = " + строка1 + " (ожидается Второй)")
        ВывестиСтрокуВКонсоль("  getString(2) = " + строка2 + " (ожидается Третий)")
        
        Если размер == 3 И строка0 == "Первый" И строка1 == "Второй" И строка2 == "Третий" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ addString() / getString() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ addString() / getString() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении строк (англ): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ ДОБАВЛЕНИЯ СТРОК (русские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ ДобавитьСтроку() / ПолучитьСтроку() (русские методы)                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м3 = Новый QtСписокСтрокМодель()
        м3.РежимОтладки(Режим_Отладки)
        м3.ДобавитьСтроку("Русский1")
        м3.ДобавитьСтроку("Русский2")
        м3.ДобавитьСтроку("Русский3")
        
        размер = м3.Размер()
        строка0 = м3.ПолучитьСтроку(0)
        строка1 = м3.ПолучитьСтроку(1)
        строка2 = м3.ПолучитьСтроку(2)
        
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('Русский1'), ДобавитьСтроку('Русский2'), ДобавитьСтроку('Русский3')")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(0) = " + строка0 + " (ожидается Русский1)")
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(1) = " + строка1 + " (ожидается Русский2)")
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(2) = " + строка2 + " (ожидается Русский3)")
        
        Если размер == 3 И строка0 == "Русский1" И строка1 == "Русский2" И строка2 == "Русский3" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ДобавитьСтроку() / ПолучитьСтроку() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
