            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ refresh() / Обновить() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при обновлении: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 15. ТЕСТ ПОЛУЧЕНИЯ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 15. ТЕСТ getStringListModel() / ПолучитьМодельСтрок()                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м13 = Новый QtСписокСтрокМодель(["Тест модели"])
        м13.РежимОтладки(Режим_Отладки)
        
        модельСтрок = м13.getStringListModel()
        русМодельСтрок = м13.ПолучитьМодельСтрок()
        
        ВывестиСтрокуВКонсоль("  getStringListModel() вызван, результат: " + (модельСтрок != null ? "не null" : "null"))
        ВывестиСтрокуВКонсоль("  ПолучитьМодельСтрок() вызван, результат: " + (русМодельСтрок != null ? "не null" : "null"))
        
        Если модельСтрок != null И русМодельСтрок != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ getStringListModel() / ПолучитьМодельСтрок() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ getStringListModel() / ПолучитьМодельСтрок() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении модели строк: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 16. ТЕСТ РАБОТЫ С БОЛЬШИМ КОЛИЧЕСТВОМ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 16. ТЕСТ РАБОТЫ С БОЛЬШИМ КОЛИЧЕСТВОМ ДАННЫХ                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м14 = Новый QtСписокСтрокМодель()
        м14.РежимОтладки(Режим_Отладки)
        
        // Добавляем 50 элементов
        Для i = 0 По 49 Цикл
            м14.addString("Строка" + i)
        КонецЦикла
        
        размер = м14.size()
        первый = м14.getString(0)
        последний = м14.getString(49)
        средний = м14.getString(25)
        
        ВывестиСтрокуВКонсоль("  Добавлено 50 строк (0-49)")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 50)")
        ВывестиСтрокуВКонсоль("  getString(0) = " + первый + " (ожидается Строка0)")
        ВывестиСтрокуВКонсоль("  getString(25) = " + средний + " (ожидается Строка25)")
        ВывестиСтрокуВКонсоль("  getString(49) = " + последний + " (ожидается Строка49)")
        
        Если размер == 50 И первый == "Строка0" И средний == "Строка25" И последний == "Строка49" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с большим количеством данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с большим количеством данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с большим количеством данных: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 17. ТЕСТ РАБОТЫ С ПУСТЫМИ СТРОКАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 17. ТЕСТ РАБОТЫ С ПУСТЫМИ СТРОКАМИ                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м15 = Новый QtСписокСтрокМодель()
        м15.РежимОтладки(Режим_Отладки)
        м15.addString("Есть данные")
        м15.addString("")  // Пустая строка
        м15.addString("Тоже данные")
        
        строка1 = м15.getString(0)
        строка2 = м15.getString(1)
        строка3 = м15.getString(2)
        
        ВывестиСтрокуВКонсоль("  addString('Есть данные')")
        ВывестиСтрокуВКонсоль("  addString('') (пустая строка)")
        ВывестиСтрокуВКонсоль("  addString('Тоже данные')")
        ВывестиСтрокуВКонсоль("  getString(0) = '" + строка1 + "' (ожидается 'Есть данные')")
        ВывестиСтрокуВКонсоль("  getString(1) = '" + строка2 + "' (ожидается пустая строка)")
        ВывестиСтрокуВКонсоль("  getString(2) = '" + строка3 + "' (ожидается 'Тоже данные')")
        
        Если строка1 == "Есть данные" И строка2 == "" И строка3 == "Тоже данные" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с пустыми строками корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с пустыми строками некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с пустыми строками: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 18. ТЕСТ КОМБИНИРОВАННЫХ ОПЕРАЦИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 18. ТЕСТ КОМБИНИРОВАННЫХ ОПЕРАЦИЙ                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м16 = Новый QtСписокСтрокМодель()
        м16.РежимОтладки(Режим_Отладки)
        
        // Комбинация операций
        м16.addStrings(["A", "B", "C", "D", "E"])  // 5 элементов
        м16.insertStringAt(2, "X")                  // 6 элементов: A, B, X, C, D, E
        м16.setString(0, "Z")                       // Z, B, X, C, D, E
        м16.removeStringAt(4)                       // Удаляем D (индекс 4): Z, B, X, C, E (5 элементов)
        м16.ДобавитьСтроку("F")                     // 6 элементов: Z, B, X, C, E, F
        м16.ВставитьСтроку(1, "Y")                 // 7 элементов: Z, Y, B, X, C, E, F
        
        список = м16.getStringList()
        размер = м16.size()
        
        ВывестиСтрокуВКонсоль("  addStrings(['A', 'B', 'C', 'D', 'E']) -> 5 элементов")
        ВывестиСтрокуВКонсоль("  insertStringAt(2, 'X') -> 6 элементов: A, B, X, C, D, E")
        ВывестиСтрокуВКонсоль("  setString(0, 'Z') -> Z, B, X, C, D, E")
        ВывестиСтрокуВКонсоль("  removeStringAt(4) -> удаляем D -> Z, B, X, C, E (5 элементов)")
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('F') -> 6 элементов: Z, B, X, C, E, F")
        ВывестиСтрокуВКонсоль("  ВставитьСтроку(1, 'Y') -> 7 элементов: Z, Y, B, X, C, E, F")
        ВывестиСтрокуВКонсоль("  Итоговый список: " + список.join(", "))
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 7)")
        
        // Проверяем конкретные элементы
        элемент0 = м16.getString(0)
        элемент1 = м16.getString(1)
        элемент2 = м16.getString(2)
        элемент3 = м16.getString(3)
        элемент4 = м16.getString(4)
        элемент5 = м16.getString(5)
        элемент6 = м16.getString(6)
        
        ВывестиСтрокуВКонсоль("  getString(0) = " + элемент0 + " (ожидается Z)")
        ВывестиСтрокуВКонсоль("  getString(1) = " + элемент1 + " (ожидается Y)")
        ВывестиСтрокуВКонсоль("  getString(2) = " + элемент2 + " (ожидается B)")
        ВывестиСтрокуВКонсоль("  getString(3) = " + элемент3 + " (ожидается X)")
        ВывестиСтрокуВКонсоль("  getString(4) = " + элемент4 + " (ожидается C)")
        ВывестиСтрокуВКонсоль("  getString(5) = " + элемент5 + " (ожидается E)")
        ВывестиСтрокуВКонсоль("  getString(6) = " + элемент6 + " (ожидается F)")
        
        Если размер == 7 И элемент0 == "Z" И элемент1 == "Y" И элемент2 == "B" И элемент3 == "X" И элемент4 == "C" И элемент5 == "E" И элемент6 == "F" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Комбинированные операции работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Комбинированные операции работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при комбинированных операциях: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtСписокСтрокМодель завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

    Пусть Режим_Отладки = ИСТИНА  // Глобальная переменная
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtСписокСтрокМодель (QtStringListModel)            ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtStringListModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtСписокСтрокМодель (русские и английские методы)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtStringListModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtСписокСтрокМодель: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ