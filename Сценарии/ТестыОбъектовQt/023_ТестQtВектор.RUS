        ВывестиСтрокуВКонсоль("  Получить(0) = " + эл0 + " (ожидается A)")
        ВывестиСтрокуВКонсоль("  Получить(1) = " + эл1 + " (ожидается B)")
        
        Если размер1 == 5 И размер2 == 2 И эл0 == "A" И эл1 == "B" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ИзменитьРазмер() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ИзменитьРазмер() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при ИзменитьРазмер(): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 16. ТЕСТ Зарезервировать() и Ёмкость() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 16. ТЕСТ Зарезервировать() и Ёмкость()                                          │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        вектор16 = Новый QtВектор()
        вектор16.РежимОтладки(ИСТИНА)
        
        ёмкость0 = вектор16.Ёмкость()
        ВывестиСтрокуВКонсоль("  Исходная ёмкость = " + ёмкость0)
        
        вектор16.Зарезервировать(10)
        ёмкость1 = вектор16.Ёмкость()
        ВывестиСтрокуВКонсоль("  Зарезервировать(10) -> Ёмкость() = " + ёмкость1 + " (ожидается >= 10)")
        
        вектор16.Зарезервировать(20)
        ёмкость2 = вектор16.Ёмкость()
        ВывестиСтрокуВКонсоль("  Зарезервировать(20) -> Ёмкость() = " + ёмкость2 + " (ожидается >= 20)")
        
        Если ёмкость1 >= 10 И ёмкость2 >= 20 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Зарезервировать() и Ёмкость() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Зарезервировать() и Ёмкость() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Зарезервировать(): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 17. ТЕСТ ВМассив() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 17. ТЕСТ ВМассив()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        вектор17 = Новый QtВектор()
        вектор17.РежимОтладки(ИСТИНА)
        вектор17.Добавить("A")
        вектор17.Добавить("B")
        вектор17.Добавить("C")
        
        массив = вектор17.ВМассив()
        
        ВывестиСтрокуВКонсоль("  ВМассив().length = " + массив.length + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  ВМассив()[0] = " + массив[0] + " (ожидается A)")
        ВывестиСтрокуВКонсоль("  ВМассив()[1] = " + массив[1] + " (ожидается B)")
        ВывестиСтрокуВКонсоль("  ВМассив()[2] = " + массив[2] + " (ожидается C)")
        
        Если массив.length == 3 И массив[0] == "A" И массив[1] == "B" И массив[2] == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВМассив() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВМассив() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при ВМассив(): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 18. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 18. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ (числа, строки, булевы)                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        вектор18 = Новый QtВектор()
        вектор18.РежимОтладки(ИСТИНА)
        вектор18.Добавить(42)
        вектор18.Добавить("Строка")
        вектор18.Добавить(ИСТИНА)
        вектор18.Добавить(3.14)
        
        эл0 = вектор18.Получить(0)
        эл1 = вектор18.Получить(1)
        эл2 = вектор18.Получить(2)
        эл3 = вектор18.Получить(3)
        размер = вектор18.Размер()
        
        ВывестиСтрокуВКонсоль("  Получить(0) = " + эл0 + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  Получить(1) = " + эл1 + " (ожидается Строка)")
        ВывестиСтрокуВКонсоль("  Получить(2) = " + эл2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Получить(3) = " + эл3 + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер + " (ожидается 4)")
        
        Если эл0 == 42 И эл1 == "Строка" И эл2 == ИСТИНА И эл3 == 3.14 И размер == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtВектор завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


