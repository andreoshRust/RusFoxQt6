//№    Тест    Статус
//1    Создание объекта    ✅
//2    Проверка валидности    ✅
//3    Состояние нового наблюдателя    ✅
//4    Прогресс (min/max/value/text)    ✅
//5    Получение реального наблюдателя    ✅
//6    Установка колбэков    ✅
//7    Копирование    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtНаблюдательБудущего
// ============================================================

Функция ДиагностикаМетодовQtFutureWatcher()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtНаблюдательБудущего ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtНаблюдательБудущего: " + (typeof QtНаблюдательБудущего !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtНаблюдательБудущего: " + e)
    КонецПопытки;
    
    Попытка
        диагНаблюдатель = Новый QtНаблюдательБудущего()
        Если диагНаблюдатель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtНаблюдательБудущего не создан")
            Возврат
        КонецЕсли;
        
        диагНаблюдатель.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtНаблюдательБудущего создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWatcher", "setFuture", "waitForFinished",
            "isRunning", "isFinished", "isStarted",
            "progressValue", "progressMinimum", "progressMaximum", "progressText",
            "onStarted", "onFinished", "onCanceled", "onPaused", "onResumed",
            "onProgressRangeChanged", "onProgressValueChanged", "onProgressTextChanged",
            "onResultReadyAt", "onResultsReady", "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНаблюдатель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьНаблюдателя", "УстановитьБудущее", "ОжидатьЗавершения",
            "Выполняется", "Завершён", "Запущен",
            "Прогресс", "ПрогрессМинимум", "ПрогрессМаксимум", "ТекстПрогресса",
            "ПриЗапуске", "ПриЗавершении", "ПриОтмене", "ПриПаузе", "ПриВозобновлении",
            "ПриИзмененииДиапазонаПрогресса", "ПриИзмененииПрогресса", "ПриИзмененииТекстаПрогресса",
            "ПриГотовностиРезультата", "ПриГотовностиРезультатов", "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНаблюдатель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагНаблюдатель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагНаблюдатель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtНаблюдательБудущего: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtНаблюдательБудущего
// ============================================================
Функция ТестQtFutureWatcherFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        наблюдатель = Новый QtНаблюдательБудущего()
        Если наблюдатель != null Тогда
            наблюдатель.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtНаблюдательБудущего создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtНаблюдательБудущего НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtНаблюдательБудущего провален (ошибка создания)"
    КонецПопытки;
    
    Если наблюдатель == null Тогда
        Возврат "❌ Тест QtНаблюдательБудущего провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        валидный = наблюдатель.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = наблюдатель.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

// ===== 3. СОСТОЯНИЕ НОВОГО НАБЛЮДАТЕЛЯ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Состояние нового наблюдателя")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

Попытка
    запущен = наблюдатель.isStarted()
    выполняется = наблюдатель.isRunning()
    завершён = наблюдатель.isFinished()
    ВывестиСтрокуВКонсоль("    [ENG] isStarted=" + запущен + ", isRunning=" + выполняется + ", isFinished=" + завершён)
    
    // Ожидаемое состояние: isStarted=true (готов к работе), isRunning=false, isFinished=true (завершён)
    Если запущен == ИСТИНА И выполняется == ЛОЖЬ И завершён == ИСТИНА Тогда
        англУспех = ИСТИНА
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Состояние нового наблюдателя корректно")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, false, true, получено " + запущен + ", " + выполняется + ", " + завершён)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецПопытки

Если тестПройден Тогда
    Попытка
        запущенРус = наблюдатель.Запущен()
        выполняетсяРус = наблюдатель.Выполняется()
        завершёнРус = наблюдатель.Завершён()
        ВывестиСтрокуВКонсоль("    [RUS] Запущен=" + запущенРус + ", Выполняется=" + выполняетсяРус + ", Завершён=" + завершёнРус)
        
        Если запущенРус == ИСТИНА И выполняетсяРус == ЛОЖЬ И завершёнРус == ИСТИНА Тогда
            русУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Состояние нового наблюдателя корректно")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, false, true, получено " + запущенРус + ", " + выполняетсяРус + ", " + завершёнРус)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
    КонецПопытки
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли

Если тестРусский И англУспех И русУспех Тогда
    успешноТестов = успешноТестов + 1
КонецЕсли

    // ===== 4. ПРОГРЕСС =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Прогресс")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        мин = наблюдатель.progressMinimum()
        макс = наблюдатель.progressMaximum()
        значение = наблюдатель.progressValue()
        текст = наблюдатель.progressText()
        ВывестиСтрокуВКонсоль("    [ENG] min=" + мин + ", max=" + макс + ", value=" + значение + ", text='" + текст + "'")
        
        Если мин == 0 И макс == 0 И значение == 0 Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Прогресс работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка в прогрессе")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            минРус = наблюдатель.ПрогрессМинимум()
            максРус = наблюдатель.ПрогрессМаксимум()
            значениеРус = наблюдатель.Прогресс()
            текстРус = наблюдатель.ТекстПрогресса()
            ВывестиСтрокуВКонсоль("    [RUS] минимум=" + минРус + ", максимум=" + максРус + ", значение=" + значениеРус + ", текст='" + текстРус + "'")
            
            Если минРус == 0 И максРус == 0 И значениеРус == 0 Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Прогресс работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка в прогрессе")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО НАБЛЮДАТЕЛЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального наблюдателя")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        реальный = наблюдатель.getRealWatcher()
        Если реальный != null Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    [ENG] getRealWatcher: наблюдатель получен")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getRealWatcher: наблюдатель НЕ получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            реальныйРус = наблюдатель.ПолучитьНаблюдателя()
            Если реальныйРус != null Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьНаблюдателя: наблюдатель получен")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПолучитьНаблюдателя: наблюдатель НЕ получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Получение реального наблюдателя работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Получение реального наблюдателя не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 6. УСТАНОВКА КОЛБЭКОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Установка колбэков")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        вызвано = ЛОЖЬ
        наблюдатель.onStarted(function() {
            вызвано = ИСТИНА
        })
        
        наблюдатель.onFinished(function() {
            вызвано = ИСТИНА
        })
        
        наблюдатель.onProgressValueChanged(function(value) {
            вызвано = ИСТИНА
        })
        
        ВывестиСтрокуВКонсоль("    [ENG] Колбэки установлены")
        англУспех = ИСТИНА
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка колбэков работает")
        СброситьЦветКонсоли()
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            вызваноРус = ЛОЖЬ
            наблюдатель.ПриЗапуске(function() {
                вызваноРус = ИСТИНА
            })
            
            наблюдатель.ПриЗавершении(function() {
                вызваноРус = ИСТИНА
            })
            
            наблюдатель.ПриИзмененииПрогресса(function(value) {
                вызваноРус = ИСТИНА
            })
            
            ВывестиСтрокуВКонсоль("    [RUS] Колбэки установлены")
            русУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка колбэков работает")
            СброситьЦветКонсоли()
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 7. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        копияЦель = НовыйОбъект("QtНаблюдательБудущего")
        Если копияЦель != null Тогда
            успех = наблюдатель.copyTo(копияЦель)
            Если успех Тогда
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: копия isValid: " + валидность)
                Если валидность == ИСТИНА Тогда
                    англУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [ENG] Копирование работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [ENG] Копирование не работает")
                    СброситьЦветКонсоли()
                    тестПройден = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            копияЦельРус = НовыйОбъект("QtНаблюдательБудущего")
            Если копияЦельРус != null Тогда
                успехРус = наблюдатель.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    валидностьРус = копияЦельРус.Действителен()
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: копия Действителен: " + валидностьРус)
                    Если валидностьРус == ИСТИНА Тогда
                        русУспех = ИСТИНА
                        УстановитьЦветКонсоли("green")
                        ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
                        СброситьЦветКонсоли()
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ [RUS] Копирование не работает")
                        СброситьЦветКонсоли()
                        тестРусский = ЛОЖЬ
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtНаблюдательБудущего завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.14  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║           ТЕСТИРОВАНИЕ QtНаблюдательБудущего (QtFutureWatcher)                ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtFutureWatcher()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtНаблюдательБудущего (русские и английские методы)                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtFutureWatcherFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtНаблюдательБудущего: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

