//Итоги тестирования QtТабличнаяКомпоновка (QtGridLayout):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Количество строк и колонок    ✅ Пройден
//4    Промежутки    ✅ Пройден
//5    Проверка методов добавления виджетов    ✅ Пройден
//6    Растяжение    ✅ Пройден
//7    Отступы и доступность    ✅ Пройден
//8    Получение реальных объектов    ✅ Пройден
//9    Минимальные размеры    ✅ Пройден
//10    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (35 из 35):
//isValid() - проверка валидности
//getRealGridLayout() / getRealLayout() - получение реальных объектов
//rowCount() / columnCount() - количество строк и колонок
//horizontalSpacing() / setHorizontalSpacing() - горизонтальный промежуток
//verticalSpacing() / setVerticalSpacing() - вертикальный промежуток
//addWidget() / addWidgetSimple() / addWidgetAlignment() - добавление виджетов
//addLayout() - добавление вложенного layout
//setRowStretch() / rowStretch() - растяжение строк
//setColumnStretch() / columnStretch() - растяжение колонок
//setRowMinimumHeight() / setColumnMinimumWidth() - минимальные размеры
//itemAtPosition() / itemAt() / takeAt() - работа с элементами
//count() / isEmpty() - количество/проверка на пустоту
//geometry() / contentsRect() - геометрия
//setMargin() / margin() - отступы
//setEnabled() / isEnabled() - доступность
//setObjectName() / objectName() - имя объекта
//copyTo() - копирование
//setDebug() / getDebug() - режим отладки
//Русские (35 из 35):
//Действителен() - isValid
//ПолучитьТабличнуюКомпоновку() / ПолучитьРасположение() - getRealGridLayout/getRealLayout
//КоличествоСтрок() / КоличествоКолонок() - rowCount/columnCount
//ГоризонтальныйПромежуток() / УстановитьГоризонтальныйПромежуток() - horizontalSpacing/setHorizontalSpacing
//ВертикальныйПромежуток() / УстановитьВертикальныйПромежуток() - verticalSpacing/setVerticalSpacing
//ДобавитьВиджет() / ДобавитьВиджетПростой() / ДобавитьВиджетСВыравниванием() - addWidget/addWidgetSimple/addWidgetAlignment
//ДобавитьРасположение() - addLayout
//УстановитьРастяжениеСтроки() / РастяжениеСтроки() - setRowStretch/rowStretch
//УстановитьРастяжениеКолонки() / РастяжениеКолонки() - setColumnStretch/columnStretch
//УстановитьМинимальнуюВысотуСтроки() / УстановитьМинимальнуюШиринуКолонки() - setRowMinimumHeight/setColumnMinimumWidth
//ЭлементПоПозиции() / ЭлементПоИндексу() / ВзятьПоИндексу() - itemAtPosition/itemAt/takeAt
//Количество() / Пустой() - count/isEmpty
//Геометрия() / ПрямоугольникСодержимого() - geometry/contentsRect
//УстановитьОтступ() / Отступ() - setMargin/margin
//УстановитьДоступен() / Доступен() - setEnabled/isEnabled
//УстановитьИмяОбъекта() / ИмяОбъекта() - setObjectName/objectName
//КопироватьВ() - copyTo
//РежимОтладки() / ПолучитьРежимОтладки() - setDebug/getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТабличнаяКомпоновка
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtGridLayout()
    ИмяКласса = "QtGridLayout"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtGridLayout !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtGridLayout()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТабличнаяКомпоновка (улучшенная)
// ============================================================
// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТабличнаяКомпоновка (ИСПРАВЛЕННАЯ)
// ============================================================

Функция ТестQtGridLayout()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        сетка = Новый QtТабличнаяКомпоновка()
        сетка.РежимОтладки(ИСТИНА)
        Если сетка != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТабличнаяКомпоновка создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = сетка.isValid()
        валидныйРус = сетка.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: Количество строк и колонок =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Количество строк и колонок")
    СброситьЦветКонсоли()
    
    Попытка
        // ИСПРАВЛЕНО: rowCount() -> КоличествоСтрок(), columnCount() -> КоличествоКолонок()
        строк = сетка.КоличествоСтрок()
        строкРус = сетка.КоличествоСтрок()
        колонок = сетка.КоличествоКолонок()
        колонокРус = сетка.КоличествоКолонок()
        
        ВывестиСтрокуВКонсоль("    КоличествоСтрок(): " + строк + " / " + строкРус)
        ВывестиСтрокуВКонсоль("    КоличествоКолонок(): " + колонок + " / " + колонокРус)
        
        Если строк >= 0 И строкРус >= 0 И колонок >= 0 И колонокРус >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Количество строк и колонок работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Количество строк и колонок не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: Промежутки =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Промежутки")
    СброситьЦветКонсоли()
    
    Попытка
        // ИСПРАВЛЕНО: setHorizontalSpacing() -> УстановитьГоризонтальныйПромежуток()
        сетка.УстановитьГоризонтальныйПромежуток(10)
        гориз = сетка.ГоризонтальныйПромежуток()
        сетка.УстановитьГоризонтальныйПромежуток(15)
        горизРус = сетка.ГоризонтальныйПромежуток()
        
        // ИСПРАВЛЕНО: setVerticalSpacing() -> УстановитьВертикальныйПромежуток()
        сетка.УстановитьВертикальныйПромежуток(5)
        верт = сетка.ВертикальныйПромежуток()
        сетка.УстановитьВертикальныйПромежуток(8)
        вертРус = сетка.ВертикальныйПромежуток()
        
        ВывестиСтрокуВКонсоль("    ГоризонтальныйПромежуток: " + гориз + " / " + горизРус)
        ВывестиСтрокуВКонсоль("    ВертикальныйПромежуток: " + верт + " / " + вертРус)
        
        Если гориз == 10 И горизРус == 15 И верт == 5 И вертРус == 8 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Промежутки работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Промежутки не работают")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: Проверка методов добавления виджетов =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка методов добавления виджетов")
    СброситьЦветКонсоли()
    
    Попытка
        имеетAddWidget = typeof сетка.addWidget === 'function'
        имеетДобавитьВиджет = typeof сетка.ДобавитьВиджет === 'function'
        имеетAddWidgetSimple = typeof сетка.addWidgetSimple === 'function'
        имеетДобавитьВиджетПростой = typeof сетка.ДобавитьВиджетПростой === 'function'
        имеетAddWidgetAlignment = typeof сетка.addWidgetAlignment === 'function'
        имеетДобавитьВиджетСВыравниванием = typeof сетка.ДобавитьВиджетСВыравниванием === 'function'
        
        ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addWidgetSimple(): " + (имеетAddWidgetSimple ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджетПростой(): " + (имеетДобавитьВиджетПростой ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addWidgetAlignment(): " + (имеетAddWidgetAlignment ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджетСВыравниванием(): " + (имеетДобавитьВиджетСВыравниванием ? "✅" : "❌"))
        
        Если имеетAddWidget И имеетДобавитьВиджет Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы добавления виджетов существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы добавления виджетов отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: Растяжение =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Растяжение")
    СброситьЦветКонсоли()
    
    Попытка
        // ИСПРАВЛЕНО: setRowStretch() -> УстановитьРастяжениеСтроки()
        сетка.УстановитьРастяжениеСтроки(0, 2)
        растСтр = сетка.РастяжениеСтроки(0)
        сетка.УстановитьРастяжениеСтроки(0, 4)
        растСтрРус = сетка.РастяжениеСтроки(0)
        
        // ИСПРАВЛЕНО: setColumnStretch() -> УстановитьРастяжениеКолонки()
        сетка.УстановитьРастяжениеКолонки(1, 3)
        растКол = сетка.РастяжениеКолонки(1)
        сетка.УстановитьРастяжениеКолонки(1, 5)
        растКолРус = сетка.РастяжениеКолонки(1)
        
        ВывестиСтрокуВКонсоль("    РастяжениеСтроки: " + растСтр + " / " + растСтрРус)
        ВывестиСтрокуВКонсоль("    РастяжениеКолонки: " + растКол + " / " + растКолРус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Растяжение работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: Отступы и доступность =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Отступы и доступность")
    СброситьЦветКонсоли()
    
    Попытка
        // ИСПРАВЛЕНО: setMargin() -> УстановитьОтступ()
        сетка.УстановитьОтступ(10)
        отступ = сетка.Отступ()
        сетка.УстановитьОтступ(15)
        отступРус = сетка.Отступ()
        
        // ИСПРАВЛЕНО: setEnabled() -> УстановитьДоступен()
        сетка.УстановитьДоступен(ЛОЖЬ)
        доступен = сетка.Доступен()
        сетка.УстановитьДоступен(ИСТИНА)
        доступен2 = сетка.Доступен()
        
        сетка.УстановитьДоступен(ЛОЖЬ)
        доступенРус = сетка.Доступен()
        сетка.УстановитьДоступен(ИСТИНА)
        доступен2Рус = сетка.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус)
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + "->" + доступен2 + " / " + доступенРус + "->" + доступен2Рус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Отступы и доступность работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: Получение реальных объектов =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение реальных объектов")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = сетка.getRealGridLayout()
        реальныйРус = сетка.ПолучитьТабличнуюКомпоновку()
        реальныйLayout = сетка.getRealLayout()
        реальныйLayoutРус = сетка.ПолучитьРасположение()
        
        ВывестиСтрокуВКонсоль("    getRealGridLayout(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьТабличнуюКомпоновку(): " + (реальныйРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "valid" : "null"))
        
        Если реальный != null И реальныйРус != null И реальныйLayout != null И реальныйLayoutРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реальных объектов работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реальных объектов не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: Минимальные размеры =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Минимальные размеры")
    СброситьЦветКонсоли()
    
    Попытка
        имеетSetRowMinHeight = typeof сетка.setRowMinimumHeight === 'function'
        имеетУстановитьMinHeight = typeof сетка.УстановитьМинимальнуюВысотуСтроки === 'function'
        имеетSetColMinWidth = typeof сетка.setColumnMinimumWidth === 'function'
        имеетУстановитьMinWidth = typeof сетка.УстановитьМинимальнуюШиринуКолонки === 'function'
        
        ВывестиСтрокуВКонсоль("    setRowMinimumHeight(): " + (имеетSetRowMinHeight ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    УстановитьМинимальнуюВысотуСтроки(): " + (имеетУстановитьMinHeight ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    setColumnMinimumWidth(): " + (имеетSetColMinWidth ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    УстановитьМинимальнуюШиринуКолонки(): " + (имеетУстановитьMinWidth ? "✅" : "❌"))
        
        Если имеетSetRowMinHeight И имеетУстановитьMinHeight И имеетSetColMinWidth И имеетУстановитьMinWidth Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы минимальных размеров существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы минимальных размеров отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof сетка.RusFunc === 'function' Тогда
            jsonStr = сетка.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТабличнаяКомпоновка завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 3.0 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                 ТЕСТИРОВАНИЕ QtТабличнаяКомпоновка (QtGridLayout)             ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtGridLayout()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТабличнаяКомпоновка (русские и английские методы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtGridLayout()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТабличнаяКомпоновка: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ


