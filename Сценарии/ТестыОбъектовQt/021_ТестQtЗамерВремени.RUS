//Итоги тестирования QtElapsedTimer (QtЗамерВремени):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtElapsedTimer
//✅ Проверка валидности (Действителен)
//✅ Измерение времени в миллисекундах (Прошло)
//✅ Измерение времени в секундах (ПрошлоСекунд)
//✅ Проверка истечения времени (Истек)
//✅ Оставшееся время (ОсталосьВремени)
//✅ Перезапуск таймера (Перезапустить)
//✅ Сброс таймера (Сбросить)
//✅ Запуск таймера (Запустить)
//✅ Копирование (КопироватьВ)
//✅ Измерение времени в микросекундах (ПрошлоМикросекунд)
//✅ Проверка RusFunc
//Диагностика показала:
//14 английских методов доступны
//14 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 3200, 38 элементов)
//Класс QtElapsedTimer (наследник QtObject) предоставляет:
//Управление таймером - Запустить, Перезапустить, Сбросить, СброситьВремя
//Получение времени - Прошло, ПрошлоМиллисекунд, ПрошлоСекунд, ПрошлоМикросекунд, ПрошлоНаносекунд
//Проверки - Действителен, Истек, ОсталосьВремени
//Копирование - КопироватьВ
//Получение объекта - ПолучитьТаймер
//Вывод:
//Класс QtElapsedTimer полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для измерения времени как на английском, 
//так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЗамерВремени
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtElapsedTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЗамерВремени ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtElapsedTimer: " + (typeof QtElapsedTimer !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtЗамерВремени: " + (typeof QtЗамерВремени !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЗамерВремени: " + e)
    КонецПопытки;
    
    Попытка
        диагТаймер = Новый QtЗамерВремени()
        Если диагТаймер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЗамерВремени не создан")
            Возврат
        КонецЕсли;
        
        диагТаймер.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtЗамерВремени создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "start", "restart", "invalidate", "reset",
            "elapsed", "elapsedMilliseconds", "elapsedSeconds",
            "elapsedMicroseconds", "elapsedNanoseconds",
            "hasExpired", "remainingTime",
            "copyTo", "getRealTimer"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "Действителен", "Запустить", "Перезапустить", "Сбросить", "СброситьВремя",
            "Прошло", "ПрошлоМиллисекунд", "ПрошлоСекунд",
            "ПрошлоМикросекунд", "ПрошлоНаносекунд",
            "Истек", "ОсталосьВремени",
            "КопироватьВ", "ПолучитьТаймер"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаймер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаймер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЗамерВремени: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtЗамерВремени
// ============================================================

Функция ДиагностикаМетаОбъектаElapsedTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЗамерВремени ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtElapsedTimer: " + (typeof QtElapsedTimer !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЗамерВремени: " + (typeof QtЗамерВремени !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        таймер = Новый QtЗамерВремени()
        Если таймер == null Тогда
            таймер = new QtЗамерВремени()
            Если таймер == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtЗамерВремени()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЗамерВремени:")
    методы = Object.getOwnPropertyNames(таймер)
    прототип = Object.getPrototypeOf(таймер)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof таймер[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof таймер.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = таймер.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtЗамерВремени (QtElapsedTimer) - ИСПРАВЛЕННАЯ ВЕРСИЯ 3
// ============================================================

Функция ТестQtElapsedTimerFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        таймер = Новый QtЗамерВремени()
        таймер.РежимОтладки(Режим_Отладки)
        Если таймер != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЗамерВремени создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЗамерВремени НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если таймер == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли
    
    // Запускаем таймер
    таймер.Запустить()

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        действителен = таймер.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен + " (ожидается true)")
        
        Если действителен == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ИЗМЕРЕНИЕ ВРЕМЕНИ В МИЛЛИСЕКУНДАХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Измерение времени в миллисекундах")
    СброситьЦветКонсоли()
    
    Попытка
        старт = таймер.ПрошлоВремени()
        Пауза(50)
        финиш = таймер.ПрошлоВремени()
        разница = финиш - старт
        
        ВывестиСтрокуВКонсоль("    ПрошлоВремени(): старт=" + старт + "мс, финиш=" + финиш + "мс, разница=" + разница + "мс")
        
        Если разница >= 10 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Измерение времени в миллисекундах работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Измерение времени в миллисекундах не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ИЗМЕРЕНИЕ ВРЕМЕНИ В СЕКУНДАХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Измерение времени в секундах")
    СброситьЦветКонсоли()
    
    Попытка
        секСтарт = таймер.ПрошлоСекунд()
        Пауза(50)
        секФиниш = таймер.ПрошлоСекунд()
        секРазница = секФиниш - секСтарт
        
        ВывестиСтрокуВКонсоль("    ПрошлоСекунд(): старт=" + секСтарт + "с, финиш=" + секФиниш + "с, разница=" + секРазница + "с")
        
        Если секРазница >= 0.01 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Измерение времени в секундах работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Измерение времени в секундах не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 5. ПРОВЕРКА ИСТЕЧЕНИЯ ВРЕМЕНИ (ИСПРАВЛЕННАЯ ВЕРСИЯ) =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Проверка истечения времени")
СброситьЦветКонсоли()

Попытка
    таймер5 = Новый QtЗамерВремени()
    таймер5.РежимОтладки(Режим_Отладки)
    таймер5.Запустить()
    
    // Ждем ровно 100 мс
    Пауза(100)
    
    // Получаем реальное время
    реальноеВремя = таймер5.ПрошлоВремени()
    
    // Используем большие отступы для надежности
    // Проверяем, что время НЕ истекло (таймаут больше реального времени)
    истек1 = таймер5.Истек(реальноеВремя + 50)  // должно быть false
    // Проверяем, что время истекло (таймаут меньше реального времени)
    истек2 = таймер5.Истек(реальноеВремя - 50)  // должно быть true
    
    ВывестиСтрокуВКонсоль("    Реальное время: " + реальноеВремя + "мс")
    ВывестиСтрокуВКонсоль("    Истек(" + (реальноеВремя + 50) + "): " + истек1 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    Истек(" + (реальноеВремя - 50) + "): " + истек2 + " (ожидается true)")
    
    Если истек1 == false И истек2 == true Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверка истечения времени работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Проверка истечения времени не работает")
        ВывестиСтрокуВКонсоль("      истек1=" + истек1 + " (ожидается false), истек2=" + истек2 + " (ожидается true)")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

// Дополнительная диагностика
ВывестиСтрокуВКонсоль("    Дополнительная диагностика:")
Для i = 0 По 5 Цикл
    текущее = таймер5.ПрошлоВремени()
    истекло = таймер5.Истек(текущее + 5)
    ВывестиСтрокуВКонсоль("      Время=" + текущее + "мс, Истек(" + (текущее+5) + ")=" + истекло)
    Пауза(10)
КонецЦикла;



// ===== 6. ОСТАВШЕЕСЯ ВРЕМЯ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 6: Оставшееся время")
СброситьЦветКонсоли()

Попытка
    таймер6 = Новый QtЗамерВремени()
    таймер6.РежимОтладки(Режим_Отладки)
    таймер6.Запустить()
    
    Пауза(100)
    реальноеВремя = таймер6.ПрошлоВремени()
    
    осталось1 = таймер6.ОсталосьВремени(реальноеВремя + 50)  // должно быть > 0
    осталось2 = таймер6.ОсталосьВремени(реальноеВремя - 10)  // должно быть 0
    
    ВывестиСтрокуВКонсоль("    Реальное время: " + реальноеВремя + "мс")
    ВывестиСтрокуВКонсоль("    ОсталосьВремени(" + (реальноеВремя + 50) + "): " + осталось1 + "мс (ожидается > 0)")
    ВывестиСтрокуВКонсоль("    ОсталосьВремени(" + (реальноеВремя - 10) + "): " + осталось2 + "мс (ожидается 0)")
    
    Если осталось1 > 0 И осталось2 == 0 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Оставшееся время работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Оставшееся время не работает")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

    // ===== 7. ПЕРЕЗАПУСК ТАЙМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Перезапуск таймера")
    СброситьЦветКонсоли()
    
    Попытка
        таймер7 = Новый QtЗамерВремени()
        таймер7.РежимОтладки(Режим_Отладки)
        таймер7.Запустить()
        
        Пауза(50)
        времяДо = таймер7.ПрошлоВремени()
        таймер7.Перезапустить()
        времяСразу = таймер7.ПрошлоВремени()
        
        ВывестиСтрокуВКонсоль("    Время до перезапуска: " + времяДо + "мс")
        ВывестиСтрокуВКонсоль("    Время сразу после: " + времяСразу + "мс (ожидается < 20)")
        
        Если времяСразу < 20 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Перезапуск таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Перезапуск таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. СБРОС ТАЙМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Сброс таймера")
    СброситьЦветКонсоли()
    
    Попытка
        валидДо = таймер.Действителен()
        таймер.Сбросить()
        валидПосле = таймер.Действителен()
        таймер.Запустить()
        валидПослеСтарта = таймер.Действителен()
        
        ВывестиСтрокуВКонсоль("    Действителен до сброса: " + валидДо + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен после сброса: " + валидПосле + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    Действителен после запуска: " + валидПослеСтарта + " (ожидается true)")
        
        Если валидДо == true И валидПосле == false И валидПослеСтарта == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Сброс таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Сброс таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ЗАПУСК ТАЙМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Запуск таймера")
    СброситьЦветКонсоли()
    
    Попытка
        таймер.Сбросить()
        валидДо = таймер.Действителен()
        таймер.Запустить()
        валидПосле = таймер.Действителен()
        
        ВывестиСтрокуВКонсоль("    Действителен до запуска: " + валидДо + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    Действителен после запуска: " + валидПосле + " (ожидается true)")
        
        Если валидДо == false И валидПосле == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запуск таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запуск таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Копирование")
    СброситьЦветКонсоли()
    
    Попытка
        цель = Новый QtЗамерВремени()
        цель.РежимОтладки(Режим_Отладки)
        цель.Запустить()
        
        результат = таймер.КопироватьВ(цель)
        времяОригинала = таймер.ПрошлоВремени()
        времяКопии = цель.ПрошлоВремени()
        
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат)
        ВывестиСтрокуВКонсоль("    Время оригинала: " + времяОригинала + "мс")
        ВывестиСтрокуВКонсоль("    Время копии: " + времяКопии + "мс")
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ИЗМЕРЕНИЕ В МИКРОСЕКУНДАХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Измерение в микросекундах")
    СброситьЦветКонсоли()
    
    Попытка
        таймер11 = Новый QtЗамерВремени()
        таймер11.РежимОтладки(Режим_Отладки)
        таймер11.Запустить()
        
        Пауза(10)
        мкс = таймер11.ПолучитьМикросекунды()
        мс = таймер11.ПрошлоВремени()
        
        ВывестиСтрокуВКонсоль("    ПолучитьМикросекунды(): " + мкс + " мкс")
        ВывестиСтрокуВКонсоль("    ПрошлоВремени(): " + мс + " мс")
        
        // Проверяем, что микросекунды есть и они больше миллисекунд
        // (микросекунды должны быть как минимум больше миллисекунд)
        Если мкс > 0 И мкс >= мс Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Измерение в микросекундах работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Измерение в микросекундах не работает (мкс=" + мкс + ", мс=" + мс + ")")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таймер.RusFunc === 'function' Тогда
            jsonStr = таймер.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtЗамерВремени завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtЗамерВремени (QtElapsedTimer)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtElapsedTimer()
    ДиагностикаМетаОбъектаElapsedTimer()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtЗамерВремени (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtElapsedTimerFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtЗамерВремени: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


