        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 8. РЕКУРСИВНЫЙ МЬЮТЕКС =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Рекурсивный мьютекс")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        рекурсивныйМьютекс = Новый QtМьютекс(1)
        Если рекурсивныйМьютекс != null Тогда
            рекурсивныйМьютекс.РежимОтладки(ИСТИНА)
            рекурсивныйМьютекс.lock()
            рекурсивныйМьютекс.lock()  // Вторая блокировка рекурсивного мьютекса должна работать
            рекурсивныйМьютекс.unlock()
            рекурсивныйМьютекс.unlock()
            
            рек = рекурсивныйМьютекс.isRecursive()
            ВывестиСтрокуВКонсоль("    [ENG] recursive mutex isRecursive: " + рек + " (ожидается true)")
            
            Если рек == ИСТИНА Тогда
                англУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Рекурсивный мьютекс работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + рек)
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Рекурсивный мьютекс не создан")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            рекурсивныйМьютексРус = Новый QtМьютекс(1)
            Если рекурсивныйМьютексРус != null Тогда
                рекурсивныйМьютексРус.РежимОтладки(ИСТИНА)
                рекурсивныйМьютексРус.Заблокировать()
                рекурсивныйМьютексРус.Заблокировать()
                рекурсивныйМьютексРус.Разблокировать()
                рекурсивныйМьютексРус.Разблокировать()
                
                рекРус = рекурсивныйМьютексРус.РекурсивныйМьютекс()
                ВывестиСтрокуВКонсоль("    [RUS] РекурсивныйМьютекс: " + рекРус + " (ожидается true)")
                
                Если рекРус == ИСТИНА Тогда
                    русУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Рекурсивный мьютекс работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + рекРус)
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Рекурсивный мьютекс не создан")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
