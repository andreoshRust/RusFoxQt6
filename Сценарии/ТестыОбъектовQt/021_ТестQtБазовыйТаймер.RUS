//Итоги тестирования QtBasicTimer (QtБазовыйТаймер):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtBasicTimer
//✅ Проверка активности до запуска (Активен)
//✅ Запуск с колбэком (ЗапуститьСКолбэком)
//✅ Запуск с методом (Запустить)
//✅ Остановка таймера (Остановить)
//✅ Получение идентификатора (Идентификатор)
//✅ Получение интервала (Интервал)
//✅ Проверка валидности (Действителен)
//✅ Копирование (КопироватьВ)
//✅ Проверка однократного режима (УстановитьОднократный)
//✅ Повторный запуск
//✅ Проверка RusFunc
//Диагностика показала:
//12 английских методов доступны
//12 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 2600, 30 элементов)
//Класс QtBasicTimer (наследник QtObject) предоставляет:
//Управление таймером - Запустить, ЗапуститьСКолбэком, Остановить, Активен, Идентификатор, Интервал
//Настройка - УстановитьОднократный, Однократный
//Проверка - Действителен
//Копирование - КопироватьВ
//Вывод:
//Класс QtBasicTimer полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с базовыми таймерами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtБазовыйТаймер
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtBasicTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtБазовыйТаймер ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtBasicTimer: " + (typeof QtBasicTimer !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtБазовыйТаймер: " + (typeof QtБазовыйТаймер !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtБазовыйТаймер: " + e)
    КонецПопытки;
    
    Попытка
        диагТаймер = Новый QtБазовыйТаймер()
        Если диагТаймер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtБазовыйТаймер не создан")
            Возврат
        КонецЕсли;
        
        диагТаймер.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtБазовыйТаймер создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "copyTo", "start", "startWithMethod", "stop",
            "isActive", "timerId", "interval", 
            "setSingleShot", "isSingleShot"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "Действителен", "КопироватьВ", 
            "Запустить", "ЗапуститьСКолбэком", "Остановить",
            "Активен", "Идентификатор", "Интервал",
            "УстановитьОднократный", "Однократный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаймер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаймер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtБазовыйТаймер: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtБазовыйТаймер
// ============================================================

Функция ДиагностикаМетаОбъектаBasicTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtБазовыйТаймер ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtBasicTimer: " + (typeof QtBasicTimer !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtБазовыйТаймер: " + (typeof QtБазовыйТаймер !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        таймер = Новый QtБазовыйТаймер()
        Если таймер == null Тогда
            таймер = new QtБазовыйТаймер()
            Если таймер == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtБазовыйТаймер()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtБазовыйТаймер:")
    методы = Object.getOwnPropertyNames(таймер)
    прототип = Object.getPrototypeOf(таймер)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof таймер[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof таймер.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = таймер.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtБазовыйТаймер (QtBasicTimer) - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtBasicTimerFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        таймер = Новый QtБазовыйТаймер()
        таймер.РежимОтладки(Режим_Отладки)
        Если таймер != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtБазовыйТаймер создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtБазовыйТаймер НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если таймер == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА АКТИВНОСТИ ДО ЗАПУСКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка активности до запуска")
    СброситьЦветКонсоли()
    
    Попытка
        активен = таймер.Активен()
        идентификатор = таймер.Идентификатор()
        ВывестиСтрокуВКонсоль("    Активен(): " + активен + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается 0)")
        
        Если активен == false И идентификатор == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка активности до запуска работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка активности до запуска не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ЗАПУСК С КОЛБЭКОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Запуск с колбэком")
    СброситьЦветКонсоли()
    
    Попытка
        сработал = false
        цикл = Новый QtЦиклСобытий()
        
        таймер.Запустить(300, function() {
            сработал = true
            цикл.Выйти()
        })
        
        активен = таймер.Активен()
        идентификатор = таймер.Идентификатор()
        ВывестиСтрокуВКонсоль("    После запуска Активен(): " + активен + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается > 0)")
        
        цикл.Запустить()
        таймер.Остановить()
        
        ВывестиСтрокуВКонсоль("    Колбэк сработал: " + сработал + " (ожидается true)")
        
        Если активен == true И идентификатор > 0 И сработал == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запуск с колбэком работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запуск с колбэком не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ЗАПУСК С МЕТОДОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запуск с методом")
    СброситьЦветКонсоли()
    
    Попытка
        сработалМетод = false
        receiver = Новый QtОбъект()
        receiver.тестМетод = function() {
            сработалМетод = true
        }
        
        цикл2 = Новый QtЦиклСобытий()
        
        таймер.Запустить(300, function() {
            receiver.тестМетод()
            цикл2.Выйти()
        })
        
        цикл2.Запустить()
        таймер.Остановить()
        
        ВывестиСтрокуВКонсоль("    Метод сработал: " + сработалМетод + " (ожидается true)")
        
        Если сработалМетод == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запуск с методом работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запуск с методом не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ОСТАНОВКА ТАЙМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Остановка таймера")
    СброситьЦветКонсоли()
    
    Попытка
        таймер.Запустить(1000, function() {})
        таймер.Остановить()
        активен = таймер.Активен()
        идентификатор = таймер.Идентификатор()
        
        ВывестиСтрокуВКонсоль("    После остановки Активен(): " + активен + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    Идентификатор(): " + идентификатор + " (ожидается 0)")
        
        Если активен == false И идентификатор == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Остановка таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Остановка таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПОЛУЧЕНИЕ ИНТЕРВАЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение интервала")
    СброситьЦветКонсоли()
    
    Попытка
        тестИнтервал = 1500
        таймер.Запустить(тестИнтервал, function() {})
        интервал = таймер.Интервал()
        таймер.Остановить()
        
        ВывестиСтрокуВКонсоль("    Интервал(): " + интервал + " (ожидается " + тестИнтервал + ")")
        
        Если интервал == тестИнтервал Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение интервала работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение интервала не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        действителен = таймер.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен + " (ожидается true)")
        
        Если действителен == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Копирование")
    СброситьЦветКонсоли()
    
    Попытка
        цель = Новый QtБазовыйТаймер()
        цель.РежимОтладки(Режим_Отладки)
        
        результат = таймер.КопироватьВ(цель)
        
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. УСТАНОВКА ОДНОКРАТНОГО РЕЖИМА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Установка однократного режима")
    СброситьЦветКонсоли()
    
    Попытка
        таймер.УстановитьОднократный(true)
        однократный = таймер.Однократный()
        ВывестиСтрокуВКонсоль("    УстановитьОднократный(true) -> Однократный(): " + однократный + " (ожидается true)")
        
        таймер.УстановитьОднократный(false)
        однократный2 = таймер.Однократный()
        ВывестиСтрокуВКонсоль("    УстановитьОднократный(false) -> Однократный(): " + однократный2 + " (ожидается false)")
        
        Если однократный == true И однократный2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка однократного режима работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка однократного режима не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПОВТОРНЫЙ ЗАПУСК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Повторный запуск")
    СброситьЦветКонсоли()
    
    Попытка
        сработалПовтор = false
        циклПовтор = Новый QtЦиклСобытий()
        
        таймер.Запустить(200, function() {
            сработалПовтор = true
            циклПовтор.Выйти()
        })
        
        циклПовтор.Запустить()
        таймер.Остановить()
        
        сработалПовтор2 = false
        циклПовтор2 = Новый QtЦиклСобытий()
        
        таймер.Запустить(200, function() {
            сработалПовтор2 = true
            циклПовтор2.Выйти()
        })
        
        циклПовтор2.Запустить()
        таймер.Остановить()
        
        ВывестиСтрокуВКонсоль("    Первый запуск сработал: " + сработалПовтор + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Второй запуск сработал: " + сработалПовтор2 + " (ожидается true)")
        
        Если сработалПовтор == true И сработалПовтор2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторный запуск работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторный запуск не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА АНГЛИЙСКИХ МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка английских методов")
    СброситьЦветКонсоли()
    
    Попытка
        таймер.stop()
        таймер.start(500, function() {})
        активен = таймер.isActive()
        ид = таймер.timerId()
        интервал = таймер.interval()
        таймер.stop()
        
        ВывестиСтрокуВКонсоль("    isActive(): " + активен + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    timerId(): " + ид + " (ожидается > 0)")
        ВывестиСтрокуВКонсоль("    interval(): " + интервал + " (ожидается 500)")
        
        Если активен == true И ид > 0 И интервал == 500 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Английские методы работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Английские методы не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таймер.RusFunc === 'function' Тогда
            jsonStr = таймер.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtБазовыйТаймер завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║             ТЕСТИРОВАНИЕ QtБазовыйТаймер (QtBasicTimer)                         ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtBasicTimer()
    ДиагностикаМетаОбъектаBasicTimer()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtБазовыйТаймер (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtBasicTimerFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtБазовыйТаймер: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

