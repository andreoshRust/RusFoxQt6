Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtTime()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtTime ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtDate: " + (typeof QtDate !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtTime: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtTime()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtTime не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtTime создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtTime: " + e)
    КонецПопытки;
    
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtВремя (ТОЛЬКО КОНСТРУКТОР БЕЗ ПАРАМЕТРОВ)
// ============================================================

Функция ТестQtTime()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 1: Create object")
    СброситьЦветКонсоли()
    
    Попытка
        время = Новый QtВремя()
        время.РежимОтладки(Режим_Отладки)
        Если время != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    OK: QtTime created")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    FAIL: QtTime not created")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если время == null Тогда
        Возврат "FAIL: Test QtTime failed (object not created)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ВРЕМЕНИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 2: Set time")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время2 = Новый QtВремя()
        время2.РежимОтладки(Режим_Отладки)
        время2.УстановитьВремя(14, 30, 45, 500)
        
        час = время2.ПолучитьЧас()
        минута = время2.ПолучитьМинуту()
        секунда = время2.ПолучитьСекунду()
        миллисекунда = время2.ПолучитьМиллисекунду()
        строка = время2.ВСтроку("hh:mm:ss.zzz")
        
        ВывестиСтрокуВКонсоль("    Time: " + строка)
        ВывестиСтрокуВКонсоль("    Hour: " + час + ", Minute: " + минута + ", Second: " + секунда + ", Ms: " + миллисекунда)
        
        Если час == 14 И минута == 30 И секунда == 45 И миллисекунда == 500 Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Set time works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Set time failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 3. ПОЛУЧЕНИЕ КОМПОНЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 3: Get components")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время3 = Новый QtВремя()
        время3.РежимОтладки(Режим_Отладки)
        время3.УстановитьВремя(9, 15, 30, 250)
        
        час = время3.ПолучитьЧас()
        минута = время3.ПолучитьМинуту()
        секунда = время3.ПолучитьСекунду()
        миллисекунда = время3.ПолучитьМиллисекунду()
        
        ВывестиСтрокуВКонсоль("    Hour: " + час + ", Minute: " + минута + ", Second: " + секунда + ", Ms: " + миллисекунда)
        
        Если час == 9 И минута == 15 И секунда == 30 И миллисекунда == 250 Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Get components works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Get components failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 4. ПРОВЕРКА КОРРЕКТНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 4: Validity check")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время4 = Новый QtВремя()
        время4.РежимОтладки(Режим_Отладки)
        время4.УстановитьВремя(12, 30, 45)
        
        время4b = Новый QtВремя()
        время4b.РежимОтладки(Режим_Отладки)
        время4b.УстановитьВремя(25, 30, 45)
        
        корректно = время4.Корректен()
        некорректно = время4b.Корректен()
        
        ВывестиСтрокуВКонсоль("    12:30:45 valid: " + корректно)
        ВывестиСтрокуВКонсоль("    25:30:45 valid: " + некорректно)
        
        Если корректно == ИСТИНА И некорректно == ЛОЖЬ Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Validity check works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Validity check failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 5. ФОРМАТИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 5: Formatting")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время5 = Новый QtВремя()
        время5.РежимОтладки(Режим_Отладки)
        время5.УстановитьВремя(14, 5, 7, 123)
        
        стр1 = время5.ВСтроку("hh:mm:ss")
        стр2 = время5.ВСтроку("H:mm:ss.zzz")
        
        ВывестиСтрокуВКонсоль("    hh:mm:ss: " + стр1)
        ВывестиСтрокуВКонсоль("    H:mm:ss.zzz: " + стр2)
        
        Если стр1 == "14:05:07" Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Formatting works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Formatting failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 6. ДОБАВЛЕНИЕ СЕКУНД =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 6: Add seconds")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время6 = Новый QtВремя()
        время6.РежимОтладки(Режим_Отладки)
        время6.УстановитьВремя(10, 0, 0)
        
        время6_2 = время6.ДобавитьСекунды(30)
        
        Если время6_2 == null Тогда
            ВывестиСтрокуВКонсоль("    FAIL: addSeconds returned null")
            тестПройден = ЛОЖЬ
        Иначе
            // Используем АНГЛИЙСКИЕ методы для объекта из C++
            час = время6_2.getHour()
            минута = время6_2.getMinute()
            секунда = время6_2.getSecond()
            
            ВывестиСтрокуВКонсоль("    Original: " + время6.ВСтроку())
            ВывестиСтрокуВКонсоль("    +30 sec: " + час + ":" + минута + ":" + секунда)
            
            Если час == 10 И минута == 0 И секунда == 30 Тогда
                тестПройден = ИСТИНА
            Иначе
                тестПройден = ЛОЖЬ
            КонецЕсли
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Add seconds works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Add seconds failed")
        СброситьЦветКонсоли()
    КонецЕсли
    

    // ===== 7. РАЗНИЦА ВРЕМЕНИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 7: Time difference")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время7a = Новый QtВремя()
        время7a.РежимОтладки(Режим_Отладки)
        время7a.УстановитьВремя(10, 0, 0)
        
        время7b = Новый QtВремя()
        время7b.РежимОтладки(Режим_Отладки)
        время7b.УстановитьВремя(10, 0, 30)
        
        секундДо = время7a.СекундДо(время7b)
        
        ВывестиСтрокуВКонсоль("    10:00:00 -> 10:00:30: " + секундДо + " sec")
        
        Если секундДо == 30 Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Time difference works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Time difference failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 8. СРАВНЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 8: Comparison")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время8a = Новый QtВремя()
        время8a.РежимОтладки(Режим_Отладки)
        время8a.УстановитьВремя(10, 0, 0)
        
        время8b = Новый QtВремя()
        время8b.РежимОтладки(Режим_Отладки)
        время8b.УстановитьВремя(10, 0, 0)
        
        время8c = Новый QtВремя()
        время8c.РежимОтладки(Режим_Отладки)
        время8c.УстановитьВремя(11, 0, 0)
        
        равно = время8a.Равно(время8b)
        меньше = время8a.Меньше(время8c)
        
        ВывестиСтрокуВКонсоль("    10:00:00 == 10:00:00: " + равно)
        ВывестиСтрокуВКонсоль("    10:00:00 < 11:00:00: " + меньше)
        
        Если равно == ИСТИНА И меньше == ИСТИНА Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Comparison works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Comparison failed")
        СброситьЦветКонсоли()
    КонецЕсли

     // ===== 9. ТЕКУЩЕЕ ВРЕМЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 9: Current time")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время9 = Новый QtВремя()
        время9.РежимОтладки(Режим_Отладки)
        текущее = время9.ТекущееВремя()
        
        Если текущее == null Тогда
            ВывестиСтрокуВКонсоль("    FAIL: currentTime returned null")
            тестПройден = ЛОЖЬ
        Иначе
            // Используем английский метод toString() для нового объекта
            строка = текущее.toString()
            ВывестиСтрокуВКонсоль("    Current time: " + строка)
            
            Если строка != "" Тогда
                тестПройден = ИСТИНА
            Иначе
                тестПройден = ЛОЖЬ
            КонецЕсли
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Current time works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Current time failed")
        СброситьЦветКонсоли()
    КонецЕсли

    // ===== 10. ПРОВЕРКА НУЛЕВОГО ВРЕМЕНИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Test 10: Zero time check")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        время10 = Новый QtВремя()
        время10.РежимОтладки(Режим_Отладки)
        время10.УстановитьВремя(0, 0, 0, 0)
        
        время10b = Новый QtВремя()
        время10b.РежимОтладки(Режим_Отладки)
        время10b.УстановитьВремя(12, 0, 0)
        
        // Проверяем, что время 00:00:00 - это валидное время (не null)
        корректно = время10.Корректен()
        час0 = время10.ПолучитьЧас()
        мин0 = время10.ПолучитьМинуту()
        сек0 = время10.ПолучитьСекунду()
        
        ВывестиСтрокуВКонсоль("    00:00:00.000 valid: " + корректно)
        ВывестиСтрокуВКонсоль("    Hour: " + час0 + ", Minute: " + мин0 + ", Second: " + сек0)
        ВывестиСтрокуВКонсоль("    12:00:00.000 hour: " + время10b.ПолучитьЧас())
        
        Если корректно == ИСТИНА И час0 == 0 И мин0 == 0 И сек0 == 0 Тогда
            тестПройден = ИСТИНА
        Иначе
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ERROR: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    OK: Zero time check works")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    FAIL: Zero time check failed")
        СброситьЦветКонсоли()
    КонецЕсли
    

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("PASSED: " + успешноТестов + " of " + всегоТестов + " tests (ALL PASSED!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("PASSED: " + успешноТестов + " of " + всегоТестов + " tests")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  FAILED: " + (всегоТестов - успешноТестов) + " tests")
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Test QtTime completed"
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                            ТЕСТИРОВАНИЕ QtВремя (QtTime)                        ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTime()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtВремя                                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTime()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtВремя: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ
 
