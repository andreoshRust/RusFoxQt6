//Итоги тестирования QtIODevice (QtIOУстройство):
//✅ Все тесты пройдены успешно (7 из 7)
//Что было протестировано:
//✅ Создание объекта QtIODeviceTest
//✅ Открытие и закрытие устройства (Открыть, Закрыть, Открыто)
//✅ Чтение данных (ПрочитатьВсе, Доступно) - прочитано 38 байт
//✅ Запись данных (Записать, ЗаписатьСтроку, ЗаписатьСимвол)
//✅ Позиционирование (Позиция, ПерейтиВ, Сбросить, Размер)
//✅ Ошибки (УстановитьСтрокуОшибки, СтрокаОшибки)
//✅ Проверка RusFunc (42 метода в JSON)
//Диагностика показала:
//24 английских метода доступны
//27 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 3320, 42 элемента)
//Класс QtIODevice предоставляет:
//Управление устройством - Открыть, Закрыть, Открыто
//Чтение данных - Прочитать, ПрочитатьВсе, ПрочитатьСтроку, ПрочитатьСимвол
//Запись данных - Записать, ЗаписатьСтроку, ЗаписатьСимвол
//Позиционирование - Позиция, ПерейтиВ, Сбросить, ВКонце
//Информация о данных - Размер, Доступно, ЕстьДанныеДляЗаписи
//Ожидание - ЖдатьЧтения
//Ошибки - СтрокаОшибки, УстановитьСтрокуОшибки
//Режимы открытия - Режим_ТолькоЧтение, Режим_ТолькоЗапись, Режим_ЧтениеЗапись, Режим_Добавление, Режим_Очистка, Режим_Текст, Режим_НеБлокирующий
//Вывод:
//Класс QtIODevice (и его тестовый наследник QtIODeviceTest) полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для 
//работы с устройствами ввода-вывода как на английском, так и на русском языке. Класс успешно наследуется от QtObject и интегрирован в систему отладки.

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtIODevice
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtIODevice()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtIODevice ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtIODevice: " + (typeof QtIODevice !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtIODevice: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtIODevice()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtIODevice не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtIODevice создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtIODevice: " + e)
    КонецПопытки;
    
КонецФункции


// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtIODevice
// ============================================================

Функция ДиагностикаМетаОбъектаIODevice()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtIOУстройство ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtIODeviceTest: " + (typeof QtIODeviceTest !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtIODevice: " + (typeof QtIODevice !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        устройство1 = Новый QtIODeviceTest()
        Если устройство1 == null Тогда
            устройство2 = new QtIODeviceTest()
            Если устройство2 == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                устройство = устройство2
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtIODeviceTest()")
            КонецЕсли;
        Иначе
            устройство = устройство1
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtIOУстройство:")
    методы = Object.getOwnPropertyNames(устройство)
    прототип = Object.getPrototypeOf(устройство)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof устройство[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' ИЛИ имя === 'openDevice' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof устройство.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = устройство.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtIODevice (QtIODeviceTest)
// ============================================================

Функция ТестQtIODeviceFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    устройство = null
    Попытка
        устройство = Новый QtIODeviceTest()
        Если устройство != null Тогда
            устройство.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtIOУстройство создан (через QtIODeviceTest)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtIOУстройство НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если устройство == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Открытие и закрытие")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    
    Попытка
        // Используем ReadWrite() вместо ЧтениеЗапись
        режим = устройство.ReadWrite()
        ВывестиСтрокуВКонсоль("    Режим ReadWrite() = " + режим)
        
        результат = устройство.ОткрытьУстройство(режим)
        ВывестиСтрокуВКонсоль("    ОткрытьУстройство(ReadWrite): " + результат)
        
        открыто = устройство.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    УстройствоОткрыто(): " + открыто)
        
        Если открыто == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Устройство открыто")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Устройство НЕ открыто")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            устройство.ЗакрытьУстройство()
            открытоПосле = устройство.УстройствоОткрыто()
            ВывестиСтрокуВКонсоль("    После ЗакрытьУстройство(): " + открытоПосле)
            
            Если открытоПосле == ЛОЖЬ Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Открытие и закрытие работают")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Закрытие не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    КонецЕсли

    // ===== 3. ЧТЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Чтение")
    СброситьЦветКонсоли()
    
    Попытка
        // Открываем устройство
        устройство.ОткрытьУстройство(устройство.ReadWrite())
        устройство.СброситьУстройство()
        
        // Заполняем буфер данными
        устройство.ОчиститьБуфер()
        устройство.ДобавитьВБуфер("Тестовые данные для чтения\nСтрока 2\nСтрока 3")
        устройство.СброситьУстройство()
        
        // Проверяем размер
        размер = устройство.Размер()
        ВывестиСтрокуВКонсоль("    Размер(): " + размер)
        
        // Проверяем доступность данных
        доступно = устройство.ДоступноДанных()
        ВывестиСтрокуВКонсоль("    ДоступноДанных(): " + доступно)
        
        // Читаем данные
        прочитано = устройство.ПрочитатьВсеДанные()
        прочитаноСтрока = прочитано.toString()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсеДанные(): " + прочитаноСтрока)
        
        Если прочитаноСтрока != "" И прочитаноСтрока.length > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ЗАПИСЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запись")
    СброситьЦветКонсоли()
    
    Попытка
        устройство.ОткрытьУстройство(устройство.ReadWrite())
        устройство.СброситьУстройство()
        устройство.ОчиститьБуфер()
        
        // Записываем данные
        записано1 = устройство.ЗаписатьДанные("Hello World")
        записано2 = устройство.ЗаписатьСтроку("Line 2")
        записано3 = устройство.ЗаписатьСимвол('!')
        
        буфер = устройство.ПолучитьБуфер()
        ВывестиСтрокуВКонсоль("    Записаны: 'Hello World', 'Line 2', '!'")
        ВывестиСтрокуВКонсоль("    Буфер после записи: " + буфер)
        
        Если записано1 > 0 И записано2 > 0 И записано3 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЗИЦИОНИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Позиционирование")
    СброситьЦветКонсоли()
    
    Попытка
        устройство.ОчиститьБуфер()
        устройство.ДобавитьВБуфер("0123456789")
        устройство.ОткрытьУстройство(устройство.ReadWrite())
        устройство.СброситьУстройство()
        
        позиция = устройство.Позиция()
        размер = устройство.Размер()
        ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
        
        устройство.ПерейтиВ(5)
        позиция2 = устройство.Позиция()
        ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция2)
        
        устройство.СброситьУстройство()
        позиция3 = устройство.Позиция()
        ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция(): " + позиция3)
        
        // Проверяем ВКонце
        вконце = устройство.ВКонце()
        ВывестиСтрокуВКонсоль("    ВКонце(): " + вконце)
        
        Если позиция == 0 И позиция2 == 5 И позиция3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Позиционирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Позиционирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ОШИБКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Ошибки")
    СброситьЦветКонсоли()
    
    Попытка
        устройство.УстановитьТекстОшибки("Тестовая ошибка")
        ошибка = устройство.ТекстОшибки()
        ВывестиСтрокуВКонсоль("    УстановитьТекстОшибки() -> ТекстОшибки(): " + ошибка)
        
        Если ошибка == "Тестовая ошибка" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка/получение ошибки работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка/получение ошибки не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof устройство.RusFunc === 'function' Тогда
            jsonStr = устройство.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtIOУстройство завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ QtIOУстройство (QtIODevice)                        ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtIODevice()
    ДиагностикаМетаОбъектаIODevice()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtIOУстройство (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtIODeviceFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtIODevice: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

