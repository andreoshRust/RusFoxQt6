    Пусть Режим_Отладки = ИСТИНА


Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtString()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtString ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtString: " + (typeof QtString !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtString: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtString()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtString не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtString создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtString: " + e)
    КонецПопытки;
    
КонецФункции


ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    ПодавитьВыводОкна(ИСТИНА)   // Подавляем вывод главного окна (консольный режим)
     
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()   // Очищаем консоль
    ДиагностикаМетодовQtString()
    // Счётчики для отчёта
    всегоТестов = 0
    успешноТестов = 0
    
    // Заголовок
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ QtString (англоязычные методы)            ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")

    // ========== 1. СОЗДАНИЕ ОБЪЕКТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtString                                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        строка = Новый QtString("Тестовая строка для проверки методов QtString")
        строка.РежимОтладки(ИСТИНА)
        //Отладка(строка.ПолучитьРежимОтладки())
        ВывестиСтрокуВКонсоль("  ✓ Отладка включена")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtString создан успешно")
        ВывестиСтрокуВКонсоль("    Исходная строка: " + строка.getString())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта")
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 2. ОСНОВНЫЕ МЕТОДЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ОСНОВНЫЕ МЕТОДЫ (базовые операции)                                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // setString / getString
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  >> Вызов setString('Новое значение')")
        строка.setString("Новое значение")
        ВывестиСтрокуВКонсоль("  setString(): ✓")
        ВывестиСтрокуВКонсоль("  >> Вызов getString()")
        ВывестиСтрокуВКонсоль("  getString(): " + строка.getString())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  setString/getString(): ✗ ОШИБКА")
    КонецПопытки
    
    // toString
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  >> Вызов setString('Тест toString')")
        строка.setString("Тест toString")
        ВывестиСтрокуВКонсоль("  >> Вызов toString()")
        ВывестиСтрокуВКонсоль("  toString(): " + строка.toString())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  toString(): ✗ ОШИБКА")
    КонецПопытки
    
    // length / size
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  >> Вызов setString('Привет мир')")
        строка.setString("Привет мир")
        ВывестиСтрокуВКонсоль("  >> Вызов length()")
        ВывестиСтрокуВКонсоль("  length(): " + строка.length())
        ВывестиСтрокуВКонсоль("  >> Вызов size()")
        ВывестиСтрокуВКонсоль("  size(): " + строка.size())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  length/size(): ✗ ОШИБКА")
    КонецПопытки
    
    // isEmpty / isNull
    всегоТестов = всегоТестов + 1
    Попытка
        пустаяСтрока = Новый QtString("")
        пустаяСтрока.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> Вызов isEmpty() для пустой строки")
        ВывестиСтрокуВКонсоль("  isEmpty(): " + пустаяСтрока.isEmpty())
        ВывестиСтрокуВКонсоль("  >> Вызов isNull() для пустой строки")
        ВывестиСтрокуВКонсоль("  isNull(): " + пустаяСтрока.isNull())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  isEmpty/isNull(): ✗ ОШИБКА")
    КонецПопытки;
    
    // clear
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  >> Вызов clear()")
        строка.clear()
        ВывестиСтрокуВКонсоль("  clear(): строка очищена")
        ВывестиСтрокуВКонсоль("  >> Вызов length() после clear")
        ВывестиСтрокуВКонсоль("  длина=" + строка.length())
        ВывестиСтрокуВКонсоль("  >> Вызов setString('Восстановлено')")
        строка.setString("Восстановлено")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  clear(): ✗ ОШИБКА")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 3. ИЗВЛЕЧЕНИЕ ПОДСТРОК ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ИЗВЛЕЧЕНИЕ ПОДСТРОК (left, right, mid, at)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    строка.setString("Программирование на QtString")
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  at(0): " + строка.at(0))
        ВывестиСтрокуВКонсоль("  at(5): " + строка.at(5))
        ВывестиСтрокуВКонсоль("  left(5): " + строка.left(5))
        ВывестиСтрокуВКонсоль("  right(5): " + строка.right(5))
        ВывестиСтрокуВКонсоль("  mid(5): " + строка.mid(5))
        ВывестиСтрокуВКонсоль("  mid(5, 10): " + строка.mid(5, 10))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при извлечении подстрок")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 4. ПРЕОБРАЗОВАНИЕ РЕГИСТРА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ПРЕОБРАЗОВАНИЕ РЕГИСТРА (toLower, toUpper, trimmed, simplified)           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    строка.setString("Тестовая Строка Для Проверки")
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  Исходная: " + строка.getString())
        ВывестиСтрокуВКонсоль("  toUpper(): " + строка.toUpper())
        ВывестиСтрокуВКонсоль("  toLower(): " + строка.toLower())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при преобразовании регистра")
    КонецПопытки
    
    всегоТестов = всегоТестов + 1
    Попытка
        строкаСПробелами = Новый QtString("   Текст   с   пробелами   ")
        строкаСПробелами.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  Исходная с пробелами: '" + строкаСПробелами.getString() + "'")
        ВывестиСтрокуВКонсоль("  trimmed(): '" + строкаСПробелами.trimmed() + "'")
        ВывестиСтрокуВКонсоль("  simplified(): '" + строкаСПробелами.simplified() + "'")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при удалении пробелов")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 5. ПОИСК В СТРОКЕ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ПОИСК В СТРОКЕ (indexOf, lastIndexOf, contains, startsWith, endsWith)     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // === ТЕСТ 1: ЛАТИНИЦА ===
    строка.setString("The quick brown fox jumps over the lazy dog")
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  [Латиница]")
        ВывестиСтрокуВКонсоль("    indexOf('quick'): " + строка.indexOf("quick"))
        ВывестиСтрокуВКонсоль("    indexOf('fox'): " + строка.indexOf("fox"))
        ВывестиСтрокуВКонсоль("    indexOf('the', 20): " + строка.indexOf("the", 20))
        ВывестиСтрокуВКонсоль("    lastIndexOf('the'): " + строка.lastIndexOf("the"))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при поиске (латиница)")
    КонецПопытки
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("    contains('fox'): " + строка.contains("fox"))
        ВывестиСтрокуВКонсоль("    contains('CAT', ЛОЖЬ): " + строка.contains("CAT", ЛОЖЬ))
        ВывестиСтрокуВКонсоль("    startsWith('The'): " + строка.startsWith("The"))
        ВывестиСтрокуВКонсоль("    startsWith('the', ЛОЖЬ): " + строка.startsWith("the", ЛОЖЬ))
        ВывестиСтрокуВКонсоль("    endsWith('dog'): " + строка.endsWith("dog"))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке содержания (латиница)")
    КонецПопытки
    
    // === ТЕСТ 2: КИРИЛЛИЦА ===
    строка.setString("Быстрая коричневая лиса прыгает через ленивую собаку")
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("  [Кириллица]")
        ВывестиСтрокуВКонсоль("    indexOf('лиса'): " + строка.indexOf("лиса"))
        ВывестиСтрокуВКонсоль("    indexOf('собаку'): " + строка.indexOf("собаку"))
        ВывестиСтрокуВКонсоль("    indexOf('зебра'): " + строка.indexOf("зебра"))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при поиске (кириллица)")
    КонецПопытки
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("    lastIndexOf('а'): " + строка.lastIndexOf("а"))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при поиске последнего вхождения (кириллица)")
    КонецПопытки
    
    всегоТестов = всегоТестов + 1
    Попытка
        ВывестиСтрокуВКонсоль("    contains('лиса'): " + строка.contains("лиса"))
        ВывестиСтрокуВКонсоль("    contains('КОТ', ЛОЖЬ): " + строка.contains("КОТ", ЛОЖЬ))
        ВывестиСтрокуВКонсоль("    startsWith('Быстрая'): " + строка.startsWith("Быстрая"))
        ВывестиСтрокуВКонсоль("    endsWith('собаку'): " + строка.endsWith("собаку"))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке содержания (кириллица)")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 6. МОДИФИКАЦИЯ СТРОКИ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. МОДИФИКАЦИЯ СТРОКИ (replace, remove, append, prepend, insert)             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        строкаМод = Новый QtString("Hello World")
        строкаМод.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> replace('World', 'Qt')")
        строкаМод.replace("World", "Qt")
        ВывестиСтрокуВКонсоль("  replace: " + строкаМод.getString())
        
        строкаМод2 = Новый QtString("Hello!!! World!!!")
        строкаМод2.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> remove('!!!')")
        строкаМод2.remove("!!!")
        ВывестиСтрокуВКонсоль("  remove: " + строкаМод2.getString())
        
        строкаМод3 = Новый QtString("Hello")
        строкаМод3.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> append(' World')")
        строкаМод3.append(" World")
        ВывестиСтрокуВКонсоль("  append: " + строкаМод3.getString())
        
        строкаМод4 = Новый QtString("World")
        строкаМод4.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> prepend('Hello ')")
        строкаМод4.prepend("Hello ")
        ВывестиСтрокуВКонсоль("  prepend: " + строкаМод4.getString())
        
        строкаМод5 = Новый QtString("HelloWorld")
        строкаМод5.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  >> insert(5, ' ')")
        строкаМод5.insert(5, " ")
        ВывестиСтрокуВКонсоль("  insert: " + строкаМод5.getString())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при модификации строки")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ========== 7. РАЗДЕЛЕНИЕ СТРОК ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. РАЗДЕЛЕНИЕ СТРОК (split, section)                                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        строкаРазд = Новый QtString("яблоко,банан,вишня,апельсин")
        строкаРазд.РежимОтладки(Режим_Отладки)
        части = строкаРазд.split(",")
        ВывестиСтрокуВКонсоль("  split(','):")
        ВывестиСтрокуВКонсоль("    [0]=" + части[0])
        ВывестиСтрокуВКонсоль("    [1]=" + части[1])
        ВывестиСтрокуВКонсоль("    [2]=" + части[2])
        ВывестиСтрокуВКонсоль("    [3]=" + части[3])
        
        строкаСекц = Новый QtString("a,b,c,d,e,f,g")
        строкаСекц.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  section(',', 2): " + строкаСекц.section(",", 2))
        ВывестиСтрокуВКонсоль("  section(',', 2, 4): " + строкаСекц.section(",", 2, 4))
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при разделении строк")
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 8. ФОРМАТИРОВАНИЕ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ФОРМАТИРОВАНИЕ (arg3)                                                     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // arg3 работает - используем его
    всегоТестов = всегоТестов + 1
    Попытка
        шаблон = Новый QtString("%1 + %2 = %3")
        шаблон.РежимОтладки(Режим_Отладки)
        результат = шаблон.arg3(2, 3, 5)
        ВывестиСтрокуВКонсоль("  arg3(2, 3, 5): " + результат)
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  arg3(): ✗ ОШИБКА")
    КонецПопытки
    
    // Альтернативный способ форматирования через конкатенацию
    всегоТестов = всегоТестов + 1
    Попытка
        имя = "Иван"
        возраст = 25
        результат = "User: " + имя + ", Age: " + возраст
        ВывестиСтрокуВКонсоль("  конкатенация: " + результат)
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  конкатенация: ✗ ОШИБКА")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 9. ПРЕОБРАЗОВАНИЕ ТИПОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ПРЕОБРАЗОВАНИЕ ТИПОВ (toInt, toDouble, toFloat)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        число = Новый QtString("123")
        число.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  toInt('123'): " + число.toInt())
        
        дробь = Новый QtString("3.14159")
        дробь.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  toDouble('3.14159'): " + дробь.toDouble())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  toInt/toDouble(): ✗ ОШИБКА")
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 10. СОЗДАНИЕ ИЗ ЧИСЛА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. СОЗДАНИЕ ИЗ ЧИСЛА (через конструктор)                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        число2 = Новый QtString(String(42))
        число2.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  Из числа 42: " + число2.getString())
        
        дробь2 = Новый QtString(String(3.14159))
        дробь2.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  Из дроби 3.14159: " + дробь2.getString())
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  Из числа/дроби(): ✗ ОШИБКА")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")
    
    // ========== 11. ЦЕПОЧКИ ВЫЗОВОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ЦЕПОЧКИ ВЫЗОВОВ (пошаговый подход)                                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        исходная1 = Новый QtString("  Hello   World  ")
        исходная1.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("  Исходная: '" + исходная1.getString() + "'")
        
        // trimmed() возвращает QString, создаём новый объект
        новаяСтрока = исходная1.trimmed()
        ВывестиСтрокуВКонсоль("  после trimmed(): '" + новаяСтрока + "'")
        исходная2 = Новый QtString(новаяСтрока)
        исходная2.РежимОтладки(Режим_Отладки)
        
        // replace изменяет текущий объект
        исходная2.replace(" ", "_")
        ВывестиСтрокуВКонсоль("  после replace(' ', '_'): '" + исходная2.getString() + "'")
        
        // toUpper() возвращает QString, создаём новый объект
        новаяСтрока2 = исходная2.toUpper()
        ВывестиСтрокуВКонсоль("  после toUpper(): '" + новаяСтрока2 + "'")
        
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при пошаговых вызовах")
    КонецПопытки
    ВывестиСтрокуВКонсоль("")

    // ========== 12. ИТОГОВЫЙ ОТЧЁТ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╠════════════════════════════════════════════════════════════════════════════════╣")
    ВывестиСтрокуВКонсоль("║  Всего тестов: " + всегоТестов + "                                                  ║")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              ║")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  Ошибок:        " + (всегоТестов - успешноТестов) + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        ║")
    КонецЕсли;
    
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ
