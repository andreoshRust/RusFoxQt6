        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении значений: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ Извлечь() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ Извлечь()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х7 = Новый QtХешТаблица()
        х7.РежимОтладки(ИСТИНА)
        х7.Вставить("x", 100)
        х7.Вставить("y", 200)
        х7.Вставить("z", 300)
        
        извлеч1 = х7.take("y")
        извлеч2 = х7.Извлечь("z")
        размер = х7.Размер()
        сод1 = х7.contains("x")
        сод2 = х7.contains("y")
        сод3 = х7.contains("z")
        
        ВывестиСтрокуВКонсоль("  take('y') = " + извлеч1.toString() + " (ожидается 200)")
        ВывестиСтрокуВКонсоль("  Извлечь('z') = " + извлеч2.toString() + " (ожидается 300)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер + " (ожидается 1)")
