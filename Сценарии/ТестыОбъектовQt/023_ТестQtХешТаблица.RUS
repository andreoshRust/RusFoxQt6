        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 12. ТЕСТ ЗАМЕНА ЗНАЧЕНИЯ ПО КЛЮЧУ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 12. ТЕСТ ЗАМЕНА ЗНАЧЕНИЯ ПО КЛЮЧУ (перезапись)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х10 = Новый QtХешТаблица()
        х10.РежимОтладки(ИСТИНА)
        х10.Вставить("ключ", "старое значение")
        х10.Вставить("ключ", "новое значение")
        
        знач = х10.value("ключ")
        размер = х10.Размер()
        
        ВывестиСтрокуВКонсоль("  Вставить('ключ', 'старое значение')")
        ВывестиСтрокуВКонсоль("  Вставить('ключ', 'новое значение')")
        ВывестиСтрокуВКонсоль("  value('ключ') = " + знач.toString() + " (ожидается новое значение)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер + " (ожидается 1)")
        
        Если знач.toString() == "новое значение" И размер == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Замена значения по ключу работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Замена значения по ключу работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при замене значения: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtХешТаблица завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

