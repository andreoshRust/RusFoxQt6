        х6.Вставить("b", "B")
        х6.Вставить("c", "C")
        
        значения1 = х6.values()
        значения2 = х6.Значения()
        
        стрЗнач1 = []
        Для i = 0 По значения1.length - 1 Цикл
            стрЗнач1.push(значения1[i].toString())
        КонецЦикла;
        стрЗнач1.sort()
        
        стрЗнач2 = []
