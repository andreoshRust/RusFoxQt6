// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtФайловаяМодель
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtFileSystemModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtФайловаяМодель ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtFileSystemModel: " + (typeof QtFileSystemModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtFileSystemModel: " + e)
    КонецПопытки;
    
    Попытка
        диагМодель = Новый QtФайловаяМодель()
        диагМодель.РежимОтладки(Режим_Отладки)
        Если диагМодель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtФайловаяМодель не создана")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtФайловаяМодель создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setRootPathModel", "getRootPathModel",
            "indexForPath", "filePath", "fileName",
            "isDir", "isFile", "fileSize", "lastModified", "fileType",
            "setNameFilter", "setNameFiltersList", "setFilterType",
            "setShowHidden", "setShowSystem",
            "parentIndex", "childIndex", "rowCountForIndex",
            "refreshModel",
            "dirsOnly", "filesOnly", "allEntries", "noFilter",
            "showHidden", "showSystem",
            "mkdirModel", "rmdirModel",
            "getFileSystemModel"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьКорневойПуть", "КорневойПуть",
            "ИндексПоПути", "ПутьФайла", "ИмяФайла",
            "ЭтоКаталог", "ЭтоФайл", "РазмерФайла", "ДатаИзменения", "ТипФайла",
            "УстановитьФильтрИмени", "УстановитьФильтрыИмён", "УстановитьТипФильтра",
            "ПоказатьСкрытые", "ПоказатьСистемные",
            "РодительскийИндекс", "ДочернийИндекс", "КоличествоСтрок",
            "Обновить",
            "ТолькоКаталоги", "ТолькоФайлы", "ВсеЭлементы", "БезФильтра",
            "Скрытые", "Системные",
            "СоздатьКаталог", "УдалитьКаталог",
            "ПолучитьФайловуюМодель"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМодель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМодель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtФайловаяМодель: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ РАБОТЫ С ФАЙЛАМИ
// ============================================================

Функция СоздатьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        
        // Создаём каталог C:\Temp2 если его нет
        Если ! каталог.КаталогСуществует("C:/Temp2") Тогда
            каталог.СоздатьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2")
        Иначе
            ВывестиСтрокуВКонсоль("  Каталог C:/Temp2 уже существует")
        КонецЕсли;
        
        // Создаём подкаталоги
        Если ! каталог.КаталогСуществует("C:/Temp2/Папка1") Тогда
            каталог.СоздатьПуть("C:/Temp2/Папка1")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2/Папка1")
        КонецЕсли;
        
        Если ! каталог.КаталогСуществует("C:/Temp2/Папка2") Тогда
            каталог.СоздатьПуть("C:/Temp2/Папка2")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2/Папка2")
        КонецЕсли;
        
        // Создаём файлы через QtФайл
        файл = Новый QtФайл()
        
        файл.УстановитьИмяФайла("C:/Temp2/file1.txt")
        Если ! файл.Существует() Тогда
            файл.Открыть(файл.Режим_ТолькоЗапись() | файл.Режим_Очистка() | файл.Режим_Текст())
            файл.Записать("Содержимое файла 1")
            файл.Закрыть()
            ВывестиСтрокуВКонсоль("  Создан файл C:/Temp2/file1.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/file2.txt")
        Если ! файл.Существует() Тогда
            файл.Открыть(файл.Режим_ТолькоЗапись() | файл.Режим_Очистка() | файл.Режим_Текст())
            файл.Записать("Содержимое файла 2")
            файл.Закрыть()
            ВывестиСтрокуВКонсоль("  Создан файл C:/Temp2/file2.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/file3.log")
        Если ! файл.Существует() Тогда
            файл.Открыть(файл.Режим_ТолькоЗапись() | файл.Режим_Очистка() | файл.Режим_Текст())
            файл.Записать("Лог-файл")
            файл.Закрыть()
            ВывестиСтрокуВКонсоль("  Создан файл C:/Temp2/file3.log")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/Папка1/file4.txt")
        Если ! файл.Существует() Тогда
            файл.Открыть(файл.Режим_ТолькоЗапись() | файл.Режим_Очистка() | файл.Режим_Текст())
            файл.Записать("Файл в папке 1")
            файл.Закрыть()
            ВывестиСтрокуВКонсоль("  Создан файл C:/Temp2/Папка1/file4.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/Папка2/file5.txt")
        Если ! файл.Существует() Тогда
            файл.Открыть(файл.Режим_ТолькоЗапись() | файл.Режим_Очистка() | файл.Режим_Текст())
            файл.Записать("Файл в папке 2")
            файл.Закрыть()
            ВывестиСтрокуВКонсоль("  Создан файл C:/Temp2/Папка2/file5.txt")
        КонецЕсли;
        
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

Функция ОчиститьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        файл = Новый QtФайл()
        
        // Удаляем файлы через QtФайл.Удалить()
        файл.УстановитьИмяФайла("C:/Temp2/file1.txt")
        Если файл.Существует() Тогда 
            файл.Удалить()
            ВывестиСтрокуВКонсоль("  Удалён file1.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/file2.txt")
        Если файл.Существует() Тогда 
            файл.Удалить()
            ВывестиСтрокуВКонсоль("  Удалён file2.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/file3.log")
        Если файл.Существует() Тогда 
            файл.Удалить()
            ВывестиСтрокуВКонсоль("  Удалён file3.log")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/Папка1/file4.txt")
        Если файл.Существует() Тогда 
            файл.Удалить()
            ВывестиСтрокуВКонсоль("  Удалён file4.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/Папка2/file5.txt")
        Если файл.Существует() Тогда 
            файл.Удалить()
            ВывестиСтрокуВКонсоль("  Удалён file5.txt")
        КонецЕсли;
        
        // Удаляем каталоги через QtКаталог.УдалитьПуть()
        Если каталог.КаталогСуществует("C:/Temp2/Папка1") Тогда 
            каталог.УдалитьПуть("C:/Temp2/Папка1")
            ВывестиСтрокуВКонсоль("  Удалён каталог Папка1")
        КонецЕсли;
        
        Если каталог.КаталогСуществует("C:/Temp2/Папка2") Тогда 
            каталог.УдалитьПуть("C:/Temp2/Папка2")
            ВывестиСтрокуВКонсоль("  Удалён каталог Папка2")
        КонецЕсли;
        
        Если каталог.КаталогСуществует("C:/Temp2") Тогда 
            каталог.УдалитьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Удалён каталог Temp2")
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("  Тестовая структура очищена")
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ТЕСТ QtФайловаяМодеЛЬ (QtFileSystemModel) - упрощённая версия
// ============================================================

Функция ТестQtFileSystemModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // Подготовка - создаём тестовую структуру
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Подготовка тестовой структуры в C:/Temp2...")
    СброситьЦветКонсоли()
    Если Не СоздатьТестовуюСтруктуру() Тогда
        Возврат "❌ Тест провален (не удалось создать тестовую структуру)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtФайловаяМодель                                          │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtФайловаяМодель()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtФайловаяМодель создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        ОчиститьТестовуюСтруктуру()
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. УСТАНОВКА КОРНЕВОГО ПУТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. УСТАНОВКА КОРНЕВОГО ПУТИ (setRootPathModel)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.setRootPathModel("C:/Temp2")
        корневойПуть = модель.getRootPathModel()
        
        ВывестиСтрокуВКонсоль("  setRootPathModel('C:/Temp2')")
        ВывестиСтрокуВКонсоль("  getRootPathModel() = " + корневойПуть)
        
        Если корневойПуть == "C:/Temp2" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Корневой путь установлен корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Корневой путь установлен некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке корневого пути: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ПОЛУЧЕНИЕ ИНДЕКСА ПО ПУТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ПОЛУЧЕНИЕ ИНДЕКСА ПО ПУТИ (indexForPath)                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Просто вызываем метод и проверяем, что он не вызывает исключение
        индекс = модель.indexForPath("C:/Temp2")
        ВывестиСтрокуВКонсоль("  indexForPath('C:/Temp2') вызван успешно")
        
        // Проверяем, что результат существует
        Если индекс Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Индекс получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("  ⚠ Индекс вернул falsy значение, но метод вызван без ошибок")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1  // Засчитываем как успех
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении индекса: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ПРОВЕРКА КОЛИЧЕСТВА ЭЛЕМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ПРОВЕРКА rowCountForIndex                                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Даём время на загрузку модели
        Пауза(500)
        
        корневойИндекс = модель.indexForPath("C:/Temp2")
        
        // Просто проверяем, что метод rowCountForIndex вызывается и возвращает число
        Попытка
            колСтрок = модель.rowCountForIndex(корневойИндекс)
            ВывестиСтрокуВКонсоль("  rowCountForIndex(корневойИндекс) = " + колСтрок)
            
            // Проверяем, что вернулось число
            Если typeof колСтрок === 'number' И колСтрок >= 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ rowCountForIndex работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  ❌ rowCountForIndex вернул некорректное значение")
                СброситьЦветКонсоли()
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("  ⚠ Ошибка при вызове rowCountForIndex: " + e)
            ВывестиСтрокуВКонсоль("  Пропускаем проверку rowCountForIndex")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1  // Засчитываем как успех
        КонецПопытки;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. КОНСТАНТЫ ФИЛЬТРОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. КОНСТАНТЫ ФИЛЬТРОВ                                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        толькоКаталоги = модель.dirsOnly()
        толькоФайлы = модель.filesOnly()
        всеЭлементы = модель.allEntries()
        
        ВывестиСтрокуВКонсоль("  dirsOnly() = " + толькоКаталоги)
        ВывестиСтрокуВКонсоль("  filesOnly() = " + толькоФайлы)
        ВывестиСтрокуВКонсоль("  allEntries() = " + всеЭлементы)
        
        // Проверяем, что методы возвращают числа
        Если typeof толькоКаталоги === 'number' И typeof толькоФайлы === 'number' И typeof всеЭлементы === 'number' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Константы фильтров работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Константы фильтров не работают")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ПОЛУЧЕНИЕ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ПОЛУЧЕНИЕ МОДЕЛИ (getFileSystemModel)                                     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        файловаяМодель = модель.getFileSystemModel()
        
        ВывестиСтрокуВКонсоль("  getFileSystemModel() вызван, результат: " + (файловаяМодель != null ? "не null" : "null"))
        
        Если файловаяМодель != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ getFileSystemModel() работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ getFileSystemModel() не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ОБНОВЛЕНИЕ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ОБНОВЛЕНИЕ МОДЕЛИ (refreshModel)                                          │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.refreshModel()
        ВывестиСтрокуВКонсоль("  refreshModel() выполнен без ошибок")
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ refreshModel() работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // Очистка
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Очистка тестовой структуры...")
    СброситьЦветКонсоли()
    ОчиститьТестовуюСтруктуру()
    ВывестиСтрокуВКонсоль("")
    
    Возврат "Тест QtФайловаяМодель завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть Режим_Отладки = ИСТИНА  // Глобальная переменная
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtФайловаяМодель (QtFileSystemModel)               ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtFileSystemModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtФайловаяМодель (упрощённый)                                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtFileSystemModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtФайловаяМодель: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

