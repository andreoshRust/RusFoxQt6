//Итоги тестирования QtПроксиСтиль (QtProxyStyle):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Получение имени стиля    ✅ Пройден
//4    Работа с базовым стилем    ✅ Пройден
//5    Получение обёртки базового стиля    ✅ Пройден
//6    Получение пиксельного размера    ✅ Пройден
//7    Проверка нативности стиля    ✅ Пройден
//8    Получение стандартной иконки    ✅ Пройден
//9    Копирование объекта    ✅ Пройден
//10    Получение реального прокси-стиля    ✅ Пройден
//11    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (21 из 21):
//isValid() - проверка валидности
//getRealProxyStyle() - получение реального прокси-стиля
//name() - имя стиля
//setBaseStyle() - установка базового стиля
//getBaseStyle() - получение базового стиля
//setBaseStyleWrapper() - установка базового стиля через обёртку
//getBaseStyleWrapper() - получение обёртки базового стиля
//standardIcon() - стандартная иконка
//pixelMetric() - пиксельный размер
//sizeFromContents() - размер из содержимого
//drawPrimitive() - отрисовка примитива
//drawControl() - отрисовка контрола
//drawComplexControl() - отрисовка сложного контрола
//hitTestComplexControl() - тест сложного контрола
//subElementRect() - прямоугольник подэлемента
//subControlRect() - прямоугольник подконтрола
//getStyleForWidget() - стиль для виджета
//isNativeStyle() - нативный стиль
//copyTo() - копирование
//setDebug() - установка режима отладки
//getDebug() - получение режима отладки
//Русские (21 из 21):
//Действителен() - isValid
//ПолучитьПроксиСтиль() - getRealProxyStyle
//Имя() - name
//УстановитьБазовыйСтиль() - setBaseStyle
//БазовыйСтиль() - getBaseStyle
//УстановитьБазовыйСтильОбёртку() - setBaseStyleWrapper
//БазовыйСтильОбёртка() - getBaseStyleWrapper
//СтандартнаяИконка() - standardIcon
//ПиксельныйРазмер() - pixelMetric
//РазмерИзСодержимого() - sizeFromContents
//НарисоватьПримитив() - drawPrimitive
//НарисоватьКонтрол() - drawControl
//НарисоватьСложныйКонтрол() - drawComplexControl
//ПопаданиеСложногоКонтрола() - hitTestComplexControl
//ПрямоугольникПодэлемента() - subElementRect
//ПрямоугольникПодконтрола() - subControlRect
//СтильДляВиджета() - getStyleForWidget
//НативныйСтиль() - isNativeStyle
//КопироватьВ() - copyTo
//РежимОтладки() - setDebug
//ПолучитьРежимОтладки() - getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПроксиСтиль
// ============================================================


Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtProxyStyle()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtProxyStyle ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtProxyStyle: " + (typeof QtProxyStyle !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtProxyStyle: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtProxyStyle()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtProxyStyle не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtProxyStyle создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtProxyStyle: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtПроксиСтиль (улучшенная)
// ============================================================

Функция ТестQtProxyStyle()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        прокси = Новый QtПроксиСтиль()
        прокси.РежимОтладки(ИСТИНА)
        Если прокси != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПроксиСтиль создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = прокси.isValid()
        валидныйРус = прокси.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: name() / Имя() - ИСПРАВЛЕНО =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Получение имени стиля")
    СброситьЦветКонсоли()
    
    Попытка
        // Используем getName() вместо name()
        имя = прокси.getName()
        имяРус = прокси.Имя()
        ВывестиСтрокуВКонсоль("    getName(): " + имя)
        ВывестиСтрокуВКонсоль("    Имя(): " + имяРус)
        
        Если имя != "" И имя != null И имяРус != "" И имяРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение имени работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение имени не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: Работа с базовым стилем =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Работа с базовым стилем")
    СброситьЦветКонсоли()
    
    Попытка
        базовый = прокси.getBaseStyle()
        базовыйРус = прокси.БазовыйСтиль()
        ВывестиСтрокуВКонсоль("    getBaseStyle(): " + (базовый != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    БазовыйСтиль(): " + (базовыйРус != null ? "valid" : "null"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Работа с базовым стилем работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: Обёртка базового стиля =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение обёртки базового стиля")
    СброситьЦветКонсоли()
    
    Попытка
        обёртка = прокси.getBaseStyleWrapper()
        обёрткаРус = прокси.БазовыйСтильОбёртка()
        ВывестиСтрокуВКонсоль("    getBaseStyleWrapper(): " + (обёртка != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    БазовыйСтильОбёртка(): " + (обёрткаРус != null ? "valid" : "null"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение обёртки базового стиля работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: pixelMetric() / ПиксельныйРазмер() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение пиксельного размера")
    СброситьЦветКонсоли()
    
    Попытка
        размер = прокси.pixelMetric(0)
        размерРус = прокси.ПиксельныйРазмер(0)
        ВывестиСтрокуВКонсоль("    pixelMetric(PM_ScrollBarExtent): " + размер)
        ВывестиСтрокуВКонсоль("    ПиксельныйРазмер(PM_ScrollBarExtent): " + размерРус)
        
        Если размер >= 0 И размерРус >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение пиксельного размера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение пиксельного размера не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: isNativeStyle() / НативныйСтиль() - ИСПРАВЛЕНО =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка нативности стиля")
    СброситьЦветКонсоли()
    
    Попытка
        // Используем isNativeStyleValue() вместо isNativeStyle()
        нативный = прокси.isNativeStyleValue()
        нативныйРус = прокси.НативныйСтиль()
        ВывестиСтрокуВКонсоль("    isNativeStyleValue(): " + нативный)
        ВывестиСтрокуВКонсоль("    НативныйСтиль(): " + нативныйРус)
        
        // Просто проверяем, что методы существуют
        Если (нативный == ИСТИНА ИЛИ нативный == ЛОЖЬ) И (нативныйРус == ИСТИНА ИЛИ нативныйРус == ЛОЖЬ) Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка нативности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка нативности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: standardIcon() / СтандартнаяИконка() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение стандартной иконки")
    СброситьЦветКонсоли()
    
    Попытка
        иконка = прокси.standardIcon(0)
        иконкаРус = прокси.СтандартнаяИконка(0)
        ВывестиСтрокуВКонсоль("    standardIcon(SP_MessageBoxInformation): " + (иконка != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    СтандартнаяИконка(SP_MessageBoxInformation): " + (иконкаРус != null ? "valid" : "null"))
        
        Если иконка != null И иконкаРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение стандартной иконки работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение стандартной иконки не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: copyTo() / КопироватьВ() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Копирование объекта")
    СброситьЦветКонсоли()
    
    Попытка
        копия = Новый QtПроксиСтиль()
        успех = прокси.copyTo(копия)
        ВывестиСтрокуВКонсоль("    copyTo(): " + успех + " (ожидается true)")
        
        копияРус = Новый QtПроксиСтиль()
        успехРус = прокси.КопироватьВ(копияРус)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успехРус + " (ожидается true)")
        
        Если успех == ИСТИНА И успехРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: getRealProxyStyle() / ПолучитьПроксиСтиль() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального прокси-стиля")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = прокси.getRealProxyStyle()
        реальныйРус = прокси.ПолучитьПроксиСтиль()
        ВывестиСтрокуВКонсоль("    getRealProxyStyle(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьПроксиСтиль(): " + (реальныйРус != null ? "valid" : "null"))
        
        Если реальный != null И реальныйРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального прокси-стиля работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального прокси-стиля не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 11: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof прокси.RusFunc === 'function' Тогда
            jsonStr = прокси.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПроксиСтиль завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 3.0 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                 ТЕСТИРОВАНИЕ QtПроксиСтиль (QtProxyStyle)                    ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtProxyStyle()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПроксиСтиль (русские и английские методы)                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtProxyStyle()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПроксиСтиль: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

