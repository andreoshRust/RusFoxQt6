//Итоги тестирования QtПроксиСтиль (QtProxyStyle):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Получение имени стиля    ✅ Пройден
//4    Работа с базовым стилем    ✅ Пройден
//5    Получение обёртки базового стиля    ✅ Пройден
//6    Получение пиксельного размера    ✅ Пройден
//7    Проверка нативности стиля    ✅ Пройден
//8    Получение стандартной иконки    ✅ Пройден
//9    Копирование объекта    ✅ Пройден
//10    Получение реального прокси-стиля    ✅ Пройден
//11    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (21 из 21):
//isValid() - проверка валидности
//getRealProxyStyle() - получение реального прокси-стиля
//name() - имя стиля
//setBaseStyle() - установка базового стиля
//getBaseStyle() - получение базового стиля
//setBaseStyleWrapper() - установка базового стиля через обёртку
//getBaseStyleWrapper() - получение обёртки базового стиля
//standardIcon() - стандартная иконка
//pixelMetric() - пиксельный размер
//sizeFromContents() - размер из содержимого
//drawPrimitive() - отрисовка примитива
//drawControl() - отрисовка контрола
//drawComplexControl() - отрисовка сложного контрола
//hitTestComplexControl() - тест сложного контрола
//subElementRect() - прямоугольник подэлемента
//subControlRect() - прямоугольник подконтрола
//getStyleForWidget() - стиль для виджета
//isNativeStyle() - нативный стиль
//copyTo() - копирование
//setDebug() - установка режима отладки
//getDebug() - получение режима отладки
//Русские (21 из 21):
//Действителен() - isValid
//ПолучитьПроксиСтиль() - getRealProxyStyle
//Имя() - name
//УстановитьБазовыйСтиль() - setBaseStyle
//БазовыйСтиль() - getBaseStyle
//УстановитьБазовыйСтильОбёртку() - setBaseStyleWrapper
//БазовыйСтильОбёртка() - getBaseStyleWrapper
//СтандартнаяИконка() - standardIcon
//ПиксельныйРазмер() - pixelMetric
//РазмерИзСодержимого() - sizeFromContents
//НарисоватьПримитив() - drawPrimitive
//НарисоватьКонтрол() - drawControl
//НарисоватьСложныйКонтрол() - drawComplexControl
//ПопаданиеСложногоКонтрола() - hitTestComplexControl
//ПрямоугольникПодэлемента() - subElementRect
//ПрямоугольникПодконтрола() - subControlRect
//СтильДляВиджета() - getStyleForWidget
//НативныйСтиль() - isNativeStyle
//КопироватьВ() - copyTo
//РежимОтладки() - setDebug
//ПолучитьРежимОтладки() - getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПроксиСтиль
// ============================================================

Функция ДиагностикаМетодовQtProxyStyle()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПроксиСтиль ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtProxyStyle: " + (typeof QtProxyStyle !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtПроксиСтиль: " + (typeof QtПроксиСтиль !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке: " + e)
    КонецПопытки;
    
    Попытка
        диагПрокси = Новый QtПроксиСтиль()
        Если диагПрокси == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПроксиСтиль не создан")
            Возврат
        КонецЕсли;
        
        диагПрокси.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПроксиСтиль создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealProxyStyle", "name",
            "setBaseStyle", "getBaseStyle", "setBaseStyleWrapper", "getBaseStyleWrapper",
            "standardIcon", "pixelMetric", "sizeFromContents",
            "drawPrimitive", "drawControl", "drawComplexControl",
            "hitTestComplexControl", "subElementRect", "subControlRect",
            "getStyleForWidget", "isNativeStyle",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрокси[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьПроксиСтиль", "Имя",
            "УстановитьБазовыйСтиль", "БазовыйСтиль", "УстановитьБазовыйСтильОбёртку", "БазовыйСтильОбёртка",
            "СтандартнаяИконка", "ПиксельныйРазмер", "РазмерИзСодержимого",
            "НарисоватьПримитив", "НарисоватьКонтрол", "НарисоватьСложныйКонтрол",
            "ПопаданиеСложногоКонтрола", "ПрямоугольникПодэлемента", "ПрямоугольникПодконтрола",
            "СтильДляВиджета", "НативныйСтиль",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрокси[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПрокси.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПрокси.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                    
                    // Проверка наличия всех русских методов в JSON
                    ВывестиСтрокуВКонсоль("  Проверка русских методов в JSON:")
                    найдено = 0
                    Для i = 0 По русМетоды.length - 1 Цикл
                        нашли = ЛОЖЬ
                        Для j = 0 По карта.length - 1 Цикл
                            Если карта[j].русскоеИмя == русМетоды[i] Тогда
                                нашли = ИСТИНА
                                Прервать
                            КонецЕсли;
                        КонецЦикла;
                        Если нашли Тогда
                            найдено = найдено + 1
                            ВывестиСтрокуВКонсоль("    ✓ " + русМетоды[i])
                        Иначе
                            ВывестиСтрокуВКонсоль("    ✗ " + русМетоды[i] + " (НЕ НАЙДЕН в JSON)")
                        КонецЕсли;
                    КонецЦикла;
                    ВывестиСтрокуВКонсоль("  Найдено: " + найдено + " из " + русМетоды.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПроксиСтиль: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtПроксиСтиль (улучшенная)
// ============================================================

Функция ТестQtProxyStyle()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        прокси = Новый QtПроксиСтиль()
        прокси.РежимОтладки(ИСТИНА)
        Если прокси != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПроксиСтиль создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = прокси.isValid()
        валидныйРус = прокси.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: name() / Имя() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Получение имени стиля")
    СброситьЦветКонсоли()
    
    Попытка
        имя = прокси.name()
        имяРус = прокси.Имя()
        ВывестиСтрокуВКонсоль("    name(): " + имя)
        ВывестиСтрокуВКонсоль("    Имя(): " + имяРус)
        
        Если имя != "" И имя != null И имяРус != "" И имяРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение имени работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение имени не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: Работа с базовым стилем =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Работа с базовым стилем")
    СброситьЦветКонсоли()
    
    Попытка
        базовый = прокси.getBaseStyle()
        базовыйРус = прокси.БазовыйСтиль()
        ВывестиСтрокуВКонсоль("    getBaseStyle(): " + (базовый != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    БазовыйСтиль(): " + (базовыйРус != null ? "valid" : "null"))
        
        // Проверяем, что методы существуют и работают
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Работа с базовым стилем работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: Обёртка базового стиля =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение обёртки базового стиля")
    СброситьЦветКонсоли()
    
    Попытка
        обёртка = прокси.getBaseStyleWrapper()
        обёрткаРус = прокси.БазовыйСтильОбёртка()
        ВывестиСтрокуВКонсоль("    getBaseStyleWrapper(): " + (обёртка != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    БазовыйСтильОбёртка(): " + (обёрткаРус != null ? "valid" : "null"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение обёртки базового стиля работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: pixelMetric() / ПиксельныйРазмер() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение пиксельного размера")
    СброситьЦветКонсоли()
    
    Попытка
        размер = прокси.pixelMetric(0)
        размерРус = прокси.ПиксельныйРазмер(0)
        ВывестиСтрокуВКонсоль("    pixelMetric(PM_ScrollBarExtent): " + размер)
        ВывестиСтрокуВКонсоль("    ПиксельныйРазмер(PM_ScrollBarExtent): " + размерРус)
        
        Если размер >= 0 И размерРус >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение пиксельного размера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение пиксельного размера не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: isNativeStyle() / НативныйСтиль() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка нативности стиля")
    СброситьЦветКонсоли()
    
    Попытка
        нативный = прокси.isNativeStyle()
        нативныйРус = прокси.НативныйСтиль()
        ВывестиСтрокуВКонсоль("    isNativeStyle(): " + нативный)
        ВывестиСтрокуВКонсоль("    НативныйСтиль(): " + нативныйРус)
        
        // Просто проверяем, что методы существуют
        Если (нативный == ИСТИНА ИЛИ нативный == ЛОЖЬ) И (нативныйРус == ИСТИНА ИЛИ нативныйРус == ЛОЖЬ) Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка нативности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка нативности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: standardIcon() / СтандартнаяИконка() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение стандартной иконки")
    СброситьЦветКонсоли()
    
    Попытка
        иконка = прокси.standardIcon(0)
        иконкаРус = прокси.СтандартнаяИконка(0)
        ВывестиСтрокуВКонсоль("    standardIcon(SP_MessageBoxInformation): " + (иконка != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    СтандартнаяИконка(SP_MessageBoxInformation): " + (иконкаРус != null ? "valid" : "null"))
        
        Если иконка != null И иконкаРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение стандартной иконки работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение стандартной иконки не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: copyTo() / КопироватьВ() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Копирование объекта")
    СброситьЦветКонсоли()
    
    Попытка
        копия = Новый QtПроксиСтиль()
        успех = прокси.copyTo(копия)
        ВывестиСтрокуВКонсоль("    copyTo(): " + успех + " (ожидается true)")
        
        копияРус = Новый QtПроксиСтиль()
        успехРус = прокси.КопироватьВ(копияРус)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успехРус + " (ожидается true)")
        
        Если успех == ИСТИНА И успехРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: getRealProxyStyle() / ПолучитьПроксиСтиль() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального прокси-стиля")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = прокси.getRealProxyStyle()
        реальныйРус = прокси.ПолучитьПроксиСтиль()
        ВывестиСтрокуВКонсоль("    getRealProxyStyle(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьПроксиСтиль(): " + (реальныйРус != null ? "valid" : "null"))
        
        Если реальный != null И реальныйРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального прокси-стиля работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального прокси-стиля не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 11: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof прокси.RusFunc === 'function' Тогда
            jsonStr = прокси.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПроксиСтиль завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                 ТЕСТИРОВАНИЕ QtПроксиСтиль (QtProxyStyle)                    ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtProxyStyle()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПроксиСтиль (русские и английские методы)                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtProxyStyle()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПроксиСтиль: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

