// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtОчередь
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtQueue()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtОчередь ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtQueue: " + (typeof QtQueue !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtQueue: " + e)
    КонецПопытки;
    
    Попытка
        диагОчередь = Новый QtОчередь()
        Если диагОчередь == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtОчередь не создана")
            Возврат
        КонецЕсли;
        
        диагОчередь.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtОчередь создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "enqueue", "dequeue", "head", "clear",
            "size", "count", "isEmpty", "toArray",
            "empty", "len", "cnt"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагОчередь[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ВОчередь", "ИзОчереди", "Голова", "Очистить",
            "ВМассив", "Размер", "Количество", "Пустой"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагОчередь[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагОчередь.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагОчередь.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtОчередь: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtОчередь (QtQueue)
// ============================================================

Функция ТестQtQueueFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtОчередь                                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    очередь = null
    Попытка
        очередь = Новый QtОчередь()
        очередь.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtОчередь создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если очередь == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОЙ ОЧЕРЕДИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОЙ ОЧЕРЕДИ (свойства и методы)                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // ✅ Используем СВОЙСТВА с заглавной буквы
        пуст1 = очередь.IsEmpty
        пуст2 = очередь.Пустой()
        пуст3 = очередь.empty()
        размер1 = очередь.Size
        размер2 = очередь.Размер()
        размер3 = очередь.len()
        кол1 = очередь.Count
        кол2 = очередь.Количество()
        кол3 = очередь.cnt()
        
        ВывестиСтрокуВКонсоль("  IsEmpty (свойство) = " + пуст1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Пустой() = " + пуст2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  empty() = " + пуст3 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  len() = " + размер3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Count (свойство) = " + кол1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Количество() = " + кол2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  cnt() = " + кол3 + " (ожидается 0)")
        
        Если пуст1 == ИСТИНА И пуст2 == ИСТИНА И пуст3 == ИСТИНА И размер1 == 0 И размер2 == 0 И размер3 == 0 И кол1 == 0 И кол2 == 0 И кол3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка пустой очереди работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка пустой очереди работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой очереди: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ ВОчередь() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ВОчередь()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о1 = Новый QtОчередь()
        о1.РежимОтладки(Режим_Отладки)
        о1.ВОчередь("Первый")
        о1.ВОчередь("Второй")
        о1.ВОчередь("Третий")
        
        размер = о1.Size
        голова = о1.head()
        
        ВывестиСтрокуВКонсоль("  ВОчередь('Первый'), ВОчередь('Второй'), ВОчередь('Третий')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  head() = " + голова.toString() + " (ожидается Первый)")
        
        Если размер == 3 И голова.toString() == "Первый" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВОчередь() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВОчередь() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ Голова() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ Голова()                                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о2 = Новый QtОчередь()
        о2.РежимОтладки(Режим_Отладки)
        о2.ВОчередь("A")
        о2.ВОчередь("B")
        о2.ВОчередь("C")
        
        голова1 = о2.head()
        голова2 = о2.Голова()
        
        ВывестиСтрокуВКонсоль("  head() = " + голова1.toString() + " (ожидается A)")
        ВывестиСтрокуВКонсоль("  Голова() = " + голова2.toString() + " (ожидается A)")
        
        Если голова1.toString() == "A" И голова2.toString() == "A" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Голова() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Голова() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении головы очереди: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ ИзОчереди() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ ИзОчереди() (FIFO - первый пришёл, первый ушёл)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о3 = Новый QtОчередь()
        о3.РежимОтладки(Режим_Отладки)
        о3.ВОчередь("Первый")
        о3.ВОчередь("Второй")
        о3.ВОчередь("Третий")
        
        извлеч1 = о3.dequeue()
        извлеч2 = о3.ИзОчереди()
        извлеч3 = о3.dequeue()
        
        размер = о3.Size
        
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч1.toString() + " (ожидается Первый)")
        ВывестиСтрокуВКонсоль("  ИзОчереди() = " + извлеч2.toString() + " (ожидается Второй)")
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч3.toString() + " (ожидается Третий)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 0)")
        
        Если извлеч1.toString() == "Первый" И извлеч2.toString() == "Второй" И извлеч3.toString() == "Третий" И размер == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ИзОчереди() работает корректно (FIFO)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ИзОчереди() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при извлечении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ Очистить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о4 = Новый QtОчередь()
        о4.РежимОтладки(Режим_Отладки)
        о4.ВОчередь("A")
        о4.ВОчередь("B")
        о4.ВОчередь("C")
        
        о4.clear()
        размер1 = о4.Size
        пусто1 = о4.IsEmpty
        
        о4.ВОчередь("D")
        о4.ВОчередь("E")
        о4.Очистить()
        размер2 = о4.Size
        пусто2 = о4.IsEmpty
        
        ВывестиСтрокуВКонсоль("  clear() -> Size = " + размер1 + " (ожидается 0), IsEmpty = " + пусто1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Очистить() -> Size = " + размер2 + " (ожидается 0), IsEmpty = " + пусто2 + " (ожидается true)")
        
        Если размер1 == 0 И пусто1 == ИСТИНА И размер2 == 0 И пусто2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке очереди: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ ВМассив() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ ВМассив()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о5 = Новый QtОчередь()
        о5.РежимОтладки(Режим_Отладки)
        о5.ВОчередь("X")
        о5.ВОчередь("Y")
        о5.ВОчередь("Z")
        
        массив1 = о5.toArray()
        массив2 = о5.ВМассив()
        
        стрМассив1 = []
        Для i = 0 По массив1.length - 1 Цикл
            стрМассив1.push(массив1[i].toString())
        КонецЦикла;
        
        стрМассив2 = []
        Для i = 0 По массив2.length - 1 Цикл
            стрМассив2.push(массив2[i].toString())
        КонецЦикла;
        
        ВывестиСтрокуВКонсоль("  toArray() = " + стрМассив1.join(", ") + " (ожидается X, Y, Z)")
        ВывестиСтрокуВКонсоль("  ВМассив() = " + стрМассив2.join(", ") + " (ожидается X, Y, Z)")
        
        Если стрМассив1.length == 3 И стрМассив2.length == 3 И стрМассив1[0] == "X" И стрМассив1[1] == "Y" И стрМассив1[2] == "Z" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВМассив() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВМассив() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при преобразовании в массив: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ (числа, строки, булевы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о6 = Новый QtОчередь()
        о6.РежимОтладки(Режим_Отладки)
        о6.ВОчередь(42)
        о6.ВОчередь("Строка")
        о6.ВОчередь(ИСТИНА)
        о6.ВОчередь(3.14)
        
        размер = о6.Size
        голова = о6.head()
        
        извлеч1 = о6.dequeue()
        извлеч2 = о6.dequeue()
        извлеч3 = о6.dequeue()
        извлеч4 = о6.dequeue()
        
        ВывестиСтрокуВКонсоль("  ВОчередь(42), ВОчередь('Строка'), ВОчередь(true), ВОчередь(3.14)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  head() = " + голова.toString() + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч1.toString() + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч2.toString() + " (ожидается Строка)")
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч3.toString() + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  dequeue() = " + извлеч4.toString() + " (ожидается 3.14)")
        
        Если размер == 4 И голова.toString() == "42" И извлеч1.toString() == "42" И извлеч2.toString() == "Строка" И извлеч3.toString() == "true" И извлеч4.toString() == "3.14" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ ПОРЯДОК FIFO =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ ПОРЯДОК FIFO (первый пришёл - первый ушёл)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        о7 = Новый QtОчередь()
        о7.РежимОтладки(Режим_Отладки)
        о7.ВОчередь("1")
        о7.ВОчередь("2")
        о7.ВОчередь("3")
        о7.ВОчередь("4")
        о7.ВОчередь("5")
        
        извлеч1 = о7.dequeue()
        извлеч2 = о7.dequeue()
        извлеч3 = о7.dequeue()
        извлеч4 = о7.dequeue()
        извлеч5 = о7.dequeue()
        
        ВывестиСтрокуВКонсоль("  enqueue: 1, 2, 3, 4, 5")
        ВывестиСтрокуВКонсоль("  dequeue: " + извлеч1.toString() + ", " + извлеч2.toString() + ", " + извлеч3.toString() + ", " + извлеч4.toString() + ", " + извлеч5.toString())
        
        Если извлеч1.toString() == "1" И извлеч2.toString() == "2" И извлеч3.toString() == "3" И извлеч4.toString() == "4" И извлеч5.toString() == "5" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Порядок FIFO соблюдается корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Порядок FIFO нарушен")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке порядка FIFO: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtОчередь завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ QtОчередь (QtQueue)                        ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtQueue()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtОчередь (русские и английские методы)                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtQueueFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtОчередь: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

