// ============================================================
// ТЕСТ QEventLoop (ЦиклСобытий) через CPPObject
// ============================================================

Функция ТестQEventLoop()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ QEventLoop (ЦиклСобытий) через CPPObject ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА CPPObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QEventLoop =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QEventLoop через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QEventLoop")
        ВывестиСтрокуВКонсоль("    Создать('QEventLoop'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QEventLoop создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QEventLoop НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QEventLoop" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное (ожидается QEventLoop)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реальныйОбъект = об.УстановленОбъект()
        ВывестиСтрокуВКонсоль("    УстановленОбъект(): " + (реальныйОбъект != null ? "успешно" : "неудачно"))
        
        Если реальныйОбъект != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Реальный объект получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Реальный объект не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПОЛУЧЕНИЕ СПИСКА МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение списка методов")
    СброситьЦветКонсоли()
    
    Попытка
        методы = об.СписокМетодов()
        ВывестиСтрокуВКонсоль("    СписокМетодов(): " + методы.length + " методов")
        
        // Проверяем наличие основных методов QEventLoop
        естьIsRunning = false
        естьProcessEvents = false
        естьExit = false
        естьWakeUp = false
        естьExec = false
        
        Для i = 0 По методы.length - 1 Цикл
            Если методы[i] == "isRunning" Тогда естьIsRunning = true КонецЕсли
            Если методы[i] == "processEvents" Тогда естьProcessEvents = true КонецЕсли
            Если методы[i] == "exit" Тогда естьExit = true КонецЕсли
            Если методы[i] == "wakeUp" Тогда естьWakeUp = true КонецЕсли
            Если методы[i] == "exec" Тогда естьExec = true КонецЕсли
        КонецЦикла
        
        ВывестиСтрокуВКонсоль("    isRunning: " + естьIsRunning)
        ВывестиСтрокуВКонсоль("    processEvents: " + естьProcessEvents)
        ВывестиСтрокуВКонсоль("    exit: " + естьExit)
        ВывестиСтрокуВКонсоль("    wakeUp: " + естьWakeUp)
        ВывестиСтрокуВКонсоль("    exec: " + естьExec)
        
        Если естьIsRunning И естьProcessEvents И естьExit И естьWakeUp Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Основные методы QEventLoop найдены")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не все методы найдены (это может быть особенностью Qt)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА МЕТОДА isRunning =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка метода isRunning")
    СброситьЦветКонсоли()
    
    Попытка
        запущен = об.ВызватьМетод("isRunning")
        ВывестиСтрокуВКонсоль("    isRunning(): " + запущен)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ isRunning работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА МЕТОДА processEvents =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка метода processEvents")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = об.ВызватьМетод("processEvents")
        ВывестиСтрокуВКонсоль("    processEvents(): " + результат2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ processEvents работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА МЕТОДА exit =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка метода exit")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("exit")
        ВывестиСтрокуВКонсоль("    exit вызван")
        
        // Проверяем, что объект все еще существует
        валиденПосле = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиденПосле)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ exit работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА МЕТОДА wakeUp =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка метода wakeUp")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("wakeUp")
        ВывестиСтрокуВКонсоль("    wakeUp вызван")
        
        // Проверяем, что объект все еще существует
        валиденПосле2 = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиденПосле2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ wakeUp работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ОТЛАДКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Включение отладки")
    СброситьЦветКонсоли()
    
    Попытка
        об.РежимОтладки(ИСТИНА)
        отладка = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ИСТИНА): " + отладка)
        
        об.РежимОтладки(ЛОЖЬ)
        отладка2 = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ЛОЖЬ): " + отладка2)
        
        Если отладка == ИСТИНА И отладка2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отладка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отладка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПОВТОРНОЕ СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Повторное создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        результат3 = об.Создать("QEventLoop")
        имяКласса2 = об.ИмяКласса()
        валиден2 = об.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создать('QEventLoop'): " + результат3)
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса2)
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден2)
        
        Если результат3 == true И имяКласса2 == "QEventLoop" И валиден2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторное создание работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторное создание не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. СОЗДАНИЕ НОВОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Создание нового объекта")
    СброситьЦветКонсоли()
    
    Попытка
        об2 = НовыйОбъект("CPPОбъект")
        Если об2 != null Тогда
            об2.Создать("QEventLoop")
            имяКласса3 = об2.ИмяКласса()
            ВывестиСтрокуВКонсоль("    Новый объект создан, класс: " + имяКласса3)
            
            Если имяКласса3 == "QEventLoop" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание нового объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Новый объект не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось создать новый объект")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QEventLoop: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QEventLoop: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QEventLoop завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТ QEventLoop (ЦиклСобытий)                             ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    Попытка
        результат = ТестQEventLoop()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

