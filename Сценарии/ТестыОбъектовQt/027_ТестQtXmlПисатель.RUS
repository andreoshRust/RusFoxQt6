        п10.НаписатьПространство("http://example.com/ns", "ns")
        п10.НаписатьПространство("http://example.com/ns2", "ns2")
        п10.НаписатьАтрибутСПространством("http://example.com/ns", "attr", "value")
        п10.ЗакончитьЭлемент()
        
        // ИСПРАВЛЕНО: используем ПолучитьСтроку() у писателя
        результатСтрока10 = п10.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Результат записи с пространствами имён:")
        ВывестиСтрокуВКонсоль("  " + результатСтрока10)
        
        Если результатСтрока10.indexOf("xmlns:ns") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Запись с пространствами имён работает корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Запись с пространствами имён работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при записи с пространствами имён: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 11. ТЕСТ КОПИРОВАНИЯ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ТЕСТ КОПИРОВАНИЯ (КопироватьВ)                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        цель11 = Новый QtXmlПисатель()
        цель11.РежимОтладки(Режим_Отладки)
        
        результатКопия = писатель.КопироватьВ(цель11)
        
        ВывестиСтрокуВКонсоль("  КопироватьВ() = " + результатКопия + " (ожидается true)")
        
        Если результатКопия == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("  ✓ Копирование работает корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Копирование работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при копировании: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 12. ТЕСТ ИМЕНИ ОБЪЕКТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 12. ТЕСТ ИМЕНИ ОБЪЕКТА (УстановитьИмяОбъекта, ИмяОбъекта)                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        писатель.УстановитьИмяОбъекта("MyXmlWriter")
        имя = писатель.ИмяОбъекта()
        
        ВывестиСтрокуВКонсоль("  УстановитьИмяОбъекта('MyXmlWriter') -> ИмяОбъекта() = '" + имя + "'")
        
        Если имя == "MyXmlWriter" Тогда
            ВывестиСтрокуВКонсоль("  ✓ Установка имени объекта работает корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Установка имени объекта работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке имени объекта: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 13. ТЕСТ РЕЖИМА ОТЛАДКИ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 13. ТЕСТ РЕЖИМА ОТЛАДКИ (РежимОтладки, ПолучитьРежимОтладки)                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        имеетРежимОтладки = typeof писатель.РежимОтладки === 'function'
        имеетПолучитьРежимОтладки = typeof писатель.ПолучитьРежимОтладки === 'function'
        
        ВывестиСтрокуВКонсоль("  РежимОтладки() существует: " + имеетРежимОтладки)
        ВывестиСтрокуВКонсоль("  ПолучитьРежимОтладки() существует: " + имеетПолучитьРежимОтладки)
        
        Если имеетРежимОтладки И имеетПолучитьРежимОтладки Тогда
            ВывестиСтрокуВКонсоль("  ✓ Режим отладки работает корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Режим отладки работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке режима отладки: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 14. ТЕСТ ПОЛУЧЕНИЯ РЕАЛЬНОГО ПИСАТЕЛЯ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 14. ТЕСТ ПОЛУЧЕНИЯ РЕАЛЬНОГО ПИСАТЕЛЯ (ПолучитьПисатель)                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        реальный = писатель.ПолучитьПисатель()
        
        ВывестиСтрокуВКонсоль("  ПолучитьПисатель() = " + (реальный != null ? "объект" : "null"))
        
        Если реальный != null Тогда
            ВывестиСтрокуВКонсоль("  ✓ Получение реального писателя работает корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Получение реального писателя работает некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении реального писателя: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 15. ТЕСТ ПРОВЕРКИ RUSFUNC ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 15. ТЕСТ ПРОВЕРКИ RUSFUNC                                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        Если typeof писатель.RusFunc === 'function' Тогда
            jsonStr = писатель.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                ВывестиСтрокуВКонсоль("  RusFunc() возвращает валидный JSON (" + карта.length + " методов)")
                ВывестиСтрокуВКонсоль("  ✓ RusFunc работает корректно")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("  ✗ RusFunc вернул пустой JSON")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Метод RusFunc НЕ СУЩЕСТВУЕТ")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке RusFunc: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 16. ПРАКТИЧЕСКИЙ ТЕСТ - СОЗДАНИЕ ПОЛНОГО XML ДОКУМЕНТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 16. ПРАКТИЧЕСКИЙ ТЕСТ - СОЗДАНИЕ ПОЛНОГО XML ДОКУМЕНТА                      │")
    ВывестиСтрокуВКонсоль("│     (Комбинация всех методов)                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        пФин = Новый QtXmlПисатель()
        пФин.РежимОтладки(Режим_Отладки)
        пФин.УстановитьАвтоформатирование(ИСТИНА)
        пФин.УстановитьОтступАвтоформатирования(2)
        
        // Заголовок документа
        пФин.НачатьДокумент()
        
        // Корневой элемент
        пФин.НачатьЭлемент("library")
        пФин.НаписатьАтрибут("name", "My Library")
        пФин.НаписатьАтрибут("version", "1.0")
        
        // Комментарий
        пФин.НаписатьКомментарий("Список книг")
        
        // Первая книга
        пФин.НачатьЭлемент("book")
        пФин.НаписатьАтрибут("id", "1")
        пФин.НаписатьТекстовыйЭлемент("title", "Война и мир")
        пФин.НаписатьТекстовыйЭлемент("author", "Толстой")
        пФин.НаписатьТекстовыйЭлемент("year", "1869")
        пФин.НаписатьТекстовыйЭлемент("description", "Роман-эпопея")
        пФин.ЗакончитьЭлемент()
        
        // Вторая книга с CDATA
        пФин.НачатьЭлемент("book")
        пФин.НаписатьАтрибут("id", "2")
        пФин.НаписатьТекстовыйЭлемент("title", "Преступление и наказание")
        пФин.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин.НаписатьТекстовыйЭлемент("year", "1866")
        пФин.НаписатьCDATA("<annotation>Роман о преступлении</annotation>")
        пФин.ЗакончитьЭлемент()
        
        // Третья книга с пространством имён
        пФин.НачатьЭлементСПространством("http://example.com/ns", "ns:book")
        пФин.НаписатьАтрибут("id", "3")
        пФин.НаписатьТекстовыйЭлемент("title", "Идиот")
        пФин.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин.НаписатьТекстовыйЭлемент("year", "1868")
        пФин.ЗакончитьЭлемент()
        
        // Закрываем корневой элемент
        пФин.ЗакончитьЭлемент()
        
        // Инструкция обработки
        пФин.НаписатьИнструкцию("xsp", "echo 'XML document generated'")
        
        // Завершаем документ
        пФин.ЗакончитьДокумент()
        
        // ИСПРАВЛЕНО: используем ПолучитьСтроку() у писателя
        финальныйXML = пФин.ПолучитьСтроку()
        
        ВывестиСтрокуВКонсоль("  Полный XML документ:")
        ВывестиСтрокуВКонсоль("  " + финальныйXML)
        ВывестиСтрокуВКонсоль("  Длина документа: " + финальныйXML.length + " символов")
        
        Если финальныйXML.indexOf("library") > -1 И финальныйXML.indexOf("book") > -1 И финальныйXML.indexOf("Толстой") > -1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Практический тест выполнен успешно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Практический тест выполнен с ошибками")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при практическом тесте: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== ИТОГОВЫЙ ОТЧЁТ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╠════════════════════════════════════════════════════════════════════════════════╣")
    ВывестиСтрокуВКонсоль("║  Всего тестов: " + всегоТестов + "                                                  ║")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              ║")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("║  Ошибок:        " + (всегоТестов - успешноТестов) + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        ║")
    КонецЕсли
    
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

