// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtXmlПисатель
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtXmlStreamWriter()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtXmlStreamWriter ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtXmlStreamWriter: " + (typeof QtXmlStreamWriter !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtXmlStreamWriter: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtПоток()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtXmlStreamWriter не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtXmlStreamWriter создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtThread: " + e)
    КонецПопытки;
    
КонецФункции


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ КЛАССА
// ============================================================

Функция Методы_QtXmlПисатель_Компактная()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА QtXmlStreamWriter (QtXmlПисатель) - КОМПАКТНАЯ ВЕРСИЯ ====")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    Пис1_1 = Новый QtXmlПисатель()
    Пис1_1.РежимОтладки(Режим_Отладки)
    ВывестиСтрокуВКонсоль("  Создание объекта: УСПЕШНО")
    
    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    ВывестиСтрокуВКонсоль("  isValid(): " + Пис1_1.isValid() + ", Действителен(): " + Пис1_1.Действителен() + " (ожидается true)")
    
    // ===== 3-4. АВТОФОРМАТИРОВАНИЕ И ОТСТУПЫ =====
    Пис1_1.УстановитьАвтоформатирование(ИСТИНА)
    авто = Пис1_1.ПолучитьАвтоформатирование()
    Пис1_1.УстановитьАвтоформатирование(ЛОЖЬ)
    автоРус = Пис1_1.ПолучитьАвтоформатирование()
    ВывестиСтрокуВКонсоль("  Автоформатирование: " + авто + " / " + автоРус)
    
    Пис1_1.УстановитьОтступАвтоформатирования(4)
    отступ = Пис1_1.ПолучитьОтступАвтоформатирования()
    Пис1_1.УстановитьОтступАвтоформатирования(2)
    отступРус = Пис1_1.ПолучитьОтступАвтоформатирования()
    ВывестиСтрокуВКонсоль("  Отступ: " + отступ + " / " + отступРус + " (ожидается 4 / 2)")
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ЗАПИСЬ ПРОСТОГО XML =====
    Попытка
        п52 = Новый QtXmlПисатель()
        п52.РежимОтладки(Режим_Отладки)
        п52.УстановитьАвтоформатирование(ИСТИНА)
        п52.УстановитьОтступАвтоформатирования(2)
        
        п52.НачатьДокумент()
        п52.НачатьЭлемент("root")
        п52.НаписатьПустойЭлемент("empty")
        п52.НаписатьТекстовыйЭлемент("name", "value")
        п52.НаписатьТекстовыйЭлемент("русский", "текст")
        п52.ЗакончитьЭлемент()
        п52.ЗакончитьДокумент()
        
        результат = п52.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  Простой XML: " + (результат.indexOf("root") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  Простой XML: ❌ ОШИБКА")
    КонецПопытки

    // ===== 6. ЗАПИСЬ С АТРИБУТАМИ =====
    Попытка
        п61 = Новый QtXmlПисатель()
        п61.РежимОтладки(Режим_Отладки)
        
        п61.НачатьЭлемент("book")
        п61.НаписатьАтрибут("title", "Война и мир")
        п61.НаписатьАтрибут("author", "Толстой")
        п61.НаписатьАтрибут("year", "1869")
        п61.НаписатьТекст("Роман-эпопея")
        п61.ЗакончитьЭлемент()
        
        результат = п61.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  Атрибуты: " + (результат.indexOf("title") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  Атрибуты: ❌ ОШИБКА")
    КонецПопытки

    // ===== 7. CDATA И КОММЕНТАРИИ =====
    Попытка
        п71 = Новый QtXmlПисатель()
        п71.РежимОтладки(Режим_Отладки)
        
        п71.НачатьЭлемент("data")
        п71.НаписатьCDATA("<special> & \n text</special>")
        п71.НаписатьКомментарий("Это комментарий")
        п71.НаписатьКомментарий("Ещё один комментарий")
        п71.ЗакончитьЭлемент()
        
        результат = п71.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  CDATA/Комментарии: " + (результат.indexOf("CDATA") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  CDATA/Комментарии: ❌ ОШИБКА")
    КонецПопытки

    // ===== 8. ИНСТРУКЦИИ ОБРАБОТКИ =====
    Попытка
        п81 = Новый QtXmlПисатель()
        п81.РежимОтладки(Режим_Отладки)
        
        п81.НаписатьИнструкцию("xml-stylesheet", "type='text/xsl' href='style.xsl'")
        п81.НаписатьИнструкцию("php", "echo 'Hello';")
        п81.НачатьЭлемент("root")
        п81.ЗакончитьЭлемент()
        
        результат = п81.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  Инструкции: " + (результат.indexOf("xml-stylesheet") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  Инструкции: ❌ ОШИБКА")
    КонецПопытки

    // ===== 9. DTD =====
    Попытка
        п91 = Новый QtXmlПисатель()
        п91.РежимОтладки(Режим_Отладки)
        
        п91.НаписатьDTD("<!DOCTYPE root [<!ELEMENT root ANY>]>")
        п91.НаписатьDTD("<!ENTITY author 'Толстой'>")
        п91.НачатьЭлемент("root")
        п91.ЗакончитьЭлемент()
        
        resultado = п91.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  DTD: " + (resultado.indexOf("DOCTYPE") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  DTD: ❌ ОШИБКА")
    КонецПопытки

    // ===== 10. ПРОСТРАНСТВА ИМЁН =====
    Попытка
        п101 = Новый QtXmlПисатель()
        п101.РежимОтладки(Режим_Отладки)
        
        п101.НачатьЭлементСПространством("http://example.com/ns", "ns:root")
        п101.НаписатьПространство("http://example.com/ns", "ns")
        п101.НаписатьПространство("http://example.com/ns2", "ns2")
        п101.НаписатьАтрибутСПространством("http://example.com/ns", "attr", "value")
        п101.ЗакончитьЭлемент()
        
        результат = п101.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  Пространства имён: " + (результат.indexOf("xmlns:ns") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  Пространства имён: ❌ ОШИБКА")
    КонецПопытки

    // ===== 11-12. КОПИРОВАНИЕ И ИМЯ =====
    цель = Новый QtXmlПисатель()
    результат = Пис1_1.КопироватьВ(цель)
    ВывестиСтрокуВКонсоль("  КопироватьВ: " + (результат ? "✅" : "❌"))
    
    Пис1_1.УстановитьИмяОбъекта("MyXmlWriter")
    ВывестиСтрокуВКонсоль("  ИмяОбъекта: " + Пис1_1.ИмяОбъекта() + " (ожидается MyXmlWriter)")

    // ===== 13-14. РЕЖИМ ОТЛАДКИ И ПОЛУЧЕНИЕ ПИСАТЕЛЯ =====
    ВывестиСтрокуВКонсоль("  РежимОтладки: " + (typeof Пис1_1.РежимОтладки === 'function' ? "✅" : "❌"))
    реальный = Пис1_1.ПолучитьПисатель()
    ВывестиСтрокуВКонсоль("  ПолучитьПисатель: " + (реальный != null ? "✅" : "❌"))

    // ===== 15. RUSFUNC =====
    Если typeof Пис1_1.RusFunc === 'function' Тогда
        карта = JSON.parse(Пис1_1.RusFunc())
        ВывестиСтрокуВКонсоль("  RusFunc: " + карта.length + " методов ✅")
    Иначе
        ВывестиСтрокуВКонсоль("  RusFunc: ❌ НЕ СУЩЕСТВУЕТ")
    КонецЕсли

    // ===== 16. ПРАКТИЧЕСКОЕ ИСПОЛЬЗОВАНИЕ =====
    Попытка
        пФин1 = Новый QtXmlПисатель()
        пФин1.РежимОтладки(Режим_Отладки)
        пФин1.УстановитьАвтоформатирование(ИСТИНА)
        пФин1.УстановитьОтступАвтоформатирования(2)
        
        пФин1.НачатьДокумент()
        пФин1.НачатьЭлемент("library")
        пФин1.НаписатьАтрибут("name", "My Library")
        пФин1.НаписатьАтрибут("version", "1.0")
        пФин1.НаписатьКомментарий("Список книг")
        
        // Книга 1
        пФин1.НачатьЭлемент("book")
        пФин1.НаписатьАтрибут("id", "1")
        пФин1.НаписатьТекстовыйЭлемент("title", "Война и мир")
        пФин1.НаписатьТекстовыйЭлемент("author", "Толстой")
        пФин1.НаписатьТекстовыйЭлемент("year", "1869")
        пФин1.НаписатьТекстовыйЭлемент("description", "Роман-эпопея")
        пФин1.ЗакончитьЭлемент()
        
        // Книга 2 с CDATA
        пФин1.НачатьЭлемент("book")
        пФин1.НаписатьАтрибут("id", "2")
        пФин1.НаписатьТекстовыйЭлемент("title", "Преступление и наказание")
        пФин1.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин1.НаписатьТекстовыйЭлемент("year", "1866")
        пФин1.НаписатьCDATA("<annotation>Роман о преступлении</annotation>")
        пФин1.ЗакончитьЭлемент()
        
        // Книга 3 с пространством имён
        пФин1.НачатьЭлементСПространством("http://example.com/ns", "ns:book")
        пФин1.НаписатьАтрибут("id", "3")
        пФин1.НаписатьТекстовыйЭлемент("title", "Идиот")
        пФин1.НаписатьТекстовыйЭлемент("author", "Достоевский")
        пФин1.НаписатьТекстовыйЭлемент("year", "1868")
        пФин1.ЗакончитьЭлемент()
        
        пФин1.ЗакончитьЭлемент()
        пФин1.НаписатьИнструкцию("xsp", "echo 'XML document generated'")
        пФин1.ЗакончитьДокумент()
        
        финальныйXML = пФин1.ПолучитьСтроку()
        ВывестиСтрокуВКонсоль("  Практическое использование: длина " + финальныйXML.length + " символов " + (финальныйXML.indexOf("library") > -1 ? "✅" : "❌"))
    Исключение
        ВывестиСтрокуВКонсоль("  Практическое использование: ❌ ОШИБКА")
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("==== ДИАГНОСТИКА QtXmlStreamWriter (QtXmlПисатель) ЗАВЕРШЕНА ====") 
    ВывестиСтрокуВКонсоль("") 
КонецФункции


