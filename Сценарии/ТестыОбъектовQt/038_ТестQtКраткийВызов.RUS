//Что было проверено:
//✅ Создание объекта - Новый QtКраткийВызов(виджет)
//✅ Валидность - isValid() / Действителен()
//✅ Установка и получение ключа - setKey() / key() / keyText() и УстановитьКлюч() / Ключ() / ТекстКлюча()
//✅ Доступность - setEnabled() / isEnabled() и УстановитьДоступен() / Доступен()
//✅ Автоповтор - setAutoRepeat() / autoRepeat() и УстановитьАвтоповтор() / Автоповтор()
//✅ Подсказка - setWhat() / what() и УстановитьПодсказку() / Подсказка()
//✅ Идентификатор и родитель - id() / parentWidget() и Идентификатор() / РодительскийВиджет()
//✅ Последовательности ключей - keySequence() / standardKeyText() и ПоследовательностьКлючей() / СтандартныйКлюч()
//✅ Создание последовательности из ключей - keySequenceFromKeys() и ПоследовательностьИзКлючей()
//✅ Колбэк, копирование, реальный объект - setCallback() / copyTo() / getRealShortcut() и УстановитьКолбэк() / КопироватьВ() / ПолучитьКраткийВызов()


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtКраткийВызов
// ============================================================

Функция ДиагностикаМетодовQtShortcut()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtКраткийВызов ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtКраткийВызов: " + (typeof QtКраткийВызов !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtКраткийВызов: " + e)
    КонецПопытки;
    
    Попытка
        // Создаём виджет для теста
        диагВиджет = Новый QtВиджет()
        диагВиджет.Показать()
        
        // Создаём шорткат с виджетом
        диагШорткат = Новый QtКраткийВызов(диагВиджет)
        
        Если диагШорткат == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtКраткийВызов не создан")
            Возврат
        КонецЕсли;
        
        диагШорткат.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtКраткийВызов создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealShortcut",
            "setKey", "key", "keyText",
            "setCallback",
            "setEnabled", "isEnabled",
            "setAutoRepeat", "autoRepeat",
            "setWhat", "what",
            "id", "parentWidget",
            "keySequence", "keySequenceFromKeys", "standardKeyText",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагШорткат[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьКраткийВызов",
            "УстановитьКлюч", "Ключ", "ТекстКлюча",
            "УстановитьКолбэк",
            "УстановитьДоступен", "Доступен",
            "УстановитьАвтоповтор", "Автоповтор",
            "УстановитьПодсказку", "Подсказка",
            "Идентификатор", "РодительскийВиджет",
            "ПоследовательностьКлючей", "ПоследовательностьИзКлючей", "СтандартныйКлюч",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагШорткат[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагШорткат.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагШорткат.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
        диагВиджет.Скрыть()
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtКраткийВызов: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtКраткийВызов
// ============================================================

Функция ТестQtShortcut()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // Создаём виджет для тестов
    виджет = Новый QtВиджет()
    виджет.Показать()
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    шорткат = null
    Попытка
        шорткат = Новый QtКраткийВызов(виджет)
        шорткат.РежимОтладки(ИСТИНА)
        Если шорткат != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtКраткийВызов создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = шорткат.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = шорткат.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: setKey() / key() / keyText() / УстановитьКлюч() / Ключ() / ТекстКлюча() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка и получение ключа")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        шорткат.setKey("Ctrl+Shift+S")
        ключ = шорткат.key()
        текстКлюча = шорткат.keyText()
        ВывестиСтрокуВКонсоль("    [ENG] setKey(Ctrl+Shift+S) -> keyText() = " + текстКлюча)
        
        Если текстКлюча != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setKey()/key()/keyText() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setKey()/key()/keyText() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            шорткат.УстановитьКлюч("Ctrl+Alt+O")
            ключРус = шорткат.Ключ()
            текстКлючаРус = шорткат.ТекстКлюча()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьКлюч(Ctrl+Alt+O) -> ТекстКлюча() = " + текстКлючаРус)
            
            Если текстКлючаРус != "" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьКлюч()/Ключ()/ТекстКлюча() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьКлюч()/Ключ()/ТекстКлюча() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: setEnabled() / isEnabled() / УстановитьДоступен() / Доступен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Доступность сокращения")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        шорткат.setEnabled(false)
        доступен1 = шорткат.isEnabled()
        шорткат.setEnabled(true)
        доступен2 = шорткат.isEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setEnabled(false) -> isEnabled()=" + доступен1)
        ВывестиСтрокуВКонсоль("    [ENG] setEnabled(true) -> isEnabled()=" + доступен2)
        
        Если доступен1 == false И доступен2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setEnabled()/isEnabled() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setEnabled()/isEnabled() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            шорткат.УстановитьДоступен(false)
            доступен1Рус = шорткат.Доступен()
            шорткат.УстановитьДоступен(true)
            доступен2Рус = шорткат.Доступен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступен(false) -> Доступен()=" + доступен1Рус)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступен(true) -> Доступен()=" + доступен2Рус)
            
            Если доступен1Рус == false И доступен2Рус == true Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьДоступен()/Доступен() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьДоступен()/Доступен() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: setAutoRepeat() / autoRepeat() / УстановитьАвтоповтор() / Автоповтор() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Автоповтор")
    СброситьЦветКонсоли()
    
