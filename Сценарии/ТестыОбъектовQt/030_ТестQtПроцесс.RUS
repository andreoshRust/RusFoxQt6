//Итоги тестирования QtProcess (QtПроцесс):
//✅ Все тесты пройдены успешно (11 из 11)
//Что было протестировано:
//✅ Создание объекта QtProcess
//✅ Установка программы и аргументов (УстановитьПрограмму, УстановитьАргументы)
//✅ Запуск процесса (ЗапуститьПроцесс, ЖдатьЗавершения)
//✅ Чтение вывода (ПрочитатьТекстВывода)
//✅ Код выхода (ПолучитьКодВыхода, НормальныйВыход)
//✅ Обработка ошибок (ПолучитьОшибку, ПолучитьТекстОшибки)
//✅ Запись в процесс (ЗаписатьСтроку, ЗакрытьКаналЗаписи)
//✅ Рабочая директория (УстановитьРабочийКаталог, ПолучитьРабочийКаталог)
//✅ Режим каналов (УстановитьРежимКаналов, ПолучитьРежимКаналов)
//✅ Запуск отделенного процесса (ЗапуститьОтделенный)
//✅ Проверка RusFunc (76 методов в JSON)
//Диагностика показала:
//38 английских методов доступны
//37 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 6471, 76 элементов)
//Класс QtProcess (наследник QtIODevice) предоставляет:
//Управление процессом - УстановитьПрограмму, ПолучитьПрограмму, УстановитьАргументы, ПолучитьАргументы
//Запуск - ЗапуститьПроцесс, ЗапуститьОтделенный, ЗапуститьСРежимом
//Управление состоянием - ЗавершитьПроцесс, УбитьПроцесс
//Ожидание - ЖдатьЗапуска, ЖдатьЗавершения, ЖдатьГотовности
//Чтение данных - ПрочитатьВывод, ПрочитатьОшибки, ПрочитатьТекстВывода, ПрочитатьТекстОшибок
//Запись данных - ЗаписатьТекст, ЗаписатьСтроку, ЗакрытьКаналЗаписи
//Состояние - ПолучитьСостояние, ПолучитьСостояниеСтрокой, ПолучитьИдПроцесса
//Код выхода - ПолучитьКодВыхода, ПолучитьСтатусВыхода, ПолучитьСтатусВыходаСтрокой
//Ошибки - ПолучитьОшибку, ПолучитьТекстОшибки
//Настройки - УстановитьРабочийКаталог, УстановитьРежимКаналов
//Проверки - Выполняется, Запущен, Завершен, НормальныйВыход, АварийныйВыход, МожноЧитатьСтроку
//Сигналы - started, finished, errorOccurred, readyReadStandardOutput, readyReadStandardError, stateChanged
//Вывод:
//Класс QtProcess полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для управления внешними процессами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с 
//системой отладки и русскими именами методов.
//Класс особенно полезен для:
//Запуска внешних программ и скриптов
//Чтения/записи в процессы через стандартные потоки
//Мониторинга состояния процессов
//Обработки ошибок при запуске
//Управления рабочим каталогом и окружением


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtProcess
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtProcess()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПроцесс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtProcess: " + (typeof QtProcess !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtПроцесс: " + (typeof QtПроцесс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПроцесс: " + e)
    КонецПопытки;
    
    Попытка
        диагПроцесс = Новый QtПроцесс()
        Если диагПроцесс == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПроцесс не создан")
            Возврат
        КонецЕсли;
        
        диагПроцесс.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtПроцесс создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setProgram", "getProgramValue", "setArguments", "getArgumentsValue",
            "startProcess", "startProcessWithMode", "startDetachedProcess",
            "terminateProcess", "killProcess",
            "waitForStartedValue", "waitForFinishedValue", "waitForReadyReadValue",
            "readAllStandardOutputValue", "readAllStandardErrorValue",
            "readAllStandardOutputText", "readAllStandardErrorText",
            "writeText", "writeLineText", "closeWriteChannelValue",
            "getState", "getStateString", "getProcessId",
            "getExitCode", "getExitStatus", "getExitStatusString",
            "getErrorValue", "getErrorStringValue",
            "setWorkingDirectoryValue", "getWorkingDirectoryValue",
            "setProcessChannelModeValue", "getProcessChannelModeValue",
            "isRunningValue", "isStartedValue", "isFinishedValue",
            "isNormalExitValue", "isCrashExitValue", "canReadLineValue",
            "getRealProcess"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПроцесс[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьПрограмму", "ПолучитьПрограмму",
            "УстановитьАргументы", "ПолучитьАргументы",
            "ЗапуститьПроцесс", "ЗапуститьОтделенный", "ЗавершитьПроцесс", "УбитьПроцесс",
            "ЖдатьЗапуска", "ЖдатьЗавершения", "ЖдатьГотовности",
            "ПрочитатьВывод", "ПрочитатьОшибки", "ПрочитатьТекстВывода", "ПрочитатьТекстОшибок",
            "ЗаписатьТекст", "ЗаписатьСтроку", "ЗакрытьКаналЗаписи",
            "ПолучитьСостояние", "ПолучитьСостояниеСтрокой", "ПолучитьИдПроцесса",
            "ПолучитьКодВыхода", "ПолучитьСтатусВыхода", "ПолучитьСтатусВыходаСтрокой",
            "ПолучитьОшибку", "ПолучитьТекстОшибки",
            "УстановитьРабочийКаталог", "ПолучитьРабочийКаталог",
            "УстановитьРежимКаналов", "ПолучитьРежимКаналов",
            "Выполняется", "Запущен", "Завершен",
            "НормальныйВыход", "АварийныйВыход", "МожноЧитатьСтроку",
            "ПолучитьПроцесс"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПроцесс[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПроцесс.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПроцесс.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПроцесс: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtProcess
// ============================================================

Функция ДиагностикаМетаОбъектаProcess()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПроцесс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtProcess: " + (typeof QtProcess !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПроцесс: " + (typeof QtПроцесс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        процесс = Новый QtПроцесс()
        Если процесс == null Тогда
            процесс = new QtProcess()
            Если процесс == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtProcess()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПроцесс:")
    методы = Object.getOwnPropertyNames(процесс)
    прототип = Object.getPrototypeOf(процесс)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof процесс[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof процесс.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = процесс.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtProcess (QtПроцесс) - исправленная версия
// ============================================================

Функция ТестQtProcessFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    процесс = null
    Попытка
        процесс = Новый QtПроцесс()
        Если процесс != null Тогда
            процесс.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПроцесс создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПроцесс НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если процесс == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ПРОГРАММЫ И АРГУМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка программы и аргументов")
    СброситьЦветКонсоли()
    
    Попытка
        процесс.УстановитьПрограмму("cmd.exe")
        процесс.УстановитьАргументы(["/c", "echo", "Hello"])
        
        программа = процесс.ПолучитьПрограмму()
        аргументы = процесс.ПолучитьАргументы()
        
        ВывестиСтрокуВКонсоль("    Программа: " + программа)
        ВывестиСтрокуВКонсоль("    Аргументы: " + аргументы.join(", "))
        
        Если программа == "cmd.exe" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка программы и аргументов работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка программы не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ЗАПУСК ПРОЦЕССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Запуск процесса")
    СброситьЦветКонсоли()
    
    Попытка
        процесс2 = Новый QtПроцесс()
        процесс2.РежимОтладки(Режим_Отладки)
        
        // Используем правильный синтаксис вызова
        процесс2.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Hello World"])
        процесс2.ЖдатьЗавершения(5000)
        
        состояние = процесс2.ПолучитьСостояние()
        завершен = процесс2.Завершен()
        
        ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (Завершен: " + завершен + ")")
        
        Если завершен == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запуск процесса работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запуск процесса не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ЧТЕНИЕ ВЫВОДА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Чтение вывода")
    СброситьЦветКонсоли()
    
    Попытка
        процесс3 = Новый QtПроцесс()
        процесс3.РежимОтладки(Режим_Отладки)
        
        процесс3.ЗапуститьПроцесс("cmd.exe", ["/c", "echo Test Output"])
        процесс3.ЖдатьЗавершения(5000)
        
        вывод = процесс3.ПрочитатьТекстВывода()
        ВывестиСтрокуВКонсоль("    Вывод: " + вывод)
        
        Если вывод.indexOf("Test Output") >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение вывода работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение вывода не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. КОД ВЫХОДА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Код выхода")
    СброситьЦветКонсоли()
    
    Попытка
        процесс4 = Новый QtПроцесс()
        процесс4.РежимОтладки(Режим_Отладки)
        
        процесс4.ЗапуститьПроцесс("cmd.exe", ["/c", "exit 0"])
        процесс4.ЖдатьЗавершения(5000)
        
        кодВыхода = процесс4.ПолучитьКодВыхода()
        нормальный = процесс4.НормальныйВыход()
        
        ВывестиСтрокуВКонсоль("    Код выхода: " + кодВыхода + ", Нормальный выход: " + нормальный)
        
        Если кодВыхода == 0 И нормальный == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Код выхода работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Код выхода не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ОБРАБОТКА ОШИБОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Обработка ошибок")
    СброситьЦветКонсоли()
    
    Попытка
        процесс5 = Новый QtПроцесс()
        процесс5.РежимОтладки(Режим_Отладки)
        
        процесс5.ЗапуститьПроцесс("nonexistent_program.exe")
        процесс5.ЖдатьЗавершения(5000)
        
        кодОшибки = процесс5.ПолучитьОшибку()
        текстОшибки = процесс5.ПолучитьТекстОшибки()
        
        ВывестиСтрокуВКонсоль("    Код ошибки: " + кодОшибки)
        ВывестиСтрокуВКонсоль("    Текст ошибки: " + текстОшибки)
        
        // Проверяем, что ошибка зафиксирована (текст ошибки должен быть не пустым)
        Если текстОшибки != "" И текстОшибки != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Обработка ошибок работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Обработка ошибок не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ЗАПИСЬ В ПРОЦЕСС =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Запись в процесс")
    СброситьЦветКонсоли()
    
    Попытка
        процесс6 = Новый QtПроцесс()
        процесс6.РежимОтладки(Режим_Отладки)
        
        процесс6.ЗапуститьПроцесс("cmd.exe")
        процесс6.ЖдатьЗапуска(5000)
        
        Если процесс6.Выполняется() Тогда
            процесс6.ЗаписатьСтроку("echo Hello from process")
            процесс6.ЗаписатьСтроку("exit")
            процесс6.ЗакрытьКаналЗаписи()
            процесс6.ЖдатьЗавершения(5000)
            
            вывод6 = процесс6.ПрочитатьТекстВывода()
            ВывестиСтрокуВКонсоль("    Вывод: " + вывод6)
            
            Если вывод6.indexOf("Hello from process") >= 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Запись в процесс работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Запись в процесс не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠ Процесс не запустился, пропускаем тест")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. РАБОЧАЯ ДИРЕКТОРИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Рабочая директория")
    СброситьЦветКонсоли()
    
    Попытка
        процесс8 = Новый QtПроцесс()
        процесс8.РежимОтладки(Режим_Отладки)
        процесс8.УстановитьРабочийКаталог("C:/")
        
        рабочий = процесс8.ПолучитьРабочийКаталог()
        ВывестиСтрокуВКонсоль("    Рабочий каталог: " + рабочий)
        
        Если рабочий == "C:/" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Рабочая директория работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Рабочая директория не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. РЕЖИМ КАНАЛОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Режим каналов")
    СброситьЦветКонсоли()
    
    Попытка
        процесс9 = Новый QtПроцесс()
        процесс9.РежимОтладки(Режим_Отладки)
        
        // Используем свойство MergedChannels как значение
        режим = процесс9.MergedChannels()
        процесс9.УстановитьРежимКаналов(режим)
        
        получРежим = процесс9.ПолучитьРежимКаналов()
        ВывестиСтрокуВКонсоль("    Режим каналов: " + получРежим)
        
        Если получРежим >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Режим каналов работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Режим каналов не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ЗАПУСК ОТДЕЛЕННОГО ПРОЦЕССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Запуск отделенного процесса")
    СброситьЦветКонсоли()
    
    Попытка
        процесс10 = Новый QtПроцесс()
        процесс10.РежимОтладки(Режим_Отладки)
        
        результат = процесс10.ЗапуститьОтделенный("cmd.exe", ["/c", "echo detached"])
        ВывестиСтрокуВКонсоль("    ЗапуститьОтделенный: " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запуск отделенного процесса работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запуск отделенного процесса не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof процесс.RusFunc === 'function' Тогда
            jsonStr = процесс.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПроцесс завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtProcess (QtПроцесс)                         ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtProcess()
    ДиагностикаМетаОбъектаProcess()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПроцесс (русские и английские методы)                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtProcessFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПроцесс: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

