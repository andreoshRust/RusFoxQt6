//Итоги тестирования QtSaveFile (QtФайлБезопасный):
//✅ Все тесты пройдены успешно (11 из 11)
//Что было протестировано:
//✅ Создание объекта QtSaveFile
//✅ Установка имени файла (УстановитьИмяФайла, ПолучитьИмяФайла)
//✅ Открытие и отмена (Открыть, Открыт, ОтменитьЗапись)
//✅ Запись и сохранение (ЗаписатьТекст, ЗаписатьСтроку, СброситьБуфер, Сохранить)
//✅ Отмена записи - файл не создаётся при отмене
//✅ Размер и позиция (Позиция, ПерейтиВ, Размер, Сбросить)
//✅ Обработка ошибок (ТекстОшибки)
//✅ Удаление файла (УдалитьФайл, ФайлСуществует)
//✅ Создание с именем файла (конструктор с параметром)
//✅ Получение реального объекта (ПолучитьSaveFile)
//✅ Проверка RusFunc (64 метода в JSON)
//Диагностика показала:
//19 английских методов доступны
//18 из 19 русских методов доступны (метод Существует не доступен, но используется ФайлСуществует из родительского класса)
//Метод RusFunc() работает корректно (JSON длиной 4933, 64 элемента)
//Класс QtSaveFile предоставляет:
//Безопасную запись - данные пишутся во временный файл
//Атомарное сохранение - Сохранить() переименовывает временный файл в целевой
//Отмену записи - ОтменитьЗапись() удаляет временный файл
//Все методы родительского класса QtFile для работы с файлами
//Вывод:
//Класс QtSaveFile (наследник QtFile) полностью функционален и готов к использованию. Он обеспечивает безопасную запись файлов с возможностью 
//отмены и атомарного сохранения. Класс успешно наследуется от QtFile, который в свою очередь наследуется от QtIODevice и QtObject, что 
//обеспечивает полную интеграцию с системой отладки и русскими именами методов.



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtSaveFile
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtSaveFile()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtSaveFile ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtSaveFile: " + (typeof QtSaveFile !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtФайлБезопасный: " + (typeof QtФайлБезопасный !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtSaveFile: " + e)
    КонецПопытки;
    
    Попытка
        диагSaveFile = Новый QtSaveFile()
        Если диагSaveFile == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtSaveFile не создан")
            Возврат
        КонецЕсли;
        
        диагSaveFile.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtSaveFile создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setFileName", "getFileName", "open", "isOpen", "close",
            "commit", "cancelWriting", "exists", "remove",
            "errorString", "write", "writeLine", "flush",
            "readAll", "pos", "seek", "size", "reset",
            "getRealSaveFile"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагSaveFile[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьИмяФайла", "ПолучитьИмяФайла",
            "Открыть", "Открыт", "Закрыть",
            "Сохранить", "ОтменитьЗапись", "Существует", "УдалитьФайл",
            "ТекстОшибки", "ЗаписатьТекст", "ЗаписатьСтроку", "СброситьБуфер",
            "ПрочитатьВсе", "Позиция", "ПерейтиВ", "Размер", "Сбросить",
            "ПолучитьSaveFile"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагSaveFile[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагSaveFile.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагSaveFile.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtSaveFile: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ СОЗДАНИЯ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция СоздатьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        
        Если ! каталог.КаталогСуществует("C:/Temp2") Тогда
            каталог.СоздатьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2")
        Иначе
            ВывестиСтрокуВКонсоль("  Каталог C:/Temp2 уже существует")
        КонецЕсли;
        
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ФУНКЦИЯ ОЧИСТКИ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция ОчиститьТестовуюСтруктуру()
    Попытка
        файл = Новый QtФайл()
        
        файл.УстановитьИмяФайла("C:/Temp2/save_test.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён save_test.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/save_test2.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён save_test2.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/size_test.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён size_test.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/to_delete.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён to_delete.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/direct_file.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён direct_file.txt")
        КонецЕсли;
        
        каталог = Новый QtКаталог()
        Если каталог.КаталогСуществует("C:/Temp2") Тогда 
            каталог.УдалитьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Удалён каталог Temp2")
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("  Тестовая структура очищена")
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ТЕСТ QtSaveFile (QtФайлБезопасный) - исправленная версия
// ============================================================

Функция ТестQtSaveFileFull()
    всегоТестов = 0
    успешноТестов = 0
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Подготовка тестовой структуры в C:/Temp2...")
    СброситьЦветКонсоли()
    Если Не СоздатьТестовуюСтруктуру() Тогда
        Возврат "❌ Тест провален (не удалось создать тестовую структуру)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")
    
    тестПапка = "C:/Temp2"
    тестФайл = тестПапка + "/save_test.txt"
    тестФайл2 = тестПапка + "/save_test2.txt"
    тестФайл3 = тестПапка + "/size_test.txt"
    тестФайл4 = тестПапка + "/to_delete.txt"
    тестФайл5 = тестПапка + "/direct_file.txt"
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    saveFile = null
    Попытка
        saveFile = Новый QtSaveFile()
        Если saveFile != null Тогда
            saveFile.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtSaveFile создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtSaveFile НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если saveFile == null Тогда
        ОчиститьТестовуюСтруктуру()
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ИМЕНИ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка имени файла")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile.УстановитьИмяФайла(тестФайл)
        имя = saveFile.ПолучитьИмяФайла()
        ВывестиСтрокуВКонсоль("    УстановитьИмяФайла() -> ПолучитьИмяФайла(): " + имя)
        
        Если имя == тестФайл Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя файла установлено корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя файла установлено некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ОТКРЫТИЕ И ОТМЕНА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Открытие и отмена")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile.ОтменитьЗапись()
        результат = saveFile.Открыть()
        открыт = saveFile.Открыт()
        ВывестиСтрокуВКонсоль("    Открыть(): " + результат + ", Открыт(): " + открыт)
        
        saveFile.ОтменитьЗапись()
        открытПосле = saveFile.Открыт()
        ВывестиСтрокуВКонсоль("    После ОтменитьЗапись(): " + открытПосле)
        
        Если результат == true И открыт == true И открытПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Открытие и отмена работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Открытие или отмена не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ЗАПИСЬ И СОХРАНЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запись и сохранение")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile4 = Новый QtSaveFile()
        saveFile4.РежимОтладки(Режим_Отладки)
        saveFile4.УстановитьИмяФайла(тестФайл)
        saveFile4.ОтменитьЗапись()
        
        saveFile4.Открыть()
        saveFile4.ЗаписатьТекст("Hello World")
        saveFile4.ЗаписатьСтроку("Line 2")
        saveFile4.ЗаписатьТекст("Final")
        saveFile4.СброситьБуфер()
        
        результатСохр = saveFile4.Сохранить()
        ВывестиСтрокуВКонсоль("    Сохранить(): " + результатСохр)
        
        // Используем ФайлСуществует из родительского класса
        существует = saveFile4.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    ФайлСуществует(): " + существует)
        
        saveFile4.Закрыть()
        содержимое = saveFile4.ПрочитатьВсе()
        ВывестиСтрокуВКонсоль("    Содержимое: " + содержимое)
        
        Если результатСохр == true И существует == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись и сохранение работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись или сохранение не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ОТМЕНА ЗАПИСИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Отмена записи")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile5 = Новый QtSaveFile()
        saveFile5.РежимОтладки(Режим_Отладки)
        saveFile5.УстановитьИмяФайла(тестФайл2)
        saveFile5.ОтменитьЗапись()
        
        saveFile5.Открыть()
        saveFile5.ЗаписатьТекст("This should be cancelled")
        saveFile5.ОтменитьЗапись()
        
        результатСохр2 = saveFile5.Сохранить()
        существует2 = saveFile5.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    Сохранить() после отмены: " + результатСохр2)
        ВывестиСтрокуВКонсоль("    ФайлСуществует(): " + существует2)
        
        Если результатСохр2 == false И существует2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отмена записи работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отмена записи не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. РАЗМЕР И ПОЗИЦИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Размер и позиция")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile6 = Новый QtSaveFile()
        saveFile6.РежимОтладки(Режим_Отладки)
        saveFile6.УстановитьИмяФайла(тестФайл3)
        saveFile6.ОтменитьЗапись()
        
        saveFile6.Открыть()
        saveFile6.ЗаписатьТекст("1234567890")
        
        позиция = saveFile6.Позиция()
        размер = saveFile6.Размер()
        ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
        
        saveFile6.ПерейтиВ(5)
        позиция2 = saveFile6.Позиция()
        ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция(): " + позиция2)
        
        saveFile6.Сбросить()
        позиция3 = saveFile6.Позиция()
        ВывестиСтрокуВКонсоль("    Сбросить() -> Позиция(): " + позиция3)
        
        saveFile6.ОтменитьЗапись()
        
        Если позиция == 10 И размер == 10 И позиция2 == 5 И позиция3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Размер и позиция работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Размер или позиция не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ОШИБКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Ошибки")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile7 = Новый QtSaveFile()
        saveFile7.РежимОтладки(Режим_Отладки)
        saveFile7.ОтменитьЗапись()
        
        результат = saveFile7.Открыть()
        ошибка = saveFile7.ТекстОшибки()
        ВывестиСтрокуВКонсоль("    Открыть() без имени: " + результат)
        ВывестиСтрокуВКонсоль("    ТекстОшибки(): " + ошибка)
        
        Если ошибка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Обработка ошибок работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Обработка ошибок не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. УДАЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Удаление")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile8 = Новый QtSaveFile()
        saveFile8.РежимОтладки(Режим_Отладки)
        saveFile8.УстановитьИмяФайла(тестФайл4)
        saveFile8.ОтменитьЗапись()
        
        saveFile8.Открыть()
        saveFile8.ЗаписатьТекст("Delete me")
        saveFile8.Сохранить()
        saveFile8.Закрыть()
        
        существуетДо = saveFile8.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    ФайлСуществует() до удаления: " + существуетДо)
        
        saveFile8.УдалитьФайл()
        существуетПосле = saveFile8.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    ФайлСуществует() после удаления: " + существуетПосле)
        
        Если существуетДо == true И существуетПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Удаление работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Удаление не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. СОЗДАНИЕ С ИМЕНЕМ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Создание с именем файла")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile9 = Новый QtSaveFile(тестФайл5)
        saveFile9.РежимОтладки(Режим_Отладки)
        
        имя = saveFile9.ПолучитьИмяФайла()
        ВывестиСтрокуВКонсоль("    ПолучитьИмяФайла(): " + имя)
        
        Если имя == тестФайл5 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Создание с именем файла работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя файла не совпадает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = saveFile.ПолучитьSaveFile()
        ВывестиСтрокуВКонсоль("    ПолучитьSaveFile(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof saveFile.RusFunc === 'function' Тогда
            jsonStr = saveFile.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Очистка тестовой структуры...")
    СброситьЦветКонсоли()
    ОчиститьТестовуюСтруктуру()
    ВывестиСтрокуВКонсоль("")
    
    Возврат "Тест QtSaveFile завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtSaveFile (QtФайлБезопасный)                  ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtSaveFile()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtSaveFile (русские и английские методы)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtSaveFileFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtSaveFile: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

