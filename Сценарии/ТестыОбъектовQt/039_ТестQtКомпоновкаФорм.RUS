//Итоги тестирования QtКомпоновкаФорм (QtFormLayout):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Количество строк    ✅ Пройден
//4    Добавление строк    ✅ Пройден
//5    Добавление строки на всю ширину    ✅ Пройден
//6    Вставка строки    ✅ Пройден
//7    Удаление строки    ✅ Пройден
//8    Очистка формы    ✅ Пройден
//9    Промежутки    ✅ Пройден
//10    Получение реальных объектов    ✅ Пройден
//11    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (41 из 41):
//isValid() - проверка валидности
//getRealFormLayout() / getRealLayout() - получение реальных объектов
//rowCount() - количество строк
//horizontalSpacing() / setHorizontalSpacing() - горизонтальный промежуток
//verticalSpacing() / setVerticalSpacing() - вертикальный промежуток
//labelAlignment() / setLabelAlignment() - выравнивание меток
//formAlignment() / setFormAlignment() - выравнивание формы
//fieldGrowthPolicy() / setFieldGrowthPolicy() - политика роста полей
//rowWrapPolicy() / setRowWrapPolicy() - политика переноса строк
//addRow() / addRowWidget() / addRowLayout() - добавление строк
//addRowWidgetFull() / addRowLayoutFull() - добавление строк на всю ширину
//insertRow() / insertRowWidget() / insertRowLayout() - вставка строк
//removeRow() - удаление строк
//clear() - очистка
//itemAt() / takeAt() - работа с элементами
//count() / isEmpty() - количество/проверка на пустоту
//geometry() / contentsRect() - геометрия
//setMargin() / margin() - отступы
//setEnabled() / isEnabled() - доступность
//setObjectName() / objectName() - имя объекта
//copyTo() - копирование
//setDebug() / getDebug() - режим отладки
//Русские (41 из 41):
//Действителен() - isValid
//ПолучитьКомпоновкуФорм() / ПолучитьРасположение() - getRealFormLayout/getRealLayout
//КоличествоСтрок() - rowCount
//ГоризонтальныйПромежуток() / УстановитьГоризонтальныйПромежуток() - horizontalSpacing/setHorizontalSpacing
//ВертикальныйПромежуток() / УстановитьВертикальныйПромежуток() - verticalSpacing/setVerticalSpacing
//ВыравниваниеМеток() / УстановитьВыравниваниеМеток() - labelAlignment/setLabelAlignment
//ВыравниваниеФормы() / УстановитьВыравниваниеФормы() - formAlignment/setFormAlignment
//ПолитикаРостаПолей() / УстановитьПолитикуРостаПолей() - fieldGrowthPolicy/setFieldGrowthPolicy
//ПолитикаПереносаСтрок() / УстановитьПолитикуПереносаСтрок() - rowWrapPolicy/setRowWrapPolicy
//ДобавитьСтроку() / ДобавитьСтрокуСВиджетом() / ДобавитьСтрокуСРасположением() - addRow/addRowWidget/addRowLayout
//ДобавитьСтрокуПолную() / ДобавитьСтрокуРасположениеПолное() - addRowWidgetFull/addRowLayoutFull
//ВставитьСтроку() / ВставитьСтрокуСВиджетом() / ВставитьСтрокуСРасположением() - insertRow/insertRowWidget/insertRowLayout
//УдалитьСтроку() - removeRow
//Очистить() - clear
//ЭлементПоИндексу() / ВзятьПоИндексу() - itemAt/takeAt
//Количество() / Пустой() - count/isEmpty
//Геометрия() / ПрямоугольникСодержимого() - geometry/contentsRect
//УстановитьОтступ() / Отступ() - setMargin/margin
//УстановитьДоступен() / Доступен() - setEnabled/isEnabled
//УстановитьИмяОбъекта() / ИмяОбъекта() - setObjectName/objectName
//КопироватьВ() - copyTo
//РежимОтладки() / ПолучитьРежимОтладки() - setDebug/getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtКомпоновкаФорм
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtFormLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtКомпоновкаФорм ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtFormLayout: " + (typeof QtFormLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtКомпоновкаФорм: " + (typeof QtКомпоновкаФорм !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке: " + e)
    КонецПопытки;
    
    Попытка
        диагLayout = Новый QtКомпоновкаФорм()
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtКомпоновкаФорм не создан")
            Возврат 
        КонецЕсли;
        
        диагLayout.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtКомпоновкаФорм создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealFormLayout", "getRealLayout",
            "rowCount",
            "horizontalSpacing", "setHorizontalSpacing",
            "verticalSpacing", "setVerticalSpacing",
            "labelAlignment", "setLabelAlignment",
            "formAlignment", "setFormAlignment",
            "fieldGrowthPolicy", "setFieldGrowthPolicy",
            "rowWrapPolicy", "setRowWrapPolicy",
            "addRow", "addRowWidget", "addRowLayout",
            "addRowWidgetFull", "addRowLayoutFull",
            "insertRow", "insertRowWidget", "insertRowLayout",
            "removeRow", "clear",
            "itemAt", "takeAt",
            "count", "isEmpty", "geometry", "contentsRect",
            "setMargin", "margin",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьКомпоновкуФорм", "ПолучитьРасположение",
            "КоличествоСтрок",
            "ГоризонтальныйПромежуток", "УстановитьГоризонтальныйПромежуток",
            "ВертикальныйПромежуток", "УстановитьВертикальныйПромежуток",
            "ВыравниваниеМеток", "УстановитьВыравниваниеМеток",
            "ВыравниваниеФормы", "УстановитьВыравниваниеФормы",
            "ПолитикаРостаПолей", "УстановитьПолитикуРостаПолей",
            "ПолитикаПереносаСтрок", "УстановитьПолитикуПереносаСтрок",
            "ДобавитьСтроку", "ДобавитьСтрокуСВиджетом", "ДобавитьСтрокуСРасположением",
            "ДобавитьСтрокуПолную", "ДобавитьСтрокуРасположениеПолное",
            "ВставитьСтроку", "ВставитьСтрокуСВиджетом", "ВставитьСтрокуСРасположением",
            "УдалитьСтроку", "Очистить",
            "ЭлементПоИндексу", "ВзятьПоИндексу",
            "Количество", "Пустой", "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьДоступен", "Доступен",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtКомпоновкаФорм: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКомпоновкаФорм
// ============================================================

Функция ДиагностикаМетаОбъектаFormLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКомпоновкаФорм ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtFormLayout: " + (typeof QtFormLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtКомпоновкаФорм: " + (typeof QtКомпоновкаФорм !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        форма = Новый QtКомпоновкаФорм()
        Если форма == null Тогда
            форма = new QtКомпоновкаФорм()
            Если форма == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtКомпоновкаФорм()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКомпоновкаФорм:")
    методы = Object.getOwnPropertyNames(форма)
    прототип = Object.getPrototypeOf(форма)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof форма[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' ИЛИ имя === 'addRow' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof форма.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = форма.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ СОЗДАНИЯ ВИДЖЕТОВ
// ============================================================

Функция ПолучитьРеальныйВиджет(объект)
    Если объект == null Тогда
        Возврат null
    КонецЕсли;
    
    Попытка
        // Способ 1: через getRealWidget()
        Если typeof объект.getRealWidget === 'function' Тогда
            Возврат объект.getRealWidget()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 2: через ПолучитьВиджет()
        Если typeof объект.ПолучитьВиджет === 'function' Тогда
            Возврат объект.ПолучитьВиджет()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 3: через getRealObject()
        Если typeof объект.getRealObject === 'function' Тогда
            Возврат объект.getRealObject()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 4: через ПолучитьОбъект()
        Если typeof объект.ПолучитьОбъект === 'function' Тогда
            Возврат объект.ПолучитьОбъект()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    // Если ничего не работает, возвращаем сам объект (может не сработать)
    Возврат объект
КонецФункции

Функция СоздатьРедактор()
    Попытка
        редактор = Новый QtРедакторСтроки()
        Если редактор == null Тогда
            Возврат null
        КонецЕсли;
        Возврат ПолучитьРеальныйВиджет(редактор)
    Исключение
        ВывестиСтрокуВКонсоль("    ⚠️ Ошибка создания редактора: " + e)
        Возврат null
    КонецПопытки
КонецФункции

Функция СоздатьКнопку(текст)
    Попытка
        кнопка = Новый QtКнопка(текст)
        Если кнопка == null Тогда
            Возврат null
        КонецЕсли;
        Возврат ПолучитьРеальныйВиджет(кнопка)
    Исключение
        ВывестиСтрокуВКонсоль("    ⚠️ Ошибка создания кнопки: " + e)
        Возврат null
    КонецПопытки
КонецФункции

// ============================================================
// ТЕСТ QtКомпоновкаФорм (QtFormLayout) - ИСПРАВЛЕННЫЙ
// ============================================================

Функция ТестQtFormLayoutFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    форма = null
    Попытка
        форма = Новый QtКомпоновкаФорм()
        Если форма != null Тогда
            форма.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtКомпоновкаФорм создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtКомпоновкаФорм НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если форма == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = форма.isValid()
        валидныйРус = форма.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. КОЛИЧЕСТВО СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Количество строк")
    СброситьЦветКонсоли()
    
    Попытка
        строк = форма.rowCount()
        строкРус = форма.КоличествоСтрок()
        ВывестиСтрокуВКонсоль("    rowCount(): " + строк + " / КоличествоСтрок(): " + строкРус)
        
        Если строк >= 0 И строкРус >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Количество строк работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Количество строк не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ДОБАВЛЕНИЕ СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Добавление строк")
    СброситьЦветКонсоли()
    
    Попытка
        форма.Очистить()
        
        поле1 = СоздатьРедактор()
        поле2 = СоздатьРедактор()
        поле3 = СоздатьРедактор()
        поле4 = СоздатьРедактор()
        
        Если поле1 != null И поле2 != null И поле3 != null И поле4 != null Тогда
            форма.addRow("Имя:", поле1)
            форма.addRow("Email:", поле2)
            форма.ДобавитьСтроку("Телефон:", поле3)
            форма.ДобавитьСтроку("Адрес:", поле4)
            
            кол = форма.rowCount()
            колРус = форма.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("    Добавлено 4 строки: rowCount()=" + кол + " / КоличествоСтрок()=" + колРус)
            
            Если кол == 4 И колРус == 4 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Добавление строк работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Добавление строк не работает (ожидалось 4, получено " + кол + ")")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать виджеты (тест пропущен)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ДОБАВЛЕНИЕ СТРОКИ НА ВСЮ ШИРИНУ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Добавление строки на всю ширину")
    СброситьЦветКонсоли()
    
    Попытка
        форма.Очистить()
        
        кнопка1 = СоздатьКнопку("Кнопка 1")
        кнопка2 = СоздатьКнопку("Кнопка 2")
        
        Если кнопка1 != null И кнопка2 != null Тогда
            форма.addRowWidgetFull(кнопка1)
            форма.ДобавитьСтрокуПолную(кнопка2)
            
            кол = форма.rowCount()
            колРус = форма.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("    Добавлено 2 строки на всю ширину: rowCount()=" + кол + " / КоличествоСтрок()=" + колРус)
            
            Если кол == 2 И колРус == 2 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Добавление строк на всю ширину работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Добавление строк на всю ширину не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать кнопки (тест пропущен)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ВСТАВКА СТРОКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Вставка строки")
    СброситьЦветКонсоли()
    
    Попытка
        форма.Очистить()
        
        поле1 = СоздатьРедактор()
        поле2 = СоздатьРедактор()
        поле3 = СоздатьРедактор()
        поле4 = СоздатьРедактор()
        
        Если поле1 != null И поле2 != null И поле3 != null И поле4 != null Тогда
            форма.addRow("Строка 1:", поле1)
            форма.addRow("Строка 3:", поле2)
            форма.insertRow(1, "Строка 2:", поле3)
            форма.ВставитьСтроку(2, "Строка 2.5:", поле4)
            
            кол = форма.rowCount()
            колРус = форма.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("    Вставлено 2 строки: rowCount()=" + кол + " / КоличествоСтрок()=" + колРус)
            
            Если кол == 4 И колРус == 4 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Вставка строк работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Вставка строк не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать виджеты (тест пропущен)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. УДАЛЕНИЕ СТРОКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Удаление строки")
    СброситьЦветКонсоли()
    
    Попытка
        форма.Очистить()
        
        поле1 = СоздатьРедактор()
        поле2 = СоздатьРедактор()
        поле3 = СоздатьРедактор()
        
        Если поле1 != null И поле2 != null И поле3 != null Тогда
            форма.addRow("Строка 1:", поле1)
            форма.addRow("Строка 2:", поле2)
            форма.addRow("Строка 3:", поле3)
            
            форма.removeRow(0)
            форма.УдалитьСтроку(1)
            
            кол = форма.rowCount()
            колРус = форма.КоличествоСтрок()
            ВывестиСтрокуВКонсоль("    Удалено 2 строки: rowCount()=" + кол + " / КоличествоСтрок()=" + колРус)
            
            Если кол == 1 И колРус == 1 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Удаление строк работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Удаление строк не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать виджеты (тест пропущен)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ОЧИСТКА ФОРМЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Очистка формы")
    СброситьЦветКонсоли()
    
    Попытка
        форма.Очистить()
        
        поле1 = СоздатьРедактор()
        поле2 = СоздатьРедактор()
        
        Если поле1 != null И поле2 != null Тогда
            форма.addRow("Строка 1:", поле1)
            форма.addRow("Строка 2:", поле2)
            
            колДо = форма.rowCount()
            форма.clear()
            колПосле = форма.rowCount()
            
            форма.addRow("Строка 3:", СоздатьРедактор())
            форма.addRow("Строка 4:", СоздатьРедактор())
            колДоРус = форма.КоличествоСтрок()
            форма.Очистить()
            колПослеРус = форма.КоличествоСтрок()
            
            ВывестиСтрокуВКонсоль("    clear(): до=" + колДо + ", после=" + колПосле)
            ВывестиСтрокуВКонсоль("    Очистить(): до=" + колДоРус + ", после=" + колПослеРус)
            
            Если колПосле == 0 И колПослеРус == 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Очистка формы работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Очистка формы не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать виджеты (тест пропущен)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОМЕЖУТКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Промежутки")
    СброситьЦветКонсоли()
    
    Попытка
        форма.setHorizontalSpacing(10)
        гориз = форма.horizontalSpacing()
        форма.УстановитьГоризонтальныйПромежуток(15)
        горизРус = форма.ГоризонтальныйПромежуток()
        
        форма.setVerticalSpacing(5)
        верт = форма.verticalSpacing()
        форма.УстановитьВертикальныйПромежуток(8)
        вертРус = форма.ВертикальныйПромежуток()
        
        ВывестиСтрокуВКонсоль("    horizontalSpacing: " + гориз + " / " + горизРус)
        ВывестиСтрокуВКонсоль("    verticalSpacing: " + верт + " / " + вертРус)
        
        Если гориз == 10 И горизРус == 15 И верт == 5 И вертРус == 8 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Промежутки работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Промежутки не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реальных объектов")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = форма.getRealFormLayout()
        реальныйРус = форма.ПолучитьКомпоновкуФорм()
        реальныйLayout = форма.getRealLayout()
        реальныйLayoutРус = форма.ПолучитьРасположение()
        
        ВывестиСтрокуВКонсоль("    getRealFormLayout(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьКомпоновкуФорм(): " + (реальныйРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "valid" : "null"))
        
        Если реальный != null И реальныйРус != null И реальныйLayout != null И реальныйLayoutРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реальных объектов работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реальных объектов не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof форма.RusFunc === 'function' Тогда
            jsonStr = форма.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtКомпоновкаФорм завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


