//Итоги тестирования QtКомпоновкаФорм (QtFormLayout):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Количество строк    ✅ Пройден
//4    Добавление строк    ✅ Пройден
//5    Добавление строки на всю ширину    ✅ Пройден
//6    Вставка строки    ✅ Пройден
//7    Удаление строки    ✅ Пройден
//8    Очистка формы    ✅ Пройден
//9    Промежутки    ✅ Пройден
//10    Получение реальных объектов    ✅ Пройден
//11    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (41 из 41):
//isValid() - проверка валидности
//getRealFormLayout() / getRealLayout() - получение реальных объектов
//rowCount() - количество строк
//horizontalSpacing() / setHorizontalSpacing() - горизонтальный промежуток
//verticalSpacing() / setVerticalSpacing() - вертикальный промежуток
//labelAlignment() / setLabelAlignment() - выравнивание меток
//formAlignment() / setFormAlignment() - выравнивание формы
//fieldGrowthPolicy() / setFieldGrowthPolicy() - политика роста полей
//rowWrapPolicy() / setRowWrapPolicy() - политика переноса строк
//addRow() / addRowWidget() / addRowLayout() - добавление строк
//addRowWidgetFull() / addRowLayoutFull() - добавление строк на всю ширину
//insertRow() / insertRowWidget() / insertRowLayout() - вставка строк
//removeRow() - удаление строк
//clear() - очистка
//itemAt() / takeAt() - работа с элементами
//count() / isEmpty() - количество/проверка на пустоту
//geometry() / contentsRect() - геометрия
//setMargin() / margin() - отступы
//setEnabled() / isEnabled() - доступность
//setObjectName() / objectName() - имя объекта
//copyTo() - копирование
//setDebug() / getDebug() - режим отладки
//Русские (41 из 41):
//Действителен() - isValid
//ПолучитьКомпоновкуФорм() / ПолучитьРасположение() - getRealFormLayout/getRealLayout
//КоличествоСтрок() - rowCount
//ГоризонтальныйПромежуток() / УстановитьГоризонтальныйПромежуток() - horizontalSpacing/setHorizontalSpacing
//ВертикальныйПромежуток() / УстановитьВертикальныйПромежуток() - verticalSpacing/setVerticalSpacing
//ВыравниваниеМеток() / УстановитьВыравниваниеМеток() - labelAlignment/setLabelAlignment
//ВыравниваниеФормы() / УстановитьВыравниваниеФормы() - formAlignment/setFormAlignment
//ПолитикаРостаПолей() / УстановитьПолитикуРостаПолей() - fieldGrowthPolicy/setFieldGrowthPolicy
//ПолитикаПереносаСтрок() / УстановитьПолитикуПереносаСтрок() - rowWrapPolicy/setRowWrapPolicy
//ДобавитьСтроку() / ДобавитьСтрокуСВиджетом() / ДобавитьСтрокуСРасположением() - addRow/addRowWidget/addRowLayout
//ДобавитьСтрокуПолную() / ДобавитьСтрокуРасположениеПолное() - addRowWidgetFull/addRowLayoutFull
//ВставитьСтроку() / ВставитьСтрокуСВиджетом() / ВставитьСтрокуСРасположением() - insertRow/insertRowWidget/insertRowLayout
//УдалитьСтроку() - removeRow
//Очистить() - clear
//ЭлементПоИндексу() / ВзятьПоИндексу() - itemAt/takeAt
//Количество() / Пустой() - count/isEmpty
//Геометрия() / ПрямоугольникСодержимого() - geometry/contentsRect
//УстановитьОтступ() / Отступ() - setMargin/margin
//УстановитьДоступен() / Доступен() - setEnabled/isEnabled
//УстановитьИмяОбъекта() / ИмяОбъекта() - setObjectName/objectName
//КопироватьВ() - copyTo
//РежимОтладки() / ПолучитьРежимОтладки() - setDebug/getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtКомпоновкаФорм
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtFormLayout()
    ИмяКласса = "QtFormLayout"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtFormLayout !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtFormLayout()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКомпоновкаФорм
// ============================================================

Функция ДиагностикаМетаОбъектаFormLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКомпоновкаФорм ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtFormLayout: " + (typeof QtFormLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtКомпоновкаФорм: " + (typeof QtКомпоновкаФорм !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        форма1 = Новый QtКомпоновкаФорм()
        Если форма1 == null Тогда
          ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
          Возврат 
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtКомпоновкаФорм()")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКомпоновкаФорм:")
    методы = Object.getOwnPropertyNames(форма1)
    прототип = Object.getPrototypeOf(форма1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof форма1[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' ИЛИ имя === 'addRow' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof форма1.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = форма1.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ СОЗДАНИЯ ВИДЖЕТОВ
// ============================================================

Функция ПолучитьРеальныйВиджет(объект)
    Если объект == null Тогда
        Возврат null
    КонецЕсли;
    
    Попытка
        // Способ 1: через getRealWidget()
        Если typeof объект.getRealWidget === 'function' Тогда
            Возврат объект.getRealWidget()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 2: через ПолучитьВиджет()
        Если typeof объект.ПолучитьВиджет === 'function' Тогда
            Возврат объект.ПолучитьВиджет()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 3: через getRealObject()
        Если typeof объект.getRealObject === 'function' Тогда
            Возврат объект.getRealObject()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    Попытка
        // Способ 4: через ПолучитьОбъект()
        Если typeof объект.ПолучитьОбъект === 'function' Тогда
            Возврат объект.ПолучитьОбъект()
        КонецЕсли;
    Исключение
        // Игнорируем
    КонецПопытки;
    
    // Если ничего не работает, возвращаем сам объект (может не сработать)
    Возврат объект
КонецФункции

Функция СоздатьРедактор()
    Попытка
        редактор = Новый QtРедакторСтроки()
        Если редактор == null Тогда
            Возврат null
        КонецЕсли;
        Возврат ПолучитьРеальныйВиджет(редактор)
    Исключение
        ВывестиСтрокуВКонсоль("    ⚠️ Ошибка создания редактора: " + e)
        Возврат null
    КонецПопытки
КонецФункции

Функция СоздатьКнопку(текст)
    Попытка
        кнопка = Новый QtКнопка(текст)
        Если кнопка == null Тогда
            Возврат null
        КонецЕсли;
        Возврат ПолучитьРеальныйВиджет(кнопка)
    Исключение
        ВывестиСтрокуВКонсоль("    ⚠️ Ошибка создания кнопки: " + e)
        Возврат null
    КонецПопытки
КонецФункции

// ============================================================
// ТЕСТ QtКомпоновкаФорм (QtFormLayout) - ИСПРАВЛЕННЫЙ
// ============================================================

Функция ТестQtFormLayoutFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
