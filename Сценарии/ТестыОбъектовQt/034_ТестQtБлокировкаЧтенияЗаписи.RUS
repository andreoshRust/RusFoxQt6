        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            рекурсивнаяБлокировкаРус = Новый QtБлокировкаЧтенияЗаписи(1)
            Если рекурсивнаяБлокировкаРус != null Тогда
                рекурсивнаяБлокировкаРус.РежимОтладки(ИСТИНА)
                рекРус = рекурсивнаяБлокировкаРус.РекурсивнаяБлокировка()
                ВывестиСтрокуВКонсоль("    [RUS] РекурсивнаяБлокировка: " + рекРус + " (ожидается true)")
                
                Если рекРус == ИСТИНА Тогда
                    русУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Рекурсивная блокировка работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + рекРус)
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Рекурсивная блокировка не создана")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

// ===== 12. КОПИРОВАНИЕ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 12: Копирование")
СброситьЦветКонсоли()

