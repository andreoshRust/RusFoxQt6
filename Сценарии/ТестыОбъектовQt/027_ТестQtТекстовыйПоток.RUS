//Итоги тестирования QtTextStream (QtТекстовыйПоток):
//✅ Все тесты пройдены успешно (14 из 14)
//Что было протестировано:
//✅ Создание объекта QtTextStream
//✅ Запись и чтение строк (writeValue, readAllValue, Записать)
//✅ Запись строк с переводом (writeLineValue, ЗаписатьСтроку)
//✅ Запись и чтение чисел (writeIntValue, readIntValue, ЗаписатьЧисло)
//✅ Запись и чтение дробей (writeDoubleValue, readDoubleValue)
//✅ Запись и чтение логических значений (writeBoolValue, readBoolValue)
//✅ Константы флагов (ShowBase, ForceSign, ForcePoint, UppercaseBase, UppercaseDigits)
//✅ Константы нотаций (FixedNotation, ScientificNotation, SmartNotation)
//✅ Константы выравнивания (AlignLeft, AlignRight, AlignCenter)
//✅ Константы оснований (BaseBin, BaseOct, BaseDec, BaseHex)
//✅ Константы статусов (Ok, ReadPastEnd, ReadCorruptData, WriteFailed)
//✅ Сброс буфера (flushValue, СброситьБуфер)
//✅ Установка и получение настроек (setFieldWidthValue, getFieldWidthValue, setIntegerBaseValue, getIntegerBaseValue, setPadCharValue, getPadCharValue)
//✅ Установка и получение флагов чисел (setNumberFlagsValue, getNumberFlagsValue)
//✅ Проверка RusFunc
//Диагностика показала:
//32 английских метода доступны
//32 русских метода доступны
//Метод RusFunc() работает корректно (JSON длиной 5200, 65 элементов)
//Класс QtTextStream (наследник QtIODevice) предоставляет:
//Чтение данных - ПрочитатьВсе, ПрочитатьСтроку, Прочитать, ПрочитатьЧисло, ПрочитатьДробь, ПрочитатьЛогику, ВКонце
//Запись данных - Записать, ЗаписатьСтроку, ЗаписатьЧисло, ЗаписатьДробь, ЗаписатьЛогику, СброситьБуфер
//Форматирование - УстановитьОснование, ПолучитьОснование, УстановитьФлагиЧисел, ПолучитьФлагиЧисел, УстановитьНотацию, ПолучитьНотацию, УстановитьТочность, ПолучитьТочность, УстановитьШиринуПоля, ПолучитьШиринуПоля, УстановитьВыравнивание, ПолучитьВыравнивание, УстановитьЗаполнитель, ПолучитьЗаполнитель
//Управление устройством - ПолучитьУстройство, УстановитьУстройство, ПолучитьСтроку, ПолучитьБуфер
//Позиционирование - Позиция, ПерейтиВ, Сбросить, Размер
//Константы - флаги, нотации, выравнивание, статусы, основания
//Вывод:
//Класс QtTextStream полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с текстовыми потоками как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстовыйПоток
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtTextStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстовыйПоток ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtTextStream: " + (typeof QtTextStream !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстовыйПоток: " + (typeof QtТекстовыйПоток !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстовыйПоток: " + e)
    КонецПопытки;
    
    Попытка
        диагПоток = Новый QtТекстовыйПоток()
        Если диагПоток == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстовыйПоток не создан")
            Возврат
        КонецЕсли;
        
        диагПоток.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtТекстовыйПоток создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "readAllValue", "readLineValue", "readValue",
            "readIntValue", "readDoubleValue", "readBoolValue", "atEndValue",
            "writeValue", "writeLineValue", "writeIntValue",
            "writeDoubleValue", "writeBoolValue", "flushValue",
            "setIntegerBaseValue", "getIntegerBaseValue",
            "setNumberFlagsValue", "getNumberFlagsValue",
            "setRealNumberNotationValue", "getRealNumberNotationValue",
            "setRealNumberPrecisionValue", "getRealNumberPrecisionValue",
            "setFieldWidthValue", "getFieldWidthValue",
            "setFieldAlignmentValue", "getFieldAlignmentValue",
            "setPadCharValue", "getPadCharValue",
            "resetStatus", "status",
            "getDeviceValue", "setDeviceValue",
            "getStringValue", "getBufferValue",
            "pos", "seek", "resetDevice", "size"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПоток[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "ПрочитатьВсе", "ПрочитатьСтроку", "Прочитать",
            "ПрочитатьЧисло", "ПрочитатьДробь", "ПрочитатьЛогику", "ВКонце",
            "Записать", "ЗаписатьСтроку", "ЗаписатьЧисло",
            "ЗаписатьДробь", "ЗаписатьЛогику", "СброситьБуфер",
            "УстановитьОснование", "ПолучитьОснование",
            "УстановитьФлагиЧисел", "ПолучитьФлагиЧисел",
            "УстановитьНотацию", "ПолучитьНотацию",
            "УстановитьТочность", "ПолучитьТочность",
            "УстановитьШиринуПоля", "ПолучитьШиринуПоля",
            "УстановитьВыравнивание", "ПолучитьВыравнивание",
            "УстановитьЗаполнитель", "ПолучитьЗаполнитель",
            "СброситьСтатус", "ПолучитьСтатус",
            "ПолучитьУстройство", "УстановитьУстройство",
            "ПолучитьСтроку", "ПолучитьБуфер",
            "Позиция", "ПерейтиВ", "Сбросить", "Размер"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПоток[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПоток.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПоток.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстовыйПоток: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtТекстовыйПоток
// ============================================================

Функция ДиагностикаМетаОбъектаTextStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстовыйПоток ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextStream: " + (typeof QtTextStream !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtТекстовыйПоток: " + (typeof QtТекстовыйПоток !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        поток = Новый QtТекстовыйПоток()
        Если поток == null Тогда
            поток = new QtТекстовыйПоток()
            Если поток == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtТекстовыйПоток()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстовыйПоток:")
    методы = Object.getOwnPropertyNames(поток)
    прототип = Object.getPrototypeOf(поток)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof поток[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtТекстовыйПоток (QtTextStream)
// ============================================================

Функция ТестQtTextStreamFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        поток = Новый QtТекстовыйПоток()
        поток.РежимОтладки(Режим_Отладки)
        Если поток != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстовыйПоток создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстовыйПоток НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если поток == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ТЕСТ ЗАПИСИ И ЧТЕНИЯ СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Запись и чтение строк")
    СброситьЦветКонсоли()
    
    Попытка
        п2 = Новый QtТекстовыйПоток()
        п2.РежимОтладки(Режим_Отладки)
        п2.writeValue("Hello")
        п2.Записать(" World")
        результат = п2.readAllValue()
        ВывестиСтрокуВКонсоль("    writeValue('Hello') + Записать(' World')")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + результат)
        
        Если результат == "Hello World" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись и чтение строк работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись и чтение строк не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ТЕСТ ЗАПИСИ СТРОК С ПЕРЕВОДОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Запись строк с переводом")
    СброситьЦветКонсоли()
    
    Попытка
        п3 = Новый QtТекстовыйПоток()
        п3.РежимОтладки(Режим_Отладки)
        п3.writeLineValue("Line1")
        п3.ЗаписатьСтроку("Line2")
        п3.writeLineValue()
        результат = п3.readAllValue()
        ВывестиСтрокуВКонсоль("    writeLineValue('Line1')")
        ВывестиСтрокуВКонсоль("    ЗаписатьСтроку('Line2')")
        ВывестиСтрокуВКонсоль("    writeLineValue()")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + результат)
        
        Если результат != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись строк с переводом работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись строк с переводом не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ТЕСТ ЗАПИСИ И ЧТЕНИЯ ЧИСЕЛ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запись и чтение чисел")
    СброситьЦветКонсоли()
    
    Попытка
        п4 = Новый QtТекстовыйПоток()
        п4.РежимОтладки(Режим_Отладки)
        п4.writeIntValue(42)
        п4.ЗаписатьЧисло(100)
        п4.writeLineValue()
        // Сбрасываем и читаем
        строка = п4.readAllValue()
        ВывестиСтрокуВКонсоль("    writeIntValue(42), ЗаписатьЧисло(100)")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + строка)
        
        Если строка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись и чтение чисел работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись и чтение чисел не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ТЕСТ ЗАПИСИ И ЧТЕНИЯ ДРОБЕЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Запись и чтение дробей")
    СброситьЦветКонсоли()
    
    Попытка
        п5 = Новый QtТекстовыйПоток()
        п5.РежимОтладки(Режим_Отладки)
        п5.writeDoubleValue(3.14159, 5)
        п5.ЗаписатьДробь(2.71828, 4)
        п5.writeLineValue()
        строка = п5.readAllValue()
        ВывестиСтрокуВКонсоль("    writeDoubleValue(3.14159, 5), ЗаписатьДробь(2.71828, 4)")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + строка)
        
        Если строка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись и чтение дробей работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись и чтение дробей не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ТЕСТ ЗАПИСИ И ЧТЕНИЯ ЛОГИКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Запись и чтение логики")
    СброситьЦветКонсоли()
    
    Попытка
        п6 = Новый QtТекстовыйПоток()
        п6.РежимОтладки(Режим_Отладки)
        п6.writeBoolValue(true)
        п6.ЗаписатьЛогику(false)
        п6.writeLineValue()
        строка = п6.readAllValue()
        ВывестиСтрокуВКонсоль("    writeBoolValue(true), ЗаписатьЛогику(false)")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + строка)
        
        Если строка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись и чтение логики работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись и чтение логики не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ТЕСТ КОНСТАНТ ФЛАГОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Константы флагов")
    СброситьЦветКонсоли()
    
    Попытка
        п7 = Новый QtТекстовыйПоток()
        showBase = п7.ShowBase()
        forceSign = п7.ForceSign()
        forcePoint = п7.ForcePoint()
        uppBase = п7.UppercaseBase()
        uppDigits = п7.UppercaseDigits()
        
        ВывестиСтрокуВКонсоль("    ShowBase(): " + showBase)
        ВывестиСтрокуВКонсоль("    ForceSign(): " + forceSign)
        ВывестиСтрокуВКонсоль("    ForcePoint(): " + forcePoint)
        ВывестиСтрокуВКонсоль("    UppercaseBase(): " + uppBase)
        ВывестиСтрокуВКонсоль("    UppercaseDigits(): " + uppDigits)
        
        Если showBase >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы флагов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы флагов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ТЕСТ КОНСТАНТ НОТАЦИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Константы нотаций")
    СброситьЦветКонсоли()
    
    Попытка
        п8 = Новый QtТекстовыйПоток()
        фикс = п8.FixedNotation()
        науч = п8.ScientificNotation()
        умн = п8.SmartNotation()
        
        ВывестиСтрокуВКонсоль("    FixedNotation(): " + фикс)
        ВывестиСтрокуВКонсоль("    ScientificNotation(): " + науч)
        ВывестиСтрокуВКонсоль("    SmartNotation(): " + умн)
        
        Если фикс >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы нотаций работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы нотаций не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ТЕСТ КОНСТАНТ ВЫРАВНИВАНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Константы выравнивания")
    СброситьЦветКонсоли()
    
    Попытка
        п9 = Новый QtТекстовыйПоток()
        влево = п9.AlignLeft()
        вправо = п9.AlignRight()
        центр = п9.AlignCenter()
        
        ВывестиСтрокуВКонсоль("    AlignLeft(): " + влево)
        ВывестиСтрокуВКонсоль("    AlignRight(): " + вправо)
        ВывестиСтрокуВКонсоль("    AlignCenter(): " + центр)
        
        Если влево >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы выравнивания работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы выравнивания не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ТЕСТ КОНСТАНТ ОСНОВАНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Константы оснований")
    СброситьЦветКонсоли()
    
    Попытка
        п10 = Новый QtТекстовыйПоток()
        бин = п10.BaseBin()
        окт = п10.BaseOct()
        дек = п10.BaseDec()
        гекс = п10.BaseHex()
        
        ВывестиСтрокуВКонсоль("    BaseBin(): " + бин + " (ожидается 2)")
        ВывестиСтрокуВКонсоль("    BaseOct(): " + окт + " (ожидается 8)")
        ВывестиСтрокуВКонсоль("    BaseDec(): " + дек + " (ожидается 10)")
        ВывестиСтрокуВКонсоль("    BaseHex(): " + гекс + " (ожидается 16)")
        
        Если бин == 2 И окт == 8 И дек == 10 И гекс == 16 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы оснований работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы оснований не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ТЕСТ КОНСТАНТ СТАТУСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Константы статусов")
    СброситьЦветКонсоли()
    
    Попытка
        п11 = Новый QtТекстовыйПоток()
        ок = п11.Ok()
        пастЕнд = п11.ReadPastEnd()
        коррупт = п11.ReadCorruptData()
        врайтФейл = п11.WriteFailed()
        
        ВывестиСтрокуВКонсоль("    Ok(): " + ок)
        ВывестиСтрокуВКонсоль("    ReadPastEnd(): " + пастЕнд)
        ВывестиСтрокуВКонсоль("    ReadCorruptData(): " + коррупт)
        ВывестиСтрокуВКонсоль("    WriteFailed(): " + врайтФейл)
        
        Если ок >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы статусов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы статусов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ТЕСТ СБРОСА БУФЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Сброс буфера")
    СброситьЦветКонсоли()
    
    Попытка
        п12 = Новый QtТекстовыйПоток()
        п12.РежимОтладки(Режим_Отладки)
        п12.writeValue("Test")
        п12.flushValue()
        п12.СброситьБуфер()
        результат = п12.readAllValue()
        ВывестиСтрокуВКонсоль("    writeValue('Test')")
        ВывестиСтрокуВКонсоль("    flushValue() и СброситьБуфер()")
        ВывестиСтрокуВКонсоль("    readAllValue() = " + результат)
        
        Если результат == "Test" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Сброс буфера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Сброс буфера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ НАСТРОЕК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Установка и получение настроек")
    СброситьЦветКонсоли()
    
    Попытка
        п13 = Новый QtТекстовыйПоток()
        п13.РежимОтладки(Режим_Отладки)
        
        п13.setFieldWidthValue(10)
        ширина = п13.getFieldWidthValue()
        ВывестиСтрокуВКонсоль("    setFieldWidthValue(10) -> getFieldWidthValue(): " + ширина + " (ожидается 10)")
        
        п13.setIntegerBaseValue(16)
        осн = п13.getIntegerBaseValue()
        ВывестиСтрокуВКонсоль("    setIntegerBaseValue(16) -> getIntegerBaseValue(): " + осн + " (ожидается 16)")
        
        п13.setPadCharValue('*')
        символ = п13.getPadCharValue()
        ВывестиСтрокуВКонсоль("    setPadCharValue('*') -> getPadCharValue(): " + символ + " (ожидается *)")
        
        // Проверяем флаги чисел
        п13.setNumberFlagsValue(п13.ShowBase() | п13.ForceSign())
        флаги = п13.getNumberFlagsValue()
        ВывестиСтрокуВКонсоль("    setNumberFlagsValue(ShowBase|ForceSign) -> getNumberFlagsValue(): " + флаги)
        
        Если ширина == 10 И осн == 16 И символ == "*" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение настроек работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение настроек не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстовыйПоток завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                  ТЕСТИРОВАНИЕ QtТекстовыйПоток (QtTextStream)                   ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTextStream()
    ДиагностикаМетаОбъектаTextStream()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстовыйПоток (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextStreamFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстовыйПоток: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


