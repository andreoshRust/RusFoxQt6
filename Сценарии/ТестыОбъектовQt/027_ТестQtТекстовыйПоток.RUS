//Итоги тестирования QtTextStream (QtТекстовыйПоток):
//✅ Все тесты пройдены успешно (14 из 14)
//Что было протестировано:
//✅ Создание объекта QtTextStream
//✅ Запись и чтение строк (writeValue, readAllValue, Записать)
//✅ Запись строк с переводом (writeLineValue, ЗаписатьСтроку)
//✅ Запись и чтение чисел (writeIntValue, readIntValue, ЗаписатьЧисло)
//✅ Запись и чтение дробей (writeDoubleValue, readDoubleValue)
//✅ Запись и чтение логических значений (writeBoolValue, readBoolValue)
//✅ Константы флагов (ShowBase, ForceSign, ForcePoint, UppercaseBase, UppercaseDigits)
//✅ Константы нотаций (FixedNotation, ScientificNotation, SmartNotation)
//✅ Константы выравнивания (AlignLeft, AlignRight, AlignCenter)
//✅ Константы оснований (BaseBin, BaseOct, BaseDec, BaseHex)
//✅ Константы статусов (Ok, ReadPastEnd, ReadCorruptData, WriteFailed)
//✅ Сброс буфера (flushValue, СброситьБуфер)
//✅ Установка и получение настроек (setFieldWidthValue, getFieldWidthValue, setIntegerBaseValue, getIntegerBaseValue, setPadCharValue, getPadCharValue)
//✅ Установка и получение флагов чисел (setNumberFlagsValue, getNumberFlagsValue)
//✅ Проверка RusFunc
//Диагностика показала:
//32 английских метода доступны
//32 русских метода доступны
//Метод RusFunc() работает корректно (JSON длиной 5200, 65 элементов)
//Класс QtTextStream (наследник QtIODevice) предоставляет:
//Чтение данных - ПрочитатьВсе, ПрочитатьСтроку, Прочитать, ПрочитатьЧисло, ПрочитатьДробь, ПрочитатьЛогику, ВКонце
//Запись данных - Записать, ЗаписатьСтроку, ЗаписатьЧисло, ЗаписатьДробь, ЗаписатьЛогику, СброситьБуфер
//Форматирование - УстановитьОснование, ПолучитьОснование, УстановитьФлагиЧисел, ПолучитьФлагиЧисел, УстановитьНотацию, ПолучитьНотацию, УстановитьТочность, ПолучитьТочность, УстановитьШиринуПоля, ПолучитьШиринуПоля, УстановитьВыравнивание, ПолучитьВыравнивание, УстановитьЗаполнитель, ПолучитьЗаполнитель
//Управление устройством - ПолучитьУстройство, УстановитьУстройство, ПолучитьСтроку, ПолучитьБуфер
//Позиционирование - Позиция, ПерейтиВ, Сбросить, Размер
//Константы - флаги, нотации, выравнивание, статусы, основания
//Вывод:
//Класс QtTextStream полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с текстовыми потоками как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстовыйПоток
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtTextStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtTextStream ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtTextStream: " + (typeof QtTextStream !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtTextStream: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtTextStream()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtTextStream не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtTextStream создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtTextStream: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtТекстовыйПоток
// ============================================================

Функция ДиагностикаМетаОбъектаTextStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстовыйПоток ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextStream: " + (typeof QtTextStream !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtТекстовыйПоток: " + (typeof QtТекстовыйПоток !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        поток1 = Новый QtТекстовыйПоток()
        Если поток1 == null Тогда
            поток2 = new QtТекстовыйПоток()
            Если поток2 == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                поток = поток1
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtТекстовыйПоток()")
            КонецЕсли;
        Иначе
            поток = поток2
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстовыйПоток:")
    методы = Object.getOwnPropertyNames(поток)
    прототип = Object.getPrototypeOf(поток)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof поток[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtТекстовыйПоток (QtTextStream)
// ============================================================

Функция ТестQtTextStreamFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        поток = Новый QtТекстовыйПоток()
        поток.РежимОтладки(Режим_Отладки)
        Если поток != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстовыйПоток создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстовыйПоток НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если поток == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ТЕСТ МЕТОДОВ УПРАВЛЕНИЯ УСТРОЙСТВОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Методы управления устройством")
    СброситьЦветКонсоли()
    
    Попытка
        п2 = Новый QtТекстовыйПоток()
        п2.РежимОтладки(Режим_Отладки)
        
        // Проверяем статус устройства
        открыт = п2.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    УстройствоОткрыто() = " + открыт)
        
        // Проверяем получение устройства
        уст = п2.ПолучитьУстройство()
        ВывестиСтрокуВКонсоль("    ПолучитьУстройство() = " + (уст != null ? "не null" : "null"))
        
        // Проверяем позицию
        поз = п2.Позиция()
        ВывестиСтрокуВКонсоль("    Позиция() = " + поз)
        
        // Проверяем размер
        разм = п2.Размер()
        ВывестиСтрокуВКонсоль("    Размер() = " + разм)
        
        // Проверяем конец
        вконце = п2.ВКонце()
        ВывестиСтрокуВКонсоль("    ВКонце() = " + вконце)
        
        Если открыт != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы управления устройством работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Методы управления устройством не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ТЕСТ РЕЖИМОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Константы режимов")
    СброситьЦветКонсоли()
    
    Попытка
        п3 = Новый QtТекстовыйПоток()
        п3.РежимОтладки(Режим_Отладки)
        
        текст = п3.Текстовый()
        толькоЧтение = п3.ТолькоЧтение()
        толькоЗапись = п3.ТолькоЗапись()
        чтениеЗапись = п3.ЧтениеЗапись()
        добавление = п3.Добавление()
        обрезать = п3.Обрезать()
        безБуферизации = п3.БезБуферизации()
        
        ВывестиСтрокуВКонсоль("    Текстовый() = " + текст)
        ВывестиСтрокуВКонсоль("    ТолькоЧтение() = " + толькоЧтение)
        ВывестиСтрокуВКонсоль("    ТолькоЗапись() = " + толькоЗапись)
        ВывестиСтрокуВКонсоль("    ЧтениеЗапись() = " + чтениеЗапись)
        ВывестиСтрокуВКонсоль("    Добавление() = " + добавление)
        ВывестиСтрокуВКонсоль("    Обрезать() = " + обрезать)
        ВывестиСтрокуВКонсоль("    БезБуферизации() = " + безБуферизации)
        
        Если текст >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы режимов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы режимов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 4. ТЕСТ МЕТОДОВ ЗАПИСИ/ЧТЕНИЯ (проверка API) =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Проверка методов записи/чтения")
СброситьЦветКонсоли()

Попытка
    п4 = Новый QtТекстовыйПоток()
    п4.РежимОтладки(Режим_Отладки)
    
    // Проверяем английские методы
    методыПроверки = [
        "writeData",
        "writeLineData", 
        "putCharData",
        "readAllData",
        "readData",
        "readLineData",
        "getCharData",
        "bytesToWriteData",
        "bytesAvailableData"
    ]
    
    всеМетодыСуществуют = ИСТИНА
    Для i = 0 По методыПроверки.length - 1 Цикл
        имяМетода = методыПроверки[i]
        Если typeof п4[имяМетода] !== 'function' Тогда
            ВывестиСтрокуВКонсоль("    ✗ Метод " + имяМетода + " НЕ СУЩЕСТВУЕТ")
            всеМетодыСуществуют = ЛОЖЬ
        КонецЕсли
    КонецЦикла
    
    // Проверяем, что методы вызываются без ошибок
    Если всеМетодыСуществуют Тогда
        Попытка
            п4.writeData("Тест")
            п4.writeLineData("Строка")
            п4.putCharData('X')
            п4.resetDevice()
            байт = п4.bytesToWriteData()
            доступно = п4.bytesAvailableData()
            ВывестиСтрокуВКонсоль("    bytesToWriteData() = " + байт)
            ВывестиСтрокуВКонсоль("    bytesAvailableData() = " + доступно)
            
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Все методы записи/чтения существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ошибка при вызове методов: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Некоторые методы отсутствуют")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

    // ===== 5. ТЕСТ МЕТОДОВ ПОЗИЦИОНИРОВАНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Методы позиционирования")
    СброситьЦветКонсоли()
    
    Попытка
        п5 = Новый QtТекстовыйПоток()
        п5.РежимОтладки(Режим_Отладки)
        
        // Записываем данные
        п5.ЗаписатьДанные("Test data for positioning")
        
        // Получаем позицию
        поз1 = п5.Позиция()
        ВывестиСтрокуВКонсоль("    Позиция() = " + поз1)
        
        // Перемещаемся
        п5.ПерейтиВ(5)
        поз2 = п5.Позиция()
        ВывестиСтрокуВКонсоль("    ПерейтиВ(5) -> Позиция() = " + поз2)
        
        // Сбрасываем
        п5.СброситьУстройство()
        поз3 = п5.Позиция()
        ВывестиСтрокуВКонсоль("    СброситьУстройство() -> Позиция() = " + поз3)
        
        Если поз1 >= 0 И поз2 >= 0 И поз3 >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы позиционирования работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Методы позиционирования не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ТЕСТ МЕТОДОВ СТАТУСА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Методы статуса")
    СброситьЦветКонсоли()
    
    Попытка
        п6 = Новый QtТекстовыйПоток()
        п6.РежимОтладки(Режим_Отладки)
        
        // Получаем текст ошибки
        ошибка = п6.ТекстОшибки()
        ВывестиСтрокуВКонсоль("    ТекстОшибки() = '" + ошибка + "'")
        
        // Устанавливаем текст ошибки
        п6.УстановитьТекстОшибки("Test error")
        ошибка2 = п6.ТекстОшибки()
        ВывестиСтрокуВКонсоль("    УстановитьТекстОшибки('Test error') -> ТекстОшибки() = '" + ошибка2 + "'")
        
        // Проверяем валидность
        валидный = п6.Валидный()
        ВывестиСтрокуВКонсоль("    Валидный() = " + валидный)
        
        Если ошибка != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы статуса работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Методы статуса не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ТЕСТ МЕТОДОВ УПРАВЛЕНИЯ УСТРОЙСТВОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Открытие/закрытие устройства")
    СброситьЦветКонсоли()
    
    Попытка
        п7 = Новый QtТекстовыйПоток()
        п7.РежимОтладки(Режим_Отладки)
        
        // Проверяем открыто
        открыт1 = п7.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    УстройствоОткрыто() до = " + открыт1)
        
        // Закрываем
        п7.ЗакрытьУстройство()
        открыт2 = п7.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    ЗакрытьУстройство() -> УстройствоОткрыто() = " + открыт2)
        
        // Открываем (если есть метод openDevice)
        Попытка
            п7.ОткрытьУстройство()
            открыт3 = п7.УстройствоОткрыто()
            ВывестиСтрокуВКонсоль("    ОткрытьУстройство() -> УстройствоОткрыто() = " + открыт3)
        Исключение
            ВывестиСтрокуВКонсоль("    ⚠️ ОткрытьУстройство() недоступен (пропускаем)")
        КонецПопытки
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Методы управления устройством работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстовыйПоток завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                  ТЕСТИРОВАНИЕ QtТекстовыйПоток (QtTextStream)                   ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTextStream()
    ДиагностикаМетаОбъектаTextStream()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстовыйПоток (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextStreamFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстовыйПоток: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


