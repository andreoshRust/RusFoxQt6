                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 9. ТЕСТ: ИМЯ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Имя объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // ИСПРАВЛЕНО: объявляем переменные ЗДЕСЬ
    действие9 = Новый QtДействие()
    действие9Рус = Новый QtДействие()
    
    // Английский метод
    Попытка
        действие9.УстановитьИмяОбъекта("myAction")
        имя = действие9.ИмяОбъекта()
        ВывестиСтрокуВКонсоль("    [ENG] УстановитьИмяОбъекта('myAction') -> ИмяОбъекта() = '" + имя + "'")
        
        Если имя == "myAction" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] УстановитьИмяОбъекта()/ИмяОбъекта() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] УстановитьИмяОбъекта()/ИмяОбъекта() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            действие9Рус.УстановитьИмяОбъекта("русскоеДействие")
            имяРус = действие9Рус.ИмяОбъекта()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьИмяОбъекта('русскоеДействие') -> ИмяОбъекта() = '" + имяРус + "'")
            
            Если имяРус == "русскоеДействие" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьИмяОбъекта()/ИмяОбъекта() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьИмяОбъекта()/ИмяОбъекта() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 10. ТЕСТ: isValid() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // ИСПРАВЛЕНО: объявляем переменные ЗДЕСЬ
    действие10 = Новый QtДействие()
    действие10Рус = Новый QtДействие()
    
    // Английский метод
    Попытка
        валид = действие10.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid() = " + валид)
        
        Если валид == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидРус = действие10Рус.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен() = " + валидРус)
            
            Если валидРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    сопоставления = [
        ["1", "Создание объекта", "Создание объекта"],
        ["2", "setText()/text()", "УстановитьТекст()/Текст()"],
        ["3", "setShortcut()/shortcut()", "УстановитьКлавиши()/Клавиши()"],
        ["4", "setCheckable()/setChecked()", "УстановитьПереключаемый()/УстановитьВыбран()"],
        ["5", "setEnabled()/setVisible()", "УстановитьДоступен()/УстановитьВидимый()"],
        ["6", "setData()/data()", "УстановитьДанные()/Данные()"],
        ["7", "setPriority()/priority()", "УстановитьПриоритет()/Приоритет()"],
        ["8", "setAutoRepeat()/autoRepeat()", "УстановитьАвтоповтор()/Автоповтор()"],
        ["9", "setObjectName()/objectName()", "УстановитьИмяОбъекта()/ИмяОбъекта()"],
        ["10", "isValid()", "Действителен()"]
    ]
    
    Для i = 0 По сопоставления.length - 1 Цикл
        строка = сопоставления[i]
        номер = строка[0]
        англМетод = строка[1]
        русМетод = строка[2]
        
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли;
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли;
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли;
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + номер + "    │ " + англМетод + " " + англСтатус + "        │ " + русМетод + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtДействие завершён"
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtГруппаДействий
// ============================================================

Функция ТестQtActionGroup()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта QtГруппаДействий")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    группа = null
    Попытка
        группа = Новый QtГруппаДействий()
        группа.РежимОтладки(ИСТИНА)
        Если группа != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtГруппаДействий создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;

    // ===== ИСПРАВЛЕНО: объявляем ВСЕ переменные ЗДЕСЬ, ОДИН РАЗ =====
    // Переменные для теста 2
    группа2 = Новый QtГруппаДействий()
    действие1 = Новый QtДействие("Действие 1")
    действие2 = Новый QtДействие("Действие 2")
    группа2.ДобавитьДействие(действие1)
    группа2.ДобавитьДействие(действие2)
    группа2Рус = Новый QtГруппаДействий()
    дейст1Рус = Новый QtДействие("Русское действие 1")
    дейст2Рус = Новый QtДействие("Русское действие 2")
    группа2Рус.ДобавитьДействие(дейст1Рус)
    группа2Рус.ДобавитьДействие(дейст2Рус)
    
    // Переменные для теста 3
    группа3 = Новый QtГруппаДействий()
    действ3_1 = Новый QtДействие("Действие A")
    действ3_2 = Новый QtДействие("Действие B")
    группа3.ДобавитьДействие(действ3_1)
    группа3.ДобавитьДействие(действ3_2)
    группа3Рус = Новый QtГруппаДействий()
    действ3Рус1 = Новый QtДействие("Русское A")
    действ3Рус2 = Новый QtДействие("Русское B")
    группа3Рус.ДобавитьДействие(действ3Рус1)
    группа3Рус.ДобавитьДействие(действ3Рус2)
    
    // Переменные для теста 4
    группа4 = Новый QtГруппаДействий()
    действ4_1 = Новый QtДействие("Действие 1")
    действ4_2 = Новый QtДействие("Действие 2")
    группа4.ДобавитьДействие(действ4_1)
    группа4.ДобавитьДействие(действ4_2)
    группа4Рус = Новый QtГруппаДействий()
    действ4Рус1 = Новый QtДействие("Русское 1")
    действ4Рус2 = Новый QtДействие("Русское 2")
    группа4Рус.ДобавитьДействие(действ4Рус1)
    группа4Рус.ДобавитьДействие(действ4Рус2)
    
    // Переменные для теста 5
    группа5 = Новый QtГруппаДействий()
    гр5 = Новый QtДействие()
    группа5Рус = Новый QtГруппаДействий()
    п1Рус = Новый QtДействие()
    
    // Переменные для теста 6
    группа6 = Новый QtГруппаДействий()
    группа6Рус = Новый QtГруппаДействий()
    
    // Переменные для теста 7
    группа7 = Новый QtГруппаДействий()
    группа7Рус = Новый QtГруппаДействий()
    
    // Переменные для теста 8
    группа8 = Новый QtГруппаДействий()
    группа8Рус = Новый QtГруппаДействий()
    
    // Переменные для теста 9
    группа9 = Новый QtГруппаДействий()
    действ9_1 = Новый QtДействие("Действие 1")
    действ9_2 = Новый QtДействие("Действие 2")
    действ9_1.УстановитьПереключаемый(ИСТИНА)
    действ9_2.УстановитьПереключаемый(ИСТИНА)
