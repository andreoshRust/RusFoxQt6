// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДействие
// ============================================================

Функция ДиагностикаМетодовQtAction()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДействие ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДействие: " + (typeof QtДействие !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДействие: " + e)
    КонецПопытки;
    
    Попытка
        диагAction = Новый QtДействие()
        Если диагAction == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДействие не создан")
            Возврат
        КонецЕсли;
        
        диагAction.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДействие создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealAction",
            "text", "setText",
            "icon", "setIcon",
            "iconText", "setIconText",
            "toolTip", "setToolTip",
            "statusTip", "setStatusTip",
            "whatsThis", "setWhatsThis",
            "shortcut", "setShortcut",
            "shortcutContext", "setShortcutContext",
            "isCheckable", "setCheckable",
            "isChecked", "setChecked", "toggle",
            "isEnabled", "setEnabled",
            "isVisible", "setVisible",
            "actionGroup", "setActionGroup",
            "data", "setData",
            "priority", "setPriority",
            "autoRepeat", "setAutoRepeat",
            "font", "setFont",
            "objectName", "setObjectName",
            "trigger", "activate",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагAction[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьРеальноеДействие",
            "Текст", "УстановитьТекст",
            "Иконка", "УстановитьИконку",
            "ТекстИконки", "УстановитьТекстИконки",
            "Подсказка", "УстановитьПодсказку",
            "СтатусПодсказка", "УстановитьСтатусПодсказку",
            "ЧтоЭтоТекст", "УстановитьЧтоЭтоТекст",
            "Клавиши", "УстановитьКлавиши",
            "КонтекстКлавиш", "УстановитьКонтекстКлавиш",
            "Переключаемый", "УстановитьПереключаемый",
            "Выбран", "УстановитьВыбран", "Переключить",
            "Доступен", "УстановитьДоступен",
            "Видимый", "УстановитьВидимый",
            "ГруппаДействий", "УстановитьГруппуДействий",
            "Данные", "УстановитьДанные",
            "Приоритет", "УстановитьПриоритет",
            "Автоповтор", "УстановитьАвтоповтор",
            "Шрифт", "УстановитьШрифт",
            "ИмяОбъекта", "УстановитьИмяОбъекта",
            "Выполнить", "Активировать",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагAction[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагAction.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагAction.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДействие: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtГруппаДействий
// ============================================================

Функция ДиагностикаМетодовQtActionGroup()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtГруппаДействий ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtГруппаДействий: " + (typeof QtГруппаДействий !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtГруппаДействий: " + e)
    КонецПопытки;
    
    Попытка
        диагGroup = Новый QtГруппаДействий()
        Если диагGroup == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtГруппаДействий не создан")
            Возврат
        КонецЕсли;
        
        диагGroup.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtГруппаДействий создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealActionGroup",
            "isEnabled", "setEnabled",
            "isVisible", "setVisible",
            "objectName", "setObjectName",
            "exclusionPolicy", "setExclusionPolicy",
            "parentGroup", "setParentGroup",
            "addAction", "removeAction",
            "actions", "checkedAction",
            "count", "isEmpty",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагGroup[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьРеальнуюГруппу",
            "Доступен", "УстановитьДоступен",
            "Видимый", "УстановитьВидимый",
            "ИмяОбъекта", "УстановитьИмяОбъекта",
            "ПолитикаИсключения", "УстановитьПолитикуИсключения",
            "РодительскаяГруппа", "УстановитьРодительскуюГруппу",
            "ДобавитьДействие", "УдалитьДействие",
            "Действия", "ВыбранноеДействие",
            "Количество", "Пустой",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагGroup[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагGroup.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагGroup.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtГруппаДействий: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДействие
// ============================================================

Функция ТестQtAction()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта QtДействие")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    действие = null
    Попытка
        действие = Новый QtДействие()
        действие.РежимОтладки(ИСТИНА)
        Если действие != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtДействие создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: УСТАНОВКА ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    действие2 = Новый QtДействие()
    
    // Английский метод
    Попытка
        действие2.setText("Сохранить")
        текст = действие2.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText('Сохранить') -> text() = '" + текст + "'")
        
        Если текст == "Сохранить" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setText()/text() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setText()/text() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            действие2Рус = Новый QtДействие()
            действие2Рус.УстановитьТекст("Открыть")
            текстРус = действие2Рус.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст('Открыть') -> Текст() = '" + текстРус + "'")
            
            Если текстРус == "Открыть" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьТекст()/Текст() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьТекст()/Текст() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: УСТАНОВКА КЛАВИШ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка клавиш быстрого доступа")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    действие3 = Новый QtДействие()
    
    // Английский метод
    Попытка
        действие3.setShortcut("Ctrl+S")
        клавиши = действие3.shortcut()
        ВывестиСтрокуВКонсоль("    [ENG] setShortcut('Ctrl+S') -> shortcut() = '" + клавиши.toString() + "'")
        
        Если клавиши.toString() == "Ctrl+S" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setShortcut()/shortcut() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setShortcut()/shortcut() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            действие3Рус = Новый QtДействие()
            действие3Рус.УстановитьКлавиши("Ctrl+O")
            клавишиРус = действие3Рус.Клавиши()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьКлавиши('Ctrl+O') -> Клавиши() = '" + клавишиРус.toString() + "'")
            
            Если клавишиРус.toString() == "Ctrl+O" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьКлавиши()/Клавиши() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
