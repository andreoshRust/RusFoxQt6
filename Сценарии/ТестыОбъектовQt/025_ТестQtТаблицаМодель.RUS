        м10.clearAll()
        строкПосле1 = м10.rowCount()
        колонокПосле1 = м10.columnCount()
        загПосле1 = м10.getHeaderDataValue(0)
        ВывестиСтрокуВКонсоль("  После clearAll(): строк=" + строкПосле1 + ", колонок=" + колонокПосле1 + ", заголовок0=" + загПосле1)
        
        м10.setRowCount(2)
        м10.setColumnCount(2)
        м10.setDataValue(0, 0, "Новые данные")
        м10.setHeaders(["X", "Y"])
        
        м10.Очистить()
        строкПосле2 = м10.rowCount()
        колонокПосле2 = м10.columnCount()
        загПосле2 = м10.getHeaderDataValue(0)
        ВывестиСтрокуВКонсоль("  После Очистить(): строк=" + строкПосле2 + ", колонок=" + колонокПосле2 + ", заголовок0=" + загПосле2)
        
        Если строкПосле1 == 0 И колонокПосле1 == 0 И загПосле1 == "" И строкПосле2 == 0 И колонокПосле2 == 0 И загПосле2 == "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ clearAll() / Очистить() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ clearAll() / Очистить() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 13. ТЕСТ ОБНОВЛЕНИЯ (refresh) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 13. ТЕСТ refresh() / Обновить()                                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м11 = Новый QtТаблицаМодель()
        м11.РежимОтладки(Режим_Отладки)
        м11.setRowCount(2)
        м11.setColumnCount(2)
        м11.setDataValue(0, 0, "Тест")
        
        // Проверяем, что refresh не вызывает ошибок
        м11.refresh()
        м11.Обновить()
        
        данные = м11.getDataValue(0, 0)
        
        ВывестиСтрокуВКонсоль("  refresh() и Обновить() выполнены без ошибок")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 0) = " + данные + " (ожидается Тест)")
        
        Если данные == "Тест" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ refresh() / Обновить() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ refresh() / Обновить() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при обновлении: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 14. ТЕСТ ПОЛУЧЕНИЯ ТАБЛИЧНОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 14. ТЕСТ getTableModel() / ПолучитьТабличнуюМодель()                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м12 = Новый QtТаблицаМодель()
        м12.РежимОтладки(Режим_Отладки)
        м12.setRowCount(1)
        м12.setColumnCount(1)
        м12.setDataValue(0, 0, "Тест модели")
        
        табличнаяМодель = м12.getTableModel()
        русТабличнаяМодель = м12.ПолучитьТабличнуюМодель()
        
        ВывестиСтрокуВКонсоль("  getTableModel() вызван, результат: " + (табличнаяМодель != null ? "не null" : "null"))
        ВывестиСтрокуВКонсоль("  ПолучитьТабличнуюМодель() вызван, результат: " + (русТабличнаяМодель != null ? "не null" : "null"))
        
        Если табличнаяМодель != null И русТабличнаяМодель != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ getTableModel() / ПолучитьТабличнуюМодель() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ getTableModel() / ПолучитьТабличнуюМодель() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении табличной модели: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 15. ТЕСТ РАБОТЫ С БОЛЬШИМ КОЛИЧЕСТВОМ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 15. ТЕСТ РАБОТЫ С БОЛЬШИМ КОЛИЧЕСТВОМ ДАННЫХ                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м13 = Новый QtТаблицаМодель()
        м13.РежимОтладки(Режим_Отладки)
        м13.setRowCount(10)
        м13.setColumnCount(10)
        
        // Заполняем данными
        Для i = 0 По 9 Цикл
            Для j = 0 По 9 Цикл
                м13.setDataValue(i, j, "R" + i + "C" + j)
            КонецЦикла
        КонецЦикла
        
        // Проверяем несколько случайных ячеек
        данные1 = м13.getDataValue(0, 0)
        данные2 = м13.getDataValue(5, 5)
        данные3 = м13.getDataValue(9, 9)
        строк = м13.rowCount()
        колонок = м13.columnCount()
        
        ВывестиСтрокуВКонсоль("  Заполнена таблица 10x10")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 0) = " + данные1 + " (ожидается R0C0)")
        ВывестиСтрокуВКонсоль("  getDataValue(5, 5) = " + данные2 + " (ожидается R5C5)")
        ВывестиСтрокуВКонсоль("  getDataValue(9, 9) = " + данные3 + " (ожидается R9C9)")
        ВывестиСтрокуВКонсоль("  rowCount() = " + строк + " (ожидается 10)")
        ВывестиСтрокуВКонсоль("  columnCount() = " + колонок + " (ожидается 10)")
        
        Если данные1 == "R0C0" И данные2 == "R5C5" И данные3 == "R9C9" И строк == 10 И колонок == 10 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с большим количеством данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с большим количеством данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с большим количеством данных: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 16. ТЕСТ РАБОТЫ С ПУСТЫМИ СТРОКАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 16. ТЕСТ РАБОТЫ С ПУСТЫМИ СТРОКАМИ                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м14 = Новый QtТаблицаМодель()
        м14.РежимОтладки(Режим_Отладки)
        м14.setRowCount(2)
        м14.setColumnCount(2)
        
        // Заполняем только некоторые ячейки
        м14.setDataValue(0, 0, "Есть данные")
        // Ячейка (0,1) остаётся пустой
        // Ячейка (1,0) остаётся пустой
        м14.setDataValue(1, 1, "Тоже данные")
        
        данные1 = м14.getDataValue(0, 0)
        данные2 = м14.getDataValue(0, 1)
        данные3 = м14.getDataValue(1, 0)
        данные4 = м14.getDataValue(1, 1)
        
        ВывестиСтрокуВКонсоль("  setDataValue(0, 0, 'Есть данные')")
        ВывестиСтрокуВКонсоль("  (0,1) и (1,0) оставлены пустыми")
        ВывестиСтрокуВКонсоль("  setDataValue(1, 1, 'Тоже данные')")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 0) = '" + данные1 + "' (ожидается 'Есть данные')")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 1) = '" + данные2 + "' (ожидается пустая строка)")
        ВывестиСтрокуВКонсоль("  getDataValue(1, 0) = '" + данные3 + "' (ожидается пустая строка)")
        ВывестиСтрокуВКонсоль("  getDataValue(1, 1) = '" + данные4 + "' (ожидается 'Тоже данные')")
        
        Если данные1 == "Есть данные" И данные2 == "" И данные3 == "" И данные4 == "Тоже данные" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с пустыми строками корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с пустыми строками некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с пустыми строками: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТаблицаМодель завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                    ТЕСТИРОВАНИЕ QtТаблицаМодель (QtAbstractTableModel)           ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtAbstractTableModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТаблицаМодель (русские и английские методы)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtAbstractTableModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТаблицаМодель: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ
