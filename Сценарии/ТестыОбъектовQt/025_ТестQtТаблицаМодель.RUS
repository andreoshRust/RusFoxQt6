// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtТаблицаМодель
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtAbstractTableModel
// ============================================================

Функция ДиагностикаМетодовQtAbstractTableModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtAbstractTableModel ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtAbstractTableModel: " + (typeof QtAbstractTableModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtAbstractTableModel: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtAbstractTableModel()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtAbstractTableModel не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtAbstractTableModel создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtAbstractTableModel: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ТЕСТ QtТаблицаМодель (QtAbstractTableModel)
// ============================================================

Функция ТестQtAbstractTableModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtТаблицаМодель                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtТаблицаМодель()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtТаблицаМодель создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОЙ МОДЕЛИ (rowCount, columnCount)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        строк = модель.rowCount()
        колонок = модель.columnCount()
        
        ВывестиСтрокуВКонсоль("  rowCount() = " + строк + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  columnCount() = " + колонок + " (ожидается 0)")
        
        // Проверка получения данных из пустой модели
        Попытка
            пустыеДанные = модель.getDataValue(0, 0)
            ВывестиСтрокуВКонсоль("  getDataValue(0,0) для пустой модели = '" + пустыеДанные + "' (должна быть пустая строка)")
        Исключение
            ВывестиСтрокуВКонсоль("  ⚠️ getDataValue(0,0) для пустой модели: " + e)
        КонецПопытки
        
        Если строк == 0 И колонок == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Пустая модель корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Пустая модель некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой модели: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ УСТАНОВКИ РАЗМЕРОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ УСТАНОВКИ РАЗМЕРОВ (setRowCount, setColumnCount)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м1 = Новый QtТаблицаМодель()
        м1.РежимОтладки(Режим_Отладки)
        м1.setRowCount(3)
        м1.setColumnCount(4)
        
        строк = м1.rowCount()
        колонок = м1.columnCount()
        
        ВывестиСтрокуВКонсоль("  setRowCount(3), setColumnCount(4)")
        ВывестиСтрокуВКонсоль("  rowCount() = " + строк + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  columnCount() = " + колонок + " (ожидается 4)")
        
        Если строк == 3 И колонок == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Установка размеров работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Установка размеров работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке размеров: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ УСТАНОВКИ ДАННЫХ (английские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ setDataValue() / getDataValue() (английские методы)                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м2 = Новый QtТаблицаМодель()
        м2.РежимОтладки(Режим_Отладки)
        м2.setRowCount(2)
        м2.setColumnCount(3)
        
        м2.setDataValue(0, 0, "Тест")
        м2.setDataValue(0, 1, "Значение")
        м2.setDataValue(0, 2, "Данные")
        м2.setDataValue(1, 0, "Строка 2")
        м2.setDataValue(1, 1, "42")
        м2.setDataValue(1, 2, "3.14")
        
        данные1 = м2.getDataValue(0, 0)
        данные2 = м2.getDataValue(0, 1)
        данные3 = м2.getDataValue(0, 2)
        данные4 = м2.getDataValue(1, 0)
        данные5 = м2.getDataValue(1, 1)
        данные6 = м2.getDataValue(1, 2)
        
        ВывестиСтрокуВКонсоль("  setDataValue(0, 0, 'Тест')")
        ВывестиСтрокуВКонсоль("  setDataValue(0, 1, 'Значение')")
        ВывестиСтрокуВКонсоль("  setDataValue(0, 2, 'Данные')")
        ВывестиСтрокуВКонсоль("  setDataValue(1, 0, 'Строка 2')")
        ВывестиСтрокуВКонсоль("  setDataValue(1, 1, '42')")
        ВывестиСтрокуВКонсоль("  setDataValue(1, 2, '3.14')")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 0) = " + данные1 + " (ожидается Тест)")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 1) = " + данные2 + " (ожидается Значение)")
        ВывестиСтрокуВКонсоль("  getDataValue(0, 2) = " + данные3 + " (ожидается Данные)")
        ВывестиСтрокуВКонсоль("  getDataValue(1, 0) = " + данные4 + " (ожидается Строка 2)")
        ВывестиСтрокуВКонсоль("  getDataValue(1, 1) = " + данные5 + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  getDataValue(1, 2) = " + данные6 + " (ожидается 3.14)")
        
        Если данные1 == "Тест" И данные2 == "Значение" И данные3 == "Данные" И данные4 == "Строка 2" И данные5 == "42" И данные6 == "3.14" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ setDataValue() / getDataValue() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ setDataValue() / getDataValue() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с данными (англ): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ УСТАНОВКИ ДАННЫХ (русские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ УстановитьЗначение() / ПолучитьЗначение() (русские методы)           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м3 = Новый QtТаблицаМодель()
        м3.РежимОтладки(Режим_Отладки)
        м3.УстановитьКоличествоСтрок(2)
        м3.УстановитьКоличествоКолонок(2)
        
        м3.УстановитьЗначение(0, 0, "Русский")
        м3.УстановитьЗначение(0, 1, "Тест")
        м3.УстановитьЗначение(1, 0, "Пример")
        м3.УстановитьЗначение(1, 1, "2024")
        
        данные1 = м3.ПолучитьЗначение(0, 0)
        данные2 = м3.ПолучитьЗначение(0, 1)
        данные3 = м3.ПолучитьЗначение(1, 0)
        данные4 = м3.ПолучитьЗначение(1, 1)
        
        ВывестиСтрокуВКонсоль("  УстановитьЗначение(0, 0, 'Русский')")
        ВывестиСтрокуВКонсоль("  УстановитьЗначение(0, 1, 'Тест')")
        ВывестиСтрокуВКонсоль("  УстановитьЗначение(1, 0, 'Пример')")
