// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtРасположение (исправленная)
// ============================================================

Функция ДиагностикаМетодовQtLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtРасположение ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtLayout: " + (typeof QtLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtРасположение: " + (typeof QtРасположение !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке: " + e)
    КонецПопытки;
    
    Попытка
        диагLayout = Новый QtРасположение()
        
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtРасположение не создан")
            Возврат
        КонецЕсли;
        
        диагLayout.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtРасположение создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealLayout",
            "setParentWidget", "parentWidget",
            "addWidget", "addLayout", "removeWidget",
            "clear", "update", "activate", "invalidate",
            "itemAt", "takeAt", "count", "isEmpty",
            "geometry", "contentsRect",
            "setMargin", "margin",
            "setLeftMargin", "leftMargin",
            "setRightMargin", "rightMargin",
            "setTopMargin", "topMargin",
            "setBottomMargin", "bottomMargin",
            "setSpacing", "spacing",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "layoutType", "layoutTypeString",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов (исправленные имена)
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьРасположение",
            "УстановитьРодительскийВиджет", "РодительскийВиджет",
            "ДобавитьВиджет", "ДобавитьРасположение", "УдалитьВиджет",
            "Очистить", "Обновить", "Активировать", "Инвалидировать",
            "ЭлементПоИндексу", "ВзятьПоИндексу",  // Исправлено
            "Количество", "Пустой",
            "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьЛевыйОтступ", "ЛевыйОтступ",
            "УстановитьПравыйОтступ", "ПравыйОтступ",
            "УстановитьВерхнийОтступ", "ВерхнийОтступ",
            "УстановитьНижнийОтступ", "НижнийОтступ",
            "УстановитьПромежуток", "Промежуток",
            "УстановитьДоступен", "Доступен",  // Исправлено
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "ТипРасположения", "ТипРасположенияСтрока",  // Исправлено
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                    
                    // Проверка наличия всех русских методов в JSON
                    ВывестиСтрокуВКонсоль("  Проверка русских методов в JSON:")
                    найдено = 0
                    Для i = 0 По русМетоды.length - 1 Цикл
                        нашли = ЛОЖЬ
                        Для j = 0 По карта.length - 1 Цикл
                            Если карта[j].русскоеИмя == русМетоды[i] Тогда
                                нашли = ИСТИНА
                                Прервать
                            КонецЕсли;
                        КонецЦикла;
                        Если нашли Тогда
                            найдено = найдено + 1
                            ВывестиСтрокуВКонсоль("    ✓ " + русМетоды[i])
                        Иначе
                            ВывестиСтрокуВКонсоль("    ✗ " + русМетоды[i] + " (НЕ НАЙДЕН в JSON)")
                        КонецЕсли;
                    КонецЦикла;
                    ВывестиСтрокуВКонсоль("  Найдено: " + найдено + " из " + русМетоды.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtРасположение: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtРасположение (исправленная)
// ============================================================

Функция ТестQtLayout()
    всегоТестов = 0
    успешноТестов = 0
    
    // Создаем виджет и расположение
    виджет = Новый QtВиджет()
    виджет.Показать()
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаем расположение без передачи виджета
        расположение = Новый QtРасположение()
        расположение.РежимОтладки(ИСТИНА)
        
        Если расположение != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtРасположение создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = расположение.isValid()
        валидныйРус = расположение.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: parentWidget() / РодительскийВиджет() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Получение родительского виджета")
    СброситьЦветКонсоли()
    
    Попытка
        родитель = расположение.parentWidget()
        родительРус = расположение.РодительскийВиджет()
        ВывестиСтрокуВКонсоль("    parentWidget(): " + (родитель != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    РодительскийВиджет(): " + (родительРус != null ? "valid" : "null"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение родительского виджета работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: Проверка методов добавления =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка методов добавления")
    СброситьЦветКонсоли()
    
    Попытка
        имеетAddWidget = typeof расположение.addWidget === 'function'
        имеетДобавитьВиджет = typeof расположение.ДобавитьВиджет === 'function'
        имеетAddLayout = typeof расположение.addLayout === 'function'
        имеетДобавитьРасположение = typeof расположение.ДобавитьРасположение === 'function'
        
        ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
        
        Если имеетAddWidget И имеетДобавитьВиджет И имеетAddLayout И имеетДобавитьРасположение Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы добавления существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы добавления отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: clear() / Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Очистка расположения")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.Очистить()
        кол = расположение.count()
        ВывестиСтрокуВКонсоль("    После очистки count(): " + кол + " (ожидается 0)")
        
        Если кол == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Очистка расположения работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Очистка расположения не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: setMargin() / margin() / УстановитьОтступ() / Отступ() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Отступы")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.setMargin(15)
        отступ = расположение.margin()
        ВывестиСтрокуВКонсоль("    setMargin(15) -> margin(): " + отступ)
        
        расположение.УстановитьОтступ(20)
        отступРус = расположение.Отступ()
        ВывестиСтрокуВКонсоль("    УстановитьОтступ(20) -> Отступ(): " + отступРус)
        
        Если отступ == 15 И отступРус == 20 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отступы работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отступы не работают")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: setSpacing() / spacing() / УстановитьПромежуток() / Промежуток() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Промежутки")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.setSpacing(8)
        промежуток = расположение.spacing()
        ВывестиСтрокуВКонсоль("    setSpacing(8) -> spacing(): " + промежуток)
        
        расположение.УстановитьПромежуток(10)
        промежутокРус = расположение.Промежуток()
        ВывестиСтрокуВКонсоль("    УстановитьПромежуток(10) -> Промежуток(): " + промежутокРус)
        
        Если промежуток == 8 И промежутокРус == 10 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Промежутки работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Промежутки не работают")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: setEnabled() / isEnabled() / УстановитьДоступен() / Доступен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Доступность расположения")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.setEnabled(false)
        доступен1 = расположение.isEnabled()
        расположение.setEnabled(true)
        доступен2 = расположение.isEnabled()
        ВывестиСтрокуВКонсоль("    setEnabled(false) -> isEnabled(): " + доступен1)
        ВывестиСтрокуВКонсоль("    setEnabled(true) -> isEnabled(): " + доступен2)
        
        расположение.УстановитьДоступен(false)  // Исправлено: УстановитьДоступность → УстановитьДоступен
        доступен1Рус = расположение.Доступен()
        расположение.УстановитьДоступен(true)   // Исправлено: УстановитьДоступность → УстановитьДоступен
        доступен2Рус = расположение.Доступен()
        ВывестиСтрокуВКонсоль("    УстановитьДоступен(false) -> Доступен(): " + доступен1Рус)
        ВывестиСтрокуВКонсоль("    УстановитьДоступен(true) -> Доступен(): " + доступен2Рус)
        
        Если доступен1 == false И доступен2 == true И доступен1Рус == false И доступен2Рус == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Доступность работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Доступность не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: getRealLayout() / layoutType() / ПолучитьРасположение() / ТипРасположения() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Получение реального расположения и типа")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = расположение.getRealLayout()
        тип = расположение.layoutType()
        типСтр = расположение.layoutTypeString()
        ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    layoutType(): " + тип)
        ВывестиСтрокуВКонсоль("    layoutTypeString(): " + типСтр)
        
        реальныйРус = расположение.ПолучитьРасположение()
        типРус = расположение.ТипРасположения()
        типСтрРус = расположение.ТипРасположенияСтрока()  // Исправлено: ТипРасположенияСтрокой → ТипРасположенияСтрока
        ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ТипРасположения(): " + типРус)
        ВывестиСтрокуВКонсоль("    ТипРасположенияСтрока(): " + типСтрРус)
        
        Если реальный != null И реальныйРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального расположения и типа работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального расположения и типа не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof расположение.RusFunc === 'function' Тогда
            jsonStr = расположение.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    виджет.Скрыть()
    
    Возврат "Тест QtРасположение завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtРасположение (QtLayout)                    ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtLayout()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtРасположение (русские и английские методы)                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtLayout()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtРасположение: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

