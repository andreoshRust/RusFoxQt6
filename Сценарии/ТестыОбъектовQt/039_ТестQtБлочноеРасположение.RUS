//Итоги тестирования QtБлочноеРасположение (QtBoxLayout):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Направление блочного расположения    ✅ Пройден
//4    Проверка методов добавления    ✅ Пройден
//5    Проверка методов вставки    ✅ Пройден
//6    Управление растяжением    ✅ Пройден
//7    Проверка методов работы с вложенными layout    ✅ Пройден
//8    Отступы, промежутки и доступность    ✅ Пройден
//9    Получение реальных объектов    ✅ Пройден
//10    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (33 из 33):
//isValid() - проверка валидности
//getRealBoxLayout() / getRealLayout() - получение реальных объектов
//direction() / directionString() - направление
//isVertical() / isHorizontal() - проверка ориентации
//addWidget() / addWidgetEnd() / insertWidget() - добавление/вставка виджетов
//addStretch() / insertStretch() - добавление/вставка растяжения
//addSpacing() / insertSpacing() - добавление/вставка отступа
//addLayout() / insertLayout() - добавление/вставка вложенных layout
//setStretch() / stretch() - управление растяжением
//count() / isEmpty() - количество/проверка на пустоту
//geometry() / contentsRect() - геометрия
//setMargin() / margin() - отступы
//setSpacing() / spacing() - промежутки
//setEnabled() / isEnabled() - доступность
//setObjectName() / objectName() - имя объекта
//copyTo() - копирование
//setDebug() / getDebug() - режим отладки
//Русские (33 из 33):
//Действителен() - isValid
//ПолучитьБлочноеРасположение() / ПолучитьРасположение() - getRealBoxLayout/getRealLayout
//Направление() / НаправлениеСтрока() - direction/directionString
//Вертикальный() / Горизонтальный() - isVertical/isHorizontal
//ДобавитьВиджет() / ДобавитьВиджетВКонец() / ВставитьВиджет() - addWidget/addWidgetEnd/insertWidget
//ДобавитьРастяжение() / ВставитьРастяжение() - addStretch/insertStretch
//ДобавитьОтступ() / ВставитьОтступ() - addSpacing/insertSpacing
//ДобавитьРасположение() / ВставитьРасположение() - addLayout/insertLayout
//УстановитьРастяжение() / Растяжение() - setStretch/stretch
//Количество() / Пустой() - count/isEmpty
//Геометрия() / ПрямоугольникСодержимого() - geometry/contentsRect
//УстановитьОтступ() / Отступ() - setMargin/margin
//УстановитьПромежуток() / Промежуток() - setSpacing/spacing
//УстановитьДоступен() / Доступен() - setEnabled/isEnabled
//УстановитьИмяОбъекта() / ИмяОбъекта() - setObjectName/objectName
//КопироватьВ() - copyTo
//РежимОтладки() / ПолучитьРежимОтладки() - setDebug/getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtБлочноеРасположение
// ============================================================

Функция ДиагностикаМетодовQtBoxLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtБлочноеРасположение ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtBoxLayout: " + (typeof QtBoxLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtБлочноеРасположение: " + (typeof QtБлочноеРасположение !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке: " + e)
    КонецПопытки;
    
    Попытка
        диагLayout = Новый QtБлочноеРасположение()
        
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtБлочноеРасположение не создан")
            Возврат
        КонецЕсли;
        
        диагLayout.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtБлочноеРасположение создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealBoxLayout", "getRealLayout",
            "direction", "directionString", "isVertical", "isHorizontal",
            "addWidget", "addWidgetEnd", "insertWidget",
            "addStretch", "insertStretch",
            "addSpacing", "insertSpacing",
            "addLayout", "insertLayout",
            "setStretch", "stretch",
            "count", "isEmpty", "geometry", "contentsRect",
            "setMargin", "margin",
            "setSpacing", "spacing",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьБлочноеРасположение", "ПолучитьРасположение",
            "Направление", "НаправлениеСтрока", "Вертикальный", "Горизонтальный",
            "ДобавитьВиджет", "ДобавитьВиджетВКонец", "ВставитьВиджет",
            "ДобавитьРастяжение", "ВставитьРастяжение",
            "ДобавитьОтступ", "ВставитьОтступ",
            "ДобавитьРасположение", "ВставитьРасположение",
            "УстановитьРастяжение", "Растяжение",
            "Количество", "Пустой", "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьПромежуток", "Промежуток",
            "УстановитьДоступен", "Доступен",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                    
                    // Проверка наличия всех русских методов в JSON
                    ВывестиСтрокуВКонсоль("  Проверка русских методов в JSON:")
                    найдено = 0
                    Для i = 0 По русМетоды.length - 1 Цикл
                        нашли = ЛОЖЬ
                        Для j = 0 По карта.length - 1 Цикл
                            Если карта[j].русскоеИмя == русМетоды[i] Тогда
                                нашли = ИСТИНА
                                Прервать
                            КонецЕсли;
                        КонецЦикла;
                        Если нашли Тогда
                            найдено = найдено + 1
                            ВывестиСтрокуВКонсоль("    ✓ " + русМетоды[i])
                        Иначе
                            ВывестиСтрокуВКонсоль("    ✗ " + русМетоды[i] + " (НЕ НАЙДЕН в JSON)")
                        КонецЕсли;
                    КонецЦикла;
                    ВывестиСтрокуВКонсоль("  Найдено: " + найдено + " из " + русМетоды.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtБлочноеРасположение: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtБлочноеРасположение (улучшенная)
// ============================================================

Функция ТестQtBoxLayout()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        расположение = Новый QtБлочноеРасположение()
        расположение.РежимОтладки(ИСТИНА)
        Если расположение != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtБлочноеРасположение создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = расположение.isValid()
        валидныйРус = расположение.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: Направление =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Направление блочного расположения")
    СброситьЦветКонсоли()
    
    Попытка
        направление = расположение.direction()
        направлениеРус = расположение.Направление()
        направлениеСтр = расположение.directionString()
        направлениеСтрРус = расположение.НаправлениеСтрока()
        вертикальный = расположение.isVertical()
        вертикальныйРус = расположение.Вертикальный()
        горизонтальный = расположение.isHorizontal()
        горизонтальныйРус = расположение.Горизонтальный()
        
        ВывестиСтрокуВКонсоль("    direction(): " + направление + " / Направление(): " + направлениеРус)
        ВывестиСтрокуВКонсоль("    directionString(): " + направлениеСтр + " / НаправлениеСтрока(): " + направлениеСтрРус)
        ВывестиСтрокуВКонсоль("    isVertical(): " + вертикальный + " / Вертикальный(): " + вертикальныйРус)
        ВывестиСтрокуВКонсоль("    isHorizontal(): " + горизонтальный + " / Горизонтальный(): " + горизонтальныйРус)
        
        Если направление >= 0 И направление <= 3 И направлениеРус >= 0 И направлениеРус <= 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Направление работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Направление не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: Проверка методов добавления =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка методов добавления")
    СброситьЦветКонсоли()
    
    Попытка
        имеетAddWidget = typeof расположение.addWidget === 'function'
        имеетДобавитьВиджет = typeof расположение.ДобавитьВиджет === 'function'
        имеетAddStretch = typeof расположение.addStretch === 'function'
        имеетДобавитьРастяжение = typeof расположение.ДобавитьРастяжение === 'function'
        имеетAddSpacing = typeof расположение.addSpacing === 'function'
        имеетДобавитьОтступ = typeof расположение.ДобавитьОтступ === 'function'
        
        ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
        
        Если имеетAddWidget И имеетДобавитьВиджет И имеетAddStretch И имеетДобавитьРастяжение Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы добавления существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы добавления отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: Проверка методов вставки =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка методов вставки")
    СброситьЦветКонсоли()
    
    Попытка
        имеетInsertWidget = typeof расположение.insertWidget === 'function'
        имеетВставитьВиджет = typeof расположение.ВставитьВиджет === 'function'
        имеетInsertStretch = typeof расположение.insertStretch === 'function'
        имеетВставитьРастяжение = typeof расположение.ВставитьРастяжение === 'function'
        имеетInsertSpacing = typeof расположение.insertSpacing === 'function'
        имеетВставитьОтступ = typeof расположение.ВставитьОтступ === 'function'
        
        ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
        
        Если имеетInsertWidget И имеетВставитьВиджет Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы вставки существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы вставки отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: Управление растяжением =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Управление растяжением")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.setStretch(0, 5)
        растяжение = расположение.stretch(0)
        расположение.УстановитьРастяжение(0, 3)
        растяжениеРус = расположение.Растяжение(0)
        
        ВывестиСтрокуВКонсоль("    setStretch(0, 5) -> stretch(0): " + растяжение)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0, 3) -> Растяжение(0): " + растяжениеРус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Управление растяжением работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: Проверка методов работы с вложенными layout =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка методов работы с вложенными layout")
    СброситьЦветКонсоли()
    
    Попытка
        имеетAddLayout = typeof расположение.addLayout === 'function'
        имеетДобавитьРасположение = typeof расположение.ДобавитьРасположение === 'function'
        имеетInsertLayout = typeof расположение.insertLayout === 'function'
        имеетВставитьРасположение = typeof расположение.ВставитьРасположение === 'function'
        
        ВывестиСтрокуВКонсоль("    addLayout(): " + (имеетAddLayout ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьРасположение(): " + (имеетДобавитьРасположение ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    insertLayout(): " + (имеетInsertLayout ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьРасположение(): " + (имеетВставитьРасположение ? "✅" : "❌"))
        
        Если имеетAddLayout И имеетДобавитьРасположение Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы работы с вложенными layout существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы работы с вложенными layout отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: Отступы, промежутки и доступность =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Отступы, промежутки и доступность")
    СброситьЦветКонсоли()
    
    Попытка
        расположение.setMargin(10)
        отступ = расположение.margin()
        расположение.УстановитьОтступ(15)
        отступРус = расположение.Отступ()
        
        расположение.setSpacing(5)
        промежуток = расположение.spacing()
        расположение.УстановитьПромежуток(8)
        промежутокРус = расположение.Промежуток()
        
        расположение.setEnabled(false)
        доступен = расположение.isEnabled()
        расположение.setEnabled(true)
        доступен2 = расположение.isEnabled()
        
        расположение.УстановитьДоступен(false)
        доступенРус = расположение.Доступен()
        расположение.УстановитьДоступен(true)
        доступен2Рус = расположение.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус)
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус)
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + "->" + доступен2 + " / " + доступенРус + "->" + доступен2Рус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Отступы, промежутки и доступность работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: Получение реальных объектов =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Получение реальных объектов")
    СброситьЦветКонсоли()
    
    Попытка
        реальный = расположение.getRealBoxLayout()
        реальныйРус = расположение.ПолучитьБлочноеРасположение()
        реальныйLayout = расположение.getRealLayout()
        реальныйLayoutРус = расположение.ПолучитьРасположение()
        
        ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальный != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "valid" : "null"))
        
        Если реальный != null И реальныйРус != null И реальныйLayout != null И реальныйLayoutРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реальных объектов работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реальных объектов не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof расположение.RusFunc === 'function' Тогда
            jsonStr = расположение.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtБлочноеРасположение завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtБлочноеРасположение (QtBoxLayout)              ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtBoxLayout()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtБлочноеРасположение (русские и английские методы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtBoxLayout()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtБлочноеРасположение: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ


