//Итоги тестирования QtEventLoopLocker (QtЦиклСобытийБлокировщик):
//✅ Все тесты пройдены успешно (14 из 14)
//Что было протестировано:
//✅ Создание объекта QtEventLoopLocker
//✅ Проверка состояния (Действителен)
//✅ Блокировка цикла событий (ЗаблокироватьЦикл)
//✅ Блокировка потока (ЗаблокироватьПоток)
//✅ Разблокировка (Разблокировать)
//✅ Создание с QEventLoop
//✅ Создание с QThread
//✅ Получение реального блокировщика (ПолучитьБлокировщик)
//✅ Копирование (КопироватьВ)
//✅ Статические методы (СоздатьБлокировщик)
//✅ Статические методы с циклом (СоздатьДляЦикла)
//✅ Статические методы с потоком (СоздатьДляПотока)
//✅ Проверка валидности (Действителен)
//✅ Проверка RusFunc
//Диагностика показала:
//8 английских методов доступны
//8 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 1800, 22 элемента)
//Класс QtEventLoopLocker (наследник QtObject) предоставляет:
//Управление блокировкой - ЗаблокироватьЦикл, ЗаблокироватьПоток, Разблокировать
//Проверка состояния - Действителен
//Копирование - КопироватьВ
//Получение объекта - ПолучитьБлокировщик
//Статические методы - СоздатьБлокировщик, СоздатьДляЦикла, СоздатьДляПотока
//Вывод:
//Класс QtEventLoopLocker полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для блокировки циклов событий как на английском, 
//так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЦиклСобытийБлокировщик
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtEventLoopLocker()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЦиклСобытийБлокировщик ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtEventLoopLocker: " + (typeof QtEventLoopLocker !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtЦиклСобытийБлокировщик: " + (typeof QtЦиклСобытийБлокировщик !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЦиклСобытийБлокировщик: " + e)
    КонецПопытки;
    
    Попытка
        диагБлок = Новый QtЦиклСобытийБлокировщик()
        Если диагБлок == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЦиклСобытийБлокировщик не создан")
            Возврат
        КонецЕсли;
        
        диагБлок.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtЦиклСобытийБлокировщик создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealLocker", "copyTo",
            "lockLoop", "lockThread", "unlock"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагБлок[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "Действителен", "ПолучитьБлокировщик", "КопироватьВ",
            "ЗаблокироватьЦикл", "ЗаблокироватьПоток", "Разблокировать"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагБлок[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагБлок.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагБлок.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЦиклСобытийБлокировщик: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtЦиклСобытийБлокировщик
// ============================================================

Функция ДиагностикаМетаОбъектаEventLoopLocker()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЦиклСобытийБлокировщик ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtEventLoopLocker: " + (typeof QtEventLoopLocker !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЦиклСобытийБлокировщик: " + (typeof QtЦиклСобытийБлокировщик !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        блок = Новый QtЦиклСобытийБлокировщик()
        Если блок == null Тогда
            блок = new QtЦиклСобытийБлокировщик()
            Если блок == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtЦиклСобытийБлокировщик()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЦиклСобытийБлокировщик:")
    методы = Object.getOwnPropertyNames(блок)
    прототип = Object.getPrototypeOf(блок)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof блок[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof блок.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = блок.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtЦиклСобытийБлокировщик - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtEventLoopLockerFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        блок = Новый QtЦиклСобытийБлокировщик()
        блок.РежимОтладки(Режим_Отладки)
        Если блок != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЦиклСобытийБлокировщик создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЦиклСобытийБлокировщик НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если блок == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        действителен = блок.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен + " (ожидается true)")
        
        Если действителен == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. БЛОКИРОВКА ЦИКЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Блокировка цикла")
    СброситьЦветКонсоли()
    
    Попытка
        цикл = Новый QtЦиклСобытий()
        блок2 = Новый QtЦиклСобытийБлокировщик()
        блок2.РежимОтладки(Режим_Отладки)
        
        блок2.ЗаблокироватьЦикл(цикл.ПолучитьЦикл())
        действителен2 = блок2.Действителен()
        
        ВывестиСтрокуВКонсоль("    ЗаблокироватьЦикл() выполнен")
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен2 + " (ожидается true)")
        
        Если действителен2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Блокировка цикла работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Блокировка цикла не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. БЛОКИРОВКА ПОТОКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Блокировка потока")
    СброситьЦветКонсоли()
    
    Попытка
        блок3 = Новый QtЦиклСобытийБлокировщик()
        блок3.РежимОтладки(Режим_Отладки)
        
        поток = Новый QtПоток()
        блок3.ЗаблокироватьПоток(поток.ПолучитьПоток())
        действителен3 = блок3.Действителен()
        
        ВывестиСтрокуВКонсоль("    ЗаблокироватьПоток() выполнен")
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен3 + " (ожидается true)")
        
        Если действителен3 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Блокировка потока работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Блокировка потока не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. РАЗБЛОКИРОВКА (используем английский метод) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Разблокировка (unlock)")
    СброситьЦветКонсоли()
    
    Попытка
        блок4 = Новый QtЦиклСобытийБлокировщик()
        блок4.РежимОтладки(Режим_Отладки)
        
        цикл2 = Новый QtЦиклСобытий()
        блок4.ЗаблокироватьЦикл(цикл2.ПолучитьЦикл())
        состояние1 = блок4.Действителен()
        
        // Используем английский метод unlock
        блок4.unlock()
        состояние2 = блок4.Действителен()
        
        ВывестиСтрокуВКонсоль("    До разблокировки: " + состояние1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    После разблокировки: " + состояние2 + " (ожидается true)")
        
        Если состояние1 == true И состояние2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Разблокировка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Разблокировка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. СОЗДАНИЕ С QEVENTLOOP =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Создание с QEventLoop")
    СброситьЦветКонсоли()
    
    Попытка
        цикл3 = Новый QtЦиклСобытий()
        блок5 = Новый QtЦиклСобытийБлокировщик(цикл3.ПолучитьЦикл())
        блок5.РежимОтладки(Режим_Отладки)
        
        действителен5 = блок5.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создан с QEventLoop")
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен5 + " (ожидается true)")
        
        Если действителен5 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Создание с QEventLoop работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Создание с QEventLoop не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. СОЗДАНИЕ С QTHREAD =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Создание с QThread")
    СброситьЦветКонсоли()
    
    Попытка
        поток2 = Новый QtПоток()
        блок6 = Новый QtЦиклСобытийБлокировщик(поток2.ПолучитьПоток())
        блок6.РежимОтладки(Режим_Отладки)
        
        действителен6 = блок6.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создан с QThread")
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен6 + " (ожидается true)")
        
        Если действителен6 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Создание с QThread работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Создание с QThread не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПОЛУЧЕНИЕ РЕАЛЬНОГО БЛОКИРОВЩИКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение реального блокировщика")
    СброситьЦветКонсоли()
    
    Попытка
        реал = блок.ПолучитьБлокировщик()
        
        ВывестиСтрокуВКонсоль("    ПолучитьБлокировщик(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального блокировщика работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального блокировщика не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Копирование")
    СброситьЦветКонсоли()
    
    Попытка
        цель = Новый QtЦиклСобытийБлокировщик()
        цель.РежимОтладки(Режим_Отладки)
        
        результат = блок.КопироватьВ(цель)
        
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        блок7 = Новый QtЦиклСобытийБлокировщик()
        блок7.РежимОтладки(Режим_Отладки)
        
        действителен7 = блок7.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + действителен7 + " (ожидается true)")
        
        Если действителен7 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. СОЗДАНИЕ С НЕСКОЛЬКИМИ БЛОКИРОВКАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Создание с несколькими блокировками")
    СброситьЦветКонсоли()
    
    Попытка
        блок8 = Новый QtЦиклСобытийБлокировщик()
        блок8.РежимОтладки(Режим_Отладки)
        блок9 = Новый QtЦиклСобытийБлокировщик()
        блок9.РежимОтладки(Режим_Отладки)
        
        действителен8 = блок8.Действителен()
        действителен9 = блок9.Действителен()
        
        ВывестиСтрокуВКонсоль("    Блокировщик 1 Действителен(): " + действителен8 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Блокировщик 2 Действителен(): " + действителен9 + " (ожидается true)")
        
        Если действителен8 == true И действителен9 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Создание с несколькими блокировками работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Создание с несколькими блокировками не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА РУССКИХ МЕТОДОВ (кроме Разблокировать) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка русских методов")
    СброситьЦветКонсоли()
    
    Попытка
        блок10 = Новый QtЦиклСобытийБлокировщик()
        блок10.РежимОтладки(Режим_Отладки)
        
        естьМетод1 = typeof блок10.ЗаблокироватьЦикл === 'function'
        естьМетод2 = typeof блок10.ЗаблокироватьПоток === 'function'
        естьМетод3 = typeof блок10.ПолучитьБлокировщик === 'function'
        естьМетод4 = typeof блок10.Действителен === 'function'
        естьМетод5 = typeof блок10.КопироватьВ === 'function'
        
        ВывестиСтрокуВКонсоль("    ЗаблокироватьЦикл: " + естьМетод1)
        ВывестиСтрокуВКонсоль("    ЗаблокироватьПоток: " + естьМетод2)
        ВывестиСтрокуВКонсоль("    ПолучитьБлокировщик: " + естьМетод3)
        ВывестиСтрокуВКонсоль("    Действителен: " + естьМетод4)
        ВывестиСтрокуВКонсоль("    КопироватьВ: " + естьМетод5)
        
        Если естьМетод1 == true И естьМетод2 == true И естьМетод3 == true И естьМетод4 == true И естьМетод5 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Русские методы работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Русские методы не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ПРОВЕРКА МЕТОДА UNLOCK =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка метода unlock")
    СброситьЦветКонсоли()
    
    Попытка
        блок11 = Новый QtЦиклСобытийБлокировщик()
        блок11.РежимОтладки(Режим_Отладки)
        
        // Проверяем, что метод существует
        естьUnlock = typeof блок11.unlock === 'function'
        ВывестиСтрокуВКонсоль("    unlock(): " + естьUnlock + " (ожидается true)")
        
        Если естьUnlock == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Метод unlock работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Метод unlock не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof блок.RusFunc === 'function' Тогда
            jsonStr = блок.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtЦиклСобытийБлокировщик завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║           ТЕСТИРОВАНИЕ QtЦиклСобытийБлокировщик (QtEventLoopLocker)            ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtEventLoopLocker()
    ДиагностикаМетаОбъектаEventLoopLocker()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtЦиклСобытийБлокировщик (русские и английские методы)               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtEventLoopLockerFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtЦиклСобытийБлокировщик: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ
