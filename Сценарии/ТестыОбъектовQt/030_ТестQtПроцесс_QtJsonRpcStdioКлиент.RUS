
// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ QtJsonRpcStdioКлиент
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовStdioClient()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtJsonRpcStdioClient ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtJsonRpcStdioClient: " + (typeof QtJsonRpcStdioClient !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtJsonRpcStdioClient: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtJsonRpcStdioClient()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtJsonRpcStdioClient не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtJsonRpcStdioClient создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtJsonRpcStdioClient: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtПроцесс
// ============================================================

Функция ТестQtПроцесс()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ =====
    всегоТестов = всегоТестов + 1
    Попытка
        процесс = Новый QtПроцесс()
        процесс.РежимОтладки(Режим_Отладки)
        Если процесс != null Тогда
            ВывестиСтрокуВКонсоль("  ✓ QtПроцесс создан")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ QtПроцесс НЕ создан")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка создания: " + e)
    КонецПопытки
    
    Если процесс == null Тогда
        Возврат "❌ Тест QtПроцесс провален (объект не создан)"
    КонецЕсли
    
    // ===== 2. НАЧАЛЬНОЕ СОСТОЯНИЕ =====
    всегоТестов = всегоТестов + 1
    Попытка
        состояние = процесс.ПолучитьСостояние()  // state()
        запущен = процесс.Запущен()  // isStarted()
        ВывестиСтрокуВКонсоль("  Состояние: " + состояние + " (ожидается 0 - NotRunning)")
        ВывестиСтрокуВКонсоль("  Запущен: " + запущен + " (ожидается false)")
        Если состояние == 0 И запущен == false Тогда
            ВывестиСтрокуВКонсоль("  ✓ Начальное состояние корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Начальное состояние некорректно")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 3. ЗАПУСК И ОЖИДАНИЕ =====
    всегоТестов = всегоТестов + 1
    Попытка
        процесс.ЗапуститьПроцесс("cmd", ["/c", "echo", "Hello World"])
        Если процесс.ЖдатьЗавершения(5000) Тогда
            вывод = процесс.ПрочитатьТекстВывода()  // readAllStandardOutputText()
            код = процесс.ПолучитьКодВыхода()  // exitCode()
            ВывестиСтрокуВКонсоль("  Вывод: " + вывод)
            ВывестиСтрокуВКонсоль("  Код выхода: " + код + " (ожидается 0)")
            Если код == 0 Тогда
                ВывестиСтрокуВКонсоль("  ✓ Команда выполнена успешно")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("  ✗ Команда завершилась с ошибкой")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Таймаут!")
            процесс.ЗавершитьПроцесс()  // terminate()
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 4. ПРОВЕРКА ПОСЛЕ ЗАВЕРШЕНИЯ =====
    всегоТестов = всегоТестов + 1
    Попытка
        завершен = процесс.Завершен()  // isFinished()
        статус = процесс.ПолучитьСтатусВыхода()  // exitStatus()
        ВывестиСтрокуВКонсоль("  Завершен: " + завершен + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Статус выхода: " + статус + " (ожидается 0 - NormalExit)")
        Если завершен == true И статус == 0 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Статус после завершения корректен")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Статус после завершения некорректен")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 5. ЗАПУСК С ПАРАМЕТРАМИ =====
    всегоТестов = всегоТестов + 1
    Попытка
        процесс2 = Новый QtПроцесс()
        процесс2.РежимОтладки(Режим_Отладки)
        процесс2.ЗапуститьПроцесс("ping", ["-n", "2", "127.0.0.1"])
        процесс2.ЖдатьЗавершения(5000)
        вывод = процесс2.ПрочитатьТекстВывода()
        Если вывод != "" Тогда
            ВывестиСтрокуВКонсоль("  Ping вывод получен (длина: " + вывод.length + ")")
            ВывестиСтрокуВКонсоль("  ✓ Запуск с параметрами работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Ping вывод пуст")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 6. РАБОЧАЯ ДИРЕКТОРИЯ =====
    всегоТестов = всегоТестов + 1
    Попытка
        процесс3 = Новый QtПроцесс()
        процесс3.РежимОтладки(Режим_Отладки)
        процесс3.УстановитьРабочийКаталог("C:/")
        процесс3.ЗапуститьПроцесс("cmd", ["/c", "echo", "%CD%"])
        процесс3.ЖдатьЗавершения(5000)
        вывод = процесс3.ПрочитатьТекстВывода()
        ВывестиСтрокуВКонсоль("  Рабочий каталог: " + процесс3.ПолучитьРабочийКаталог())
        Если вывод != "" Тогда
            ВывестиСтрокуВКонсоль("  ✓ Рабочая директория работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Рабочая директория не работает")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 7. ЗАПИСЬ В ПРОЦЕСС =====
    всегоТестов = всегоТестов + 1
    Попытка
        процесс4 = Новый QtПроцесс()
        процесс4.РежимОтладки(Режим_Отладки)
        процесс4.ЗапуститьПроцесс("cmd")
        Если процесс4.ЖдатьЗапуска(3000) Тогда
            процесс4.ЗаписатьСтроку("echo Hello from process")
            процесс4.ЗаписатьСтроку("exit")
            процесс4.ЗакрытьКаналЗаписи()
            процесс4.ЖдатьЗавершения(5000)
            вывод = процесс4.ПрочитатьТекстВывода()
            ВывестиСтрокуВКонсоль("  Вывод: " + вывод)
            Если вывод.indexOf("Hello from process") >= 0 Тогда
                ВывестиСтрокуВКонсоль("  ✓ Запись в процесс работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("  ✗ Запись в процесс не работает")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("  ⚠ Процесс не запустился, пропускаем")
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    Возврат "✅ Тест QtПроцесс: " + успешноТестов + " из " + всегоТестов + " пройдено"
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtJsonRpcStdioКлиент
// ============================================================

Функция ТестQtJsonRpcStdioКлиент()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ =====
    всегоТестов = всегоТестов + 1
    Попытка
        клиент = Новый QtJsonRpcStdioКлиент()
        Если клиент != null Тогда
            ВывестиСтрокуВКонсоль("  ✓ QtJsonRpcStdioКлиент создан")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ QtJsonRpcStdioКлиент НЕ создан")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка создания: " + e)
    КонецПопытки
    
    Если клиент == null Тогда
        Возврат "❌ Тест QtJsonRpcStdioКлиент провален (объект не создан)"
    КонецЕсли
    
    // ===== 2. НАСТРОЙКА КОЛБЭКОВ =====
    всегоТестов = всегоТестов + 1
    Попытка
        клиент.ПриЗапуске(Функция() {
            ВывестиСтрокуВКонсоль("    ✅ Событие: Gateway запущен")
        })
        клиент.ПриОстановке(Функция() {
            ВывестиСтрокуВКонсоль("    ⏹ Событие: Gateway остановлен")
        })
        клиент.ПриОшибке(Функция(ошибка) {
            ВывестиСтрокуВКонсоль("    ❌ Событие: Ошибка - " + ошибка)
        })
        клиент.ПриУведомлении(Функция(метод, параметры) {
            ВывестиСтрокуВКонсоль("    📨 Событие: " + метод)
        })
        ВывестиСтрокуВКонсоль("  ✓ Колбэки установлены")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка установки колбэков: " + e)
    КонецПопытки
    
    // ===== 3. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    Попытка
        запущен = клиент.Запущен()
        ВывестиСтрокуВКонсоль("  Запущен (до запуска): " + запущен + " (ожидается false)")
        Если запущен == false Тогда
            ВывестиСтрокуВКонсоль("  ✓ Состояние до запуска корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Состояние до запуска некорректно")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 4. ВЫЗОВ МЕТОДА БЕЗ ЗАПУСКА =====
    всегоТестов = всегоТестов + 1
    Попытка
        колбэкВызван = ЛОЖЬ
        id = клиент.ВызватьМетод("test.method", null, Функция(успех, ошибка, результат) {
            колбэкВызван = ИСТИНА
            Если успех Тогда
                ВывестиСтрокуВКонсоль("    ✅ Вызов успешен")
            Иначе
                ВывестиСтрокуВКонсоль("    ⚠️ Ошибка (ожидаемо): " + ошибка)
            КонецЕсли
        })
        ВывестиСтрокуВКонсоль("  ID вызова: " + id + " (ожидается -1)")
        Если id == -1 И колбэкВызван == true Тогда
            ВывестиСтрокуВКонсоль("  ✓ Вызов метода без запуска корректен")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ Вызов метода без запуска некорректен")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка: " + e)
    КонецПопытки
    
    // ===== 5. ОТПРАВКА УВЕДОМЛЕНИЯ =====
    всегоТестов = всегоТестов + 1
    Попытка
        клиент.ОтправитьУведомление("test.notification", null)
        ВывестиСтрокуВКонсоль("  ✓ ОтправитьУведомление() выполнен")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка отправки уведомления: " + e)
    КонецПопытки
    
    // ===== 6. ОСТАНОВКА =====
    всегоТестов = всегоТестов + 1
    Попытка
        клиент.ОстановитьШлюз()
        ВывестиСтрокуВКонсоль("  ✓ Остановка выполнена")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ Ошибка остановки: " + e)
    КонецПопытки
    
    Возврат "✅ Тест QtJsonRpcStdioКлиент: " + успешноТестов + " из " + всегоТестов + " пройдено"
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtПроцесс И QtJsonRpcStdioКлиент               ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовStdioClient()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. ТЕСТ QtПроцесс                                                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtПроцесс()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПроцесс: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ QtJsonRpcStdioКлиент                                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtJsonRpcStdioКлиент()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtJsonRpcStdioКлиент: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ
