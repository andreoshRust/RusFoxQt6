//Итоги тестирования QtГоризонтальнаяКомпоновка (QtHBoxLayout):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка валидности    ✅ Пройден
//3    Направление    ✅ Пройден
//4    Добавление виджетов    ✅ Пройден
//5    Растяжение и отступы    ✅ Пройден
//6    Отступы и доступность    ✅ Пройден
//7    Получение реальных объектов    ✅ Пройден
//8    Вставка элементов    ✅ Пройден
//9    Управление растяжением    ✅ Пройден
//10    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (34 из 34):
//isValid() - проверка валидности
//getRealHBoxLayout() / getRealBoxLayout() / getRealLayout() - получение реальных объектов
//direction() / directionString() - направление
//isVertical() / isHorizontal() - проверка ориентации
//addWidget() / addWidgetEnd() / insertWidget() - добавление/вставка виджетов
//addStretch() / insertStretch() - добавление/вставка растяжения
//addSpacing() / insertSpacing() - добавление/вставка отступа
//addLayout() / insertLayout() - добавление/вставка вложенных layout
//setStretch() / stretch() - управление растяжением
//count() / isEmpty() - количество/проверка на пустоту
//geometry() / contentsRect() - геометрия
//setMargin() / margin() - отступы
//setSpacing() / spacing() - промежутки
//setEnabled() / isEnabled() - доступность
//setObjectName() / objectName() - имя объекта
//copyTo() - копирование
//setDebug() / getDebug() - режим отладки
//Русские (34 из 34):
//Действителен() - isValid
//ПолучитьГоризонтальнуюКомпоновку() / ПолучитьБлочноеРасположение() / ПолучитьРасположение() - getRealHBoxLayout/getRealBoxLayout/getRealLayout
//Направление() / НаправлениеСтрока() - direction/directionString
//Вертикальный() / Горизонтальный() - isVertical/isHorizontal
//ДобавитьВиджет() / ДобавитьВиджетВКонец() / ВставитьВиджет() - addWidget/addWidgetEnd/insertWidget
//ДобавитьРастяжение() / ВставитьРастяжение() - addStretch/insertStretch
//ДобавитьОтступ() / ВставитьОтступ() - addSpacing/insertSpacing
//ДобавитьРасположение() / ВставитьРасположение() - addLayout/insertLayout
//УстановитьРастяжение() / Растяжение() - setStretch/stretch
//Количество() / Пустой() - count/isEmpty
//Геометрия() / ПрямоугольникСодержимого() - geometry/contentsRect
//УстановитьОтступ() / Отступ() - setMargin/margin
//УстановитьПромежуток() / Промежуток() - setSpacing/spacing
//УстановитьДоступен() / Доступен() - setEnabled/isEnabled
//УстановитьИмяОбъекта() / ИмяОбъекта() - setObjectName/objectName
//КопироватьВ() - copyTo
//РежимОтладки() / ПолучитьРежимОтладки() - setDebug/getDebug
//Полная иерархия классов:
//QtObject
//    ├── QtTimer
//    │   ├── QtBasicTimer (QBasicTimer) - QtБазовыйТаймер
//    │   ├── QtElapsedTimer (QElapsedTimer) - QtЗамерВремени
//    │   └── QtDeadlineTimer (QDeadlineTimer) - QtДедлайнТаймер
//    ├── QtStyle (QStyle) - QtСтиль
//    │   ├── QtProxyStyle (QProxyStyle) - QtПроксиСтиль
//    │   └── QtCommonStyle (QCommonStyle) - QtОбщийСтиль
//    └── QtLayout (QLayout) - QtРасположение
//            ├── QtBoxLayout (QBoxLayout) - QtБлочноеРасположение
//            │       ├── QtHBoxLayout (QHBoxLayout) - QtГоризонтальнаяКомпоновка
//            │       └── QtVBoxLayout (QVBoxLayout) - QtВертикальнаяКомпоновка (если будет)
//            ├── QtGridLayout (QGridLayout) - QtТабличнаяКомпоновка
//            └── QtFormLayout (QFormLayout) - QtКомпоновкаФорм
            

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtГоризонтальнаяКомпоновка
// ============================================================

Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtHBoxLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtHBoxLayout ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtHBoxLayout: " + (typeof QtHBoxLayout !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtHBoxLayout: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtHBoxLayout()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtHBoxLayout не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtHBoxLayout создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtHBoxLayout: " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtГоризонтальнаяКомпоновка
// ============================================================

Функция ДиагностикаМетаОбъектаHBoxLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtГоризонтальнаяКомпоновка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtHBoxLayout: " + (typeof QtHBoxLayout !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtГоризонтальнаяКомпоновка: " + (typeof QtГоризонтальнаяКомпоновка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        компоновка1 = Новый QtГоризонтальнаяКомпоновка()
        Если компоновка1 == null Тогда
          ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
          Возврат 
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtГоризонтальнаяКомпоновка:")
    методы = Object.getOwnPropertyNames(компоновка1)
    прототип = Object.getPrototypeOf(компоновка1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли;
    КонецЦикла;
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof компоновка1[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' ИЛИ имя === 'addWidget' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof компоновка1.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = компоновка1.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtГоризонтальнаяКомпоновка (QtHBoxLayout)
// ============================================================

Функция ТестQtHBoxLayoutFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    компоновка = null
    Попытка
        компоновка = Новый QtГоризонтальнаяКомпоновка()
        Если компоновка != null Тогда
            компоновка.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtГоризонтальнаяКомпоновка создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtГоризонтальнаяКомпоновка НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если компоновка == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = компоновка.isValid()
        валидныйРус = компоновка.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. НАПРАВЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Направление")
    СброситьЦветКонсоли()
    
    Попытка
        направление = компоновка.direction()
        направлениеРус = компоновка.Направление()
        направлениеСтр = компоновка.directionString()
        направлениеСтрРус = компоновка.НаправлениеСтрока()
        вертикальный = компоновка.isVertical()
        вертикальныйРус = компоновка.Вертикальный()
        горизонтальный = компоновка.isHorizontal()
        горизонтальныйРус = компоновка.Горизонтальный()
        
        ВывестиСтрокуВКонсоль("    direction(): " + направление + " / Направление(): " + направлениеРус)
        ВывестиСтрокуВКонсоль("    directionString(): " + направлениеСтр + " / НаправлениеСтрока(): " + направлениеСтрРус)
        ВывестиСтрокуВКонсоль("    isVertical(): " + вертикальный + " / Вертикальный(): " + вертикальныйРус)
        ВывестиСтрокуВКонсоль("    isHorizontal(): " + горизонтальный + " / Горизонтальный(): " + горизонтальныйРус)
        
        Если направление == 0 И направлениеРус == 0 И горизонтальный == ИСТИНА И горизонтальныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Направление работает (горизонтальное)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Направление не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ДОБАВЛЕНИЕ ВИДЖЕТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Добавление виджетов")
    СброситьЦветКонсоли()
    
    Попытка
        компоновка.Очистить()
        // Проверяем существование методов
        имеетAddWidget = typeof компоновка.addWidget === 'function'
        имеетДобавитьВиджет = typeof компоновка.ДобавитьВиджет === 'function'
        
        ВывестиСтрокуВКонсоль("    addWidget(): " + (имеетAddWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьВиджет(): " + (имеетДобавитьВиджет ? "✅" : "❌"))
        
        Если имеетAddWidget И имеетДобавитьВиджет Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы добавления виджетов существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Методы добавления виджетов отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. РАСТЯЖЕНИЕ И ОТСТУПЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Растяжение и отступы")
    СброситьЦветКонсоли()
    
    Попытка
        имеетAddStretch = typeof компоновка.addStretch === 'function'
        имеетДобавитьРастяжение = typeof компоновка.ДобавитьРастяжение === 'function'
        имеетAddSpacing = typeof компоновка.addSpacing === 'function'
        имеетДобавитьОтступ = typeof компоновка.ДобавитьОтступ === 'function'
        
        ВывестиСтрокуВКонсоль("    addStretch(): " + (имеетAddStretch ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьРастяжение(): " + (имеетДобавитьРастяжение ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    addSpacing(): " + (имеетAddSpacing ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ДобавитьОтступ(): " + (имеетДобавитьОтступ ? "✅" : "❌"))
        
        Если имеетAddStretch И имеетДобавитьРастяжение И имеетAddSpacing И имеетДобавитьОтступ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы растяжения и отступов существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы растяжения/отступов отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ОТСТУПЫ И ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Отступы и доступность")
    СброситьЦветКонсоли()
    
    Попытка
        компоновка.setMargin(10)
        отступ = компоновка.margin()
        компоновка.УстановитьОтступ(15)
        отступРус = компоновка.Отступ()
        
        компоновка.setSpacing(5)
        промежуток = компоновка.spacing()
        компоновка.УстановитьПромежуток(8)
        промежутокРус = компоновка.Промежуток()
        
        компоновка.setEnabled(false)
        доступен = компоновка.isEnabled()
        компоновка.setEnabled(true)
        доступен2 = компоновка.isEnabled()
        
        компоновка.УстановитьДоступен(false)
        доступенРус = компоновка.Доступен()
        компоновка.УстановитьДоступен(true)
        доступен2Рус = компоновка.Доступен()
        
        ВывестиСтрокуВКонсоль("    Отступ: " + отступ + " / " + отступРус)
        ВывестиСтрокуВКонсоль("    Промежуток: " + промежуток + " / " + промежутокРус)
        ВывестиСтрокуВКонсоль("    Доступен: " + доступен + "->" + доступен2 + " / " + доступенРус + "->" + доступен2Рус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Отступы, промежутки и доступность работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 7. ПОЛУЧЕНИЕ РЕАЛЬНЫХ ОБЪЕКТОВ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 7: Получение реальных объектов")
СброситьЦветКонсоли()

Попытка
    реальный = компоновка.getRealHBoxLayout()
    // ИСПРАВЛЕНО: ПолучитьГоризонтальнуюКомпоновку -> ПолучитьГоризонтальноеРасположение
    реальныйРус = компоновка.ПолучитьГоризонтальноеРасположение()
    реальныйBox = компоновка.getRealBoxLayout()
    реальныйBoxРус = компоновка.ПолучитьБлочноеРасположение()
    реальныйLayout = компоновка.getRealLayout()
    реальныйLayoutРус = компоновка.ПолучитьРасположение()
    
    ВывестиСтрокуВКонсоль("    getRealHBoxLayout(): " + (реальный != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    ПолучитьГоризонтальноеРасположение(): " + (реальныйРус != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    getRealBoxLayout(): " + (реальныйBox != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    ПолучитьБлочноеРасположение(): " + (реальныйBoxРус != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    getRealLayout(): " + (реальныйLayout != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    ПолучитьРасположение(): " + (реальныйLayoutРус != null ? "valid" : "null"))
    
    Если реальный != null И реальныйРус != null И реальныйBox != null И реальныйBoxРус != null Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение реальных объектов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Получение реальных объектов не работает")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

    // ===== 8. ВСТАВКА ЭЛЕМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Вставка элементов")
    СброситьЦветКонсоли()
    
    Попытка
        имеетInsertWidget = typeof компоновка.insertWidget === 'function'
        имеетВставитьВиджет = typeof компоновка.ВставитьВиджет === 'function'
        имеетInsertStretch = typeof компоновка.insertStretch === 'function'
        имеетВставитьРастяжение = typeof компоновка.ВставитьРастяжение === 'function'
        имеетInsertSpacing = typeof компоновка.insertSpacing === 'function'
        имеетВставитьОтступ = typeof компоновка.ВставитьОтступ === 'function'
        
        ВывестиСтрокуВКонсоль("    insertWidget(): " + (имеетInsertWidget ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьВиджет(): " + (имеетВставитьВиджет ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    insertStretch(): " + (имеетInsertStretch ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьРастяжение(): " + (имеетВставитьРастяжение ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    insertSpacing(): " + (имеетInsertSpacing ? "✅" : "❌"))
        ВывестиСтрокуВКонсоль("    ВставитьОтступ(): " + (имеетВставитьОтступ ? "✅" : "❌"))
        
        Если имеетInsertWidget И имеетВставитьВиджет Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Методы вставки существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Некоторые методы вставки отсутствуют")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. УПРАВЛЕНИЕ РАСТЯЖЕНИЕМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Управление растяжением")
    СброситьЦветКонсоли()
    
    Попытка
        компоновка.setStretch(0, 5)
        растяжение = компоновка.stretch(0)
        компоновка.УстановитьРастяжение(0, 3)
        растяжениеРус = компоновка.Растяжение(0)
        
        ВывестиСтрокуВКонсоль("    setStretch(0, 5) -> stretch(0): " + растяжение)
        ВывестиСтрокуВКонсоль("    УстановитьРастяжение(0, 3) -> Растяжение(0): " + растяжениеРус)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Управление растяжением работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof компоновка.RusFunc === 'function' Тогда
            jsonStr = компоновка.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtГоризонтальнаяКомпоновка завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 3.0 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ QtГоризонтальнаяКомпоновка (QtHBoxLayout)          ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtHBoxLayout()
    ДиагностикаМетаОбъектаHBoxLayout()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtГоризонтальнаяКомпоновка (русские и английские методы)                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtHBoxLayoutFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtГоризонтальнаяКомпоновка: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ


