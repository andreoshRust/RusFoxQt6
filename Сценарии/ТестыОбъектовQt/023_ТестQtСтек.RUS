// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtСтек
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtStack()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtСтек ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtStack: " + (typeof QtStack !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtStack: " + e)
    КонецПопытки;
    
    Попытка
        диагСтек = Новый QtСтек()
        Если диагСтек == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtСтек не создан")
            Возврат
        КонецЕсли;
        
        диагСтек.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtСтек создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "push", "pop", "top", "clear",
            "size", "count", "isEmpty", "toArray",
            "empty", "len", "cnt"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСтек[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ВСтек", "ИзСтека", "Вершина", "Очистить",
            "ВМассив", "Размер", "Количество", "Пустой"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСтек[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСтек.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСтек.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtСтек: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtСтек (QtStack)
// ============================================================

Функция ТестQtStackFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtСтек                                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    стек = null
    Попытка
        стек = Новый QtСтек()
        стек.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtСтек создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если стек == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОГО СТЕКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОГО СТЕКА (свойства и методы)                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // ✅ Используем СВОЙСТВА с заглавной буквы
        пуст1 = стек.IsEmpty
        пуст2 = стек.Пустой()
        пуст3 = стек.empty()
        размер1 = стек.Size
        размер2 = стек.Размер()
        размер3 = стек.len()
        кол1 = стек.Count
        кол2 = стек.Количество()
        кол3 = стек.cnt()
        
        ВывестиСтрокуВКонсоль("  IsEmpty (свойство) = " + пуст1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Пустой() = " + пуст2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  empty() = " + пуст3 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  len() = " + размер3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Count (свойство) = " + кол1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Количество() = " + кол2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  cnt() = " + кол3 + " (ожидается 0)")
        
        Если пуст1 == ИСТИНА И пуст2 == ИСТИНА И пуст3 == ИСТИНА И размер1 == 0 И размер2 == 0 И размер3 == 0 И кол1 == 0 И кол2 == 0 И кол3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка пустого стека работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка пустого стека работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустого стека: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ ВСтек() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ВСтек()                                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с1 = Новый QtСтек()
        с1.РежимОтладки(Режим_Отладки)
        с1.ВСтек("Первый")
        с1.ВСтек("Второй")
        с1.ВСтек("Третий")
        
        размер = с1.Size
        вершина = с1.top()
        
        ВывестиСтрокуВКонсоль("  ВСтек('Первый'), ВСтек('Второй'), ВСтек('Третий')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  top() = " + вершина.toString() + " (ожидается Третий)")
        
        Если размер == 3 И вершина.toString() == "Третий" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВСтек() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВСтек() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ Вершина() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ Вершина()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с2 = Новый QtСтек()
        с2.РежимОтладки(Режим_Отладки)
        с2.ВСтек("A")
        с2.ВСтек("B")
        с2.ВСтек("C")
        
        вершина1 = с2.top()
        вершина2 = с2.Вершина()
        
        ВывестиСтрокуВКонсоль("  top() = " + вершина1.toString() + " (ожидается C)")
        ВывестиСтрокуВКонсоль("  Вершина() = " + вершина2.toString() + " (ожидается C)")
        
        Если вершина1.toString() == "C" И вершина2.toString() == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Вершина() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Вершина() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении вершины стека: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ ИзСтека() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ ИзСтека() (LIFO - последний пришёл, первый ушёл)                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с3 = Новый QtСтек()
        с3.РежимОтладки(Режим_Отладки)
        с3.ВСтек("Первый")
        с3.ВСтек("Второй")
        с3.ВСтек("Третий")
        
        извлеч1 = с3.pop()
        извлеч2 = с3.ИзСтека()
        извлеч3 = с3.pop()
        
        размер = с3.Size
        
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч1.toString() + " (ожидается Третий)")
        ВывестиСтрокуВКонсоль("  ИзСтека() = " + извлеч2.toString() + " (ожидается Второй)")
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч3.toString() + " (ожидается Первый)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 0)")
        
        Если извлеч1.toString() == "Третий" И извлеч2.toString() == "Второй" И извлеч3.toString() == "Первый" И размер == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ИзСтека() работает корректно (LIFO)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ИзСтека() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при извлечении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ Очистить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с4 = Новый QtСтек()
        с4.РежимОтладки(Режим_Отладки)
        с4.ВСтек("A")
        с4.ВСтек("B")
        с4.ВСтек("C")
        
        с4.clear()
        размер1 = с4.Size
        пусто1 = с4.IsEmpty
        
        с4.ВСтек("D")
        с4.ВСтек("E")
        с4.Очистить()
        размер2 = с4.Size
        пусто2 = с4.IsEmpty
        
        ВывестиСтрокуВКонсоль("  clear() -> Size = " + размер1 + " (ожидается 0), IsEmpty = " + пусто1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Очистить() -> Size = " + размер2 + " (ожидается 0), IsEmpty = " + пусто2 + " (ожидается true)")
        
        Если размер1 == 0 И пусто1 == ИСТИНА И размер2 == 0 И пусто2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке стека: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ ВМассив() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ ВМассив()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с5 = Новый QtСтек()
        с5.РежимОтладки(Режим_Отладки)
        с5.ВСтек("X")
        с5.ВСтек("Y")
        с5.ВСтек("Z")
        
        массив1 = с5.toArray()
        массив2 = с5.ВМассив()
        
        стрМассив1 = []
        Для i = 0 По массив1.length - 1 Цикл
            стрМассив1.push(массив1[i].toString())
        КонецЦикла;
        
        стрМассив2 = []
        Для i = 0 По массив2.length - 1 Цикл
            стрМассив2.push(массив2[i].toString())
        КонецЦикла;
        
        ВывестиСтрокуВКонсоль("  toArray() = " + стрМассив1.join(", ") + " (ожидается X, Y, Z)")
        ВывестиСтрокуВКонсоль("  ВМассив() = " + стрМассив2.join(", ") + " (ожидается X, Y, Z)")
        
        Если стрМассив1.length == 3 И стрМассив2.length == 3 И стрМассив1[0] == "X" И стрМассив1[1] == "Y" И стрМассив1[2] == "Z" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВМассив() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВМассив() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при преобразовании в массив: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ (числа, строки, булевы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с6 = Новый QtСтек()
        с6.РежимОтладки(Режим_Отладки)
        с6.ВСтек(42)
        с6.ВСтек("Строка")
        с6.ВСтек(ИСТИНА)
        с6.ВСтек(3.14)
        
        размер = с6.Size
        вершина = с6.top()
        
        извлеч1 = с6.pop()
        извлеч2 = с6.pop()
        извлеч3 = с6.pop()
        извлеч4 = с6.pop()
        
        ВывестиСтрокуВКонсоль("  ВСтек(42), ВСтек('Строка'), ВСтек(true), ВСтек(3.14)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  top() = " + вершина.toString() + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч1.toString() + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч2.toString() + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч3.toString() + " (ожидается Строка)")
        ВывестиСтрокуВКонсоль("  pop() = " + извлеч4.toString() + " (ожидается 42)")
        
        Если размер == 4 И вершина.toString() == "3.14" И извлеч1.toString() == "3.14" И извлеч2.toString() == "true" И извлеч3.toString() == "Строка" И извлеч4.toString() == "42" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ ПОРЯДОК LIFO =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ ПОРЯДОК LIFO (последний пришёл - первый ушёл)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        с7 = Новый QtСтек()
        с7.РежимОтладки(Режим_Отладки)
        с7.ВСтек("1")
        с7.ВСтек("2")
        с7.ВСтек("3")
        с7.ВСтек("4")
        с7.ВСтек("5")
        
        извлеч1 = с7.pop()
        извлеч2 = с7.pop()
        извлеч3 = с7.pop()
        извлеч4 = с7.pop()
        извлеч5 = с7.pop()
        
        ВывестиСтрокуВКонсоль("  push: 1, 2, 3, 4, 5")
        ВывестиСтрокуВКонсоль("  pop: " + извлеч1.toString() + ", " + извлеч2.toString() + ", " + извлеч3.toString() + ", " + извлеч4.toString() + ", " + извлеч5.toString())
        
        Если извлеч1.toString() == "5" И извлеч2.toString() == "4" И извлеч3.toString() == "3" И извлеч4.toString() == "2" И извлеч5.toString() == "1" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Порядок LIFO соблюдается корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Порядок LIFO нарушен")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке порядка LIFO: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtСтек завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ QtСтек (QtStack)                           ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtStack()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtСтек (русские и английские методы)                                     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtStackFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtСтек: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

