Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДата
// ============================================================

Функция ДиагностикаМетодовQtJsonArray()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtJsonArray ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtJsonArray: " + (typeof QtJsonArray !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtJsonArray: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtJsonArray()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtJsonArray не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtJsonArray создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtJsonArray: " + e)
    КонецПопытки;
    
КонецФункции


ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    // ========== ВЫЗОВ ДИАГНОСТИКИ ==========
    ДиагностикаМетодовQtJsonArray()
    
    // ========== ТЕСТ QtJsonArray ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtJsonМассив (QtJsonArray)                     ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")

    всегоТестов = 0
    успешноТестов = 0

    // ========== 1. СОЗДАНИЕ ОБЪЕКТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtJsonМассив (по умолчанию)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        массив = Новый QtJsonМассив()
        ВывестиСтрокуВКонсоль("  ✓ Объект QtJsonМассив создан успешно")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 2. ТЕСТ ПУСТОГО МАССИВА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОГО МАССИВА (Размер)                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а1 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        кол = а1.Размер()
        ВывестиСтрокуВКонсоль("  Размер() = " + кол + " (ожидается 0)")
        Если кол == 0 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Массив пустой (Размер = 0)")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Массив не пустой (Размер = " + кол + ")")
            тестПройден = ЛОЖЬ
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Размер(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И кол == 0 Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 3. ТЕСТ ДОБАВЛЕНИЯ ЭЛЕМЕНТОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ДОБАВЛЕНИЯ ЭЛЕМЕНТОВ (ДобавитьСтроку, ДобавитьЧисло, ДобавитьЛогику) │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а2 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        а2.ДобавитьСтроку("Первый")
        а2.ДобавитьСтроку("Второй")
        а2.ДобавитьЧисло(42)
        а2.ДобавитьЧисло(3.14)
        а2.ДобавитьЛогику(true)
        а2.ДобавитьNull()
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('Первый'), ДобавитьСтроку('Второй')")
        ВывестиСтрокуВКонсоль("  ДобавитьЧисло(42), ДобавитьЧисло(3.14)")
        ВывестиСтрокуВКонсоль("  ДобавитьЛогику(true), ДобавитьNull()")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        кол = а2.Размер()
        ВывестиСтрокуВКонсоль("  Размер() = " + кол + " (ожидается 6)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Размер(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И кол == 6 Тогда
        ВывестиСтрокуВКонсоль("  ✓ Добавление элементов работает корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Добавление элементов работает некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 4. ТЕСТ ПОЛУЧЕНИЯ ЭЛЕМЕНТОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ ПОЛУЧЕНИЯ ЭЛЕМЕНТОВ (ПолучитьСтроку, ПолучитьЧисло, ПолучитьЛогику) │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а3 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        а3.ДобавитьСтроку("Тест")
        а3.ДобавитьЧисло(123)
        а3.ДобавитьЛогику(true)
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('Тест'), ДобавитьЧисло(123), ДобавитьЛогику(true)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        стр = а3.ПолучитьСтроку(0)
        чис = а3.ПолучитьЧисло(1)
        лог = а3.ПолучитьЛогику(2)
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(0) = " + стр + " (ожидается Тест)")
        ВывестиСтрокуВКонсоль("  ПолучитьЧисло(1) = " + чис + " (ожидается 123)")
        ВывестиСтрокуВКонсоль("  ПолучитьЛогику(2) = " + лог + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И стр == "Тест" И чис == 123 И лог == true Тогда
        ВывестиСтрокуВКонсоль("  ✓ Получение элементов работает корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Получение элементов работает некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 5. ТЕСТ УСТАНОВКИ ЭЛЕМЕНТОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ УСТАНОВКИ ЭЛЕМЕНТОВ (УстановитьСтроку, УстановитьЧисло)               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а4 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        а4.ДобавитьСтроку("Старое")
        а4.ДобавитьЧисло(0)
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('Старое'), ДобавитьЧисло(0)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        а4.УстановитьСтроку(0, "Новое")
        а4.УстановитьЧисло(1, 999)
        ВывестиСтрокуВКонсоль("  УстановитьСтроку(0, 'Новое'), УстановитьЧисло(1, 999)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        стр = а4.ПолучитьСтроку(0)
        чис = а4.ПолучитьЧисло(1)
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(0) = " + стр + " (ожидается Новое)")
        ВывестиСтрокуВКонсоль("  ПолучитьЧисло(1) = " + чис + " (ожидается 999)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И стр == "Новое" И чис == 999 Тогда
        ВывестиСтрокуВКонсоль("  ✓ Установка элементов работает корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Установка элементов работает некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 6. ТЕСТ УДАЛЕНИЯ ЭЛЕМЕНТОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ УДАЛЕНИЯ ЭЛЕМЕНТОВ (removeAt)                                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а5 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        а5.ДобавитьСтроку("a")
        а5.ДобавитьСтроку("b")
        а5.ДобавитьСтроку("c")
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('a'), ДобавитьСтроку('b'), ДобавитьСтроку('c')")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        колДо = а5.Размер()
        ВывестиСтрокуВКонсоль("  До удаления: Размер = " + колДо + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Размер(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        // Используем removeAt (английский метод)
        а5.removeAt(1)
        ВывестиСтрокуВКонсоль("  removeAt(1)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при removeAt(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        колПосле = а5.Размер()
        стр1 = а5.ПолучитьСтроку(0)
        стр2 = а5.ПолучитьСтроку(1)
        ВывестиСтрокуВКонсоль("  После удаления: Размер = " + колПосле + " (ожидается 2)")
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(0) = " + стр1 + " (ожидается a)")
        ВывестиСтрокуВКонсоль("  ПолучитьСтроку(1) = " + стр2 + " (ожидается c)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И колПосле == 2 И стр1 == "a" И стр2 == "c" Тогда
        ВывестиСтрокуВКонсоль("  ✓ Удаление элементов работает корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Удаление элементов работает некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 7. ТЕСТ ОЧИСТКИ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ ОЧИСТКИ (Очистить)                                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    а6 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    
    Попытка
        а6.ДобавитьСтроку("a")
        а6.ДобавитьСтроку("b")
        а6.ДобавитьСтроку("c")
        ВывестиСтрокуВКонсоль("  ДобавитьСтроку('a'), ДобавитьСтроку('b'), ДобавитьСтроку('c')")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        колДо = а6.Размер()
        ВывестиСтрокуВКонсоль("  До очистки: Размер = " + колДо + " (ожидается 3)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Размер(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
