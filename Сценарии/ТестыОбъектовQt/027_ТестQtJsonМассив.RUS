    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Очистить(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        колПосле = а6.Размер()
        ВывестиСтрокуВКонсоль("  После очистки: Размер = " + колПосле + " (ожидается 0)")
        Если колПосле == 0 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Массив очищен")
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Массив не очищен")
            тестПройден = ЛОЖЬ
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И колПосле == 0 Тогда
        ВывестиСтрокуВКонсоль("  ✓ Очистка работает корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Очистка работает некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 8. ТЕСТ ПРЕОБРАЗОВАНИЯ В СТРОКУ ==========
