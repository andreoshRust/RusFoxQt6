        ВывестиСтрокуВКонсоль("  getIdealThreadCount() = " + идеал + " (ожидается >= 1)")
        
        поток.yieldCurrentThread()
        ВывестиСтрокуВКонсоль("  yieldCurrentThread() выполнен")
        
        Если идеал >= 1 Тогда
            ВывестиСтрокуВКонсоль("  ✓ Статические методы работают корректно")
