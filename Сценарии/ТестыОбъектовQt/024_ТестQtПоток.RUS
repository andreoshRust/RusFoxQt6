    // ========== 7. ТЕСТ ЗАДЕРЖЕК (sleep, msleep, usleep) ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ ЗАДЕРЖЕК (sleepThread, msleepThread, usleepThread)                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        задержкаВыполнена = false
        
        Функция ТестЗадержки()
            поток6.msleepThread(100)
            задержкаВыполнена = true
        КонецФункции;
        
        поток6 = Новый QtПоток()
        поток6.startWithFunction(ТестЗадержки)
        
        Пауза(50)
        запущен6 = поток6.isRunningThread()
        ВывестиСтрокуВКонсоль("  msleepThread(100) выполняется в потоке, isRunningThread() = " + запущен6 + " (ожидается true)")
        
        поток6.waitThread()
        
        ВывестиСтрокуВКонсоль("  задержкаВыполнена = " + задержкаВыполнена + " (ожидается true)")
        
        Если запущен6 == true И задержкаВыполнена == true Тогда
            ВывестиСтрокуВКонсоль("  ✓ Задержки в потоке работают корректно")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("  ❌ Задержки в потоке работают некорректно")
        КонецЕсли;
    Исключение
