    ВывестиСтрокуВКонсоль("  Тест 11: Оставшееся время")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("setInterval", 1000)
        об.ВызватьМетод("start")
        Пауза(100)
        оставшееся = об.ВызватьМетод("remainingTime")
        ВывестиСтрокуВКонсоль("    remainingTime(): " + оставшееся)
        об.ВызватьМетод("stop")
        
        Если оставшееся != null И оставшееся > 0 Тогда
