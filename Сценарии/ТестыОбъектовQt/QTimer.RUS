//Итоговый результат тестирования QTimer (Таймер):
//№    Тест    Статус
//1    Создание CPPObject    ✅
//2    Создание QTimer через CPPObject    ✅
//3    Проверка имени класса    ✅
//4    Проверка валидности    ✅
//5    Получение реального объекта    ✅
//6    Получение списка методов    ✅
//7    Работа с таймером (setInterval/start/stop/isActive)    ✅
//8    Одиночный таймер (setSingleShot/isSingleShot)    ✅
//9    Тип таймера (setTimerType/timerType)    ✅
//10    Запуск с интервалом (start(msec))    ✅
//11    Оставшееся время (remainingTime)    ✅
//12    Включение отладки    ✅
//13    Повторное создание объекта    ✅
//14    Создание нового объекта    ✅
//✅ Тест QTimer: 14 из 14 пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)
//
//Результаты тестирования методов QTimer:
//Метод    Результат
//setInterval(1000) → interval()    ✅ 1000
//start() → isActive()    ✅ true
//stop() → isActive()    ✅ false
//setSingleShot(true) → isSingleShot()    ✅ true
//setSingleShot(false) → isSingleShot()    ✅ false
//setTimerType(0) → timerType()    ✅ 0 (PreciseTimer)
//setTimerType(1) → timerType()    ✅ 1 (CoarseTimer)
//start(2000) → interval()    ✅ 2000
//remainingTime()    ✅ ~863 мс
//Что было сделано:
//Добавлена специальная обработка для QTimer в CPPObject::callTimerMethod()
//
//Все методы QTimer теперь работают напрямую без использования мета-системы
//
//Добавлен хардкодный список методов для getMethodNames() при работе с QTimer
//
//Создан полный тест с 14 тестами, покрывающими все основные методы QTimer
//
//Особенности QTimer:
//Интервал - установка и получение интервала в миллисекундах
//
//Запуск/остановка - управление таймером
//
//Одиночный режим - таймер срабатывает один раз
//
//Тип таймера - точный, грубый или очень точный
//
//Оставшееся время - получение времени до срабатывания
//
//Сигналы - timeout() при срабатывании

// ============================================================
// ТЕСТ QTimer (Таймер) через CPPObject - ИСПРАВЛЕННЫЙ
// ============================================================

Функция ТестQTimer()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ QTimer (Таймер) через CPPObject ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА CPPObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QTimer =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QTimer через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QTimer")
        ВывестиСтрокуВКонсоль("    Создать('QTimer'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QTimer создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QTimer НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QTimer" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное (ожидается QTimer)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
