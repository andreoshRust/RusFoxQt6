    Попытка
        об.ВызватьМетод("setTimerType", 0)
        тип = об.ВызватьМетод("timerType")
        ВывестиСтрокуВКонсоль("    setTimerType(PreciseTimer) -> timerType(): " + тип)
        
        об.ВызватьМетод("setTimerType", 1)
        тип2 = об.ВызватьМетод("timerType")
        ВывестиСтрокуВКонсоль("    setTimerType(CoarseTimer) -> timerType(): " + тип2)
        
        Если тип == 0 И тип2 == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Тип таймера работает")
