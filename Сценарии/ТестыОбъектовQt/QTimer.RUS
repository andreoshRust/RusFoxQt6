    КонецПопытки

    // ===== 6. ПОЛУЧЕНИЕ СПИСКА МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение списка методов")
    СброситьЦветКонсоли()
    
    Попытка
        методы = об.СписокМетодов()
        ВывестиСтрокуВКонсоль("    СписокМетодов(): " + методы.length + " методов")
        
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("    ⚠️ Список методов может быть пуст (особенность Qt)")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 7. РАБОТА С ТАЙМЕРОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Работа с таймером")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("setInterval", 1000)
        интервал = об.ВызватьМетод("interval")
        ВывестиСтрокуВКонсоль("    setInterval(1000) -> interval(): " + интервал)
        
        об.ВызватьМетод("start")
        активен = об.ВызватьМетод("isActive")
        ВывестиСтрокуВКонсоль("    start() -> isActive(): " + активен)
        
        об.ВызватьМетод("stop")
        активен2 = об.ВызватьМетод("isActive")
        ВывестиСтрокуВКонсоль("    stop() -> isActive(): " + активен2)
        
        Если интервал == 1000 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Работа с таймером работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Работа с таймером не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ОДИНОЧНЫЙ ТАЙМЕР =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Одиночный таймер")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("setSingleShot", true)
        одиночный = об.ВызватьМетод("isSingleShot")
        ВывестиСтрокуВКонсоль("    setSingleShot(true) -> isSingleShot(): " + одиночный)
        
        об.ВызватьМетод("setSingleShot", false)
        одиночный2 = об.ВызватьМетод("isSingleShot")
        ВывестиСтрокуВКонсоль("    setSingleShot(false) -> isSingleShot(): " + одиночный2)
        
        Если одиночный == true И одиночный2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Одиночный таймер работает")
