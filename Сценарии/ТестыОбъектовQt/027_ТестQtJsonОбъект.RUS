    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при Merge(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        о13.MergeWith(о14)
        стр3 = о13.GetString("a")
        стр4 = о13.GetString("c")
        ВывестиСтрокуВКонсоль("  MergeWith() -> a = " + стр3 + ", c = " + стр4)
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при MergeWith(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И стр1 == "1" И стр2 == "3" И стр3 == "1" И стр4 == "3" Тогда
        ВывестиСтрокуВКонсоль("  ✓ Merge() и MergeWith() работают корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Merge() и MergeWith() работают некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 14. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 14. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ (комплексный тест)                          │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    о15 = Новый QtJsonОбъект()
    влож = Новый QtJsonОбъект()
    массив15 = Новый QtJsonМассив()
    тестПройден = ИСТИНА
    стр = ""
    чис = 0
    лог = false
    внутрСтр = ""
    эл1 = ""
    эл2 = 0
    
    Попытка
        о15.InsertString("string", "Тест")
        о15.InsertNumber("number", 123.45)
        о15.InsertBool("boolean", true)
        о15.InsertNull("null")
        ВывестиСтрокуВКонсоль("  Вставлены: string, number, boolean, null")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        влож.InsertString("inner", "значение")
        о15.InsertObject("object", влож.ToJson())
        ВывестиСтрокуВКонсоль("  Вложенный объект: inner=значение")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке объекта: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        массив15.appendString("элемент1")
        массив15.appendNumber(2)
        о15.InsertArray("array", массив15.toJsonArray())
        ВывестиСтрокуВКонсоль("  Вложенный массив: элемент1, 2")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке массива: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден Тогда
        Попытка
            стр = о15.GetString("string")
            чис = о15.GetNumber("number")
            лог = о15.GetBool("boolean")
            ВывестиСтрокуВКонсоль("  GetString/GetNumber/GetBool выполнены")
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении данных: " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден Тогда
        Попытка
            jsonStr = о15.ToString()
            ВывестиСтрокуВКонсоль("  ToString() = " + jsonStr)
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при ToString(): " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден Тогда
        Попытка
            jsonObj = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  JSON.parse() выполнен успешно")
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при JSON.parse(): " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден Тогда
        Попытка
            внутрСтр = jsonObj.object.inner
            ВывестиСтрокуВКонсоль("  object.inner = " + внутрСтр + " (ожидается значение)")
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении object.inner: " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден Тогда
        Попытка
            arrayVal = jsonObj.array
            эл1 = arrayVal[0]
            эл2 = arrayVal[1]
            ВывестиСтрокуВКонсоль("  array[0] = " + эл1 + " (ожидается элемент1)")
            ВывестиСтрокуВКонсоль("  array[1] = " + эл2 + " (ожидается 2)")
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении массива: " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден Тогда
        Попытка
            ВывестиСтрокуВКонсоль("  Полный объект: " + о15.ToStringIndented())
            ВывестиСтрокуВКонсоль("")
            ВывестиСтрокуВКонсоль("  string = " + стр + " (ожидается Тест)")
            ВывестиСтрокуВКонсоль("  number = " + чис + " (ожидается 123.45)")
            ВывестиСтрокуВКонсоль("  boolean = " + лог + " (ожидается true)")
        Исключение
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при выводе результата: " + e)
            тестПройден = ЛОЖЬ
        КонецПопытки;
    КонецЕсли;
    
    Если тестПройден И стр == "Тест" И чис == 123.45 И лог == true И внутрСтр == "значение" И эл1 == "элемент1" И эл2 == 2 Тогда
        ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами данных корректна")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами данных некорректна")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== ИТОГОВЫЙ ОТЧЁТ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╠════════════════════════════════════════════════════════════════════════════════╣")
    ВывестиСтрокуВКонсоль("║  Всего тестов: " + всегоТестов + "                                                  ║")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              ║")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("║  Успешно:       " + успешноТестов + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  Ошибок:        " + (всегоТестов - успешноТестов) + "                                                  ║")
        ВывестиСтрокуВКонсоль("║  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        ║")
    КонецЕсли
    
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

