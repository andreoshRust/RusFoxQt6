Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtJsonObject
// ============================================================

Функция ДиагностикаМетодовQtJsonObject()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtJsonObject ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtJsonObject: " + (typeof QtJsonObject !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtJsonObject: " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtJsonObject()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtJsonObject не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtJsonObject создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtJsonObject: " + e)
    КонецПопытки;
    
КонецФункции


ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    // ========== ВЫЗОВ ДИАГНОСТИКИ ==========
    ДиагностикаМетодовQtJsonObject()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtJsonОбъект (QtJsonObject)                     ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")

    // ========== ИНИЦИАЛИЗАЦИЯ СЧЁТЧИКОВ ==========
    всегоТестов = 0
    успешноТестов = 0

    // ========== 1. СОЗДАНИЕ ОБЪЕКТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtJsonОбъект (по умолчанию)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    Попытка
        объект = Новый QtJsonОбъект()
        ВывестиСтрокуВКонсоль("  ✓ Объект QtJsonОбъект создан успешно")
        успешноТестов = успешноТестов + 1
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ========== 2. ТЕСТ ПУСТОГО ОБЪЕКТА ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОГО ОБЪЕКТА (GetCount, IsEmpty, GetKeys)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    о1 = Новый QtJsonОбъект()
    тестПройден = ИСТИНА
    
    Попытка
        кол = о1.GetCount()
        ВывестиСтрокуВКонсоль("  GetCount() = " + кол + " (ожидается 0)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при GetCount(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        пусто = о1.IsEmpty()
        ВывестиСтрокуВКонсоль("  IsEmpty() = " + пусто + " (ожидается true)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при IsEmpty(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        ключи = о1.GetKeys()
        ВывестиСтрокуВКонсоль("  GetKeys() = " + ключи.join(", ") + " (ожидается пустой)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при GetKeys(): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И кол == 0 И пусто == true И ключи.length == 0 Тогда
        ВывестиСтрокуВКонсоль("  ✓ Пустой объект корректен")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Пустой объект некорректен")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 3. ТЕСТ ВСТАВКИ И ПОЛУЧЕНИЯ ПРОСТЫХ ТИПОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ВСТАВКИ И ПОЛУЧЕНИЯ ПРОСТЫХ ТИПОВ                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    о2 = Новый QtJsonОбъект()
    тестПройден = ИСТИНА
    
    Попытка
        о2.InsertString("name", "Иван")
        о2.InsertString("city", "Москва")
        о2.InsertNumber("age", 30)
        о2.InsertNumber("pi", 3.14)
        о2.InsertBool("active", true)
        о2.InsertBool("verified", false)
        о2.InsertNull("empty")
        ВывестиСтрокуВКонсоль("  InsertString/InsertNumber/InsertBool/InsertNull выполнены")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        имя = о2.GetString("name")
        город = о2.GetString("city")
        возраст = о2.GetNumber("age")
        пи = о2.GetNumber("pi")
        активен = о2.GetBool("active")
        проверен = о2.GetBool("verified")
        ВывестиСтрокуВКонсоль("  GetString('name') = " + имя + " (ожидается Иван)")
        ВывестиСтрокуВКонсоль("  GetString('city') = " + город + " (ожидается Москва)")
        ВывестиСтрокуВКонсоль("  GetNumber('age') = " + возраст + " (ожидается 30)")
        ВывестиСтрокуВКонсоль("  GetNumber('pi') = " + пи + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  GetBool('active') = " + активен + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  GetBool('verified') = " + проверен + " (ожидается false)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И имя == "Иван" И город == "Москва" И возраст == 30 И пи == 3.14 И активен == true И проверен == false Тогда
        ВывестиСтрокуВКонсоль("  ✓ Вставка и получение простых типов работают корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Вставка и получение простых типов работают некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 4. ТЕСТ ВЛОЖЕННЫХ ОБЪЕКТОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ ВЛОЖЕННЫХ ОБЪЕКТОВ (InsertObject, GetObject)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    всегоТестов = всегоТестов + 1
    о3 = Новый QtJsonОбъект()
    вложенный = Новый QtJsonОбъект()
    тестПройден = ИСТИНА
    
    Попытка
        вложенный.InsertString("street", "Тверская")
        вложенный.InsertString("building", "15")
        вложенный.InsertNumber("floor", 5)
        ВывестиСтрокуВКонсоль("  вложенный.InsertString/InsertNumber")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при заполнении вложенного: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        о3.InsertObject("address", вложенный.ToJson())
        о3.InsertObject("work", вложенный.ToJson())
        ВывестиСтрокуВКонсоль("  о3.InsertObject('address'), InsertObject('work')")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при InsertObject: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        адрес = о3.GetObject("address")
        улица = адрес.GetString("street")
        этаж = адрес.GetNumber("floor")
        ВывестиСтрокуВКонсоль("  GetObject('address').GetString('street') = " + улица + " (ожидается Тверская)")
        ВывестиСтрокуВКонсоль("  GetObject('address').GetNumber('floor') = " + этаж + " (ожидается 5)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при GetObject('address'): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Попытка
        работа = о3.GetObject("work")
        здание = работа.GetString("building")
        ВывестиСтрокуВКонсоль("  GetObject('work').GetString('building') = " + здание + " (ожидается 15)")
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при GetObject('work'): " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И улица == "Тверская" И этаж == 5 И здание == "15" Тогда
        ВывестиСтрокуВКонсоль("  ✓ Вложенные объекты работают корректно")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("  ❌ Вложенные объекты работают некорректно")
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ========== 5. ТЕСТ ВЛОЖЕННЫХ МАССИВОВ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ ВЛОЖЕННЫХ МАССИВОВ (InsertArray, ToString)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
