    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 20, получено " + размерКопии)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            формат.УстановитьРазмерШрифта(24)
            копияРус = формат.Копировать()
            Если копияРус != null Тогда
                размерКопииРус = копияРус.fontPointSize()
                ВывестиСтрокуВКонсоль("    [RUS] Копировать: размер=" + размерКопииРус + " (ожидается 24)")
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: копия не создана")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И размерКопииРус == 24 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 24, получено " + размерКопииРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. СВОЙСТВА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Свойства")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        формат.setProperty(1, "test value")
        есть = формат.hasProperty(1)
        значение = формат.property(1)
        формат.clearProperty(1)
        есть2 = формат.hasProperty(1)
        ВывестиСтрокуВКонсоль("    [ENG] hasProperty=" + есть + ", value='" + значение + "', после clear: " + есть2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Свойства работают")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            формат.УстановитьСвойство(2, "test rus")
            естьРус = формат.ЕстьСвойство(2)
            значениеРус = формат.Свойство(2)
            формат.ОчиститьСвойство(2)
            естьРус2 = формат.ЕстьСвойство(2)
            ВывестиСтрокуВКонсоль("    [RUS] ЕстьСвойство=" + естьРус + ", Свойство='" + значениеРус + "', после ОчиститьСвойство: " + естьРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Свойства работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

// ===== 11. ОБЪЕДИНЕНИЕ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 11: Объединение")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА

// --- АНГЛИЙСКИЙ МЕТОД ---
Попытка
    формат3 = Новый QtТекстСимволФормат()
    формат3.РежимОтладки(Режим_Отладки)
    формат4 = Новый QtТекстСимволФормат()
    формат4.РежимОтладки(Режим_Отладки)
    формат3.setFontSize(16)
    формат4.setFontBold(true)
    формат3.merge(формат4.getFormat())
    размер3 = формат3.fontPointSize()
    жирный3 = формат3.fontBold()
    ВывестиСтрокуВКонсоль("    [ENG] merge: размер=" + размер3 + ", жирный=" + жирный3)
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецПопытки

Если тестПройден Тогда
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("    ✓ [ENG] Объединение работает")
    СброситьЦветКонсоли()
Иначе
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецЕсли

// --- РУССКИЙ МЕТОД (используем английский getFormat для получения формата) ---
Если тестПройден Тогда
    Попытка
        форматРус1 = Новый QtТекстСимволФормат()
        форматРус1.РежимОтладки(Режим_Отладки)
        форматРус2 = Новый QtТекстСимволФормат()
        форматРус2.РежимОтладки(Режим_Отладки)
        форматРус1.УстановитьРазмерШрифта(18)
        форматРус2.УстановитьКурсивныйШрифт(ИСТИНА)
        // Используем английский метод getFormat() для получения формата
        форматРус1.Объединить(форматРус2.getFormat())
        размерРус = форматРус1.РазмерШрифта()
        курсивРус = форматРус1.КурсивныйШрифт()
        ВывестиСтрокуВКонсоль("    [RUS] Объединить: размер=" + размерРус + ", курсив=" + курсивРус)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
    КонецПопытки
    
    Если тестРусский Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Объединение работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
        СброситьЦветКонсоли()
    КонецЕсли
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли

    // ===== 12. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Получить/Установить формат")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        полученныйФормат = формат.getFormat()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getFormat: формат получен")
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: формат не получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Получить/Установить формат работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            полученныйФорматРус = формат.ПолучитьФормат()
            Если полученныйФорматРус != null Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьФормат: формат получен")
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: формат не получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Получить/Установить формат работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстСимволФормат: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстСимволФормат: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстСимволФормат завершён"
КонецФункции

