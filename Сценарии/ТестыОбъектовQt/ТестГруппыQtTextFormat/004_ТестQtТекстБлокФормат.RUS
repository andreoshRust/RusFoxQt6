        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка в высоте строки: height=" + высотаСтроки + ", type=" + типВысоты)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            // Используем правильный русский метод УстановитьВысотуСтроки
            формат.УстановитьВысотуСтроки(30, 2)
            высотаСтрокиРус = формат.ВысотаСтроки()
            типВысотыРус = формат.ТипВысотыСтроки()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВысотуСтроки/ВысотаСтроки: высота=" + высотаСтрокиРус + ", тип=" + типВысотыРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И высотаСтрокиРус == 30 И типВысотыРус == 2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Высота строки работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка в высоте строки: height=" + высотаСтрокиРус + ", type=" + типВысотыРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. НЕРАЗРЫВНЫЕ СТРОКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Неразрывные строки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат.setNonBreakableLines(ИСТИНА)
        неразрывные = формат.nonBreakableLines()
        ВывестиСтрокуВКонсоль("    [ENG] setNonBreakableLines/nonBreakableLines: " + неразрывные)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И неразрывные == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Неразрывные строки работают")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка в неразрывных строках")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат.УстановитьНеразрывныеСтроки(ЛОЖЬ)
            неразрывныеРус = формат.НеразрывныеСтроки()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьНеразрывныеСтроки/НеразрывныеСтроки: " + неразрывныеРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И неразрывныеРус == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Неразрывные строки работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка в неразрывных строках")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 11. ПОЛИТИКА РАЗРЫВА СТРАНИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Политика разрыва страницы")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат.setPageBreakPolicy(1)
        политика = формат.pageBreakPolicy()
        ВывестиСтрокуВКонсоль("    [ENG] setPageBreakPolicy/pageBreakPolicy: " + политика)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И политика == 1 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Политика разрыва страницы работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка в политике разрыва страницы")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат.УстановитьПолитикуРазрываСтраницы(2)
            политикаРус = формат.ПолитикаРазрываСтраницы()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПолитикуРазрываСтраницы/ПолитикаРазрываСтраницы: " + политикаРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И политикаРус == 2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Политика разрыва страницы работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка в политике разрыва страницы")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 12. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        копияЦель = Новый QtТекстБлокФормат()
        копияЦель.РежимОтладки(Режим_Отладки)
        Если копияЦель != null Тогда
            успех = формат.copyTo(копияЦель)
            Если успех Тогда
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: содержимое скопировано")
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] копия isValid: " + валидность)
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            копияЦельРус = Новый QtТекстБлокФормат()
            копияЦельРус.РежимОтладки(Режим_Отладки)
            Если копияЦельРус != null Тогда
                успехРус = формат.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: содержимое скопировано")
                    валидностьРус = копияЦельРус.Действителен()
                    ВывестиСтрокуВКонсоль("    [RUS] копия Действителен: " + валидностьРус)
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
                    СброситьЦветКонсоли()
                    успешноТестов = успешноТестов + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 13. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Получить/Установить формат")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        полученныйФормат = формат.getBlockFormatObject()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getBlockFormatObject: формат получен")
            формат.setBlockFormat(полученныйФормат)
            ВывестиСтрокуВКонсоль("    [ENG] setBlockFormat: формат установлен")
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] getBlockFormatObject: формат НЕ получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            полученныйФорматРус = формат.ПолучитьБлочныйФормат()
            Если полученныйФорматРус != null Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьБлочныйФормат: формат получен")
                формат.УстановитьБлочныйФормат(полученныйФорматРус)
                ВывестиСтрокуВКонсоль("    [RUS] УстановитьБлочныйФормат: формат установлен")
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Получить/Установить формат работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПолучитьБлочныйФормат: формат НЕ получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстБлокФормат завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 3.0  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 3.0. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtТекстБлокФормат (QtTextBlockFormat)              ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTextBlockFormat()
    ДиагностикаМетаОбъектаTextBlockFormat()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстБлокФормат (русские и английские методы)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextBlockFormatFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстБлокФормат: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

