// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстИзображениеФормат
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtTextImageFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстИзображениеФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстИзображениеФормат: " + (typeof QtТекстИзображениеФормат !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстИзображениеФормат: " + e)
    КонецПопытки;
    
    Попытка
        диагФормат = Новый QtТекстИзображениеФормат()
        диагФормат.РежимОтладки(Режим_Отладки)
        диагФормат.РежимОтладки(Режим_Отладки)
        Если диагФормат == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстИзображениеФормат не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtТекстИзображениеФормат создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "name", "setName", "width", "setWidth", 
            "height", "setHeight", "clear", "isEmpty",
            "getFormat", "setFormat", "toString"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "Имя", "УстановитьИмя", "Ширина", "УстановитьШирину",
            "Высота", "УстановитьВысоту", "Очистить", "Пустой",
            "ПолучитьФормат", "УстановитьФормат", "ВСтроку"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагФормат.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагФормат.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстИзображениеФормат: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстИзображениеФормат
// ============================================================

Функция ЭтоМетодБезПараметров(имя)
    список = [
        "isValid", "type", "objectIndex",
        "isEmpty", "isEmptyFormat", "isEmptyImage",
        "name", "width", "height",
        "clear", "getFormat", "toString",
        "copy", "getDebug", "getImageFormat",
        "getImageFormatObject", "getCharFormat",
        "getInvalidFormat", "getBlockFormat",
        "getListFormat", "getTableFormat",
        "getFrameFormat", "getUserFormat",
        "getSelectionFormat", "font",
        "fontFamily", "fontPointSize",
        "fontBold", "fontItalic",
        "fontUnderline", "fontStrikeOut",
        "fontOverline", "fontCapitalization",
        "foreground", "foregroundColor",
        "textColor", "backgroundColor",
        "underlineStyle", "underlineColor",
        "verticalAlignment", "letterSpacing",
        "wordSpacing", "isCharFormat",
        "propertyCount", "RusFunc"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСБулевымПараметром(имя)
    список = [
        "setDebug", "РежимОтладки",
        "setFontBold", "setFontItalic",
        "setFontUnderline", "setFontStrikeOut",
        "setFontOverline"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодССтроковымПараметром(имя)
    список = [
        "setName", "setFontFamily",
        "setTextColor", "setBackgroundColor",
        "setForegroundColor", "setUnderlineColor"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСЧисловымПараметром(имя)
    список = [
        "setWidth", "setHeight",
        "setFontPointSize", "setFontSize",
        "setLetterSpacing", "setWordSpacing",
        "setFontWeight", "setUnderlineStyle",
        "setVerticalAlignment", "setFontCapitalization"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСОбъектнымПараметром(имя)
    список = [
        "setFont", "setForeground", "setBackground"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСЦелымПараметром(имя)
    список = [
        "setProperty", "hasProperty",
        "clearProperty", "property"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСФорматом(имя)
    список = [
        "setFormat", "setImageFormat",
        "setCharFormat", "merge"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодCopyTo(имя)
    Возврат имя === "copyTo"
КонецФункции

Функция ДиагностикаМетаОбъектаTextImageFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстИзображениеФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextImageFormat: " + (typeof QtTextImageFormat !== "undefined"))
        ВывестиСтрокуВКонсоль("Проверка QtТекстИзображениеФормат: " + (typeof QtТекстИзображениеФормат !== "undefined"))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        формат = Новый QtТекстИзображениеФормат()
        формат.РежимОтладки(Режим_Отладки)
        Если формат == null Тогда
            формат = Новый QtTextImageFormat()
            формат.РежимОтладки(Режим_Отладки)
            Если формат == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через Новый QtTextImageFormat()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстИзображениеФормат:")
    
    методы = Object.getOwnPropertyNames(формат)
    прототип = Object.getPrototypeOf(формат)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    
    Для i = 0 По методыПрототипа.длина - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Список проблемных методов
    проблемныеМетоды = []
    успешныеМетоды = []
    
    Для i = 0 По методы.длина - 1 Цикл
        имя = методы[i]
        
        // Пропускаем служебные методы
        Если имя === "constructor" ИЛИ имя === "objectNameChanged" ИЛИ имя === "destroyed" Тогда
            Продолжить
        КонецЕсли
        
        Попытка
            // Проверяем, является ли это функцией
            Если typeof(формат[имя]) === "function" Тогда
                // Пытаемся вызвать метод с правильными параметрами
                Попытка
                    // Определяем тип метода по имени
                    Если ЭтоМетодБезПараметров(имя) Тогда
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСБулевымПараметром(имя) Тогда
                        формат[имя](Ложь)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(Ложь) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодССтроковымПараметром(имя) Тогда
                        формат[имя]("тест")
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "('тест') - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСЧисловымПараметром(имя) Тогда
                        формат[имя](10)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(10) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСОбъектнымПараметром(имя) Тогда
                        font1 = new QFont()
                        формат[имя](font1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(Новый QFont()) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСЦелымПараметром(имя) Тогда
                        формат[имя](1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСФорматом(имя) Тогда
                        формат[имя](формат.getFormat())
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(format) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодCopyTo(имя) Тогда
                        цель = Новый QtТекстИзображениеФормат()
                        цель.РежимОтладки(Режим_Отладки)
                        формат[имя](цель)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(target) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    Иначе
                        // Неизвестный метод - пробуем вызвать без параметров
                        формат[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK (неизвестный)")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                    КонецЕсли;
                    
                Исключение
                    // Метод вызвал исключение
                    УстановитьЦветКонсоли("красный")
                    ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - ОШИБКА: " + e)
                    СброситьЦветКонсоли()
                    проблемныеМетоды.push({имя: имя, ошибка: e})
                КонецПопытки
            КонецЕсли
        Исключение
            // Ошибка при проверке типа метода
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("  ✗ " + имя + " - ОШИБКА ПРОВЕРКИ: " + e)
            СброситьЦветКонсоли()
            проблемныеМетоды.push({имя: имя, ошибка: e})
        КонецПопытки
    КонецЦикла
    
    // ========== ИТОГИ ==========
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("голубой")
    ВывестиСтрокуВКонсоль("=== ИТОГИ ДИАГНОСТИКИ ===")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("  ✅ Успешных методов: " + успешныеМетоды.length)
    
    Если проблемныеМетоды.length > 0 Тогда
        УстановитьЦветКонсоли("красный")
        ВывестиСтрокуВКонсоль("  ❌ Проблемных методов: " + проблемныеМетоды.length)
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("  Список проблемных методов:")
        Для i = 0 По проблемныеМетоды.length - 1 Цикл
            элемент = проблемныеМетоды[i]
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("    - " + элемент.имя + "() : " + элемент.ошибка)
            СброситьЦветКонсоли()
        КонецЦикла
    Иначе
        УстановитьЦветКонсоли("зеленый")
        ВывестиСтрокуВКонсоль("  ✅ Все методы работают корректно!")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТекстИзображениеФормат (русские и английские методы)
// ============================================================
Функция ТестQtTextImageFormatFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        формат = Новый QtТекстИзображениеФормат()
        формат.РежимОтладки(Режим_Отладки)
        Если формат != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстИзображениеФормат создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстИзображениеФормат НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если формат == null Тогда
        Возврат "❌ Тест QtТекстИзображениеФормат провален (объект не создан)"
    КонецЕсли

    // ===== ТЕСТ 2: ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = true
    тестРусский = true
    
    try {
        валидный = формат.isValid()
        // Новый объект должен быть валидным (после конструктора по умолчанию)
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    } catch(e) {
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = false
    }
    
    if (тестПройден && валидный == true) {
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает (true)")
        СброситьЦветКонсоли()
    } else {
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = false
    }
    
    // --- РУССКИЙ МЕТОД ---
    if (тестПройден) {
        try {
            валидныйРус = формат.Действителен()
            // Исправлено: ожидается true, а не false!
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        } catch(e) {
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = false
        }
        
        if (тестРусский && валидныйРус == true) {
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает (true)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        } else if (тестРусский) {
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        }
    } else {
