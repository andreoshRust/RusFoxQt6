            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: данные не сброшены")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            // Создаем новый объект для русского теста
            форматРус = Новый QtТекстИзображениеФормат()
            форматРус.РежимОтладки(Режим_Отладки)
            форматРус.УстановитьИмя("test_rus.png")
            форматРус.УстановитьШирину(200)
            форматРус.УстановитьВысоту(100)
            
            былоИмяРус = форматРус.Имя()
            былоWidthРус = форматРус.Ширина()
            былоHeightРус = форматРус.Высота()
            
            форматРус.Очистить()
            
            пустойРус = форматРус.Пустой()
            валидныйРус = форматРус.Действителен()
            имяПослеРус = форматРус.Имя()
            ширинаПослеРус = форматРус.Ширина()
            высотаПослеРус = форматРус.Высота()
            
            ВывестиСтрокуВКонсоль("    [RUS] Было: имя='" + былоИмяРус + "', ширина=" + былоWidthРус + ", высота=" + былоHeightРус)
            ВывестиСтрокуВКонсоль("    [RUS] После Очистить: Пустой=" + пустойРус + ", Действителен=" + валидныйРус)
            ВывестиСтрокуВКонсоль("    [RUS] После Очистить: Имя='" + имяПослеРус + "', Ширина=" + ширинаПослеРус + ", Высота=" + высотаПослеРус)
            
            Если пустойРус == ИСТИНА И имяПослеРус == "" И ширинаПослеРус == 0 И высотаПослеРус == 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Очистка работает (данные сброшены)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: данные не сброшены")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 9. СОЗДАНИЕ С ИМЕНЕМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Создание с именем")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат2 = Новый QtTextImageFormat("photo.jpg")
        формат2.РежимОтладки(Режим_Отладки)
        Если формат2 != null Тогда
            имя2 = формат2.name()
            валидный2 = формат2.isValid()
            ВывестиСтрокуВКонсоль("    [ENG] имя='" + имя2 + "', isValid=" + валидный2)
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Формат не создан")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И имя2 == "photo.jpg" И валидный2 == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Создание с именем работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат2Рус = Новый QtТекстИзображениеФормат("photo_rus.jpg")
            формат2Рус.РежимОтладки(Режим_Отладки)
            Если формат2Рус != null Тогда
                имя2Рус = формат2Рус.Имя()
                валидный2Рус = формат2Рус.Действителен()
                ВывестиСтрокуВКонсоль("    [RUS] Имя='" + имя2Рус + "', Действителен=" + валидный2Рус)
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Формат не создан")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И имя2Рус == "photo_rus.jpg" И валидный2Рус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с именем работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. TOSTRING =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: toString()")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат3 = Новый QtTextImageFormat()
        формат3.РежимОтладки(Режим_Отладки)
        формат3.setName("image.png")
        формат3.setWidth(200)
        формат3.setHeight(150)
        строка = формат3.toString()
        ВывестиСтрокуВКонсоль("    [ENG] toString: '" + строка + "'")
        
        Если строка.indexOf("image.png") != -1 И строка.indexOf("200") != -1 И строка.indexOf("150") != -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] toString() работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: строка не содержит ожидаемых данных")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            формат3Рус = Новый QtТекстИзображениеФормат()
            формат3Рус.РежимОтладки(Режим_Отладки)
            формат3Рус.УстановитьИмя("image_rus.png")
            формат3Рус.УстановитьШирину(300)
            формат3Рус.УстановитьВысоту(200)
            строкаРус = формат3Рус.ВСтроку()
            ВывестиСтрокуВКонсоль("    [RUS] ВСтроку: '" + строкаРус + "'")
            
            Если строкаРус.indexOf("image_rus.png") != -1 И строкаРус.indexOf("300") != -1 И строкаРус.indexOf("200") != -1 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ВСтроку работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: строка не содержит ожидаемых данных")
                СброситьЦветКонсоли()
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 11. ПОЛУЧИТЬФОРМАТ И УСТАНОВИТЬФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: ПолучитьФормат и УстановитьФормат")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        формат4 = Новый QtTextImageFormat()
        формат4.РежимОтладки(Режим_Отладки)
        формат4.setName("copy.png")
        формат4.setWidth(400)
        формат4.setHeight(300)
        
        внутрФормат = формат4.getFormat()
        ВывестиСтрокуВКонсоль("    [ENG] getFormat() вызван")
        
        формат5 = Новый QtTextImageFormat()
        формат5.РежимОтладки(Режим_Отладки)
        формат5.setFormat(внутрФормат)
        ВывестиСтрокуВКонсоль("    [ENG] setFormat() вызван")
        
        имя5 = формат5.name()
        ширина5 = формат5.width()
        высота5 = формат5.height()
        ВывестиСтрокуВКонсоль("    [ENG] имя='" + имя5 + "', ширина=" + ширина5 + ", высота=" + высота5)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И имя5 == "copy.png" И ширина5 == 400 И высота5 == 300 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] getFormat/setFormat работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: данные не совпадают")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            формат4Рус = Новый QtТекстИзображениеФормат()
            формат4Рус.РежимОтладки(Режим_Отладки)
            формат4Рус.УстановитьИмя("copy_rus.png")
            формат4Рус.УстановитьШирину(500)
            формат4Рус.УстановитьВысоту(400)
            
            внутрФорматРус = формат4Рус.ПолучитьФормат()
            ВывестиСтрокуВКонсоль("    [RUS] ПолучитьФормат() вызван")
            
            формат5Рус = Новый QtТекстИзображениеФормат()
            формат5Рус.РежимОтладки(Режим_Отладки)
            формат5Рус.УстановитьФормат(внутрФорматРус)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьФормат() вызван")
            
            имя5Рус = формат5Рус.Имя()
            ширина5Рус = формат5Рус.Ширина()
            высота5Рус = формат5Рус.Высота()
            ВывестиСтрокуВКонсоль("    [RUS] Имя='" + имя5Рус + "', Ширина=" + ширина5Рус + ", Высота=" + высота5Рус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И имя5Рус == "copy_rus.png" И ширина5Рус == 500 И высота5Рус == 400 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ПолучитьФормат/УстановитьФормат работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: данные не совпадают")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстИзображениеФормат: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстИзображениеФормат: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстИзображениеФормат завершён"
КонецФункции


