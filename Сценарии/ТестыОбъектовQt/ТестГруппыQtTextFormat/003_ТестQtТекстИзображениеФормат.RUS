            формат4Рус.УстановитьВысоту(400)
            
            внутрФорматРус = формат4Рус.ПолучитьФормат()
            ВывестиСтрокуВКонсоль("    [RUS] ПолучитьФормат() вызван")
            
            формат5Рус = Новый QtТекстИзображениеФормат()
            формат5Рус.РежимОтладки(Режим_Отладки)
            формат5Рус.УстановитьФормат(внутрФорматРус)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьФормат() вызван")
            
            имя5Рус = формат5Рус.Имя()
            ширина5Рус = формат5Рус.Ширина()
            высота5Рус = формат5Рус.Высота()
            ВывестиСтрокуВКонсоль("    [RUS] Имя='" + имя5Рус + "', Ширина=" + ширина5Рус + ", Высота=" + высота5Рус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И имя5Рус == "copy_rus.png" И ширина5Рус == 500 И высота5Рус == 400 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ПолучитьФормат/УстановитьФормат работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: данные не совпадают")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстИзображениеФормат: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстИзображениеФормат: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстИзображениеФормат завершён"
КонецФункции

