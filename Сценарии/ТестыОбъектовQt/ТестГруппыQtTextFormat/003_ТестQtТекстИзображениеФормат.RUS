// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстИзображениеФормат
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовКласса(диагОбъект)
        // ========== ПОЛУЧАЕМ СПИСОК МЕТОДОВ ИЗ RusFunc ==========
        русМетодыИзFunc = []
        англМетодыИзFunc = []
        карта = []
        
        Попытка
            Если typeof диагОбъект.RusFunc === 'function' Тогда
                jsonStr = диагОбъект.RusFunc()
                карта = JSON.parse(jsonStr)
                ВывестиСтрокуВКонсоль("✓ RusFunc() возвращает " + карта.length + " методов")
                ВывестиСтрокуВКонсоль("")
                
                // Формируем списки русских и английских методов из RusFunc
                Для i = 0 По карта.length - 1 Цикл
                    русМетодыИзFunc[русМетодыИзFunc.length] = карта[i].русскоеИмя
                    англМетодыИзFunc[англМетодыИзFunc.length] = карта[i].латинскоеИмя
                КонецЦикла;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
                Возврат
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
            Возврат
        КонецПопытки;
        
        // ========== ПОЛНЫЙ СПИСОК МЕТОДОВ ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                   ПОЛНЫЙ СПИСОК МЕТОДОВ (русский ↔ английский)")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Вычисляем максимальную длину для выравнивания
        максРусДлина = 0
        максАнглДлина = 0
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            Если русское.length > максРусДлина Тогда максРусДлина = русское.length КонецЕсли
            Если латинское.length > максАнглДлина Тогда максАнглДлина = латинское.length КонецЕсли
        КонецЦикла;
        
        // Устанавливаем минимальную ширину для красивого вывода
        Если максРусДлина < 30 Тогда максРусДлина = 30 КонецЕсли
        Если максАнглДлина < 30 Тогда максАнглДлина = 30 КонецЕсли
        
        // Заголовок таблицы
        УстановитьЦветКонсоли("cyan")
        строкаЗаголовка = "┌─────┬" + "─".repeat(максРусДлина + 2) + "┬" + "─".repeat(максАнглДлина + 2) + "┐"
        ВывестиСтрокуВКонсоль(строкаЗаголовка)
        ВывестиСтрокуВКонсоль("│  №  │ Русский метод" + " ".repeat(максРусДлина - 13) + " │ Английский метод" + " ".repeat(максАнглДлина - 15) + " │")
        ВывестиСтрокуВКонсоль("├─────┼" + "─".repeat(максРусДлина + 2) + "┼" + "─".repeat(максАнглДлина + 2) + "┤")
        СброситьЦветКонсоли()
        
        // Выводим все методы
        Для i = 0 По карта.length - 1 Цикл
            русское = карта[i].русскоеИмя
            латинское = карта[i].латинскоеИмя
            
            // Выравнивание
            русскоеВыровнено = русское
            Если русское.length < максРусДлина Тогда
                русскоеВыровнено = русское + " ".repeat(максРусДлина - русское.length)
            КонецЕсли
            
            латинскоеВыровнено = латинское
            Если латинское.length < максАнглДлина Тогда
                латинскоеВыровнено = латинское + " ".repeat(максАнглДлина - латинское.length)
            КонецЕсли
            
            // Проверяем доступность английского метода
            доступен = typeof диагОбъект[латинское] === 'function'
            
            Если доступен Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("│ " + (i+1) + " │ " + русскоеВыровнено + " │ " + латинскоеВыровнено + " │")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЦикла
        
        // Нижняя граница таблицы
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("└─────┴" + "─".repeat(максРусДлина + 2) + "┴" + "─".repeat(максАнглДлина + 2) + "┘")
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("")
        
        // ========== СТАТИСТИКА ==========
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        ВывестиСтрокуВКонсоль("                          СТАТИСТИКА МЕТОДОВ")
        ВывестиСтрокуВКонсоль("═══════════════════════════════════════════════════════════════════════════════════════")
        СброситьЦветКонсоли()
        
        // Проверяем доступность всех английских методов
        рабочиеАнгл = 0
        нерабочиеАнгл = []
        
        Для i = 0 По англМетодыИзFunc.length - 1 Цикл
            Если typeof диагОбъект[англМетодыИзFunc[i]] === 'function' Тогда
                рабочиеАнгл = рабочиеАнгл + 1
            Иначе
                нерабочиеАнгл[нерабочиеАнгл.length] = англМетодыИзFunc[i]
            КонецЕсли
        КонецЦикла
        
        УстановитьЦветКонсоли("cyan")
        ВывестиСтрокуВКонсоль("  Всего методов в RusFunc: " + карта.length)
        ВывестиСтрокуВКонсоль("  Русских методов:         " + русМетодыИзFunc.length)
        ВывестиСтрокуВКонсоль("  Английских методов:       " + англМетодыИзFunc.length)
        СброситьЦветКонсоли()
        
        Если рабочиеАнгл == англМетодыИзFunc.length Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✅ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length + " (ВСЕ ДОСТУПНЫ!)")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Доступно английских:    " + рабочиеАнгл + " из " + англМетодыИзFunc.length)
            СброситьЦветКонсоли()
            
            Если нерабочиеАнгл.length > 0 Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  НЕДОСТУПНЫЕ английские методы:")
                Для i = 0 По нерабочиеАнгл.length - 1 Цикл
                    ВывестиСтрокуВКонсоль("    ✗ " + нерабочиеАнгл[i])
                КонецЦикла
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
        
        // Русские методы считаем доступными через препроцессор
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✅ Русские методы:         " + русМетодыИзFunc.length + " (доступны через препроцессор)")
        СброситьЦветКонсоли()
        
        ВывестиСтрокуВКонсоль("")
        
   
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

Функция ДиагностикаМетодовQtTextImageFormat()
    ИмяКласса = "QtTextImageFormat"
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ "+ИмяКласса+" ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования "+ИмяКласса+": " + (typeof QtTextImageFormat !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке "+ИмяКласса+": " + e)
    КонецПопытки;
    
    Попытка
        диагДата = Новый QtTextImageFormat()
        
        Если диагДата == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: "+ИмяКласса+" не создан")
            Возврат 
        КонецЕсли;
        
        диагДата.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ "+ИмяКласса+" создан")
        ВывестиСтрокуВКонсоль("")
        
        ДиагностикаМетодовКласса(диагДата)
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике "+ИмяКласса+": " + e)
    КонецПопытки;
    
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстИзображениеФормат
// ============================================================

Функция ЭтоМетодБезПараметров(имя)
    список = [
        "isValid", "type", "objectIndex",
        "isEmpty", "isEmptyFormat", "isEmptyImage",
        "name", "width", "height",
        "clear", "getFormat", "toString",
        "copy", "getDebug", "getImageFormat",
        "getImageFormatObject", "getCharFormat",
        "getInvalidFormat", "getBlockFormat",
        "getListFormat", "getTableFormat",
        "getFrameFormat", "getUserFormat",
        "getSelectionFormat", "font",
        "fontFamily", "fontPointSize",
        "fontBold", "fontItalic",
        "fontUnderline", "fontStrikeOut",
        "fontOverline", "fontCapitalization",
        "foreground", "foregroundColor",
        "textColor", "backgroundColor",
        "underlineStyle", "underlineColor",
        "verticalAlignment", "letterSpacing",
        "wordSpacing", "isCharFormat",
        "propertyCount", "RusFunc"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСБулевымПараметром(имя)
    список = [
        "setDebug", "РежимОтладки",
        "setFontBold", "setFontItalic",
        "setFontUnderline", "setFontStrikeOut",
        "setFontOverline"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодССтроковымПараметром(имя)
    список = [
        "setName", "setFontFamily",
        "setTextColor", "setBackgroundColor",
        "setForegroundColor", "setUnderlineColor"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСЧисловымПараметром(имя)
    список = [
        "setWidth", "setHeight",
        "setFontPointSize", "setFontSize",
        "setLetterSpacing", "setWordSpacing",
        "setFontWeight", "setUnderlineStyle",
        "setVerticalAlignment", "setFontCapitalization"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСОбъектнымПараметром(имя)
    список = [
        "setFont", "setForeground", "setBackground"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСЦелымПараметром(имя)
    список = [
        "setProperty", "hasProperty",
        "clearProperty", "property"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодСФорматом(имя)
    список = [
        "setFormat", "setImageFormat",
        "setCharFormat", "merge"
    ]
    Возврат список.индекс(имя) !== -1
КонецФункции

Функция ЭтоМетодCopyTo(имя)
    Возврат имя === "copyTo"
КонецФункции

Функция ДиагностикаМетаОбъектаTextImageFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстИзображениеФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextImageFormat: " + (typeof QtTextImageFormat !== "undefined"))
        ВывестиСтрокуВКонсоль("Проверка QtТекстИзображениеФормат: " + (typeof QtТекстИзображениеФормат !== "undefined"))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        формат1 = Новый QtТекстИзображениеФормат()
        формат1.РежимОтладки(Режим_Отладки)
        Если формат1 == null Тогда
          ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
          Возврат 
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат 
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстИзображениеФормат:")
    
    методы = Object.getOwnPropertyNames(формат1)
    прототип = Object.getPrototypeOf(формат1)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    
    Для i = 0 По методыПрототипа.длина - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Список проблемных методов
    проблемныеМетоды = []
    успешныеМетоды = []
    
    Для i = 0 По методы.длина - 1 Цикл
        имя = методы[i]
        
        // Пропускаем служебные методы
        Если имя === "constructor" ИЛИ имя === "objectNameChanged" ИЛИ имя === "destroyed" Тогда
            Продолжить
        КонецЕсли
        
        Попытка
            // Проверяем, является ли это функцией
            Если typeof(формат1[имя]) === "function" Тогда
                // Пытаемся вызвать метод с правильными параметрами
                Попытка
                    // Определяем тип метода по имени
                    Если ЭтоМетодБезПараметров(имя) Тогда
                        формат1[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСБулевымПараметром(имя) Тогда
                        формат1[имя](Ложь)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(Ложь) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодССтроковымПараметром(имя) Тогда
                        формат1[имя]("тест")
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "('тест') - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСЧисловымПараметром(имя) Тогда
                        формат1[имя](10)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(10) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСОбъектнымПараметром(имя) Тогда
                        font1 = new QFont()
                        формат1[имя](font1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(Новый QFont()) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСЦелымПараметром(имя) Тогда
                        формат1[имя](1)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(1) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодСФорматом(имя) Тогда
                        формат1[имя](формат1.getFormat())
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(format) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    ИначеЕсли ЭтоМетодCopyTo(имя) Тогда
                        цель = Новый QtТекстИзображениеФормат()
                        цель.РежимОтладки(Режим_Отладки)
                        формат1[имя](цель)
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "(target) - OK")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                        
                    Иначе
                        // Неизвестный метод - пробуем вызвать без параметров
                        формат1[имя]()
                        УстановитьЦветКонсоли("зеленый")
                        ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - OK (неизвестный)")
                        СброситьЦветКонсоли()
                        успешныеМетоды.push(имя)
                    КонецЕсли;
                    
                Исключение
                    // Метод вызвал исключение
                    УстановитьЦветКонсоли("красный")
                    ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - ОШИБКА: " + e)
                    СброситьЦветКонсоли()
                    проблемныеМетоды.push({имя: имя, ошибка: e})
                КонецПопытки
            КонецЕсли
        Исключение
            // Ошибка при проверке типа метода
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("  ✗ " + имя + " - ОШИБКА ПРОВЕРКИ: " + e)
            СброситьЦветКонсоли()
            проблемныеМетоды.push({имя: имя, ошибка: e})
        КонецПопытки
    КонецЦикла
    
    // ========== ИТОГИ ==========
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("голубой")
    ВывестиСтрокуВКонсоль("=== ИТОГИ ДИАГНОСТИКИ ===")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("  ✅ Успешных методов: " + успешныеМетоды.length)
    
    Если проблемныеМетоды.length > 0 Тогда
        УстановитьЦветКонсоли("красный")
        ВывестиСтрокуВКонсоль("  ❌ Проблемных методов: " + проблемныеМетоды.length)
        СброситьЦветКонсоли()
        ВывестиСтрокуВКонсоль("  Список проблемных методов:")
        Для i = 0 По проблемныеМетоды.length - 1 Цикл
            элемент = проблемныеМетоды[i]
            УстановитьЦветКонсоли("красный")
            ВывестиСтрокуВКонсоль("    - " + элемент.имя + "() : " + элемент.ошибка)
            СброситьЦветКонсоли()
        КонецЦикла
    Иначе
        УстановитьЦветКонсоли("зеленый")
