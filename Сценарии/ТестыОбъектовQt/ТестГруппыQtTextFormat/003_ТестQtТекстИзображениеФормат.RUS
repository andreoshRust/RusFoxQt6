            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

// ===== 10. TOSTRING =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 10: toString()")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА

// --- АНГЛИЙСКИЙ МЕТОД ---
Попытка
    формат3 = Новый QtTextImageFormat()
    формат3.РежимОтладки(Режим_Отладки)
    формат3.setName("image.png")
    формат3.setWidth(200)
    формат3.setHeight(150)
    строка = формат3.toString()
    ВывестиСтрокуВКонсоль("    [ENG] toString: '" + строка + "'")
    
    Если строка.indexOf("image.png") != -1 И строка.indexOf("200") != -1 И строка.indexOf("150") != -1 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] toString() работает")
