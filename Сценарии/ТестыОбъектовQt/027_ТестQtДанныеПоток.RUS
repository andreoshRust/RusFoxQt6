//Что было протестировано:
//Создание объекта - ✓ QtДанныеПоток успешно создается
//Запись целых чисел - ✓ writeInt32, ЗаписатьЦелое32, writeInt64
//Запись беззнаковых чисел - ✓ writeUInt32, ЗаписатьБеззнаковое32
//Запись дробей - ✓ writeDouble, ЗаписатьДробь, writeFloat
//Запись логики - ✓ writeBool, ЗаписатьЛогику
//Запись строк - ✓ writeString, ЗаписатьСтроку, writeQString
//Запись байтов - ✓ writeBytes, ЗаписатьБайты
//Константы порядка байт - ✓ BigEndian(0), LittleEndian(1)
//Константы точности - ✓ SinglePrecision(0), DoublePrecision(1)
//Константы статусов - ✓ Ok(0), ReadPastEnd(1), ReadCorruptData(2), WriteFailed(3)
//Установка и получение порядка байт - ✓ setByteOrderValue, getByteOrderValue
//Установка и получение точности - ✓ setFloatingPointPrecisionValue, getFloatingPointPrecisionValue
//Проверка статуса - ✓ status, resetStatus
//Проверка RusFunc - ✓ Возвращает валидный JSON с 87 методами
//Диагностика показала:
//40 английских методов доступны
//40 русских методов доступны
//87 методов в JSON RusFunc
//Класс QtDataStream предоставляет:
//Чтение данных (8/16/32/64 бит):
//Целые: ПрочитатьЦелое8, ПрочитатьЦелое16, ПрочитатьЦелое32, ПрочитатьЦелое64
//Беззнаковые: ПрочитатьБеззнаковое8/16/32/64
//Дроби: ПрочитатьДробь, ПрочитатьДробьОдинарную
//Логика: ПрочитатьЛогику
//Строки: ПрочитатьСтроку, ПрочитатьQString
//Байты: ПрочитатьБайты, ПрочитатьВсеБайты
//Проверка: ВКонце
//Запись данных (8/16/32/64 бит):
//Целые: ЗаписатьЦелое8/16/32/64
//Беззнаковые: ЗаписатьБеззнаковое8/16/32/64
//Дроби: ЗаписатьДробь, ЗаписатьДробьОдинарную
//Логика: ЗаписатьЛогику
//Строки: ЗаписатьСтроку, ЗаписатьQString
//Байты: ЗаписатьБайты
//Настройки:
//Порядок байт: УстановитьПорядокБайт, ПолучитьПорядокБайт
//Точность: УстановитьТочность, ПолучитьТочность
//Статус: СброситьСтатус, ПолучитьСтатус
//Устройство:
//ПолучитьУстройство, УстановитьУстройство
//ПолучитьБуфер, ПолучитьРазмер
//Константы:
//Порядок байт: БольшойПорядок, МаленькийПорядок
//Точность: ТочностьОдинарная, ТочностьДвойная
//Статусы: Ок, ЧтениеЗаКонец, ОшибкаЧтения, ОшибкаЗаписи
//Вывод:
//Класс QtDataStream полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с бинарными потоками данных как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДанныеПоток
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtDataStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДанныеПоток ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtDataStream: " + (typeof QtDataStream !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtДанныеПоток: " + (typeof QtДанныеПоток !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДанныеПоток: " + e)
    КонецПопытки;
    
    Попытка
        диагПоток = Новый QtДанныеПоток()
        Если диагПоток == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДанныеПоток не создан")
            Возврат
        КонецЕсли;
        
        диагПоток.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtДанныеПоток создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "readInt8", "readInt16", "readInt32", "readInt64",
            "readUInt8", "readUInt16", "readUInt32", "readUInt64",
            "readDouble", "readFloat", "readBool",
            "readString", "readBytes", "readAllBytes", "readQString",
            "atEndValue",
            "writeInt8", "writeInt16", "writeInt32", "writeInt64",
            "writeUInt8", "writeUInt16", "writeUInt32", "writeUInt64",
            "writeDouble", "writeFloat", "writeBool",
            "writeString", "writeBytes", "writeQString",
            "setByteOrderValue", "getByteOrderValue",
            "setFloatingPointPrecisionValue", "getFloatingPointPrecisionValue",
            "resetStatus", "status",
            "getDeviceValue", "setDeviceValue",
            "getBufferValue", "getSize"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПоток[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "ПрочитатьЦелое8", "ПрочитатьЦелое16", "ПрочитатьЦелое32", "ПрочитатьЦелое64",
            "ПрочитатьБеззнаковое8", "ПрочитатьБеззнаковое16", "ПрочитатьБеззнаковое32", "ПрочитатьБеззнаковое64",
            "ПрочитатьДробь", "ПрочитатьДробьОдинарную", "ПрочитатьЛогику",
            "ПрочитатьСтроку", "ПрочитатьБайты", "ПрочитатьВсеБайты", "ПрочитатьQString",
            "ВКонце",
            "ЗаписатьЦелое8", "ЗаписатьЦелое16", "ЗаписатьЦелое32", "ЗаписатьЦелое64",
            "ЗаписатьБеззнаковое8", "ЗаписатьБеззнаковое16", "ЗаписатьБеззнаковое32", "ЗаписатьБеззнаковое64",
            "ЗаписатьДробь", "ЗаписатьДробьОдинарную", "ЗаписатьЛогику",
            "ЗаписатьСтроку", "ЗаписатьБайты", "ЗаписатьQString",
            "УстановитьПорядокБайт", "ПолучитьПорядокБайт",
            "УстановитьТочность", "ПолучитьТочность",
            "СброситьСтатус", "ПолучитьСтатус",
            "ПолучитьУстройство", "УстановитьУстройство",
            "ПолучитьБуфер", "ПолучитьРазмер"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПоток[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПоток.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПоток.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДанныеПоток: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtДанныеПоток
// ============================================================

Функция ДиагностикаМетаОбъектаDataStream()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtДанныеПоток ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtDataStream: " + (typeof QtDataStream !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtДанныеПоток: " + (typeof QtДанныеПоток !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        поток = Новый QtДанныеПоток()
        Если поток == null Тогда
            поток = new QtДанныеПоток()
            Если поток == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtДанныеПоток()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtДанныеПоток:")
    методы = Object.getOwnPropertyNames(поток)
    прототип = Object.getPrototypeOf(поток)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof поток[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtДанныеПоток (QtDataStream) - ИТОГОВАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtDataStreamFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        поток = Новый QtДанныеПоток()
        поток.РежимОтладки(Режим_Отладки)
        Если поток != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДанныеПоток создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДанныеПоток НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если поток == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ТЕСТ ЗАПИСИ ЦЕЛЫХ ЧИСЕЛ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Запись целых чисел")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п2 = Новый QtДанныеПоток()
        п2.РежимОтладки(Режим_Отладки)
        п2.writeInt32(42)
        п2.ЗаписатьЦелое32(100)
        п2.writeInt64(1234567890)
        ВывестиСтрокуВКонсоль("    writeInt32(42), ЗаписатьЦелое32(100), writeInt64(1234567890) - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись целых чисел работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 3. ТЕСТ ЗАПИСИ БЕЗЗНАКОВЫХ ЧИСЕЛ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Запись беззнаковых чисел")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п3 = Новый QtДанныеПоток()
        п3.РежимОтладки(Режим_Отладки)
        п3.writeUInt32(255)
        п3.ЗаписатьБеззнаковое32(65535)
        ВывестиСтрокуВКонсоль("    writeUInt32(255), ЗаписатьБеззнаковое32(65535) - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись беззнаковых чисел работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 4. ТЕСТ ЗАПИСИ ДРОБЕЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запись дробей")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п4 = Новый QtДанныеПоток()
        п4.РежимОтладки(Режим_Отладки)
        п4.writeDouble(3.1415926535)
        п4.ЗаписатьДробь(2.7182818284)
        п4.writeFloat(1.618)
        ВывестиСтрокуВКонсоль("    writeDouble(3.14159), ЗаписатьДробь(2.71828), writeFloat(1.618) - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись дробей работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 5. ТЕСТ ЗАПИСИ ЛОГИКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Запись логики")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п5 = Новый QtДанныеПоток()
        п5.РежимОтладки(Режим_Отладки)
        п5.writeBool(true)
        п5.ЗаписатьЛогику(false)
        п5.writeBool(true)
        ВывестиСтрокуВКонсоль("    writeBool(true), ЗаписатьЛогику(false), writeBool(true) - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись логики работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 6. ТЕСТ ЗАПИСИ СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Запись строк")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п6 = Новый QtДанныеПоток()
        п6.РежимОтладки(Режим_Отладки)
        п6.writeString("Hello")
        п6.ЗаписатьСтроку(" World")
        п6.writeQString(" Qt")
        ВывестиСтрокуВКонсоль("    writeString('Hello'), ЗаписатьСтроку(' World'), writeQString(' Qt') - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись строк работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 7. ТЕСТ ЗАПИСИ БАЙТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Запись байтов")
    СброситьЦветКонсоли()
    
    тестПройден = ЛОЖЬ
    Попытка
        п7 = Новый QtДанныеПоток()
        п7.РежимОтладки(Режим_Отладки)
        п7.writeBytes("Hello")
        п7.ЗаписатьБайты(" World")
        ВывестиСтрокуВКонсоль("    writeBytes('Hello'), ЗаписатьБайты(' World') - выполнено без ошибок")
        тестПройден = ИСТИНА
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запись байтов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 8. ТЕСТ КОНСТАНТ ПОРЯДКА БАЙТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Константы порядка байт")
    СброситьЦветКонсоли()
    
    Попытка
        п8 = Новый QtДанныеПоток()
        большой = п8.BigEndian()
        маленький = п8.LittleEndian()
        
        ВывестиСтрокуВКонсоль("    BigEndian(): " + большой + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("    LittleEndian(): " + маленький + " (ожидается 1)")
        
        Если большой == 0 И маленький == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы порядка байт работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы порядка байт не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ТЕСТ КОНСТАНТ ТОЧНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Константы точности")
    СброситьЦветКонсоли()
    
    Попытка
        п9 = Новый QtДанныеПоток()
        одинарная = п9.SinglePrecision()
        двойная = п9.DoublePrecision()
        
        ВывестиСтрокуВКонсоль("    SinglePrecision(): " + одинарная + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("    DoublePrecision(): " + двойная + " (ожидается 1)")
        
        Если одинарная == 0 И двойная == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы точности работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы точности не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ТЕСТ КОНСТАНТ СТАТУСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Константы статусов")
    СброситьЦветКонсоли()
    
    Попытка
        п10 = Новый QtДанныеПоток()
        ок = п10.Ok()
        пастЕнд = п10.ReadPastEnd()
        коррупт = п10.ReadCorruptData()
        врайтФейл = п10.WriteFailed()
        
        ВывестиСтрокуВКонсоль("    Ok(): " + ок + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("    ReadPastEnd(): " + пастЕнд + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("    ReadCorruptData(): " + коррупт + " (ожидается 2)")
        ВывестиСтрокуВКонсоль("    WriteFailed(): " + врайтФейл + " (ожидается 3)")
        
        Если ок == 0 И пастЕнд == 1 И коррупт == 2 И врайтФейл == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы статусов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы статусов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ ПОРЯДКА БАЙТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Установка и получение порядка байт")
    СброситьЦветКонсоли()
    
    Попытка
        п11 = Новый QtДанныеПоток()
        п11.РежимОтладки(Режим_Отладки)
        
        п11.setByteOrderValue(п11.LittleEndian())
        порядок = п11.getByteOrderValue()
        ВывестиСтрокуВКонсоль("    setByteOrderValue(LittleEndian) -> getByteOrderValue(): " + порядок + " (ожидается 1)")
        
        п11.УстановитьПорядокБайт(п11.BigEndian())
        порядок2 = п11.ПолучитьПорядокБайт()
        ВывестиСтрокуВКонсоль("    УстановитьПорядокБайт(BigEndian) -> ПолучитьПорядокБайт(): " + порядок2 + " (ожидается 0)")
        
        Если порядок == 1 И порядок2 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение порядка байт работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение порядка байт не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ ТОЧНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Установка и получение точности")
    СброситьЦветКонсоли()
    
    Попытка
        п12 = Новый QtДанныеПоток()
        п12.РежимОтладки(Режим_Отладки)
        
        п12.setFloatingPointPrecisionValue(п12.SinglePrecision())
        точность = п12.getFloatingPointPrecisionValue()
        ВывестиСтрокуВКонсоль("    setFloatingPointPrecisionValue(SinglePrecision) -> getFloatingPointPrecisionValue(): " + точность + " (ожидается 0)")
        
        п12.УстановитьТочность(п12.DoublePrecision())
        точность2 = п12.ПолучитьТочность()
        ВывестиСтрокуВКонсоль("    УстановитьТочность(DoublePrecision) -> ПолучитьТочность(): " + точность2 + " (ожидается 1)")
        
        Если точность == 0 И точность2 == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение точности работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение точности не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ТЕСТ СТАТУСА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка статуса")
    СброситьЦветКонсоли()
    
    Попытка
        п13 = Новый QtДанныеПоток()
        п13.РежимОтладки(Режим_Отладки)
        
        статус1 = п13.status()
        ВывестиСтрокуВКонсоль("    status(): " + статус1 + " (ожидается 0 - Ok)")
        
        п13.resetStatus()
        статус2 = п13.ПолучитьСтатус()
        ВывестиСтрокуВКонсоль("    resetStatus() -> ПолучитьСтатус(): " + статус2 + " (ожидается 0 - Ok)")
        
        Если статус1 == 0 И статус2 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Статус работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Статус работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof поток.RusFunc === 'function' Тогда
            jsonStr = поток.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtДанныеПоток завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                  ТЕСТИРОВАНИЕ QtДанныеПоток (QtDataStream)                     ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtDataStream()
    ДиагностикаМетаОбъектаDataStream()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtДанныеПоток (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtDataStreamFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtДанныеПоток: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


