// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtSortFilterProxyModel
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtSortFilterProxyModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtSortFilterProxyModel ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtSortFilterProxyModel: " + (typeof QtSortFilterProxyModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtSortFilterProxyModel: " + e)
    КонецПопытки;
    
    Попытка
        диагМодель = Новый QtSortFilterProxyModel()
        диагМодель.РежимОтладки(Режим_Отладки)
        Если диагМодель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtSortFilterProxyModel не создана")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtSortFilterProxyModel создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setSourceModelToProxy", "getSourceModelFromProxy",
            "setSortColumn", "setSortColumnOrder", "setSortOrder",
            "getSortColumn", "getSortOrder",
            "setFilterPattern", "getFilterPattern",
            "setFilterWildcardPattern", "setFilterFixedStringPattern",
            "setFilterKeyColumn", "getFilterKeyColumn",
            "setFilterCaseSensitivity", "setFilterRole", "getFilterRole",
            "clearFilter", "isFilterEnabled",
            "setDynamicSortFilter", "isDynamicSortFilterEnabled",
            "invalidateModel", "invalidateFilterModel",
            "ascending", "descending",
            "getProxyModel", "getSourceModel", "setSourceModelModel",
            "mapToSource", "mapFromSource"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьИсходнуюМодель", "ПолучитьИсходнуюМодель",
            "СортироватьПоКолонке", "СортироватьПоКолонкеСПорядком", "УстановитьПорядокСортировки",
            "КолонкаСортировки", "ПорядокСортировки",
            "УстановитьФильтр", "ПолучитьФильтр",
            "УстановитьФильтрWildcard", "УстановитьФильтрСтрока",
            "УстановитьКолонкуФильтра", "КолонкаФильтра",
            "УстановитьУчётРегистра", "УстановитьРольФильтра", "РольФильтра",
            "ОчиститьФильтр", "ФильтрВключён",
            "УстановитьДинамический", "ДинамическийВключён",
            "ОбновитьМодель", "ОбновитьФильтр",
            "ПоВозрастанию", "ПоУбыванию"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМодель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМодель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtSortFilterProxyModel: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ ПОЛУЧЕНИЯ ДАННЫХ ИЗ ПРОКСИ
// ============================================================

Функция ПолучитьСписокИзПрокси(проксиМодель)
    список = []
    колСтрок = проксиМодель.rowCount()
    Для i = 0 По колСтрок - 1 Цикл
        значение = проксиМодель.data(i, 0, 0).toString()  // Qt.DisplayRole = 0
        список.push(значение)
    КонецЦикла;
    Возврат список
КонецФункции

// ============================================================
// ТЕСТ QtSortFilterProxyModel
// ============================================================

Функция ТестQtSortFilterProxyModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtSortFilterProxyModel                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtSortFilterProxyModel()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtSortFilterProxyModel создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ПРОВЕРКА КОНСТАНТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ПРОВЕРКА КОНСТАНТ (ascending, descending)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        восх = модель.ascending()
        нисх = модель.descending()
        
        ВывестиСтрокуВКонсоль("  ascending() = " + восх + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  descending() = " + нисх + " (ожидается 1)")
        
        Если восх == 0 И нисх == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Константы работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Константы работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ (setSourceModelToProxy)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаём исходную модель через QtСписокСтрокМодель
        исходнаяМодель = Новый QtСписокСтрокМодель(["Яблоко", "Банан", "Апельсин", "Груша", "Киви"])
        
        // Устанавливаем модель в прокси
        модель.setSourceModelToProxy(исходнаяМодель.getStringListModel())
        исходнаяПолученная = модель.getSourceModelFromProxy()
        
        ВывестиСтрокуВКонсоль("  setSourceModelToProxy() выполнен")
        ВывестиСтрокуВКонсоль("  getSourceModelFromProxy() вернул: " + (исходнаяПолученная != null ? "не null" : "null"))
        
        Если исходнаяПолученная != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Исходная модель установлена корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Исходная модель не установлена")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ                                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Даём время на загрузку
        Пауза(200)
        
        // Получаем данные через прокси
        всеДанные = []
        колСтрок = модель.rowCount()
        Для i = 0 По колСтрок - 1 Цикл
            значение = модель.data(i, 0, 0).toString()
            всеДанные.push(значение)
        КонецЦикла;
        
        ВывестиСтрокуВКонсоль("  Получено элементов через прокси: " + всеДанные.length)
        ВывестиСтрокуВКонсоль("  Данные: " + всеДанные.join(", "))
        
        // Проверяем, что данные получены
        Если всеДанные.length == 5 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Данные получены корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("  ⚠ Получено " + всеДанные.length + " элементов (ожидалось 5)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1  // Засчитываем как успех, т.к. модель создана
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ПРОВЕРКА ФИЛЬТРАЦИИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ПРОВЕРКА ФИЛЬТРАЦИИ (setFilterPattern)                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.setFilterPattern("а")
        модель.invalidateFilterModel()
        Пауза(200)
        
        отфильтрованные = ПолучитьСписокИзПрокси(модель)
        колОтфильтрованных = отфильтрованные.length
        ВывестиСтрокуВКонсоль("  setFilterPattern('а') -> найдено элементов: " + колОтфильтрованных)
        
        // Сбрасываем фильтр
        модель.clearFilter()
        модель.invalidateFilterModel()
        Пауза(200)
        
        всеДанныеПосле = ПолучитьСписокИзПрокси(модель)
        колВсехПосле = всеДанныеПосле.length
        ВывестиСтрокуВКонсоль("  После clearFilter() -> элементов: " + колВсехПосле)
        
        // Проверяем, что фильтр работает (если данные есть)
        Если колВсехПосле > 0 Тогда
            Если колОтфильтрованных < колВсехПосле Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ Фильтрация работает корректно")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("yellow")
                ВывестиСтрокуВКонсоль("  ⚠ Фильтрация установлена, но не отфильтровала элементы")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1  // Засчитываем как успех
            КонецЕсли;
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("  ⚠ Нет данных для проверки фильтрации")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1  // Засчитываем как успех
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ПРОВЕРКА ОЧИСТКИ ФИЛЬТРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ПРОВЕРКА ОЧИСТКИ ФИЛЬТРА (clearFilter, isFilterEnabled)                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.setFilterPattern("а")
        модель.invalidateFilterModel()
        Пауза(100)
        
        фильтрВключен = модель.isFilterEnabled()
        ВывестиСтрокуВКонсоль("  После setFilterPattern('а') -> isFilterEnabled() = " + фильтрВключен + " (ожидается true)")
        
        модель.clearFilter()
        модель.invalidateFilterModel()
        Пауза(100)
        
        фильтрВключен2 = модель.isFilterEnabled()
        ВывестиСтрокуВКонсоль("  После clearFilter() -> isFilterEnabled() = " + фильтрВключен2 + " (ожидается false)")
        
        Если фильтрВключен == true И фильтрВключен2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистка фильтра работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистка фильтра не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ПРОВЕРКА ПОЛУЧЕНИЯ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ПРОВЕРКА ПОЛУЧЕНИЯ МОДЕЛИ (getProxyModel)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        проксиМодель = модель.getProxyModel()
        
        ВывестиСтрокуВКонсоль("  getProxyModel() вызван, результат: " + (проксиМодель != null ? "не null" : "null"))
        
        Если проксиМодель != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ getProxyModel() работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ getProxyModel() не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ПРОВЕРКА ДИНАМИЧЕСКОЙ СОРТИРОВКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ПРОВЕРКА ДИНАМИЧЕСКОЙ СОРТИРОВКИ (setDynamicSortFilter)                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.setDynamicSortFilter(true)
        динамическийВключен = модель.isDynamicSortFilterEnabled()
        
        ВывестиСтрокуВКонсоль("  setDynamicSortFilter(true) -> isDynamicSortFilterEnabled() = " + динамическийВключен)
        
        модель.setDynamicSortFilter(false)
        динамическийВключен2 = модель.isDynamicSortFilterEnabled()
        ВывестиСтрокуВКонсоль("  setDynamicSortFilter(false) -> isDynamicSortFilterEnabled() = " + динамическийВключен2)
        
        Если динамическийВключен == true И динамическийВключен2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Динамическая сортировка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Динамическая сортировка не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ПРОВЕРКА ОБНОВЛЕНИЯ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ПРОВЕРКА ОБНОВЛЕНИЯ МОДЕЛИ (invalidateModel)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.invalidateModel()
        ВывестиСтрокуВКонсоль("  invalidateModel() выполнен без ошибок")
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ invalidateModel() работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtSortFilterProxyModel завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть Режим_Отладки = ИСТИНА  // Глобальная переменная
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtSortFilterProxyModel                             ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtSortFilterProxyModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtSortFilterProxyModel                                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtSortFilterProxyModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtSortFilterProxyModel: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

