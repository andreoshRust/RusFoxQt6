// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtМИМДанные
// ============================================================

Функция ДиагностикаМетодовQtMimeData()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtМИМДанные ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtМИМДанные: " + (typeof QtМИМДанные !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtМИМДанные: " + e)
    КонецПопытки;
    
    Попытка
        диагДанные = Новый QtМИМДанные()
        Если диагДанные == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtМИМДанные не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtМИМДанные создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "hasText", "text", "setText",
            "hasHtml", "html", "setHtml",
            "hasUrls", "urls", "setUrls",
            "hasImage", "imageData", "setImageData",
            "hasColor", "colorData", "setColorData",
            "hasFormat", "formats", 
            "data", "setData", "removeFormat", "clear",
            "isValid", "getMimeData", "setMimeData",
            "toString"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДанные[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ЕстьТекст", "Текст", "УстановитьТекст",
            "ЕстьHTML", "HTML", "УстановитьHTML",
            "ЕстьURL", "URL", "УстановитьURL",
            "ЕстьИзображение", "ДанныеИзображения", "УстановитьИзображение",
            "ЕстьЦвет", "ДанныеЦвета", "УстановитьЦвет",
            "ЕстьФормат", "Форматы",
            "Данные", "УстановитьДанные", "УдалитьФормат", "Очистить",
            "Действителен", "ПолучитьДанные", "УстановитьДанныеОбъект",
            "ВСтроку"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДанные[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДанные.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДанные.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtМИМДанные: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtМИМДанные
// ============================================================

Функция ДиагностикаМетаОбъектаMimeData()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtМИМДанные ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtMimeData: " + (typeof QtMimeData !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtМИМДанные: " + (typeof QtМИМДанные !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        данные = НовыйОбъект("QtМИМДанные")
        Если данные == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            данные = new QtMimeData()
            Если данные == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtMimeData()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtMimeData()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtМИМДанные:")
    методы = Object.getOwnPropertyNames(данные)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(данные)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof данные[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof данные.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = данные.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "ЕстьТекст", "Текст", "УстановитьТекст",
        "ЕстьHTML", "HTML", "УстановитьHTML",
        "Действителен", "Очистить"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof данные[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtМИМДанные (русские и английские методы)
// ============================================================
Функция ТестQtMimeDataFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    данные = null
    Попытка
        данные = Новый QtМИМДанные()
        Если данные != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtМИМДанные создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtМИМДанные НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если данные == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        валидный = данные.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = данные.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
            Если валидныйРус == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ТЕКСТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Работа с текстом")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.setText("Hello World!")
        текст = данные.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText/text: '" + текст + "' (ожидается 'Hello World!')")
        Если текст == "Hello World!" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'Hello World!', получено '" + текст + "'")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            данные.УстановитьТекст("Hello RUS!")
            текстРус = данные.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст/Текст: '" + текстРус + "' (ожидается 'Hello RUS!')")
            Если текстРус == "Hello RUS!" Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Hello RUS!', получено '" + текстРус + "'")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 4. HTML =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Работа с HTML")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.setHtml("<b>Bold</b> and <i>Italic</i>")
        html = данные.html()
        ВывестиСтрокуВКонсоль("    [ENG] setHtml/html: '" + html + "'")
        Если html.indexOf("Bold") >= 0 И html.indexOf("Italic") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] HTML работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: HTML не содержит ожидаемых данных")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            данные.УстановитьHTML("<u>Underline</u> and <s>Strike</s>")
            htmlРус = данные.HTML()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьHTML/HTML: '" + htmlРус + "'")
            Если htmlРус.indexOf("Underline") >= 0 И htmlРус.indexOf("Strike") >= 0 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] HTML работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: HTML не содержит ожидаемых данных")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 5. ПРОВЕРКА НАЛИЧИЯ ФОРМАТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка наличия форматов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        имеетТекст = данные.hasText()
        имеетHtml = данные.hasHtml()
        ВывестиСтрокуВКонсоль("    [ENG] hasText=" + имеетТекст + ", hasHtml=" + имеетHtml)
        Если имеетТекст == ИСТИНА И имеетHtml == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Проверка форматов работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, true")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            естьТекст = данные.ЕстьТекст()
            естьHtml = данные.ЕстьHTML()
            ВывестиСтрокуВКонсоль("    [RUS] ЕстьТекст=" + естьТекст + ", ЕстьHTML=" + естьHtml)
            Если естьТекст == ИСТИНА И естьHtml == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Проверка форматов работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, true")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 6. ФОРМАТЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение списка форматов")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        форматы = данные.formats()
        ВывестиСтрокуВКонсоль("    [ENG] formats: " + форматы.join(", "))
        Если форматы.length >= 2 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Форматы получены")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается минимум 2 формата")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            форматыРус = данные.Форматы()
            ВывестиСтрокуВКонсоль("    [RUS] Форматы: " + форматыРус.join(", "))
            Если форматыРус.length >= 2 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Форматы получены")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается минимум 2 формата")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 7. ПРОИЗВОЛЬНЫЕ ДАННЫЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Произвольные данные")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.setData("application/x-test", "MyCustomData")
        данныеДанные = данные.data("application/x-test")
        ВывестиСтрокуВКонсоль("    [ENG] setData/data: '" + данныеДанные + "' (ожидается 'MyCustomData')")
        Если данныеДанные == "MyCustomData" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Произвольные данные работают")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'MyCustomData', получено '" + данныеДанные + "'")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            данные.УстановитьДанные("application/x-test-rus", "MyCustomDataRUS")
            данныеРус = данные.Данные("application/x-test-rus")
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДанные/Данные: '" + данныеРус + "' (ожидается 'MyCustomDataRUS')")
            Если данныеРус == "MyCustomDataRUS" Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Произвольные данные работают")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'MyCustomDataRUS', получено '" + данныеРус + "'")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 8. ПРОВЕРКА НАЛИЧИЯ ФОРМАТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка наличия формата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        естьФормат = данные.hasFormat("application/x-test")
        нетФормата = данные.hasFormat("application/x-nonexistent")
        ВывестиСтрокуВКонсоль("    [ENG] hasFormat(test)=" + естьФормат + ", hasFormat(nonexistent)=" + нетФормата)
        Если естьФормат == ИСТИНА И нетФормата == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Проверка формата работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, false")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            естьФорматРус = данные.ЕстьФормат("application/x-test-rus")
            нетФорматаРус = данные.ЕстьФормат("application/x-nonexistent-rus")
            ВывестиСтрокуВКонсоль("    [RUS] ЕстьФормат(test)=" + естьФорматРус + ", ЕстьФормат(nonexistent)=" + нетФорматаРус)
            Если естьФорматРус == ИСТИНА И нетФорматаРус == ЛОЖЬ Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Проверка формата работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, false")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 9. УДАЛЕНИЕ ФОРМАТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Удаление формата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.removeFormat("application/x-test")
        естьФормат = данные.hasFormat("application/x-test")
        ВывестиСтрокуВКонсоль("    [ENG] removeFormat: hasFormat=" + естьФормат + " (ожидается false)")
        Если естьФормат == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Удаление формата работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false, получено " + естьФормат)
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            данные.УдалитьФормат("application/x-test-rus")
            естьФорматРус = данные.ЕстьФормат("application/x-test-rus")
            ВывестиСтрокуВКонсоль("    [RUS] УдалитьФормат: ЕстьФормат=" + естьФорматРус + " (ожидается false)")
            Если естьФорматРус == ЛОЖЬ Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Удаление формата работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false, получено " + естьФорматРус)
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. ОЧИСТКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Очистка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.clear()
        hasText = данные.hasText()
        hasHtml = данные.hasHtml()
        форматы = данные.formats()
        ВывестиСтрокуВКонсоль("    [ENG] clear: hasText=" + hasText + ", hasHtml=" + hasHtml + ", formats=" + форматы.length)
        Если hasText == ЛОЖЬ И hasHtml == ЛОЖЬ И форматы.length == 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Очистка работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается все пустое")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            данные.УстановитьТекст("Test")
            данные.УстановитьHTML("<b>Test</b>")
            данные.Очистить()
            hasTextРус = данные.ЕстьТекст()
            hasHtmlРус = данные.ЕстьHTML()
            форматыРус = данные.Форматы()
            ВывестиСтрокуВКонсоль("    [RUS] Очистить: ЕстьТекст=" + hasTextРус + ", ЕстьHTML=" + hasHtmlРус + ", Форматы=" + форматыРус.length)
            Если hasTextРус == ЛОЖЬ И hasHtmlРус == ЛОЖЬ И форматыРус.length == 0 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Очистка работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается все пустое")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 11. TOSTRING =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: toString()")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        данные.УстановитьТекст("Test")
        строка = данные.toString()
        ВывестиСтрокуВКонсоль("    [ENG] toString: '" + строка + "'")
        Если строка.indexOf("QMimeData") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] toString() работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: строка не содержит 'QMimeData'")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            строкаРус = данные.ВСтроку()
            ВывестиСтрокуВКонсоль("    [RUS] ВСтроку: '" + строкаРус + "'")
            Если строкаРус.indexOf("QMimeData") >= 0 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ВСтроку работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: строка не содержит 'QMimeData'")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtМИМДанные: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtМИМДанные: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtМИМДанные завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.12  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.12. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    //Отладка = ИСТИНА
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtМИМДанные (QtMimeData)                           ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtMimeData()
    ДиагностикаМетаОбъектаMimeData()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtМИМДанные (русские и английские методы)                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtMimeDataFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtМИМДанные: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

