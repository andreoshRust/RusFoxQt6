            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается #0000ff, получено " + имяРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 8. РАБОТА С АЛЬФА-КАНАЛОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Работа с альфа-каналом")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет.setRgba(255, 0, 0, 128)
        a = цвет.alpha()
        ВывестиСтрокуВКонсоль("    [ENG] setRgba: alpha=" + a + " (ожидается 128)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И a == 128 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Альфа работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 128, получено " + a)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет.УстановитьRGBA(0, 255, 0, 200)
            aРус = цвет.Альфа()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьRGBA: alpha=" + aРус + " (ожидается 200)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И aРус == 200 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Альфа работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 200, получено " + aРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 9. ПРЕДОПРЕДЕЛЕННЫЕ ЦВЕТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Предопределенные цвета")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        бел = цвет.colorWhite()
        кр = цвет.colorRed()
        зел = цвет.colorGreen()
        син = цвет.colorBlue()
        
        // Проверяем, что объекты созданы
        Если бел != null И кр != null И зел != null И син != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    [ENG] Предопределенные цвета: все объекты созданы")
