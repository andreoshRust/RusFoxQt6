//Тест проверяет 12 основных функций QtColor:
//===========================================
//Создание объекта - проверка создания QtЦвет
//Установка RGB - setRgb/УстановитьRGB
//Установка имени цвета - setNamedColor/УстановитьИмяЦвета
//Установка HSV - setHsv/УстановитьHSV
//Светлее/Темнее - lighter/darker, Светлее/Темнее
//Проверка действительности - isValid/Действителен
//Имя с форматом - name/Имя, name(формат)/ИмяСФорматом
//Альфа-канал - setRgba/УстановитьRGBA, alpha/Альфа
//Предопределенные цвета - colorWhite/Белый, colorRed/КрасныйЦвет
//RGB Float - setRgbF/УстановитьRGBF, redF/КрасныйF
//Из CMYK - fromCmyk/ИзCMYK
//Получение QColor и создание нового QtColor - getColor/ПолучитьЦвет, fromQColor/ИзQColor


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЦвет
// ============================================================

Функция ДиагностикаМетодовQtColor()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЦвет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtЦвет: " + (typeof QtЦвет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЦвет: " + e)
    КонецПопытки;
    
    Попытка
        диагЦвет = Новый QtЦвет()
        Если диагЦвет == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЦвет не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtЦвет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setRgb", "setRgba", "setHsv", "setHsl", "setCmyk", 
            "setNamedColor", "setRgbF", "setHsvF", "setHslF",
            "red", "green", "blue", "alpha",
            "redF", "greenF", "blueF", "alphaF",
            "hue", "saturation", "value", "lightness",
            "hueF", "saturationF", "valueF", "lightnessF",
            "cyan", "magenta", "yellow", "black",
            "cyanF", "magentaF", "yellowF", "blackF",
            "name", "rgba", "rgb",
            "getRgb", "getHsv", "getHsl", "getCmyk",
            "toRgb", "toHsv", "toHsl", "toCmyk",
            "lighter", "darker", "isValid",
            "withAlpha", "withAlphaF",
            "getColor", "fromQColor",
            "colorNames", "fromRgb", "fromRgba", "fromRgbF",
            "fromHsv", "fromHsvF", "fromHsl", "fromHslF",
            "fromCmyk", "fromCmykF", "fromString",
            "colorWhite", "colorBlack", "colorRed", "colorGreen", "colorBlue",
            "colorCyan", "colorMagenta", "colorYellow",
            "colorGray", "colorDarkGray", "colorLightGray", "colorTransparent"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагЦвет[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьRGB", "УстановитьRGBA", "УстановитьHSV", "УстановитьHSL", "УстановитьCMYK",
            "УстановитьИмяЦвета", "УстановитьRGBF", "УстановитьHSVF", "УстановитьHSLF",
            "Красный", "Зеленый", "Синий", "Альфа",
            "КрасныйF", "ЗеленыйF", "СинийF", "АльфаF",
            "Оттенок", "Насыщенность", "Яркость", "Светлота",
            "ОттенокF", "НасыщенностьF", "ЯркостьF", "СветлотаF",
            "Голубой", "Пурпурный", "Желтый", "Черный",
            "ГолубойF", "ПурпурныйF", "ЖелтыйF", "ЧерныйF",
            "Имя", "RGBA", "RGB",
            "ПолучитьRGB", "ПолучитьHSV", "ПолучитьHSL", "ПолучитьCMYK",
            "ВRGB", "ВHSV", "ВHSL", "ВCMYK",
            "Светлее", "Темнее", "Действителен",
            "САльфой", "САльфойF",
            "ПолучитьЦвет", "ИзQColor",
            "ИменаЦветов", "ИзRGB", "ИзRGBA", "ИзRGBF",
            "ИзHSV", "ИзHSVF", "ИзHSL", "ИзHSLF",
            "ИзCMYK", "ИзCMYKF", "ИзСтроки",
            "Белый", "ЧерныйЦвет", "КрасныйЦвет", "ЗеленыйЦвет", "СинийЦвет",
            "ГолубойЦвет", "ПурпурныйЦвет", "ЖелтыйЦвет",
            "Серый", "ТемноСерый", "СветлоСерый", "Прозрачный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагЦвет[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагЦвет.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагЦвет.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЦвет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtЦвет
// ============================================================

Функция ДиагностикаМетаОбъектаColor()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЦвет ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtColor: " + (typeof QtColor !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЦвет: " + (typeof QtЦвет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        цвет = НовыйОбъект("QtЦвет")
        Если цвет == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            цвет = new QtColor()
            Если цвет == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtColor()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtColor()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЦвет:")
    методы = Object.getOwnPropertyNames(цвет)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(цвет)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof цвет[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof цвет.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = цвет.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьRGB", "Красный", "Зеленый", "Синий",
        "Светлее", "Темнее", "Действителен"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof цвет[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = НовыйОбъект("QtБазовыйТаймер")
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtЦвет (русские и английские методы)
// ============================================================
Функция ТестQtColorFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        цвет = Новый QtЦвет()
        Если цвет != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЦвет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЦвет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если цвет == null Тогда
        Возврат "❌ Тест QtЦвет провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА RGB =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка RGB")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет.setRgb(255, 128, 64)
        r = цвет.red()
        g = цвет.green()
        b = цвет.blue()
        ВывестиСтрокуВКонсоль("    [ENG] setRgb: RGB(" + r + ", " + g + ", " + b + ") (ожидается 255, 128, 64)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И r == 255 И g == 128 И b == 64 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] RGB работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 255, 128, 64, получено " + r + ", " + g + ", " + b)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет.УстановитьRGB(64, 128, 255)
            rРус = цвет.Красный()
            gРус = цвет.Зеленый()
            bРус = цвет.Синий()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьRGB: RGB(" + rРус + ", " + gРус + ", " + bРус + ") (ожидается 64, 128, 255)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И rРус == 64 И gРус == 128 И bРус == 255 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] RGB работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 64, 128, 255, получено " + rРус + ", " + gРус + ", " + bРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. УСТАНОВКА ИМЕНИ ЦВЕТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка имени цвета")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет.setNamedColor("red")
        имя = цвет.name()
        r = цвет.red()
        g = цвет.green()
        b = цвет.blue()
        ВывестиСтрокуВКонсоль("    [ENG] setNamedColor: имя='" + имя + "', RGB(" + r + ", " + g + ", " + b + ")")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И имя == "#ff0000" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Имя цвета работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается #ff0000, получено " + имя)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет.УстановитьИмяЦвета("blue")
            имяРус = цвет.Имя()
            rРус = цвет.Красный()
            gРус = цвет.Зеленый()
            bРус = цвет.Синий()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьИмяЦвета: имя='" + имяРус + "', RGB(" + rРус + ", " + gРус + ", " + bРус + ")")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И имяРус == "#0000ff" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Имя цвета работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
