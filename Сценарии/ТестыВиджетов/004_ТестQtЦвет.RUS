    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет.setHsv(120, 255, 128)
        h = цвет.hue()
        s = цвет.saturation()
        v = цвет.value()
        ВывестиСтрокуВКонсоль("    [ENG] setHsv: HSV(" + h + ", " + s + ", " + v + ") (ожидается 120, 255, 128)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
