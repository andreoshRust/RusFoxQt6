    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет.УстановитьHSV(240, 255, 128)
            hРус = цвет.Оттенок()
            sРус = цвет.Насыщенность()
            vРус = цвет.Яркость()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьHSV: HSV(" + hРус + ", " + sРус + ", " + vРус + ") (ожидается 240, 255, 128)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
