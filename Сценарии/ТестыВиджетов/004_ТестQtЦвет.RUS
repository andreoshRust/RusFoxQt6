        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            цвет.УстановитьRGB(0, 0, 255)
            имяРус = цвет.Имя()
            имяРусФормат = цвет.ИмяСФорматом(2) // QColor::HexArgb
            ВывестиСтрокуВКонсоль("    [RUS] Имя: " + имяРус + ", ИмяСФорматом: " + имяРусФормат)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И имяРус == "#0000ff" Тогда
