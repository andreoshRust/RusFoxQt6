        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 5. СВЕТЛЕЕ/ТЕМНЕЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Светлее/Темнее")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        цвет.setRgb(128, 128, 128)
        светлый = цвет.lighter(150)
        темный = цвет.darker(200)
        
        // Проверяем, что объекты созданы
        Если светлый != null И темный != null Тогда
