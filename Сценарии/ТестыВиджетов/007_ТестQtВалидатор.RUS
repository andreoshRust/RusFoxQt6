//Что было создано и протестировано:
//1. Класс QtValidator (базовый валидатор)
//✅ Создание объекта
//✅ Проверка валидности (isValid/Действителен)
//✅ Получение реального валидатора (getRealValidator/ПолучитьВалидатор)
//✅ Валидация (validate/Проверить)
//✅ Исправление (fixup/Исправить, fixupString/ИсправитьСтроку)
//✅ Управление родителем (setParentWrapper/УстановитьРодителя, getParentWrapper/ПолучитьРодителя)
//✅ Имя объекта (setObjectName/УстановитьИмяОбъекта, objectName/ИмяОбъекта)
//✅ Отладка (setDebug/РежимОтладки, getDebug/ПолучитьРежимОтладки)
//✅ Копирование (copyTo/КопироватьВ)
//
//2. Класс QtIntValidator (валидатор целых чисел)
//✅ Установка диапазона (setRange/УстановитьДиапазон)
//✅ Установка минимума (setBottom/УстановитьМинимум)
//✅ Установка максимума (setTop/УстановитьМаксимум)
//✅ Получение минимума (bottom/Минимум)
//✅ Получение максимума (top/Максимум)
//
//3. Класс QtDoubleValidator (валидатор дробных чисел)
//✅ Установка диапазона (setRange/УстановитьДиапазон)
//✅ Установка минимума (setBottom/УстановитьМинимум)
//✅ Установка максимума (setTop/УстановитьМаксимум)
//✅ Установка десятичных знаков (setDecimals/УстановитьДесятичные)
//✅ Получение минимума (bottom/Минимум)
//✅ Получение максимума (top/Максимум)
//✅ Получение десятичных знаков (decimals/Десятичные)
//✅ Установка нотации (setNotation/УстановитьНотацию)
//✅ Получение нотации (notation/Нотация)
//
//4. Класс QtRegExpValidator (валидатор регулярных выражений)
//✅ Установка выражения (setRegularExpression/УстановитьВыражение)
//✅ Установка шаблона (setPattern/УстановитьШаблон)
//✅ Получение выражения (regularExpression/Выражение)
//✅ Получение шаблона (pattern/Шаблон)


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВалидаторЦелых
// ============================================================

// Константы состояния валидатора
Acceptable = 2
Intermediate = 1
Invalid = 0

Функция ДиагностикаМетодовQtIntValidator()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВалидаторЦелых ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtВалидаторЦелых: " + (typeof QtВалидаторЦелых !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtВалидаторЦелых: " + e)
    КонецПопытки;
    
    Попытка
        диагВалидатор = НовыйОбъект("QtВалидаторЦелых")
        Если диагВалидатор == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВалидаторЦелых не создан")
            Возврат
        КонецЕсли;
        
        диагВалидатор.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtВалидаторЦелых создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealValidator",
            "validate", "fixup", "fixupString",
            "setRange", "setBottom", "setTop", "bottom", "top",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВалидатор[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВалидатор",
            "Проверить", "Исправить", "ИсправитьСтроку",
            "УстановитьДиапазон", "УстановитьМинимум", "УстановитьМаксимум", "Минимум", "Максимум",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВалидатор[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагВалидатор.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагВалидатор.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВалидаторЦелых: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

