            // Для чисел в пределах диапазона - Acceptable (2)
            // Для чисел вне диапазона - Intermediate (1) или Invalid (0)
            // Для нечисловых строк - Invalid (0)
            Если результат1 == Acceptable И результат2 == Intermediate И результат3 == Invalid Тогда
                УстановитьЦветКонсоли("green")
