// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ ВСЕХ ВАЛИДАТОРОВ
// ============================================================

Функция ТестВсеВалидаторы()
    всегоТестов = 0
    успешноТестов = 0
    
    // Константы состояния валидатора
    Acceptable = 2
    Intermediate = 1
    Invalid = 0
    
    // ============================================================
    // ТЕСТ 1: ВАЛИДАТОР ЦЕЛЫХ ЧИСЕЛ
    // ============================================================
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТИРОВАНИЕ QtВалидаторЦелых                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // ===== 1.1 СОЗДАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1.1: Создание валидатора целых чисел")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаем через НовыйОбъект
        валидаторЦелых = НовыйОбъект("QtВалидаторЦелых")
        Если валидаторЦелых == null Тогда
            // Пробуем с параметрами
            валидаторЦелых = НовыйОбъект("QtВалидаторЦелых", 1, 100)
        КонецЕсли
        
        Если валидаторЦелых != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВалидаторЦелых создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВалидаторЦелых НЕ создан")
            СброситьЦветКонсоли()
            // Пропускаем остальные тесты для этого валидатора
            валидаторЦелых = null
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        валидаторЦелых = null
    КонецПопытки;
    
    Если валидаторЦелых != null Тогда
    
        // ===== 1.2 ПРОВЕРКА ДИАПАЗОНА =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 1.2: Проверка диапазона")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        // --- АНГЛИЙСКИЙ МЕТОД ---
        Попытка
            валидаторЦелых.setRange(10, 20)
            минимум = валидаторЦелых.bottom()
            максимум = валидаторЦелых.top()
            ВывестиСтрокуВКонсоль("    [ENG] setRange: минимум=" + минимум + ", максимум=" + максимум + " (ожидается 10, 20)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И минимум == 10 И максимум == 20 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Диапазон работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 10, 20, получено " + минимум + ", " + максимум)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторЦелых.УстановитьДиапазон(15, 25)
                минимумРус = валидаторЦелых.Минимум()
                максимумРус = валидаторЦелых.Максимум()
                ВывестиСтрокуВКонсоль("    [RUS] УстановитьДиапазон: минимум=" + минимумРус + ", максимум=" + максимумРус + " (ожидается 15, 25)")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И минимумРус == 15 И максимумРус == 25 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Диапазон работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            ИначеЕсли тестРусский Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 15, 25, получено " + минимумРус + ", " + максимумРус)
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
        // ===== 1.3 ПРОВЕРКА ВАЛИДАЦИИ =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 1.3: Проверка валидации целых чисел")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
