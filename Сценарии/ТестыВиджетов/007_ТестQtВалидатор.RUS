            ВывестиСтрокуВКонсоль("    [ENG] validate: 'Hello'=" + результат1 + ", 'Hello123'=" + результат2 + ", '123'=" + результат3)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И результат1 == Acceptable И результат2 == Invalid И результат3 == Invalid Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Валидация работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьШаблон("^[A-Za-z]+$")
                результатРус1 = валидаторРег.Проверить("Hello")
                результатРус2 = валидаторРег.Проверить("Hello123")
                результатРус3 = валидаторРег.Проверить("123")
                ВывестиСтрокуВКонсоль("    [RUS] Проверить: 'Hello'=" + результатРус1 + ", 'Hello123'=" + результатРус2 + ", '123'=" + результатРус3)
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И результатРус1 == Acceptable И результатРус2 == Invalid И результатРус3 == Invalid Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Валидация работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            ИначеЕсли тестРусский Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
        // ===== 3.5 ИСПРАВЛЕНИЕ =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 3.5: Исправление строки")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        // --- АНГЛИЙСКИЙ МЕТОД ---
        Попытка
            валидаторРег.setPattern("^[A-Za-z]+$")
            исправлено = валидаторРег.fixupString("Hello123")
            ВывестиСтрокуВКонсоль("    [ENG] fixupString: '" + исправлено + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Исправление работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьШаблон("^[A-Za-z]+$")
                исправленоРус = валидаторРег.ИсправитьСтроку("Hello456")
                ВывестиСтрокуВКонсоль("    [RUS] ИсправитьСтроку: '" + исправленоРус + "'")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Исправление работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
        // ===== 3.6 ИМЯ ОБЪЕКТА =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 3.6: Имя объекта")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        // --- АНГЛИЙСКИЙ МЕТОД ---
        Попытка
            валидаторРег.setObjectName("myRegexValidator")
            имя = валидаторРег.objectName()
            ВывестиСтрокуВКонсоль("    [ENG] setObjectName: '" + имя + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И имя == "myRegexValidator" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Имя объекта работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'myRegexValidator', получено '" + имя + "'")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьИмяОбъекта("русскийРегВыр")
                имяРус = валидаторРег.ИмяОбъекта()
                ВывестиСтрокуВКонсоль("    [RUS] УстановитьИмяОбъекта: '" + имяРус + "'")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И имяРус == "русскийРегВыр" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Имя объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            ИначеЕсли тестРусский Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'русскийРегВыр', получено '" + имяРус + "'")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
    КонецЕсли
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         ИТОГОВЫЙ ОТЧЁТ                                        │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно: " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                        │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно: " + успешноТестов + "                                                  │")
        СброситьЦветКонсоли()
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Неуспешно: " + (всегоТестов - успешноТестов) + "                                                │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест всех валидаторов завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ ВАЛИДАТОРОВ (QtValidator)                         ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtIntValidator()
    ДиагностикаМетодовQtDoubleValidator()
    ДиагностикаМетодовQtRegExpValidator()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТЫ ВАЛИДАТОРОВ (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестВсеВалидаторы()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте валидаторов: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

