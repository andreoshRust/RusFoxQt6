            шаблон = валидаторРег.pattern()
            ВывестиСтрокуВКонсоль("    [ENG] setPattern: '" + шаблон + "' (ожидается '^[0-9]+$')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И шаблон == "^[0-9]+$" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Шаблон работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается '^[0-9]+$', получено '" + шаблон + "'")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьШаблон("^[A-Za-z0-9]+$")
                шаблонРус = валидаторРег.Шаблон()
                ВывестиСтрокуВКонсоль("    [RUS] УстановитьШаблон: '" + шаблонРус + "' (ожидается '^[A-Za-z0-9]+$')")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И шаблонРус == "^[A-Za-z0-9]+$" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Шаблон работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            ИначеЕсли тестРусский Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается '^[A-Za-z0-9]+$', получено '" + шаблонРус + "'")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
        // ===== 3.3 ПРОВЕРКА ВАЛИДАЦИИ =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 3.3: Проверка валидации регулярных выражений")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        // --- АНГЛИЙСКИЙ МЕТОД ---
        Попытка
            валидаторРег.setPattern("^[A-Za-z]+$")
            результат1 = валидаторРег.validate("Hello")
            результат2 = валидаторРег.validate("Hello123")
            результат3 = валидаторРег.validate("123")
            ВывестиСтрокуВКонсоль("    [ENG] validate: 'Hello'=" + результат1 + ", 'Hello123'=" + результат2 + ", '123'=" + результат3)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден И результат1 == Acceptable И результат2 == Invalid И результат3 == Invalid Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Валидация работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьШаблон("^[A-Za-z]+$")
                результатРус1 = валидаторРег.Проверить("Hello")
                результатРус2 = валидаторРег.Проверить("Hello123")
                результатРус3 = валидаторРег.Проверить("123")
                ВывестиСтрокуВКонсоль("    [RUS] Проверить: 'Hello'=" + результатРус1 + ", 'Hello123'=" + результатРус2 + ", '123'=" + результатРус3)
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский И результатРус1 == Acceptable И результатРус2 == Invalid И результатРус3 == Invalid Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Валидация работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            ИначеЕсли тестРусский Тогда
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
        // ===== 3.4 ИСПРАВЛЕНИЕ =====
        всегоТестов = всегоТестов + 1
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("  Тест 3.4: Исправление строки")
        СброситьЦветКонсоли()
        
        тестПройден = ИСТИНА
        тестРусский = ИСТИНА
        
        // --- АНГЛИЙСКИЙ МЕТОД ---
        Попытка
            валидаторРег.setPattern("^[A-Za-z]+$")
            исправлено = валидаторРег.fixupString("Hello123")
            ВывестиСтрокуВКонсоль("    [ENG] fixupString: '" + исправлено + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        Если тестПройден Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Исправление работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
        
        // --- РУССКИЙ МЕТОД ---
        Если тестПройден Тогда
            Попытка
                валидаторРег.УстановитьШаблон("^[A-Za-z]+$")
                исправленоРус = валидаторРег.ИсправитьСтроку("Hello456")
                ВывестиСтрокуВКонсоль("    [RUS] ИсправитьСтроку: '" + исправленоРус + "'")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
            
            Если тестРусский Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Исправление работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        КонецЕсли
        
    КонецЕсли
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("")
        ВывестиСтрокуВКонсоль("✅ Тест всех валидаторов: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("")
        ВывестиСтрокуВКонсоль("✅ Тест всех валидаторов: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест всех валидаторов завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.12  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.12. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    //Отладка = ИСТИНА
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ ВАЛИДАТОРОВ (QtValidator)                         ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtIntValidator()
    ДиагностикаМетодовQtDoubleValidator()
    ДиагностикаМетодовQtRegExpValidator()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТЫ ВАЛИДАТОРОВ (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестВсеВалидаторы()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте валидаторов: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

