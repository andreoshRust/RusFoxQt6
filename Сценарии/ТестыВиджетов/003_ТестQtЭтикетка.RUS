//Тест проверяет 12 основных функций QtLabel:
//==========================================
//Создание объекта - проверка создания QtЭтикетка
//Текст - setText/text, УстановитьТекст/Текст
//Цвет - через setStyleSheet/styleSheet, УстановитьСтиль/Стиль
//Шрифт - setFontSize/setFontBold, УстановитьРазмерШрифта/УстановитьЖирныйШрифт
//Выравнивание - setAlignment/alignment, УстановитьВыравнивание/Выравнивание
//Перенос слов - setWordWrap/wordWrap, УстановитьПереносСлов/ПереносСлов
//Размер - setFixedSize/width/height, УстановитьФиксированныйРазмер/Ширина/Высота
//Видимость - setVisible/isVisible, УстановитьВидимость/Видим
//Подсказки - setToolTip/toolTip, УстановитьПодсказку/Подсказка
//Отступы - setMargin/margin, setIndent/indent, УстановитьОтступ/Отступ, УстановитьОтступСтроки/ОтступСтроки
//Стиль - setStyleSheet/styleSheet, УстановитьСтиль/Стиль
//Очистка - clear, Очистить


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЭтикетка
// ============================================================

Функция ДиагностикаМетодовQtLabel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЭтикетка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtЭтикетка: " + (typeof QtЭтикетка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЭтикетка: " + e)
    КонецПопытки;
    
    Попытка
        диагМетка = Новый QtЭтикетка()
        Если диагМетка == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЭтикетка не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtЭтикетка создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setText", "text", "clear",
            "setAlignment", "alignment", "setWordWrap", "wordWrap",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline", "setFontStrikeOut",
            "setColor", "color", "setBackgroundColor", "setStyleSheet", "styleSheet",
            "setPixmap", "pixmap", "setScaledContents", "scaledContents",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setMargin", "margin", "setIndent", "indent",
            "setOpenExternalLinks", "openExternalLinks",
            "setTextInteractionFlags", "textInteractionFlags",
            "setBuddy", "buddy",
            "setAccessibleName", "accessibleName", "setAccessibleDescription", "accessibleDescription"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМетка[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьТекст", "Текст", "Очистить",
            "УстановитьВыравнивание", "Выравнивание", "УстановитьПереносСлов", "ПереносСлов",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт", 
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт", "УстановитьЗачеркнутыйШрифт",
            "УстановитьЦвет", "Цвет", "УстановитьЦветФона", "УстановитьСтиль", "Стиль",
            "УстановитьКартинку", "Картинка", "УстановитьМасштабирование", "Масштабирование",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер", "МинимальныйРазмер", "МаксимальныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьОтступ", "Отступ", "УстановитьОтступСтроки", "ОтступСтроки",
            "УстановитьВнешниеСсылки", "ВнешниеСсылки",
            "УстановитьФлагиВзаимодействия", "ФлагиВзаимодействия",
            "УстановитьСвязанныйЭлемент", "СвязанныйЭлемент",
            "УстановитьИмяДоступности", "ИмяДоступности", "УстановитьОписаниеДоступности", "ОписаниеДоступности"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМетка[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМетка.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМетка.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЭтикетка: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЭтикетка
// ============================================================

Функция ДиагностикаМетаОбъектаLabel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЭтикетка ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtLabel: " + (typeof QtLabel !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЭтикетка: " + (typeof QtЭтикетка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        метка = НовыйОбъект("QtЭтикетка")
        Если метка == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            метка = new QtLabel()
            Если метка == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtLabel()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtLabel()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЭтикетка:")
    методы = Object.getOwnPropertyNames(метка)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(метка)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof метка[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof метка.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = метка.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьТекст", "Текст", "УстановитьЦвет",
        "УстановитьДоступность", "Доступен", "Видим"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof метка[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = НовыйОбъект("QtБазовыйТаймер")
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtЭтикетка (русские и английские методы)
// ============================================================
Функция ТестQtLabelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        метка = Новый QtЭтикетка()
        Если метка != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЭтикетка создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЭтикетка НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если метка == null Тогда
        Возврат "❌ Тест QtЭтикетка провален (объект не создан)"
    КонецЕсли

    // ===== 2. ТЕКСТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Текст")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        метка.setText("Test ENG")
        текст = метка.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText/text: '" + текст + "' (ожидается 'Test ENG')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == "Test ENG" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'Test ENG', получено '" + текст + "'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            метка.УстановитьТекст("Test RUS")
            текстРус = метка.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст/Текст: '" + текстРус + "' (ожидается 'Test RUS')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == "Test RUS" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Test RUS', получено '" + текстРус + "'")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ЦВЕТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Цвет")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        метка.setStyleSheet("color: red;")
        стиль = метка.styleSheet()
        ВывестиСтрокуВКонсоль("    [ENG] setStyleSheet (цвет): '" + стиль + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И стиль != "" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Цвет работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            метка.УстановитьСтиль("color: blue;")
            стильРус = метка.Стиль()
