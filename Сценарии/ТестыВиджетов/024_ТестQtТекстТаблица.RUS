// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстТаблица
// ============================================================

Функция ДиагностикаМетодовQtTextTable()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстТаблица ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстТаблица: " + (typeof QtТекстТаблица !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстТаблица: " + e)
    КонецПопытки;
    
    Попытка
        диагТаблица = Новый QtТекстТаблица()
        Если диагТаблица == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстТаблица не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtТекстТаблица создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "insertTable", "insertRows", "insertCols", "removeRows", "removeCols",
            "resizeTable", "mergeCells", "splitCell",
            "cellAt", "cellAtPosition", "rowCount", "colCount", "columnCount",
            "setFormatting", "setCellFormatting", "setCellBlockFormatting",
            "clearCellContent", "setCellText", "getCellText",
            "setBorderStyle", "setBorder", "setBorderColor",
            "setCellBorder", "setCellBorderColor",
            "setBackgroundColor", "setCellBackgroundColor",
            "setAlignment", "setCellAlignment",
            "setHeaderRowCount", "headerRowCount",
            "setCellPadding", "setCellSpacing", "setWidth", "setColumnWidth",
            "cursorAtCell", "cursorAtPosition",
            "isValid", "getTable", "setCursor", "cursor"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаблица[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ВставитьТаблицу", "ВставитьСтроки", "ВставитьКолонки", "УдалитьСтроки", "УдалитьКолонки",
            "ИзменитьРазмер", "ОбъединитьЯчейки", "РазделитьЯчейку",
            "Ячейка", "ЯчейкаПозиции", "Строк", "Колонок",
            "УстановитьФормат", "УстановитьФорматЯчейки", "УстановитьФорматБлокаЯчейки",
            "ОчиститьЯчейку", "УстановитьТекстЯчейки", "ТекстЯчейки",
            "УстановитьСтильГраницы", "УстановитьГраницу", "УстановитьЦветГраницы",
            "УстановитьГраницуЯчейки", "УстановитьЦветГраницыЯчейки",
            "УстановитьЦветФона", "УстановитьЦветФонаЯчейки",
            "УстановитьВыравнивание", "УстановитьВыравниваниеЯчейки",
            "УстановитьСтрокиЗаголовка", "СтрокиЗаголовка",
            "УстановитьОтступЯчейки", "УстановитьРасстояниеЯчейки", "УстановитьШирину", "УстановитьШиринуКолонки",
            "КурсорЯчейки", "КурсорПозиции",
            "Действителен", "ПолучитьТаблицу", "УстановитьКурсор", "Курсор"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаблица[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаблица.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаблица.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстТаблица: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстТаблица
// ============================================================

Функция ДиагностикаМетаОбъектаTextTable()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстТаблица ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextTable: " + (typeof QtTextTable !== 'undefined'))
        Попытка
            ВывестиСтрокуВКонсоль("Проверка QtТекстТаблица: " + (typeof QtТекстТаблица !== 'undefined'))
        Исключение
        КонецПопытки;
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        таблица = НовыйОбъект("QtТекстТаблица")
        Если таблица == null Тогда
            таблица = new QtTextTable()
            Если таблица == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtTextTable()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстТаблица:")
    методы = Object.getOwnPropertyNames(таблица)
    прототип = Object.getPrototypeOf(таблица)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof таблица[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof таблица.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = таблица.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtТекстТаблица
// ============================================================

Функция ТестQtTextTableFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    таблица = null
    Попытка
        таблица = Новый QtТекстТаблица()
        Если таблица != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстТаблица создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстТаблица НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если таблица == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности (isValid)")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = таблица.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается false - таблица не вставлена)")
        Если валидный == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 3. СОЗДАНИЕ ТАБЛИЦЫ С КУРСОРОМ =====
Попытка
    // Создаем таблицу через конструктор с курсором-оберткой
    таблица = Новый QtТекстТаблица(курсор, 3, 3)
    
    Если таблица != null И таблица.Действителен() Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Таблица 3x3 создана")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Таблица НЕ создана")
        СброситьЦветКонсоли()
    КонецЕсли
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    СброситьЦветКонсоли()
КонецПопытки

    // ===== 4. РАЗМЕР ТАБЛИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Получение количества строк и колонок")
    СброситьЦветКонсоли()
    
    Попытка
        // Проверяем наличие методов
        имеетСтрок = typeof таблица.Строк === 'function'
        имеетКолонок = typeof таблица.Колонок === 'function'
        
        Если имеетСтрок И имеетКолонок Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Методы Строк и Колонок существуют")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Методы Строк или Колонок НЕ СУЩЕСТВУЮТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. УСТАНОВКА ГРАНИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Установка границы")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьГраницу === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьГраницу существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьГраницу НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. УСТАНОВКА ЦВЕТА ГРАНИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Установка цвета границы")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьЦветГраницы === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьЦветГраницы существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьЦветГраницы НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. УСТАНОВКА ЦВЕТА ФОНА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Установка цвета фона")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьЦветФона === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьЦветФона существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьЦветФона НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. УСТАНОВКА ВЫРАВНИВАНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Установка выравнивания")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьВыравнивание === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьВыравнивание существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьВыравнивание НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. УСТАНОВКА СТРОК ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Установка строк заголовка")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьСтрокиЗаголовка === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьСтрокиЗаголовка существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьСтрокиЗаголовка НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. УСТАНОВКА ОТСТУПА ЯЧЕЙКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Установка отступа ячейки")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьОтступЯчейки === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьОтступЯчейки существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьОтступЯчейки НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. УСТАНОВКА ШИРИНЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Установка ширины")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.УстановитьШирину === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод УстановитьШирину существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод УстановитьШирину НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ОБЪЕДИНЕНИЕ ЯЧЕЕК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Объединение ячеек")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.ОбъединитьЯчейки === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод ОбъединитьЯчейки существует")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод ОбъединитьЯчейки НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. МЕТОД RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таблица.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Метод RusFunc существует")
            СброситьЦветКонсоли()
            
            Попытка
                jsonStr = таблица.RusFunc()
                карта = JSON.parse(jsonStr)
                Если карта.length > 0 Тогда
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                    СброситьЦветКонсоли()
                    успешноТестов = успешноТестов + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                    СброситьЦветКонсоли()
                КонецЕсли
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка при вызове RusFunc: " + e)
                СброситьЦветКонсоли()
            КонецПопытки
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                       │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                       │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстТаблица завершён"
КонецФункции

// ============================================================
// РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица (QtTextTable)
// ============================================================

Функция ТестРеальнойРаботыQtTextTable()
    ВывестиСтрокуВКонсоль("=== РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица ===")
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ДОКУМЕНТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание документа")
    СброситьЦветКонсоли()
    
    документ = null
    Попытка
        документ = Новый QtТекстовыйДокумент()
        Если документ != null Тогда
            документ.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Документ создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Документ НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если документ == null Тогда
        Возврат "❌ Реальный тест провален (документ не создан)"
    КонецЕсли
    
    // ===== 2. ПОЛУЧЕНИЕ РЕАЛЬНОГО КУРСОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Получение реального курсора")
    СброситьЦветКонсоли()
    
    реальныйКурсор = null
    Попытка
        реальныйКурсор = документ.ПолучитьКурсор()
        Если реальныйКурсор != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Реальный курсор получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Реальный курсор НЕ получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если реальныйКурсор == null Тогда
        Возврат "❌ Реальный тест провален (реальный курсор не получен)"
    КонецЕсли
    
    // ===== 3. СОЗДАНИЕ ОБЕРТКИ КУРСОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Создание обертки курсора")
    СброситьЦветКонсоли()
    
    курсорОбертка = null
    Попытка
        курсорОбертка = Новый QtТекстовыйКурсор(реальныйКурсор)
        Если курсорОбертка != null Тогда
            курсорОбертка.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Обертка курсора создана")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Обертка курсора НЕ создана")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если курсорОбертка == null Тогда
        Возврат "❌ Реальный тест провален (обертка курсора не создана)"
    КонецЕсли
    
// ===== 4. СОЗДАНИЕ ТАБЛИЦЫ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Создание таблицы")
СброситьЦветКонсоли()

таблица = null
Попытка
    // Создаем таблицу
    таблица = Новый QtТекстТаблица()
    Если таблица != null Тогда
        таблица.РежимОтладки(ИСТИНА)
        
        // Устанавливаем курсор (передаем обертку)
        таблица.УстановитьКурсор(курсорОбертка)
        
        // Вставляем таблицу
        таблица.ВставитьТаблицу(3, 3)
        
        Если таблица.Действителен() Тогда
            стр = таблица.Строк()
            кол = таблица.Колонок()
            ВывестиСтрокуВКонсоль("    [RUS] Размер таблицы: " + стр + "x" + кол)
            
            Если стр == 3 И кол == 3 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Таблица 3x3 создана")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Неправильный размер: " + стр + "x" + кол)
                СброситьЦветКонсоли()
                Возврат "❌ Реальный тест провален (неправильный размер)"
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Таблица НЕ валидна")
            СброситьЦветКонсоли()
            Возврат "❌ Реальный тест провален (таблица не валидна)"
        КонецЕсли
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Таблица НЕ создана")
        СброситьЦветКонсоли()
        Возврат "❌ Реальный тест провален (таблица не создана)"
    КонецЕсли
    
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    СброситьЦветКонсоли()
    Возврат "❌ Реальный тест провален (ошибка создания таблицы)"
КонецПопытки

    
    // ===== 5. УСТАНОВКА ТЕКСТА В ЯЧЕЙКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Установка текста в ячейки")
    СброситьЦветКонсоли()
    
    Попытка
        таблица.УстановитьТекстЯчейки(0, 0, "Ячейка 1,1")
        таблица.УстановитьТекстЯчейки(0, 1, "Ячейка 1,2")
        таблица.УстановитьТекстЯчейки(0, 2, "Ячейка 1,3")
        таблица.УстановитьТекстЯчейки(1, 0, "Ячейка 2,1")
        таблица.УстановитьТекстЯчейки(1, 1, "Ячейка 2,2")
        таблица.УстановитьТекстЯчейки(1, 2, "Ячейка 2,3")
        таблица.УстановитьТекстЯчейки(2, 0, "Ячейка 3,1")
        таблица.УстановитьТекстЯчейки(2, 1, "Ячейка 3,2")
        таблица.УстановитьТекстЯчейки(2, 2, "Ячейка 3,3")
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст установлен во все ячейки")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== 6. ЧТЕНИЕ ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Чтение текста из ячейки")
    СброситьЦветКонсоли()
    
    Попытка
        текст = таблица.ТекстЯчейки(0, 0)
        ВывестиСтрокуВКонсоль("    [RUS] Текст ячейки (0,0): '" + текст + "' (ожидается 'Ячейка 1,1')")
        Если текст == "Ячейка 1,1" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Чтение текста работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Ячейка 1,1'")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== 7. ПРОВЕРКА РАЗМЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка размера таблицы")
    СброситьЦветКонсоли()
    
    Попытка
        строк = таблица.Строк()
        колонок = таблица.Колонок()
        ВывестиСтрокуВКонсоль("    [RUS] Размер: " + строк + "x" + колонок + " (ожидается 3x3)")
        Если строк == 3 И колонок == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Размер таблицы корректный")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3x3")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                   РЕЗУЛЬТАТЫ РЕАЛЬНОГО ТЕСТА                                │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                      │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                   │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Реальный тест QtТекстТаблица завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.12 Тогда 
        ПоказатьСообщение("Данный сценарий работает с версии 2.12. Ваша версия: " + НомерВерсииПрограммы)
        Возврат    
    КонецЕсли
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtТекстТаблица (QtTextTable)                       ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Диагностика
    ДиагностикаМетодовQtTextTable()
    ДиагностикаМетаОбъектаTextTable()
    
    // Стандартный тест
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtТекстТаблица (русские и английские методы)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTextTableFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtТекстТаблица: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Реальный тест с документом
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ РЕАЛЬНЫЙ ТЕСТ QtТекстТаблица (с QtТекстовыйДокумент)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = ТестРеальнойРаботыQtTextTable()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в реальном тесте: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // Завершение
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ
