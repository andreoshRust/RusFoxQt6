// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВыпадающийСписок
// ============================================================

Функция ДиагностикаМетодовQtComboBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВыпадающийСписок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtВыпадающийСписок: " + (typeof QtВыпадающийСписок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtВыпадающийСписок: " + e)
    КонецПопытки;
    
    Попытка
        диагСписок = Новый QtВыпадающийСписок()
        Если диагСписок == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВыпадающийСписок не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtВыпадающийСписок создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "addItem", "addItems", "insertItem", "insertItems", "removeItem", "clear", "count",
            "itemText", "setItemText", "itemData", "setItemData",
            "currentIndex", "setCurrentIndex", "currentText", "setCurrentText", "currentData",
            "findText", "findData",
            "isEditable", "setEditable", "editText", "setEditText",
            "maxCount", "setMaxCount", "maxVisibleItems", "setMaxVisibleItems",
            "hasFrame", "setFrame",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "isValid", "getWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСписок[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ДобавитьЭлемент", "ДобавитьЭлементСДанными", "ДобавитьЭлементы",
            "ВставитьЭлемент", "ВставитьЭлементСДанными", "ВставитьЭлементы",
            "УдалитьЭлемент", "Очистить", "Количество",
            "ТекстЭлемента", "УстановитьТекстЭлемента", "ДанныеЭлемента", "УстановитьДанныеЭлемента",
            "ТекущийИндекс", "УстановитьТекущийИндекс", "ТекущийТекст", "УстановитьТекущийТекст", "ТекущиеДанные",
            "НайтиТекст", "НайтиДанные",
            "Редактируемый", "УстановитьРедактируемый", "ТекстРедактирования", "УстановитьТекстРедактирования",
            "МаксимумЭлементов", "УстановитьМаксимумЭлементов",
            "МаксимумВидимых", "УстановитьМаксимумВидимых",
            "ЕстьРамка", "УстановитьРамку",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьСтиль", "Стиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьФокус", "ЕстьФокус",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСписок[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСписок.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСписок.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВыпадающийСписок: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВыпадающийСписок
// ============================================================

Функция ДиагностикаМетаОбъектаComboBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtВыпадающийСписок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtComboBox: " + (typeof QtComboBox !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtВыпадающийСписок: " + (typeof QtВыпадающийСписок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        список = НовыйОбъект("QtВыпадающийСписок")
        Если список == null Тогда
            список = new QtComboBox()
            Если список == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtComboBox()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtВыпадающийСписок:")
    методы = Object.getOwnPropertyNames(список)
    прототип = Object.getPrototypeOf(список)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof список[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof список.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = список.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ТЕСТ QtВыпадающийСписок
// ============================================================

Функция ТестQtComboBoxFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    список = null
    Попытка
        список = Новый QtВыпадающийСписок()
        Если список != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВыпадающийСписок создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВыпадающийСписок НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если список == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = список.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    КонецПопытки

// ===== 3. ДОБАВЛЕНИЕ ЭЛЕМЕНТОВ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Добавление элементов")
СброситьЦветКонсоли()

Попытка
    // Создаем новый список для чистоты теста
    списокТест = Новый QtВыпадающийСписок()
    списокТест.ДобавитьЭлемент("Элемент 1")
    списокТест.ДобавитьЭлемент("Элемент 2")
    списокТест.ДобавитьЭлемент("Элемент 3")
    списокТест.ДобавитьЭлементы(["Элемент 4", "Элемент 5"])
    количество = списокТест.Количество()
    ВывестиСтрокуВКонсоль("    [RUS] Количество элементов: " + количество + " (ожидается 5)")
    Если количество == 5 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Добавление элементов работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 5, получено " + количество)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки

// ===== 4. ВСТАВКА ЭЛЕМЕНТА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Вставка элемента")
СброситьЦветКонсоли()

Попытка
    списокТест.ВставитьЭлемент(2, "Вставленный")
    текст = списокТест.ТекстЭлемента(2)
    количество = списокТест.Количество()
    ВывестиСтрокуВКонсоль("    [RUS] Элемент[2]='" + текст + "', количество=" + количество)
    Если текст == "Вставленный" И количество == 6 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Вставка элемента работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки

// ===== 5. ВЫБОР ЭЛЕМЕНТА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Выбор элемента")
СброситьЦветКонсоли()

Попытка
    списокТест.УстановитьТекущийИндекс(3)
    индекс = списокТест.ТекущийИндекс()
    текст = списокТест.ТекущийТекст()
    ВывестиСтрокуВКонсоль("    [RUS] Индекс=" + индекс + ", Текст='" + текст + "'")
    Если индекс == 3 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Выбор элемента работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3, получено " + индекс)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки

// ===== 6. ПОИСК =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 6: Поиск")
СброситьЦветКонсоли()

Попытка
    // После вставки: [0]="Элемент 1", [1]="Элемент 2", [2]="Вставленный", [3]="Элемент 3", [4]="Элемент 4", [5]="Элемент 5"
    индекс = списокТест.НайтиТекст("Элемент 5")
    ВывестиСтрокуВКонсоль("    [RUS] НайтиТекст('Элемент 5') = " + индекс + " (ожидается 5)")
    Если индекс == 5 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Поиск работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 5, получено " + индекс)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки

// ===== 7. УДАЛЕНИЕ ЭЛЕМЕНТА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 7: Удаление элемента")
СброситьЦветКонсоли()

Попытка
    списокТест.УдалитьЭлемент(2)
    количество = списокТест.Количество()
    ВывестиСтрокуВКонсоль("    [RUS] После удаления: количество=" + количество + " (ожидается 5)")
    Если количество == 5 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Удаление элемента работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 5, получено " + количество)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки


// ===== 8. ОЧИСТКА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 8: Очистка")
СброситьЦветКонсоли()

Попытка
    списокТест.Очистить()
    количество = списокТест.Количество()
    ВывестиСтрокуВКонсоль("    [RUS] После очистки: количество=" + количество + " (ожидается 0)")
    Если количество == 0 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Очистка работает")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0, получено " + количество)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки
    // ===== 9. РЕДАКТИРУЕМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Редактируемость")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьРедактируемый(ИСТИНА)
        редактируемый = список.Редактируемый()
        список.УстановитьРедактируемый(ЛОЖЬ)
        редактируемый2 = список.Редактируемый()
        ВывестиСтрокуВКонсоль("    [RUS] Редактируемый: true->" + редактируемый + ", false->" + редактируемый2)
        Если редактируемый == ИСТИНА И редактируемый2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Редактируемость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true -> false")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 10. МАКСИМУМ ЭЛЕМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Максимум элементов")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьМаксимумЭлементов(20)
        максимум = список.МаксимумЭлементов()
        ВывестиСтрокуВКонсоль("    [RUS] МаксимумЭлементов: " + максимум + " (ожидается 20)")
        Если максимум == 20 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Максимум элементов работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 20, получено " + максимум)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 11. РАМКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Рамка")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьРамку(ЛОЖЬ)
        рамка = список.ЕстьРамка()
        список.УстановитьРамку(ИСТИНА)
        рамка2 = список.ЕстьРамка()
        ВывестиСтрокуВКонсоль("    [RUS] Рамка: false->" + рамка + ", true->" + рамка2)
        Если рамка == ЛОЖЬ И рамка2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Рамка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 12. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьДоступность(ЛОЖЬ)
        доступен = список.Доступен()
        список.УстановитьДоступность(ИСТИНА)
        доступен2 = список.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 13. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьВидимость(ЛОЖЬ)
        видим = список.Видим()
        список.УстановитьВидимость(ИСТИНА)
        видим2 = список.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 14. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьПодсказку("Тест подсказка")
        подсказка = список.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тест подсказка')")
        Если подсказка == "Тест подсказка" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест подсказка'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 15. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        список.УстановитьСтиль("color: red;")
        стиль = список.Стиль()
        ВывестиСтрокуВКонсоль("    [RUS] Стиль: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'red'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 16. СИГНАЛ (пропущен) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Сигналы (пропущен)")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("    ⚠️ Тест пропущен - проверка сигналов не поддерживается")
    ВывестиСтрокуВКонсоль("    ✓ [RUS] Тест пропущен (не критично)")
    успешноТестов = успешноТестов + 1

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtВыпадающийСписок: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtВыпадающийСписок: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtВыпадающийСписок завершён"
КонецФункции

// ============================================================
