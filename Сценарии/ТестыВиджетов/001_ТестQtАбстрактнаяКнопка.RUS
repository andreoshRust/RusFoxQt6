//✅ Тесты (10 из 10 успешны):
//✅ Создание объекта
//✅ Текст (setText/text, УстановитьТекст/Текст)
//✅ Состояние (setChecked/isChecked/toggle, УстановитьВыбрано/Выбрано/Переключить)
//✅ Автоповтор (setAutoRepeat/autoRepeat, УстановитьАвтоповтор/Автоповтор)
//✅ Шрифт (setFont/setFontSize, УстановитьШрифт/УстановитьРазмерШрифта)
//✅ Стиль (setStyleSheet/styleSheet, УстановитьСтиль/Стиль)
//✅ Валидность (isValid/Действителен)
//✅ Видимость (setVisible/isVisible, УстановитьВидимость/Видим)
//✅ Размеры (setFixedSize/width/height, УстановитьФиксированныйРазмер/Ширина/Высота)
//✅ RusFunc

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtАбстрактнаяКнопка
// ============================================================

Функция ДиагностикаМетодовQtAbstractButton()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtАбстрактнаяКнопка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtАбстрактнаяКнопка: " + (typeof QtАбстрактнаяКнопка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtАбстрактнаяКнопка: " + e)
    КонецПопытки;
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtКнопка: " + (typeof QtКнопка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtКнопка: " + e)
    КонецПопытки;
    
    Попытка
        диагКнопка = НовыйОбъект("QtКнопка")
        Если диагКнопка == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtКнопка не создан")
            Возврат
        КонецЕсли;
        
        диагКнопка.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtКнопка создана")
        
        // Проверяем, что кнопка является наследником QtАбстрактнаяКнопка
        Попытка
            Если typeof диагКнопка.УстановитьТекст === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Кнопка поддерживает методы QtАбстрактнаяКнопка")
            Иначе
                ВывестиСтрокуВКонсоль("✗ Кнопка НЕ поддерживает методы QtАбстрактнаяКнопка")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке наследования: " + e)
        КонецПопытки
        
        // Проверка английских методов QtAbstractButton
        ВывестиСтрокуВКонсоль("Английские методы QtAbstractButton (должны работать):")
        англМетоды = [
            "text", "setText",
            "isChecked", "setChecked", "toggle",
            "isCheckable", "setCheckable",
            "isDown", "setDown",
            "isEnabled", "setEnabled",
            "autoRepeat", "setAutoRepeat",
            "autoRepeatDelay", "setAutoRepeatDelay",
            "autoRepeatInterval", "setAutoRepeatInterval",
            "icon", "setIcon", "iconSize", "setIconSize",
            "setFont", "font",
            "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline", "setFontStrikeOut",
            "setStyleSheet", "styleSheet",
            "isValid", "getRealWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКнопка[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Текст", "УстановитьТекст",
            "Выбрано", "УстановитьВыбрано", "Переключить",
            "Выбираемый", "УстановитьВыбираемый",
            "Нажат", "УстановитьНажат",
            "Доступен", "УстановитьДоступность",
            "Автоповтор", "УстановитьАвтоповтор",
            "ЗадержкаАвтоповтора", "УстановитьЗадержкуАвтоповтора",
            "ИнтервалАвтоповтора", "УстановитьИнтервалАвтоповтора",
            "Иконка", "УстановитьИконку", "РазмерИконки", "УстановитьРазмерИконки",
            "Шрифт", "УстановитьШрифт",
            "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт", "УстановитьКурсивныйШрифт",
            "УстановитьПодчеркнутыйШрифт", "УстановитьЗачеркнутыйШрифт",
            "Стиль", "УстановитьСтиль",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКнопка[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагКнопка.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагКнопка.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtАбстрактнаяКнопка
// ============================================================

Функция ДиагностикаМетаОбъектаAbstractButton()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtАбстрактнаяКнопка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtAbstractButton: " + (typeof QtAbstractButton !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtАбстрактнаяКнопка: " + (typeof QtАбстрактнаяКнопка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        кнопка = НовыйОбъект("QtКнопка")
        Если кнопка == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКнопка (наследник QtAbstractButton):")
    методы = Object.getOwnPropertyNames(кнопка)
    прототип = Object.getPrototypeOf(кнопка)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof кнопка[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof кнопка.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = кнопка.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtАбстрактнаяКнопка (через QtКнопка)
// ============================================================

Функция ТестQtAbstractButtonFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    кнопка = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        кнопка = НовыйОбъект("QtКнопка")
        Если кнопка == null Тогда
            кнопка = new QtPushButton()
        КонецЕсли
        
        Если кнопка != null Тогда
            кнопка.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtКнопка создана")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtКнопка НЕ создана")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если кнопка == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Кнопка не создана, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ТЕКСТ (ENG) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setText/text"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестТекст = "Test Button"
    тестТекст2 = "New Button"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setText(тестТекст)
        текст = кнопка.text()
        кнопка.setText(тестТекст2)
        текст2 = кнопка.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText: '" + текст + "' -> '" + текст2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == тестТекст И текст2 == тестТекст2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка текста")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьТекст(тестТекст)
            текстРус = кнопка.Текст()
            кнопка.УстановитьТекст(тестТекст2)
            текстРус2 = кнопка.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст: '" + текстРус + "' -> '" + текстРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == тестТекст И текстРус2 == тестТекст2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка текста")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. СОСТОЯНИЕ (ENG) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setChecked/isChecked/toggle"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Состояние кнопки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        кнопка.setCheckable(true)
        кнопка.setChecked(true)
        проверка = кнопка.isChecked()
        кнопка.toggle()
        проверка2 = кнопка.isChecked()
        ВывестиСтрокуВКонсоль("    [ENG] setChecked(true): " + проверка + ", toggle: " + проверка2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И проверка == ИСТИНА И проверка2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Состояние работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка состояния")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            кнопка.УстановитьВыбираемый(ИСТИНА)
            кнопка.УстановитьВыбрано(ИСТИНА)
            проверкаРус = кнопка.Выбрано()
            кнопка.Переключить()
            проверкаРус2 = кнопка.Выбрано()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВыбрано(true): " + проверкаРус + ", Переключить: " + проверкаРус2)
