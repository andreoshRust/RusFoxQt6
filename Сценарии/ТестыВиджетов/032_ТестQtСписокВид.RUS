//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность    isValid    Действителен    ✅
//3    Установка потока    setFlow    УстановитьПоток    ✅
//4    Установка интервала    setSpacing    УстановитьИнтервал    ✅
//5    Установка размера сетки    setGridWidth/setGridHeight    УстановитьШиринуСетки/УстановитьВысотуСетки    ✅
//6    Установка размера иконок    setIconWidth/setIconHeight    УстановитьШиринуИконок/УстановитьВысотуИконок    ✅
//7    Перенос слов    setWordWrap    УстановитьПереносСлов    ✅
//8    Единый размер элементов    setUniformItemSizes    УстановитьЕдиныйРазмерЭлементов    ✅
//9    Константы    LeftToRight, TopToBottom, Fixed, Adjust, SinglePass, Batched    СлеваНаправо, СверхуВниз, Фиксированный, Подгонять, Однократный, Пакетный    ✅
//10    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//11    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//12    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//13    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//14    Получение реального виджета    getRealWidget    ПолучитьОбъект    ✅
//15    Очистка    clear    Очистить    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtListView
// ============================================================

Функция ДиагностикаМетодовQtListView()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtListView ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtListView: " + (typeof QtListView !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtListView: " + e)
    КонецПопытки;
    
    Попытка
        диагListView = НовыйОбъект("QtСписокВид")
        Если диагListView == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtСписокВид не создан")
            Возврат
        КонецЕсли;
        
        диагListView.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtСписокВид создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "setFlow", "flow",
            "setResizeMode", "resizeMode",
            "setLayoutMode", "layoutMode",
            "setSpacing", "spacing",
            "setGridWidth", "gridWidth", "setGridHeight", "gridHeight", "gridSize",
            "setIconWidth", "iconWidth", "setIconHeight", "iconHeight", "iconSize",
            "setWordWrap", "wordWrap",
            "setSelectionRectVisible", "isSelectionRectVisible",
            "setUniformItemSizes", "uniformItemSizes",
            "setBatchSize", "batchSize",
            "isWrapping",
            "clear",
            "LeftToRight", "TopToBottom",
            "Fixed", "Adjust",
            "SinglePass", "Batched",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагListView[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "УстановитьПоток", "Поток",
            "УстановитьРежимИзмененияРазмера", "РежимИзмененияРазмера",
            "УстановитьРежимКомпоновки", "РежимКомпоновки",
            "УстановитьИнтервал", "Интервал",
            "УстановитьШиринуСетки", "ШиринаСетки", "УстановитьВысотуСетки", "ВысотаСетки", "РазмерСетки",
            "УстановитьШиринуИконок", "ШиринаИконок", "УстановитьВысотуИконок", "ВысотаИконок", "РазмерИконок",
            "УстановитьПереносСлов", "ПереносСлов",
            "УстановитьВидимостьПрямоугольникаВыделения", "ВидимостьПрямоугольникаВыделения",
            "УстановитьЕдиныйРазмерЭлементов", "ЕдиныйРазмерЭлементов",
            "УстановитьРазмерПакета", "РазмерПакета",
            "Обертывание",
            "Очистить",
            "СлеваНаправо", "СверхуВниз",
            "Фиксированный", "Подгонять",
            "Однократный", "Пакетный",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагListView[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагListView.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагListView.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtСписокВид: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtListView (QtСписокВид)
// ============================================================

Функция ТестQtListViewFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    listView = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        listView = НовыйОбъект("QtСписокВид")
        Если listView == null Тогда
            listView = new QtListView()
        КонецЕсли
        
        Если listView != null Тогда
            listView.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtСписокВид создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtСписокВид НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если listView == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ ListView не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = listView.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = listView.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА ПОТОКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setFlow/УстановитьПоток"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка потока")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        listView.setFlow(listView.TopToBottom())
        поток = listView.flow()
        listView.setFlow(listView.LeftToRight())
        поток2 = listView.flow()
        ВывестиСтрокуВКонсоль("    [ENG] setFlow: " + поток + " -> " + поток2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка потока работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка установки потока")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            listView.УстановитьПоток(listView.СверхуВниз())
            потокРус = listView.Поток()
            listView.УстановитьПоток(listView.СлеваНаправо())
            потокРус2 = listView.Поток()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПоток: " + потокРус + " -> " + потокРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка потока работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка установки потока")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. УСТАНОВКА ИНТЕРВАЛА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setSpacing/УстановитьИнтервал"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка интервала")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        listView.setSpacing(10)
        интервал = listView.spacing()
        listView.setSpacing(5)
        интервал2 = listView.spacing()
        ВывестиСтрокуВКонсоль("    [ENG] setSpacing: 10->" + интервал + ", 5->" + интервал2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И интервал == 10 И интервал2 == 5 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка интервала работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка установки интервала")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            listView.УстановитьИнтервал(20)
            интервалРус = listView.Интервал()
            listView.УстановитьИнтервал(15)
            интервалРус2 = listView.Интервал()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьИнтервал: 20->" + интервалРус + ", 15->" + интервалРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
