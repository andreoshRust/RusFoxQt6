        Если текущийТекст != "Hello" Тогда
            ВывестиСтрокуВКонсоль("    [ENG] ВНИМАНИЕ: текст не совпадает! Пробуем русский метод")
            редактор.УстановитьТекст("Hello")
            текущийТекст = редактор.Текст()
