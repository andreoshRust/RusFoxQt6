//Тест проверяет 12 основных функций QtLineEdit:
//==============================================
//Создание объекта - проверка создания QtРедакторСтроки
//Текст - setText/text, УстановитьТекст/Текст
//Заполнитель - setPlaceholderText/placeholderText, УстановитьЗаполнитель/Заполнитель
//Режим ввода - setEchoMode/echoMode, УстановитьРежимВвода/РежимВвода
//Только чтение - setReadOnly/isReadOnly, УстановитьТолькоЧтение/ТолькоЧтение
//Максимальная длина - setMaxLength/maxLength, УстановитьМаксимальнуюДлину/МаксимальнаяДлина
//Выделение - selectAll/deselect/selectedText, ВыбратьВсе/СнятьВыделение/ВыделенныйТекст
//Курсор - setCursorPosition/cursorPosition, УстановитьПозициюКурсора/ПозицияКурсора
//Вставка - insert, Вставить
//Кнопка очистки - setClearButtonEnabled/isClearButtonEnabled, УстановитьКнопкуОчистки/КнопкаОчистки
//Очистка - clear, Очистить
//Видимость - setVisible/isVisible, УстановитьВидимость/Видим
//


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtРедакторСтроки
// ============================================================

Функция ДиагностикаМетодовQtLineEdit()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtРедакторСтроки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtРедакторСтроки: " + (typeof QtРедакторСтроки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtРедакторСтроки: " + e)
    КонецПопытки;
    
    Попытка
        диагРедактор = Новый QtРедакторСтроки()
        Если диагРедактор == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtРедакторСтроки не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtРедакторСтроки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setText", "text", "clear", "insert",
            "setPlaceholderText", "placeholderText",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setColor", "color", "setBackgroundColor", "setStyleSheet", "styleSheet",
            "setAlignment", "alignment",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setEchoMode", "echoMode", "setReadOnly", "isReadOnly",
            "setMaxLength", "maxLength", "setCursorPosition", "cursorPosition",
            "home", "end", "backspace", "del",
            "selectAll", "deselect", "selectedText", "hasSelectedText",
            "setSelection", "selectionStart", "selectionEnd",
            "setValidator", "validator", "hasAcceptableInput",
            "setCompleter", "completer",
            "setInputMask", "inputMask",
            "setDragEnabled", "dragEnabled",
            "setClearButtonEnabled", "isClearButtonEnabled",
            "setAccessibleName", "accessibleName",
            "setAccessibleDescription", "accessibleDescription"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРедактор[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьТекст", "Текст", "Очистить", "Вставить",
            "УстановитьЗаполнитель", "Заполнитель",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьЦвет", "Цвет", "УстановитьЦветФона", "УстановитьСтиль", "Стиль",
            "УстановитьВыравнивание", "Выравнивание",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер", "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим",
            "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьРежимВвода", "РежимВвода", "УстановитьТолькоЧтение", "ТолькоЧтение",
            "УстановитьМаксимальнуюДлину", "МаксимальнаяДлина",
            "УстановитьПозициюКурсора", "ПозицияКурсора",
            "ВНачало", "ВКонец", "Backspace", "Delete",
            "ВыбратьВсе", "СнятьВыделение", "ВыделенныйТекст", "ЕстьВыделение",
            "УстановитьВыделение", "НачалоВыделения", "КонецВыделения",
            "УстановитьВалидатор", "Валидатор", "ДопустимыйВвод",
            "УстановитьАвтодополнение", "Автодополнение",
            "УстановитьМаскуВвода", "МаскаВвода",
            "УстановитьDrag", "Drag",
            "УстановитьКнопкуОчистки", "КнопкаОчистки",
            "УстановитьИмяДоступности", "ИмяДоступности",
            "УстановитьОписаниеДоступности", "ОписаниеДоступности"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРедактор[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагРедактор.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагРедактор.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtРедакторСтроки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtРедакторСтроки
// ============================================================

Функция ДиагностикаМетаОбъектаLineEdit()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtРедакторСтроки ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtLineEdit: " + (typeof QtLineEdit !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtРедакторСтроки: " + (typeof QtРедакторСтроки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        редактор = НовыйОбъект("QtРедакторСтроки")
        Если редактор == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            редактор = new QtLineEdit()
            Если редактор == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtLineEdit()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtLineEdit()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtРедакторСтроки:")
    методы = Object.getOwnPropertyNames(редактор)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(редактор)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof редактор[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof редактор.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = редактор.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьТекст", "Текст", "УстановитьЦвет",
        "УстановитьДоступность", "Доступен", "Видим"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof редактор[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = НовыйОбъект("QtБазовыйТаймер")
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtРедакторСтроки (русские и английские методы)
// ============================================================
Функция ТестQtLineEditFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        редактор = Новый QtРедакторСтроки()
        Если редактор != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtРедакторСтроки создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtРедакторСтроки НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если редактор == null Тогда
        Возврат "❌ Тест QtРедакторСтроки провален (объект не создан)"
    КонецЕсли

    // ===== 2. ТЕКСТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Текст")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        редактор.setText("Test ENG")
        текст = редактор.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText/text: '" + текст + "' (ожидается 'Test ENG')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == "Test ENG" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'Test ENG', получено '" + текст + "'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            редактор.УстановитьТекст("Test RUS")
            текстРус = редактор.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст/Текст: '" + текстРус + "' (ожидается 'Test RUS')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == "Test RUS" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Test RUS', получено '" + текстРус + "'")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ЗАПОЛНИТЕЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Заполнитель")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    тестЗаполнитель = "Введите текст..."
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        редактор.setPlaceholderText(тестЗаполнитель)
        заполнитель = редактор.placeholderText()
        ВывестиСтрокуВКонсоль("    [ENG] setPlaceholderText: '" + заполнитель + "' (ожидается '" + тестЗаполнитель + "')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
