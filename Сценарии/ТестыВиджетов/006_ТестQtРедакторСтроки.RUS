            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            текст = редактор.text()
            ВывестиСтрокуВКонсоль("    [ENG] текст='" + текст + "' (ожидается 'Hello World')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка text: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
    КонецЕсли
    
    Если тестПройден И текст == "Hello World" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Вставка работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'Hello World', получено '" + текст + "'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            редактор.УстановитьМаксимальнуюДлину(32767)
            редактор.УстановитьТолькоЧтение(ЛОЖЬ)
            редактор.УстановитьРежимВвода(0)
            редактор.УстановитьМаскуВвода("")
            редактор.УстановитьВалидатор(null)
            редактор.Очистить()
            
            редактор.УстановитьТекст("Привет")
            текущийТекстРус = редактор.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] После УстановитьТекст: текст='" + текущийТекстРус + "'")
            
            редактор.УстановитьПозициюКурсора(6)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПозициюКурсора(6) выполнен")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            Попытка
                редактор.Вставить(" Мир")
                ВывестиСтрокуВКонсоль("    [RUS] Вставить(' Мир') выполнен")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка Вставить: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
        КонецЕсли
        
        Если тестРусский Тогда
            Попытка
                текстРус = редактор.Текст()
                ВывестиСтрокуВКонсоль("    [RUS] текст='" + текстРус + "' (ожидается 'Привет Мир')")
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка Текст: " + e)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецПопытки
        КонецЕсли
        
        Если тестРусский И текстРус == "Привет Мир" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Вставка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Привет Мир', получено '" + текстРус + "'")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    // ===== 10. КНОПКА ОЧИСТКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Кнопка очистки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        редактор.setClearButtonEnabled(true)
        кнопкаОчистки = редактор.isClearButtonEnabled()
        редактор.setClearButtonEnabled(false)
        кнопкаОчистки2 = редактор.isClearButtonEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setClearButtonEnabled: true->" + кнопкаОчистки + ", false->" + кнопкаОчистки2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И кнопкаОчистки == ИСТИНА И кнопкаОчистки2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Кнопка очистки работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true -> false")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            редактор.УстановитьКнопкуОчистки(ИСТИНА)
            кнопкаОчисткиРус = редактор.КнопкаОчистки()
            редактор.УстановитьКнопкуОчистки(ЛОЖЬ)
            кнопкаОчисткиРус2 = редактор.КнопкаОчистки()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьКнопкуОчистки: true->" + кнопкаОчисткиРус + ", false->" + кнопкаОчисткиРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И кнопкаОчисткиРус == ИСТИНА И кнопкаОчисткиРус2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Кнопка очистки работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
