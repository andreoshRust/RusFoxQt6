//№    Тест    Описание
//1    Создание объекта    Проверка создания QtРедакторСтроки
//2    Текст    setText/text, УстановитьТекст/Текст
//3    Заполнитель    setPlaceholderText/placeholderText, УстановитьТекстПодсказки/ТекстПодсказки
//4    Режим ввода    setEchoMode/echoMode, УстановитьРежимВвода/РежимВвода
//5    Только чтение    setReadOnly/isReadOnly, УстановитьТолькоЧтение/ТолькоЧтение
//6    Максимальная длина    setMaxLength/maxLength, УстановитьМаксимальнуюДлину/МаксимальнаяДлина
//7    Выделение    selectAll/deselect/selectedText, ВыделитьВсе/СнятьВыделение/ВыделенныйТекст
//8    Курсор    setCursorPosition/cursorPosition, УстановитьПозициюКурсора/ПозицияКурсора
//9    Вставка    insert, Вставить
//10    Кнопка очистки    setClearButtonEnabled/isClearButtonEnabled, УстановитьКнопкуОчистки/КнопкаОчистки
//11    Очистка    clear, Очистить
//12    Видимость    setVisible/isVisible, УстановитьВидимость/Видим

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtРедакторСтроки
// ============================================================

Функция ДиагностикаМетодовQtLineEdit()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtРедакторСтроки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtРедакторСтроки: " + (typeof QtРедакторСтроки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtРедакторСтроки: " + e)
    КонецПопытки;
    
    Попытка
        диагРедактор = НовыйОбъект("QtРедакторСтроки")
        Если диагРедактор == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtРедакторСтроки не создан")
            Возврат
        КонецЕсли;
        
        диагРедактор.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtРедакторСтроки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setText", "text", "clear", "insert",
            "setPlaceholderText", "placeholderText",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setColor", "color", "setBackgroundColor", "setStyleSheet", "styleSheet",
            "setAlignment", "alignment",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setEchoMode", "echoMode", "setReadOnly", "isReadOnly",
            "setMaxLength", "maxLength", "setCursorPosition", "cursorPosition",
            "home", "end", "backspace", "del",
            "selectAll", "deselect", "selectedText", "hasSelectedText",
            "setSelection", "selectionStart", "selectionEnd",
            "setValidator", "validator", "hasAcceptableInput",
            "setCompleter", "completer",
            "setInputMask", "inputMask",
            "setDragEnabled", "dragEnabled",
            "setClearButtonEnabled", "isClearButtonEnabled",
            "isValid", "getRealWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРедактор[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьТекст", "Текст", "Очистить", "Вставить",
            "УстановитьТекстПодсказки", "ТекстПодсказки",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьЦвет", "Цвет", "УстановитьЦветФона", "УстановитьСтиль", "Стиль",
            "УстановитьВыравнивание", "Выравнивание",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер", "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим",
            "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьРежимВвода", "РежимВвода", "УстановитьТолькоЧтение", "ТолькоЧтение",
            "УстановитьМаксимальнуюДлину", "МаксимальнаяДлина",
            "УстановитьПозициюКурсора", "ПозицияКурсора",
            "Домой", "Конец", "Backspace", "Удалить",
            "ВыделитьВсе", "СнятьВыделение", "ВыделенныйТекст", "ЕстьВыделение",
            "УстановитьВыделение", "НачалоВыделения", "КонецВыделения",
            "УстановитьВалидатор", "Валидатор", "ЕстьДопустимыйВвод",
            "УстановитьДополнитель", "Дополнитель",
            "УстановитьМаскуВвода", "МаскаВвода",
            "УстановитьПеретаскивание", "Перетаскивание",
            "УстановитьКнопкуОчистки", "КнопкаОчистки",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагРедактор[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагРедактор.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагРедактор.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtРедакторСтроки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtРедакторСтроки
// ============================================================

Функция ДиагностикаМетаОбъектаLineEdit()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtРедакторСтроки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtLineEdit: " + (typeof QtLineEdit !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtРедакторСтроки: " + (typeof QtРедакторСтроки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        редактор = НовыйОбъект("QtРедакторСтроки")
        Если редактор == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtРедакторСтроки:")
    методы = Object.getOwnPropertyNames(редактор)
    прототип = Object.getPrototypeOf(редактор)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof редактор[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof редактор.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = редактор.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьТекст", "Текст", "УстановитьЦвет",
        "УстановитьДоступность", "Доступен", "Видим"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof редактор[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtРедакторСтроки (QtLineEdit)
// ============================================================

Функция ТестQtLineEditFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    редактор = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        редактор = НовыйОбъект("QtРедакторСтроки")
        Если редактор == null Тогда
            редактор = new QtLineEdit()
        КонецЕсли
        
        Если редактор != null Тогда
            редактор.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtРедакторСтроки создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtРедакторСтроки НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если редактор == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Редактор не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ТЕКСТ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setText/text"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Текст")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестТекст = "Test ENG"
    тестТекст2 = "New ENG"
    тестТекстРус = "Test RUS"
    тестТекстРус2 = "New RUS"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        редактор.setText(тестТекст)
        текст = редактор.text()
        редактор.setText(тестТекст2)
        текст2 = редактор.text()
        ВывестиСтрокуВКонсоль("    [ENG] setText: '" + текст + "' -> '" + текст2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И текст == тестТекст И текст2 == тестТекст2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Текст работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка текста")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            редактор.УстановитьТекст(тестТекстРус)
            текстРус = редактор.Текст()
            редактор.УстановитьТекст(тестТекстРус2)
            текстРус2 = редактор.Текст()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТекст: '" + текстРус + "' -> '" + текстРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И текстРус == тестТекстРус И текстРус2 == тестТекстРус2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Текст работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка текста")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. ТЕКСТ ПОДСКАЗКИ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setPlaceholderText/placeholderText"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Текст подсказки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестПодсказка = "Enter text..."
    тестПодсказкаРус = "Введите текст..."
    
