    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            реалРус = скролл.ПолучитьРеальныйВиджет()
            ВывестиСтрокуВКонсоль("    [RUS] ПолучитьРеальныйВиджет: " + (реалРус != null ? "успешно" : "неудачно"))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И реалРус != null Тогда
