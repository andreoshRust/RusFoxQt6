// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtScrollArea
// ============================================================

Функция ДиагностикаМетодовQtScrollArea()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtScrollArea ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtScrollArea: " + (typeof QtScrollArea !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtScrollArea: " + e)
    КонецПопытки;
    
    Попытка
        диагScroll = НовыйОбъект("QtОбластьПрокрутки")
        Если диагScroll == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtОбластьПрокрутки не создан")
            Возврат
        КонецЕсли;
        
        диагScroll.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtОбластьПрокрутки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setScrollWidget", "widget", "takeWidget",
            "widgetResizable", "setWidgetResizable",
            "ensureVisible", "ensureWidgetVisible",
            "horizontalScrollBarPolicy", "setHorizontalScrollBarPolicy",
            "verticalScrollBarPolicy", "setVerticalScrollBarPolicy",
            "horizontalScrollBar", "verticalScrollBar",
            "setHorizontalScrollBar", "setVerticalScrollBar",
            "ScrollBarAsNeeded", "ScrollBarAlwaysOff", "ScrollBarAlwaysOn",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагScroll[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов (из RusFunc)
        ВывестиСтрокуВКонсоль("Русские методы (из RusFunc):")
        русМетоды = [
            // QtObject
            "Действителен", "ПолучитьОбъект", "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта", "УстановитьСвойство", "Свойство",
            "ПодключитьСигнал", "ОтключитьСигнал", "КопироватьВ",
            "РежимОтладки", "ПолучитьРежимОтладки",
            
            // QtWidget
            "УстановитьРодителя", "ПолучитьРодителя", "УстановитьВидимость", "Видим",
            "Показать", "Скрыть", "Поднять", "Опустить",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер", "УстановитьМинимальныйРазмер",
            "УстановитьМаксимальныйРазмер", "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьИмяДоступности", "ИмяДоступности",
            "УстановитьОписаниеДоступности", "ОписаниеДоступности",
            "ПолучитьРеальныйВиджет", "УстановитьШрифт", "Шрифт",
            
            // QtFrame
            "УстановитьСтильРамки", "СтильРамки",
            "УстановитьФормуРамки", "ФормаРамки",
            "УстановитьТеньРамки", "ТеньРамки",
            "УстановитьШиринуЛинии", "ШиринаЛинии",
            "УстановитьСреднююШирину", "СредняяШирина",
            "ШиринаРамки", "Видимость",
            "НетРамки", "Коробка", "Панель", "ПанельОкна",
            "ГоризонтальнаяЛиния", "ВертикальнаяЛиния", "СтилизованнаяПанель",
            "Плоская", "Выпуклая", "Вогнутая",
            
            // QtScrollArea
            "УстановитьВиджет", "Виджет", "ЗабратьВиджет",
            "УстановитьВиджетПрокрутки", "ВиджетИзменяем",
            "УстановитьИзменяемостьВиджета",
            "ПоказатьОбласть", "ПоказатьВиджет",
            "ПолитикаГоризонтальнойПолосы", "УстановитьПолитикуГоризонтальнойПолосы",
            "ПолитикаВертикальнойПолосы", "УстановитьПолитикуВертикальнойПолосы",
            "ГоризонтальнаяПолоса", "ВертикальнаяПолоса",
            "УстановитьГоризонтальнуюПолосу", "УстановитьВертикальнуюПолосу",
            "ПолосаПриНеобходимости", "ПолосаВсегдаВыключена", "ПолосаВсегдаВключена"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагScroll[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtОбластьПрокрутки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtScrollArea (QtОбластьПрокрутки) - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtScrollAreaFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    скролл = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        скролл = НовыйОбъект("QtОбластьПрокрутки")
        Если скролл == null Тогда
            скролл = new QtScrollArea()
        КонецЕсли
        
        Если скролл != null Тогда
            скролл.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtОбластьПрокрутки создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtОбластьПрокрутки НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если скролл == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ ScrollArea не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = скролл.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = скролл.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА ВИДЖЕТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setScrollWidget/УстановитьВиджетПрокрутки"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка виджета")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестовыйВиджет = null
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестовыйВиджет = НовыйОбъект("QtВиджет")
        реалВиджет = тестовыйВиджет.ПолучитьРеальныйВиджет()
        скролл.setScrollWidget(реалВиджет)
        полученный = скролл.widget()
        ВывестиСтрокуВКонсоль("    [ENG] setScrollWidget: " + (полученный != null ? "успешно" : "неудачно"))
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И полученный != null Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка виджета работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка установки виджета")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестовыйВиджет2 = НовыйОбъект("QtВиджет")
            реалВиджет2 = тестовыйВиджет2.ПолучитьРеальныйВиджет()
            скролл.УстановитьВиджетПрокрутки(реалВиджет2)
            полученныйРус = скролл.Виджет()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВиджетПрокрутки: " + (полученныйРус != null ? "успешно" : "неудачно"))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И полученныйРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка виджета работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка установки виджета")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. ИЗМЕНЯЕМОСТЬ ВИДЖЕТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "widgetResizable/setWidgetResizable"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Изменяемость виджета")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        скролл.setWidgetResizable(ИСТИНА)
        изменяем = скролл.widgetResizable()
        скролл.setWidgetResizable(ЛОЖЬ)
        изменяем2 = скролл.widgetResizable()
        ВывестиСтрокуВКонсоль("    [ENG] setWidgetResizable: true->" + изменяем + ", false->" + изменяем2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И изменяем == ИСТИНА И изменяем2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Изменяемость работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка изменяемости")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            скролл.УстановитьИзменяемостьВиджета(ИСТИНА)
            изменяемРус = скролл.ВиджетИзменяем()
            скролл.УстановитьИзменяемостьВиджета(ЛОЖЬ)
            изменяемРус2 = скролл.ВиджетИзменяем()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьИзменяемостьВиджета: true->" + изменяемРус + ", false->" + изменяемРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И изменяемРус == ИСТИНА И изменяемРус2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Изменяемость работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка изменяемости")
            СброситьЦветКонсоли()
