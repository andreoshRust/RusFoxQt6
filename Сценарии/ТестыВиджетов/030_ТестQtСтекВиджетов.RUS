        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            нужноПриРус = скролл.ПолосаПриНеобходимости()
            всегдВыклРус = скролл.ПолосаВсегдаВыключена()
            всегдВклРус = скролл.ПолосаВсегдаВключена()
