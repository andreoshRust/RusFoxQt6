        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьСостояние(2) // Checked
            состояниеРус = флажок.Состояние()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСостояние/Состояние: " + состояниеРус + " (ожидается 2)")
            Если состояниеРус == 2 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Состояние работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 2, получено " + состояниеРус)
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 8. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Доступность")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок.setEnabled(false)
        доступен = флажок.isEnabled()
        флажок.setEnabled(true)
        доступен2 = флажок.isEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setEnabled: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Доступность работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false -> true")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьДоступность(ЛОЖЬ)
            доступенРус = флажок.Доступен()
            флажок.УстановитьДоступность(ИСТИНА)
            доступенРус2 = флажок.Доступен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступность: false->" + доступенРус + ", true->" + доступенРус2)
            Если доступенРус == ЛОЖЬ И доступенРус2 == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 9. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Видимость")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок.setVisible(false)
        видим = флажок.isVisible()
        флажок.setVisible(true)
        видим2 = флажок.isVisible()
        ВывестиСтрокуВКонсоль("    [ENG] setVisible: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Видимость работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false -> true")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьВидимость(ЛОЖЬ)
            видимРус = флажок.Видим()
            флажок.УстановитьВидимость(ИСТИНА)
            видимРус2 = флажок.Видим()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВидимость: false->" + видимРус + ", true->" + видимРус2)
            Если видимРус == ЛОЖЬ И видимРус2 == ИСТИНА Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 10. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Подсказка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок.setToolTip("ToolTip Test")
        подсказка = флажок.toolTip()
        ВывестиСтрокуВКонсоль("    [ENG] setToolTip/toolTip: '" + подсказка + "' (ожидается 'ToolTip Test')")
        Если подсказка == "ToolTip Test" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Подсказка работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'ToolTip Test', получено '" + подсказка + "'")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьПодсказку("Тест Подсказка")
            подсказкаРус = флажок.Подсказка()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПодсказку/Подсказка: '" + подсказкаРус + "' (ожидается 'Тест Подсказка')")
            Если подсказкаРус == "Тест Подсказка" Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест Подсказка', получено '" + подсказкаРус + "'")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 11. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Стиль")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок.setStyleSheet("color: red;")
        стиль = флажок.styleSheet()
        ВывестиСтрокуВКонсоль("    [ENG] setStyleSheet/styleSheet: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: стиль не содержит 'red'")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьСтиль("color: blue;")
            стильРус = флажок.Стиль()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтиль/Стиль: '" + стильРус + "'")
            Если стильРус.indexOf("blue") >= 0 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'blue'")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 12. СОЗДАНИЕ С ТЕКСТОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Создание с текстом")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок2 = Новый QtCheckBox("Created with text")
        Если флажок2 != null Тогда
            текст2 = флажок2.text()
            ВывестиСтрокуВКонсоль("    [ENG] текст: '" + текст2 + "' (ожидается 'Created with text')")
            Если текст2 == "Created with text" Тогда
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Создание с текстом работает")
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 'Created with text', получено '" + текст2 + "'")
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Объект не создан")
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок2Рус = Новый QtФлажок("Создан с текстом")
            Если флажок2Рус != null Тогда
                текст2Рус = флажок2Рус.Текст()
                ВывестиСтрокуВКонсоль("    [RUS] Текст: '" + текст2Рус + "' (ожидается 'Создан с текстом')")
                Если текст2Рус == "Создан с текстом" Тогда
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с текстом работает")
                    успешноТестов = успешноТестов + 1
                Иначе
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Создан с текстом', получено '" + текст2Рус + "'")
                КонецЕсли
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Объект не создан")
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtФлажок: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtФлажок: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtФлажок завершён"
КонецФункции

