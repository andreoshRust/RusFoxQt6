        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        Попытка
            флажок.УстановитьТройноеСостояние(ЛОЖЬ)
            тройноеРус = флажок.ТройноеСостояние()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьТройноеСостояние/ТройноеСостояние: " + тройноеРус + " (ожидается false)")
            Если тройноеРус == ЛОЖЬ Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Тройное состояние работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false, получено " + тройноеРус)
            КонецЕсли
        Исключение
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 7. СОСТОЯНИЕ (checkState) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Состояние (checkState)")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    Попытка
        флажок.setTristate(true)
        флажок.setCheckState(1) // PartiallyChecked
        состояние = флажок.checkState()
        ВывестиСтрокуВКонсоль("    [ENG] setCheckState/checkState: " + состояние + " (ожидается 1)")
        Если состояние == 1 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] checkState работает")
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 1, получено " + состояние)
