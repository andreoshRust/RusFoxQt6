// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtГруппБокс
// ============================================================

Функция ДиагностикаМетодовQtGroupBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtГруппБокс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtГруппБокс: " + (typeof QtГруппБокс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtГруппБокс: " + e)
    КонецПопытки;
    
    Попытка
        диагГруппа = Новый QtГруппБокс()
        Если диагГруппа == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtГруппБокс не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtГруппБокс создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "title", "setTitle",
            "alignment", "setAlignment",
            "isCheckable", "setCheckable", "isChecked", "setChecked",
            "isFlat", "setFlat",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "isValid", "getWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагГруппа[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Заголовок", "УстановитьЗаголовок",
            "Выравнивание", "УстановитьВыравнивание",
            "ЕстьЧекбокс", "УстановитьЧекбокс", "Выбран", "УстановитьВыбран",
            "Плоский", "УстановитьПлоский",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьСтиль", "Стиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьФокус", "ЕстьФокус",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагГруппа[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагГруппа.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагГруппа.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtГруппБокс: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtГруппБокс
// ============================================================

Функция ДиагностикаМетаОбъектаGroupBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtГруппБокс ===")
    
    Функция Вложенная()
    
      Возврат  3
    КонецФункции
    
     Функция Вложенная2()
    
      Возврат  3
    КонецФункции    
       
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtGroupBox: " + (typeof QtGroupBox !== 'undefined'))
        Попытка
          
           ВывестиСтрокуВКонсоль("Проверка QtГруппБокс: " + (typeof QtГруппБокс !== 'undefined'))
        Исключение
        КонецПопытки;
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        группа = НовыйОбъект("QtГруппБокс")
        Если группа == null Тогда
            группа = new QtGroupBox()
            Если группа == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtGroupBox()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtГруппБокс:")
    методы = Object.getOwnPropertyNames(группа)
    прототип = Object.getPrototypeOf(группа)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof группа[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof группа.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = группа.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ТЕСТ QtГруппБокс
// ============================================================

Функция ТестQtGroupBoxFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    группа = null
    Попытка
        группа = Новый QtГруппБокс()
        Если группа != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtГруппБокс создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtГруппБокс НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если группа == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = группа.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    КонецПопытки

    // ===== 3. ЗАГОЛОВОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Заголовок")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьЗаголовок("Тестовая группа")
        заголовок = группа.Заголовок()
        ВывестиСтрокуВКонсоль("    [RUS] Заголовок: '" + заголовок + "' (ожидается 'Тестовая группа')")
        Если заголовок == "Тестовая группа" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тестовая группа'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 4. ВЫРАВНИВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Выравнивание")
    СброситьЦветКонсоли()
    
    Попытка
        AlignCenter = 0x0004
        группа.УстановитьВыравнивание(AlignCenter)
        выравнивание = группа.Выравнивание()
        ВывестиСтрокуВКонсоль("    [RUS] Выравнивание: " + выравнивание + " (ожидается " + AlignCenter + ")")
        Если выравнивание == AlignCenter Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Выравнивание работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается " + AlignCenter)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 5. ЧЕКБОКС РЕЖИМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Чекбокс режим")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьЧекбокс(ИСТИНА)
        естьЧекбокс = группа.ЕстьЧекбокс()
        группа.УстановитьВыбран(ИСТИНА)
        выбран = группа.Выбран()
        группа.УстановитьВыбран(ЛОЖЬ)
        выбран2 = группа.Выбран()
        ВывестиСтрокуВКонсоль("    [RUS] ЕстьЧекбокс=" + естьЧекбокс + ", Выбран: true->" + выбран + ", false->" + выбран2)
        Если естьЧекбокс == ИСТИНА И выбран == ИСТИНА И выбран2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Чекбокс режим работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 6. ПЛОСКИЙ ВИД =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Плоский вид")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьПлоский(ИСТИНА)
        плоский = группа.Плоский()
        группа.УстановитьПлоский(ЛОЖЬ)
        плоский2 = группа.Плоский()
        ВывестиСтрокуВКонсоль("    [RUS] Плоский: true->" + плоский + ", false->" + плоский2)
        Если плоский == ИСТИНА И плоский2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Плоский вид работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true -> false")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 7. СОЗДАНИЕ С ЗАГОЛОВКОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Создание с заголовком")
    СброситьЦветКонсоли()
    
    Попытка
        группа2 = Новый QtГруппБокс("Группа с заголовком")
        Если группа2 != null Тогда
            заголовок2 = группа2.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] Заголовок: '" + заголовок2 + "' (ожидается 'Группа с заголовком')")
            Если заголовок2 == "Группа с заголовком" Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с заголовком работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Группа с заголовком'")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Объект не создан")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 8. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьДоступность(ЛОЖЬ)
        доступен = группа.Доступен()
        группа.УстановитьДоступность(ИСТИНА)
        доступен2 = группа.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 9. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьВидимость(ЛОЖЬ)
        видим = группа.Видим()
        группа.УстановитьВидимость(ИСТИНА)
        видим2 = группа.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 10. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьПодсказку("Тест подсказка")
        подсказка = группа.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тест подсказка')")
        Если подсказка == "Тест подсказка" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест подсказка'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 11. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        группа.УстановитьСтиль("color: red;")
        стиль = группа.Стиль()
        ВывестиСтрокуВКонсоль("    [RUS] Стиль: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'red'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 12. СИГНАЛ (пропущен) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Сигналы (пропущен)")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("    ⚠️ Тест пропущен - проверка сигналов не поддерживается")
    ВывестиСтрокуВКонсоль("    ✓ [RUS] Тест пропущен (не критично)")
    успешноТестов = успешноТестов + 1

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtГруппБокс: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtГруппБокс: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtГруппБокс завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.12 Тогда 
        ПоказатьСообщение("Данный сценарий работает с версии 2.12. Ваша версия: " + НомерВерсииПрограммы)
        Возврат    
    КонецЕсли
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtГруппБокс (QtGroupBox)                         ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ДиагностикаМетодовQtGroupBox()
    ДиагностикаМетаОбъектаGroupBox()
    
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtГруппБокс (русские и английские методы)                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtGroupBoxFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtГруппБокс: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

