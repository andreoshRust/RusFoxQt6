//✅ QtTreeWidget (QtДеревоЭлементов) - 11/11 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка колонок и заголовков    ✅
//3    Добавление корневых элементов    ✅
//4    Получение корневого элемента    ✅
//5    Разворачивание и сворачивание    ✅
//6    Удаление элемента    ✅
//7    Очистка    ✅
//8    Сортировка    ✅
//9    Внешний вид    ✅
//10    Проверка валидности    ✅
//11    Имя объекта    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДеревоЭлементов
// ============================================================

Функция ДиагностикаМетодовQtTreeWidget()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДеревоЭлементов ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДеревоЭлементов: " + (typeof QtДеревоЭлементов !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДеревоЭлементов: " + e)
    КонецПопытки;
    
    Попытка
        диагДерево = НовыйОбъект("QtДеревоЭлементов")
        Если диагДерево == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДеревоЭлементов не создан")
            Возврат
        КонецЕсли;
        
        диагДерево.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДеревоЭлементов создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setColumnCount", "columnCount",
            "setHeaderLabels", "setHeaderItem", "headerText",
            "setHeaderHidden", "isHeaderHidden",
            "addTopLevelItem", "addTopLevelItems", "insertTopLevelItem",
            "takeTopLevelItem", "removeTopLevelItem", "topLevelItemCount",
            "topLevelItem", "currentItem", "setCurrentItem",
            "indexOfTopLevelItem",
            "selectedItems", "clearSelection",
            "expandAll", "collapseAll", "expandItem", "collapseItem",
            "clear",
            "sortItems", "setSortingEnabled", "isSortingEnabled",
            "setAlternatingRowColors", "alternatingRowColors",
            "setIndentation", "indentation",
            "setAnimated", "isAnimated",
            "setItemsExpandable", "areItemsExpandable",
            "setExpandsOnDoubleClick", "expandsOnDoubleClick",
            "setSelectionMode", "selectionMode",
            "setEditTriggers", "editTriggers",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДерево[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьКоличествоКолонок", "КоличествоКолонок",
            "УстановитьЗаголовки", "УстановитьЗаголовок", "ТекстЗаголовка",
            "СкрытьЗаголовок", "ЗаголовокСкрыт",
            "ДобавитьКорневойЭлемент", "ДобавитьКорневыеЭлементы", "ВставитьКорневойЭлемент",
            "ИзвлечьКорневойЭлемент", "УдалитьКорневойЭлемент", "КоличествоКорневыхЭлементов",
            "КорневойЭлемент", "ТекущийЭлемент", "УстановитьТекущийЭлемент",
            "ИндексКорневогоЭлемента",
            "ВыделенныеЭлементы", "СнятьВыделение",
            "РазвернутьВсе", "СвернутьВсе", "РазвернутьЭлемент", "СвернутьЭлемент",
            "Очистить",
            "Сортировать", "ВключитьСортировку", "СортировкаВключена",
            "ЧередоватьЦветаСтрок", "ЧередованиеЦветов",
            "УстановитьОтступ", "Отступ",
            "Анимация", "АнимацияВключена",
            "ЭлементыРаскрываемы", "Раскрываемы",
            "РаскрыватьПоДвойномуКлику", "РаскрыватьПоДвойномуКликуВключено",
            "УстановитьРежимВыделения", "РежимВыделения",
            "УстановитьТриггерыПравки", "ТриггерыПравки",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДерево[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДерево.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДерево.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДеревоЭлементов: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДеревоЭлементов
// ============================================================

Функция ТестQtTreeWidget()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    дерево = null
    Попытка
        дерево = НовыйОбъект("QtДеревоЭлементов")
        Если дерево == null Тогда
            дерево = new QtTreeWidget()
        КонецЕсли
        
        Если дерево != null Тогда
            дерево.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДеревоЭлементов создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДеревоЭлементов НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если дерево == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Дерево не создано, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА КОЛОНОК И ЗАГОЛОВКОВ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setColumnCount/setHeaderLabels"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка колонок и заголовков")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        дерево.setColumnCount(3)
        дерево.setHeaderLabels(["Название", "Тип", "Размер"])
        колонок = дерево.columnCount()
        заголовок = дерево.headerText(0)
        ВывестиСтрокуВКонсоль("    [ENG] setColumnCount(3), setHeaderLabels: columns=" + колонок + ", header[0]='" + заголовок + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И колонок == 3 И заголовок == "Название" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Колонки и заголовки работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается columns=3, header='Название'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            дерево.УстановитьКоличествоКолонок(2)
            дерево.УстановитьЗаголовки(["Имя", "Значение"])
            колонокРус = дерево.КоличествоКолонок()
            заголовокРус = дерево.ТекстЗаголовка(0)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьКоличествоКолонок(2), УстановитьЗаголовки: columns=" + колонокРус + ", header[0]='" + заголовокРус + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И колонокРус == 2 И заголовокРус == "Имя" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Колонки и заголовки работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается columns=2, header='Имя'")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
// ===== 3. ДОБАВЛЕНИЕ КОРНЕВЫХ ЭЛЕМЕНТОВ =====
всегоТестов = всегоТестов + 1
названияТестов[названияТестов.length] = "addTopLevelItem"
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Добавление корневых элементов")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Пробуем создать элементы разными способами
Попытка
    элемент1 = null
    элемент2 = null
    
    // Способ 1: через НовыйОбъект
    Попытка
        элемент1 = НовыйОбъект("QtЭлементДерева")
    Исключение
        элемент1 = null
    КонецПопытки
    
    Если элемент1 == null Тогда
        // Способ 2: через New с русским именем
        Попытка
            элемент1 = new QtЭлементДерева()
        Исключение
            элемент1 = null
        КонецПопытки
    КонецЕсли
    
    Если элемент1 == null Тогда
        // Способ 3: через New с английским именем
        Попытка
            элемент1 = new QtTreeWidgetItem()
        Исключение
            элемент1 = null
        КонецПопытки
    КонецЕсли
    
    Если элемент1 == null Тогда
        // Способ 4: через QTreeWidgetItem
        Попытка
            элемент1 = new QTreeWidgetItem()
        Исключение
            элемент1 = null
        КонецПопытки
    КонецЕсли
    
    Если элемент1 != null Тогда
        // Устанавливаем текст для элемента
        Попытка
            Если typeof элемент1.УстановитьТекст === 'function' Тогда
                элемент1.УстановитьТекст(0, "Корень 1")
                элемент1.УстановитьТекст(1, "Папка")
                элемент1.УстановитьТекст(2, "10 KB")
            ИначеЕсли typeof элемент1.setText === 'function' Тогда
                элемент1.setText(0, "Корень 1")
                элемент1.setText(1, "Папка")
                элемент1.setText(2, "10 KB")
            КонецЕсли
        Исключение
            // Игнорируем
        КонецПопытки
    КонецЕсли
    
    // Аналогично для второго элемента
    Попытка
        элемент2 = НовыйОбъект("QtЭлементДерева")
    Исключение
        элемент2 = null
    КонецПопытки
    
    Если элемент2 == null Тогда
        Попытка
            элемент2 = new QtTreeWidgetItem()
        Исключение
            элемент2 = null
        КонецПопытки
    КонецЕсли
    
    Если элемент2 == null Тогда
        Попытка
            элемент2 = new QTreeWidgetItem()
        Исключение
            элемент2 = null
        КонецПопытки
    КонецЕсли
    
    Если элемент2 != null Тогда
        Попытка
            Если typeof элемент2.УстановитьТекст === 'function' Тогда
                элемент2.УстановитьТекст(0, "Корень 2")
                элемент2.УстановитьТекст(1, "Файл")
                элемент2.УстановитьТекст(2, "5 KB")
            ИначеЕсли typeof элемент2.setText === 'function' Тогда
                элемент2.setText(0, "Корень 2")
                элемент2.setText(1, "Файл")
                элемент2.setText(2, "5 KB")
            КонецЕсли
        Исключение
            // Игнорируем
        КонецПопытки
    КонецЕсли
    
    Если элемент1 == null ИЛИ элемент2 == null Тогда
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("    ⚠️ Не удалось создать элементы дерева")
        СброситьЦветКонсоли()
        Возврат "Тест прерван - не удалось создать элементы"
    КонецЕсли
    
Исключение
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("    ⚠️ Ошибка при создании элементов: " + e)
    СброситьЦветКонсоли()
    Возврат "Тест прерван"
КонецПопытки

// --- АНГЛИЙСКИЙ ---
Попытка
    дерево.addTopLevelItem(элемент1)
    дерево.addTopLevelItem(элемент2)
    колво = дерево.topLevelItemCount()
    ВывестиСтрокуВКонсоль("    [ENG] addTopLevelItem x2: count=" + колво + " (ожидается 2)")
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
КонецПопытки

Если тестПройден И колво == 2 Тогда
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("    ✓ [ENG] Добавление элементов работает")
    СброситьЦветКонсоли()
    англУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
Иначе
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 2, получено " + колво)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецЕсли

// --- РУССКИЙ ---
Если тестПройден Тогда
    Попытка
        // Очищаем дерево перед русским тестом
        дерево.Очистить()
        
        // Создаем элементы через QtЭлементДерева
        элементРус1 = НовыйОбъект("QtЭлементДерева")
        Если элементРус1 != null Тогда
            элементРус1.УстановитьТекст(0, "Русский корень 1")
            элементРус1.УстановитьТекст(1, "Папка")
        Иначе
            // Если русская обертка не доступна, пробуем английскую
            элементРус1 = НовыйОбъект("QtTreeWidgetItem")
            Если элементРус1 != null Тогда
