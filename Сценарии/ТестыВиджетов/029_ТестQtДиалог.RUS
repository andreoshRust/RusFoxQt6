//✅ QtDialog (QtДиалог) - 10/10 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка заголовка    ✅
//3    Модальность    ✅
//4    Размерная ручка    ✅
//5    Установка фиксированного размера    ✅
//6    Константы (Accepted/Rejected)    ✅
//7    Проверка валидности    ✅
//8    Имя объекта    ✅
//9    Подсказка    ✅
//10    Видимость    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДиалог
// ============================================================

Функция ДиагностикаМетодовQtDialog()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДиалог ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДиалог: " + (typeof QtДиалог !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДиалог: " + e)
    КонецПопытки;
    
    Попытка
        диагДиалог = НовыйОбъект("QtДиалог")
        Если диагДиалог == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДиалог не создан")
            Возврат
        КонецЕсли;
        
        диагДиалог.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДиалог создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "result", "setModal", "isModal",
            "setSizeGripEnabled", "isSizeGripEnabled",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "Результат", "УстановитьМодальный", "Модальный",
            "УстановитьРазмернуюРучку", "РазмернаяРучкаВключена",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДиалог.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДиалог.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДиалог: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДиалог
// ============================================================

Функция ТестQtDialog()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    диалог = null
    Попытка
        диалог = НовыйОбъект("QtДиалог")
        Если диалог == null Тогда
            диалог = new QtDialog()
        КонецЕсли
        
        Если диалог != null Тогда
            диалог.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДиалог создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДиалог НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если диалог == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Диалог не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setWindowTitle/УстановитьЗаголовок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка заголовка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗаголовок = "Тестовый диалог"
    тестЗаголовок2 = "Новый заголовок"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setWindowTitle(тестЗаголовок)
        заголовок = диалог.windowTitle()
        диалог.setWindowTitle(тестЗаголовок2)
        заголовок2 = диалог.windowTitle()
        ВывестиСтрокуВКонсоль("    [ENG] setWindowTitle: '" + заголовок + "' -> '" + заголовок2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И заголовок == тестЗаголовок И заголовок2 == тестЗаголовок2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Заголовок работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка заголовка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьЗаголовок(тестЗаголовок)
            заголовокРус = диалог.Заголовок()
            диалог.УстановитьЗаголовок(тестЗаголовок2)
            заголовокРус2 = диалог.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок: '" + заголовокРус + "' -> '" + заголовокРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И заголовокРус == тестЗаголовок И заголовокРус2 == тестЗаголовок2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка заголовка")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. МОДАЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setModal/isModal"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Модальность")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setModal(ИСТИНА)
        модальный = диалог.isModal()
        диалог.setModal(ЛОЖЬ)
        модальный2 = диалог.isModal()
        ВывестиСтрокуВКонсоль("    [ENG] setModal(true): " + модальный + ", setModal(false): " + модальный2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И модальный == ИСТИНА И модальный2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Модальность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, затем false")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьМодальный(ИСТИНА)
            модальныйРус = диалог.Модальный()
            диалог.УстановитьМодальный(ЛОЖЬ)
            модальныйРус2 = диалог.Модальный()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьМодальный(true): " + модальныйРус + ", УстановитьМодальный(false): " + модальныйРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И модальныйРус == ИСТИНА И модальныйРус2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Модальность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, затем false")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. РАЗМЕРНАЯ РУЧКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setSizeGripEnabled"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Размерная ручка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setSizeGripEnabled(ИСТИНА)
        ручка = диалог.isSizeGripEnabled()
        диалог.setSizeGripEnabled(ЛОЖЬ)
        ручка2 = диалог.isSizeGripEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setSizeGripEnabled(true): " + ручка + ", setSizeGripEnabled(false): " + ручка2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И ручка == ИСТИНА И ручка2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Размерная ручка работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, затем false")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьРазмернуюРучку(ИСТИНА)
            ручкаРус = диалог.РазмернаяРучкаВключена()
            диалог.УстановитьРазмернуюРучку(ЛОЖЬ)
            ручкаРус2 = диалог.РазмернаяРучкаВключена()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьРазмернуюРучку(true): " + ручкаРус + ", УстановитьРазмернуюРучку(false): " + ручкаРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
