//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность    isValid    Действителен    ✅
//3    Установка области просмотра    setViewport    УстановитьОбластьПросмотра    ✅
//4    Политика горизонтальной полосы    setHorizontalScrollBarPolicy/horizontalScrollBarPolicy    УстановитьПолитикуГоризонтальнойПолосы/ПолитикаГоризонтальнойПолосы    ✅
//5    Политика вертикальной полосы    setVerticalScrollBarPolicy/verticalScrollBarPolicy    УстановитьПолитикуВертикальнойПолосы/ПолитикаВертикальнойПолосы    ✅
//6    Установка углового виджета    setCornerWidget    УстановитьУгловойВиджет    ✅
//7    Максимальный размер области просмотра    maximumViewportSize    МаксимальныйРазмерОбластиПросмотра    ✅
//8    Минимальный размер подсказка    minimumSizeHint    МинимальныйРазмерПодсказка    ✅
//9    Константы    ScrollBarAsNeeded, ScrollBarAlwaysOff, ScrollBarAlwaysOn    ПолосаПриНеобходимости, ПолосаВсегдаВыключена, ПолосаВсегдаВключена    ✅
//10    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//11    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//12    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//13    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//14    Получение реального виджета    getRealWidget/getRealObject    ПолучитьОбъект    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtAbstractScrollArea
// ============================================================

Функция ДиагностикаМетодовQtAbstractScrollArea()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtAbstractScrollArea ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtAbstractScrollArea: " + (typeof QtAbstractScrollArea !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtAbstractScrollArea: " + e)
    КонецПопытки;
    
    Попытка
        диагAbstractScroll = НовыйОбъект("QtАбстрактнаяОбластьПрокрутки")
        Если диагAbstractScroll == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtАбстрактнаяОбластьПрокрутки не создан")
            Возврат
        КонецЕсли;
        
        диагAbstractScroll.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtАбстрактнаяОбластьПрокрутки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "setViewport", "viewport",
            "setHorizontalScrollBarPolicy", "horizontalScrollBarPolicy",
            "setVerticalScrollBarPolicy", "verticalScrollBarPolicy",
            "setHorizontalScrollBar", "horizontalScrollBar",
            "setVerticalScrollBar", "verticalScrollBar",
            "setCornerWidget", "cornerWidget",
            "maximumViewportSize", "minimumSizeHint",
            "ScrollBarAsNeeded", "ScrollBarAlwaysOff", "ScrollBarAlwaysOn",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагAbstractScroll[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "УстановитьОбластьПросмотра", "ОбластьПросмотра",
            "УстановитьПолитикуГоризонтальнойПолосы", "ПолитикаГоризонтальнойПолосы",
            "УстановитьПолитикуВертикальнойПолосы", "ПолитикаВертикальнойПолосы",
            "УстановитьГоризонтальнуюПолосу", "ГоризонтальнаяПолоса",
            "УстановитьВертикальнуюПолосу", "ВертикальнаяПолоса",
            "УстановитьУгловойВиджет", "УгловойВиджет",
            "МаксимальныйРазмерОбластиПросмотра", "МинимальныйРазмерПодсказка",
            "ПолосаПриНеобходимости", "ПолосаВсегдаВыключена", "ПолосаВсегдаВключена",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагAbstractScroll[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагAbstractScroll.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагAbstractScroll.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtАбстрактнаяОбластьПрокрутки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtAbstractScrollArea (QtАбстрактнаяОбластьПрокрутки)
// ============================================================

Функция ТестQtAbstractScrollAreaFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    abstractScroll = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        abstractScroll = НовыйОбъект("QtАбстрактнаяОбластьПрокрутки")
        Если abstractScroll == null Тогда
            abstractScroll = new QtAbstractScrollArea()
        КонецЕсли
        
        Если abstractScroll != null Тогда
            abstractScroll.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtАбстрактнаяОбластьПрокрутки создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtАбстрактнаяОбластьПрокрутки НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если abstractScroll == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ AbstractScrollArea не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = abstractScroll.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = abstractScroll.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА ОБЛАСТИ ПРОСМОТРА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setViewport/УстановитьОбластьПросмотра"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка области просмотра")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестовыйВиджет = null
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        тестовыйВиджет = НовыйОбъект("QtВиджет")
        реалВиджет = тестовыйВиджет.ПолучитьРеальныйВиджет()
        abstractScroll.setViewport(реалВиджет)
        полученный = abstractScroll.viewport()
        ВывестиСтрокуВКонсоль("    [ENG] setViewport: " + (полученный != null ? "успешно" : "неудачно"))
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И полученный != null Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Установка области просмотра работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка установки области просмотра")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            тестовыйВиджет2 = НовыйОбъект("QtВиджет")
            реалВиджет2 = тестовыйВиджет2.ПолучитьРеальныйВиджет()
            abstractScroll.УстановитьОбластьПросмотра(реалВиджет2)
            полученныйРус = abstractScroll.ОбластьПросмотра()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьОбластьПросмотра: " + (полученныйРус != null ? "успешно" : "неудачно"))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И полученныйРус != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка области просмотра работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка установки области просмотра")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. ПОЛИТИКА ГОРИЗОНТАЛЬНОЙ ПОЛОСЫ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "horizontalScrollBarPolicy"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Политика горизонтальной полосы")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        abstractScroll.setHorizontalScrollBarPolicy(abstractScroll.ScrollBarAlwaysOn())
        политика = abstractScroll.horizontalScrollBarPolicy()
        abstractScroll.setHorizontalScrollBarPolicy(abstractScroll.ScrollBarAlwaysOff())
        политика2 = abstractScroll.horizontalScrollBarPolicy()
        ВывестиСтрокуВКонсоль("    [ENG] setHorizontalScrollBarPolicy: " + политика + " -> " + политика2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Политика горизонтальной полосы работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка политики горизонтальной полосы")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            abstractScroll.УстановитьПолитикуГоризонтальнойПолосы(abstractScroll.ПолосаВсегдаВключена())
