//✅ QtFileDialog (QtДиалогФайла) - 10/10 тестов пройдено
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка заголовка    ✅
//3    Установка фильтров    ✅
//4    Установка директории    ✅
//5    Режимы файла    ✅
//6    Константы    ✅
//7    Проверка валидности    ✅
//8    Имя объекта    ✅
//9    Подсказка    ✅
//10    Видимость    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДиалогФайла
// ============================================================

Функция ДиагностикаМетодовQtFileDialog()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДиалогФайла ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДиалогФайла: " + (typeof QtДиалогФайла !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДиалогФайла: " + e)
    КонецПопытки;
    
    Попытка
        диагДиалог = НовыйОбъект("QtДиалогФайла")
        Если диагДиалог == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДиалогФайла не создан")
            Возврат
        КонецЕсли;
        
        диагДиалог.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДиалогФайла создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "setDirectory", "directory",
            "setDirectoryUrl", "directoryUrl",
            "setNameFilters", "nameFilters",
            "setMimeTypeFilters", "mimeTypeFilters",
            "setSelectedNameFilter", "selectedNameFilter",
            "setSelectedMimeTypeFilter", "selectedMimeTypeFilter",
            "setFileMode", "fileMode",
            "setAcceptMode", "acceptMode",
            "setViewMode", "viewMode",
            "selectedFiles",
            "setDefaultSuffix", "defaultSuffix",
            "setHistory", "history",
            "setSidebarUrls", "sidebarUrls",
            "getOpenFileName", "getOpenFileNames",
            "getSaveFileName", "getExistingDirectory",
            "AnyFile", "ExistingFile", "Directory", "ExistingFiles",
            "AcceptOpen", "AcceptSave",
            "Detail", "List",
            "setParentWrapper", "getParentWrapper",
            "setObjectName", "objectName",
            "setDebug", "getDebug",
            "setVisible", "isVisible",
            "setEnabled", "isEnabled",
            "setWindowTitle", "windowTitle",
            "setFixedWidth", "setFixedHeight", "setFixedSize",
            "setMinimumSize", "setMaximumSize",
            "width", "height", "size",
            "move", "resize", "x", "y", "pos",
            "setFocus", "hasFocus", "clearFocus",
            "setStyleSheet", "styleSheet",
            "setToolTip", "toolTip",
            "setWhatsThis", "whatsThis",
            "setFont", "font",
            "raise", "lower",
            "exec", "open", "show", "hide",
            "accept", "reject", "done",
            "Accepted", "Rejected"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "УстановитьДиректорию", "Директория",
            "УстановитьURLДиректории", "URLДиректории",
            "УстановитьФильтрыИмен", "ФильтрыИмен",
            "УстановитьMimeTypeФильтры", "MimeTypeФильтры",
            "УстановитьВыбранныйФильтрИмени", "ВыбранныйФильтрИмени",
            "УстановитьВыбранныйMimeTypeФильтр", "ВыбранныйMimeTypeФильтр",
            "УстановитьРежимФайла", "РежимФайла",
            "УстановитьРежимПринятия", "РежимПринятия",
            "УстановитьРежимПросмотра", "РежимПросмотра",
            "ВыбранныеФайлы",
            "УстановитьСуффиксПоУмолчанию", "СуффиксПоУмолчанию",
            "УстановитьИсторию", "История",
            "УстановитьБоковуюПанель", "БоковаяПанель",
            "ОткрытьФайл", "ОткрытьФайлы",
            "СохранитьФайл", "ВыбратьДиректорию",
            "ЛюбойФайл", "СуществующийФайл", "Директория", "СуществующиеФайлы",
            "Открыть", "Сохранить",
            "Детально", "Список",
            "УстановитьРодителя", "ПолучитьРодителя",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "РежимОтладки", "ПолучитьРежимОтладки",
            "УстановитьВидимость", "Видим",
            "УстановитьДоступность", "Доступен",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту",
            "УстановитьФиксированныйРазмер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Ширина", "Высота", "Размер",
            "Переместить", "ИзменитьРазмер", "ПозицияX", "ПозицияY", "Позиция",
            "УстановитьФокус", "ЕстьФокус", "СнятьФокус",
            "УстановитьСтиль", "Стиль",
            "УстановитьПодсказку", "Подсказка",
            "УстановитьЧтоЭто", "ЧтоЭто",
            "УстановитьШрифт", "Шрифт",
            "Поднять", "Опустить",
            "Выполнить", "Открыть", "Показать", "Скрыть",
            "Принять", "Отклонить", "Завершить",
            "Принято", "Отклонено"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагДиалог[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагДиалог.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагДиалог.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДиалогФайла: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДиалогФайла
// ============================================================

Функция ТестQtFileDialog()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    диалог = null
    Попытка
        диалог = НовыйОбъект("QtДиалогФайла")
        Если диалог == null Тогда
            диалог = new QtFileDialog()
        КонецЕсли
        
        Если диалог != null Тогда
            диалог.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДиалогФайла создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДиалогФайла НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если диалог == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Диалог не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли
    
    // ===== 2. УСТАНОВКА ЗАГОЛОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setWindowTitle/УстановитьЗаголовок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка заголовка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестЗаголовок = "Тестовый диалог файла"
    тестЗаголовок2 = "Новый заголовок"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setWindowTitle(тестЗаголовок)
        заголовок = диалог.windowTitle()
        диалог.setWindowTitle(тестЗаголовок2)
        заголовок2 = диалог.windowTitle()
        ВывестиСтрокуВКонсоль("    [ENG] setWindowTitle: '" + заголовок + "' -> '" + заголовок2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И заголовок == тестЗаголовок И заголовок2 == тестЗаголовок2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Заголовок работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка заголовка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            диалог.УстановитьЗаголовок(тестЗаголовок)
            заголовокРус = диалог.Заголовок()
            диалог.УстановитьЗаголовок(тестЗаголовок2)
            заголовокРус2 = диалог.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок: '" + заголовокРус + "' -> '" + заголовокРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И заголовокРус == тестЗаголовок И заголовокРус2 == тестЗаголовок2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Заголовок работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка заголовка")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. УСТАНОВКА ФИЛЬТРОВ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setNameFilters/УстановитьФильтрыИмен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка фильтров")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        фильтры = ["Текстовые файлы (*.txt)", "Все файлы (*.*)"]
        диалог.setNameFilters(фильтры)
        полученные = диалог.nameFilters()
        ВывестиСтрокуВКонсоль("    [ENG] setNameFilters: count=" + полученные.length)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И полученные.length == 2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Фильтры работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка фильтров")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            фильтрыРус = ["Изображения (*.png *.jpg)", "Все файлы (*.*)"]
            диалог.УстановитьФильтрыИмен(фильтрыРус)
            полученныеРус = диалог.ФильтрыИмен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьФильтрыИмен: count=" + полученныеРус.length)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И полученныеРус.length == 2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Фильтры работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка фильтров")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. УСТАНОВКА ДИРЕКТОРИИ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setDirectory/УстановитьДиректорию"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка директории")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестДиректория = "C:/"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        диалог.setDirectory(тестДиректория)
        директория = диалог.directory()
        ВывестиСтрокуВКонсоль("    [ENG] setDirectory: '" + директория + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
