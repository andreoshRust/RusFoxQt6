                неуспешноАнгл = неуспешноАнгл + 1
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать с текстом")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            радио3 = НовыйОбъект("QtРадиоКнопка", "Создан с текстом")
            Если радио3 != null Тогда
                текстРус = радио3.Текст()
                ВывестиСтрокуВКонсоль("    [RUS] Текст: '" + текстРус + "' (ожидается 'Создан с текстом')")
                Если текстРус == "Создан с текстом" Тогда
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с текстом работает")
                    СброситьЦветКонсоли()
                    русУспех = ИСТИНА
                    успешноРус = успешноРус + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Создан с текстом', получено '" + текстРус + "'")
                    СброситьЦветКонсоли()
                    неуспешноРус = неуспешноРус + 1
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать с текстом")
                СброситьЦветКонсоли()
                неуспешноРус = неуспешноРус + 1
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 10. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setToolTip/toolTip"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Подсказка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестПодсказка = "ToolTip Test"
    тестПодсказкаРус = "Тест подсказка"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        радио.setToolTip(тестПодсказка)
        подсказка = радио.toolTip()
        ВывестиСтрокуВКонсоль("    [ENG] setToolTip/toolTip: '" + подсказка + "' (ожидается '" + тестПодсказка + "')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И подсказка == тестПодсказка Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Подсказка работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка подсказки")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            радио.УстановитьПодсказку(тестПодсказкаРус)
            подсказкаРус = радио.Подсказка()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПодсказку/Подсказка: '" + подсказкаРус + "' (ожидается '" + тестПодсказкаРус + "')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И подсказкаРус == тестПодсказкаРус Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка подсказки")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 11. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setStyleSheet/styleSheet"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Стиль")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        радио.setStyleSheet("color: red;")
        стиль = радио.styleSheet()
        ВывестиСтрокуВКонсоль("    [ENG] setStyleSheet/styleSheet: '" + стиль + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И стиль != "" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка стиля")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            радио.УстановитьСтиль("color: blue;")
            стильРус = радио.Стиль()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтиль/Стиль: '" + стильРус + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И стильРус != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка стиля")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 12. ГРУППИРОВКА (проверка через autoExclusive) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Группировка"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Работа с группой")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        // Проверяем, что autoExclusive работает по умолчанию
        исключ = радио.autoExclusive()
        ВывестиСтрокуВКонсоль("    [ENG] autoExclusive по умолчанию: " + исключ + " (ожидается true)")
        
        Если исключ == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Группировка включена по умолчанию")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ [ENG] autoExclusive: " + исключ + " (не соответствует ожидаемому)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли
        
        // Проверяем русский метод
        Если тестПройден Тогда
            исключРус = радио.АвтоИсключительность()
            ВывестиСтрокуВКонсоль("    [RUS] АвтоИсключительность: " + исключРус + " (ожидается true)")
            Если исключРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Группировка работает")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("yellow")
                ВывестиСтрокуВКонсоль("    ⚠️ [RUS] АвтоИсключительность: " + исключРус)
                СброситьЦветКонсоли()
                неуспешноРус = неуспешноРус + 1
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
        
        ВывестиСтрокуВКонсоль("    ⚠️ Примечание: Для группировки радиокнопок используйте общий родительский виджет")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка при проверке группировки: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    Для i = 0 По названияТестов.length - 1 Цикл
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + (i+1) + "    │ " + названияТестов[i] + " " + англСтатус + "        │ " + названияТестов[i] + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtРадиоКнопка завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtРадиоКнопка (QtRadioButton)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtRadioButton()
    ДиагностикаМетаОбъектаRadioButton()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtРадиоКнопка (русские и английские методы)                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtRadioButton()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtРадиоКнопка: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

