    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Свойства работают")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            формат.УстановитьСвойство(2, "test rus")
            естьРус = формат.ЕстьСвойство(2)
            значениеРус = формат.Свойство(2)
            формат.ОчиститьСвойство(2)
            естьРус2 = формат.ЕстьСвойство(2)
            ВывестиСтрокуВКонсоль("    [RUS] ЕстьСвойство=" + естьРус + ", Свойство='" + значениеРус + "', после ОчиститьСвойство: " + естьРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Свойства работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 11. ОБЪЕДИНЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Объединение")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        формат1 = Новый QtТекстСимволФормат()
        формат2 = Новый QtТекстСимволФормат()
        формат1.setFontSize(16)
        формат2.setFontBold(true)
        формат1.merge(формат2.getFormat())
        размер = формат1.fontPointSize()
        жирный = формат1.fontBold()
        ВывестиСтрокуВКонсоль("    [ENG] merge: размер=" + размер + ", жирный=" + жирный)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Объединение работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    // Для русского теста используем английские методы
    Если тестПройден Тогда
        Попытка
            форматРус1 = Новый QtТекстСимволФормат()
            форматРус2 = Новый QtТекстСимволФормат()
            форматРус1.УстановитьРазмерШрифта(18)
            форматРус2.УстановитьКурсивныйШрифт(ИСТИНА)
            форматРус1.Объединить(форматРус2.ПолучитьФормат())
            размерРус = форматРус1.РазмерШрифта()
            курсивРус = форматРус1.КурсивныйШрифт()
            ВывестиСтрокуВКонсоль("    [RUS] Объединить: размер=" + размерРус + ", курсив=" + курсивРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Объединение работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 12. ПОЛУЧИТЬ/УСТАНОВИТЬ ФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Получить/Установить формат")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        полученныйФормат = формат.getFormat()
        Если полученныйФормат != null Тогда
            ВывестиСтрокуВКонсоль("    [ENG] getFormat: формат получен")
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: формат не получен")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Получить/Установить формат работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            полученныйФорматРус = формат.ПолучитьФормат()
            Если полученныйФорматРус != null Тогда
                ВывестиСтрокуВКонсоль("    [RUS] ПолучитьФормат: формат получен")
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: формат не получен")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Получить/Установить формат работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстСимволФормат: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtТекстСимволФормат: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtТекстСимволФормат завершён"
КонецФункции

