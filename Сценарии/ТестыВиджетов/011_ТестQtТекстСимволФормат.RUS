//Тест проверяет 12 основных функций QtTextCharFormat:
//====================================================
//Создание объекта - проверка создания QtТекстСимволФормат
//Шрифт - setFontSize/setFontBold, УстановитьРазмерШрифта/УстановитьЖирныйШрифт
//Цвет текста - setTextColor/textColor, УстановитьЦветТекста/ЦветТекста
//Цвет фона - setBackgroundColor/backgroundColor, УстановитьЦветФона/ЦветФона
//Подчеркивание - setUnderlineStyle/underlineStyle, УстановитьСтильПодчеркивания/СтильПодчеркивания
//Вертикальное выравнивание - setVerticalAlignment/verticalAlignment, УстановитьВертикальноеВыравнивание/ВертикальноеВыравнивание
//Интервалы - setLetterSpacing/letterSpacing, УстановитьМежбуквенныйИнтервал/МежбуквенныйИнтервал
//Проверка пустоты - isEmpty, Пусто
//Копирование - copy, Копировать
//Свойства - setProperty/property/hasProperty/clearProperty, УстановитьСвойство/Свойство/ЕстьСвойство/ОчиститьСвойство
//Объединение - merge, Объединить
//Получить/Установить формат - getFormat/setFormat, ПолучитьФормат/УстановитьФормат


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТекстСимволФормат
// ============================================================

Функция ДиагностикаМетодовQtTextCharFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТекстСимволФормат ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТекстСимволФормат: " + (typeof QtТекстСимволФормат !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТекстСимволФормат: " + e)
    КонецПопытки;
    
    Попытка
        диагФормат = Новый QtТекстСимволФормат()
        Если диагФормат == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТекстСимволФормат не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtТекстСимволФормат создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "getFormat", "setFormat",
            "setFont", "font", "setFontFamily", "fontFamily",
            "setFontPointSize", "fontPointSize", "setFontSize",
            "setFontWeight", "fontWeight", "setFontBold", "fontBold",
            "setFontItalic", "fontItalic", "setFontUnderline", "fontUnderline",
            "setFontStrikeOut", "fontStrikeOut", "setFontOverline", "fontOverline",
            "setFontCapitalization", "fontCapitalization",
            "setForeground", "foreground", "setForegroundColor", "foregroundColor",
            "setTextColor", "textColor",
            "setBackground", "background", "setBackgroundColor", "backgroundColor",
            "setUnderlineStyle", "underlineStyle",
            "setUnderlineColor", "underlineColor",
            "setVerticalAlignment", "verticalAlignment",
            "setStrikeOut", "strikeOut",
            "setLetterSpacing", "letterSpacing",
            "setWordSpacing", "wordSpacing",
            "setProperty", "property", "hasProperty", "clearProperty",
            "isEmpty", "isCharFormat", "objectIndex",
            "copy", "merge"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ПолучитьФормат", "УстановитьФормат",
            "УстановитьШрифт", "Шрифт", "УстановитьСемействоШрифта", "СемействоШрифта",
            "УстановитьРазмерШрифта", "РазмерШрифта", "УстановитьРазмер",
            "УстановитьВесШрифта", "ВесШрифта", "УстановитьЖирныйШрифт", "ЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "КурсивныйШрифт", "УстановитьПодчеркнутыйШрифт", "ПодчеркнутыйШрифт",
            "УстановитьЗачеркнутыйШрифт", "ЗачеркнутыйШрифт", "УстановитьНадчеркнутыйШрифт", "НадчеркнутыйШрифт",
            "УстановитьРегистрШрифта", "РегистрШрифта",
            "УстановитьЦветПера", "ЦветПера", "УстановитьЦветТекста", "ЦветТекста",
            "УстановитьЦветФона", "ЦветФона",
            "УстановитьСтильПодчеркивания", "СтильПодчеркивания",
            "УстановитьЦветПодчеркивания", "ЦветПодчеркивания",
            "УстановитьВертикальноеВыравнивание", "ВертикальноеВыравнивание",
            "УстановитьМежбуквенныйИнтервал", "МежбуквенныйИнтервал",
            "УстановитьМежсловныйИнтервал", "МежсловныйИнтервал",
            "УстановитьСвойство", "Свойство", "ЕстьСвойство", "ОчиститьСвойство",
            "Пусто", "ЯвляетсяСимвольнымФорматом", "ИндексОбъекта",
            "Копировать", "Объединить"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФормат[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагФормат.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагФормат.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТекстСимволФормат: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстСимволФормат
// ============================================================

Функция ДиагностикаМетаОбъектаTextCharFormat()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtТекстСимволФормат ===")
    
    // 1. Проверяем, что класс зарегистрирован
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTextCharFormat: " + (typeof QtTextCharFormat !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtТекстСимволФормат: " + (typeof QtТекстСимволФормат !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    // 2. Создаем объект
    Попытка
        формат = НовыйОбъект("QtТекстСимволФормат")
        Если формат == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан через НовыйОбъект")
            // Пробуем создать напрямую
            формат = new QtTextCharFormat()
            Если формат == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан через new QtTextCharFormat()")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtTextCharFormat()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    // 3. Получаем список методов объекта
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtТекстСимволФормат:")
    методы = Object.getOwnPropertyNames(формат)
    // Добавляем методы из прототипа
    прототип = Object.getPrototypeOf(формат)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    // Выводим методы
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof формат[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    // 4. Специальная проверка RusFunc
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof формат.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            // Вызываем RusFunc
            jsonStr = формат.RusFunc()
            ВывестиСтрокуВКонсоль("  RusFunc вернул: " + jsonStr.substring(0, 200) + "...")
            
            // Парсим JSON
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            // Показываем первые 5 методов
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // 5. Проверяем русские методы (если есть)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "УстановитьШрифт", "Шрифт",
        "УстановитьЦветТекста", "ЦветТекста",
        "Копировать"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof формат[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    // 6. Сравнение с QtBasicTimer (если доступен)
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Сравнение с QtBasicTimer:")
    Попытка
        таймер = НовыйОбъект("QtБазовыйТаймер")
        Если таймер != null Тогда
            Если typeof таймер.RusFunc === 'function' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("✓ QtBasicTimer.RusFunc существует")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("✗ QtBasicTimer.RusFunc НЕ СУЩЕСТВУЕТ")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("⚠️ QtBasicTimer не доступен для сравнения")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при создании QtBasicTimer: " + e)
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТекстСимволФормат (русские и английские методы)
// ============================================================
Функция ТестQtTextCharFormatFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        формат = Новый QtТекстСимволФормат()
        Если формат != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtТекстСимволФормат создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtТекстСимволФормат НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если формат == null Тогда
        Возврат "❌ Тест QtТекстСимволФормат провален (объект не создан)"
    КонецЕсли

    // ===== 2. ШРИФТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Шрифт")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        формат.setFontSize(16)
        формат.setFontBold(true)
        размер = формат.fontPointSize()
        жирный = формат.fontBold()
        ВывестиСтрокуВКонсоль("    [ENG] setFontSize/setFontBold: размер=" + размер + ", жирный=" + жирный)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Шрифт работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            формат.УстановитьРазмерШрифта(18)
            формат.УстановитьЖирныйШрифт(ИСТИНА)
            размерРус = формат.РазмерШрифта()
            жирныйРус = формат.ЖирныйШрифт()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьРазмерШрифта/УстановитьЖирныйШрифт: размер=" + размерРус + ", жирный=" + жирныйРус)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Шрифт работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== 3. ЦВЕТ ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Цвет текста")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        формат.setTextColor("red")
        цвет = формат.textColor()
        // name - это свойство, а не метод
        имяЦвета = цвет.name
        ВывестиСтрокуВКонсоль("    [ENG] setTextColor: " + имяЦвета)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
