//Тест    Описание    Статус
//1    Создание объекта    ✅
//2    Проверка действительности (isValid)    ✅
//3    Значение (value/setValue)    ✅
//4    Диапазон (setRange)    ✅
//5    Шаг (singleStep)    ✅
//6    Шаг страницы (pageStep)    ✅
//7    Ориентация (orientation)    ✅
//8    Положение (sliderPosition)    ✅
//9    Отслеживание (tracking)    ✅
//10    Инвертированный вид    ✅
//11    Интервал меток    ✅
//12    Положение меток    ✅
//13    Доступность    ✅
//14    Видимость    ✅
//15    Подсказка    ✅
//16    Стиль    ✅
//17    Создание с ориентацией    ✅
//18    Сигналы (пропущен)    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПолзунок
// ============================================================

Функция ДиагностикаМетодовQtSlider()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПолзунок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПолзунок: " + (typeof QtПолзунок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПолзунок: " + e)
    КонецПопытки;
    
    Попытка
        диагПолзунок = Новый QtПолзунок()
        Если диагПолзунок == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПолзунок не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtПолзунок создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "value", "setValue",
            "minimum", "setMinimum", "maximum", "setMaximum", "setRange",
            "singleStep", "setSingleStep", "pageStep", "setPageStep",
            "orientation", "setOrientation",
            "sliderPosition", "setSliderPosition",
            "hasTracking", "setTracking",
            "invertedControls", "setInvertedControls",
            "invertedAppearance", "setInvertedAppearance",
            "tickInterval", "setTickInterval", "tickPosition", "setTickPosition",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "isValid", "getWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПолзунок[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Значение", "УстановитьЗначение",
            "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум", "УстановитьДиапазон",
            "Шаг", "УстановитьШаг", "ШагСтраницы", "УстановитьШагСтраницы",
            "Ориентация", "УстановитьОриентацию",
            "Положение", "УстановитьПоложение",
            "Отслеживание", "УстановитьОтслеживание",
            "ИнвертированныеЭлементы", "УстановитьИнвертированныеЭлементы",
            "ИнвертированныйВид", "УстановитьИнвертированныйВид",
            "ИнтервалМеток", "УстановитьИнтервалМеток", "ПоложениеМеток", "УстановитьПоложениеМеток",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьСтиль", "Стиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьФокус", "ЕстьФокус",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПолзунок[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПолзунок.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПолзунок.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПолзунок: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПолзунок
// ============================================================

Функция ДиагностикаМетаОбъектаSlider()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПолзунок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtSlider: " + (typeof QtSlider !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПолзунок: " + (typeof QtПолзунок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        ползунок = НовыйОбъект("QtПолзунок")
        Если ползунок == null Тогда
            ползунок = new QtSlider()
            Если ползунок == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtSlider()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПолзунок:")
    методы = Object.getOwnPropertyNames(ползунок)
    прототип = Object.getPrototypeOf(ползунок)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof ползунок[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof ползунок.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = ползунок.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ТЕСТ QtПолзунок
// ============================================================

Функция ТестQtSliderFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    ползунок = null
    Попытка
        ползунок = Новый QtПолзунок()
        Если ползунок != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПолзунок создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПолзунок НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если ползунок == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = ползунок.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    КонецПопытки

    // ===== 3. ЗНАЧЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Значение")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьДиапазон(0, 100)
        ползунок.УстановитьЗначение(50)
        значение = ползунок.Значение()
        ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗначение/Значение: " + значение + " (ожидается 50)")
        Если значение == 50 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Значение работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 50, получено " + значение)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 4. ДИАПАЗОН =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Диапазон")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьДиапазон(10, 90)
        минимум = ползунок.Минимум()
        максимум = ползунок.Максимум()
        ВывестиСтрокуВКонсоль("    [RUS] Диапазон: мин=" + минимум + ", макс=" + максимум + " (ожидается 10, 90)")
        Если минимум == 10 И максимум == 90 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Диапазон работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10, 90")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 5. ШАГ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Шаг")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьШаг(5)
        шаг = ползунок.Шаг()
        ВывестиСтрокуВКонсоль("    [RUS] Шаг: " + шаг + " (ожидается 5)")
        Если шаг == 5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Шаг работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 5, получено " + шаг)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 6. ШАГ СТРАНИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Шаг страницы")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьШагСтраницы(20)
        шагСтраницы = ползунок.ШагСтраницы()
        ВывестиСтрокуВКонсоль("    [RUS] ШагСтраницы: " + шагСтраницы + " (ожидается 20)")
        Если шагСтраницы == 20 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Шаг страницы работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 20, получено " + шагСтраницы)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 7. ОРИЕНТАЦИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Ориентация")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьОриентацию(1) // Vertical
        ориентация = ползунок.Ориентация()
        ползунок.УстановитьОриентацию(0) // Horizontal
        ориентация2 = ползунок.Ориентация()
        ВывестиСтрокуВКонсоль("    [RUS] Ориентация: 1->" + ориентация + ", 0->" + ориентация2)
        Если ориентация == 1 И ориентация2 == 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Ориентация работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 1 -> 0")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 8. ПОЛОЖЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Положение")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьДиапазон(0, 100)
        ползунок.УстановитьПоложение(75)
        положение = ползунок.Положение()
        значение = ползунок.Значение()
        ВывестиСтрокуВКонсоль("    [RUS] Положение=" + положение + ", Значение=" + значение)
        Если положение == 75 И значение == 75 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Положение работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 75, 75")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 9. ОТСЛЕЖИВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Отслеживание")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьОтслеживание(ЛОЖЬ)
        отслеживание = ползунок.Отслеживание()
        ползунок.УстановитьОтслеживание(ИСТИНА)
        отслеживание2 = ползунок.Отслеживание()
        ВывестиСтрокуВКонсоль("    [RUS] Отслеживание: false->" + отслеживание + ", true->" + отслеживание2)
        Если отслеживание == ЛОЖЬ И отслеживание2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Отслеживание работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 10. ИНВЕРТИРОВАННЫЙ ВИД =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Инвертированный вид")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьИнвертированныйВид(ИСТИНА)
        инвертВид = ползунок.ИнвертированныйВид()
        ползунок.УстановитьИнвертированныйВид(ЛОЖЬ)
        инвертВид2 = ползунок.ИнвертированныйВид()
        ВывестиСтрокуВКонсоль("    [RUS] ИнвертированныйВид: true->" + инвертВид + ", false->" + инвертВид2)
        Если инвертВид == ИСТИНА И инвертВид2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Инвертированный вид работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true -> false")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 11. ИНТЕРВАЛ МЕТОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Интервал меток")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьИнтервалМеток(10)
        интервал = ползунок.ИнтервалМеток()
        ВывестиСтрокуВКонсоль("    [RUS] ИнтервалМеток: " + интервал + " (ожидается 10)")
        Если интервал == 10 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Интервал меток работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10, получено " + интервал)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 12. ПОЛОЖЕНИЕ МЕТОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Положение меток")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьПоложениеМеток(3) // TicksBothSides
        положениеМеток = ползунок.ПоложениеМеток()
        ВывестиСтрокуВКонсоль("    [RUS] ПоложениеМеток: " + положениеМеток + " (ожидается 3)")
        Если положениеМеток == 3 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Положение меток работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3, получено " + положениеМеток)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 13. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьДоступность(ЛОЖЬ)
        доступен = ползунок.Доступен()
        ползунок.УстановитьДоступность(ИСТИНА)
        доступен2 = ползунок.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 14. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьВидимость(ЛОЖЬ)
        видим = ползунок.Видим()
        ползунок.УстановитьВидимость(ИСТИНА)
        видим2 = ползунок.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 15. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьПодсказку("Тест подсказка")
        подсказка = ползунок.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тест подсказка')")
        Если подсказка == "Тест подсказка" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест подсказка'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 16. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        ползунок.УстановитьСтиль("color: red;")
        стиль = ползунок.Стиль()
        ВывестиСтрокуВКонсоль("    [RUS] Стиль: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'red'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 17. СОЗДАНИЕ С ОРИЕНТАЦИЕЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 17: Создание с ориентацией")
    СброситьЦветКонсоли()
    
    Попытка
        ползунокВерт = Новый QtПолзунок(1) // Vertical
        Если ползунокВерт != null Тогда
            ориентация = ползунокВерт.Ориентация()
            ВывестиСтрокуВКонсоль("    [RUS] Ориентация: " + ориентация + " (ожидается 1)")
            Если ориентация == 1 Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание с ориентацией работает")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 1, получено " + ориентация)
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Объект не создан")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 18. СИГНАЛ (пропущен) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 18: Сигналы (пропущен)")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("    ⚠️ Тест пропущен - проверка сигналов не поддерживается")
    ВывестиСтрокуВКонсоль("    ✓ [RUS] Тест пропущен (не критично)")
    успешноТестов = успешноТестов + 1

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtПолзунок: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtПолзунок: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПолзунок завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.12 Тогда 
        ПоказатьСообщение("Данный сценарий работает с версии 2.12. Ваша версия: " + НомерВерсииПрограммы)
        Возврат    
    КонецЕсли
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                ТЕСТИРОВАНИЕ QtПолзунок (QtSlider)                            ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ДиагностикаМетодовQtSlider()
    ДиагностикаМетаОбъектаSlider()
    
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПолзунок (русские и английские методы)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtSliderFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПолзунок: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

