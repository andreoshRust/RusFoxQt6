//№    Тест    Описание
//1    Создание объекта    Проверка создания QtПолзунок
//2    Действительность    isValid/Действителен
//3    Значение    setValue/value, УстановитьЗначение/Значение
//4    Диапазон    setRange/minimum/maximum, УстановитьДиапазон/Минимум/Максимум
//5    Шаг    setSingleStep/singleStep, УстановитьШаг/Шаг
//6    Шаг страницы    setPageStep/pageStep, УстановитьШагСтраницы/ШагСтраницы
//7    Ориентация    setOrientation/orientation, УстановитьОриентацию/Ориентация
//8    Положение    setSliderPosition/sliderPosition, УстановитьПоложение/Положение
//9    Отслеживание    setTracking/hasTracking, УстановитьОтслеживание/Отслеживание
//10    Инвертированный вид    setInvertedAppearance/invertedAppearance, УстановитьИнвертированныйВид/ИнвертированныйВид
//11    Интервал меток    setTickInterval/tickInterval, УстановитьИнтервалМеток/ИнтервалМеток
//12    Положение меток    setTickPosition/tickPosition, УстановитьПоложениеМеток/ПоложениеМеток
//13    Константы    Проверка констант
//14    Доступность    setEnabled/isEnabled, УстановитьДоступность/Доступен
//15    Видимость    setVisible/isVisible, УстановитьВидимость/Видим
//16    Подсказка    setToolTip/toolTip, УстановитьПодсказку/Подсказка
//17    Стиль    setStyleSheet/styleSheet, УстановитьСтиль/Стиль
//18    Создание с ориентацией    Создание с ориентацией

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПолзунок
// ============================================================

Функция ДиагностикаМетодовQtSlider()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПолзунок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПолзунок: " + (typeof QtПолзунок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПолзунок: " + e)
    КонецПопытки;
    
    Попытка
        диагПолзунок = НовыйОбъект("QtПолзунок")
        Если диагПолзунок == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПолзунок не создан")
            Возврат
        КонецЕсли;
        
        диагПолзунок.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПолзунок создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "copyTo",
            "value", "setValue",
            "minimum", "setMinimum", "maximum", "setMaximum", "setRange",
            "singleStep", "setSingleStep", "pageStep", "setPageStep",
            "orientation", "setOrientation",
            "sliderPosition", "setSliderPosition",
            "hasTracking", "setTracking",
            "invertedControls", "setInvertedControls",
            "invertedAppearance", "setInvertedAppearance",
            "tickInterval", "setTickInterval", "tickPosition", "setTickPosition",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline", "setFontStrikeOut",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "Horizontal", "Vertical",
            "NoTicks", "TicksAbove", "TicksBelow", "TicksBothSides", "TicksLeft", "TicksRight"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПолзунок[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьВиджет", "КопироватьВ",
            "Значение", "УстановитьЗначение",
            "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум", "УстановитьДиапазон",
            "Шаг", "УстановитьШаг", "ШагСтраницы", "УстановитьШагСтраницы",
            "Ориентация", "УстановитьОриентацию",
            "Положение", "УстановитьПоложение",
            "Отслеживание", "УстановитьОтслеживание",
            "ИнвертированныеЭлементы", "УстановитьИнвертированныеЭлементы",
            "ИнвертированныйВид", "УстановитьИнвертированныйВид",
            "ИнтервалМеток", "УстановитьИнтервалМеток", "ПоложениеМеток", "УстановитьПоложениеМеток",
            "Шрифт", "УстановитьШрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт", "УстановитьЗачеркнутыйШрифт",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "Что Это", "УстановитьЧто Это",
            "ЕстьФокус", "УстановитьФокус",
            "Горизонтальный", "Вертикальный",
            "НетМеток", "МеткиСверху", "МеткиСнизу", "МеткиСОбеихСторон", "МеткиСлева", "МеткиСправа"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПолзунок[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПолзунок.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПолзунок.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПолзунок: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtПолзунок
// ============================================================

Функция ДиагностикаМетаОбъектаSlider()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПолзунок ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtSlider: " + (typeof QtSlider !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПолзунок: " + (typeof QtПолзунок !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки;
    
    Попытка
        ползунок = НовыйОбъект("QtПолзунок")
        Если ползунок == null Тогда
            ВывестиСтрокуВКонсоль("✗ Объект не создан")
            Возврат
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПолзунок:")
    методы = Object.getOwnPropertyNames(ползунок)
    прототип = Object.getPrototypeOf(ползунок)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    найденоRusFunc = ЛОЖЬ
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof ползунок[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
                найденоRusFunc = ИСТИНА
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof ползунок.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = ползунок.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Проверка русских методов:")
    русскиеМетоды = [
        "Значение", "УстановитьЗначение",
        "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум",
        "Шаг", "УстановитьШаг", "ШагСтраницы", "УстановитьШагСтраницы",
        "Ориентация", "УстановитьОриентацию",
        "Положение", "УстановитьПоложение",
        "Отслеживание", "УстановитьОтслеживание",
        "ИнвертированныйВид", "УстановитьИнвертированныйВид",
        "ИнтервалМеток", "УстановитьИнтервалМеток",
        "ПоложениеМеток", "УстановитьПоложениеМеток",
        "Действителен", "Показать", "Скрыть"
    ]
    найдено = 0
    Для i = 0 По русскиеМетоды.length - 1 Цикл
        имя = русскиеМетоды[i]
        Если typeof ползунок[имя] === 'function' Тогда
            найдено = найдено + 1
            ВывестиСтрокуВКонсоль("  ✓ " + имя + "()")
        Иначе
            ВывестиСтрокуВКонсоль("  ✗ " + имя + "() - НЕ ДОСТУПЕН")
        КонецЕсли
    КонецЦикла
    ВывестиСтрокуВКонсоль("  Итого: " + найдено + " из " + русскиеМетоды.length + " русских методов доступно")
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtПолзунок (QtSlider)
// ============================================================

Функция ТестQtSliderFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    ползунок = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        ползунок = НовыйОбъект("QtПолзунок")
        Если ползунок == null Тогда
            ползунок = new QtSlider()
        КонецЕсли
        
        Если ползунок != null Тогда
            ползунок.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПолзунок создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПолзунок НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если ползунок == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ползунок не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = ползунок.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = ползунок.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. ЗНАЧЕНИЕ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setValue/value"
    УстановитьЦветКонсоли("yellow")
