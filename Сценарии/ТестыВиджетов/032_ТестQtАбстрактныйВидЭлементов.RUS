        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Доступность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка доступности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            itemView.УстановитьДоступность(ЛОЖЬ)
            доступенРус = itemView.Доступен()
            itemView.УстановитьДоступность(ИСТИНА)
            доступенРус2 = itemView.Доступен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступность: false->" + доступенРус + ", true->" + доступенРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И доступенРус == ЛОЖЬ И доступенРус2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка доступности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 12. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setVisible/isVisible"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Видимость")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        itemView.setVisible(false)
        видим = itemView.isVisible()
        itemView.setVisible(true)
        видим2 = itemView.isVisible()
        ВывестиСтрокуВКонсоль("    [ENG] setVisible: false->" + видим + ", true->" + видим2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Видимость работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка видимости")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            itemView.УстановитьВидимость(ЛОЖЬ)
            видимРус = itemView.Видим()
            itemView.УстановитьВидимость(ИСТИНА)
            видимРус2 = itemView.Видим()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВидимость: false->" + видимРус + ", true->" + видимРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И видимРус == ЛОЖЬ И видимРус2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка видимости")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 13. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setToolTip/toolTip"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Подсказка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    тестПодсказка = "ItemView ToolTip"
    тестПодсказкаРус = "Подсказка вида элементов"
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        itemView.setToolTip(тестПодсказка)
        подсказка = itemView.toolTip()
        ВывестиСтрокуВКонсоль("    [ENG] setToolTip/toolTip: '" + подсказка + "' (ожидается '" + тестПодсказка + "')")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И подсказка == тестПодсказка Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Подсказка работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка подсказки")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            itemView.УстановитьПодсказку(тестПодсказкаРус)
            подсказкаРус = itemView.Подсказка()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПодсказку/Подсказка: '" + подсказкаРус + "' (ожидается '" + тестПодсказкаРус + "')")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И подсказкаРус == тестПодсказкаРус Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка подсказки")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 14. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setStyleSheet/styleSheet"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Стиль")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        itemView.setStyleSheet("QAbstractItemView { background-color: #f0f0f0; }")
        стиль = itemView.styleSheet()
        ВывестиСтрокуВКонсоль("    [ENG] setStyleSheet/styleSheet: '" + стиль + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И стиль != "" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Стиль работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка стиля")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            itemView.УстановитьСтиль("QAbstractItemView { background-color: #e0e0e0; }")
            стильРус = itemView.Стиль()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСтиль/Стиль: '" + стильРус + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И стильРус != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка стиля")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 15. ПОЛУЧЕНИЕ РЕАЛЬНОГО ВИДЖЕТА (ПРОПУЩЕН) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "getRealWidget/ПолучитьОбъект (пропущен)"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Получение реального виджета (пропущен - абстрактный класс)")
    СброситьЦветКонсоли()
    
    // Пропускаем тест, так как абстрактный класс не имеет реального объекта
    англУспех = ИСТИНА
    русУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
    успешноРус = успешноРус + 1
    ВывестиСтрокуВКонсоль("    ⚠️ [ENG] Тест пропущен - абстрактный класс")
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Тест пропущен - абстрактный класс")
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    Для i = 0 По названияТестов.length - 1 Цикл
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + (i+1) + "    │ " + названияТестов[i] + " " + англСтатус + "        │ " + названияТестов[i] + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtAbstractItemView завершён"
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtAbstractItemView (QtАбстрактныйВидЭлементов)    ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtAbstractItemView()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
