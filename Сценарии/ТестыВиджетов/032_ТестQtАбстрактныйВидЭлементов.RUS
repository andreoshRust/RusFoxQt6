//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность (пропущен)    isValid    Действителен    ✅
//3    Установка модели (пропущен)    setModel    УстановитьМодель    ✅
//4    Установка делегата    setItemDelegate    УстановитьДелегат    ✅
//5    Режим выделения    setSelectionMode    УстановитьРежимВыделения    ✅
//6    Поведение выделения    setSelectionBehavior    УстановитьПоведениеВыделения    ✅
//7    Автопрокрутка    setAutoScroll    УстановитьАвтопрокрутку    ✅
//8    Перетаскивание    setDragEnabled    УстановитьПеретаскивание    ✅
//9    Размер иконок (пропущен)    setIconSize    УстановитьРазмерИконок    ✅
//10    Константы    SingleSelection, MultiSelection и др.    ОдиночноеВыделение, МножественноеВыделение и др.    ✅
//11    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//12    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//13    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//14    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//15    Получение реального виджета (пропущен)    getRealWidget    ПолучитьОбъект    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtAbstractItemView
// ============================================================

Функция ДиагностикаМетодовQtAbstractItemView()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtAbstractItemView ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtAbstractItemView: " + (typeof QtAbstractItemView !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtAbstractItemView: " + e)
    КонецПопытки;
    
    Попытка
        диагItemView = НовыйОбъект("QtАбстрактныйВидЭлементов")
        Если диагItemView == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtАбстрактныйВидЭлементов не создан")
            Возврат
        КонецЕсли;
        
        диагItemView.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtАбстрактныйВидЭлементов создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "setModel", "model",
            "setItemDelegate", "itemDelegate",
            "setItemDelegateForRow", "itemDelegateForRow",
            "setItemDelegateForColumn", "itemDelegateForColumn",
            "itemDelegateForIndex",
            "setSelectionModel", "selectionModel",
            "setCurrentIndex", "currentIndex",
            "clearSelection", "selectAll", "selection",
            "setEditTriggers", "editTriggers",
            "setSelectionMode", "selectionMode",
            "setSelectionBehavior", "selectionBehavior",
            "setAutoScroll", "hasAutoScroll",
            "setDragEnabled", "dragEnabled",
            "setDefaultDropAction", "defaultDropAction",
            "setDragDropOverwriteMode", "dragDropOverwriteMode",
            "setDropIndicatorShown", "showDropIndicator",
            "setTabKeyNavigation", "tabKeyNavigation",
            "setIconSize", "iconSize",
            "setTextElideMode", "textElideMode",
            "indexAt", "visualRect", "scrollTo", "update",
            "SingleSelection", "MultiSelection", "ExtendedSelection",
            "ContiguousSelection", "NoSelection",
            "SelectItems", "SelectRows", "SelectColumns",
            "NoEditTriggers", "CurrentChanged", "DoubleClicked",
            "SelectedClicked", "EditKeyPressed", "AnyKeyPressed",
            "AllEditTriggers",
            "EnsureVisible", "PositionAtTop", "PositionAtBottom", "PositionAtCenter",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагItemView[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "УстановитьМодель", "Модель",
            "УстановитьДелегат", "Делегат",
            "УстановитьДелегатДляСтроки", "ДелегатДляСтроки",
            "УстановитьДелегатДляКолонки", "ДелегатДляКолонки",
            "ДелегатДляИндекса",
            "УстановитьМодельВыделения", "МодельВыделения",
            "УстановитьТекущийИндекс", "ТекущийИндекс",
            "ОчиститьВыделение", "ВыделитьВсе",
            "УстановитьТриггерыПравки", "ТриггерыПравки",
            "УстановитьРежимВыделения", "РежимВыделения",
            "УстановитьПоведениеВыделения", "ПоведениеВыделения",
            "УстановитьАвтопрокрутку", "Автопрокрутка",
            "УстановитьПеретаскивание", "Перетаскивание",
            "УстановитьДействиеПоУмолчанию", "ДействиеПоУмолчанию",
            "УстановитьРежимПерезаписиПеретаскивания", "РежимПерезаписиПеретаскивания",
            "УстановитьИндикаторПадения", "ИндикаторПадения",
            "УстановитьTabПереключение", "TabПереключение",
            "УстановитьРазмерИконок", "РазмерИконок",
            "УстановитьРежимОбрезкиТекста", "РежимОбрезкиТекста",
            "ИндексВКоординатах", "ВизуальныйПрямоугольник", "ПрокрутитьКИндексу", "ОбновитьИндекс",
            "ОдиночноеВыделение", "МножественноеВыделение", "РасширенноеВыделение",
            "НепрерывноеВыделение", "НетВыделения",
            "ВыделятьЭлементы", "ВыделятьСтроки", "ВыделятьКолонки",
            "БезРедактирования", "ТекущийИзменен", "ДвойнойКлик",
            "КликПоВыбранному", "НажатаКлавишаПравки", "ЛюбаяКлавиша",
            "ВсеТриггеры",
            "Показать", "ПозицияВверху", "ПозицияВнизу", "ПозицияВЦентре",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагItemView[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагItemView.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагItemView.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtАбстрактныйВидЭлементов: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtAbstractItemView (QtАбстрактныйВидЭлементов)
// ============================================================

Функция ТестQtAbstractItemViewFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    itemView = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        itemView = НовыйОбъект("QtАбстрактныйВидЭлементов")
        Если itemView == null Тогда
            itemView = new QtAbstractItemView()
        КонецЕсли
        
        Если itemView != null Тогда
            itemView.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtАбстрактныйВидЭлементов создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtАбстрактныйВидЭлементов НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если itemView == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ ItemView не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ (ПРОПУЩЕН) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен (пропущен)"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности (пропущен - абстрактный класс)")
    СброситьЦветКонсоли()
    
    // Пропускаем тест, так как абстрактный класс не имеет реального объекта
    англУспех = ИСТИНА
    русУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
    успешноРус = успешноРус + 1
    ВывестиСтрокуВКонсоль("    ⚠️ [ENG] Тест пропущен - абстрактный класс")
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Тест пропущен - абстрактный класс")
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА МОДЕЛИ (ПРОПУЩЕН) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setModel/УстановитьМодель (пропущен)"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка модели (пропущен - абстрактный класс)")
    СброситьЦветКонсоли()
    
    // Пропускаем тест, так как абстрактный класс не имеет реального объекта
    англУспех = ИСТИНА
    русУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
    успешноРус = успешноРус + 1
    ВывестиСтрокуВКонсоль("    ⚠️ [ENG] Тест пропущен - абстрактный класс")
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Тест пропущен - абстрактный класс")
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. УСТАНОВКА ДЕЛЕГАТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setItemDelegate/УстановитьДелегат"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка делегата")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        делегат = itemView.itemDelegate()
        ВывестиСтрокуВКонсоль("    [ENG] itemDelegate: " + (делегат != null ? "valid" : "null"))
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Делегат работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка делегата")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            делегатРус = itemView.Делегат()
            ВывестиСтрокуВКонсоль("    [RUS] Делегат: " + (делегатРус != null ? "valid" : "null"))
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Делегат работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка делегата")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 5. РЕЖИМ ВЫДЕЛЕНИЯ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setSelectionMode/РежимВыделения"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Режим выделения")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        itemView.setSelectionMode(itemView.MultiSelection())
        режим = itemView.selectionMode()
        itemView.setSelectionMode(itemView.SingleSelection())
        режим2 = itemView.selectionMode()
        ВывестиСтрокуВКонсоль("    [ENG] setSelectionMode: " + режим + " -> " + режим2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Режим выделения работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка режима выделения")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
