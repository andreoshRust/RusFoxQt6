// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПрогрессБар
// ============================================================

Функция ДиагностикаМетодовQtProgressBar()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПрогрессБар ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПрогрессБар: " + (typeof QtПрогрессБар !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПрогрессБар: " + e)
    КонецПопытки;
    
    Попытка
        диагПрогресс = Новый QtПрогрессБар()
        Если диагПрогресс == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПрогрессБар не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtПрогрессБар создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "value", "setValue", "reset",
            "minimum", "setMinimum", "maximum", "setMaximum", "setRange",
            "text", "setText", "format", "setFormat",
            "textVisible", "setTextVisible",
            "setStyleSheet", "styleSheet",
            "alignment", "setAlignment",
            "invertedAppearance", "setInvertedAppearance",
            "orientation", "setOrientation",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "isValid", "getWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрогресс[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Значение", "УстановитьЗначение", "Сбросить",
            "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум", "УстановитьДиапазон",
            "Текст", "УстановитьТекст", "Формат", "УстановитьФормат",
            "ТекстВидим", "УстановитьТекстВидим",
            "УстановитьСтиль", "Стиль",
            "Выравнивание", "УстановитьВыравнивание",
            "ИнвертированныйВид", "УстановитьИнвертированныйВид",
            "Ориентация", "УстановитьОриентацию",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьФокус", "ЕстьФокус",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПрогресс[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПрогресс.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПрогресс.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПрогрессБар: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПрогрессБар
// ============================================================

Функция ДиагностикаМетаОбъектаProgressBar()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПрогрессБар ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtProgressBar: " + (typeof QtProgressBar !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПрогрессБар: " + (typeof QtПрогрессБар !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        прогресс = НовыйОбъект("QtПрогрессБар")
        Если прогресс == null Тогда
            прогресс = new QtProgressBar()
            Если прогресс == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtProgressBar()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПрогрессБар:")
    методы = Object.getOwnPropertyNames(прогресс)
    прототип = Object.getPrototypeOf(прогресс)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof прогресс[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof прогресс.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = прогресс.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ТЕСТ QtПрогрессБар
// ============================================================

Функция ТестQtProgressBarFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    прогресс = null
    Попытка
        прогресс = Новый QtПрогрессБар()
        Если прогресс != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПрогрессБар создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПрогрессБар НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если прогресс == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = прогресс.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    КонецПопытки

    // ===== 3. ЗНАЧЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Значение")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьДиапазон(0, 100)
        прогресс.УстановитьЗначение(50)
        значение = прогресс.Значение()
        ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗначение/Значение: " + значение + " (ожидается 50)")
        Если значение == 50 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Значение работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 50, получено " + значение)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 4. ДИАПАЗОН =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Диапазон")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьДиапазон(10, 90)
        минимум = прогресс.Минимум()
        максимум = прогресс.Максимум()
        ВывестиСтрокуВКонсоль("    [RUS] Диапазон: мин=" + минимум + ", макс=" + максимум + " (ожидается 10, 90)")
        Если минимум == 10 И максимум == 90 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Диапазон работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10, 90")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 5. ФОРМАТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Формат")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьФормат("%p%")
        формат = прогресс.Формат()
        текст = прогресс.Текст()
        ВывестиСтрокуВКонсоль("    [RUS] Формат='" + формат + "', Текст='" + текст + "'")
        Если формат == "%p%" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Формат работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается '%p%'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 6. УСТАНОВКА ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Установка текста")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьТекст("Загрузка... %p%")
        формат = прогресс.Формат()
        текст = прогресс.Текст()
        ВывестиСтрокуВКонсоль("    [RUS] Формат='" + формат + "', Текст='" + текст + "'")
        Если формат == "Загрузка... %p%" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Установка текста работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Загрузка... %p%'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 7. ВИДИМОСТЬ ТЕКСТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Видимость текста")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьТекстВидим(ЛОЖЬ)
        видим = прогресс.ТекстВидим()
        прогресс.УстановитьТекстВидим(ИСТИНА)
        видим2 = прогресс.ТекстВидим()
        ВывестиСтрокуВКонсоль("    [RUS] ТекстВидим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость текста работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 8. ВЫРАВНИВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Выравнивание")
    СброситьЦветКонсоли()
    
    Попытка
        AlignCenter = 0x0004
        прогресс.УстановитьВыравнивание(AlignCenter)
        выравнивание = прогресс.Выравнивание()
        ВывестиСтрокуВКонсоль("    [RUS] Выравнивание: " + выравнивание + " (ожидается " + AlignCenter + ")")
        Если выравнивание == AlignCenter Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Выравнивание работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается " + AlignCenter)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 9. ОРИЕНТАЦИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Ориентация")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьОриентацию(1) // Vertical
        ориентация = прогресс.Ориентация()
        прогресс.УстановитьОриентацию(0) // Horizontal
        ориентация2 = прогресс.Ориентация()
        ВывестиСтрокуВКонсоль("    [RUS] Ориентация: 1->" + ориентация + ", 0->" + ориентация2)
        Если ориентация == 1 И ориентация2 == 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Ориентация работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 1 -> 0")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 10. ИНВЕРТИРОВАННЫЙ ВИД =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Инвертированный вид")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьИнвертированныйВид(ИСТИНА)
        инверт = прогресс.ИнвертированныйВид()
        прогресс.УстановитьИнвертированныйВид(ЛОЖЬ)
        инверт2 = прогресс.ИнвертированныйВид()
        ВывестиСтрокуВКонсоль("    [RUS] ИнвертированныйВид: true->" + инверт + ", false->" + инверт2)
        Если инверт == ИСТИНА И инверт2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Инвертированный вид работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true -> false")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

// ===== 11. СБРОС =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 11: Сброс")
СброситьЦветКонсоли()

Попытка
    // Устанавливаем диапазон с минимумом 0
    прогресс.УстановитьДиапазон(0, 100)
    прогресс.УстановитьЗначение(75)
    прогресс.Сбросить()
    значение = прогресс.Значение()
    ВывестиСтрокуВКонсоль("    [RUS] После Сбросить: значение=" + значение)
    
    // Проверяем различные варианты поведения reset()
    минимум = прогресс.Минимум()
    Если значение == 0 ИЛИ значение == минимум ИЛИ значение == -1 Тогда
        ВывестиСтрокуВКонсоль("    ✓ [RUS] Сброс работает (значение=" + значение + ")")
        успешноТестов = успешноТестов + 1
    Иначе
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0, " + минимум + " или -1, получено " + значение)
    КонецЕсли
Исключение
    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
КонецПопытки


    // ===== 12. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьДоступность(ЛОЖЬ)
        доступен = прогресс.Доступен()
        прогресс.УстановитьДоступность(ИСТИНА)
        доступен2 = прогресс.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 13. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьВидимость(ЛОЖЬ)
        видим = прогресс.Видим()
        прогресс.УстановитьВидимость(ИСТИНА)
        видим2 = прогресс.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 14. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьПодсказку("Тест подсказка")
        подсказка = прогресс.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тест подсказка')")
        Если подсказка == "Тест подсказка" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест подсказка'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 15. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        прогресс.УстановитьСтиль("color: red;")
        стиль = прогресс.Стиль()
        ВывестиСтрокуВКонсоль("    [RUS] Стиль: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'red'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 16. СИГНАЛ (пропущен) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Сигналы (пропущен)")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("    ⚠️ Тест пропущен - QProgressBar не имеет собственных сигналов")
    ВывестиСтрокуВКонсоль("    ✓ [RUS] Тест пропущен (не критично)")
    успешноТестов = успешноТестов + 1

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtПрогрессБар: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtПрогрессБар: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПрогрессБар завершён"
КонецФункции

