        сортировка = список.isSortingEnabled()
        список.setSortingEnabled(false)
        ВывестиСтрокуВКонсоль("    [ENG] setSortingEnabled(true): isSortingEnabled=" + сортировка + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И сортировка == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Сортировка работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            список.clear()
            список.ДобавитьЭлементы(["Z", "A", "M", "B"])
            список.УстановитьСортировку(ИСТИНА)
            сортировкаРус = список.СортировкаВключена()
            список.УстановитьСортировку(ЛОЖЬ)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьСортировку(true): СортировкаВключена=" + сортировкаРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И сортировкаРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Сортировка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    // ===== 11. УПРАВЛЕНИЕ ВИДИМОСТЬЮ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Управление видимостью")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        список.setVisible(false)
        видим = список.isVisible()
        список.setVisible(true)
        видим2 = список.isVisible()
        ВывестиСтрокуВКонсоль("    [ENG] setVisible(false): isVisible=" + видим + ", setVisible(true): isVisible=" + видим2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Управление видимостью работает")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false, затем true")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            список.УстановитьВидимость(ЛОЖЬ)
            видимРус = список.Видим()
            список.УстановитьВидимость(ИСТИНА)
            видимРус2 = список.Видим()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьВидимость(false): Видим=" + видимРус + ", УстановитьВидимость(true): Видим=" + видимРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки;
        
        Если тестРусский И видимРус == ЛОЖЬ И видимРус2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Управление видимостью работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false, затем true")
            СброситьЦветКонсоли()
        КонецЕсли;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    // ===== 12. ПОДСКАЗКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Подсказки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    тестПодсказка = "Тестовая подсказка"
    тестПодсказка2 = "Новая подсказка"
    
    // --- АНГЛИЙСКИЙ МЕТОД ---
    Попытка
        список.setToolTip(тестПодсказка)
        подсказка = список.toolTip()
        список.setToolTip(тестПодсказка2)
        подсказка2 = список.toolTip()
        ВывестиСтрокуВКонсоль("    [ENG] setToolTip: '" + подсказка + "' -> '" + подсказка2 + "'")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки;
    
    Если тестПройден И подсказка == тестПодсказка И подсказка2 == тестПодсказка2 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Подсказки работают")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается '" + тестПодсказка + "', затем '" + тестПодсказка2 + "'")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли;
    
    // --- РУССКИЙ МЕТОД ---
    Если тестПройден Тогда
        Попытка
            список.УстановитьПодсказку(тестПодсказка)
            подсказкаРус = список.Подсказка()
            список.УстановитьПодсказку(тестПодсказка2)
            подсказкаРус2 = список.Подсказка()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьПодсказку: '" + подсказкаРус + "' -> '" + подсказкаРус2 + "'")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки;
        
        Если тестРусский И подсказкаРус == тестПодсказка И подсказкаРус2 == тестПодсказка2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказки работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается '" + тестПодсказка + "', затем '" + тестПодсказка2 + "'")
            СброситьЦветКонсоли()
        КонецЕсли;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtСписокЭлементов: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtСписокЭлементов: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtСписокЭлементов завершён"
КонецФункции

