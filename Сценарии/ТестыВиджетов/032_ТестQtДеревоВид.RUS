//Список протестированных методов:
//№    Тест    Английский метод    Русский метод    Статус
//1    Создание объекта    -    -    ✅
//2    Действительность    isValid    Действителен    ✅
//3    Установка модели (пропущен)    setModel    УстановитьМодель    ✅
//4    Чередование цветов строк    setAlternatingRowColors    УстановитьЧередованиеЦветовСтрок    ✅
//5    Сортировка    setSortingEnabled    УстановитьСортировку    ✅
//6    Отступ    setIndentation    УстановитьОтступ    ✅
//7    Анимация    setAnimated    УстановитьАнимацию    ✅
//8    Перенос слов    setWordWrap    УстановитьПереносСлов    ✅
//9    Раскрытие и свертывание    expand/collapse/expandAll/collapseAll    Раскрыть/Свернуть/РаскрытьВсе/СвернутьВсе    ✅
//10    Выделение    clearSelection/selectAll    СнятьВыделение/ВыделитьВсе    ✅
//11    Очистка    clear    Очистить    ✅
//12    Доступность    setEnabled/isEnabled    УстановитьДоступность/Доступен    ✅
//13    Видимость    setVisible/isVisible    УстановитьВидимость/Видим    ✅
//14    Подсказка    setToolTip/toolTip    УстановитьПодсказку/Подсказка    ✅
//15    Стиль    setStyleSheet/styleSheet    УстановитьСтиль/Стиль    ✅
//16    Получение реального виджета    getRealWidget    ПолучитьОбъект

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtTreeView
// ============================================================

Функция ДиагностикаМетодовQtTreeView()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtTreeView ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtTreeView: " + (typeof QtTreeView !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtTreeView: " + e)
    КонецПопытки;
    
    Попытка
        диагTreeView = НовыйОбъект("QtДеревоВид")
        Если диагTreeView == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДеревоВид не создан")
            Возврат
        КонецЕсли;
        
        диагTreeView.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДеревоВид создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealWidget", "getRealObject", "copyTo",
            "setAlternatingRowColors", "alternatingRowColors",
            "setSortingEnabled", "isSortingEnabled",
            "setIndentation", "indentation",
            "setRootIsDecorated", "rootIsDecorated",
            "setUniformRowHeights", "uniformRowHeights",
            "setAnimated", "isAnimated",
            "setItemsExpandable", "itemsExpandable",
            "setExpandsOnDoubleClick", "expandsOnDoubleClick",
            "setTreePosition", "treePosition",
            "setWordWrap", "wordWrap",
            "header", "setHeader",
            "expand", "collapse", "expandAll", "collapseAll",
            "expandToDepth", "expandRecursively", "isExpanded",
            "clearSelection", "selectAll",
            "clear",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setMinimumSize", "setMaximumSize",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTreeView[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбъект", "КопироватьВ",
            "УстановитьЧередованиеЦветовСтрок", "ЧередованиеЦветовСтрок",
            "УстановитьСортировку", "Сортировка",
            "УстановитьОтступ", "Отступ",
            "УстановитьДекорациюКорня", "ДекорацияКорня",
            "УстановитьЕдинуюВысотуСтрок", "ЕдинаяВысотаСтрок",
            "УстановитьАнимацию", "Анимация",
            "УстановитьРаскрываемостьЭлементов", "РаскрываемостьЭлементов",
            "УстановитьРаскрытиеПоДвойномуКлику", "РаскрытиеПоДвойномуКлику",
            "УстановитьПозициюДерева", "ПозицияДерева",
            "УстановитьПереносСлов", "ПереносСлов",
            "Заголовок", "УстановитьЗаголовок",
            "Раскрыть", "Свернуть", "РаскрытьВсе", "СвернутьВсе",
            "РаскрытьДоГлубины", "РаскрытьРекурсивно", "Раскрыт",
            "СнятьВыделение", "ВыделитьВсе",
            "Очистить",
            "Стиль", "УстановитьСтиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьМинимальныйРазмер", "УстановитьМаксимальныйРазмер",
            "Доступен", "УстановитьДоступность",
            "Видим", "УстановитьВидимость", "Показать", "Скрыть",
            "Подсказка", "УстановитьПодсказку", "ЧтоЭто", "УстановитьЧтоЭто",
            "ЕстьФокус", "УстановитьФокус"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTreeView[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагTreeView.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагTreeView.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДеревоВид: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtTreeView (QtДеревоВид)
// ============================================================

Функция ТестQtTreeViewFull()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    англРезультаты = []
    русРезультаты = []
    названияТестов = []
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Создание объекта"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    treeView = null
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        treeView = НовыйОбъект("QtДеревоВид")
        Если treeView == null Тогда
            treeView = new QtTreeView()
        КонецЕсли
        
        Если treeView != null Тогда
            treeView.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДеревоВид создан")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            русУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДеревоВид НЕ создан")
            СброситьЦветКонсоли()
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
    КонецПопытки
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    Если treeView == null Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ TreeView не создан, дальнейшие тесты пропущены")
        СброситьЦветКонсоли()
        Возврат "Тест прерван"
    КонецЕсли

    // ===== 2. ДЕЙСТВИТЕЛЬНОСТЬ =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "isValid/Действителен"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        валид = treeView.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валид + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валид == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка действительности")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            валидРус = treeView.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действительность работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка действительности")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 3. УСТАНОВКА МОДЕЛИ (ПРОПУЩЕН) =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "Установка модели (пропущен)"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка модели (пропущен - требуется QtStandardItemModel)")
    СброситьЦветКонсоли()
    
    англУспех = ИСТИНА
    русУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
    успешноРус = успешноРус + 1
    ВывестиСтрокуВКонсоль("    ⚠️ [ENG] Тест пропущен - требуется QtStandardItemModel")
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Тест пропущен - требуется QtStandardItemModel")
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 4. ЧЕРЕДОВАНИЕ ЦВЕТОВ СТРОК =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setAlternatingRowColors/ЧередованиеЦветовСтрок"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Чередование цветов строк")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        treeView.setAlternatingRowColors(true)
        чередование = treeView.alternatingRowColors()
        treeView.setAlternatingRowColors(false)
        чередование2 = treeView.alternatingRowColors()
        ВывестиСтрокуВКонсоль("    [ENG] setAlternatingRowColors: true->" + чередование + ", false->" + чередование2)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И чередование == ИСТИНА И чередование2 == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Чередование цветов строк работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка чередования цветов строк")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли
    
    // --- РУССКИЙ ---
    Если тестПройден Тогда
        Попытка
            treeView.УстановитьЧередованиеЦветовСтрок(ИСТИНА)
            чередованиеРус = treeView.ЧередованиеЦветовСтрок()
            treeView.УстановитьЧередованиеЦветовСтрок(ЛОЖЬ)
            чередованиеРус2 = treeView.ЧередованиеЦветовСтрок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЧередованиеЦветовСтрок: true->" + чередованиеРус + ", false->" + чередованиеРус2)
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И чередованиеРус == ИСТИНА И чередованиеРус2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Чередование цветов строк работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка чередования цветов строк")
            СброситьЦветКонсоли()
            неуспешноРус = неуспешноРус + 1
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
        неуспешноРус = неуспешноРус + 1
    КонецЕсли
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех

    // ===== 5. СОРТИРОВКА =====
    всегоТестов = всегоТестов + 1
    названияТестов[названияТестов.length] = "setSortingEnabled/Сортировка"
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Сортировка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // --- АНГЛИЙСКИЙ ---
    Попытка
        treeView.setSortingEnabled(true)
        сортировка = treeView.isSortingEnabled()
        treeView.setSortingEnabled(false)
        сортировка2 = treeView.isSortingEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setSortingEnabled: true->" + сортировка + ", false->" + сортировка2)
    Исключение
        УстановитьЦветКонсоли("red")
