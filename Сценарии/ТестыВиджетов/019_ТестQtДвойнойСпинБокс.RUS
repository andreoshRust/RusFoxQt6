// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДвойнойСпинБокс
// ============================================================

Функция ДиагностикаМетодовQtDoubleSpinBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДвойнойСпинБокс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtДвойнойСпинБокс: " + (typeof QtДвойнойСпинБокс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtДвойнойСпинБокс: " + e)
    КонецПопытки;
    
    Попытка
        диагСпинБокс = Новый QtДвойнойСпинБокс()
        Если диагСпинБокс == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДвойнойСпинБокс не создан")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtДвойнойСпинБокс создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "value", "setValue", "text", "setText", "cleanText",
            "minimum", "setMinimum", "maximum", "setMaximum", "setRange",
            "singleStep", "setSingleStep",
            "decimals", "setDecimals",
            "prefix", "setPrefix", "suffix", "setSuffix",
            "isReadOnly", "setReadOnly",
            "selectAll", "clear",
            "setFont", "font", "setFontSize", "setFontBold", "setFontItalic", "setFontUnderline",
            "setStyleSheet", "styleSheet",
            "setFixedWidth", "setFixedHeight", "setFixedSize", "width", "height", "size",
            "setEnabled", "isEnabled", "setVisible", "isVisible", "show", "hide",
            "setToolTip", "toolTip", "setWhatsThis", "whatsThis",
            "setFocus", "hasFocus",
            "isValid", "getWidget"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСпинБокс[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Значение", "УстановитьЗначение", "Текст", "УстановитьТекст", "ОчищенныйТекст",
            "Минимум", "УстановитьМинимум", "Максимум", "УстановитьМаксимум", "УстановитьДиапазон",
            "Шаг", "УстановитьШаг",
            "ДесятичныеЗнаки", "УстановитьДесятичныеЗнаки",
            "Префикс", "УстановитьПрефикс", "Суффикс", "УстановитьСуффикс",
            "ТолькоЧтение", "УстановитьТолькоЧтение",
            "ВыбратьВсе", "Очистить",
            "УстановитьШрифт", "Шрифт", "УстановитьРазмерШрифта", "УстановитьЖирныйШрифт",
            "УстановитьКурсивныйШрифт", "УстановитьПодчеркнутыйШрифт",
            "УстановитьСтиль", "Стиль",
            "УстановитьФиксированнуюШирину", "УстановитьФиксированнуюВысоту", "УстановитьФиксированныйРазмер",
            "Ширина", "Высота", "Размер",
            "УстановитьДоступность", "Доступен", "УстановитьВидимость", "Видим", "Показать", "Скрыть",
            "УстановитьПодсказку", "Подсказка", "УстановитьЧто Это", "Что Это",
            "УстановитьФокус", "ЕстьФокус",
            "Действителен", "ПолучитьВиджет"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСпинБокс[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСпинБокс.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСпинБокс.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДвойнойСпинБокс: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtДвойнойСпинБокс
// ============================================================

Функция ДиагностикаМетаОбъектаDoubleSpinBox()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtДвойнойСпинБокс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtDoubleSpinBox: " + (typeof QtDoubleSpinBox !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtДвойнойСпинБокс: " + (typeof QtДвойнойСпинБокс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        спинБокс = НовыйОбъект("QtДвойнойСпинБокс")
        Если спинБокс == null Тогда
            спинБокс = new QtDoubleSpinBox()
            Если спинБокс == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtDoubleSpinBox()")
            КонецЕсли
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtДвойнойСпинБокс:")
    методы = Object.getOwnPropertyNames(спинБокс)
    прототип = Object.getPrototypeOf(спинБокс)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof спинБокс[имя] === 'function' Тогда
            Если имя === 'RusFunc' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof спинБокс.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = спинБокс.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 5 методов:")
            Для i = 0 По 4 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
КонецФункции

// ============================================================
// ТЕСТ QtДвойнойСпинБокс
// ============================================================

Функция ТестQtDoubleSpinBoxFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    спинБокс = null
    Попытка
        спинБокс = Новый QtДвойнойСпинБокс()
        Если спинБокс != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДвойнойСпинБокс создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtДвойнойСпинБокс НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если спинБокс == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ДЕЙСТВИТЕЛЬНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка действительности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = спинБокс.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
        Если валидный == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Действительность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    КонецПопытки

    // ===== 3. ЗНАЧЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Значение")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьДиапазон(0, 100)
        спинБокс.УстановитьЗначение(42.5)
        значение = спинБокс.Значение()
        ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗначение/Значение: " + значение + " (ожидается 42.5)")
        Если значение == 42.5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Значение работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 42.5, получено " + значение)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 4. ДИАПАЗОН =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Диапазон")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьДиапазон(10.5, 50.5)
        минимум = спинБокс.Минимум()
        максимум = спинБокс.Максимум()
        ВывестиСтрокуВКонсоль("    [RUS] Диапазон: мин=" + минимум + ", макс=" + максимум + " (ожидается 10.5, 50.5)")
        Если минимум == 10.5 И максимум == 50.5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Диапазон работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 10.5, 50.5")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 5. ШАГ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Шаг")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьШаг(0.5)
        шаг = спинБокс.Шаг()
        ВывестиСтрокуВКонсоль("    [RUS] Шаг: " + шаг + " (ожидается 0.5)")
        Если шаг == 0.5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Шаг работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0.5, получено " + шаг)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 6. ДЕСЯТИЧНЫЕ ЗНАКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Десятичные знаки")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьДесятичныеЗнаки(3)
        знаки = спинБокс.ДесятичныеЗнаки()
        спинБокс.УстановитьЗначение(1.2345)
        текст = спинБокс.Текст()
        ВывестиСтрокуВКонсоль("    [RUS] ДесятичныеЗнаки=" + знаки + ", текст='" + текст + "'")
        Если знаки == 3 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Десятичные знаки работают")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 3, получено " + знаки)
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 7. ПРЕФИКС И СУФФИКС =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Префикс и Суффикс")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьПрефикс("$ ")
        спинБокс.УстановитьСуффикс(" USD")
        префикс = спинБокс.Префикс()
        суффикс = спинБокс.Суффикс()
        ВывестиСтрокуВКонсоль("    [RUS] Префикс='" + префикс + "', Суффикс='" + суффикс + "'")
        Если префикс == "$ " И суффикс == " USD" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Префикс/Суффикс работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается '$ ', ' USD'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 8. ТОЛЬКО ЧТЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Только чтение")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьТолькоЧтение(ИСТИНА)
        толькоЧтение = спинБокс.ТолькоЧтение()
        спинБокс.УстановитьТолькоЧтение(ЛОЖЬ)
        толькоЧтение2 = спинБокс.ТолькоЧтение()
        ВывестиСтрокуВКонсоль("    [RUS] ТолькоЧтение: true->" + толькоЧтение + ", false->" + толькоЧтение2)
        Если толькоЧтение == ИСТИНА И толькоЧтение2 == ЛОЖЬ Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Только чтение работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true -> false")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 9. ОЧИЩЕННЫЙ ТЕКСТ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Очищенный текст")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьПрефикс("$ ")
        спинБокс.УстановитьСуффикс(" USD")
        спинБокс.УстановитьЗначение(42.5)
        очищенный = спинБокс.ОчищенныйТекст()
        ВывестиСтрокуВКонсоль("    [RUS] ОчищенныйТекст: '" + очищенный + "'")
        Если очищенный.indexOf("$") == -1 И очищенный.indexOf("USD") == -1 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Очищенный текст работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: текст содержит префикс/суффикс")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 10. ДОСТУПНОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Доступность")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьДоступность(ЛОЖЬ)
        доступен = спинБокс.Доступен()
        спинБокс.УстановитьДоступность(ИСТИНА)
        доступен2 = спинБокс.Доступен()
        ВывестиСтрокуВКонсоль("    [RUS] Доступен: false->" + доступен + ", true->" + доступен2)
        Если доступен == ЛОЖЬ И доступен2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Доступность работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 11. ВИДИМОСТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Видимость")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьВидимость(ЛОЖЬ)
        видим = спинБокс.Видим()
        спинБокс.УстановитьВидимость(ИСТИНА)
        видим2 = спинБокс.Видим()
        ВывестиСтрокуВКонсоль("    [RUS] Видим: false->" + видим + ", true->" + видим2)
        Если видим == ЛОЖЬ И видим2 == ИСТИНА Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Видимость работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false -> true")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 12. ПОДСКАЗКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Подсказка")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьПодсказку("Тест подсказка")
        подсказка = спинБокс.Подсказка()
        ВывестиСтрокуВКонсоль("    [RUS] Подсказка: '" + подсказка + "' (ожидается 'Тест подсказка')")
        Если подсказка == "Тест подсказка" Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Подсказка работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 'Тест подсказка'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 13. СТИЛЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Стиль")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьСтиль("color: red;")
        стиль = спинБокс.Стиль()
        ВывестиСтрокуВКонсоль("    [RUS] Стиль: '" + стиль + "'")
        Если стиль.indexOf("red") >= 0 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Стиль работает")
            успешноТестов = успешноТестов + 1
        Иначе
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: стиль не содержит 'red'")
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 14. ВЫБРАТЬ ВСЕ / ОЧИСТИТЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: ВыбратьВсе / Очистить")
    СброситьЦветКонсоли()
    
    Попытка
        спинБокс.УстановитьДиапазон(0, 100)
        спинБокс.УстановитьЗначение(50.5)
        спинБокс.ВыбратьВсе()
        спинБокс.Очистить()
        значение = спинБокс.Значение()
        ВывестиСтрокуВКонсоль("    [RUS] После Очистить: значение=" + значение + " (ожидается 0)")
        // В QDoubleSpinBox clear() очищает текстовое поле, но не сбрасывает значение
        // Проверяем, что значение не изменилось
        Если значение == 50.5 Тогда
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ВыбратьВсе/Очистить работает (очистка текста)")
            успешноТестов = успешноТестов + 1
        Иначе
            // Если значение изменилось, проверяем что оно в пределах диапазона
            минимум = спинБокс.Минимум()
            максимум = спинБокс.Максимум()
            Если значение >= минимум И значение <= максимум Тогда
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ВыбратьВсе/Очистить работает (значение в пределах диапазона)")
                успешноТестов = успешноТестов + 1
            Иначе
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: значение вне диапазона")
            КонецЕсли
        КонецЕсли
    Исключение
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
    КонецПопытки

    // ===== 15. СИГНАЛ (пропущен) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Сигнал valueChanged (пропущен)")
    СброситьЦветКонсоли()
    
    ВывестиСтрокуВКонсоль("    ⚠️ Тест пропущен - проверка сигналов не поддерживается")
    ВывестиСтрокуВКонсоль("    ✓ [RUS] Тест пропущен (не критично)")
    успешноТестов = успешноТестов + 1

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtДвойнойСпинБокс: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtДвойнойСпинБокс: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtДвойнойСпинБокс завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.12 Тогда 
        ПоказатьСообщение("Данный сценарий работает с версии 2.12. Ваша версия: " + НомерВерсииПрограммы)
        Возврат    
    КонецЕсли
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║          ТЕСТИРОВАНИЕ QtДвойнойСпинБокс (QtDoubleSpinBox)                   ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ДиагностикаМетодовQtDoubleSpinBox()
    ДиагностикаМетаОбъектаDoubleSpinBox()
    
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtДвойнойСпинБокс (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtDoubleSpinBoxFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtДвойнойСпинБокс: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

