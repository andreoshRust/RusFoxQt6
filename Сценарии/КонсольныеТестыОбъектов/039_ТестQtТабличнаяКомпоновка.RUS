//Что было проверено:
//✅ Создание объекта - Новый QtТабличнаяКомпоновка(виджет)
//✅ Валидность - isValid() / Действителен()
//✅ Количество строк и колонок - rowCount() / columnCount() и их русские аналоги
//✅ Промежутки - горизонтальные и вертикальные, установка и получение
//✅ Добавление виджетов - addWidget() / ДобавитьВиджет()
//✅ Растяжение - строк и колонок, установка и получение
//✅ Отступы и доступность - setMargin() / setEnabled() и их русские аналоги
//✅ Реальные объекты - getRealGridLayout() / getRealLayout() и их русские аналоги
//✅ Упрощённые методы добавления - addWidgetSimple() / addWidgetAlignment() и их русские аналоги
//✅ Минимальные размеры - setRowMinimumHeight() / setColumnMinimumWidth() и их русские аналоги



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtТабличнаяКомпоновка
// ============================================================

Функция ДиагностикаМетодовQtGridLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtТабличнаяКомпоновка ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtТабличнаяКомпоновка: " + (typeof QtТабличнаяКомпоновка !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtТабличнаяКомпоновка: " + e)
    КонецПопытки;
    
    Попытка
        диагВиджет = Новый QtВиджет()
        диагВиджет.Показать()
        диагLayout = Новый QtТабличнаяКомпоновка(диагВиджет)
        
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtТабличнаяКомпоновка не создан")
            Возврат
        КонецЕсли;
        
        диагLayout.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtТабличнаяКомпоновка создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealGridLayout", "getRealLayout",
            "rowCount", "columnCount",
            "horizontalSpacing", "setHorizontalSpacing",
            "verticalSpacing", "setVerticalSpacing",
            "addWidget", "addWidgetSimple", "addWidgetAlignment",
            "addLayout",
            "setRowStretch", "rowStretch",
            "setColumnStretch", "columnStretch",
            "setRowMinimumHeight", "setColumnMinimumWidth",
            "itemAtPosition", "itemAt", "takeAt",
            "count", "isEmpty", "geometry", "contentsRect",
            "setMargin", "margin",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьТабличнуюКомпоновку", "ПолучитьРасположение",
            "КоличествоСтрок", "КоличествоКолонок",
            "ГоризонтальныйПромежуток", "УстановитьГоризонтальныйПромежуток",
            "ВертикальныйПромежуток", "УстановитьВертикальныйПромежуток",
            "ДобавитьВиджет", "ДобавитьВиджетПростой", "ДобавитьВиджетСВыравниванием",
            "ДобавитьРасположение",
            "УстановитьРастяжениеСтроки", "РастяжениеСтроки",
            "УстановитьРастяжениеКолонки", "РастяжениеКолонки",
            "УстановитьМинимальнуюВысотуСтроки", "УстановитьМинимальнуюШиринуКолонки",
            "ЭлементПоПозиции", "ЭлементПоИндексу", "ВзятьПоИндексу",
            "Количество", "Пустой", "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьДоступен", "Доступен",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
        диагВиджет.Скрыть()
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtТабличнаяКомпоновка: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtТабличнаяКомпоновка
// ============================================================

Функция ТестQtGridLayout()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    виджет = Новый QtВиджет()
    виджет.Показать()
    сетка = null
    Попытка
        сетка = Новый QtТабличнаяКомпоновка(виджет)
        сетка.РежимОтладки(ИСТИНА)
        Если сетка != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtТабличнаяКомпоновка создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = сетка.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = сетка.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: rowCount() / columnCount() / КоличествоСтрок() / КоличествоКолонок() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Количество строк и колонок")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        строк = сетка.rowCount()
        колонок = сетка.columnCount()
        ВывестиСтрокуВКонсоль("    [ENG] rowCount()=" + строк + ", columnCount()=" + колонок)
        
        Если строк >= 0 И колонок >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] rowCount()/columnCount() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] rowCount()/columnCount() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            строкРус = сетка.КоличествоСтрок()
            колонокРус = сетка.КоличествоКолонок()
            ВывестиСтрокуВКонсоль("    [RUS] КоличествоСтрок()=" + строкРус + ", КоличествоКолонок()=" + колонокРус)
            
            Если строкРус >= 0 И колонокРус >= 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] КоличествоСтрок()/КоличествоКолонок() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] КоличествоСтрок()/КоличествоКолонок() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: setHorizontalSpacing() / setVerticalSpacing() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка промежутков")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        сетка.setHorizontalSpacing(10)
        гориз = сетка.horizontalSpacing()
        сетка.setVerticalSpacing(5)
        верт = сетка.verticalSpacing()
        ВывестиСтрокуВКонсоль("    [ENG] horizontalSpacing=" + гориз + ", verticalSpacing=" + верт)
        
        Если гориз == 10 И верт == 5 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setHorizontalSpacing()/setVerticalSpacing() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setHorizontalSpacing()/setVerticalSpacing() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            сетка.УстановитьГоризонтальныйПромежуток(15)
            горизРус = сетка.ГоризонтальныйПромежуток()
            сетка.УстановитьВертикальныйПромежуток(8)
            вертРус = сетка.ВертикальныйПромежуток()
            ВывестиСтрокуВКонсоль("    [RUS] ГоризонтальныйПромежуток=" + горизРус + ", ВертикальныйПромежуток=" + вертРус)
            
            Если горизРус == 15 И вертРус == 8 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьГоризонтальныйПромежуток()/УстановитьВертикальныйПромежуток() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьГоризонтальныйПромежуток()/УстановитьВертикальныйПромежуток() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
