//№    Тест    Статус
//1    Создание объекта (нерекурсивный)    ✅
//2    Проверка валидности    ✅
//3    Проверка рекурсивности    ✅
//4    Блокировка и разблокировка    ✅
//5    Попытка блокировки    ✅
//6    Попытка блокировки с таймаутом    ✅
//7    Константы (nonRecursive/recursive)    ✅
//8    Рекурсивный мьютекс    ✅
//9    Копирование    ✅



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtМьютекс
// ============================================================

Функция ДиагностикаМетодовQtMutex()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtМьютекс ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtМьютекс: " + (typeof QtМьютекс !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtМьютекс: " + e)
    КонецПопытки;
    
    Попытка
        диагМьютекс = Новый QtМьютекс()
        Если диагМьютекс == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtМьютекс не создан")
            Возврат
        КонецЕсли;
        
        диагМьютекс.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtМьютекс создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealMutex", "getRealRecursiveMutex",
            "nonRecursive", "recursive", "isRecursive",
            "lock", "tryLock", "tryLockTimeout", "unlock",
            "copyTo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМьютекс[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьМьютекс", "ПолучитьРекурсивныйМьютекс",
            "Нерекурсивный", "Рекурсивный", "РекурсивныйМьютекс",
            "Заблокировать", "ПопробоватьЗаблокировать", "ПопробоватьЗаблокироватьТаймаут", "Разблокировать",
            "КопироватьВ"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМьютекс[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМьютекс.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМьютекс.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtМьютекс: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtМьютекс
// ============================================================
Функция ТестQtMutexFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА (НЕРЕКУРСИВНЫЙ) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта (нерекурсивный)")
    СброситьЦветКонсоли()
    
    Попытка
        мьютекс = Новый QtМьютекс()
        Если мьютекс != null Тогда
            мьютекс.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtМьютекс создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtМьютекс НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        Возврат "❌ Тест QtМьютекс провален (ошибка создания)"
    КонецПопытки;
    
    Если мьютекс == null Тогда
        Возврат "❌ Тест QtМьютекс провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        валидный = мьютекс.isValid()
        ВывестиСтрокуВКонсоль("    [ENG] isValid: " + валидный + " (ожидается true)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И валидный == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + валидный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            валидныйРус = мьютекс.Действителен()
            ВывестиСтрокуВКонсоль("    [RUS] Действителен: " + валидныйРус + " (ожидается true)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + валидныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 3. ПРОВЕРКА РЕКУРСИВНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка рекурсивности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        рекурсивный = мьютекс.isRecursive()
        ВывестиСтрокуВКонсоль("    [ENG] isRecursive: " + рекурсивный + " (ожидается false)")
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки
    
    Если тестПройден И рекурсивный == ЛОЖЬ Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isRecursive работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается false, получено " + рекурсивный)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецЕсли
    
    Если тестПройден Тогда
        Попытка
            рекурсивныйРус = мьютекс.РекурсивныйМьютекс()
            ВывестиСтрокуВКонсоль("    [RUS] РекурсивныйМьютекс: " + рекурсивныйРус + " (ожидается false)")
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И рекурсивныйРус == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] РекурсивныйМьютекс работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
        ИначеЕсли тестРусский Тогда
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается false, получено " + рекурсивныйРус)
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 4. БЛОКИРОВКА И РАЗБЛОКИРОВКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Блокировка и разблокировка")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        мьютекс.lock()
        мьютекс.unlock()
        ВывестиСтрокуВКонсоль("    [ENG] lock/unlock: выполнено без ошибок")
        англУспех = ИСТИНА
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Блокировка/разблокировка работает")
        СброситьЦветКонсоли()
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            мьютекс.Заблокировать()
            мьютекс.Разблокировать()
            ВывестиСтрокуВКонсоль("    [RUS] Заблокировать/Разблокировать: выполнено без ошибок")
            русУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Блокировка/разблокировка работает")
            СброситьЦветКонсоли()
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 5. ПОПЫТКА БЛОКИРОВКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Попытка блокировки")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        результат = мьютекс.tryLock()
        Если результат == ИСТИНА Тогда
            мьютекс.unlock()
        КонецЕсли
        ВывестиСтрокуВКонсоль("    [ENG] tryLock: " + результат + " (ожидается true)")
        
        Если результат == ИСТИНА Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Попытка блокировки работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + результат)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            результатРус = мьютекс.ПопробоватьЗаблокировать()
            Если результатРус == ИСТИНА Тогда
                мьютекс.Разблокировать()
            КонецЕсли
            ВывестиСтрокуВКонсоль("    [RUS] ПопробоватьЗаблокировать: " + результатРус + " (ожидается true)")
            
            Если результатРус == ИСТИНА Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Попытка блокировки работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + результатРус)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 6. ПОПЫТКА БЛОКИРОВКИ С ТАЙМАУТОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Попытка блокировки с таймаутом")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        результат = мьютекс.tryLockTimeout(100)
        Если результат == ИСТИНА Тогда
            мьютекс.unlock()
        КонецЕсли
        ВывестиСтрокуВКонсоль("    [ENG] tryLockTimeout(100): " + результат + " (ожидается true)")
        
        Если результат == ИСТИНА Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Попытка блокировки с таймаутом работает")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + результат)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            результатРус = мьютекс.ПопробоватьЗаблокироватьТаймаут(100)
            Если результатРус == ИСТИНА Тогда
                мьютекс.Разблокировать()
            КонецЕсли
            ВывестиСтрокуВКонсоль("    [RUS] ПопробоватьЗаблокироватьТаймаут(100): " + результатРус + " (ожидается true)")
            
            Если результатРус == ИСТИНА Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Попытка блокировки с таймаутом работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + результатРус)
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 7. КОНСТАНТЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Константы")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        нерек = мьютекс.nonRecursive()
        рек = мьютекс.recursive()
        ВывестиСтрокуВКонсоль("    [ENG] nonRecursive: " + нерек + ", recursive: " + рек)
        
        Если нерек == 0 И рек == 1 Тогда
            англУспех = ИСТИНА
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] Константы работают")
            СброситьЦветКонсоли()
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается 0 и 1")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            нерекРус = мьютекс.Нерекурсивный()
            рекРус = мьютекс.Рекурсивный()
            ВывестиСтрокуВКонсоль("    [RUS] Нерекурсивный: " + нерекРус + ", Рекурсивный: " + рекРус)
            
            Если нерекРус == 0 И рекРус == 1 Тогда
                русУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Константы работают")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается 0 и 1")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 8. РЕКУРСИВНЫЙ МЬЮТЕКС =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Рекурсивный мьютекс")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    Попытка
        рекурсивныйМьютекс = Новый QtМьютекс(1)
        Если рекурсивныйМьютекс != null Тогда
            рекурсивныйМьютекс.РежимОтладки(ИСТИНА)
            рекурсивныйМьютекс.lock()
            рекурсивныйМьютекс.lock()  // Вторая блокировка рекурсивного мьютекса должна работать
            рекурсивныйМьютекс.unlock()
            рекурсивныйМьютекс.unlock()
            
            рек = рекурсивныйМьютекс.isRecursive()
            ВывестиСтрокуВКонсоль("    [ENG] recursive mutex isRecursive: " + рек + " (ожидается true)")
            
            Если рек == ИСТИНА Тогда
                англУспех = ИСТИНА
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [ENG] Рекурсивный мьютекс работает")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: ожидается true, получено " + рек)
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Рекурсивный мьютекс не создан")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            рекурсивныйМьютексРус = Новый QtМьютекс(1)
            Если рекурсивныйМьютексРус != null Тогда
                рекурсивныйМьютексРус.РежимОтладки(ИСТИНА)
                рекурсивныйМьютексРус.Заблокировать()
                рекурсивныйМьютексРус.Заблокировать()
                рекурсивныйМьютексРус.Разблокировать()
                рекурсивныйМьютексРус.Разблокировать()
                
                рекРус = рекурсивныйМьютексРус.РекурсивныйМьютекс()
                ВывестиСтрокуВКонсоль("    [RUS] РекурсивныйМьютекс: " + рекРус + " (ожидается true)")
                
                Если рекРус == ИСТИНА Тогда
                    русУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [RUS] Рекурсивный мьютекс работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: ожидается true, получено " + рекРус)
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Рекурсивный мьютекс не создан")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли
    
    Если тестРусский И англУспех И русУспех Тогда
        успешноТестов = успешноТестов + 1
    КонецЕсли

    // ===== 9. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Копирование")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ

    Попытка
        копияЦель = НовыйОбъект("QtМьютекс")
        Если копияЦель != null Тогда
            успех = мьютекс.copyTo(копияЦель)
            Если успех Тогда
                валидность = копияЦель.isValid()
                ВывестиСтрокуВКонсоль("    [ENG] copyTo: копия isValid: " + валидность)
                Если валидность == ИСТИНА Тогда
                    англУспех = ИСТИНА
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ [ENG] Копирование работает")
                    СброситьЦветКонсоли()
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [ENG] Копирование не работает")
                    СброситьЦветКонсоли()
                    тестПройден = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo: копирование не удалось")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] Не удалось создать целевой объект")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
    КонецПопытки

    Если тестПройден Тогда
        Попытка
            копияЦельРус = НовыйОбъект("QtМьютекс")
            Если копияЦельРус != null Тогда
                успехРус = мьютекс.КопироватьВ(копияЦельРус)
                Если успехРус Тогда
                    валидностьРус = копияЦельРус.Действителен()
                    ВывестиСтрокуВКонсоль("    [RUS] КопироватьВ: копия Действителен: " + валидностьРус)
                    Если валидностьРус == ИСТИНА Тогда
                        русУспех = ИСТИНА
                        УстановитьЦветКонсоли("green")
                        ВывестиСтрокуВКонсоль("    ✓ [RUS] Копирование работает")
                        СброситьЦветКонсоли()
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ [RUS] Копирование не работает")
                        СброситьЦветКонсоли()
                        тестРусский = ЛОЖЬ
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ: копирование не удалось")
                    СброситьЦветКонсоли()
                    тестРусский = ЛОЖЬ
                КонецЕсли
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Не удалось создать целевой объект")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
        КонецПопытки
        
        Если тестРусский И англУспех И русУспех Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ALL] Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ALL] Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtМьютекс завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

   Пусть НомерВерсииПрограммы = ВерсияПрограммы()
   Если  НомерВерсииПрограммы < 2.14  Тогда 
       ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
       Возврат    
   КонецЕсли;
   
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtМьютекс (QtMutex)                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtMutex()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtМьютекс (русские и английские методы)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtMutexFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtМьютекс: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

