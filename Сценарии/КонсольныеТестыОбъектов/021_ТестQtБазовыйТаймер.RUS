//
//№    Английский метод    Русский метод    Статус
//1    Создание объекта    Создание объекта    ✅
//2    isActive() до запуска    Активен() до запуска    ✅
//3    start() с колбэком    ЗапуститьСКолбэком()    ✅
//4    start() с receiver/member    Запустить() с receiver/member    ✅
//5    stop()    Остановить()    ✅
//6    timerId()    Идентификатор()    ✅
//7    interval()    Интервал()    ✅
//8    isValid()    Действителен()    ✅
//9    copyTo()    КопироватьВ()    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtБазовыйТаймер
// ============================================================

Функция ДиагностикаМетодовQtBasicTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtБазовыйТаймер ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtБазовыйТаймер: " + (typeof QtБазовыйТаймер !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtБазовыйТаймер: " + e)
    КонецПопытки;
    
    Попытка
        диагТаймер = Новый QtБазовыйТаймер()
        Если диагТаймер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtБазовыйТаймер не создан")
            Возврат
        КонецЕсли;
        
        диагТаймер.setDebug(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtБазовыйТаймер создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "copyTo", "start", "stop", "isActive", "timerId", "interval", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "КопироватьВ", "ЗапуститьСКолбэком", "Запустить", "Остановить", 
            "Активен", "Идентификатор", "Интервал", "РежимОтладки", "Отладка"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаймер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаймер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtБазовыйТаймер: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtБазовыйТаймер
// ============================================================

Функция ТестQtBasicTimer()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    Попытка
        таймер = Новый QtБазовыйТаймер()
        таймер.setDebug(ИСТИНА)
        Если таймер != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtБазовыйТаймер создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isActive() / Активен() ДО ЗАПУСКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка активности до запуска")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        активен = таймер.isActive()
        Если активен == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isActive() = false (верно)")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isActive() = true (ожидается false)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            активенРус = таймер.Активен()
            Если активенРус == ЛОЖЬ Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Активен() = false (верно)")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Активен() = true (ожидается false)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
// ===== 3. ТЕСТ: start(с колбэком) / ЗапуститьСКолбэком() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Запуск с колбэком")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Английский метод
Попытка
    сработал = ЛОЖЬ
    цикл = Новый QtЦиклСобытий()
    
    таймер.start(500, function() {
        сработал = ИСТИНА
        цикл.Выйти()
    })
    
    цикл.Запустить() // Ждём срабатывания таймера
    таймер.stop()
    
    Если сработал == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] start(callback) сработал")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] start(callback) НЕ сработал")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
таймер.stop()
Если тестПройден Тогда
    Попытка
        сработалРус = ЛОЖЬ
        циклРус = Новый QtЦиклСобытий()
        
        таймер.ЗапуститьСКолбэком(500, function() {
            сработалРус = ИСТИНА
            циклРус.Выйти()
        })
        
        циклРус.Запустить() // Ждём срабатывания таймера
        таймер.Остановить()
        
        Если сработалРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ЗапуститьСКолбэком() сработал")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] ЗапуститьСКолбэком() НЕ сработал")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 4. ТЕСТ: start(с receiver и member) / Запустить() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Запуск с receiver и member")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Английский метод
Попытка
    receiver = Новый QtОбъект()
    receiver.сработал = ЛОЖЬ
    receiver.testMethod = function() {
        this.сработал = ИСТИНА
    }
    
    цикл2 = Новый QtЦиклСобытий()
    // Создаём функцию-обёртку, которая вызовет метод receiver
    таймер.start(300, function() {
        receiver.testMethod()
        цикл2.Выйти()
    })
    
    цикл2.Запустить() // Ждём срабатывания таймера
    таймер.stop()
    
    Если receiver.сработал == ИСТИНА Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] start(receiver, member) сработал")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] start(receiver, member) НЕ сработал")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
таймер.stop()
Если тестПройден Тогда
    Попытка
        receiverРус = Новый QtОбъект()
        receiverРус.сработал = ЛОЖЬ
        receiverРус.тестМетод = function() {
            this.сработал = ИСТИНА
        }
        
        цикл2Рус = Новый QtЦиклСобытий()
        таймер.Запустить(300, function() {
            receiverРус.тестМетод()
            цикл2Рус.Выйти()
        })
        
        цикл2Рус.Запустить() // Ждём срабатывания таймера
        таймер.Остановить()
        
        Если receiverРус.сработал == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Запустить(receiver, member) сработал")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Запустить(receiver, member) НЕ сработал")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: stop() / Остановить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Остановка таймера")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        таймер.start(1000, function() {})
        таймер.stop()
        активен = таймер.isActive()
        Если активен == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] stop() остановил таймер")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] stop() НЕ остановил таймер (isActive=true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            таймер.Запустить(1000, function() {})
            таймер.Остановить()
            активенРус = таймер.Активен()
            Если активенРус == ЛОЖЬ Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Остановить() остановил таймер")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Остановить() НЕ остановил таймер (Активен=true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 6. ТЕСТ: timerId() / Идентификатор() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение идентификатора")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        таймер.stop()
        идДо = таймер.timerId()
        таймер.start(100, function() {})
        идПосле = таймер.timerId()
        таймер.stop()
        
        Если идДо == 0 И идПосле != 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] timerId() работает (до=" + идДо + ", после=" + идПосле + ")")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] timerId() ошибка (до=" + идДо + ", после=" + идПосле + ")")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            таймер.Остановить()
            идДоРус = таймер.Идентификатор()
            таймер.Запустить(100, function() {})
            идПослеРус = таймер.Идентификатор()
            таймер.Остановить()
            
            Если идДоРус == 0 И идПослеРус != 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Идентификатор() работает (до=" + идДоРус + ", после=" + идПослеРус + ")")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Идентификатор() ошибка (до=" + идДоРус + ", после=" + идПослеРус + ")")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 7. ТЕСТ: interval() / Интервал() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Получение интервала")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        таймер.stop()
        // Создаём новый таймер для чистоты теста
        таймер7 = Новый QtБазовыйТаймер()
        таймер7.setDebug(ИСТИНА)
        
        интервалДо = таймер7.interval()
        таймер7.start(1500, function() {})
        интервалПосле = таймер7.interval()
        таймер7.stop()
        
        // interval() возвращает последний установленный интервал, даже после остановки
        Если интервалПосле == 1500 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] interval() работает (интервал=" + интервалПосле + ")")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] interval() ошибка (ожидается 1500, получено " + интервалПосле + ")")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            таймер7.Остановить()
            интервалДоРус = таймер7.Интервал()
            таймер7.Запустить(2000, function() {})
            интервалПослеРус = таймер7.Интервал()
            таймер7.Остановить()
            
            Если интервалПослеРус == 2000 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Интервал() работает (интервал=" + интервалПослеРус + ")")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Интервал() ошибка (ожидается 2000, получено " + интервалПослеРус + ")")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 8. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = таймер.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = таймер.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 9. ТЕСТ: copyTo() / КопироватьВ() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Копирование объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        таймер.origin = Новый QtБазовыйТаймер()
        таймер.origin.setDebug(ИСТИНА)
        копия = Новый QtБазовыйТаймер()
        успех = таймер.origin.copyTo(копия)
        
        Если успех == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] copyTo() успешно скопировал")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo() вернул false")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            таймер.originРус = Новый QtБазовыйТаймер()
            таймер.originРус.РежимОтладки(ИСТИНА)
            копияРус = Новый QtБазовыйТаймер()
            успехРус = таймер.originРус.КопироватьВ(копияРус)
            
            Если успехРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] КопироватьВ() успешно скопировал")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ() вернул false")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    сопоставления = [
        ["1", "Создание объекта", "Создание объекта"],
        ["2", "isActive() до запуска", "Активен() до запуска"],
        ["3", "start() с колбэком", "ЗапуститьСКолбэком()"],
        ["4", "start() с receiver/member", "Запустить() с receiver/member"],
        ["5", "stop()", "Остановить()"],
        ["6", "timerId()", "Идентификатор()"],
        ["7", "interval()", "Интервал()"],
        ["8", "isValid()", "Действителен()"],
        ["9", "copyTo()", "КопироватьВ()"]
    ]
    
    Для i = 0 По сопоставления.length - 1 Цикл
        строка = сопоставления[i]
        номер = строка[0]
        англМетод = строка[1]
        русМетод = строка[2]
        
        англСтатус = "❌"
        русСтатус = "❌"
        
        // Определяем статус для английского метода
        Если i < англРезультаты.length Тогда
            Если англРезультаты[i] == ИСТИНА Тогда
                англСтатус = "✅"
            КонецЕсли;
        КонецЕсли;
        
        // Определяем статус для русского метода
        Если i < русРезультаты.length Тогда
            Если русРезультаты[i] == ИСТИНА Тогда
                русСтатус = "✅"
            КонецЕсли;
        КонецЕсли;
        
        общийСтатус = "❌"
        Если англРезультаты[i] == ИСТИНА И русРезультаты[i] == ИСТИНА Тогда
            общийСтатус = "✅"
        КонецЕсли;
        
        // Выводим строку таблицы с цветами
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + номер + "    │ " + англМетод + " " + англСтатус + "        │ " + русМетод + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtБазовыйТаймер завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║          ТЕСТИРОВАНИЕ QtБазовыйТаймер (QtBasicTimer)                          ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtBasicTimer()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtБазовыйТаймер (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtBasicTimer()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtБазовыйТаймер: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ


