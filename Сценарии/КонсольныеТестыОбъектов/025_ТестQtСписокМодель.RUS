// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtСписокМодель
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtAbstractListModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtСписокМодель ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtAbstractListModel: " + (typeof QtAbstractListModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtAbstractListModel: " + e)
    КонецПопытки;
    
    Попытка
        диагМодель = Новый QtСписокМодель()
        диагМодель.РежимОтладки(Режим_Отладки)
        Если диагМодель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtСписокМодель не создана")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtСписокМодель создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setItem", "getItem",
            "addItem", "addItems", "insertItemAt", "removeItemAt",
            "clearAll", "refresh",
            "size", "count", "isEmpty",
            "toList", "fromList",
            "getListModel"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьЭлемент", "ПолучитьЭлемент",
            "ДобавитьЭлемент", "ДобавитьЭлементы", "ВставитьЭлемент", "УдалитьЭлемент",
            "Очистить", "Обновить",
            "Размер", "Количество", "Пустой",
            "ВСписок", "ИзСписка",
            "ПолучитьМодельСписка"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМодель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМодель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtСписокМодель: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtСписокМодель (QtAbstractListModel)
// ============================================================

Функция ТестQtAbstractListModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtСписокМодель                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtСписокМодель()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtСписокМодель создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОЙ МОДЕЛИ (size, count, isEmpty)                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        размер = модель.size()
        количество = модель.count()
        пусто = модель.isEmpty()
        
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  count() = " + количество + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  isEmpty() = " + пусто + " (ожидается true)")
        
        // Проверка получения элемента из пустой модели
        Попытка
            пустойЭлемент = модель.getItem(0)
            ВывестиСтрокуВКонсоль("  getItem(0) для пустой модели = '" + пустойЭлемент + "' (должна быть пустая строка)")
        Исключение
            ВывестиСтрокуВКонсоль("  ⚠️ getItem(0) для пустой модели: " + e)
        КонецПопытки
        
        Если размер == 0 И количество == 0 И пусто == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Пустая модель корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Пустая модель некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой модели: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ ДОБАВЛЕНИЯ ЭЛЕМЕНТОВ (английские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ addItem() / getItem() (английские методы)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м1 = Новый QtСписокМодель()
        м1.РежимОтладки(Режим_Отладки)
        м1.addItem("Первый")
        м1.addItem("Второй")
        м1.addItem("Третий")
        
        размер = м1.size()
        элемент1 = м1.getItem(0)
        элемент2 = м1.getItem(1)
        элемент3 = м1.getItem(2)
        
        ВывестиСтрокуВКонсоль("  addItem('Первый'), addItem('Второй'), addItem('Третий')")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  getItem(0) = " + элемент1 + " (ожидается Первый)")
        ВывестиСтрокуВКонсоль("  getItem(1) = " + элемент2 + " (ожидается Второй)")
        ВывестиСтрокуВКонсоль("  getItem(2) = " + элемент3 + " (ожидается Третий)")
        
        Если размер == 3 И элемент1 == "Первый" И элемент2 == "Второй" И элемент3 == "Третий" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ addItem() / getItem() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ addItem() / getItem() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении элементов (англ): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ ДОБАВЛЕНИЯ ЭЛЕМЕНТОВ (русские методы) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ ДобавитьЭлемент() / ПолучитьЭлемент() (русские методы)               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м2 = Новый QtСписокМодель()
        м2.РежимОтладки(Режим_Отладки)
        м2.ДобавитьЭлемент("Русский1")
        м2.ДобавитьЭлемент("Русский2")
        м2.ДобавитьЭлемент("Русский3")
        
        размер = м2.Размер()
        элемент1 = м2.ПолучитьЭлемент(0)
        элемент2 = м2.ПолучитьЭлемент(1)
        элемент3 = м2.ПолучитьЭлемент(2)
        
        ВывестиСтрокуВКонсоль("  ДобавитьЭлемент('Русский1'), ДобавитьЭлемент('Русский2'), ДобавитьЭлемент('Русский3')")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  ПолучитьЭлемент(0) = " + элемент1 + " (ожидается Русский1)")
        ВывестиСтрокуВКонсоль("  ПолучитьЭлемент(1) = " + элемент2 + " (ожидается Русский2)")
        ВывестиСтрокуВКонсоль("  ПолучитьЭлемент(2) = " + элемент3 + " (ожидается Русский3)")
        
        Если размер == 3 И элемент1 == "Русский1" И элемент2 == "Русский2" И элемент3 == "Русский3" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ДобавитьЭлемент() / ПолучитьЭлемент() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ДобавитьЭлемент() / ПолучитьЭлемент() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении элементов (рус): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ ДОБАВЛЕНИЯ НЕСКОЛЬКИХ ЭЛЕМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ addItems() / ДобавитьЭлементы()                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м3 = Новый QtСписокМодель()
        м3.РежимОтладки(Режим_Отладки)
        м3.addItems(["A", "B", "C"])
        м3.ДобавитьЭлементы(["D", "E"])
        
        размер = м3.size()
        список = м3.toList()
        
        ВывестиСтрокуВКонсоль("  addItems(['A', 'B', 'C'])")
        ВывестиСтрокуВКонсоль("  ДобавитьЭлементы(['D', 'E'])")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("  toList() = " + список.join(", ") + " (ожидается A, B, C, D, E)")
        
        Если размер == 5 И список.join(",") == "A,B,C,D,E" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ addItems() / ДобавитьЭлементы() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ addItems() / ДобавитьЭлементы() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении нескольких элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ ВСТАВКИ ЭЛЕМЕНТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ insertItemAt() / ВставитьЭлемент()                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м4 = Новый QtСписокМодель()
        м4.РежимОтладки(Режим_Отладки)
        м4.addItems(["0", "2", "3"])
        
        м4.insertItemAt(1, "1")
        м4.ВставитьЭлемент(0, "Начало")
        
        размер = м4.size()
        элемент0 = м4.getItem(0)
        элемент1 = м4.getItem(1)
        элемент2 = м4.getItem(2)
        элемент3 = м4.getItem(3)
        
        ВывестиСтрокуВКонсоль("  Исходно: ['0', '2', '3']")
        ВывестиСтрокуВКонсоль("  insertItemAt(1, '1') -> ['0', '1', '2', '3']")
        ВывестиСтрокуВКонсоль("  ВставитьЭлемент(0, 'Начало') -> ['Начало', '0', '1', '2', '3']")
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("  getItem(0) = " + элемент0 + " (ожидается Начало)")
        ВывестиСтрокуВКонсоль("  getItem(1) = " + элемент1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  getItem(2) = " + элемент2 + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("  getItem(3) = " + элемент3 + " (ожидается 2)")
        
        Если размер == 5 И элемент0 == "Начало" И элемент1 == "0" И элемент2 == "1" И элемент3 == "2" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ insertItemAt() / ВставитьЭлемент() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ insertItemAt() / ВставитьЭлемент() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ УСТАНОВКИ ЭЛЕМЕНТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ setItem() / УстановитьЭлемент()                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м5 = Новый QtСписокМодель()
        м5.РежимОтладки(Режим_Отладки)
        м5.addItems(["A", "B", "C"])
        
        м5.setItem(1, "X")
        м5.УстановитьЭлемент(2, "Y")
        
        элемент1 = м5.getItem(1)
        элемент2 = м5.getItem(2)
        
        ВывестиСтрокуВКонсоль("  setItem(1, 'X') -> getItem(1) = " + элемент1 + " (ожидается X)")
        ВывестиСтрокуВКонсоль("  УстановитьЭлемент(2, 'Y') -> getItem(2) = " + элемент2 + " (ожидается Y)")
        
        Если элемент1 == "X" И элемент2 == "Y" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ setItem() / УстановитьЭлемент() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ setItem() / УстановитьЭлемент() работают некорректно")
            СброситьЦветКонсоли()
