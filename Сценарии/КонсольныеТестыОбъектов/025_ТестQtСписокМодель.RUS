        ВывестиСтрокуВКонсоль("  addItems(['A', 'B', 'C', 'D', 'E']) -> 5 элементов")
        ВывестиСтрокуВКонсоль("  insertItemAt(2, 'X') -> 6 элементов: A, B, X, C, D, E")
        ВывестиСтрокуВКонсоль("  setItem(0, 'Z') -> Z, B, X, C, D, E")
        ВывестиСтрокуВКонсоль("  removeItemAt(4) -> удаляем D -> Z, B, X, C, E (5 элементов)")
        ВывестиСтрокуВКонсоль("  ДобавитьЭлемент('F') -> 6 элементов: Z, B, X, C, E, F")
        ВывестиСтрокуВКонсоль("  ВставитьЭлемент(1, 'Y') -> 7 элементов: Z, Y, B, X, C, E, F")
        ВывестиСтрокуВКонсоль("  Итоговый список: " + список.join(", "))
        ВывестиСтрокуВКонсоль("  size() = " + размер + " (ожидается 7)")
        
        // Проверяем: Z, Y, B, X, C, E, F
        Если размер == 7 И список.length == 7 Тогда
            // Проверяем конкретные элементы
            элемент0 = м14.getItem(0)
            элемент1 = м14.getItem(1)
            элемент2 = м14.getItem(2)
            элемент3 = м14.getItem(3)
            элемент4 = м14.getItem(4)
            элемент5 = м14.getItem(5)
            элемент6 = м14.getItem(6)
            
            ВывестиСтрокуВКонсоль("  getItem(0) = " + элемент0 + " (ожидается Z)")
            ВывестиСтрокуВКонсоль("  getItem(1) = " + элемент1 + " (ожидается Y)")
            ВывестиСтрокуВКонсоль("  getItem(2) = " + элемент2 + " (ожидается B)")
            ВывестиСтрокуВКонсоль("  getItem(3) = " + элемент3 + " (ожидается X)")
            ВывестиСтрокуВКонсоль("  getItem(4) = " + элемент4 + " (ожидается C)")
            ВывестиСтрокуВКонсоль("  getItem(5) = " + элемент5 + " (ожидается E)")
            ВывестиСтрокуВКонсоль("  getItem(6) = " + элемент6 + " (ожидается F)")
            
            Если элемент0 == "Z" И элемент1 == "Y" И элемент2 == "B" И элемент3 == "X" И элемент4 == "C" И элемент5 == "E" И элемент6 == "F" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ Комбинированные операции работают корректно")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  ❌ Комбинированные операции работают некорректно (неправильные значения)")
                СброситьЦветКонсоли()
            КонецЕсли;
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Комбинированные операции работают некорректно (ожидалось 7 элементов, получено " + размер + ")")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при комбинированных операциях: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtСписокМодель завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть Режим_Отладки = ИСТИНА  // Глобальная переменная
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                    ТЕСТИРОВАНИЕ QtСписокМодель (QtAbstractListModel)            ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtAbstractListModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtСписокМодель (русские и английские методы)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtAbstractListModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtСписокМодель: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

