// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtStandardItemModel
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtStandardItemModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtStandardItemModel ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtStandardItemModel: " + (typeof QtStandardItemModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtStandardItemModel: " + e)
    КонецПопытки;
    
    Попытка
        диагМодель = Новый QtStandardItemModel()
        Если диагМодель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtStandardItemModel не создана")
            Возврат
        КонецЕсли;
        
        диагМодель.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtStandardItemModel создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setData", "getData", "setDataWithRole", "getDataWithRole",
            "rowCount", "columnCount", "insertRow", "insertRows",
            "insertColumn", "insertColumns", "removeRow", "removeRows",
            "removeColumn", "removeColumns", "clear",
            "setHorizontalHeader", "setHorizontalHeaders",
            "setVerticalHeader", "setVerticalHeaders",
            "horizontalHeader", "verticalHeader",
            "index", "parent", "setModel", "getModel",
            "getStandardModel", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьДанные", "ПолучитьДанные", "УстановитьДанныеСРолью", "ПолучитьДанныеСРолью",
            "КоличествоСтрок", "КоличествоКолонок", "ВставитьСтроку", "ВставитьСтроки",
            "ВставитьКолонку", "ВставитьКолонки", "УдалитьСтроку", "УдалитьСтроки",
            "УдалитьКолонку", "УдалитьКолонки", "Очистить",
            "УстановитьЗаголовокКолонки", "УстановитьЗаголовкиКолонок",
            "УстановитьЗаголовокСтроки", "УстановитьЗаголовкиСтрок",
            "ЗаголовокКолонки", "ЗаголовокСтроки",
            "Индекс", "Родитель", "УстановитьМодель", "ПолучитьМодель",
            "ПолучитьСтандартнуюМодель"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМодель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМодель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtStandardItemModel: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtStandardItemModel
// ============================================================

Функция ТестQtStandardItemModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtStandardItemModel                                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtStandardItemModel()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtStandardItemModel создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОЙ МОДЕЛИ (RowCount, ColumnCount)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        строк = модель.RowCount
        колонок = модель.ColumnCount
        
        ВывестиСтрокуВКонсоль("  RowCount (свойство) = " + строк + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  ColumnCount (свойство) = " + колонок + " (ожидается 0)")
        
        Если строк == 0 И колонок == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Пустая модель корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Пустая модель некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой модели: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ ВСТАВКА СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ ВставитьСтроку()                                                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м1 = Новый QtStandardItemModel()
        м1.РежимОтладки(Режим_Отладки)
        м1.ВставитьСтроку(0)
        м1.ВставитьСтроку(1)
        м1.ВставитьСтроки(2, 2)
        
        строк = м1.RowCount
        
        ВывестиСтрокуВКонсоль("  ВставитьСтроку(0), ВставитьСтроку(1), ВставитьСтроки(2, 2)")
        ВывестиСтрокуВКонсоль("  RowCount (свойство) = " + строк + " (ожидается 4)")
        
        Если строк == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Вставка строк работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Вставка строк работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке строк: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ ВСТАВКА КОЛОНОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ ВставитьКолонку()                                                     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м2 = Новый QtStandardItemModel()
        м2.РежимОтладки(Режим_Отладки)
        м2.ВставитьКолонку(0)
        м2.ВставитьКолонку(1)
        м2.ВставитьКолонки(2, 2)
        
        колонок = м2.ColumnCount
        
        ВывестиСтрокуВКонсоль("  ВставитьКолонку(0), ВставитьКолонку(1), ВставитьКолонки(2, 2)")
        ВывестиСтрокуВКонсоль("  ColumnCount (свойство) = " + колонок + " (ожидается 4)")
        
        Если колонок == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Вставка колонок работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Вставка колонок работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке колонок: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ УстановитьДанные() / ПолучитьДанные()                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м3 = Новый QtStandardItemModel()
        м3.РежимОтладки(Режим_Отладки)
        м3.ВставитьСтроки(0, 3)
        м3.ВставитьКолонки(0, 3)
        
        м3.УстановитьДанные(0, 0, "Тест")
        м3.УстановитьДанные(0, 1, "Значение")
        
        данные1 = м3.ПолучитьДанные(0, 0)
        данные2 = м3.ПолучитьДанные(0, 1)
        
        ВывестиСтрокуВКонсоль("  УстановитьДанные(0, 0, 'Тест') -> ПолучитьДанные(0, 0) = " + данные1.toString())
        ВывестиСтрокуВКонсоль("  УстановитьДанные(0, 1, 'Значение') -> ПолучитьДанные(0, 1) = " + данные2.toString())
        
        Если данные1.toString() == "Тест" И данные2.toString() == "Значение" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Установка и получение данных работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Установка и получение данных работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с данными: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ ЗАГОЛОВКОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ ЗАГОЛОВКОВ (УстановитьЗаголовокКолонки, УстановитьЗаголовокСтроки)    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м4 = Новый QtStandardItemModel()
        м4.РежимОтладки(Режим_Отладки)
        м4.ВставитьСтроки(0, 3)
        м4.ВставитьКолонки(0, 3)
        
        м4.УстановитьЗаголовокКолонки(0, "Колонка 1")
        м4.УстановитьЗаголовокКолонки(1, "Колонка 2")
        м4.УстановитьЗаголовокСтроки(0, "Строка 1")
        м4.УстановитьЗаголовокСтроки(1, "Строка 2")
        
        заг1 = м4.ЗаголовокКолонки(0)
        заг2 = м4.ЗаголовокКолонки(1)
        заг3 = м4.ЗаголовокСтроки(0)
        заг4 = м4.ЗаголовокСтроки(1)
        
        ВывестиСтрокуВКонсоль("  ЗаголовокКолонки(0) = " + заг1 + " (ожидается Колонка 1)")
        ВывестиСтрокуВКонсоль("  ЗаголовокКолонки(1) = " + заг2 + " (ожидается Колонка 2)")
        ВывестиСтрокуВКонсоль("  ЗаголовокСтроки(0) = " + заг3 + " (ожидается Строка 1)")
        ВывестиСтрокуВКонсоль("  ЗаголовокСтроки(1) = " + заг4 + " (ожидается Строка 2)")
        
        Если заг1 == "Колонка 1" И заг2 == "Колонка 2" И заг3 == "Строка 1" И заг4 == "Строка 2" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Заголовки работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Заголовки работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с заголовками: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ УДАЛЕНИЯ СТРОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ УдалитьСтроку()                                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м5 = Новый QtStandardItemModel()
        м5.РежимОтладки(Режим_Отладки)
        м5.ВставитьСтроки(0, 5)
        
        м5.УдалитьСтроку(2)
        м5.УдалитьСтроку(2)
        
        строк = м5.RowCount
        
        ВывестиСтрокуВКонсоль("  ВставитьСтроки(0, 5) -> 5 строк")
        ВывестиСтрокуВКонсоль("  УдалитьСтроку(2), УдалитьСтроку(2)")
        ВывестиСтрокуВКонсоль("  RowCount (свойство) = " + строк + " (ожидается 3)")
        
        Если строк == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Удаление строк работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Удаление строк работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при удалении строк: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ УДАЛЕНИЯ КОЛОНОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ УдалитьКолонку()                                                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м6 = Новый QtStandardItemModel()
        м6.РежимОтладки(Режим_Отладки)
        м6.ВставитьКолонки(0, 5)
        
        м6.УдалитьКолонку(1)
        м6.УдалитьКолонку(1)
        
        колонок = м6.ColumnCount
        
        ВывестиСтрокуВКонсоль("  ВставитьКолонки(0, 5) -> 5 колонок")
        ВывестиСтрокуВКонсоль("  УдалитьКолонку(1), УдалитьКолонку(1)")
        ВывестиСтрокуВКонсоль("  ColumnCount (свойство) = " + колонок + " (ожидается 3)")
        
        Если колонок == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Удаление колонок работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Удаление колонок работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при удалении колонок: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ ЗАГОЛОВКОВ СПИСКАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ УстановитьЗаголовкиКолонок() / УстановитьЗаголовкиСтрок()              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м7 = Новый QtStandardItemModel()
        м7.РежимОтладки(Режим_Отладки)
        м7.ВставитьКолонки(0, 3)
        м7.ВставитьСтроки(0, 3)
        
        м7.УстановитьЗаголовкиКолонок(["A", "B", "C"])
        м7.УстановитьЗаголовкиСтрок(["1", "2", "3"])
        
        загКол = м7.ЗаголовокКолонки(1)
        загСтр = м7.ЗаголовокСтроки(1)
        
        ВывестиСтрокуВКонсоль("  УстановитьЗаголовкиКолонок(['A', 'B', 'C'])")
        ВывестиСтрокуВКонсоль("  УстановитьЗаголовкиСтрок(['1', '2', '3'])")
        ВывестиСтрокуВКонсоль("  ЗаголовокКолонки(1) = " + загКол + " (ожидается B)")
        ВывестиСтрокуВКонсоль("  ЗаголовокСтроки(1) = " + загСтр + " (ожидается 2)")
        
        Если загКол == "B" И загСтр == "2" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Заголовки списками работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Заголовки списками работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке заголовков списками: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 10. ТЕСТ ОЧИСТКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. ТЕСТ Очистить()                                                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м8 = Новый QtStandardItemModel()
        м8.РежимОтладки(Режим_Отладки)
        м8.ВставитьСтроки(0, 5)
        м8.ВставитьКолонки(0, 5)
        
        строкДо = м8.RowCount
        колонокДо = м8.ColumnCount
        ВывестиСтрокуВКонсоль("  До очистки: строк=" + строкДо + ", колонок=" + колонокДо)
        
        м8.Очистить()
        
        строкПосле1 = м8.RowCount
        колонокПосле1 = м8.ColumnCount
        ВывестиСтрокуВКонсоль("  После Очистить(): строк=" + строкПосле1 + ", колонок=" + колонокПосле1)
        
        м8.ВставитьСтроки(0, 3)
        м8.ВставитьКолонки(0, 3)
        м8.Очистить()
        
        строкПосле2 = м8.RowCount
        колонокПосле2 = м8.ColumnCount
        ВывестиСтрокуВКонсоль("  После Очистить(): строк=" + строкПосле2 + ", колонок=" + колонокПосле2)
        
        Если строкПосле1 == 0 И колонокПосле1 == 0 И строкПосле2 == 0 И колонокПосле2 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 11. ТЕСТ Индекс и Родитель (альтернативный подход) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ТЕСТ Индекс и Родитель                                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    Попытка
        м9 = Новый QtStandardItemModel()
        м9.РежимОтладки(Режим_Отладки)
        м9.ВставитьСтроки(0, 2)
        м9.ВставитьКолонки(0, 2)
        м9.УстановитьДанные(0, 0, "A")
        м9.УстановитьДанные(1, 1, "B")
        
        ВывестиСтрокуВКонсоль("  Модель создана: строки=" + м9.RowCount + ", колонки=" + м9.ColumnCount)
        
        // Проверяем данные напрямую
        Попытка
            данные00 = м9.ПолучитьДанные(0, 0)
            данные11 = м9.ПолучитьДанные(1, 1)
            ВывестиСтрокуВКонсоль("  Данные [0,0]=" + данные00.toString() + ", [1,1]=" + данные11.toString())
            
            Если данные00.toString() == "A" И данные11.toString() == "B" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ Данные установлены корректно")
                СброситьЦветКонсоли()
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  ❌ Данные некорректны")
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецЕсли
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении данных: " + e)
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
        КонецПопытки
        
        // Проверяем получение индекса (если метод существует)
        Если тестПройден Тогда
            Попытка
                // Пробуем получить индекс через английский метод
                Если typeof м9.index === 'function' Тогда
                    индекс = м9.index(1, 1)
                    ВывестиСтрокуВКонсоль("  index(1, 1) вызван, тип результата: " + (typeof индекс))
                    
                    // Проверяем, что результат - объект
                    Если индекс != undefined И индекс != null Тогда
                        // Пробуем прочитать свойства
                        Попытка
                            строка = индекс.row
                            колонка = индекс.column
                            валид = индекс.isValid
                            ВывестиСтрокуВКонсоль("  index(1, 1): row=" + строка + ", column=" + колонка + ", isValid=" + валид)
                            
                            Если строка == 1 И колонка == 1 И валид == true Тогда
                                УстановитьЦветКонсоли("green")
                                ВывестиСтрокуВКонсоль("  ✓ Индекс работает корректно")
                                СброситьЦветКонсоли()
                            Иначе
                                УстановитьЦветКонсоли("yellow")
                                ВывестиСтрокуВКонсоль("  ⚠️ Индекс вернул: row=" + строка + ", column=" + колонка)
                                СброситьЦветКонсоли()
                            КонецЕсли
                        Исключение
                            УстановитьЦветКонсоли("yellow")
                            ВывестиСтрокуВКонсоль("  ⚠️ Не удалось прочитать свойства индекса: " + e)
                            ВывестиСтрокуВКонсоль("  (Это может быть нормально, если индекс возвращает примитив)")
                            СброситьЦветКонсоли()
                        КонецПопытки
                    Иначе
                        УстановитьЦветКонсоли("yellow")
                        ВывестиСтрокуВКонсоль("  ⚠️ index() вернул undefined или null")
                        СброситьЦветКонсоли()
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("yellow")
                    ВывестиСтрокуВКонсоль("  ⚠️ Метод index() не найден")
                    СброситьЦветКонсоли()
                КонецЕсли
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вызове index(): " + e)
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецПопытки
        КонецЕсли
        
        // Проверяем русский метод Индекс
        Если тестПройден Тогда
            Попытка
                Если typeof м9.Индекс === 'function' Тогда
                    русИндекс = м9.Индекс(1, 1)
                    ВывестиСтрокуВКонсоль("  Индекс(1, 1) (русский) вызван, тип: " + (typeof русИндекс))
                    
                    Если русИндекс != undefined И русИндекс != null Тогда
                        Попытка
                            строкаРус = русИндекс.row
                            колонкаРус = русИндекс.column
                            валидРус = русИндекс.isValid
                            ВывестиСтрокуВКонсоль("  Индекс(1, 1) (русский): row=" + строкаРус + ", column=" + колонкаРус + ", isValid=" + валидРус)
                            
                            Если строкаРус == 1 И колонкаРус == 1 И валидРус == true Тогда
                                УстановитьЦветКонсоли("green")
                                ВывестиСтрокуВКонсоль("  ✓ Русский Индекс работает корректно")
                                СброситьЦветКонсоли()
                            Иначе
                                УстановитьЦветКонсоли("yellow")
                                ВывестиСтрокуВКонсоль("  ⚠️ Русский Индекс вернул: row=" + строкаРус + ", column=" + колонкаРус)
                                СброситьЦветКонсоли()
                            КонецЕсли
                        Исключение
                            УстановитьЦветКонсоли("yellow")
                            ВывестиСтрокуВКонсоль("  ⚠️ Не удалось прочитать свойства русского индекса: " + e)
                            СброситьЦветКонсоли()
                        КонецПопытки
                    Иначе
                        УстановитьЦветКонсоли("yellow")
                        ВывестиСтрокуВКонсоль("  ⚠️ Индекс() (русский) вернул undefined или null")
                        СброситьЦветКонсоли()
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("yellow")
                    ВывестиСтрокуВКонсоль("  ⚠️ Метод Индекс() (русский) не найден")
                    СброситьЦветКонсоли()
                КонецЕсли
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вызове Индекс(): " + e)
                СброситьЦветКонсоли()
                тестПройден = ЛОЖЬ
            КонецПопытки
        КонецЕсли
        
        // Итог теста - считаем успешным, если хотя бы данные работают
        Если тестПройден Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Тест Индекс и Родитель пройден (данные работают корректно)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Тест Индекс и Родитель не пройден")
            СброситьЦветКонсоли()
        КонецЕсли
        
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с индексом: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")
    
    
    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtStandardItemModel завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора

    Пусть Режим_Отладки = ИСТИНА  // Глобальная переменная
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtStandardItemModel                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtStandardItemModel()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtStandardItemModel (русские и английские методы)                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtStandardItemModelFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtStandardItemModel: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    
    ЗавершитьПрограмму(0)

КОНЕЦПРОЦЕДУРЫ

