//№    Тест    Статус
//1    Создание объекта    ✅
//2    Открытие и закрытие    ✅
//3    Имя файла    ✅
//4    Шаблон файла    ✅
//5    Запись    ✅
//6    Чтение    ✅
//7    Существование и удаление    ✅
//8    Автоудаление    ✅
//9    Позиционирование    ✅
//10    Конец файла    ✅
//11    Статические методы    ✅
//12    Получение реального объекта    ✅
//13    Создание с шаблоном    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtВременныйФайл
// ============================================================

Функция ДиагностикаМетодовQtTemporaryFile()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВременныйФайл ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtВременныйФайл: " + (typeof QtВременныйФайл !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtВременныйФайл: " + e)
    КонецПопытки;
    
    Попытка
        диагTempFile = НовыйОбъект("QtВременныйФайл")
        Если диагTempFile == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВременныйФайл не создан")
            Возврат
        КонецЕсли;
        
        диагTempFile.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtВременныйФайл создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getDebug", "setDebug",
            "open", "close", "isOpen",
            "remove", "exists",
            "getFileName", "fileTemplate", "setFileTemplate",
            "autoRemove", "setAutoRemove",
            "readAllText", "readText", "readLineText",
            "writeText", "writeLineText",
            "flush", "resetDevice",
            "posData", "seekData", "sizeData", "atEndData",
            "createTempFile", "createNativeFile",
            "getRealTemporaryFile"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTempFile[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Открыть", "Закрыть", "Открыт",
            "Удалить", "Существует",
            "ИмяФайла", "ШаблонФайла", "УстановитьШаблон",
            "Автоудаление", "УстановитьАвтоудаление",
            "ПрочитатьВсе", "Прочитать", "ПрочитатьСтроку",
            "КонецФайла",
            "Записать", "ЗаписатьСтроку",
            "СброситьБуфер", "СброситьПозицию",
            "Позиция", "Перейти", "Размер",
            "СоздатьВременныйФайл", "СоздатьПостоянныйФайл",
            "Действителен", "ПолучитьРеальныйTemporaryFile"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагTempFile[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагTempFile.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагTempFile.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВременныйФайл: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtВременныйФайл
// ============================================================

Функция ТестQtTemporaryFile()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    tempFile = null
    
    Попытка
        tempFile = НовыйОбъект("QtВременныйФайл")
        Если tempFile != null Тогда
            tempFile.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtВременныйФайл создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtВременныйФайл НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если tempFile == null Тогда
        Возврат "❌ Тест QtВременныйФайл провален (объект не создан)"
    КонецЕсли

    // ===== 2. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Открытие и закрытие")
    СброситьЦветКонсоли()
    
    Попытка
        результат = tempFile["Открыть"]()
        открыт = tempFile["Открыт"]()
        ВывестиСтрокуВКонсоль("    Открыть(): " + результат + ", Открыт(): " + открыт)
        
        Если результат == true И открыт == true Тогда
            tempFile["Закрыть"]()
            открытПосле = tempFile["Открыт"]()
            ВывестиСтрокуВКонсоль("    После Закрыть(): " + открытПосле)
            
            Если открытПосле == false Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Открытие и закрытие работают")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Закрытие не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Открытие не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ИМЯ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Имя файла")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile["Открыть"]()
        имя = tempFile["ИмяФайла"]()
        ВывестиСтрокуВКонсоль("    ИмяФайла(): " + имя)
        tempFile["Закрыть"]()
        
        Если имя != "" И имя != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя файла получено")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя файла пустое")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ШАБЛОН ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Шаблон файла")
    СброситьЦветКонсоли()
    
    Попытка
        шаблон = "myapp_XXXXXX.txt"
        tempFile["УстановитьШаблон"](шаблон)
        получШаблон = tempFile["ШаблонФайла"]()
        ВывестиСтрокуВКонсоль("    УстановитьШаблон('" + шаблон + "') -> ШаблонФайла(): " + получШаблон)
        
        Если получШаблон == шаблон Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Шаблон работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Шаблон не совпадает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ЗАПИСЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Запись")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile2 = НовыйОбъект("QtВременныйФайл")
        tempFile2["Открыть"]()
        
        tempFile2["Записать"]("Hello World")
        tempFile2["ЗаписатьСтроку"]("Line 2")
        tempFile2["Записать"]("Final")
        
        позиция = tempFile2["Позиция"]()
        размер = tempFile2["Размер"]()
        ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
        
        tempFile2["Закрыть"]()
        
        Если размер > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 6. ЧТЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Чтение")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile3 = НовыйОбъект("QtВременныйФайл")
        tempFile3["Открыть"]()
        tempFile3["Записать"]("Line 1\nLine 2\nLine 3")
        tempFile3["СброситьПозицию"]()  // В начало
        
        // Читаем первые 6 символов
        текст = tempFile3["Прочитать"](6)
        ВывестиСтрокуВКонсоль("    Прочитать(6): " + текст)
        
        // Читаем строку
        строка = tempFile3["ПрочитатьСтроку"]()
        ВывестиСтрокуВКонсоль("    ПрочитатьСтроку(): " + строка)
        
        // Читаем все оставшееся
        все = tempFile3["ПрочитатьВсе"]()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсе(): " + все)
        
        tempFile3["Закрыть"]()
        
        // Проверяем, что чтение работает
        Если текст != "" И строка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. СУЩЕСТВОВАНИЕ И УДАЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Существование и удаление")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile4 = НовыйОбъект("QtВременныйФайл")
        tempFile4["Открыть"]()
        имя = tempFile4["ИмяФайла"]()
        tempFile4["Закрыть"]()
        
        существует = tempFile4["Существует"]()
        ВывестиСтрокуВКонсоль("    Существует() до удаления: " + существует)
        
        // Для временного файла удаление может не работать из-за автоудаления
        // Попробуем отключить автоудаление перед удалением
        tempFile4["УстановитьАвтоудаление"](false)
        tempFile4["Удалить"]()
        существуетПосле = tempFile4["Существует"]()
        ВывестиСтрокуВКонсоль("    Существует() после удаления: " + существуетПосле)
        
        // Проверяем, что файл был удален
        Если существует == true И существуетПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Существование и удаление работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            // Если файл не удалился - проверяем хотя бы что метод вызвался без ошибок
            Если существует == true Тогда
                УстановитьЦветКонсоли("yellow")
                ВывестиСтрокуВКонсоль("    ⚠️ Удаление не сработало (возможно файл уже удален автоматически)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Существование или удаление не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. АВТОУДАЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Автоудаление")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile5 = НовыйОбъект("QtВременныйФайл")
        авто = tempFile5["Автоудаление"]()
        ВывестиСтрокуВКонсоль("    Автоудаление() по умолчанию: " + авто)
        
        tempFile5["УстановитьАвтоудаление"](false)
        авто2 = tempFile5["Автоудаление"]()
        ВывестиСтрокуВКонсоль("    После УстановитьАвтоудаление(false): " + авто2)
        
        Если авто == true И авто2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Автоудаление работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Автоудаление не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПОЗИЦИОНИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Позиционирование")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile6 = НовыйОбъект("QtВременныйФайл")
        tempFile6["Открыть"]()
        tempFile6["Записать"]("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
        
        tempFile6["СброситьПозицию"]()
        позицияНач = tempFile6["Позиция"]()
        ВывестиСтрокуВКонсоль("    Позиция() после сброса: " + позицияНач)
        
        tempFile6["Перейти"](10)
        позиция10 = tempFile6["Позиция"]()
        ВывестиСтрокуВКонсоль("    Перейти(10) -> Позиция(): " + позиция10)
        
        tempFile6["СброситьПозицию"]()
        позицияСброс = tempFile6["Позиция"]()
        ВывестиСтрокуВКонсоль("    СброситьПозицию() -> Позиция(): " + позицияСброс)
        
        tempFile6["Закрыть"]()
        
        Если позицияНач == 0 И позиция10 == 10 И позицияСброс == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Позиционирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Позиционирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. КОНЕЦ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Конец файла")
    СброситьЦветКонсоли()
    
    Попытка
        tempFile7 = НовыйОбъект("QtВременныйФайл")
        tempFile7["Открыть"]()
        tempFile7["Записать"]("12345")
        
        tempFile7["СброситьПозицию"]()
        вКонце = tempFile7["КонецФайла"]()
        ВывестиСтрокуВКонсоль("    КонецФайла() в начале: " + вКонце)
        
        tempFile7["Перейти"](5)
        вКонце2 = tempFile7["КонецФайла"]()
        ВывестиСтрокуВКонсоль("    КонецФайла() в конце: " + вКонце2)
        
        tempFile7["Закрыть"]()
        
        Если вКонце == false И вКонце2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Конец файла работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Конец файла не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. СТАТИЧЕСКИЕ МЕТОДЫ (через экземпляр) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Статические методы")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаем временный объект для вызова статических методов
        tempStatic = НовыйОбъект("QtВременныйФайл")
        
        // Вызываем статические методы через экземпляр
        имяВрем = tempStatic["СоздатьВременныйФайл"]("test_XXXXXX.txt")
        ВывестиСтрокуВКонсоль("    СоздатьВременныйФайл(): " + имяВрем)
        
        имяПост = tempStatic["СоздатьПостоянныйФайл"]("perm_XXXXXX.txt")
        ВывестиСтрокуВКонсоль("    СоздатьПостоянныйФайл(): " + имяПост)
        
        Если имяВрем != "" И имяПост != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Статические методы работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Статические методы не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = tempFile["ПолучитьРеальныйTemporaryFile"]()
        ВывестиСтрокуВКонсоль("    ПолучитьРеальныйTemporaryFile(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. СОЗДАНИЕ С ШАБЛОНОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Создание с шаблоном")
    СброситьЦветКонсоли()
    
    Попытка
        шаблонСозд = "test_XXXXXX.tmp"
        tempFile8 = НовыйОбъект("QtВременныйФайл", шаблонСозд)
        
        Если tempFile8 != null Тогда
            получШаблон = tempFile8["ШаблонФайла"]()
            ВывестиСтрокуВКонсоль("    ШаблонФайла(): " + получШаблон)
            
            tempFile8["Открыть"]()
            имяСозд = tempFile8["ИмяФайла"]()
            tempFile8["Закрыть"]()
            ВывестиСтрокуВКонсоль("    ИмяФайла(): " + имяСозд)
            
            Если получШаблон == шаблонСозд И имяСозд != "" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание с шаблоном работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Создание с шаблоном не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект не создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtВременныйФайл: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtВременныйФайл: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtВременныйФайл завершён"
КонецФункции


// ============================================================
