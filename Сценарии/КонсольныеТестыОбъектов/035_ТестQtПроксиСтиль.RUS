    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        иконка = прокси.standardIcon(0)
        ВывестиСтрокуВКонсоль("    [ENG] standardIcon(SP_MessageBoxInformation) = " + (иконка != null ? "valid" : "null"))
        
        Если иконка != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] standardIcon() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
