    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 10. ТЕСТ: getRealProxyStyle() / ПолучитьПроксиСтиль() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального прокси-стиля")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        реальный = прокси.getRealProxyStyle()
        ВывестиСтрокуВКонсоль("    [ENG] getRealProxyStyle() = " + (реальный != null ? "valid" : "null"))
        
        Если реальный != null Тогда
