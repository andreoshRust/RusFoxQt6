        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            иконкаРус = прокси.СтандартнаяИконка(0)
            ВывестиСтрокуВКонсоль("    [RUS] СтандартнаяИконка(SP_MessageBoxInformation) = " + (иконкаРус != null ? "valid" : "null"))
            
            Если иконкаРус != null Тогда
