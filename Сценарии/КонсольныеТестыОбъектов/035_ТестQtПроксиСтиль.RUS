    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 8. ТЕСТ: standardIcon() / СтандартнаяИконка() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение стандартной иконки")
    СброситьЦветКонсоли()
    
