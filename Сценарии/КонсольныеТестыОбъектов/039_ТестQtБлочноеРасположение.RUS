//Что было проверено:
//✅ Создание объекта - Новый QtБлочноеРасположение()
//✅ Валидность - isValid() / Действителен()
//✅ Направление - direction() / directionString() / isVertical() / isHorizontal() и их русские аналоги
//✅ Добавление виджета - addWidget() / ДобавитьВиджет()
//✅ Добавление растяжения и отступа - addStretch() / addSpacing() и их русские аналоги
//✅ Вставка элементов - insertWidget() / insertStretch() / insertSpacing() и их русские аналоги
//✅ Управление растяжением - setStretch() / stretch() и их русские аналоги
//✅ Добавление вложенного расположения - addLayout() / ДобавитьРасположение()
//✅ Отступы, промежутки и доступность - setMargin() / setSpacing() / setEnabled() и их русские аналоги
//✅ Получение реальных объектов - getRealBoxLayout() / getRealLayout() и их русские аналоги

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtБлочноеРасположение
// ============================================================

Функция ДиагностикаМетодовQtBoxLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtБлочноеРасположение ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtБлочноеРасположение: " + (typeof QtБлочноеРасположение !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtБлочноеРасположение: " + e)
    КонецПопытки;
    
    Попытка
        диагВиджет = Новый QtВиджет()
        диагВиджет.Показать()
        диагLayout = Новый QtБлочноеРасположение(диагВиджет)
        
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtБлочноеРасположение не создан")
            Возврат
        КонецЕсли;
        
        диагLayout.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtБлочноеРасположение создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealBoxLayout", "getRealLayout",
            "direction", "directionString", "isVertical", "isHorizontal",
            "addWidget", "addWidgetEnd", "insertWidget",
            "addStretch", "insertStretch",
            "addSpacing", "insertSpacing",
            "addLayout", "insertLayout",
            "setStretch", "stretch",
            "count", "isEmpty", "geometry", "contentsRect",
            "setMargin", "margin",
            "setSpacing", "spacing",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьБлочноеРасположение", "ПолучитьРасположение",
            "Направление", "НаправлениеСтрока", "Вертикальный", "Горизонтальный",
            "ДобавитьВиджет", "ДобавитьВиджетВКонец", "ВставитьВиджет",
            "ДобавитьРастяжение", "ВставитьРастяжение",
            "ДобавитьОтступ", "ВставитьОтступ",
            "ДобавитьРасположение", "ВставитьРасположение",
            "УстановитьРастяжение", "Растяжение",
            "Количество", "Пустой", "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьПромежуток", "Промежуток",
            "УстановитьДоступен", "Доступен",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
        диагВиджет.Скрыть()
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtБлочноеРасположение: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtБлочноеРасположение
// ============================================================

Функция ТестQtBoxLayout()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // Создаём виджет для тестов
    виджет = Новый QtВиджет()
    виджет.Показать()
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    расположение = null
    Попытка
        расположение = Новый QtБлочноеРасположение(виджет)
        расположение.РежимОтладки(ИСТИНА)
        Если расположение != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtБлочноеРасположение создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = расположение.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = расположение.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: direction() / directionString() / isVertical() / isHorizontal() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Направление блочного расположения")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        направление = расположение.direction()
        направлениеСтр = расположение.directionString()
        вертикальный = расположение.isVertical()
        горизонтальный = расположение.isHorizontal()
        ВывестиСтрокуВКонсоль("    [ENG] direction() = " + направление)
        ВывестиСтрокуВКонсоль("    [ENG] directionString() = " + направлениеСтр)
        ВывестиСтрокуВКонсоль("    [ENG] isVertical() = " + вертикальный)
        ВывестиСтрокуВКонсоль("    [ENG] isHorizontal() = " + горизонтальный)
        
        Если направление >= 0 И направление <= 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] direction()/directionString()/isVertical()/isHorizontal() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] direction()/directionString()/isVertical()/isHorizontal() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            направлениеРус = расположение.Направление()
            направлениеСтрРус = расположение.НаправлениеСтрока()
            вертикальныйРус = расположение.Вертикальный()
            горизонтальныйРус = расположение.Горизонтальный()
            ВывестиСтрокуВКонсоль("    [RUS] Направление() = " + направлениеРус)
            ВывестиСтрокуВКонсоль("    [RUS] НаправлениеСтрока() = " + направлениеСтрРус)
            ВывестиСтрокуВКонсоль("    [RUS] Вертикальный() = " + вертикальныйРус)
            ВывестиСтрокуВКонсоль("    [RUS] Горизонтальный() = " + горизонтальныйРус)
            
            Если направлениеРус >= 0 И направлениеРус <= 3 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Направление()/НаправлениеСтрока()/Вертикальный()/Горизонтальный() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Направление()/НаправлениеСтрока()/Вертикальный()/Горизонтальный() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
// ===== 4. ТЕСТ: addWidget() / ДобавитьВиджет() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Добавление виджета (проверка вызова)")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Создаём layout без родителя
тестLayout4 = Новый QtБлочноеРасположение()

// Создаём виджет для добавления
кнопкаТест = Новый QtКнопка("Тестовая кнопка")
реальныйВиджетТест = кнопкаТест.ПолучитьВиджет()

// Английский метод
Попытка
    // Просто проверяем, что метод существует и вызывается без ошибок
    Если typeof тестLayout4.addWidget === 'function' Тогда
        тестLayout4.addWidget(реальныйВиджетТест, 1, 0)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] addWidget() вызывается без ошибок")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] addWidget() не существует")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        Если typeof тестLayout4.ДобавитьВиджет === 'function' Тогда
            кнопка2Тест = Новый QtКнопка("Тестовая кнопка 2")
            реальныйВиджет2Тест = кнопка2Тест.ПолучитьВиджет()
            тестLayout4.ДобавитьВиджет(реальныйВиджет2Тест, 1, 0)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ДобавитьВиджет() вызывается без ошибок")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] ДобавитьВиджет() не существует")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
