//Итоги тестирования QtByteArray (QtБайтМассив):
//✅ Все тесты пройдены успешно (14 из 14)
//Что было протестировано:
//✅ Создание объекта QtByteArray
//✅ Получение размера и длины (Размер, Длина)
//✅ Проверка состояния (Пустой, Нулевой)
//✅ Доступ к символам (ПолучитьСимвол)
//✅ Извлечение частей (ПолучитьСередину, ПолучитьЛевуюЧасть, ПолучитьПравуюЧасть)
//✅ Добавление данных (ДобавитьДанные, ДобавитьСтроку, ДобавитьСимвол)
//✅ Вставка данных (ВставитьВНачало, ВставитьДанные, ВставитьСтроку, ВставитьСимвол)
//✅ Удаление данных (УдалитьДанные, ОбрезатьДанные, ОтрезатьДанные)
//✅ Замена данных (ЗаменитьДанные, ЗаменитьСтроку, ЗаменитьСимвол, ЗаменитьПоИндексу)
//✅ Поиск (НайтиДанные, НайтиСтроку, НайтиСимвол, СодержитДанные, СодержитСтроку, СодержитСимвол)
//✅ Проверка начала и конца (НачинаетсяСДанных, ЗаканчиваетсяНаДанные)
//✅ Преобразование (ВHexСтроку, ВBase64Строку, ВLatin1Строку, ВUtf8Строку)
//✅ Сравнение (РавноДанным, СравнитьДанные)
//✅ RusFunc (89 методов в JSON)
//✅ Очистка данных
//Диагностика показала:
//48 английских методов доступны
//48 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 7500, 89 элементов)
//Класс QtByteArray (наследник QtObject) предоставляет:
//Доступ к данным - ПолучитьДанные, ПолучитьКакСтроку, ПолучитьДлину, ПолучитьРазмер, ПолучитьПусто, ПолучитьСимвол, ПолучитьСередину, ПолучитьЛевуюЧасть, ПолучитьПравуюЧасть, ПолучитьHex, ПолучитьBase64
//Модификация - ДобавитьДанные, ДобавитьСтроку, ДобавитьСимвол, ВставитьВНачало, ВставитьВНачалоСтроку, ВставитьВНачалоСимвол, ВставитьДанные, ВставитьСтроку, ВставитьСимвол, УдалитьДанные, ЗаменитьДанные, ЗаменитьСтроку, ЗаменитьСимвол, ЗаменитьПоИндексу, ОчиститьДанные, ИзменитьРазмер, ОбрезатьДанные, ОтрезатьДанные
//Поиск - НайтиДанные, НайтиСтроку, НайтиСимвол, НайтиПоследниеДанные, НайтиПоследнююСтроку, НайтиПоследнийСимвол, СодержитДанные, СодержитСтроку, СодержитСимвол, НачинаетсяСДанных, НачинаетсяСоСтрокой, НачинаетсяССимволом, ЗаканчиваетсяНаДанные, ЗаканчиваетсяНаСтроку, ЗаканчиваетсяНаСимвол, КоличествоДанных, КоличествоСтрок, КоличествоСимволов
//Преобразование - ВHexСтроку, ВBase64Строку, ВPercentEncodingСтроку, ВLatin1Строку, ВUtf8Строку, ПолучитьСжатые, ПолучитьРаспакованные, ВBase64БезРавных
//Операции статуса - ЯвляетсяНулевым, ЗаполнитьСимволом, ПолучитьУпрощенные, ПолучитьОбрезанные, ПолучитьНижнийРегистр, ПолучитьВерхнийРегистр, ПолучитьПовторенные
//Работа с буфером - ПолучитьЕмкость, ЗарезервироватьПамять, СжатьПамять
//Сравнение - РавноДанным, РавноСтроке, МеньшеЧем, БольшеЧем, СравнитьДанные, СравнитьСоСтрокой
//Преобразование чисел - ЧислоВСтроку, ДлинноеЧислоВСтроку, ЧислоСПлавающейТочкойВСтроку, ИзHexСтроки, ИзBase64Строки, ИзPercentEncodingСтроки
//Вывод:
//Класс QtByteArray полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с байтовыми массивами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtБайтМассив
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtByteArray()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtБайтМассив ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtByteArray: " + (typeof QtByteArray !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtБайтМассив: " + (typeof QtБайтМассив !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtБайтМассив: " + e)
    КонецПопытки;
    
    Попытка
        диагМассив = Новый QtБайтМассив()
        Если диагМассив == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtБайтМассив не создан")
            Возврат
        КонецЕсли;
        
        диагМассив.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtБайтМассив создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "getData", "getAsString", "getLength", "getSize", "getIsEmpty",
            "getCharAt", "getMid", "getLeft", "getRight", "getHex", "getBase64",
            "appendData", "appendString", "appendChar",
            "prependData", "prependString", "prependChar",
            "insertData", "insertString", "insertChar",
            "removeData", "replaceData", "replaceString", "replaceChar", "replaceAt",
            "clearData", "resizeData", "truncateData", "chopData",
            "findData", "findString", "findChar",
            "findLastData", "findLastString", "findLastChar",
            "containsData", "containsString", "containsChar",
            "startsWithData", "startsWithString", "startsWithChar",
            "endsWithData", "endsWithString", "endsWithChar",
            "countData", "countString", "countChar",
            "toHexString", "toBase64String", "toPercentEncodingString",
            "toLatin1String", "toUtf8String",
            "getCompressed", "getDecompressed", "toBase64WithoutEquals",
            "isNull", "fillWithChar", "getSimplified", "getTrimmed",
            "getLower", "getUpper", "getRepeated",
            "getCapacity", "reserveSpace", "shrinkMemory",
            "equalsData", "equalsString", "isLessThan", "isGreaterThan",
            "compareData", "compareString",
            "numberToStr", "numberLongToStr", "numberDoubleToStr",
            "fromHexString", "fromBase64String", "fromPercentEncodingString",
            "getRealByteArray"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМассив[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "ПолучитьДанные", "ПолучитьКакСтроку", "ПолучитьДлину", "ПолучитьРазмер", "ПолучитьПусто",
            "ПолучитьСимвол", "ПолучитьСередину", "ПолучитьЛевуюЧасть", "ПолучитьПравуюЧасть", "ПолучитьHex", "ПолучитьBase64",
            "ДобавитьДанные", "ДобавитьСтроку", "ДобавитьСимвол",
            "ВставитьВНачало", "ВставитьВНачалоСтроку", "ВставитьВНачалоСимвол",
            "ВставитьДанные", "ВставитьСтроку", "ВставитьСимвол",
            "УдалитьДанные", "ЗаменитьДанные", "ЗаменитьСтроку", "ЗаменитьСимвол", "ЗаменитьПоИндексу",
            "ОчиститьДанные", "ИзменитьРазмер", "ОбрезатьДанные", "ОтрезатьДанные",
            "НайтиДанные", "НайтиСтроку", "НайтиСимвол",
            "НайтиПоследниеДанные", "НайтиПоследнююСтроку", "НайтиПоследнийСимвол",
            "СодержитДанные", "СодержитСтроку", "СодержитСимвол",
            "НачинаетсяСДанных", "НачинаетсяСоСтрокой", "НачинаетсяССимволом",
            "ЗаканчиваетсяНаДанные", "ЗаканчиваетсяНаСтроку", "ЗаканчиваетсяНаСимвол",
            "КоличествоДанных", "КоличествоСтрок", "КоличествоСимволов",
            "ВHexСтроку", "ВBase64Строку", "ВPercentEncodingСтроку",
            "ВLatin1Строку", "ВUtf8Строку",
            "ПолучитьСжатые", "ПолучитьРаспакованные", "ВBase64БезРавных",
            "ЯвляетсяНулевым", "ЗаполнитьСимволом", "ПолучитьУпрощенные", "ПолучитьОбрезанные",
            "ПолучитьНижнийРегистр", "ПолучитьВерхнийРегистр", "ПолучитьПовторенные",
            "ПолучитьЕмкость", "ЗарезервироватьПамять", "СжатьПамять",
            "РавноДанным", "РавноСтроке", "МеньшеЧем", "БольшеЧем",
            "СравнитьДанные", "СравнитьСоСтрокой",
            "ЧислоВСтроку", "ДлинноеЧислоВСтроку", "ЧислоСПлавающейТочкойВСтроку",
            "ИзHexСтроки", "ИзBase64Строки", "ИзPercentEncodingСтроки",
            "ПолучитьQByteArray"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМассив[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМассив.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМассив.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtБайтМассив: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtБайтМассив
// ============================================================

Функция ДиагностикаМетаОбъектаByteArray()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtБайтМассив ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtByteArray: " + (typeof QtByteArray !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtБайтМассив: " + (typeof QtБайтМассив !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        массив = Новый QtБайтМассив()
        Если массив == null Тогда
            массив = new QtБайтМассив()
            Если массив == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtБайтМассив()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtБайтМассив:")
    методы = Object.getOwnPropertyNames(массив)
    прототип = Object.getPrototypeOf(массив)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof массив[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof массив.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = массив.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtБайтМассив (QtByteArray) - ИСПРАВЛЕННАЯ ВЕРСИЯ 2
// ============================================================

Функция ТестQtByteArrayFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        массив = Новый QtБайтМассив()
        массив.РежимОтладки(Режим_Отладки)
        Если массив != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtБайтМассив создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtБайтМассив НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если массив == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА РАЗМЕРА И ДЛИНЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка размера и длины")
    СброситьЦветКонсоли()
    
    Попытка
        размер = массив.getSize()
        длина = массив.getLength()
        пусто = массив.getIsEmpty()
        ВывестиСтрокуВКонсоль("    getSize(): " + размер + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("    getLength(): " + длина + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("    getIsEmpty(): " + пусто + " (ожидается true)")
        
        Если размер == 0 И длина == 0 И пусто == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка размера и длины работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка размера и длины не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ДОБАВЛЕНИЯ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Добавление данных")
    СброситьЦветКонсоли()
    
    Попытка
        массив2 = Новый QtБайтМассив()
        массив2.РежимОтладки(Режим_Отладки)
        массив2.appendString("Hello")
        массив2.appendChar(32) // пробел
        массив2.appendString("World")
        
        результат = массив2.getAsString()
        размер2 = массив2.getSize()
        ВывестиСтрокуВКонсоль("    appendString('Hello'), appendChar(32), appendString('World')")
        ВывестиСтрокуВКонсоль("    getAsString(): " + результат)
        ВывестиСтрокуВКонсоль("    getSize(): " + размер2 + " (ожидается 11)")
        
        Если размер2 == 11 Тогда
