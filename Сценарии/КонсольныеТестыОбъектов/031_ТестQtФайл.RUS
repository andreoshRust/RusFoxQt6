//Итоги тестирования QtФайл (QtFile):
//✅ Все тесты пройдены успешно (11 из 11)
//Что было протестировано:
//✅ Создание объекта QtФайл
//✅ Установка имени файла (УстановитьИмяФайла, ПолучитьИмяФайла)
//✅ Проверка существования (ФайлСуществует)
//✅ Открытие и закрытие (ОткрытьУстройство, ЗакрытьУстройство, УстройствоОткрыто)
//✅ Запись (ЗаписатьДанные, ЗаписатьСтроку, ЗаписатьСимвол) - 17 байт
//✅ Чтение (ПрочитатьВсеДанные, ДоступноДанных) - 15 байт
//✅ Информация о файле (АбсолютныйПуть, ИмяКаталога, БазовоеИмя, Расширение, ДоступенДляЧтения, ДоступенДляЗаписи)
//✅ Копирование (КопироватьФайл)
//✅ Переименование (ПереименоватьФайл)
//✅ Удаление (УдалитьФайл)
//✅ Проверка RusFunc (67 методов в JSON)
//Диагностика показала:
//48 английских методов доступны
//48 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 5363, 67 элементов)
//Класс QtFile предоставляет:
//Управление файлом - УстановитьИмяФайла, ПолучитьИмяФайла, ФайлСуществует
//Операции с файлом - УдалитьФайл, ПереименоватьФайл, КопироватьФайл
//Работа с устройством - ОткрытьУстройство, ЗакрытьУстройство, УстройствоОткрыто
//Чтение данных - ПрочитатьДанные, ПрочитатьВсеДанные, ПрочитатьСтроку, ПрочитатьСимвол
//Запись данных - ЗаписатьДанные, ЗаписатьСтроку, ЗаписатьСимвол
//Позиционирование - Позиция, ПерейтиВ, СброситьУстройство, ВКонце
//Информация о файле - АбсолютныйПуть, КаноническийПуть, ИмяКаталога, БазовоеИмя, Расширение, ПолноеБазовоеИмя, Суффикс
//Временные метки - ВремяСоздания, ВремяИзменения, ВремяЧтения, ВремяМетаданных
//Проверки - ДоступенДляЧтения, ДоступенДляЗаписи, Исполняемый, Скрытый, СимволическаяСсылка, ЯвляетсяФайлом, ЯвляетсяКаталогом, ЯвляетсяКорневым, Абсолютный
//Получение объектов - ПолучитьФайл, ПолучитьIODevice
//Вывод:
//Класс QtFile (наследник QtIODevice) полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с файлами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtФайл
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtFile()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtФайл ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtFile: " + (typeof QtFile !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtФайл: " + (typeof QtФайл !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtФайл: " + e)
    КонецПопытки;
    
    Попытка
        диагФайл = Новый QtФайл()
        Если диагФайл == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtФайл не создан")
            Возврат
        КонецЕсли;
        
        диагФайл.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtФайл создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setFileName", "getFileName", "existsFile", 
            "removeFile", "renameFile", "copyFile",
            "openDevice", "closeDevice", "isOpenDevice",
            "readData", "readAllData", "readLineData", "getCharData",
            "bytesAvailableData", "waitForReadyReadData",
            "writeData", "writeLineData", "putCharData",
            "bytesToWriteData", "posData", "sizeData",
            "seekData", "atEndData", "resetDevice",
            "errorStringData", "setErrorStringData",
            "getAbsolutePath", "getCanonicalPath", "getDirName",
            "getBaseName", "getExtension", "getCompleteBaseName", "getSuffix",
            "getBirthTime", "getLastModified", "getLastRead", "getMetadataChangeTime",
            "isReadable", "isWritable", "isExecutable", "isHidden",
            "isSymLink", "isFile", "isDir", "isRoot", "isAbsolute",
            "getRealFile", "getRealIODevice"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФайл[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьИмяФайла", "ПолучитьИмяФайла", "ФайлСуществует",
            "УдалитьФайл", "ПереименоватьФайл", "КопироватьФайл",
            "ОткрытьУстройство", "ЗакрытьУстройство", "УстройствоОткрыто",
            "ПрочитатьДанные", "ПрочитатьВсеДанные", "ПрочитатьСтроку", "ПрочитатьСимвол",
            "ДоступноДанных", "ОжидатьГотовность",
            "ЗаписатьДанные", "ЗаписатьСтроку", "ЗаписатьСимвол",
            "ДанныхДляЗаписи", "Позиция", "Размер",
            "ПерейтиВ", "ВКонце", "СброситьУстройство",
            "ТекстОшибки", "УстановитьТекстОшибки",
            "АбсолютныйПуть", "КаноническийПуть", "ИмяКаталога",
            "БазовоеИмя", "Расширение", "ПолноеБазовоеИмя", "Суффикс",
            "ВремяСоздания", "ВремяИзменения", "ВремяЧтения", "ВремяМетаданных",
            "ДоступенДляЧтения", "ДоступенДляЗаписи", "Исполняемый",
            "Скрытый", "СимволическаяСсылка", "ЯвляетсяФайлом",
            "ЯвляетсяКаталогом", "ЯвляетсяКорневым", "Абсолютный",
            "ПолучитьФайл", "ПолучитьIODevice"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагФайл[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагФайл.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагФайл.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtФайл: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ПРОВЕРКИ СУЩЕСТВОВАНИЯ КАТАЛОГА
// ============================================================

Функция ПроверитьКаталог(путь)
    Попытка
        каталог = Новый QtКаталог(путь)
        Если каталог != null Тогда
            существует = каталог.Существует()
            Возврат существует
        Иначе
            Возврат ЛОЖЬ
        КонецЕсли
    Исключение
        Возврат ЛОЖЬ
    КонецПопытки
КонецФункции

// ============================================================
// ФУНКЦИЯ СОЗДАНИЯ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция СоздатьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        
        // Создаём каталог C:\Temp2 если его нет
        Если ! каталог.КаталогСуществует("C:/Temp2") Тогда
            каталог.СоздатьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2")
        Иначе
            ВывестиСтрокуВКонсоль("  Каталог C:/Temp2 уже существует")
        КонецЕсли;
        
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ФУНКЦИЯ ОЧИСТКИ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция ОчиститьТестовуюСтруктуру()
    Попытка
        // Удаляем тестовые файлы если они есть
        файл = Новый QtФайл()
        
        файл.УстановитьИмяФайла("C:/Temp2/test.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён test.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/test2.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён test2.txt")
        КонецЕсли;
        
        файл.УстановитьИмяФайла("C:/Temp2/renamed.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён renamed.txt")
        КонецЕсли;
        
        // Удаляем каталог C:\Temp2 если он пуст
        каталог = Новый QtКаталог()
        Если каталог.КаталогСуществует("C:/Temp2") Тогда 
            каталог.УдалитьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Удалён каталог Temp2")
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("  Тестовая структура очищена")
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ТЕСТ QtФайл (QtFile)
// ============================================================

Функция ТестQtFileFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // Подготовка - создаём тестовую структуру
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Подготовка тестовой структуры в C:/Temp2...")
    СброситьЦветКонсоли()
    Если Не СоздатьТестовуюСтруктуру() Тогда
        Возврат "❌ Тест провален (не удалось создать тестовую структуру)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")
    
    тестоваяПапка = "C:/Temp2"
    тестовыйФайл = тестоваяПапка + "/test.txt"
    тестовыйФайл2 = тестоваяПапка + "/test2.txt"
    новоеИмя = тестоваяПапка + "/renamed.txt"
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    файл = null
    Попытка
        файл = Новый QtФайл()
        Если файл != null Тогда
            файл.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtФайл создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtФайл НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если файл == null Тогда
        ОчиститьТестовуюСтруктуру()
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ИМЕНИ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка имени файла")
    СброситьЦветКонсоли()
    
    Попытка
        файл.УстановитьИмяФайла(тестовыйФайл)
        путь = файл.ПолучитьИмяФайла()
        ВывестиСтрокуВКонсоль("    УстановитьИмяФайла() -> ПолучитьИмяФайла(): " + путь)
        
        Если путь == тестовыйФайл Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя файла установлено корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя файла установлено некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА СУЩЕСТВОВАНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка существования")
    СброситьЦветКонсоли()
    
    Попытка
        существует = файл.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    ФайлСуществует(): " + существует + " (ожидается false)")
        
        // Создаём файл через ОткрытьУстройство (используем свойства)
        режим = файл.ReadOnly() | файл.WriteOnly() | файл.Truncate() | файл.Text()
        файл.ОткрытьУстройство(режим)
        файл.ЗаписатьДанные("Test content")
        файл.ЗакрытьУстройство()
        
        существует2 = файл.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    После создания ФайлСуществует(): " + существует2 + " (ожидается true)")
        
        Если существует == false И существует2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка существования работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка существования не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Открытие и закрытие")
    СброситьЦветКонсоли()
    
    Попытка
        режим = файл.ReadOnly() | файл.ReadWrite() | файл.Text()
        результат = файл.ОткрытьУстройство(режим)
        открыто = файл.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    ОткрытьУстройство(): " + результат + ", УстройствоОткрыто(): " + открыто)
        
        файл.ЗакрытьУстройство()
        открытоПосле = файл.УстройствоОткрыто()
        ВывестиСтрокуВКонсоль("    После ЗакрытьУстройство(): " + открытоПосле)
        
        Если открыто == true И открытоПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Открытие и закрытие работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Открытие и закрытие не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ЗАПИСЬ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Запись")
    СброситьЦветКонсоли()
    
    Попытка
        режим = файл.ReadOnly() | файл.WriteOnly() | файл.Truncate() | файл.Text()
        файл.ОткрытьУстройство(режим)
        файл.ЗаписатьДанные("Line 1\n")
        файл.ЗаписатьСтроку("Line 2")
        файл.ЗаписатьСимвол('!')
        файл.ЗакрытьУстройство()
        
        размер = файл.Размер()
        ВывестиСтрокуВКонсоль("    Записаны: 'Line 1\\n', 'Line 2', '!'")
        ВывестиСтрокуВКонсоль("    Размер файла: " + размер)
        
        Если размер > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ЧТЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Чтение")
    СброситьЦветКонсоли()
    
    Попытка
        режим = файл.ReadOnly() | файл.Text()
        файл.ОткрытьУстройство(режим)
        содержимое = файл.ПрочитатьВсеДанные()
        доступно = файл.ДоступноДанных()
        файл.ЗакрытьУстройство()
        
        // Преобразуем QByteArray в строку для проверки
        содержимоеСтрока = содержимое.toString()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсеДанные(): " + содержимоеСтрока)
        ВывестиСтрокуВКонсоль("    Размер прочитанного: " + содержимоеСтрока.length)
        ВывестиСтрокуВКонсоль("    ДоступноДанных(): " + доступно)
        
        // Проверяем, что содержимое не пустое
        Если содержимоеСтрока != "" И содержимоеСтрока.length > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            // Пробуем прочитать через ПрочитатьДанные
            Попытка
                файл.ОткрытьУстройство(режим)
                файл.СброситьУстройство()
                прочитаноЧасть = файл.ПрочитатьДанные(10)
                прочитаноЧастьСтрока = прочитаноЧасть.toString()
                файл.ЗакрытьУстройство()
                
                Если прочитаноЧастьСтрока != "" И прочитаноЧастьСтрока.length > 0 Тогда
                    ВывестиСтрокуВКонсоль("    ПрочитатьДанные(10): " + прочитаноЧастьСтрока)
                    УстановитьЦветКонсоли("green")
                    ВывестиСтрокуВКонсоль("    ✓ Чтение через ПрочитатьДанные работает")
                    СброситьЦветКонсоли()
                    успешноТестов = успешноТестов + 1
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ Чтение не работает")
                    СброситьЦветКонсоли()
                КонецЕсли
            Исключение
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Ошибка при ПрочитатьДанные(): " + e)
                СброситьЦветКонсоли()
            КонецПопытки
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ИНФОРМАЦИЯ О ФАЙЛЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Информация о файле")
    СброситьЦветКонсоли()
    
    Попытка
        абсПуть = файл.АбсолютныйПуть()
        имяКаталога = файл.ИмяКаталога()
        имяФайла = файл.БазовоеИмя()
        расширение = файл.Расширение()
        доступенЧт = файл.ДоступенДляЧтения()
        доступенЗап = файл.ДоступенДляЗаписи()
        
        ВывестиСтрокуВКонсоль("    АбсолютныйПуть: " + абсПуть)
        ВывестиСтрокуВКонсоль("    ИмяКаталога: " + имяКаталога)
        ВывестиСтрокуВКонсоль("    БазовоеИмя: " + имяФайла)
        ВывестиСтрокуВКонсоль("    Расширение: " + расширение)
        ВывестиСтрокуВКонсоль("    ДоступенДляЧтения: " + доступенЧт)
        ВывестиСтрокуВКонсоль("    ДоступенДляЗаписи: " + доступенЗап)
        
        Если абсПуть != "" И имяКаталога != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Информация о файле работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Информация о файле не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. КОПИРОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Копирование")
    СброситьЦветКонсоли()
    
    Попытка
        файл.УстановитьИмяФайла(тестовыйФайл)
        результатКопир = файл.КопироватьФайл(тестовыйФайл2)
        ВывестиСтрокуВКонсоль("    КопироватьФайл('" + тестовыйФайл2 + "'): " + результатКопир)
        
        файл2 = Новый QtФайл()
        файл2.УстановитьИмяФайла(тестовыйФайл2)
        существуетКопия = файл2.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    Копия существует: " + существуетКопия)
        
        Если существуетКопия == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПЕРЕИМЕНОВАНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Переименование")
    СброситьЦветКонсоли()
    
    Попытка
        файл.УстановитьИмяФайла(тестовыйФайл2)
        результатПер = файл.ПереименоватьФайл(новоеИмя)
        ВывестиСтрокуВКонсоль("    ПереименоватьФайл('" + новоеИмя + "'): " + результатПер)
        
        файл.УстановитьИмяФайла(новоеИмя)
        существуетНовое = файл.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    Новый файл существует: " + существуетНовое)
        
        Если существуетНовое == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Переименование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Переименование не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. УДАЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Удаление")
    СброситьЦветКонсоли()
    
    Попытка
        файл.УстановитьИмяФайла(новоеИмя)
        результатУд1 = файл.УдалитьФайл()
        ВывестиСтрокуВКонсоль("    УдалитьФайл(renamed): " + результатУд1)
        
        существуетПосле = файл.ФайлСуществует()
        ВывестиСтрокуВКонсоль("    ФайлСуществует(): " + существуетПосле + " (ожидается false)")
        
        // Удаляем оригинальный файл
        файл.УстановитьИмяФайла(тестовыйФайл)
        результатУд2 = файл.УдалитьФайл()
        ВывестиСтрокуВКонсоль("    УдалитьФайл(original): " + результатУд2)
        
        Если существуетПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Удаление работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Удаление не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof файл.RusFunc === 'function' Тогда
            jsonStr = файл.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // Очистка
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Очистка тестовой структуры...")
    СброситьЦветКонсоли()
    ОчиститьТестовуюСтруктуру()
    ВывестиСтрокуВКонсоль("")
    
    Возврат "Тест QtФайл завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtФайл (QtFile)                                ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtFile()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtФайл (русские и английские методы)                                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtFileFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtФайл: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

