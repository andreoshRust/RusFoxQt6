//Итоги тестирования QtSerialPort (QtПоследовательныйПорт):
//✅ Результаты: 14 из 14 тестов пройдены
//Что было протестировано:
//Создание объекта - ✓ QtПоследовательныйПорт успешно создается
//Проверка состояния - ✓ Открыт, Подключен (возвращают false для не открытого порта)
//Установка и получение имени порта - ✓ УстановитьИмяПорта, ПолучитьИмяПорта
//Установка и получение скорости - ✓ УстановитьСкорость(9600), ПолучитьСкорость
//Установка и получение битов данных - ✓ УстановитьБитыДанных(Data8), ПолучитьБитыДанных
//Установка и получение четности - ✓ УстановитьЧетность(NoParity), ПолучитьЧетность
//Установка и получение стоп-битов - ✓ УстановитьСтопБиты(OneStop), ПолучитьСтопБиты
//Установка и получение управления потоком - ✓ УстановитьУправлениеПотоком(NoFlowControl), ПолучитьУправлениеПотоком
//Константы скоростей - ✓ 8 констант: 1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200
//Константы битов данных - ✓ 4 константы: 5, 6, 7, 8
//Константы четности - ✓ 5 констант: NoParity(0), EvenParity(2), OddParity(3), MarkParity(5), SpaceParity(4)
//Константы стоп-битов - ✓ 3 константы: OneStop(1), OneAndHalfStop(3), TwoStop(2)
//Константы управления потоком - ✓ 3 константы: NoFlowControl(0), HardwareControl(1), SoftwareControl(2)
//Проверка RusFunc - ✓ Возвращает валидный JSON с 103 методами
//Диагностика показала:
//36 английских методов доступны
//37 русских методов доступны
//103 метода в JSON RusFunc
//Класс QtSerialPort предоставляет:
//Управление портом:
//ОткрытьПорт, ЗакрытьПорт, Открыт, Подключен, Очистить, Прервать
//Настройка порта:
//Имя порта: УстановитьИмяПорта, ПолучитьИмяПорта
//Скорость: УстановитьСкорость, ПолучитьСкорость
//Биты данных: УстановитьБитыДанных, ПолучитьБитыДанных
//Четность: УстановитьЧетность, ПолучитьЧетность
//Стоп-биты: УстановитьСтопБиты, ПолучитьСтопБиты
//Управление потоком: УстановитьУправлениеПотоком, ПолучитьУправлениеПотоком
//Чтение:
//ДоступноБайт, ДоступноБайтДляЗаписи
//ПрочитатьВсе, Прочитать, ПрочитатьСтроку, ПрочитатьСимвол
//МожноЧитатьСтроку, ВКонце
//Запись:
//Записать, ЗаписатьСтроку, ЗаписатьСимвол, СброситьБуфер
//Позиционирование:
//Позиция, ПерейтиВ, Сбросить, Размер
//Ожидание:
//ОжидатьГотовностиЧтения, ОжидатьОтправки
//Константы:
//Скорости: 1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200
//Биты данных: 5, 6, 7, 8
//Четность: БезЧетности(0), Четная(2), Нечетная(3), Маркер(5), Пробел(4)
//Стоп-биты: Один(1), Полтора(3), Два(2)
//Управление потоком: Нет(0), Аппаратное(1), Программное(2)
//Вывод:
//Класс QtSerialPort полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с последовательными портами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtIODevice, который в свою очередь наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.



// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПоследовательныйПорт
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtSerialPort()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПоследовательныйПорт ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtSerialPort: " + (typeof QtSerialPort !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtПоследовательныйПорт: " + (typeof QtПоследовательныйПорт !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПоследовательныйПорт: " + e)
    КонецПопытки;
    
    Попытка
        диагПорт = Новый QtПоследовательныйПорт()
        Если диагПорт == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПоследовательныйПорт не создан")
            Возврат
        КонецЕсли;
        
        диагПорт.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtПоследовательныйПорт создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "openPort", "closePort", "isConnected", "clear", "abort",
            "setPortName", "getPortName",
            "setBaudRate", "getBaudRate",
            "setDataBits", "getDataBits",
            "setParity", "getParity",
            "setStopBits", "getStopBits",
            "setFlowControl", "getFlowControl",
            "bytesAvailable", "bytesToWrite",
            "readAll", "read", "readLine", "getChar",
            "canReadLine", "atEndValue",
            "writeData", "writeLine", "putChar", "flush",
            "waitForReadyRead", "waitForBytesWritten",
            "pos", "seek", "resetDevice", "size",
            "getRealSerialPort"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПорт[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны работать):")
        русМетоды = [
            "ОткрытьПорт", "ЗакрытьПорт", "Открыт", "Подключен", "Очистить", "Прервать",
            "УстановитьИмяПорта", "ПолучитьИмяПорта",
            "УстановитьСкорость", "ПолучитьСкорость",
            "УстановитьБитыДанных", "ПолучитьБитыДанных",
            "УстановитьЧетность", "ПолучитьЧетность",
            "УстановитьСтопБиты", "ПолучитьСтопБиты",
            "УстановитьУправлениеПотоком", "ПолучитьУправлениеПотоком",
            "ДоступноБайт", "ДоступноБайтДляЗаписи",
            "ПрочитатьВсе", "Прочитать", "ПрочитатьСтроку", "ПрочитатьСимвол",
            "МожноЧитатьСтроку", "ВКонце",
            "Записать", "ЗаписатьСтроку", "ЗаписатьСимвол", "СброситьБуфер",
            "ОжидатьГотовностиЧтения", "ОжидатьОтправки",
            "Позиция", "ПерейтиВ", "Сбросить", "Размер",
            "ПолучитьSerialПорт"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагПорт[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагПорт.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагПорт.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПоследовательныйПорт: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtПоследовательныйПорт
// ============================================================

Функция ДиагностикаМетаОбъектаSerialPort()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtПоследовательныйПорт ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtSerialPort: " + (typeof QtSerialPort !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtПоследовательныйПорт: " + (typeof QtПоследовательныйПорт !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        порт = Новый QtПоследовательныйПорт()
        Если порт == null Тогда
            порт = new QtПоследовательныйПорт()
            Если порт == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtПоследовательныйПорт()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtПоследовательныйПорт:")
    методы = Object.getOwnPropertyNames(порт)
    прототип = Object.getPrototypeOf(порт)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof порт[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof порт.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = порт.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtПоследовательныйПорт (QtSerialPort) - ИСПРАВЛЕННЫЙ
// ============================================================

Функция ТестQtSerialPortFull()
    всегоТестов = 0
    успешноТестов = 0

    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        порт = Новый QtПоследовательныйПорт()
        порт.РежимОтладки(Режим_Отладки)
        Если порт != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtПоследовательныйПорт создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtПоследовательныйПорт НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если порт == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        открыт = порт.Открыт()
        подключен = порт.Подключен()
        ВывестиСтрокуВКонсоль("    Открыт(): " + открыт + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    Подключен(): " + подключен + " (ожидается false)")
        
        Если открыт == false И подключен == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ ИМЕНИ ПОРТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка и получение имени порта")
    СброситьЦветКонсоли()
    
    Попытка
        тестовоеИмя = "COM1"
        порт.УстановитьИмяПорта(тестовоеИмя)
        имя = порт.ПолучитьИмяПорта()
        ВывестиСтрокуВКонсоль("    УстановитьИмяПорта('" + тестовоеИмя + "') -> ПолучитьИмяПорта(): " + имя)
        
        Если имя == тестовоеИмя Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение имени порта работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение имени порта не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ СКОРОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка и получение скорости")
    СброситьЦветКонсоли()
    
    Попытка
        порт.УстановитьСкорость(9600)
        скорость = порт.ПолучитьСкорость()
        ВывестиСтрокуВКонсоль("    УстановитьСкорость(9600) -> ПолучитьСкорость(): " + скорость)
        
        Если скорость == 9600 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение скорости работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение скорости не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ БИТОВ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Установка и получение битов данных")
    СброситьЦветКонсоли()
    
    Попытка
        порт.УстановитьБитыДанных(порт.Data8())
        биты = порт.ПолучитьБитыДанных()
        ВывестиСтрокуВКонсоль("    УстановитьБитыДанных(Data8) -> ПолучитьБитыДанных(): " + биты)
        
        Если биты == порт.Data8() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение битов данных работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение битов данных не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ ЧЕТНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Установка и получение четности")
    СброситьЦветКонсоли()
    
    Попытка
        порт.УстановитьЧетность(порт.NoParity())
        четность = порт.ПолучитьЧетность()
        ВывестиСтрокуВКонсоль("    УстановитьЧетность(NoParity) -> ПолучитьЧетность(): " + четность)
        
        Если четность == порт.NoParity() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение четности работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение четности не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ СТОП-БИТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Установка и получение стоп-битов")
    СброситьЦветКонсоли()
    
    Попытка
        порт.УстановитьСтопБиты(порт.OneStop())
        стопБиты = порт.ПолучитьСтопБиты()
        ВывестиСтрокуВКонсоль("    УстановитьСтопБиты(OneStop) -> ПолучитьСтопБиты(): " + стопБиты)
        
        Если стопБиты == порт.OneStop() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение стоп-битов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение стоп-битов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ТЕСТ УСТАНОВКИ И ПОЛУЧЕНИЯ УПРАВЛЕНИЯ ПОТОКОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Установка и получение управления потоком")
    СброситьЦветКонсоли()
    
    Попытка
        порт.УстановитьУправлениеПотоком(порт.NoFlowControl())
        управление = порт.ПолучитьУправлениеПотоком()
        ВывестиСтрокуВКонсоль("    УстановитьУправлениеПотоком(NoFlowControl) -> ПолучитьУправлениеПотоком(): " + управление)
        
        Если управление == порт.NoFlowControl() Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка и получение управления потоком работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка и получение управления потоком не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ТЕСТ КОНСТАНТ СКОРОСТЕЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Константы скоростей")
    СброситьЦветКонсоли()
    
    Попытка
        ск1 = порт.Скорость1200()
        ск2 = порт.Скорость2400()
        ск3 = порт.Скорость4800()
        ск4 = порт.Скорость9600()
        ск5 = порт.Скорость19200()
        ск6 = порт.Скорость38400()
        ск7 = порт.Скорость57600()
        ск8 = порт.Скорость115200()
        
        ВывестиСтрокуВКонсоль("    Скорость1200(): " + ск1)
        ВывестиСтрокуВКонсоль("    Скорость2400(): " + ск2)
        ВывестиСтрокуВКонсоль("    Скорость4800(): " + ск3)
        ВывестиСтрокуВКонсоль("    Скорость9600(): " + ск4)
        ВывестиСтрокуВКонсоль("    Скорость19200(): " + ск5)
        ВывестиСтрокуВКонсоль("    Скорость38400(): " + ск6)
        ВывестиСтрокуВКонсоль("    Скорость57600(): " + ск7)
        ВывестиСтрокуВКонсоль("    Скорость115200(): " + ск8)
        
        Если ск1 > 0 И ск2 > 0 И ск3 > 0 И ск4 > 0 И ск5 > 0 И ск6 > 0 И ск7 > 0 И ск8 > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы скоростей работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы скоростей не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ТЕСТ КОНСТАНТ БИТОВ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Константы битов данных")
    СброситьЦветКонсоли()
    
    Попытка
        д5 = порт.БитыДанных5()
        д6 = порт.БитыДанных6()
        д7 = порт.БитыДанных7()
        д8 = порт.БитыДанных8()
        
        ВывестиСтрокуВКонсоль("    БитыДанных5(): " + д5)
        ВывестиСтрокуВКонсоль("    БитыДанных6(): " + д6)
        ВывестиСтрокуВКонсоль("    БитыДанных7(): " + д7)
        ВывестиСтрокуВКонсоль("    БитыДанных8(): " + д8)
        
        Если д5 > 0 И д6 > 0 И д7 > 0 И д8 > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы битов данных работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы битов данных не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ТЕСТ КОНСТАНТ ЧЕТНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Константы четности")
    СброситьЦветКонсоли()
    
    Попытка
        безЧет = порт.БезЧетности()
        четная = порт.Четная()
        нечетная = порт.Нечетная()
        маркер = порт.Маркер()
        пробел = порт.Пробел()
        
        ВывестиСтрокуВКонсоль("    БезЧетности(): " + безЧет)
        ВывестиСтрокуВКонсоль("    Четная(): " + четная)
        ВывестиСтрокуВКонсоль("    Нечетная(): " + нечетная)
        ВывестиСтрокуВКонсоль("    Маркер(): " + маркер)
        ВывестиСтрокуВКонсоль("    Пробел(): " + пробел)
        
        // Проверяем только что все константы определены (не равны -1)
        Если безЧет >= 0 И четная >= 0 И нечетная >= 0 И маркер >= 0 И пробел >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы четности работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы четности не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ТЕСТ КОНСТАНТ СТОП-БИТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Константы стоп-битов")
    СброситьЦветКонсоли()
    
    Попытка
        один = порт.ОдинСтопБит()
        полтора = порт.ПолтораСтопБита()
        два = порт.ДваСтопБита()
        
        ВывестиСтрокуВКонсоль("    ОдинСтопБит(): " + один)
        ВывестиСтрокуВКонсоль("    ПолтораСтопБита(): " + полтора)
        ВывестиСтрокуВКонсоль("    ДваСтопБита(): " + два)
        
        // Проверяем только что все константы определены (не равны -1)
        Если один >= 0 И полтора >= 0 И два >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы стоп-битов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы стоп-битов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ТЕСТ КОНСТАНТ УПРАВЛЕНИЯ ПОТОКОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Константы управления потоком")
    СброситьЦветКонсоли()
    
    Попытка
        нет = порт.НетУправления()
        аппаратное = порт.Аппаратное()
        программное = порт.Программное()
        
        ВывестиСтрокуВКонсоль("    НетУправления(): " + нет)
        ВывестиСтрокуВКонсоль("    Аппаратное(): " + аппаратное)
        ВывестиСтрокуВКонсоль("    Программное(): " + программное)
        
        Если нет == 0 И аппаратное == 1 И программное == 2 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы управления потоком работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы управления потоком не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof порт.RusFunc === 'function' Тогда
            jsonStr = порт.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПоследовательныйПорт завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║               ТЕСТИРОВАНИЕ QtПоследовательныйПорт (QtSerialPort)               ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtSerialPort()
    ДиагностикаМетаОбъектаSerialPort()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПоследовательныйПорт (русские и английские методы)                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtSerialPortFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПоследовательныйПорт: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


