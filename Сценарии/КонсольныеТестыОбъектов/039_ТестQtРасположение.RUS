//Что было проверено:
//✅ Создание объекта - Новый QtРасположение(виджет)
//✅ Валидность - isValid() / Действителен()
//✅ Родительский виджет - parentWidget() / РодительскийВиджет()
//✅ Добавление виджета - addWidget() / ДобавитьВиджет()
//✅ Удаление виджета - removeWidget() / УдалитьВиджет()
//✅ Очистка - clear() / Очистить()
//✅ Отступы - setMargin() / margin() и УстановитьОтступ() / Отступ()
//✅ Промежутки - setSpacing() / spacing() и УстановитьПромежуток() / Промежуток()
//✅ Доступность - setEnabled() / isEnabled() и УстановитьДоступен() / Доступен()
//✅ Реальное расположение и тип - getRealLayout() / layoutType() и ПолучитьРасположение() / ТипРасположения()

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtРасположение
// ============================================================

Функция ДиагностикаМетодовQtLayout()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtРасположение ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtРасположение: " + (typeof QtРасположение !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtРасположение: " + e)
    КонецПопытки;
    
    Попытка
        диагВиджет = Новый QtВиджет()
        диагВиджет.Показать()
        диагLayout = Новый QtРасположение(диагВиджет)
        
        Если диагLayout == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtРасположение не создан")
            Возврат
        КонецЕсли;
        
        диагLayout.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtРасположение создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealLayout",
            "setParentWidget", "parentWidget",
            "addWidget", "addLayout", "removeWidget",
            "clear", "update", "activate", "invalidate",
            "itemAt", "takeAt", "count", "isEmpty",
            "geometry", "contentsRect",
            "setMargin", "margin",
            "setLeftMargin", "leftMargin",
            "setRightMargin", "rightMargin",
            "setTopMargin", "topMargin",
            "setBottomMargin", "bottomMargin",
            "setSpacing", "spacing",
            "setEnabled", "isEnabled",
            "setObjectName", "objectName",
            "layoutType", "layoutTypeString",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьРасположение",
            "УстановитьРодительскийВиджет", "РодительскийВиджет",
            "ДобавитьВиджет", "ДобавитьРасположение", "УдалитьВиджет",
            "Очистить", "Обновить", "Активировать", "Инвалидировать",
            "ЭлементПоИндексу", "ВзятьПоИндексу", "Количество", "Пустой",
            "Геометрия", "ПрямоугольникСодержимого",
            "УстановитьОтступ", "Отступ",
            "УстановитьЛевыйОтступ", "ЛевыйОтступ",
            "УстановитьПравыйОтступ", "ПравыйОтступ",
            "УстановитьВерхнийОтступ", "ВерхнийОтступ",
            "УстановитьНижнийОтступ", "НижнийОтступ",
            "УстановитьПромежуток", "Промежуток",
            "УстановитьДоступен", "Доступен",
            "УстановитьИмяОбъекта", "ИмяОбъекта",
            "ТипРасположения", "ТипРасположенияСтрока",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагLayout[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагLayout.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагLayout.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
        диагВиджет.Скрыть()
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtРасположение: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtРасположение
// ============================================================

Функция ТестQtLayout()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    виджет = Новый QtВиджет()
    виджет.Показать()
    расположение = null
    Попытка
        расположение = Новый QtРасположение(виджет)
        расположение.РежимОтладки(ИСТИНА)
        Если расположение != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtРасположение создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = расположение.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = расположение.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
// ===== 3. ТЕСТ: parentWidget() / РодительскийВиджет() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Получение родительского виджета")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Английский метод
Попытка
    родитель = расположение.parentWidget()
    ВывестиСтрокуВКонсоль("    [ENG] parentWidget() = " + (родитель != null ? "valid" : "null"))
    
    // Родитель может быть null, но метод должен работать без ошибок
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("    ✓ [ENG] parentWidget() работает корректно")
    СброситьЦветКонсоли()
    англУспех = ИСТИНА
    успешноАнгл = успешноАнгл + 1
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        родительРус = расположение.РодительскийВиджет()
        ВывестиСтрокуВКонсоль("    [RUS] РодительскийВиджет() = " + (родительРус != null ? "valid" : "null"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [RUS] РодительскийВиджет() работает корректно")
        СброситьЦветКонсоли()
        русУспех = ИСТИНА
        успешноРус = успешноРус + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 4. ТЕСТ: addWidget() / ДобавитьВиджет() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Добавление виджета")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Создаём кнопку и получаем реальный виджет
кнопка = Новый QtКнопка("Тестовая кнопка")
реальныйВиджет = кнопка.ПолучитьВиджет()

// Английский метод
Попытка
    расположение.addWidget(реальныйВиджет)
    кол = расположение.count()
    ВывестиСтрокуВКонсоль("    [ENG] addWidget() -> count()=" + кол + " (ожидается 1)")
    
    Если кол == 1 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] addWidget() работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] addWidget() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        расположение.Очистить()
        кнопка2 = Новый QtКнопка("Тестовая кнопка 2")
        реальныйВиджет2 = кнопка2.ПолучитьВиджет()
        расположение.ДобавитьВиджет(реальныйВиджет2)
        колРус = расположение.Количество()
        ВывестиСтрокуВКонсоль("    [RUS] ДобавитьВиджет() -> Количество()=" + колРус + " (ожидается 1)")
        
        Если колРус == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ДобавитьВиджет() работает корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] ДобавитьВиджет() ошибка")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 5. ТЕСТ: removeWidget() / УдалитьВиджет() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 5: Удаление виджета")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

расположение.Очистить()
кнопка3 = Новый QtКнопка("Кнопка для удаления")
реальныйВиджет3 = кнопка3.ПолучитьВиджет()
расположение.ДобавитьВиджет(реальныйВиджет3)

// Английский метод
Попытка
    расположение.removeWidget(реальныйВиджет3)
    кол = расположение.count()
    ВывестиСтрокуВКонсоль("    [ENG] removeWidget() -> count()=" + кол + " (ожидается 0)")
    
    Если кол == 0 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] removeWidget() работает корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
