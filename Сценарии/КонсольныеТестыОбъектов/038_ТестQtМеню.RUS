//Что было проверено:
//✅ Создание объекта - Новый QtМеню(виджет)
//✅ Валидность - isValid() / Действителен()
//✅ Заголовок - установка и получение
//✅ Доступность - включение/выключение
//✅ Видимость - показ/скрытие
//✅ Количество пунктов и проверка на пустоту
//✅ Добавление действий с колбэками и разделителей
//✅ Добавление подменю и работа с ними
//✅ Получение реальных объектов - getRealMenu() и getRealWidget()
//✅ Очистка меню

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtМеню (исправленная)
// ============================================================

Функция ДиагностикаМетодовQtMenu()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtМеню ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtМеню: " + (typeof QtМеню !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtМеню: " + e)
    КонецПопытки;
    
    Попытка
        // Создаём виджет
        диагВиджет = Новый QtВиджет()
        диагВиджет.Показать()
        
        // Создаём меню только с виджетом (работает)
        диагМеню = Новый QtМеню(диагВиджет)
        
        Если диагМеню == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtМеню не создан")
            Возврат
        КонецЕсли;
        
        диагМеню.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtМеню создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealMenu", "getRealWidget",
            "setTitle", "title",
            "setIcon", "icon",
            "setEnabled", "isEnabled",
            "setVisible", "isVisible",
            "count", "isEmpty", "parentWidget",
            "addAction", "addMenu", "addSeparator",
            "popup", "popupAtMouse", "exec", "execAt",
            "clear", "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМеню[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьМеню", "ПолучитьВиджет",
            "УстановитьЗаголовок", "Заголовок",
            "УстановитьИконку", "Иконка",
            "УстановитьДоступен", "Доступен",
            "УстановитьВидим", "Видим",
            "Количество", "Пустой", "РодительскийВиджет",
            "ДобавитьДействие", "ДобавитьПодменю", "ДобавитьРазделитель",
            "Показать", "ПоказатьВМыши", "Выполнить", "ВыполнитьВ",
            "Очистить", "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМеню[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМеню.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМеню.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
        // Закрываем виджет (используем метод Close или Hide)
        диагВиджет.Закрыть()
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtМеню: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции


// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtМеню
// ============================================================

Функция ТестQtMenu()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // Создаём виджет для тестов
    виджет = Новый QtВиджет()
    виджет.Показать()
    
// ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
меню = null
Попытка
    // Создаём виджет для меню
    тестВиджет1 = Новый QtВиджет()
    тестВиджет1.Показать()
    
    // Создаём меню только с виджетом (работает)
    меню = Новый QtМеню(тестВиджет1)
    // Устанавливаем заголовок отдельно
    меню.УстановитьЗаголовок("Файл")
    меню.РежимОтладки(ИСТИНА)
    
    Если меню != null Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Объект QtМеню создан")
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ИСТИНА
        русРезультаты[русРезультаты.length] = ИСТИНА
        успешноАнгл = успешноАнгл + 1
        успешноРус = успешноРус + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
    СброситьЦветКонсоли()
    англРезультаты[англРезультаты.length] = ЛОЖЬ
    русРезультаты[русРезультаты.length] = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
    неуспешноРус = неуспешноРус + 1
    Возврат "❌ Тест провален (ошибка создания)"
КонецПопытки;

    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = меню.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = меню.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: title() / setTitle() / Заголовок() / УстановитьЗаголовок() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Заголовок меню")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        меню.setTitle("Новый заголовок")
        заголовок = меню.title()
        ВывестиСтрокуВКонсоль("    [ENG] setTitle(Новый заголовок) -> title() = " + заголовок)
        
        Если заголовок == "Новый заголовок" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setTitle()/title() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setTitle()/title() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            меню.УстановитьЗаголовок("Заголовок по-русски")
            заголовокРус = меню.Заголовок()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьЗаголовок(Заголовок по-русски) -> Заголовок() = " + заголовокРус)
            
            Если заголовокРус == "Заголовок по-русски" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьЗаголовок()/Заголовок() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьЗаголовок()/Заголовок() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: setEnabled() / isEnabled() / УстановитьДоступен() / Доступен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Доступность меню")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        меню.setEnabled(false)
        доступен1 = меню.isEnabled()
        меню.setEnabled(true)
        доступен2 = меню.isEnabled()
        ВывестиСтрокуВКонсоль("    [ENG] setEnabled(false) -> isEnabled()=" + доступен1 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("    [ENG] setEnabled(true) -> isEnabled()=" + доступен2 + " (ожидается true)")
        
        Если доступен1 == false И доступен2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setEnabled()/isEnabled() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setEnabled()/isEnabled() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            меню.УстановитьДоступен(false)
            доступен1Рус = меню.Доступен()
            меню.УстановитьДоступен(true)
            доступен2Рус = меню.Доступен()
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступен(false) -> Доступен()=" + доступен1Рус)
            ВывестиСтрокуВКонсоль("    [RUS] УстановитьДоступен(true) -> Доступен()=" + доступен2Рус)
            
            Если доступен1Рус == false И доступен2Рус == true Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьДоступен()/Доступен() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьДоступен()/Доступен() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: setVisible() / isVisible() / УстановитьВидим() / Видим() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Видимость меню")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        меню.setVisible(false)
        видим1 = меню.isVisible()
        меню.setVisible(true)
        видим2 = меню.isVisible()
