    содержит2 = прямоуг9.contains(200, 200)
    пересекает = прямоуг9.intersects(прямоуг9Другой)
    пересекает2 = прямоуг9.intersects(прямоуг9Другой2)
    ВывестиСтрокуВКонсоль("    [ENG] contains(50,40)=" + содержит1 + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    [ENG] contains(200,200)=" + содержит2 + " (ожидается false)")
    ВывестиСтрокуВКонсоль("    [ENG] intersects(30,40,50,30)=" + пересекает + " (ожидается true)")
    ВывестиСтрокуВКонсоль("    [ENG] intersects(200,200,50,30)=" + пересекает2 + " (ожидается false)")
    
    Если содержит1 == true И содержит2 == false И пересекает == true И пересекает2 == false Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] contains()/intersects() работают корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] contains()/intersects() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        прямоуг9Рус = Новый QtПрямоугольник()
        прямоуг9Рус.УстановитьПрямоугольник(10, 20, 100, 50)
        прямоуг9ДругойРус = Новый QtПрямоугольник()
        прямоуг9ДругойРус.УстановитьПрямоугольник(30, 40, 50, 30)
        прямоуг9Другой2Рус = Новый QtПрямоугольник()
        прямоуг9Другой2Рус.УстановитьПрямоугольник(200, 200, 50, 30)
        
        содержит1Рус = прямоуг9Рус.Содержит(50, 40)
        содержит2Рус = прямоуг9Рус.Содержит(200, 200)
        пересекаетРус = прямоуг9Рус.Пересекается(прямоуг9ДругойРус)
        пересекает2Рус = прямоуг9Рус.Пересекается(прямоуг9Другой2Рус)
        ВывестиСтрокуВКонсоль("    [RUS] Содержит(50,40)=" + содержит1Рус)
        ВывестиСтрокуВКонсоль("    [RUS] Содержит(200,200)=" + содержит2Рус)
        ВывестиСтрокуВКонсоль("    [RUS] Пересекается(30,40,50,30)=" + пересекаетРус)
        ВывестиСтрокуВКонсоль("    [RUS] Пересекается(200,200,50,30)=" + пересекает2Рус)
        
        Если содержит1Рус == true И содержит2Рус == false И пересекаетРус == true И пересекает2Рус == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Содержит()/Пересекается() работают корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Содержит()/Пересекается() ошибка")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 10. ТЕСТ: intersected() / united() / toString() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 10: Пересечение, объединение и преобразования")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

прямоуг10 = Новый QtПрямоугольник()
прямоуг10.setRect(10, 20, 100, 50)
прямоуг10Другой = Новый QtПрямоугольник()
прямоуг10Другой.setRect(30, 40, 50, 30)

// Английский метод
Попытка
    пересечение = прямоуг10.intersected(прямоуг10Другой)
    объединение = прямоуг10.united(прямоуг10Другой)
    реальный = прямоуг10.getRealRect()
    строка = прямоуг10.toString()
    
    Если пересечение != null Тогда
        стрПерес = пересечение.toString()
    Иначе
        стрПерес = "null"
    КонецЕсли;
    Если объединение != null Тогда
        стрОбъед = объединение.toString()
    Иначе
        стрОбъед = "null"
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("    [ENG] intersected() = " + стрПерес)
    ВывестиСтрокуВКонсоль("    [ENG] united() = " + стрОбъед)
    ВывестиСтрокуВКонсоль("    [ENG] getRealRect() = " + (реальный != null ? "valid" : "null"))
    ВывестиСтрокуВКонсоль("    [ENG] toString() = " + строка)
    
    Если реальный != null И строка == "10,20 100x50" Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] intersected()/united()/getRealRect()/toString() работают корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] intersected()/united()/getRealRect()/toString() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        прямоуг10Рус = Новый QtПрямоугольник()
        прямоуг10Рус.УстановитьПрямоугольник(10, 20, 100, 50)
        прямоуг10ДругойРус = Новый QtПрямоугольник()
        прямоуг10ДругойРус.УстановитьПрямоугольник(30, 40, 50, 30)
        
        пересечениеРус = прямоуг10Рус.Пересечение(прямоуг10ДругойРус)
        объединениеРус = прямоуг10Рус.Объединение(прямоуг10ДругойРус)
        реальныйРус = прямоуг10Рус.ПолучитьПрямоугольник()
        строкаРус = прямоуг10Рус.ВСтроку()
        
        // Используем английские методы для объектов, созданных через Пересечение/Объединение
        Если пересечениеРус != null Тогда
            стрПересРус = пересечениеРус.toString()
        Иначе
            стрПересРус = "null"
        КонецЕсли;
        Если объединениеРус != null Тогда
            стрОбъедРус = объединениеРус.toString()
        Иначе
            стрОбъедРус = "null"
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("    [RUS] Пересечение() = " + стрПересРус)
        ВывестиСтрокуВКонсоль("    [RUS] Объединение() = " + стрОбъедРус)
        ВывестиСтрокуВКонсоль("    [RUS] ПолучитьПрямоугольник() = " + (реальныйРус != null ? "valid" : "null"))
        ВывестиСтрокуВКонсоль("    [RUS] ВСтроку() = " + строкаРус)
        
        Если реальныйРус != null И строкаРус == "10,20 100x50" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Пересечение()/Объединение()/ПолучитьПрямоугольник()/ВСтроку() работают корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Пересечение()/Объединение()/ПолучитьПрямоугольник()/ВСтроку() ошибка")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    сопоставления = [
        ["1", "Создание объекта", "Создание объекта"],
        ["2", "Создание с параметрами", "Создание с параметрами"],
        ["3", "x()/y()/width()/height()", "X()/Y()/Ширина()/Высота()"],
        ["4", "setX()/setY()/setWidth()/setHeight()", "УстановитьX()/УстановитьY()/УстановитьШирину()/УстановитьВысоту()"],
        ["5", "setRect()", "УстановитьПрямоугольник()"],
        ["6", "left()/right()/top()/bottom()", "Левый()/Правый()/Верхний()/Нижний()"],
        ["7", "isValid()/isNull()/isEmpty()", "Действителен()/Нулевой()/Пустой()"],
        ["8", "translate()/translated()", "Переместить()/Перемещённый()"],
        ["9", "contains()/intersects()", "Содержит()/Пересекается()"],
        ["10", "intersected()/united()/toString()", "Пересечение()/Объединение()/ВСтроку()"]
    ]
    
    Для i = 0 По сопоставления.length - 1 Цикл
        строка = сопоставления[i]
        номер = строка[0]
        англМетод = строка[1]
        русМетод = строка[2]
        
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли;
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли;
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли;
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + номер + "    │ " + англМетод + " " + англСтатус + "        │ " + русМетод + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtПрямоугольник завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                   ТЕСТИРОВАНИЕ QtПрямоугольник (QtRect)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtRect()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtПрямоугольник (русские и английские методы)                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtRect()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtПрямоугольник: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

