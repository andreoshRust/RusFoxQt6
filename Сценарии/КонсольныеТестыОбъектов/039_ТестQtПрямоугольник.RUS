// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtПрямоугольник
// ============================================================

Функция ДиагностикаМетодовQtRect()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtПрямоугольник ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtПрямоугольник: " + (typeof QtПрямоугольник !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtПрямоугольник: " + e)
    КонецПопытки;
    
    Попытка
        диагRect = Новый QtПрямоугольник()
        Если диагRect == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtПрямоугольник не создан")
            Возврат
        КонецЕсли;
        
        диагRect.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtПрямоугольник создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealRect",
            "x", "y", "width", "height",
            "setX", "setY", "setWidth", "setHeight", "setRect",
            "left", "right", "top", "bottom",
            "topLeft", "topRight", "bottomLeft", "bottomRight",
            "center", "size",
            "isNull", "isEmpty",
            "translate", "translated",
            "adjust", "adjusted",
            "contains", "intersects", "intersected", "united",
            "normalize", "normalized",
            "toString", "fromQRect",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагRect[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьПрямоугольник",
            "X", "Y", "Ширина", "Высота",
            "УстановитьX", "УстановитьY", "УстановитьШирину", "УстановитьВысоту", "УстановитьПрямоугольник",
            "Левый", "Правый", "Верхний", "Нижний",
            "ВерхнийЛевый", "ВерхнийПравый", "НижнийЛевый", "НижнийПравый",
            "Центр", "Размер",
            "Нулевой", "Пустой",
            "Переместить", "Перемещённый",
            "Изменить", "Изменённый",
            "Содержит", "Пересекается", "Пересечение", "Объединение",
            "Нормализовать", "Нормализованный",
            "ВСтроку", "ИзQRect",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагRect[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагRect.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагRect.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtПрямоугольник: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtПрямоугольник
// ============================================================

Функция ТестQtRect()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    прямоуг = null
    Попытка
        прямоуг = Новый QtПрямоугольник()
        прямоуг.РежимОтладки(ИСТИНА)
        Если прямоуг != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtПрямоугольник создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
// ===== 2. ТЕСТ: СОЗДАНИЕ С ПАРАМЕТРАМИ =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 2: Создание с параметрами (через setRect)")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

// Английский метод
Попытка
    прямоуг2 = Новый QtПрямоугольник()
    прямоуг2.setRect(10, 20, 100, 50)
    x = прямоуг2.getX()
    y = прямоуг2.getY()
    ширина = прямоуг2.getWidth()
    высота = прямоуг2.getHeight()
    ВывестиСтрокуВКонсоль("    [ENG] setRect(10,20,100,50) -> getX=" + x + ", getY=" + y + ", getWidth=" + ширина + ", getHeight=" + высота)
    
    Если x == 10 И y == 20 И ширина == 100 И высота == 50 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Создание через setRect() работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Создание через setRect() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        прямоуг2Рус = Новый QtПрямоугольник()
        прямоуг2Рус.УстановитьПрямоугольник(20, 30, 200, 100)
        xРус = прямоуг2Рус.ПолучитьX()
        yРус = прямоуг2Рус.ПолучитьY()
        ширинаРус = прямоуг2Рус.ПолучитьШирину()
        высотаРус = прямоуг2Рус.ПолучитьВысоту()
        ВывестиСтрокуВКонсоль("    [RUS] УстановитьПрямоугольник(20,30,200,100) -> ПолучитьX=" + xРус + ", ПолучитьY=" + yРус + ", ПолучитьШирину=" + ширинаРус + ", ПолучитьВысоту=" + высотаРус)
        
        Если xРус == 20 И yРус == 30 И ширинаРус == 200 И высотаРус == 100 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Создание через УстановитьПрямоугольник() работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Создание через УстановитьПрямоугольник() ошибка")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 3. ТЕСТ: Получение координат и размеров =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 3: Получение координат и размеров")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

прямоуг3 = Новый QtПрямоугольник()
прямоуг3.setRect(10, 20, 100, 50)

// Английский метод
Попытка
    x = прямоуг3.getX()
    y = прямоуг3.getY()
    ширина = прямоуг3.getWidth()
    высота = прямоуг3.getHeight()
    ВывестиСтрокуВКонсоль("    [ENG] getX=" + x + ", getY=" + y + ", getWidth=" + ширина + ", getHeight=" + высота)
    
    Если x == 10 И y == 20 И ширина == 100 И высота == 50 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] getX()/getY()/getWidth()/getHeight() работают корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] getX()/getY()/getWidth()/getHeight() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        прямоуг3Рус = Новый QtПрямоугольник()
        прямоуг3Рус.УстановитьПрямоугольник(10, 20, 100, 50)
        xРус = прямоуг3Рус.ПолучитьX()
        yРус = прямоуг3Рус.ПолучитьY()
        ширинаРус = прямоуг3Рус.ПолучитьШирину()
        высотаРус = прямоуг3Рус.ПолучитьВысоту()
        ВывестиСтрокуВКонсоль("    [RUS] ПолучитьX=" + xРус + ", ПолучитьY=" + yРус + ", ПолучитьШирину=" + ширинаРус + ", ПолучитьВысоту=" + высотаРус)
        
        Если xРус == 10 И yРус == 20 И ширинаРус == 100 И высотаРус == 50 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] ПолучитьX()/ПолучитьY()/ПолучитьШирину()/ПолучитьВысоту() работают корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] ПолучитьX()/ПолучитьY()/ПолучитьШирину()/ПолучитьВысоту() ошибка")
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестРусский = ЛОЖЬ
        неуспешноРус = неуспешноРус + 1
    КонецПопытки;
Иначе
    ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
КонецЕсли;

англРезультаты[англРезультаты.length] = англУспех
русРезультаты[русРезультаты.length] = русУспех
    
// ===== 4. ТЕСТ: setX() / setY() / setWidth() / setHeight() =====
всегоТестов = всегоТестов + 1
УстановитьЦветКонсоли("yellow")
ВывестиСтрокуВКонсоль("  Тест 4: Установка координат и размеров")
СброситьЦветКонсоли()

тестПройден = ИСТИНА
тестРусский = ИСТИНА
англУспех = ЛОЖЬ
русУспех = ЛОЖЬ

прямоуг4 = Новый QtПрямоугольник()
прямоуг4.setRect(0, 0, 0, 0)

// Английский метод
Попытка
    прямоуг4.setX(10)
    прямоуг4.setY(20)
    прямоуг4.setWidth(100)
    прямоуг4.setHeight(50)
    x = прямоуг4.getX()
    y = прямоуг4.getY()
    ширина = прямоуг4.getWidth()
    высота = прямоуг4.getHeight()
    ВывестиСтрокуВКонсоль("    [ENG] setX(10), setY(20), setWidth(100), setHeight(50) -> getX=" + x + ", getY=" + y + ", getWidth=" + ширина + ", getHeight=" + высота)
    
    Если x == 10 И y == 20 И ширина == 100 И высота == 50 Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] setX()/setY()/setWidth()/setHeight() работают корректно")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Иначе
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] setX()/setY()/setWidth()/setHeight() ошибка")
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецЕсли;
Исключение
    УстановитьЦветКонсоли("red")
    ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
    СброситьЦветКонсоли()
    тестПройден = ЛОЖЬ
    неуспешноАнгл = неуспешноАнгл + 1
КонецПопытки;

// Русский метод
Если тестПройден Тогда
    Попытка
        прямоуг4Рус = Новый QtПрямоугольник()
        прямоуг4Рус.УстановитьПрямоугольник(0, 0, 0, 0)
        прямоуг4Рус.УстановитьX(20)
        прямоуг4Рус.УстановитьY(30)
        прямоуг4Рус.УстановитьШирину(200)
        прямоуг4Рус.УстановитьВысоту(100)
        xРус = прямоуг4Рус.ПолучитьX()
        yРус = прямоуг4Рус.ПолучитьY()
        ширинаРус = прямоуг4Рус.ПолучитьШирину()
        высотаРус = прямоуг4Рус.ПолучитьВысоту()
        ВывестиСтрокуВКонсоль("    [RUS] УстановитьX(20), УстановитьY(30), УстановитьШирину(200), УстановитьВысоту(100) -> ПолучитьX=" + xРус + ", ПолучитьY=" + yРус + ", ПолучитьШирину=" + ширинаРус + ", ПолучитьВысоту=" + высотаРус)
        
        Если xРус == 20 И yРус == 30 И ширинаРус == 200 И высотаРус == 100 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьX()/УстановитьY()/УстановитьШирину()/УстановитьВысоту() работают корректно")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
