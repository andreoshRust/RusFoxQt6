//Итоги тестирования QtTcpSocket (QtTcpСокет):
//✅ Все тесты пройдены успешно (10 из 10)
//Что было протестировано:
//✅ Создание объекта QtTcpSocket
//✅ Проверка состояния (ПолучитьСостояние, СостояниеСтрокой, Подключен, Валидный)
//✅ Проверка адресов (ЛокальныйАдрес, ЛокальныйПорт)
//✅ Проверка записи без подключения (возвращает -1)
//✅ Проверка чтения без подключения (возвращает пустую строку)
//✅ Проверка дескриптора (возвращает -1 для не открытого сокета)
//✅ Проверка констант состояний
//✅ Получение реального объекта (ПолучитьTcpСокет)
//✅ Проверка RusFunc (91 метод в JSON)
//✅ Проверка ожиданий (все возвращают false для не подключенного сокета)
//Диагностика показала:
//29 английских методов доступны
//29 русских методов доступны
//Метод RusFunc() работает корректно (JSON длиной 7581, 91 элемент)
//Класс QtTcpSocket (наследник QtAbstractSocket) предоставляет:
//Управление подключением - ПодключитьсяКХосту, ОтключитьсяОтХоста, Прервать
//Состояние - ПолучитьСостояние, СостояниеСтрокой, Подключен, Валидный
//Запись данных - ЗаписатьДанные, ЗаписатьСтроку, СброситьБуфер
//Чтение данных - ПрочитатьВсе, Прочитать, ПрочитатьСтроку, МожноЧитатьСтроку
//Информация о сокете - АдресПиера, ПортПиера, ЛокальныйАдрес, ЛокальныйПорт, Дескриптор
//Ожидание событий - ОжидатьПодключения, ОжидатьОтключения, ОжидатьЧтения, ОжидатьЗаписи
//Настройки - УстановитьДескриптор, УстановитьОпциюСокета, УстановитьРазмерБуфераЧтения
//Сигналы - connected, disconnected, readyRead, bytesWritten, stateChanged, errorOccurred
//Константы - состояния, типы сокетов, опции
//Вывод:
//Класс QtTcpSocket полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с TCP сокетами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtAbstractSocket, который в свою очередь наследуется от QtIODevice и QtObject, что обеспечивает 
//полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtTcpSocket
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtTcpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtTcpСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtTcpSocket: " + (typeof QtTcpSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtTcpСокет: " + (typeof QtTcpСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtTcpСокет: " + e)
    КонецПопытки;
    
    Попытка
        диагСокет = Новый QtTcpSocket()
        Если диагСокет == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtTcpСокет не создан")
            Возврат
        КонецЕсли;
        
        диагСокет.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtTcpСокет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "connectToHost", "connectToHostReadWrite", "disconnectFromHost", "abort",
            "isConnected", "getState", "getStateString",
            "writeData", "writeLine", "flush",
            "readAllValue", "readValue", "readLineValue",
            "canReadLineValue", "bytesAvailableData", "bytesToWriteData", "atEndData",
            "setSocketDescriptorValue", "getSocketDescriptorValue",
            "getPeerAddress", "getPeerPort", "getLocalAddress", "getLocalPort",
            "waitForConnected", "waitForDisconnected", "waitForReadyRead", "waitForBytesWritten",
            "getRealTcpSocket", "isValid"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ПодключитьсяКХосту", "ПодключитьсяСРежимом", "ОтключитьсяОтХоста", "Прервать",
            "Подключен", "ПолучитьСостояние", "СостояниеСтрокой",
            "ЗаписатьДанные", "ЗаписатьСтроку", "СброситьБуфер",
            "ПрочитатьВсе", "Прочитать", "ПрочитатьСтроку",
            "МожноЧитатьСтроку", "ДоступноБайт", "БайтНаОтправку", "ВКонце",
            "УстановитьДескриптор", "ПолучитьДескриптор",
            "АдресПиера", "ПортПиера", "ЛокальныйАдрес", "ЛокальныйПорт",
            "ОжидатьПодключения", "ОжидатьОтключения", "ОжидатьЧтения", "ОжидатьЗаписи",
            "ПолучитьTcpСокет", "Валидный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСокет.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСокет.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtTcpСокет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtTcpSocket
// ============================================================

Функция ДиагностикаМетаОбъектаTcpSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtTcpСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtTcpSocket: " + (typeof QtTcpSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtTcpСокет: " + (typeof QtTcpСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        сокет = Новый QtTcpSocket()
        Если сокет == null Тогда
            сокет = new QtTcpSocket()
            Если сокет == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtTcpSocket()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtTcpСокет:")
    методы = Object.getOwnPropertyNames(сокет)
    прототип = Object.getPrototypeOf(сокет)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof сокет[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtTcpSocket (QtTcpСокет)
// ============================================================

Функция ТестQtTcpSocketFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    сокет = null
    Попытка
        сокет = Новый QtTcpSocket()
        Если сокет != null Тогда
            сокет.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtTcpСокет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtTcpСокет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если сокет == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = сокет.ПолучитьСостояние()
        состояниеСтр = сокет.СостояниеСтрокой()
        подключен = сокет.Подключен()
        валидный = сокет.Валидный()
        
        ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ")")
        ВывестиСтрокуВКонсоль("    Подключен: " + подключен)
        ВывестиСтрокуВКонсоль("    Валидный: " + валидный)
        
        Если состояние == сокет.UnconnectedState() И подключен == false И валидный == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА АДРЕСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка адресов")
    СброситьЦветКонсоли()
    
    Попытка
        локАдрес = сокет.ЛокальныйАдрес()
        локПорт = сокет.ЛокальныйПорт()
        
        ВывестиСтрокуВКонсоль("    Локальный адрес: " + локАдрес)
        ВывестиСтрокуВКонсоль("    Локальный порт: " + локПорт)
        
        // Адреса могут быть пустыми для не подключенного сокета
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверка адресов работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ЗАПИСИ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка записи (без подключения)")
    СброситьЦветКонсоли()
    
    Попытка
        результат = сокет.ЗаписатьДанные("test")
        ВывестиСтрокуВКонсоль("    ЗаписатьДанные('test') = " + результат + " (ожидается -1)")
        
        Если результат == -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись правильно возвращает ошибку")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись должна вернуть -1")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПРОВЕРКА ЧТЕНИЯ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка чтения (без подключения)")
    СброситьЦветКонсоли()
    
    Попытка
        данные = сокет.ПрочитатьВсе()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсе() = " + данные + " (ожидается пустая строка)")
        
        Если данные == "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение правильно возвращает пустую строку")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение должно вернуть пустую строку")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПРОВЕРКА ДЕСКРИПТОРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка дескриптора")
    СброситьЦветКонсоли()
    
    Попытка
        дескриптор = сокет.ПолучитьДескриптор()
        ВывестиСтрокуВКонсоль("    ПолучитьДескриптор() = " + дескриптор)
        
        // Дескриптор может быть -1 для не открытого сокета
        Если дескриптор == -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор возвращает -1 для не открытого сокета")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Дескриптор получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА КОНСТАНТ СОСТОЯНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка констант состояний")
    СброситьЦветКонсоли()
    
    Попытка
        неПодключен = сокет.UnconnectedState()
        поискХоста = сокет.HostLookupState()
        подключение = сокет.ConnectingState()
        подключен = сокет.ConnectedState()
        связан = сокет.BoundState()
        закрытие = сокет.ClosingState()
        
        ВывестиСтрокуВКонсоль("    UnconnectedState: " + неПодключен)
        ВывестиСтрокуВКонсоль("    HostLookupState: " + поискХоста)
        ВывестиСтрокуВКонсоль("    ConnectingState: " + подключение)
        ВывестиСтрокуВКонсоль("    ConnectedState: " + подключен)
        ВывестиСтрокуВКонсоль("    BoundState: " + связан)
        ВывестиСтрокуВКонсоль("    ClosingState: " + закрытие)
        
        Если неПодключен >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы состояний работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы состояний не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА ПОЛУЧЕНИЯ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = сокет.ПолучитьTcpСокет()
        ВывестиСтрокуВКонсоль("    ПолучитьTcpСокет(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА ОЖИДАНИЙ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка ожиданий")
    СброситьЦветКонсоли()
    
    Попытка
        // Проверяем, что методы ожидания не вызывают ошибок
        результат1 = сокет.ОжидатьПодключения(100)
        результат2 = сокет.ОжидатьОтключения(100)
        результат3 = сокет.ОжидатьЧтения(100)
        результат4 = сокет.ОжидатьЗаписи(100)
        
        ВывестиСтрокуВКонсоль("    ОжидатьПодключения(100): " + результат1)
        ВывестиСтрокуВКонсоль("    ОжидатьОтключения(100): " + результат2)
        ВывестиСтрокуВКонсоль("    ОжидатьЧтения(100): " + результат3)
        ВывестиСтрокуВКонсоль("    ОжидатьЗаписи(100): " + результат4)
        
        // Все методы должны вернуть false для не подключенного сокета
        Если результат1 == false И результат2 == false И результат3 == false И результат4 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Ожидания работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ожидания работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtTcpСокет завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtTcpSocket (QtTcpСокет)                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtTcpSocket()
    ДиагностикаМетаОбъектаTcpSocket()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtTcpСокет (русские и английские методы)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtTcpSocketFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtTcpСокет: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

