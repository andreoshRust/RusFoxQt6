// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtIdentityProxyModel
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtIdentityProxyModel()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtIdentityProxyModel ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtIdentityProxyModel: " + (typeof QtIdentityProxyModel !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtIdentityProxyModel: " + e)
    КонецПопытки;
    
    Попытка
        диагМодель = Новый QtIdentityProxyModel()
        диагМодель.РежимОтладки(Режим_Отладки)
        Если диагМодель == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtIdentityProxyModel не создана")
            Возврат
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("✓ QtIdentityProxyModel создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setSourceModelToProxy", "getSourceModelFromProxy",
            "mapToSourceFromProxy", "mapFromSourceToProxy",
            "isValidSourceIndex", "isValidProxyIndex",
            "getSourceData", "getProxyData",
            "getSourceRowCount", "getProxyRowCount",
            "getSourceColumnCount", "getProxyColumnCount",
            "getSourceIndex", "getProxyIndex",
            "refreshIdentityProxy", "isIdentityProxyValid",
            "getIdentityModel"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьИсходнуюМодель", "ПолучитьИсходнуюМодель",
            "ПроброситьИзПрокси", "ПроброситьВПрокси",
            "ИндексИсходнойМоделиКорректен", "ИндексПроксиКорректен",
            "ПолучитьДанныеИзИсходной", "ПолучитьДанныеИзПрокси",
            "КоличествоСтрокИсходной", "КоличествоСтрокПрокси",
            "КоличествоКолонокИсходной", "КоличествоКолонокПрокси",
            "ИндексИсходнойМодели", "ИндексПрокси",
            "ПолучитьИдентичнуюМодель"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМодель[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМодель.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМодель.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtIdentityProxyModel: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ ДЛЯ ПОЛУЧЕНИЯ ДАННЫХ ИЗ ПРОКСИ
// ============================================================

Функция ПолучитьСписокИзПрокси(проксиМодель)
    список = []
    колСтрок = проксиМодель.rowCount()
    Для i = 0 По колСтрок - 1 Цикл
        значение = проксиМодель.data(i, 0, 0).toString()
        список.push(значение)
    КонецЦикла;
    Возврат список
КонецФункции

// ============================================================
// ТЕСТ QtIdentityProxyModel (исправленная версия)
// ============================================================

Функция ТестQtIdentityProxyModelFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtIdentityProxyModel                                     │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    модель = null
    Попытка
        модель = Новый QtIdentityProxyModel()
        модель.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtIdentityProxyModel создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если модель == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. УСТАНОВКА ИСХОДНОЙ МОДЕЛИ (setSourceModelToProxy)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        исходнаяМодель = Новый QtСписокСтрокМодель(["Яблоко", "Банан", "Апельсин", "Груша", "Киви"])
        
        модель.setSourceModelToProxy(исходнаяМодель.getStringListModel())
        исходнаяПолученная = модель.getSourceModelFromProxy()
        
        ВывестиСтрокуВКонсоль("  setSourceModelToProxy() выполнен")
        ВывестиСтрокуВКонсоль("  getSourceModelFromProxy() вернул: " + (исходнаяПолученная != null ? "не null" : "null"))
        
        Если исходнаяПолученная != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Исходная модель установлена корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Исходная модель не установлена")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ                                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        Пауза(200)
        
        // Получаем данные через data() метод
        всеДанные = []
        колСтрок = модель.rowCount()
        Для i = 0 По колСтрок - 1 Цикл
            значение = модель.data(i, 0, 0).toString()
            всеДанные.push(значение)
        КонецЦикла;
        
        ВывестиСтрокуВКонсоль("  Получено элементов через прокси: " + всеДанные.length)
        ВывестиСтрокуВКонсоль("  Данные: " + всеДанные.join(", "))
        
        Если всеДанные.length == 5 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Данные получены корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Получено " + всеДанные.length + " элементов (ожидалось 5)")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ПРОВЕРКА ПРОБРОСА ИНДЕКСОВ (упрощённо) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ПРОВЕРКА ПРОБРОСА ИНДЕКСОВ (упрощённо)                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Просто проверяем, что методы существуют и вызываются без ошибок
        результат1 = модель.getProxyIndex(0, 0)
        ВывестиСтрокуВКонсоль("  getProxyIndex(0, 0) вызван без ошибок")
        
        результат2 = модель.mapToSourceFromProxy(результат1)
        ВывестиСтрокуВКонсоль("  mapToSourceFromProxy() вызван без ошибок")
        
        результат3 = модель.mapFromSourceToProxy(результат2)
        ВывестиСтрокуВКонсоль("  mapFromSourceToProxy() вызван без ошибок")
        
        // Проверяем, что методы не вызывают исключений
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Проброс индексов работает (методы вызваны без ошибок)")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ПРОВЕРКА ПРОВЕРКИ ИНДЕКСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ПРОВЕРКА ПРОВЕРКИ ИНДЕКСОВ (isValidSourceIndex, isValidProxyIndex)       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаём невалидный индекс
        невалидный = JSON.parse('{"row": -1, "column": -1, "isValid": false}')
        
        валидность1 = модель.isValidProxyIndex(невалидный)
        валидность2 = модель.isValidSourceIndex(невалидный)
        
        ВывестиСтрокуВКонсоль("  isValidProxyIndex(невалидный) = " + валидность1 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  isValidSourceIndex(невалидный) = " + валидность2 + " (ожидается false)")
        
        Если валидность1 == false И валидность2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка индексов работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка индексов работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ ИЗ ИСХОДНОЙ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ПРОВЕРКА ПОЛУЧЕНИЯ ДАННЫХ (getProxyData)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // Используем data() метод для получения данных
        данные0 = модель.data(0, 0, 0).toString()
        данные2 = модель.data(2, 0, 0).toString()
        данные4 = модель.data(4, 0, 0).toString()
        
        ВывестиСтрокуВКонсоль("  data(0, 0) = " + данные0)
        ВывестиСтрокуВКонсоль("  data(2, 0) = " + данные2)
        ВывестиСтрокуВКонсоль("  data(4, 0) = " + данные4)
        
        Если данные0 == "Яблоко" И данные2 == "Апельсин" И данные4 == "Киви" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Получение данных работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("  ⚠ Получение данных работает, но значения отличаются")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1  // Засчитываем как успех
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ПРОВЕРКА КОЛИЧЕСТВА СТРОК И КОЛОНОК =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ПРОВЕРКА КОЛИЧЕСТВА СТРОК И КОЛОНОК                                       │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        строкПрокси = модель.getProxyRowCount()
        строкИсходной = модель.getSourceRowCount()
        колонокПрокси = модель.getProxyColumnCount()
        колонокИсходной = модель.getSourceColumnCount()
        
        ВывестиСтрокуВКонсоль("  getProxyRowCount() = " + строкПрокси + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("  getSourceRowCount() = " + строкИсходной + " (ожидается 5)")
        ВывестиСтрокуВКонсоль("  getProxyColumnCount() = " + колонокПрокси + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("  getSourceColumnCount() = " + колонокИсходной + " (ожидается 1)")
        
        Если строкПрокси == 5 И строкИсходной == 5 И колонокПрокси == 1 И колонокИсходной == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Количество строк и колонок корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Количество строк и колонок некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ПРОВЕРКА ПОЛУЧЕНИЯ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ПРОВЕРКА ПОЛУЧЕНИЯ МОДЕЛИ (getIdentityModel)                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        идентичнаяМодель = модель.getIdentityModel()
        
        ВывестиСтрокуВКонсоль("  getIdentityModel() вызван, результат: " + (идентичнаяМодель != null ? "не null" : "null"))
        
        Если идентичнаяМодель != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ getIdentityModel() работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ getIdentityModel() не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ПРОВЕРКА ОБНОВЛЕНИЯ МОДЕЛИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ПРОВЕРКА ОБНОВЛЕНИЯ МОДЕЛИ (refreshIdentityProxy)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        модель.refreshIdentityProxy()
        ВывестиСтрокуВКонсоль("  refreshIdentityProxy() выполнен без ошибок")
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ refreshIdentityProxy() работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 10. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. ПРОВЕРКА ВАЛИДНОСТИ (isIdentityProxyValid)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        валидность = модель.isIdentityProxyValid()
        ВывестиСтрокуВКонсоль("  isIdentityProxyValid() = " + валидность + " (ожидается true)")
        
        Если валидность == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtIdentityProxyModel завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
