//Особенности QSaveFile:
//Безопасная запись - данные пишутся во временный файл
//Атомарное сохранение - при вызове commit() временный файл переименовывается в целевой
//Отмена записи - cancelWriting() удаляет временный файл
//Чтение не поддерживается - для чтения используется QFile

//✓ Все 19 русских методов доступно:
//  - УстановитьИмяФайла, ИмяФайла
//  - Открыть, Открыт
//  - Сохранить, Отменить
//  - Существует, Удалить, Ошибка
//  - ПрочитатьВсе
//  - Записать, ЗаписатьСтроку, СброситьБуфер
//  - Позиция, Перейти, Размер, СброситьПозицию
//  - Действителен, ПолучитьРеальныйSaveFile

//Итоговый результат тестирования QtSaveFile (QtФайлБезопасный):
//№    Тест    Статус
//1    Создание объекта    ✅
//2    Установка имени файла    ✅
//3    Открытие и закрытие    ✅
//4    Запись и сохранение    ✅
//5    Отмена записи    ✅
//6    Размер и позиция    ✅
//7    Ошибки    ✅
//8    Удаление    ✅
//9    Создание с именем файла    ✅
//10    Получение реального объекта    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtФайлБезопасный
// ============================================================

Функция ДиагностикаМетодовQtSaveFile()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtФайлБезопасный ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtФайлБезопасный: " + (typeof QtФайлБезопасный !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtФайлБезопасный: " + e)
    КонецПопытки;
    
    Попытка
        диагSaveFile = НовыйОбъект("QtФайлБезопасный")
        Если диагSaveFile == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtФайлБезопасный не создан")
            Возврат
        КонецЕсли;
        
        диагSaveFile.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtФайлБезопасный создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getDebug", "setDebug",
            "setFileName", "getFileName", "open", "isOpen",
            "commit", "cancelWriting", "exists", "remove",
            "errorString", "write", "writeLine", "flush",
            "readAll", "pos", "seek", "size", "reset",
            "getRealSaveFile"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагSaveFile[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьИмяФайла", "ИмяФайла",
            "Открыть", "Открыт",
            "Сохранить", "Отменить",
            "Существует", "Удалить",
            "Ошибка",
            "ПрочитатьВсе",
            "Записать", "ЗаписатьСтроку", "СброситьБуфер",
            "Позиция", "Перейти", "Размер", "СброситьПозицию",
            "Действителен", "ПолучитьРеальныйSaveFile"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагSaveFile[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагSaveFile.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагSaveFile.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtФайлБезопасный: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtФайлБезопасный
// ============================================================

Функция ТестQtSaveFile()
    всегоТестов = 0
    успешноТестов = 0
    тестПапка = "C:/Temp2"
    
    // Создаем папку для тестов
    Попытка
        Если typeof СоздатьКаталог !== 'undefined' Тогда
            СоздатьКаталог(тестПапка)
        КонецЕсли;
    Исключение
        // Игнорируем ошибку
    КонецПопытки;
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    saveFile = null
    
    Попытка
        saveFile = НовыйОбъект("QtФайлБезопасный")
        Если saveFile != null Тогда
            saveFile.РежимОтладки(ИСТИНА)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtФайлБезопасный создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtФайлБезопасный НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если saveFile == null Тогда
        Возврат "❌ Тест QtФайлБезопасный провален (объект не создан)"
    КонецЕсли

    // ===== 2. УСТАНОВКА ИМЕНИ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Установка имени файла")
    СброситьЦветКонсоли()
    
    тестФайл = тестПапка + "/save_test.txt"
    
    Попытка
        saveFile["УстановитьИмяФайла"](тестФайл)
        имя = saveFile["ИмяФайла"]()
        ВывестиСтрокуВКонсоль("    ИмяФайла(): " + имя)
        Если имя == тестФайл Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя файла установлено корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя файла не совпадает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ОТКРЫТИЕ И ЗАКРЫТИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Открытие и закрытие")
    СброситьЦветКонсоли()
    
    Попытка
        // Удаляем старый файл если есть
        Если saveFile["Существует"]() Тогда
            saveFile["Удалить"]()
        КонецЕсли
        
        // Убеждаемся что файл закрыт
        saveFile["Отменить"]()
        
        результат = saveFile["Открыть"]()
        открыт = saveFile["Открыт"]()
        ВывестиСтрокуВКонсоль("    Открыть(): " + результат + ", Открыт(): " + открыт)
        
        Если результат == true И открыт == true Тогда
            // Отменяем запись (закрываем без сохранения)
            saveFile["Отменить"]()
            открытПосле = saveFile["Открыт"]()
            ВывестиСтрокуВКонсоль("    После Отменить(): " + открытПосле)
            
            Если открытПосле == false Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Открытие и отмена работают")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Отмена не работает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Открытие не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 4. ЗАПИСЬ И СОХРАНЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Запись и сохранение")
    СброситьЦветКонсоли()
    
    Попытка
        // СОЗДАЕМ НОВЫЙ ОБЪЕКТ для этого теста
        saveFileTest4 = НовыйОбъект("QtФайлБезопасный")
        saveFileTest4["УстановитьИмяФайла"](тестФайл)
        
        // Удаляем старый файл если есть
        Если saveFileTest4["Существует"]() Тогда
            saveFileTest4["Удалить"]()
        КонецЕсли
        
        // Открываем для записи
        результат = saveFileTest4["Открыть"]()
        ВывестиСтрокуВКонсоль("    Открыть(): " + результат)
        
        Если результат == true Тогда
            saveFileTest4["Записать"]("Hello World")
            saveFileTest4["ЗаписатьСтроку"]("Line 2")
            saveFileTest4["Записать"]("Final")
            saveFileTest4["СброситьБуфер"]()
            
            результатСохр = saveFileTest4["Сохранить"]()
            ВывестиСтрокуВКонсоль("    Сохранить(): " + результатСохр)
            
            Если результатСохр == true Тогда
                существует = saveFileTest4["Существует"]()
                ВывестиСтрокуВКонсоль("    Существует(): " + существует)
                
                Если существует == true Тогда
                    // Проверяем содержимое
                    содержимое = saveFileTest4["ПрочитатьВсе"]()
                    ВывестиСтрокуВКонсоль("    Содержимое: " + содержимое)
                    
                    Если содержимое == "Hello WorldLine 2\nFinal" Тогда
                        УстановитьЦветКонсоли("green")
                        ВывестиСтрокуВКонсоль("    ✓ Запись и сохранение работают")
                        СброситьЦветКонсоли()
                        успешноТестов = успешноТестов + 1
                    Иначе
                        УстановитьЦветКонсоли("red")
                        ВывестиСтрокуВКонсоль("    ✗ Содержимое не совпадает")
                        СброситьЦветКонсоли()
                    КонецЕсли
                Иначе
                    УстановитьЦветКонсоли("red")
                    ВывестиСтрокуВКонсоль("    ✗ Файл не создан")
                    СброситьЦветКонсоли()
                КонецЕсли
            Иначе
                ошибка = saveFileTest4["Ошибка"]()
                ВывестиСтрокуВКонсоль("    Ошибка(): " + ошибка)
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Сохранение не удалось")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            ошибка = saveFileTest4["Ошибка"]()
            ВывестиСтрокуВКонсоль("    Ошибка(): " + ошибка)
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось открыть файл")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    

    // ===== 5. ОТМЕНА ЗАПИСИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Отмена записи")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile2 = НовыйОбъект("QtФайлБезопасный")
        saveFile2["УстановитьИмяФайла"](тестПапка + "/save_test2.txt")
        
        // Удаляем старый файл если есть
        Если saveFile2["Существует"]() Тогда
            saveFile2["Удалить"]()
        КонецЕсли
        
        // Убеждаемся что файл закрыт
        saveFile2["Отменить"]()
        
        saveFile2["Открыть"]()
        saveFile2["Записать"]("This should be cancelled")
        saveFile2["Отменить"]()
        
        // Пытаемся сохранить после отмены - должно быть false
        результат = saveFile2["Сохранить"]()
        ВывестиСтрокуВКонсоль("    Сохранить() после отмены: " + результат)
        
        существует = saveFile2["Существует"]()
        ВывестиСтрокуВКонсоль("    Существует(): " + существует)
        
        Если результат == false И существует == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отмена записи работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отмена записи не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. РАЗМЕР И ПОЗИЦИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Размер и позиция")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile3 = НовыйОбъект("QtФайлБезопасный")
        saveFile3["УстановитьИмяФайла"](тестПапка + "/size_test.txt")
        
        // Удаляем старый файл если есть
        Если saveFile3["Существует"]() Тогда
            saveFile3["Удалить"]()
        КонецЕсли
        
        // Убеждаемся что файл закрыт
        saveFile3["Отменить"]()
        
        saveFile3["Открыть"]()
        saveFile3["Записать"]("1234567890")
        
        позиция = saveFile3["Позиция"]()
        размер = saveFile3["Размер"]()
        ВывестиСтрокуВКонсоль("    Позиция(): " + позиция + ", Размер(): " + размер)
        
        saveFile3["Перейти"](5)
        позиция2 = saveFile3["Позиция"]()
        ВывестиСтрокуВКонсоль("    Перейти(5) -> Позиция(): " + позиция2)
        
        saveFile3["СброситьПозицию"]()
        позиция3 = saveFile3["Позиция"]()
        ВывестиСтрокуВКонсоль("    СброситьПозицию() -> Позиция(): " + позиция3)
        
        saveFile3["Отменить"]()
        
        Если позиция == 10 И размер == 10 И позиция2 == 5 И позиция3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Размер и позиция работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Размер или позиция не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ОШИБКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Ошибки")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile4 = НовыйОбъект("QtФайлБезопасный")
        // Не устанавливаем имя файла - должен быть пустой
        
        // Убеждаемся что закрыт
        saveFile4["Отменить"]()
        
        результат = saveFile4["Открыть"]()
        ошибка = saveFile4["Ошибка"]()
        ВывестиСтрокуВКонсоль("    Открыть() без имени: " + результат)
        ВывестиСтрокуВКонсоль("    Ошибка(): " + ошибка)
        
        // Должна быть ошибка
        Если ошибка != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Обработка ошибок работает (есть сообщение об ошибке)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Обработка ошибок не работает (нет сообщения об ошибке)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. УДАЛЕНИЕ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Удаление")
    СброситьЦветКонсоли()
    
    Попытка
        saveFile5 = НовыйОбъект("QtФайлБезопасный")
        saveFile5["УстановитьИмяФайла"](тестПапка + "/to_delete.txt")
        
        // Убеждаемся что закрыт
        saveFile5["Отменить"]()
        
        // Создаем файл
        saveFile5["Открыть"]()
        saveFile5["Записать"]("Delete me")
        saveFile5["Сохранить"]()
        
        существуетДо = saveFile5["Существует"]()
        ВывестиСтрокуВКонсоль("    Существует() до удаления: " + существуетДо)
        
        saveFile5["Удалить"]()
        существуетПосле = saveFile5["Существует"]()
        ВывестиСтрокуВКонсоль("    Существует() после удаления: " + существуетПосле)
        
        Если существуетДо == true И существуетПосле == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Удаление работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Удаление не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. СОЗДАНИЕ С ИМЕНЕМ ФАЙЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Создание с именем файла")
    СброситьЦветКонсоли()
    
    Попытка
        имяФайла = тестПапка + "/direct_file.txt"
        saveFile6 = НовыйОбъект("QtФайлБезопасный", имяФайла)
        
        Если saveFile6 != null Тогда
            имя = saveFile6["ИмяФайла"]()
            ВывестиСтрокуВКонсоль("    ИмяФайла(): " + имя)
            
            Если имя == имяФайла Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание с именем файла работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Имя файла не совпадает")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект не создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = saveFile["ПолучитьРеальныйSaveFile"]()
        ВывестиСтрокуВКонсоль("    ПолучитьРеальныйSaveFile(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QtФайлБезопасный: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QtФайлБезопасный: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QtФайлБезопасный завершён"
КонецФункции



