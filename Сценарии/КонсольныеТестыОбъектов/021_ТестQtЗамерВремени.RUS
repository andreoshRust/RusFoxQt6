
//№    Английский метод    Русский метод    Статус
//1    Создание объекта    Создание объекта    ✅
//2    isValid()    Действителен()    ✅
//3    elapsed()    ПрошлоМс()    ✅
//4    elapsedSeconds()    ПрошлоСекунд()    ✅
//5    hasExpired()    Истёк()    ✅
//6    remainingTime()    ОсталосьВремени()    ✅
//7    restart()    Перезапустить()    ✅
//8    invalidate()    Сбросить()    ✅
//9    start()    Запустить()    ✅
//10    copyTo()    КопироватьВ()    ✅

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtЗамерВремени
// ============================================================

Функция ДиагностикаМетодовQtElapsedTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЗамерВремени ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtЗамерВремени: " + (typeof QtЗамерВремени !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЗамерВремени: " + e)
    КонецПопытки;
    
    Попытка
        диагТаймер = Новый QtЗамерВремени()
        Если диагТаймер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЗамерВремени не создан")
            Возврат
        КонецЕсли;
        
        диагТаймер.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtЗамерВремени создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "start", "restart", "invalidate", 
            "elapsed", "elapsedMilliseconds", "elapsedSeconds",
            "hasExpired", "remainingTime",
            "startPerformanceTimer", "isPerformanceTimerValid",
            "copyTo", "setDebug", "getDebug", "getRealTimer"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "Запустить", "Перезапустить", "Сбросить",
            "ПрошлоМс", "ПрошлоМиллисекунд", "ПрошлоСекунд",
            "Истёк", "ОсталосьВремени",
            "ЗапуститьПроизводительность", "ПроизводительностьДействительна",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки", "ПолучитьТаймер"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаймер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаймер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЗамерВремени: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtЗамерВремени
// ============================================================

Функция ТестQtElapsedTimer()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    Попытка
        таймер = Новый QtЗамерВремени()
        таймер.РежимОтладки(ИСТИНА)
        Если таймер != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtЗамерВремени создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = таймер.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = таймер.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: elapsed() / ПрошлоМс() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Измерение времени в миллисекундах")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Создаём новый таймер для чистоты теста
    таймер3 = Новый QtЗамерВремени()
    
    // Английский метод
    Попытка
        старт = таймер3.elapsed()
        Пауза(100)
        финиш = таймер3.elapsed()
        разница = финиш - старт
        
        ВывестиСтрокуВКонсоль("    [ENG] elapsed(): старт=" + старт + "мс, финиш=" + финиш + "мс, разница=" + разница + "мс")
        
        Если разница >= 50 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] elapsed() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] elapsed() ошибка (разница=" + разница + "мс, ожидается >=50)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            стартРус = таймер3.ПрошлоМс()
            Пауза(100)
            финишРус = таймер3.ПрошлоМс()
            разницаРус = финишРус - стартРус
            
            ВывестиСтрокуВКонсоль("    [RUS] ПрошлоМс(): старт=" + стартРус + "мс, финиш=" + финишРус + "мс, разница=" + разницаРус + "мс")
            
            Если разницаРус >= 50 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ПрошлоМс() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПрошлоМс() ошибка (разница=" + разницаРус + "мс, ожидается >=50)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: elapsedSeconds() / ПрошлоСекунд() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Измерение времени в секундах")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Создаём новый таймер
    таймер4 = Новый QtЗамерВремени()
    
    // Английский метод
    Попытка
        секСтарт = таймер4.elapsedSeconds()
        Пауза(100)
        секФиниш = таймер4.elapsedSeconds()
        секРазница = секФиниш - секСтарт
        
        ВывестиСтрокуВКонсоль("    [ENG] elapsedSeconds(): старт=" + секСтарт + "с, финиш=" + секФиниш + "с, разница=" + секРазница + "с")
        
        Если секРазница >= 0.05 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] elapsedSeconds() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] elapsedSeconds() ошибка (разница=" + секРазница + "с)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            секСтартРус = таймер4.ПрошлоСекунд()
            Пауза(100)
            секФинишРус = таймер4.ПрошлоСекунд()
            секРазницаРус = секФинишРус - секСтартРус
            
            ВывестиСтрокуВКонсоль("    [RUS] ПрошлоСекунд(): старт=" + секСтартРус + "с, финиш=" + секФинишРус + "с, разница=" + секРазницаРус + "с")
            
            Если секРазницаРус >= 0.05 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ПрошлоСекунд() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПрошлоСекунд() ошибка (разница=" + секРазницаРус + "с)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: hasExpired() / Истёк() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка истечения времени")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Создаём новый таймер
    таймер5 = Новый QtЗамерВремени()
    
    // Английский метод
    Попытка
        Пауза(100)
        истек1 = таймер5.hasExpired(50)   // 100 > 50 -> true
        истек2 = таймер5.hasExpired(200)  // 100 < 200 -> false
        
        ВывестиСтрокуВКонсоль("    [ENG] hasExpired(50)=" + истек1 + " (ожидается true), hasExpired(200)=" + истек2 + " (ожидается false)")
        
        Если истек1 == ИСТИНА И истек2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] hasExpired() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
