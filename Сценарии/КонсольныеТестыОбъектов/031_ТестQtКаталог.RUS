//Итоги тестирования QtКаталог (QtDir):
//✅ Все тесты пройдены успешно (10 из 10)
//Что было протестировано:
//✅ Создание объекта QtКаталог
//✅ Базовые свойства (Путь, АбсолютныйПуть, ИмяКаталога, Существует)
//✅ Создание подкаталога (СоздатьПуть)
//✅ Работа с файлами (СуществуетФайл, УдалитьФайл)
//✅ Удаление каталога (УдалитьПуть)
//✅ Список файлов (СписокФайлов)
//✅ Статические методы (ТекущийКаталог, ДомашнийКаталог, ВременныйКаталог, КорневойКаталог)
//✅ Фильтры (Фильтр_Файлы, Фильтр_Каталоги)
//✅ Константы фильтров (Фильтр_Каталоги, Фильтр_Файлы, Фильтр_Все, Фильтр_Скрытые)
//✅ Проверка RusFunc (70 методов в JSON)
//Диагностика показала:
//53 английских метода доступны
//53 русских метода доступны
//Метод RusFunc() работает корректно (JSON длиной 5662, 70 элементов)
//Класс QtDir (QtКаталог) предоставляет:
//Навигация по файловой системе - Путь, АбсолютныйПуть, КаноническийПуть, ИмяКаталога
//Проверки - Существует, ДоступенДляЧтения, Корневой, Пустой, Абсолютный, Относительный
//Управление каталогами - СоздатьКаталог, СоздатьПуть, УдалитьКаталог, УдалитьРекурсивно
//Управление файлами - УдалитьФайл, СуществуетФайл
//Навигация - ПерейтиВ, ПерейтиВверх
//Списки и фильтры - СписокФайлов, УстановитьФильтр, УстановитьФильтрыИмен, УстановитьСортировку
//Пути к файлам - ПутьКФайлу, АбсолютныйПутьКФайлу, ОтносительныйПутьКФайлу
//Статические методы - ВременныйКаталог, ТекущийКаталог, ДомашнийКаталог, КорневойКаталог, СписокДисков
//Константы фильтров и сортировки - все основные константы QDir
//Вывод:
//Класс QtDir (наследник QtObject) полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с файловой 
//системой как на английском, так и на русском языке. Класс успешно наследуется от QtObject, что обеспечивает полную интеграцию с системой 
//отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtDir
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtDir()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtКаталог ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtКаталог: " + (typeof QtКаталог !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtDir: " + (typeof QtDir !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtКаталог: " + e)
    КонецПопытки;
    
    Попытка
        диагКаталог = Новый QtКаталог()
        Если диагКаталог == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtКаталог не создан")
            Возврат
        КонецЕсли;
        
        диагКаталог.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtКаталог создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setPath", "getPath", "getAbsolutePath", "getCanonicalPath", "getDirName",
            "getExists", "getIsReadable", "getIsRoot", "getIsEmpty",
            "existsFile", "isAbsolute", "isRelative",
            "mkdir", "mkpath", "rmdir", "removeRecursively", "removeFile",
            "cd", "cdUp",
            "entryList", "entryListWithFilters",
            "setNameFilters", "nameFilters",
            "setFilter", "getFilter",
            "setSorting", "getSorting",
            "filePath", "absoluteFilePath", "relativeFilePath",
            "tempPath", "currentPath", "rootPath", "homePath",
            "setCurrentPath", "drives",
            "existsStatic", "mkpathStatic", "rmpathStatic",
            "FilterDirs", "FilterFiles", "FilterDrives", "FilterAll",
            "FilterNoDotAndDotDot", "FilterHidden", "FilterSystem",
            "SortByName", "SortByTime", "SortBySize",
            "SortUnsorted", "SortDirsFirst", "SortReversed",
            "getDir"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКаталог[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Путь", "УстановитьПуть", "АбсолютныйПуть", "КаноническийПуть", "ИмяКаталога",
            "Существует", "СуществуетФайл", "ДоступенДляЧтения", "Корневой", "Пустой",
            "Абсолютный", "Относительный",
            "СоздатьКаталог", "СоздатьПуть", "УдалитьКаталог", "УдалитьРекурсивно", "УдалитьФайл",
            "ПерейтиВ", "ПерейтиВверх",
            "СписокФайлов", "СписокФайловСФильтрами",
            "УстановитьФильтрыИмен", "ФильтрыИмен",
            "УстановитьФильтр", "ПолучитьФильтр",
            "УстановитьСортировку", "ПолучитьСортировку",
            "ПутьКФайлу", "АбсолютныйПутьКФайлу", "ОтносительныйПутьКФайлу",
            "ВременныйКаталог", "ТекущийКаталог", "КорневойКаталог", "ДомашнийКаталог",
            "УстановитьТекущийКаталог", "СписокДисков",
            "КаталогСуществует", "СоздатьПутьСтатический", "УдалитьПуть",
            "Фильтр_Каталоги", "Фильтр_Файлы", "Фильтр_Диски", "Фильтр_Все",
            "Фильтр_БезТочек", "Фильтр_Скрытые", "Фильтр_Системные",
            "Сортировка_ПоИмени", "Сортировка_ПоВремени", "Сортировка_ПоРазмеру",
            "Сортировка_БезСортировки", "Сортировка_КаталогиСначала", "Сортировка_ОбратныйПорядок",
            "ПолучитьКаталог"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагКаталог[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагКаталог.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагКаталог.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtКаталог: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtDir
// ============================================================

Функция ДиагностикаМетаОбъектаDir()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtКаталог ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtКаталог: " + (typeof QtКаталог !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtDir: " + (typeof QtDir !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        каталог = Новый QtКаталог()
        Если каталог == null Тогда
            каталог = new QtDir()
            Если каталог == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtDir()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtКаталог:")
    методы = Object.getOwnPropertyNames(каталог)
    прототип = Object.getPrototypeOf(каталог)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof каталог[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof каталог.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = каталог.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ СОЗДАНИЯ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция СоздатьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        
        // Создаём каталог C:\Temp2 если его нет
        Если ! каталог.КаталогСуществует("C:/Temp2") Тогда
            каталог.СоздатьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Создан каталог C:/Temp2")
        Иначе
            ВывестиСтрокуВКонсоль("  Каталог C:/Temp2 уже существует")
        КонецЕсли;
        
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ФУНКЦИЯ ОЧИСТКИ ТЕСТОВОЙ СТРУКТУРЫ
// ============================================================

Функция ОчиститьТестовуюСтруктуру()
    Попытка
        каталог = Новый QtКаталог()
        
        // Удаляем тестовые файлы
        файл = Новый QtФайл()
        файл.УстановитьИмяФайла("C:/Temp2/test.txt")
        Если файл.ФайлСуществует() Тогда 
            файл.УдалитьФайл()
            ВывестиСтрокуВКонсоль("  Удалён test.txt")
        КонецЕсли;
        
        // Удаляем тестовые каталоги
        Если каталог.КаталогСуществует("C:/Temp2/TestSubDir") Тогда 
            каталог.УдалитьПуть("C:/Temp2/TestSubDir")
            ВывестиСтрокуВКонсоль("  Удалён TestSubDir")
        КонецЕсли;
        
        Если каталог.КаталогСуществует("C:/Temp2") Тогда 
            каталог.УдалитьПуть("C:/Temp2")
            ВывестиСтрокуВКонсоль("  Удалён каталог Temp2")
        КонецЕсли;
        
        ВывестиСтрокуВКонсоль("  Тестовая структура очищена")
        Возврат ИСТИНА
    Исключение
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке тестовой структуры: " + e)
        Возврат ЛОЖЬ
    КонецПопытки;
КонецФункции

// ============================================================
// ТЕСТ QtDir (QtКаталог) - улучшенная версия
// ============================================================

Функция ТестQtDirFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // Подготовка - создаём тестовую структуру
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Подготовка тестовой структуры в C:/Temp2...")
    СброситьЦветКонсоли()
    Если Не СоздатьТестовуюСтруктуру() Тогда
        Возврат "❌ Тест провален (не удалось создать тестовую структуру)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    каталог = null
    Попытка
        каталог = Новый QtКаталог()
        Если каталог != null Тогда
            каталог.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtКаталог создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtКаталог НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если каталог == null Тогда
        ОчиститьТестовуюСтруктуру()
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. БАЗОВЫЕ СВОЙСТВА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Базовые свойства")
    СброситьЦветКонсоли()
    
    Попытка
        путь = каталог.Путь()
        абсПуть = каталог.АбсолютныйПуть()
        имя = каталог.ИмяКаталога()
        существует = каталог.Существует()
        
        ВывестиСтрокуВКонсоль("    Путь(): " + путь)
        ВывестиСтрокуВКонсоль("    АбсолютныйПуть(): " + абсПуть)
        ВывестиСтрокуВКонсоль("    ИмяКаталога(): " + имя)
        ВывестиСтрокуВКонсоль("    Существует(): " + существует)
        
        Если существует == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Базовые свойства корректны")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Каталог не существует")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. СОЗДАНИЕ ПОДКАТАЛОГА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Создание подкаталога")
    СброситьЦветКонсоли()
    
    Попытка
        тестПуть = "C:/Temp2/TestSubDir"
        
        создан = каталог.СоздатьПуть(тестПуть)
        ВывестиСтрокуВКонсоль("    СоздатьПуть('" + тестПуть + "'): " + создан)
        
        существует = каталог.КаталогСуществует(тестПуть)
        ВывестиСтрокуВКонсоль("    КаталогСуществует: " + существует)
        
        Если существует == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Создание подкаталога работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Подкаталог не создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. РАБОТА С ФАЙЛАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Работа с файлами")
    СброситьЦветКонсоли()
    
    Попытка
        тестФайл = "C:/Temp2/test.txt"
        
        существует = каталог.СуществуетФайл(тестФайл)
        ВывестиСтрокуВКонсоль("    СуществуетФайл('" + тестФайл + "'): " + существует)
        
        Если !существует Тогда
            // Создаём файл через QtФайл
            файл = Новый QtФайл()
            файл.РежимОтладки(Режим_Отладки)
            файл.УстановитьИмяФайла(тестФайл)
            режим = файл.ReadOnly() | файл.WriteOnly() | файл.Truncate() | файл.Text()
            файл.ОткрытьУстройство(режим)
            файл.ЗаписатьДанные("Тестовое содержимое")
            файл.ЗакрытьУстройство()
            ВывестиСтрокуВКонсоль("    ✓ Файл создан")
            
            существует2 = каталог.СуществуетФайл(тестФайл)
            ВывестиСтрокуВКонсоль("    После создания: " + существует2)
            
            // Удаляем файл
            каталог.УдалитьФайл(тестФайл)
            ВывестиСтрокуВКонсоль("    Файл удалён")
            
            Если существует2 == true Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Работа с файлами корректна")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Файл не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Файл уже существует, тест пройден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. УДАЛЕНИЕ КАТАЛОГА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Удаление каталога")
    СброситьЦветКонсоли()
    
    Попытка
        тестПуть = "C:/Temp2/TestSubDir"
        
        существует = каталог.КаталогСуществует(тестПуть)
        ВывестиСтрокуВКонсоль("    До удаления: " + существует)
        
        удален = каталог.УдалитьПуть(тестПуть)
        ВывестиСтрокуВКонсоль("    УдалитьПуть: " + удален)
        
        существует2 = каталог.КаталогСуществует(тестПуть)
        ВывестиСтрокуВКонсоль("    После удаления: " + существует2)
        
        Если существует == true И существует2 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Удаление каталога работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Удаление каталога не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. СПИСОК ФАЙЛОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Список файлов")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаём каталог, который точно существует
        каталог2 = Новый QtКаталог()
        каталог2.РежимОтладки(Режим_Отладки)
        каталог2.УстановитьПуть("C:/Temp2")
        
        список = каталог2.СписокФайлов()
        ВывестиСтрокуВКонсоль("    Найдено элементов: " + список.length)
        
        Если список != null И список.length > 0 Тогда
            ВывестиСтрокуВКонсоль("    Первые 5 элементов:")
            Для i = 0 По 4 Цикл
                Если i < список.length Тогда
                    ВывестиСтрокуВКонсоль("      " + список[i])
                КонецЕсли
            КонецЦикла
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Список файлов получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Список файлов не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. СТАТИЧЕСКИЕ МЕТОДЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Статические методы")
    СброситьЦветКонсоли()
    
    Попытка
        текущий = каталог.ТекущийКаталог()
        домашний = каталог.ДомашнийКаталог()
        временный = каталог.ВременныйКаталог()
        корневой = каталог.КорневойКаталог()
        
        ВывестиСтрокуВКонсоль("    ТекущийКаталог: " + текущий)
        ВывестиСтрокуВКонсоль("    ДомашнийКаталог: " + домашний)
        ВывестиСтрокуВКонсоль("    ВременныйКаталог: " + временный)
        ВывестиСтрокуВКонсоль("    КорневойКаталог: " + корневой)
        
        Если текущий != "" И домашний != "" И временный != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Статические методы корректны")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Статические методы не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ФИЛЬТРЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Фильтры")
    СброситьЦветКонсоли()
    
    Попытка
        каталог3 = Новый QtКаталог()
        каталог3.РежимОтладки(Режим_Отладки)
        каталог3.УстановитьПуть("C:/Temp2")
        
        // Устанавливаем фильтр только на файлы
        каталог3.УстановитьФильтр(каталог3.Фильтр_Файлы())
        списокФайлов = каталог3.СписокФайлов()
        
        // Устанавливаем фильтр только на каталоги
        каталог3.УстановитьФильтр(каталог3.Фильтр_Каталоги())
        списокКаталогов = каталог3.СписокФайлов()
        
        ВывестиСтрокуВКонсоль("    Файлов: " + списокФайлов.length + ", Каталогов: " + списокКаталогов.length)
        
        // Проверяем, что фильтры работают
        Если списокФайлов.length > 0 И списокКаталогов.length > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Фильтры работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠ Один из списков пуст, но фильтры работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. КОНСТАНТЫ ФИЛЬТРОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Константы фильтров")
    СброситьЦветКонсоли()
    
    Попытка
        фильтрКаталоги = каталог.Фильтр_Каталоги()
        фильтрФайлы = каталог.Фильтр_Файлы()
        фильтрВсе = каталог.Фильтр_Все()
        фильтрСкрытые = каталог.Фильтр_Скрытые()
        
        ВывестиСтрокуВКонсоль("    Фильтр_Каталоги: " + фильтрКаталоги + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("    Фильтр_Файлы: " + фильтрФайлы + " (ожидается 2)")
        ВывестиСтрокуВКонсоль("    Фильтр_Все: " + фильтрВсе + " (ожидается 7)")
        ВывестиСтрокуВКонсоль("    Фильтр_Скрытые: " + фильтрСкрытые + " (ожидается 256)")
        
        Если фильтрКаталоги == 1 И фильтрФайлы == 2 И фильтрВсе == 7 И фильтрСкрытые == 256 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы фильтров корректны")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы фильтров некорректны")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof каталог.RusFunc === 'function' Тогда
            jsonStr = каталог.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    // Очистка
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("Очистка тестовой структуры...")
    СброситьЦветКонсоли()
    ОчиститьТестовуюСтруктуру()
    ВывестиСтрокуВКонсоль("")
    
    Возврат "Тест QtКаталог завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТИРОВАНИЕ QtКаталог (QtDir)                             ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtDir()
    ДиагностикаМетаОбъектаDir()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtКаталог (русские и английские методы)                                │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtDirFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtКаталог: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

