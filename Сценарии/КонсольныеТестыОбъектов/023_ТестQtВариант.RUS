// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtВариант
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtVariant()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtВариант ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtVariant: " + (typeof QtVariant !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtVariant: " + e)
    КонецПопытки;
    
    Попытка
        диагВариант = Новый QtВариант()
        Если диагВариант == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtВариант не создан")
            Возврат
        КонецЕсли;
        
        диагВариант.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtВариант создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "setValue", "setString", "setNumber", "setBool", "clear",
            "getValue", "asString", "toInt", "toDouble", "toBool",
            "getIsValid", "getIsNull", "getTypeName", "getIsString", "getIsNumber", "getIsBool",
            "canConvert", "toIntOrDefault", "toDoubleOrDefault", "toBoolOrDefault", "toStringOrDefault",
            "debugInfo"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВариант[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "УстановитьЗначение", "УстановитьСтроку", "УстановитьЧисло", "УстановитьЛогику",
            "Очистить", "ПолучитьЗначение", "ВСтроку", "ВЧисло", "ВДробь", "ВЛогику",
            "Корректен", "Пустой", "Тип", "ЭтоСтрока", "ЭтоЧисло", "ЭтоЛогика",
            "МожетПреобразовать", "ВЧислоПоУмолчанию", "ВДробьПоУмолчанию",
            "ВЛогикуПоУмолчанию", "ВСтрокуПоУмолчанию", "Отладка"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагВариант[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагВариант.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагВариант.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtВариант: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtВариант (QtVariant)
// ============================================================

Функция ТестQtVariantFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtВариант (по умолчанию)                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    вариант = null
    Попытка
        вариант = Новый QtВариант()
        вариант.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtВариант создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если вариант == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ НЕИНИЦИАЛИЗИРОВАННОГО ВАРИАНТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ НЕИНИЦИАЛИЗИРОВАННОГО ВАРИАНТА (свойства и методы)                    │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // ✅ Используем СВОЙСТВА с заглавной буквы
        тип = вариант.TypeName
        валид = вариант.IsValid
        нулл = вариант.IsNull
        строка = вариант.IsString
        число = вариант.IsNumber
        логика = вариант.IsBool
        
        тип2 = вариант.Тип()
        валид2 = вариант.Корректен()
        нулл2 = вариант.Пустой()
        
        ВывестиСтрокуВКонсоль("  TypeName (свойство) = " + тип + " (ожидается undefined)")
        ВывестиСтрокуВКонсоль("  IsValid (свойство) = " + валид + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  IsNull (свойство) = " + нулл + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  IsString (свойство) = " + строка + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  IsNumber (свойство) = " + число + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  IsBool (свойство) = " + логика + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  Тип() = " + тип2 + " (ожидается undefined)")
        ВывестиСтрокуВКонсоль("  Корректен() = " + валид2 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  Пустой() = " + нулл2 + " (ожидается true)")
        
        Если тип == "undefined" И валид == ЛОЖЬ И нулл == ИСТИНА И строка == ЛОЖЬ И число == ЛОЖЬ И логика == ЛОЖЬ И тип2 == "undefined" И валид2 == ЛОЖЬ И нулл2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка неинициализированного варианта работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка неинициализированного варианта работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке варианта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ СОЗДАНИЯ С РАЗНЫМИ ТИПАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ СОЗДАНИЯ С РАЗНЫМИ ТИПАМИ                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        вСтрока = Новый QtВариант("Привет")
        вСтрока.РежимОтладки(Режим_Отладки)
        вЧисло = Новый QtВариант(42)
        вЧисло.РежимОтладки(Режим_Отладки)
        вДробь = Новый QtВариант(3.14)
        вДробь.РежимОтладки(Режим_Отладки)
        вЛогика = Новый QtВариант(ИСТИНА)
        вЛогика.РежимОтладки(Режим_Отладки)
        
        тип1 = вСтрока.TypeName
        тип2 = вЧисло.TypeName
        тип3 = вДробь.TypeName
        тип4 = вЛогика.TypeName
        
        знач1 = вСтрока.asString()
        знач2 = вЧисло.asString()
        знач3 = вДробь.asString()
        знач4 = вЛогика.asString()
        
        ВывестиСтрокуВКонсоль("  QtВариант('Привет') -> TypeName = " + тип1 + " (ожидается string), asString() = " + знач1)
        ВывестиСтрокуВКонсоль("  QtВариант(42) -> TypeName = " + тип2 + " (ожидается number), asString() = " + знач2)
        ВывестиСтрокуВКонсоль("  QtВариант(3.14) -> TypeName = " + тип3 + " (ожидается number), asString() = " + знач3)
        ВывестиСтрокуВКонсоль("  QtВариант(true) -> TypeName = " + тип4 + " (ожидается boolean), asString() = " + знач4)
        
        Если тип1 == "string" И тип2 == "number" И тип3 == "number" И тип4 == "boolean" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Создание с разными типами работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Создание с разными типами работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ УстановитьЗначение() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ УстановитьЗначение()                                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в4 = Новый QtВариант()
        в4.РежимОтладки(Режим_Отладки)
        в4.УстановитьЗначение("Тест")
        тип1 = в4.TypeName
        знач1 = в4.asString()
        
        в4.УстановитьЗначение(123)
        тип2 = в4.TypeName
        знач2 = в4.asString()
        
        в4.УстановитьЗначение(ИСТИНА)
        тип3 = в4.TypeName
        знач3 = в4.asString()
        
        в4.УстановитьЗначение("Русский")
        тип4 = в4.TypeName
        знач4 = в4.asString()
        
        ВывестиСтрокуВКонсоль("  УстановитьЗначение('Тест') -> TypeName = " + тип1 + " (ожидается string), asString() = " + знач1)
        ВывестиСтрокуВКонсоль("  УстановитьЗначение(123) -> TypeName = " + тип2 + " (ожидается number), asString() = " + знач2)
        ВывестиСтрокуВКонсоль("  УстановитьЗначение(true) -> TypeName = " + тип3 + " (ожидается boolean), asString() = " + знач3)
        ВывестиСтрокуВКонсоль("  УстановитьЗначение('Русский') -> TypeName = " + тип4 + " (ожидается string), asString() = " + знач4)
        
        Если тип1 == "string" И тип2 == "number" И тип3 == "boolean" И тип4 == "string" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ УстановитьЗначение() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ УстановитьЗначение() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке значения: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ УстановитьСтроку() / УстановитьЧисло() / УстановитьЛогику() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ УстановитьСтроку(), УстановитьЧисло(), УстановитьЛогику()              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в5 = Новый QtВариант()
        в5.РежимОтладки(Режим_Отладки)
        
        в5.УстановитьСтроку("Привет мир")
        тип1 = в5.TypeName
        знач1 = в5.asString()
        
        в5.УстановитьЧисло(99.9)
        тип2 = в5.TypeName
        знач2 = в5.asString()
        
        в5.УстановитьЛогику(ЛОЖЬ)
        тип3 = в5.TypeName
        знач3 = в5.asString()
        
        ВывестиСтрокуВКонсоль("  УстановитьСтроку('Привет мир') -> TypeName = " + тип1 + ", asString() = " + знач1)
        ВывестиСтрокуВКонсоль("  УстановитьЧисло(99.9) -> TypeName = " + тип2 + ", asString() = " + знач2)
        ВывестиСтрокуВКонсоль("  УстановитьЛогику(false) -> TypeName = " + тип3 + ", asString() = " + знач3)
        
        Если тип1 == "string" И тип2 == "number" И тип3 == "boolean" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ УстановитьСтроку() / УстановитьЧисло() / УстановитьЛогику() работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ УстановитьСтроку() / УстановитьЧисло() / УстановитьЛогику() работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при установке типов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ ПРЕОБРАЗОВАНИЕ ТИПОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ ПРЕОБРАЗОВАНИЕ ТИПОВ (asString, toInt, toDouble, toBool)              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в6 = Новый QtВариант("123")
        в6.РежимОтладки(Режим_Отладки)
        
        стр = в6.asString()
        инт = в6.toInt()
        дробь = в6.toDouble()
        лог = в6.toBool()
        
        ВывестиСтрокуВКонсоль("  QtВариант('123')")
        ВывестиСтрокуВКонсоль("  asString() = " + стр + " (ожидается 123)")
        ВывестиСтрокуВКонсоль("  toInt() = " + инт + " (ожидается 123)")
        ВывестиСтрокуВКонсоль("  toDouble() = " + дробь + " (ожидается 123)")
        ВывестиСтрокуВКонсоль("  toBool() = " + лог + " (ожидается false)")
        
        в6.УстановитьЧисло(42)
        стр2 = в6.asString()
        инт2 = в6.toInt()
        дробь2 = в6.toDouble()
        лог2 = в6.toBool()
        
        ВывестиСтрокуВКонсоль("  УстановитьЧисло(42)")
        ВывестиСтрокуВКонсоль("  asString() = " + стр2 + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  toInt() = " + инт2 + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  toDouble() = " + дробь2 + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  toBool() = " + лог2 + " (ожидается true)")
        
        в6.УстановитьЛогику(ЛОЖЬ)
        стр3 = в6.asString()
        инт3 = в6.toInt()
        дробь3 = в6.toDouble()
        лог3 = в6.toBool()
        
        ВывестиСтрокуВКонсоль("  УстановитьЛогику(false)")
        ВывестиСтрокуВКонсоль("  asString() = " + стр3 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  toInt() = " + инт3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  toDouble() = " + дробь3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  toBool() = " + лог3 + " (ожидается false)")
        
        Если инт == 123 И лог == ЛОЖЬ И инт2 == 42 И лог2 == ИСТИНА И лог3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Преобразование типов работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Преобразование типов работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при преобразовании типов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ Методы с умолчанием =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ МЕТОДЫ С УМОЛЧАНИЕМ                                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в7 = Новый QtВариант()
        в7.РежимОтладки(Режим_Отладки)
        
        инт1 = в7.ВЧислоПоУмолчанию(999)
        дробь1 = в7.ВДробьПоУмолчанию(9.99)
        лог1 = в7.ВЛогикуПоУмолчанию(ИСТИНА)
        стр1 = в7.ВСтрокуПоУмолчанию("по умолчанию")
        
        ВывестиСтрокуВКонсоль("  Неинициализированный вариант:")
        ВывестиСтрокуВКонсоль("  ВЧислоПоУмолчанию(999) = " + инт1 + " (ожидается 999)")
        ВывестиСтрокуВКонсоль("  ВДробьПоУмолчанию(9.99) = " + дробь1 + " (ожидается 9.99)")
        ВывестиСтрокуВКонсоль("  ВЛогикуПоУмолчанию(true) = " + лог1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  ВСтрокуПоУмолчанию('по умолчанию') = " + стр1 + " (ожидается по умолчанию)")
        
        в7.УстановитьЧисло(100)
        инт2 = в7.ВЧислоПоУмолчанию(999)
        дробь2 = в7.ВДробьПоУмолчанию(9.99)
        лог2 = в7.ВЛогикуПоУмолчанию(ИСТИНА)
        стр2 = в7.ВСтрокуПоУмолчанию("по умолчанию")
        
        ВывестиСтрокуВКонсоль("  После УстановитьЧисло(100):")
        ВывестиСтрокуВКонсоль("  ВЧислоПоУмолчанию(999) = " + инт2 + " (ожидается 100)")
        ВывестиСтрокуВКонсоль("  ВДробьПоУмолчанию(9.99) = " + дробь2 + " (ожидается 100)")
        ВывестиСтрокуВКонсоль("  ВЛогикуПоУмолчанию(true) = " + лог2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  ВСтрокуПоУмолчанию('по умолчанию') = " + стр2 + " (ожидается 100)")
        
        Если инт1 == 999 И дробь1 == 9.99 И лог1 == ИСТИНА И стр1 == "по умолчанию" И инт2 == 100 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Методы с умолчанием работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Методы с умолчанием работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вызове методов с умолчанием: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ МожетПреобразовать() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ МожетПреобразовать()                                                  │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в8 = Новый QtВариант("123")
        в8.РежимОтладки(Режим_Отладки)
        
        кан1 = в8.МожетПреобразовать(0)
        кан2 = в8.МожетПреобразовать(1)
        кан3 = в8.МожетПреобразовать(2)
        
        ВывестиСтрокуВКонсоль("  QtВариант('123')")
        ВывестиСтрокуВКонсоль("  МожетПреобразовать(0) [string] = " + кан1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  МожетПреобразовать(1) [number] = " + кан2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  МожетПреобразовать(2) [boolean] = " + кан3 + " (ожидается true)")
        
        Если кан1 == ИСТИНА И кан2 == ИСТИНА И кан3 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ МожетПреобразовать() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ МожетПреобразовать() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке преобразования: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ Очистить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в9 = Новый QtВариант("Значение")
        в9.РежимОтладки(Режим_Отладки)
        
        типДо = в9.TypeName
        валидДо = в9.IsValid
        
        в9.clear()
        типПосле = в9.TypeName
        валидПосле = в9.IsValid
        
        в9.Очистить()
        типПосле2 = в9.TypeName
        валидПосле2 = в9.IsValid
        
        ВывестиСтрокуВКонсоль("  До clear(): TypeName = " + типДо + " (ожидается string), IsValid = " + валидДо + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  После clear(): TypeName = " + типПосле + " (ожидается undefined), IsValid = " + валидПосле + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  После Очистить(): TypeName = " + типПосле2 + " (ожидается undefined), IsValid = " + валидПосле2 + " (ожидается false)")
        
        Если типПосле == "undefined" И валидПосле == ЛОЖЬ И типПосле2 == "undefined" И валидПосле2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 10. ТЕСТ Отладка() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. ТЕСТ Отладка()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в10 = Новый QtВариант(42)
        в10.РежимОтладки(Режим_Отладки)
        
        инфо1 = в10.getDebug()
        инфо2 = в10.ПолучитьРежимОтладки()
        
        ВывестиСтрокуВКонсоль("  getDebug() = " + инфо1)
        ВывестиСтрокуВКонсоль("  ПолучитьРежимОтладки() = " + инфо2)
        
        Если инфо1 != "" И инфо2 != "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ПолучитьРежимОтладки() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ПолучитьРежимОтладки() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вызове ПолучитьРежимОтладки(): " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 11. ТЕСТ РУССКИХ МЕТОДОВ ПРОВЕРКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ТЕСТ РУССКИХ МЕТОДОВ ПРОВЕРКИ (ЭтоСтрока, ЭтоЧисло, ЭтоЛогика)           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в11 = Новый QtВариант("Тест")
        в11.РежимОтладки(Режим_Отладки)
        
        этоСтр = в11.ЭтоСтрока()
        этоЧис = в11.ЭтоЧисло()
        этоЛог = в11.ЭтоЛогика()
        
        ВывестиСтрокуВКонсоль("  QtВариант('Тест')")
        ВывестиСтрокуВКонсоль("  ЭтоСтрока() = " + этоСтр + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  ЭтоЧисло() = " + этоЧис + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  ЭтоЛогика() = " + этоЛог + " (ожидается false)")
        
        в11.УстановитьЧисло(100)
        этоСтр2 = в11.ЭтоСтрока()
        этоЧис2 = в11.ЭтоЧисло()
        этоЛог2 = в11.ЭтоЛогика()
        
        ВывестиСтрокуВКонсоль("  После УстановитьЧисло(100)")
        ВывестиСтрокуВКонсоль("  ЭтоСтрока() = " + этоСтр2 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  ЭтоЧисло() = " + этоЧис2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  ЭтоЛогика() = " + этоЛог2 + " (ожидается false)")
        
        Если этоСтр == ИСТИНА И этоЧис == ЛОЖЬ И этоЛог == ЛОЖЬ И этоЧис2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Русские методы проверки работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Русские методы проверки работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вызове русских методов проверки: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 12. ТЕСТ ПолучитьЗначение() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 12. ТЕСТ ПолучитьЗначение()                                                   │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        в12 = Новый QtВариант(3.14)
        в12.РежимОтладки(Режим_Отладки)
        
        знач1 = в12.getValue()
        знач2 = в12.ПолучитьЗначение()
        
        // Преобразуем в строку для сравнения
        стрЗнач1 = знач1.toString()
        стрЗнач2 = знач2.toString()
        
        ВывестиСтрокуВКонсоль("  getValue() = " + стрЗнач1 + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  ПолучитьЗначение() = " + стрЗнач2 + " (ожидается 3.14)")
        
        Если стрЗнач1 == "3.14" И стрЗнач2 == "3.14" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ПолучитьЗначение() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ПолучитьЗначение() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении значения: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtВариант завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

