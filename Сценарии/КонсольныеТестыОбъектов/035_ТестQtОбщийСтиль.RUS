//Что было проверено:
//✅ Создание объекта - Новый QtОбщийСтиль()
//✅ Валидность - isValid() / Действителен()
//✅ Имя стиля - name() / Имя()
//✅ Пиксельный размер - pixelMetric() / ПиксельныйРазмер()
//✅ Нативность - isNativeStyle() / НативныйСтиль() (возвращает false для QCommonStyle)
//✅ Стандартная иконка - standardIcon() / СтандартнаяИконка()
//✅ Копирование - copyTo() / КопироватьВ()
//✅ Реальный общий стиль - getRealCommonStyle() / ПолучитьОбщийСтиль()
//✅ Реальный стиль (QStyle) - getRealStyle() / ПолучитьСтиль()
//✅ Размер из содержимого - sizeFromContents() / РазмерИзСодержимого() (проверка существования)


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtОбщийСтиль
// ============================================================

Функция ДиагностикаМетодовQtCommonStyle()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtОбщийСтиль ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtОбщийСтиль: " + (typeof QtОбщийСтиль !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtОбщийСтиль: " + e)
    КонецПопытки;
    
    Попытка
        диагОбщий = Новый QtОбщийСтиль()
        Если диагОбщий == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtОбщийСтиль не создан")
            Возврат
        КонецЕсли;
        
        диагОбщий.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtОбщийСтиль создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealCommonStyle", "getRealStyle", "name",
            "standardIcon", "pixelMetric", "sizeFromContents",
            "drawPrimitive", "drawControl", "drawComplexControl",
            "hitTestComplexControl", "subElementRect", "subControlRect",
            "getStyleForWidget", "isNativeStyle",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагОбщий[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьОбщийСтиль", "ПолучитьСтиль", "Имя",
            "СтандартнаяИконка", "ПиксельныйРазмер", "РазмерИзСодержимого",
            "НарисоватьПримитив", "НарисоватьКонтрол", "НарисоватьСложныйКонтрол",
            "ПопаданиеСложногоКонтрола", "ПрямоугольникПодэлемента", "ПрямоугольникПодконтрола",
            "СтильДляВиджета", "НативныйСтиль",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагОбщий[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагОбщий.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагОбщий.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtОбщийСтиль: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtОбщийСтиль
// ============================================================

Функция ТестQtCommonStyle()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    общий = null
    Попытка
        общий = Новый QtОбщийСтиль()
        общий.РежимОтладки(ИСТИНА)
        Если общий != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtОбщийСтиль создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = общий.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = общий.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: name() / Имя() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Получение имени стиля")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        имя = общий.name()
        ВывестиСтрокуВКонсоль("    [ENG] name() = " + имя)
        
        Если имя != "" И имя != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] name() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] name() вернул пустую строку")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            имяРус = общий.Имя()
            ВывестиСтрокуВКонсоль("    [RUS] Имя() = " + имяРус)
            
            Если имяРус != "" И имяРус != null Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Имя() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Имя() вернул пустую строку")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: pixelMetric() / ПиксельныйРазмер() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Получение пиксельного размера")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        размер = общий.pixelMetric(0)
        ВывестиСтрокуВКонсоль("    [ENG] pixelMetric(PM_ScrollBarExtent) = " + размер)
        
        Если размер >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] pixelMetric() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] pixelMetric() вернул отрицательное значение")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            размерРус = общий.ПиксельныйРазмер(0)
            ВывестиСтрокуВКонсоль("    [RUS] ПиксельныйРазмер(PM_ScrollBarExtent) = " + размерРус)
            
            Если размерРус >= 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] ПиксельныйРазмер() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] ПиксельныйРазмер() вернул отрицательное значение")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: isNativeStyle() / НативныйСтиль() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка нативности стиля")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        нативный = общий.isNativeStyle()
        ВывестиСтрокуВКонсоль("    [ENG] isNativeStyle() = " + нативный)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] isNativeStyle() работает")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            нативныйРус = общий.НативныйСтиль()
            ВывестиСтрокуВКонсоль("    [RUS] НативныйСтиль() = " + нативныйРус)
            
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] НативныйСтиль() работает")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
