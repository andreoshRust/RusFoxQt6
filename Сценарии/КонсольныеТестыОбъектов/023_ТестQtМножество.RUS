// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtМножество
// ============================================================

Функция ДиагностикаМетодовQtSet()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtМножество ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtSet: " + (typeof QtSet !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtSet: " + e)
    КонецПопытки;
    
    Попытка
        диагМножество = Новый QtМножество()
        Если диагМножество == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtМножество не создано")
            Возврат
        КонецЕсли;
        
        диагМножество.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtМножество создано")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "insert", "remove", "clear", "contains",
            "size", "count", "isEmpty", "values", "toArray", "unite",
            "empty", "len", "cnt"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМножество[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Добавить", "Удалить", "Очистить", "Содержит",
            "Значения", "ВМассив", "Объединить",
            "Размер", "Количество", "Пустой"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагМножество[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагМножество.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагМножество.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtМножество: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtМножество (QtSet)
// ============================================================

Функция ТестQtSetFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtМножество                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    множество = null
    Попытка
        множество = Новый QtМножество()
        множество.РежимОтладки(ИСТИНА)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtМножество создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если множество == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОГО МНОЖЕСТВА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОГО МНОЖЕСТВА (свойства и методы)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // ✅ Используем СВОЙСТВА с заглавной буквы
        пуст1 = множество.IsEmpty
        пуст2 = множество.Пустой()
        пуст3 = множество.empty()
        размер1 = множество.Size
        размер2 = множество.Размер()
        размер3 = множество.len()
        кол1 = множество.Count
        кол2 = множество.Количество()
        кол3 = множество.cnt()
        
        ВывестиСтрокуВКонсоль("  IsEmpty (свойство) = " + пуст1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Пустой() = " + пуст2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  empty() = " + пуст3 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  len() = " + размер3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Count (свойство) = " + кол1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Количество() = " + кол2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  cnt() = " + кол3 + " (ожидается 0)")
        
        Если пуст1 == ИСТИНА И пуст2 == ИСТИНА И пуст3 == ИСТИНА И размер1 == 0 И размер2 == 0 И размер3 == 0 И кол1 == 0 И кол2 == 0 И кол3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка пустого множества работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка пустого множества работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустого множества: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ Добавить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ Добавить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м1 = Новый QtМножество()
        м1.РежимОтладки(ИСТИНА)
        м1.Добавить("Первый")
        м1.Добавить("Второй")
        м1.Добавить("Третий")
        
        размер = м1.Size
        знач = м1.values()
        знач.sort()
        
        ВывестиСтрокуВКонсоль("  Добавить('Первый'), Добавить('Второй'), Добавить('Третий')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  values() = " + знач.join(", ") + " (ожидается Первый, Второй, Третий)")
        
        Если размер == 3 И знач.length == 3 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Добавить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Добавить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при добавлении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ Содержит() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ Содержит()                                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м2 = Новый QtМножество()
        м2.РежимОтладки(ИСТИНА)
        м2.Добавить("значение")
        
        сод1 = м2.contains("значение")
        сод2 = м2.Содержит("значение")
        сод3 = м2.contains("нет")
        
        ВывестиСтрокуВКонсоль("  contains('значение') = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Содержит('значение') = " + сод2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('нет') = " + сод3 + " (ожидается false)")
        
        Если сод1 == ИСТИНА И сод2 == ИСТИНА И сод3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Содержит() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Содержит() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке наличия элемента: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ УНИКАЛЬНОСТЬ ЭЛЕМЕНТОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ УНИКАЛЬНОСТЬ ЭЛЕМЕНТОВ (дубликаты игнорируются)                        │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м3 = Новый QtМножество()
        м3.РежимОтладки(ИСТИНА)
        м3.Добавить("A")
        м3.Добавить("B")
        м3.Добавить("A")  // Дубликат
        м3.Добавить("B")  // Дубликат
        м3.Добавить("C")
        
        размер = м3.Size
        знач = м3.values()
        знач.sort()
        
        ВывестиСтрокуВКонсоль("  Добавить('A'), Добавить('B'), Добавить('A'), Добавить('B'), Добавить('C')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  values() = " + знач.join(", ") + " (ожидается A, B, C)")
        
        Если размер == 3 И знач.length == 3 И знач[0] == "A" И знач[1] == "B" И знач[2] == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Уникальность элементов работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Уникальность элементов работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке уникальности: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ Удалить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ Удалить()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м4 = Новый QtМножество()
        м4.РежимОтладки(ИСТИНА)
        м4.Добавить("A")
        м4.Добавить("B")
        м4.Добавить("C")
        
        м4.remove("B")
        м4.Удалить("C")
        
        размер = м4.Size
        сод1 = м4.contains("A")
        сод2 = м4.contains("B")
        сод3 = м4.contains("C")
        
        ВывестиСтрокуВКонсоль("  remove('B'), Удалить('C')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("  contains('A') = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('B') = " + сод2 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  contains('C') = " + сод3 + " (ожидается false)")
        
        Если размер == 1 И сод1 == ИСТИНА И сод2 == ЛОЖЬ И сод3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Удалить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Удалить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при удалении элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ Значения() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ Значения()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м5 = Новый QtМножество()
        м5.РежимОтладки(ИСТИНА)
        м5.Добавить("X")
        м5.Добавить("Y")
        м5.Добавить("Z")
        
        знач1 = м5.values()
        знач2 = м5.Значения()
        
        знач1.sort()
        знач2.sort()
        
        ВывестиСтрокуВКонсоль("  values() = " + знач1.join(", ") + " (ожидается X, Y, Z)")
        ВывестиСтрокуВКонсоль("  Значения() = " + знач2.join(", ") + " (ожидается X, Y, Z)")
        
        Если знач1.length == 3 И знач2.length == 3 И знач1[0] == "X" И знач1[1] == "Y" И знач1[2] == "Z" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Значения() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Значения() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении значений: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ ВМассив() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ ВМассив()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м6 = Новый QtМножество()
        м6.РежимОтладки(ИСТИНА)
        м6.Добавить("A")
        м6.Добавить("B")
        м6.Добавить("C")
        
        массив1 = м6.toArray()
        массив2 = м6.ВМассив()
        
        стрМассив1 = []
        Для i = 0 По массив1.length - 1 Цикл
            стрМассив1.push(массив1[i].toString())
        КонецЦикла;
        стрМассив1.sort()
        
        стрМассив2 = []
        Для i = 0 По массив2.length - 1 Цикл
            стрМассив2.push(массив2[i].toString())
        КонецЦикла;
        стрМассив2.sort()
        
        ВывестиСтрокуВКонсоль("  toArray() = " + стрМассив1.join(", ") + " (ожидается A, B, C)")
        ВывестиСтрокуВКонсоль("  ВМассив() = " + стрМассив2.join(", ") + " (ожидается A, B, C)")
        
        Если стрМассив1.length == 3 И стрМассив2.length == 3 И стрМассив1[0] == "A" И стрМассив1[1] == "B" И стрМассив1[2] == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ ВМассив() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ ВМассив() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при преобразовании в массив: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ Очистить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м7 = Новый QtМножество()
        м7.РежимОтладки(ИСТИНА)
        м7.Добавить("A")
        м7.Добавить("B")
        м7.Добавить("C")
        
        м7.clear()
        размер1 = м7.Size
        пусто1 = м7.IsEmpty
        
        м7.Добавить("D")
        м7.Добавить("E")
        м7.Очистить()
        размер2 = м7.Size
        пусто2 = м7.IsEmpty
        
        ВывестиСтрокуВКонсоль("  clear() -> Size = " + размер1 + " (ожидается 0), IsEmpty = " + пусто1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Очистить() -> Size = " + размер2 + " (ожидается 0), IsEmpty = " + пусто2 + " (ожидается true)")
        
        Если размер1 == 0 И пусто1 == ИСТИНА И размер2 == 0 И пусто2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке множества: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 10. ТЕСТ Объединить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. ТЕСТ Объединить()                                                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м8 = Новый QtМножество()
        м8.РежимОтладки(ИСТИНА)
        м8.Добавить("A")
        м8.Добавить("B")
        
        м9 = Новый QtМножество()
        м9.РежимОтладки(ИСТИНА)
        м9.Добавить("B")
        м9.Добавить("C")
        м9.Добавить("D")
        
        м8.unite(м9)
        
        размер = м8.Size
        знач = м8.values()
        знач.sort()
        
        ВывестиСтрокуВКонсоль("  Множество 1: A, B")
        ВывестиСтрокуВКонсоль("  Множество 2: B, C, D")
        ВывестиСтрокуВКонсоль("  unite(м9)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  values() = " + знач.join(", ") + " (ожидается A, B, C, D)")
        
        м8.Объединить(м9)
        
        размер2 = м8.Size
        знач2 = м8.values()
        знач2.sort()
        
        ВывестиСтрокуВКонсоль("  Объединить(м9)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер2 + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  values() = " + знач2.join(", ") + " (ожидается A, B, C, D)")
        
        Если размер == 4 И размер2 == 4 И знач.length == 4 И знач[0] == "A" И знач[1] == "B" И знач[2] == "C" И знач[3] == "D" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Объединить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Объединить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при объединении множеств: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 11. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ (числа, строки, булевы)                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        м10 = Новый QtМножество()
        м10.РежимОтладки(ИСТИНА)
        м10.Добавить(42)
        м10.Добавить("Строка")
        м10.Добавить(ИСТИНА)
        м10.Добавить(3.14)
        
        размер = м10.Size
        знач = м10.values()
        знач.sort()
        
        ВывестиСтрокуВКонсоль("  Добавить(42), Добавить('Строка'), Добавить(true), Добавить(3.14)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 4)")
        ВывестиСтрокуВКонсоль("  values() = " + знач.join(", ") + " (ожидается 3.14, 42, Строка, true)")
        
        сод1 = м10.contains(42)
        сод2 = м10.contains("Строка")
        сод3 = м10.contains(ИСТИНА)
        сод4 = м10.contains(3.14)
        
        ВывестиСтрокуВКонсоль("  contains(42) = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('Строка') = " + сод2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains(true) = " + сод3 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains(3.14) = " + сод4 + " (ожидается true)")
        
        Если размер == 4 И сод1 == ИСТИНА И сод2 == ИСТИНА И сод3 == ИСТИНА И сод4 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами данных корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами данных некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtМножество завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

