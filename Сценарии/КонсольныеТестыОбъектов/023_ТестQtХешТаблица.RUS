// ============================================================
// ДИАГНОСТИКА МЕТОДОВ QtХешТаблица
// ============================================================
Пусть Режим_Отладки = ИСТИНА
Функция ДиагностикаМетодовQtHash()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtХешТаблица ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtHash: " + (typeof QtHash !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtHash: " + e)
    КонецПопытки;
    
    Попытка
        диагХеш = Новый QtХешТаблица()
        Если диагХеш == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtХешТаблица не создана")
            Возврат
        КонецЕсли;
        
        диагХеш.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtХешТаблица создана")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "insert", "remove", "clear", "value", "contains",
            "size", "count", "isEmpty", "keys", "values", "take",
            "empty", "len", "cnt"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагХеш[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Вставить", "Удалить", "Очистить", "Получить", "Содержит",
            "Ключи", "Значения", "Извлечь", "Размер", "Количество", "Пустой"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагХеш[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагХеш.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагХеш.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtХешТаблица: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtХешТаблица (QtHash)
// ============================================================

Функция ТестQtHashFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 1. СОЗДАНИЕ ОБЪЕКТА QtХешТаблица                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    хеш = null
    Попытка
        хеш = Новый QtХешТаблица()
        хеш.РежимОтладки(Режим_Отладки)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("  ✓ Объект QtХешТаблица создан успешно")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при создании объекта: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если хеш == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли;
    ВывестиСтрокуВКонсоль("")

    // ===== 2. ТЕСТ ПУСТОЙ ХЕШ-ТАБЛИЦЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 2. ТЕСТ ПУСТОЙ ХЕШ-ТАБЛИЦЫ (свойства и методы)                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        // ✅ Используем СВОЙСТВА с заглавной буквы
        пуст1 = хеш.IsEmpty
        пуст2 = хеш.Пустой()
        пуст3 = хеш.empty()
        размер1 = хеш.Size
        размер2 = хеш.Размер()
        размер3 = хеш.len()
        кол1 = хеш.Count
        кол2 = хеш.Количество()
        кол3 = хеш.cnt()
        
        ВывестиСтрокуВКонсоль("  IsEmpty (свойство) = " + пуст1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Пустой() = " + пуст2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  empty() = " + пуст3 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Размер() = " + размер2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  len() = " + размер3 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Count (свойство) = " + кол1 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  Количество() = " + кол2 + " (ожидается 0)")
        ВывестиСтрокуВКонсоль("  cnt() = " + кол3 + " (ожидается 0)")
        
        Если пуст1 == ИСТИНА И пуст2 == ИСТИНА И пуст3 == ИСТИНА И размер1 == 0 И размер2 == 0 И размер3 == 0 И  кол1 == 0 И кол2 == 0 И кол3 == 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Проверка пустой хеш-таблицы работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Проверка пустой хеш-таблицы работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке пустой хеш-таблицы: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 3. ТЕСТ Вставить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 3. ТЕСТ Вставить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х1 = Новый QtХешТаблица()
        х1.РежимОтладки(Режим_Отладки)
        х1.Вставить("ключ1", "значение1")
        х1.Вставить("ключ2", "значение2")
        х1.Вставить("ключ3", "значение3")
        
        размер = х1.Size
        знач1 = х1.value("ключ1")
        знач2 = х1.value("ключ2")
        знач3 = х1.value("ключ3")
        
        ВывестиСтрокуВКонсоль("  Вставить('ключ1', 'значение1'), Вставить('ключ2', 'значение2'), Вставить('ключ3', 'значение3')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 3)")
        ВывестиСтрокуВКонсоль("  value('ключ1') = " + знач1.toString() + " (ожидается значение1)")
        ВывестиСтрокуВКонсоль("  value('ключ2') = " + знач2.toString() + " (ожидается значение2)")
        ВывестиСтрокуВКонсоль("  value('ключ3') = " + знач3.toString() + " (ожидается значение3)")
        
        Если размер == 3 И знач1.toString() == "значение1" И знач2.toString() == "значение2" И знач3.toString() == "значение3" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Вставить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Вставить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при вставке элементов: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 4. ТЕСТ Получить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 4. ТЕСТ Получить()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х2 = Новый QtХешТаблица()
        х2.РежимОтладки(Режим_Отладки)
        х2.Вставить("a", "A")
        х2.Вставить("b", "B")
        х2.Вставить("c", "C")
        
        знач1 = х2.value("b")
        знач2 = х2.Получить("c")
        знач3 = х2.value("несуществующий")
        
        ВывестиСтрокуВКонсоль("  value('b') = " + знач1.toString() + " (ожидается B)")
        ВывестиСтрокуВКонсоль("  Получить('c') = " + знач2.toString() + " (ожидается C)")
        ВывестиСтрокуВКонсоль("  value('несуществующий') = " + (знач3 === undefined ? "undefined" : знач3.toString()) + " (ожидается undefined)")
        
        Если знач1.toString() == "B" И знач2.toString() == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Получить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Получить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении значений: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 5. ТЕСТ Содержит() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 5. ТЕСТ Содержит()                                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х3 = Новый QtХешТаблица()
        х3.РежимОтладки(Режим_Отладки)
        х3.Вставить("ключ", "значение")
        
        сод1 = х3.contains("ключ")
        сод2 = х3.Содержит("ключ")
        сод3 = х3.contains("нет")
        
        ВывестиСтрокуВКонсоль("  contains('ключ') = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Содержит('ключ') = " + сод2 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('нет') = " + сод3 + " (ожидается false)")
        
        Если сод1 == ИСТИНА И сод2 == ИСТИНА И сод3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Содержит() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Содержит() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при проверке наличия ключа: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 6. ТЕСТ Удалить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 6. ТЕСТ Удалить()                                                              │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х4 = Новый QtХешТаблица()
        х4.РежимОтладки(Режим_Отладки)
        х4.Вставить("a", 1)
        х4.Вставить("b", 2)
        х4.Вставить("c", 3)
        
        х4.remove("b")
        х4.Удалить("c")
        
        размер = х4.Size
        сод1 = х4.contains("a")
        сод2 = х4.contains("b")
        сод3 = х4.contains("c")
        
        ВывестиСтрокуВКонсоль("  remove('b'), Удалить('c')")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("  contains('a') = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('b') = " + сод2 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  contains('c') = " + сод3 + " (ожидается false)")
        
        Если размер == 1 И сод1 == ИСТИНА И сод2 == ЛОЖЬ И сод3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Удалить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Удалить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при удалении ключей: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 7. ТЕСТ Ключи() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 7. ТЕСТ Ключи()                                                               │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х5 = Новый QtХешТаблица()
        х5.РежимОтладки(Режим_Отладки)
        х5.Вставить("ключ1", 1)
        х5.Вставить("ключ2", 2)
        х5.Вставить("ключ3", 3)
        
        ключи1 = х5.keys()
        ключи2 = х5.Ключи()
        
        ключи1.sort()
        ключи2.sort()
        
        ВывестиСтрокуВКонсоль("  keys() = " + ключи1.join(", ") + " (ожидается ключ1, ключ2, ключ3)")
        ВывестиСтрокуВКонсоль("  Ключи() = " + ключи2.join(", ") + " (ожидается ключ1, ключ2, ключ3)")
        
        Если ключи1.length == 3 И ключи2.length == 3 И ключи1[0] == "ключ1" И ключи1[1] == "ключ2" И ключи1[2] == "ключ3" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Ключи() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Ключи() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении ключей: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 8. ТЕСТ Значения() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 8. ТЕСТ Значения()                                                            │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х6 = Новый QtХешТаблица()
        х6.РежимОтладки(Режим_Отладки)
        х6.Вставить("a", "A")
        х6.Вставить("b", "B")
        х6.Вставить("c", "C")
        
        значения1 = х6.values()
        значения2 = х6.Значения()
        
        стрЗнач1 = []
        Для i = 0 По значения1.length - 1 Цикл
            стрЗнач1.push(значения1[i].toString())
        КонецЦикла;
        стрЗнач1.sort()
        
        стрЗнач2 = []
        Для i = 0 По значения2.length - 1 Цикл
            стрЗнач2.push(значения2[i].toString())
        КонецЦикла;
        стрЗнач2.sort()
        
        ВывестиСтрокуВКонсоль("  values() = " + стрЗнач1.join(", ") + " (ожидается A, B, C)")
        ВывестиСтрокуВКонсоль("  Значения() = " + стрЗнач2.join(", ") + " (ожидается A, B, C)")
        
        Если стрЗнач1.length == 3 И стрЗнач2.length == 3 И стрЗнач1[0] == "A" И стрЗнач1[1] == "B" И стрЗнач1[2] == "C" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Значения() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Значения() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при получении значений: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 9. ТЕСТ Извлечь() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 9. ТЕСТ Извлечь()                                                             │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х7 = Новый QtХешТаблица()
        х7.РежимОтладки(Режим_Отладки)
        х7.Вставить("x", 100)
        х7.Вставить("y", 200)
        х7.Вставить("z", 300)
        
        извлеч1 = х7.take("y")
        извлеч2 = х7.Извлечь("z")
        размер = х7.Size
        сод1 = х7.contains("x")
        сод2 = х7.contains("y")
        сод3 = х7.contains("z")
        
        ВывестиСтрокуВКонсоль("  take('y') = " + извлеч1.toString() + " (ожидается 200)")
        ВывестиСтрокуВКонсоль("  Извлечь('z') = " + извлеч2.toString() + " (ожидается 300)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 1)")
        ВывестиСтрокуВКонсоль("  contains('x') = " + сод1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  contains('y') = " + сод2 + " (ожидается false)")
        ВывестиСтрокуВКонсоль("  contains('z') = " + сод3 + " (ожидается false)")
        
        Если извлеч1.toString() == "200" И извлеч2.toString() == "300" И размер == 1 И сод1 == ИСТИНА И сод2 == ЛОЖЬ И сод3 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Извлечь() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Извлечь() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при извлечении значений: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 10. ТЕСТ Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 10. ТЕСТ Очистить()                                                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х8 = Новый QtХешТаблица()
        х8.РежимОтладки(Режим_Отладки)
        х8.Вставить("a", 1)
        х8.Вставить("b", 2)
        х8.Вставить("c", 3)
        
        х8.clear()
        размер1 = х8.Size
        пусто1 = х8.IsEmpty
        
        х8.Вставить("d", 4)
        х8.Вставить("e", 5)
        х8.Очистить()
        размер2 = х8.Size
        пусто2 = х8.IsEmpty
        
        ВывестиСтрокуВКонсоль("  clear() -> Size = " + размер1 + " (ожидается 0), IsEmpty = " + пусто1 + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  Очистить() -> Size = " + размер2 + " (ожидается 0), IsEmpty = " + пусто2 + " (ожидается true)")
        
        Если размер1 == 0 И пусто1 == ИСТИНА И размер2 == 0 И пусто2 == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Очистить() работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Очистить() работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при очистке хеш-таблицы: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 11. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ ЗНАЧЕНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 11. ТЕСТ РАБОТЫ С РАЗНЫМИ ТИПАМИ ЗНАЧЕНИЙ                                      │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х9 = Новый QtХешТаблица()
        х9.РежимОтладки(Режим_Отладки)
        х9.Вставить("число", 42)
        х9.Вставить("строка", "Привет")
        х9.Вставить("булево", ИСТИНА)
        х9.Вставить("дробь", 3.14)
        
        знач1 = х9.value("число")
        знач2 = х9.value("строка")
        знач3 = х9.value("булево")
        знач4 = х9.value("дробь")
        размер = х9.Size
        
        ВывестиСтрокуВКонсоль("  value('число') = " + знач1.toString() + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("  value('строка') = " + знач2.toString() + " (ожидается Привет)")
        ВывестиСтрокуВКонсоль("  value('булево') = " + знач3.toString() + " (ожидается true)")
        ВывестиСтрокуВКонсоль("  value('дробь') = " + знач4.toString() + " (ожидается 3.14)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 4)")
        
        Если знач1.toString() == "42" И знач2.toString() == "Привет" И знач3.toString() == "true" И знач4.toString() == "3.14" И размер == 4 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Работа с разными типами значений корректна")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Работа с разными типами значений некорректна")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при работе с разными типами: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== 12. ТЕСТ ЗАМЕНА ЗНАЧЕНИЯ ПО КЛЮЧУ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ 12. ТЕСТ ЗАМЕНА ЗНАЧЕНИЯ ПО КЛЮЧУ (перезапись)                                 │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        х10 = Новый QtХешТаблица()
        х10.РежимОтладки(Режим_Отладки)
        х10.Вставить("ключ", "старое значение")
        х10.Вставить("ключ", "новое значение")
        
        знач = х10.value("ключ")
        размер = х10.Size
        
        ВывестиСтрокуВКонсоль("  Вставить('ключ', 'старое значение')")
        ВывестиСтрокуВКонсоль("  Вставить('ключ', 'новое значение')")
        ВывестиСтрокуВКонсоль("  value('ключ') = " + знач.toString() + " (ожидается новое значение)")
        ВывестиСтрокуВКонсоль("  Size (свойство) = " + размер + " (ожидается 1)")
        
        Если знач.toString() == "новое значение" И размер == 1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("  ✓ Замена значения по ключу работает корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("  ❌ Замена значения по ключу работает некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ✗ ОШИБКА при замене значения: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    ВывестиСтрокуВКонсоль("")

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtХешТаблица завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции

