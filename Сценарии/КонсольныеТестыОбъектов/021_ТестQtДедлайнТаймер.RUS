    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Копирование объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        таймер11 = Новый QtДедлайнТаймер()
        таймер11.setRemainingTime(1500)
        копия = Новый QtДедлайнТаймер()
        успех = таймер11.copyTo(копия)
        
        Если успех == ИСТИНА Тогда
            осталосьОриг = таймер11.getRemainingTime()
            осталосьКопия = копия.getRemainingTime()
            ВывестиСтрокуВКонсоль("    [ENG] copyTo(): оригинал=" + осталосьОриг + "мс, копия=" + осталосьКопия + "мс")
            
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] copyTo() работает корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] copyTo() вернул false")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            таймер11Рус = Новый QtДедлайнТаймер()
            таймер11Рус.setRemainingTime(2000)
            копияРус = Новый QtДедлайнТаймер()
            успехРус = таймер11Рус.КопироватьВ(копияРус)
            
            Если успехРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] КопироватьВ() работает корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] КопироватьВ() вернул false")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== ВЫВОД ТАБЛИЦЫ СОПОСТАВЛЕНИЙ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌───────┬─────────────────────────────────────────┬───────────────────────────┬───────────────┐")
    ВывестиСтрокуВКонсоль("│  №    │ Английский метод                      │ Русский метод             │ Статус        │")
    ВывестиСтрокуВКонсоль("├───────┼─────────────────────────────────────────┼───────────────────────────┼───────────────┤")
    СброситьЦветКонсоли()
    
    сопоставления = [
        ["1", "Создание объекта", "Создание объекта"],
        ["2", "isForever()", "Бесконечный()"],
        ["3", "setDeadline()", "УстановитьДедлайн()"],
        ["4", "setRemainingTime()", "УстановитьОставшеесяВремя()"],
        ["5", "hasExpired()", "Истёк()"],
        ["6", "restart()", "Перезапустить()"],
        ["7", "clear()", "Очистить()"],
        ["8", "setRemainingTimeWithType()", "УстановитьОставшеесяВремяСТипом()"],
        ["9", "getRemainingTime()", "ОставшеесяВремя()"],
        ["10", "restartWithType()", "ПерезапуститьСТипом()"],
        ["11", "copyTo()", "КопироватьВ()"]
    ]
    
    Для i = 0 По сопоставления.length - 1 Цикл
        строка = сопоставления[i]
        номер = строка[0]
        англМетод = строка[1]
        русМетод = строка[2]
        
        англСтатус = "❌"
        русСтатус = "❌"
        
        Если i < англРезультаты.length И англРезультаты[i] == ИСТИНА Тогда
            англСтатус = "✅"
        КонецЕсли;
        
        Если i < русРезультаты.length И русРезультаты[i] == ИСТИНА Тогда
            русСтатус = "✅"
        КонецЕсли;
        
        общийСтатус = "❌"
        Если (i < англРезультаты.length И англРезультаты[i] == ИСТИНА) И (i < русРезультаты.length И русРезультаты[i] == ИСТИНА) Тогда
            общийСтатус = "✅"
        КонецЕсли;
        
        УстановитьЦветКонсоли("white")
        ВывестиСтрокуВКонсоль("│  " + номер + "    │ " + англМетод + " " + англСтатус + "        │ " + русМетод + " " + русСтатус + "      │   " + общийСтатус + "        │")
        СброситьЦветКонсоли()
    КонецЦикла;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└───────┴─────────────────────────────────────────┴───────────────────────────┴───────────────┘")
    СброситьЦветКонсоли()
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Английских успешно: " + успешноАнгл + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноАнгл > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: " + неуспешноАнгл + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Английских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("green")
    ВывестиСтрокуВКонсоль("│  ✅ Русских успешно: " + успешноРус + "                                                  │")
    СброситьЦветКонсоли()
    
    Если неуспешноРус > 0 Тогда
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: " + неуспешноРус + "                                                │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ❌ Русских неуспешно: 0 (все успешно!)                                    │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    СброситьЦветКонсоли()
    
    Если успешноАнгл == всегоТестов И успешноРус == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ВСЕ ТЕСТЫ ПРОЙДЕНЫ УСПЕШНО!                              │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  СТАТУС:        ЕСТЬ ОШИБКИ (проверьте вывод выше)                        │")
        СброситьЦветКонсоли()
    КонецЕсли;
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtДедлайнТаймер завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtДедлайнТаймер (QtDeadlineTimer)                  ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtDeadlineTimer()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtДедлайнТаймер (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtDeadlineTimer()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtДедлайнТаймер: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

