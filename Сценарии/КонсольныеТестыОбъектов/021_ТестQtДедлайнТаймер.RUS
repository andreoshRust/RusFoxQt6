//Итоги тестирования QtДедлайнТаймер (QtDeadlineTimer):
//Тест    Описание    Результат
//1    Создание объекта    ✅ Пройден
//2    Проверка бесконечности    ✅ Пройден
//3    Установка дедлайна    ✅ Пройден
//4    Установка оставшегося времени    ✅ Пройден
//5    Проверка истечения    ✅ Пройден
//6    Перезапуск таймера    ✅ Пройден
//7    Очистка таймера    ✅ Пройден
//8    Установка времени с типом    ✅ Пройден
//9    Уменьшение оставшегося времени    ✅ Пройден
//10    Перезапуск с типом    ✅ Пройден
//11    Копирование объекта    ✅ Пройден
//12    Проверка валидности    ✅ Пройден
//13    Проверка RusFunc    ✅ Пройден
//Доступные методы:
//Английские (16 из 16):
//isValid() - проверка валидности
//getRealTimer() - получение реального таймера
//setDeadline() - установка дедлайна
//setRemainingTime() - установка оставшегося времени
//setRemainingTimeWithType() - установка времени с типом
//deadline() - получение дедлайна
//getRemainingTime() - получение оставшегося времени
//remainingTimeNSecs() - оставшееся время в наносекундах
//hasExpired() - проверка истечения
//clear() - очистка
//restart() - перезапуск
//restartWithType() - перезапуск с типом
//isForever() - проверка бесконечности
//copyTo() - копирование
//setDebug() - установка режима отладки
//getDebug() - получение режима отладки
//Русские (16 из 16):
//Действителен() - isValid
//ПолучитьТаймер() - getRealTimer
//УстановитьДедлайн() - setDeadline
//УстановитьОставшеесяВремя() - setRemainingTime
//УстановитьОставшеесяВремяСТипом() - setRemainingTimeWithType
//Дедлайн() - deadline
//ОставшеесяВремя() - getRemainingTime
//ОставшеесяВремяНс() - remainingTimeNSecs
//Истёк() - hasExpired
//Очистить() - clear
//Перезапустить() - restart
//ПерезапуститьСТипом() - restartWithType
//Бесконечный() - isForever
//КопироватьВ() - copyTo
//РежимОтладки() - setDebug
//ПолучитьРежимОтладки() - getDebug


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtДедлайнТаймер
// ============================================================

Функция ДиагностикаМетодовQtDeadlineTimer()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtДедлайнТаймер ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtDeadlineTimer: " + (typeof QtDeadlineTimer !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtДедлайнТаймер: " + (typeof QtДедлайнТаймер !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке: " + e)
    КонецПопытки;
    
    Попытка
        диагТаймер = Новый QtДедлайнТаймер()
        Если диагТаймер == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtДедлайнТаймер не создан")
            Возврат
        КонецЕсли;
        
        диагТаймер.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtДедлайнТаймер создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealTimer", "setDeadline", "setRemainingTime", 
            "setRemainingTimeWithType", "deadline", "getRemainingTime", 
            "remainingTimeNSecs", "hasExpired", "clear", "restart", 
            "restartWithType", "isForever", "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьТаймер", "УстановитьДедлайн", "УстановитьОставшеесяВремя",
            "УстановитьОставшеесяВремяСТипом", "Дедлайн", "ОставшеесяВремя",
            "ОставшеесяВремяНс", "Истёк", "Очистить", "Перезапустить",
            "ПерезапуститьСТипом", "Бесконечный", "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагТаймер[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагТаймер.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагТаймер.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                    
                    // Проверка наличия всех русских методов
                    ВывестиСтрокуВКонсоль("  Проверка русских методов в JSON:")
                    найдено = 0
                    Для i = 0 По русМетоды.length - 1 Цикл
                        нашли = ЛОЖЬ
                        Для j = 0 По карта.length - 1 Цикл
                            Если карта[j].русскоеИмя == русМетоды[i] Тогда
                                нашли = ИСТИНА
                                Прервать
                            КонецЕсли;
                        КонецЦикла;
                        Если нашли Тогда
                            найдено = найдено + 1
                            ВывестиСтрокуВКонсоль("    ✓ " + русМетоды[i])
                        Иначе
                            ВывестиСтрокуВКонсоль("    ✗ " + русМетоды[i] + " (НЕ НАЙДЕН в JSON)")
                        КонецЕсли;
                    КонецЦикла;
                    ВывестиСтрокуВКонсоль("  Найдено: " + найдено + " из " + русМетоды.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtДедлайнТаймер: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtДедлайнТаймер (улучшенная)
// ============================================================

Функция ТестQtDeadlineTimer()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== ТЕСТ 1: Создание объекта =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        таймер = Новый QtДедлайнТаймер()
        таймер.РежимОтладки(ИСТИНА)
        Если таймер != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtДедлайнТаймер создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 2: isForever() / Бесконечный() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка бесконечности")
    СброситьЦветКонсоли()
    
    Попытка
        бесконечный = таймер.isForever()
        ВывестиСтрокуВКонсоль("    isForever(): " + бесконечный + " (ожидается true)")
        
        бесконечныйРус = таймер.Бесконечный()
        ВывестиСтрокуВКонсоль("    Бесконечный(): " + бесконечныйРус + " (ожидается true)")
        
        Если бесконечный == ИСТИНА И бесконечныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка бесконечности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка бесконечности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 3: setDeadline() / УстановитьДедлайн() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Установка дедлайна")
    СброситьЦветКонсоли()
    
    Попытка
        таймер.setDeadline(1000)
        дедлайн = таймер.deadline()
        ВывестиСтрокуВКонсоль("    setDeadline(1000) -> deadline(): " + дедлайн + "мс")
        
        таймер.УстановитьДедлайн(2000)
        дедлайнРус = таймер.deadline()
        ВывестиСтрокуВКонсоль("    УстановитьДедлайн(2000) -> deadline(): " + дедлайнРус + "мс")
        
        Если дедлайн >= 1000 И дедлайнРус >= 2000 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка дедлайна работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка дедлайна не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 4: setRemainingTime() / УстановитьОставшеесяВремя() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка оставшегося времени")
    СброситьЦветКонсоли()
    
    Попытка
        таймер4 = Новый QtДедлайнТаймер()
        таймер4.setRemainingTime(500)
        осталось = таймер4.getRemainingTime()
        ВывестиСтрокуВКонсоль("    setRemainingTime(500) -> getRemainingTime(): " + осталось + "мс")
        
        таймер4.УстановитьОставшеесяВремя(300)
        осталосьРус = таймер4.getRemainingTime()
        ВывестиСтрокуВКонсоль("    УстановитьОставшеесяВремя(300) -> getRemainingTime(): " + осталосьРус + "мс")
        
        Если осталось > 0 И осталось <= 500 И осталосьРус > 0 И осталосьРус <= 300 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка оставшегося времени работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка оставшегося времени не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 5: hasExpired() / Истёк() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка истечения")
    СброситьЦветКонсоли()
    
    Попытка
        таймер5 = Новый QtДедлайнТаймер()
        таймер5.setRemainingTime(100)
        ВывестиСтрокуВКонсоль("    Установлено 100мс")
        
        Пауза(150)
        истек = таймер5.hasExpired()
        истекРус = таймер5.Истёк()
        ВывестиСтрокуВКонсоль("    hasExpired(): " + истек + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Истёк(): " + истекРус + " (ожидается true)")
        
        Если истек == ИСТИНА И истекРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка истечения работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка истечения не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 6: restart() / Перезапустить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Перезапуск таймера")
    СброситьЦветКонсоли()
    
    Попытка
        таймер6 = Новый QtДедлайнТаймер()
        таймер6.setRemainingTime(100)
        Пауза(150)
        
        таймер6.restart(300)
        осталось = таймер6.getRemainingTime()
        ВывестиСтрокуВКонсоль("    restart(300) -> getRemainingTime(): " + осталось + "мс")
        
        таймер6.Перезапустить(200)
        осталосьРус = таймер6.getRemainingTime()
        ВывестиСтрокуВКонсоль("    Перезапустить(200) -> getRemainingTime(): " + осталосьРус + "мс")
        
        Если осталось > 0 И осталосьРус > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Перезапуск таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Перезапуск таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 7: clear() / Очистить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Очистка таймера")
    СброситьЦветКонсоли()
    
    Попытка
        таймер7 = Новый QtДедлайнТаймер()
        таймер7.setRemainingTime(500)
        таймер7.clear()
        бесконечный = таймер7.isForever()
        ВывестиСтрокуВКонсоль("    clear() -> isForever(): " + бесконечный + " (ожидается true)")
        
        таймер7.setRemainingTime(500)
        таймер7.Очистить()
        бесконечныйРус = таймер7.isForever()
        ВывестиСтрокуВКонсоль("    Очистить() -> isForever(): " + бесконечныйРус + " (ожидается true)")
        
        Если бесконечный == ИСТИНА И бесконечныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Очистка таймера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Очистка таймера не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 8: setRemainingTimeWithType() / УстановитьОставшеесяВремяСТипом() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Установка времени с типом")
    СброситьЦветКонсоли()
    
    Попытка
        таймер8 = Новый QtДедлайнТаймер()
        таймер8.setRemainingTimeWithType(1000, 0)
        осталось = таймер8.getRemainingTime()
        ВывестиСтрокуВКонсоль("    setRemainingTimeWithType(1000, 0) -> getRemainingTime(): " + осталось + "мс")
        
        таймер8.УстановитьОставшеесяВремяСТипом(2000, 1)
        осталосьРус = таймер8.getRemainingTime()
        ВывестиСтрокуВКонсоль("    УстановитьОставшеесяВремяСТипом(2000, 1) -> getRemainingTime(): " + осталосьРус + "мс")
        
        Если осталось > 0 И осталосьРус > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка времени с типом работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка времени с типом не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 9: Уменьшение оставшегося времени =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Уменьшение оставшегося времени")
    СброситьЦветКонсоли()
    
    Попытка
        таймер9 = Новый QtДедлайнТаймер()
        таймер9.setRemainingTime(3000)
        
        ост1 = таймер9.getRemainingTime()
        ВывестиСтрокуВКонсоль("    getRemainingTime() сразу: " + ост1 + "мс")
        Пауза(500)
        ост2 = таймер9.getRemainingTime()
        ВывестиСтрокуВКонсоль("    getRemainingTime() через 500мс: " + ост2 + "мс")
        Пауза(500)
        ост3 = таймер9.getRemainingTime()
        ВывестиСтрокуВКонсоль("    getRemainingTime() ещё через 500мс: " + ост3 + "мс")
        
        ост1Рус = таймер9.ОставшеесяВремя()
        Пауза(500)
        ост2Рус = таймер9.ОставшеесяВремя()
        Пауза(500)
        ост3Рус = таймер9.ОставшеесяВремя()
        ВывестиСтрокуВКонсоль("    ОставшеесяВремя(): " + ост1Рус + "мс -> " + ост2Рус + "мс -> " + ост3Рус + "мс")
        
        Если ост1 > ост2 И ост2 > ост3 И ост1Рус > ост2Рус И ост2Рус > ост3Рус Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Время уменьшается корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Время уменьшается некорректно")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 10: restartWithType() / ПерезапуститьСТипом() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Перезапуск с типом")
    СброситьЦветКонсоли()
    
    Попытка
        таймер10 = Новый QtДедлайнТаймер()
        таймер10.setRemainingTime(100)
        Пауза(150)
        
        таймер10.restartWithType(500, 1)
        осталось = таймер10.getRemainingTime()
        ВывестиСтрокуВКонсоль("    restartWithType(500, 1) -> getRemainingTime(): " + осталось + "мс")
        
        таймер10.ПерезапуститьСТипом(300, 0)
        осталосьРус = таймер10.getRemainingTime()
        ВывестиСтрокуВКонсоль("    ПерезапуститьСТипом(300, 0) -> getRemainingTime(): " + осталосьРус + "мс")
        
        Если осталось > 0 И осталосьРус > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Перезапуск с типом работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Перезапуск с типом не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 11: copyTo() / КопироватьВ() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Копирование объекта")
    СброситьЦветКонсоли()
    
    Попытка
        таймер11 = Новый QtДедлайнТаймер()
        таймер11.setRemainingTime(1500)
        копия = Новый QtДедлайнТаймер()
        успех = таймер11.copyTo(копия)
        ВывестиСтрокуВКонсоль("    copyTo(): " + успех + " (ожидается true)")
        
        таймер11Рус = Новый QtДедлайнТаймер()
        таймер11Рус.setRemainingTime(2000)
        копияРус = Новый QtДедлайнТаймер()
        успехРус = таймер11Рус.КопироватьВ(копияРус)
        ВывестиСтрокуВКонсоль("    КопироватьВ(): " + успехРус + " (ожидается true)")
        
        Если успех == ИСТИНА И успехРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Копирование работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Копирование не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 12: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валидный = таймер.isValid()
        валидныйРус = таймер.Действителен()
        ВывестиСтрокуВКонсоль("    isValid(): " + валидный + " (ожидается true)")
        ВывестиСтрокуВКонсоль("    Действителен(): " + валидныйРус + " (ожидается true)")
        
        Если валидный == ИСТИНА И валидныйРус == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка валидности работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка валидности не работает")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    // ===== ТЕСТ 13: Проверка RusFunc =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof таймер.RusFunc === 'function' Тогда
            jsonStr = таймер.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    // ===== ИТОГОВЫЙ ОТЧЁТ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    СброситьЦветКонсоли()
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtДедлайнТаймер завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.14 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.14. Ваша версия программы "+НомерВерсииПрограммы+
          ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ");  
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║              ТЕСТИРОВАНИЕ QtДедлайнТаймер (QtDeadlineTimer)                  ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtDeadlineTimer()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtДедлайнТаймер (русские и английские методы)                           │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtDeadlineTimer()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtДедлайнТаймер: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
КОНЕЦПРОЦЕДУРЫ

