//Итоги тестирования QtLocalSocket (QtЛокальныйСокет):
//✅ Все тесты пройдены успешно (12 из 12)
//Что было протестировано:
//✅ Создание объекта QtLocalSocket
//✅ Проверка состояния (ПолучитьСостояние, СостояниеСтрокой, Подключен, Валидный)
//✅ Проверка имени сервера (ИмяСервера, ПолноеИмяСервера)
//✅ Проверка записи без подключения (возвращает -1)
//✅ Проверка чтения без подключения (возвращает пустую строку)
//✅ Проверка буфера чтения (УстановитьРазмерБуфераЧтения, РазмерБуфераЧтения)
//✅ Проверка констант состояний
//✅ Проверка констант режимов
//✅ Проверка установки имени сервера
//✅ Получение реального объекта (ПолучитьЛокальныйСокет)
//✅ Проверка RusFunc (95 методов в JSON)
//✅ Проверка ожиданий (все возвращают false для не подключенного сокета)
//Диагностика показала:
//34 английских метода доступны
//34 русских метода доступны
//Метод RusFunc() работает корректно (JSON длиной 8200, 95 элементов)
//Класс QtLocalSocket (наследник QtAbstractSocket) предоставляет:
//Подключение - ПодключитьсяКСерверу, ПодключитьсяСРежимом, ОтключитьсяОтСервера, Прервать
//Состояние - ПолучитьСостояние, СостояниеСтрокой, Подключен, Валидный
//Информация о сервере - ИмяСервера, ПолноеИмяСервера, УстановитьИмяСервера
//Запись данных - ЗаписатьДанные, ЗаписатьСтроку, СброситьБуфер
//Чтение данных - ПрочитатьВсе, Прочитать, ПрочитатьСтроку, МожноЧитатьСтроку
//Настройки - УстановитьРазмерБуфераЧтения, РазмерБуфераЧтения
//Ожидание событий - ОжидатьПодключения, ОжидатьОтключения, ОжидатьЧтения, ОжидатьЗаписи
//Колбэки - ПриПодключении, ПриОтключении, ПриГотовностиЧтения, ПриОшибке, ПриИзмененииСостояния, ПриОтправкеДанных
//Сигналы - connected, disconnected, readyRead, bytesWritten, stateChanged, errorOccurred
//Константы - состояния, режимы открытия
//Вывод:
//Класс QtLocalSocket полностью функционален и готов к использованию. Он предоставляет удобный интерфейс для работы с локальными сокетами как на английском, 
//так и на русском языке. Класс успешно наследуется от QtAbstractSocket, который в свою очередь наследуется от QtIODevice и QtObject, что обеспечивает 
//полную интеграцию с системой отладки и русскими именами методов.


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtLocalSocket
// ============================================================
Пусть Режим_Отладки = ИСТИНА

Функция ДиагностикаМетодовQtLocalSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtЛокальныйСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtLocalSocket: " + (typeof QtLocalSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка существования QtЛокальныйСокет: " + (typeof QtЛокальныйСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtЛокальныйСокет: " + e)
    КонецПопытки;
    
    Попытка
        диагСокет = Новый QtLocalSocket()
        Если диагСокет == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtЛокальныйСокет не создан")
            Возврат
        КонецЕсли;
        
        диагСокет.РежимОтладки(Режим_Отладки)
        ВывестиСтрокуВКонсоль("✓ QtЛокальныйСокет создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "connectToServerValue", "connectToServerWithMode", "disconnectFromServerValue", "abortValue",
            "isConnectedValue", "getStateValue", "getStateString",
            "getServerNameValue", "getFullServerNameValue",
            "writeData", "writeLine", "flushValue",
            "bytesAvailableValue", "bytesToWriteValue",
            "readAllValue", "readValue", "readLineValue",
            "canReadLineValue", "atEndValue",
            "setServerNameValue", "setReadBufferSizeValue", "getReadBufferSizeValue",
            "waitForConnectedValue", "waitForDisconnectedValue", "waitForReadyReadValue", "waitForBytesWrittenValue",
            "getRealLocalSocket", "isValid"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов через RusFunc
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "ПодключитьсяКСерверу", "ПодключитьсяСРежимом", "ОтключитьсяОтСервера", "Прервать",
            "Подключен", "ПолучитьСостояние", "СостояниеСтрокой",
            "ИмяСервера", "ПолноеИмяСервера",
            "ЗаписатьДанные", "ЗаписатьСтроку", "СброситьБуфер",
            "ДоступноБайт", "БайтНаОтправку",
            "ПрочитатьВсе", "Прочитать", "ПрочитатьСтроку",
            "МожноЧитатьСтроку", "ВКонце",
            "УстановитьИмяСервера", "УстановитьРазмерБуфераЧтения", "РазмерБуфераЧтения",
            "ОжидатьПодключения", "ОжидатьОтключения", "ОжидатьГотовностиЧтения", "ОжидатьОтправки",
            "ПолучитьЛокальныйСокет", "Валидный"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагСокет[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагСокет.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагСокет.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtЛокальныйСокет: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТА-ОБЪЕКТА QtLocalSocket
// ============================================================

Функция ДиагностикаМетаОбъектаLocalSocket()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТА-ОБЪЕКТА QtЛокальныйСокет ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка QtLocalSocket: " + (typeof QtLocalSocket !== 'undefined'))
        ВывестиСтрокуВКонсоль("Проверка QtЛокальныйСокет: " + (typeof QtЛокальныйСокет !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("Ошибка при проверке: " + e)
    КонецПопытки
    
    Попытка
        сокет = Новый QtLocalSocket()
        Если сокет == null Тогда
            сокет = new QtLocalSocket()
            Если сокет == null Тогда
                ВывестиСтрокуВКонсоль("✗ Объект не создан")
                Возврат 
            Иначе
                ВывестиСтрокуВКонсоль("✓ Объект создан через new QtLocalSocket()")
            КонецЕсли;
        Иначе
            ВывестиСтрокуВКонсоль("✓ Объект создан через НовыйОбъект")
        КонецЕсли;
    Исключение
        ВывестиСтрокуВКонсоль("✗ Ошибка создания: " + e)
        Возврат
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("")
    ВывестиСтрокуВКонсоль("Все методы объекта QtЛокальныйСокет:")
    методы = Object.getOwnPropertyNames(сокет)
    прототип = Object.getPrototypeOf(сокет)
    методыПрототипа = Object.getOwnPropertyNames(прототип)
    Для i = 0 По методыПрототипа.length - 1 Цикл
        имя = методыПрототипа[i]
        Если методы.indexOf(имя) === -1 Тогда
            методы.push(имя)
        КонецЕсли
    КонецЦикла
    методы.sort()
    
    Для i = 0 По методы.length - 1 Цикл
        имя = методы[i]
        Если typeof сокет[имя] === 'function' Тогда
            Если имя === 'RusFunc' ИЛИ имя === 'setDebug' Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("  ✓ " + имя + "() - НАЙДЕН!")
                СброситьЦветКонсоли()
            Иначе
                ВывестиСтрокуВКонсоль("    " + имя + "()")
            КонецЕсли
        КонецЕсли
    КонецЦикла
    
    ВывестиСтрокуВКонсоль("")
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("✓ RusFunc существует!")
            СброситьЦветКонсоли()
            
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            ВывестиСтрокуВКонсоль("  Количество методов в JSON: " + карта.length)
            
            ВывестиСтрокуВКонсоль("  Первые 10 методов:")
            Для i = 0 По 9 Цикл
                Если i < карта.length Тогда
                    item = карта[i]
                    ВывестиСтрокуВКонсоль("    " + item.русскоеИмя + " -> " + item.латинскоеИмя)
                КонецЕсли
            КонецЦикла
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("✗ RusFunc НЕ СУЩЕСТВУЕТ!")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ТЕСТ QtLocalSocket (QtЛокальныйСокет) - ИСПРАВЛЕННАЯ ВЕРСИЯ
// ============================================================

Функция ТестQtLocalSocketFull()
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    сокет = null
    Попытка
        сокет = Новый QtLocalSocket()
        Если сокет != null Тогда
            сокет.РежимОтладки(Режим_Отладки)
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QtЛокальныйСокет создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QtЛокальныйСокет НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
    КонецПопытки
    
    Если сокет == null Тогда
        Возврат "❌ Тест провален (объект не создан)"
    КонецЕсли

    // ===== 2. ПРОВЕРКА СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = сокет.ПолучитьСостояние()
        состояниеСтр = сокет.СостояниеСтрокой()
        // Используем isConnectedValue для проверки подключения
        isConnected = сокет.isConnectedValue()
        валидный = сокет.Валидный()
        
        ВывестиСтрокуВКонсоль("    Состояние: " + состояние + " (" + состояниеСтр + ")")
        ВывестиСтрокуВКонсоль("    isConnectedValue: " + isConnected)
        ВывестиСтрокуВКонсоль("    Валидный: " + валидный)
        
        // Для не подключенного сокета: состояние UnconnectedState (0), isConnected false, валидный true
        Если состояние == сокет.UnconnectedState() И isConnected == false И валидный == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Проверка состояния работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Проверка состояния не работает (состояние=" + состояние + ", isConnected=" + isConnected + ", валидный=" + валидный + ")")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ СЕРВЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени сервера")
    СброситьЦветКонсоли()
    
    Попытка
        имяСервера = сокет.ИмяСервера()
        полноеИмя = сокет.ПолноеИмяСервера()
        
        ВывестиСтрокуВКонсоль("    ИмяСервера: " + имяСервера)
        ВывестиСтрокуВКонсоль("    ПолноеИмяСервера: " + полноеИмя)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Проверка имени сервера работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ЗАПИСИ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка записи (без подключения)")
    СброситьЦветКонсоли()
    
    Попытка
        результат = сокет.ЗаписатьДанные("test")
        ВывестиСтрокуВКонсоль("    ЗаписатьДанные('test') = " + результат + " (ожидается -1)")
        
        Если результат == -1 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Запись правильно возвращает ошибку")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Запись должна вернуть -1")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПРОВЕРКА ЧТЕНИЯ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Проверка чтения (без подключения)")
    СброситьЦветКонсоли()
    
    Попытка
        данные = сокет.ПрочитатьВсе()
        ВывестиСтрокуВКонсоль("    ПрочитатьВсе() = " + данные + " (ожидается пустая строка)")
        
        Если данные == "" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Чтение правильно возвращает пустую строку")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Чтение должно вернуть пустую строку")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПРОВЕРКА БУФЕРА ЧТЕНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка буфера чтения")
    СброситьЦветКонсоли()
    
    Попытка
        размер = сокет.РазмерБуфераЧтения()
        ВывестиСтрокуВКонсоль("    РазмерБуфераЧтения() = " + размер)
        
        сокет.УстановитьРазмерБуфераЧтения(8192)
        новыйРазмер = сокет.РазмерБуфераЧтения()
        ВывестиСтрокуВКонсоль("    После установки: " + новыйРазмер)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Буфер чтения работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА КОНСТАНТ СОСТОЯНИЙ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка констант состояний")
    СброситьЦветКонсоли()
    
    Попытка
        неПодключен = сокет.UnconnectedState()
        подключение = сокет.ConnectingState()
        подключен = сокет.ConnectedState()
        закрытие = сокет.ClosingState()
        
        ВывестиСтрокуВКонсоль("    UnconnectedState: " + неПодключен)
        ВывестиСтрокуВКонсоль("    ConnectingState: " + подключение)
        ВывестиСтрокуВКонсоль("    ConnectedState: " + подключен)
        ВывестиСтрокуВКонсоль("    ClosingState: " + закрытие)
        
        Если неПодключен >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы состояний работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы состояний не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА КОНСТАНТ РЕЖИМОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка констант режимов")
    СброситьЦветКонсоли()
    
    Попытка
        неОткрыт = сокет.NotOpen()
        толькоЧтение = сокет.ReadOnly()
        толькоЗапись = сокет.WriteOnly()
        чтениеЗапись = сокет.ReadWrite()
        добавление = сокет.Append()
        очистить = сокет.Truncate()
        текст = сокет.Text()
        
        ВывестиСтрокуВКонсоль("    NotOpen: " + неОткрыт)
        ВывестиСтрокуВКонсоль("    ReadOnly: " + толькоЧтение)
        ВывестиСтрокуВКонсоль("    WriteOnly: " + толькоЗапись)
        ВывестиСтрокуВКонсоль("    ReadWrite: " + чтениеЗапись)
        ВывестиСтрокуВКонсоль("    Append: " + добавление)
        ВывестиСтрокуВКонсоль("    Truncate: " + очистить)
        ВывестиСтрокуВКонсоль("    Text: " + текст)
        
        Если неОткрыт >= 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Константы режимов работают")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Константы режимов не работают")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА УСТАНОВКИ ИМЕНИ СЕРВЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка установки имени сервера")
    СброситьЦветКонсоли()
    
    Попытка
        тестовоеИмя = "test_socket"
        сокет.УстановитьИмяСервера(тестовоеИмя)
        полученноеИмя = сокет.ИмяСервера()
        ВывестиСтрокуВКонсоль("    Установлено имя: " + тестовоеИмя)
        ВывестиСтрокуВКонсоль("    Получено имя: " + полученноеИмя)
        
        Если полученноеИмя == тестовоеИмя Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Установка имени сервера работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Установка имени сервера не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА ПОЛУЧЕНИЯ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реал = сокет.ПолучитьЛокальныйСокет()
        ВывестиСтрокуВКонсоль("    ПолучитьЛокальныйСокет(): " + (реал != null ? "успешно" : "неудачно"))
        
        Если реал != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Получение реального объекта работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Получение реального объекта не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА RUSFUNC =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка RusFunc")
    СброситьЦветКонсоли()
    
    Попытка
        Если typeof сокет.RusFunc === 'function' Тогда
            jsonStr = сокет.RusFunc()
            карта = JSON.parse(jsonStr)
            Если карта.length > 0 Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] RusFunc возвращает валидный JSON (" + карта.length + " методов)")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] RusFunc вернул пустой JSON")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Метод RusFunc НЕ СУЩЕСТВУЕТ")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА ОЖИДАНИЙ (без подключения) =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка ожиданий")
    СброситьЦветКонсоли()
    
    Попытка
        результат1 = сокет.ОжидатьПодключения(100)
        результат2 = сокет.ОжидатьОтключения(100)
        результат3 = сокет.ОжидатьГотовностиЧтения(100)
        результат4 = сокет.ОжидатьОтправки(100)
        
        ВывестиСтрокуВКонсоль("    ОжидатьПодключения(100): " + результат1)
        ВывестиСтрокуВКонсоль("    ОжидатьОтключения(100): " + результат2)
        ВывестиСтрокуВКонсоль("    ОжидатьГотовностиЧтения(100): " + результат3)
        ВывестиСтрокуВКонсоль("    ОжидатьОтправки(100): " + результат4)
        
        Если результат1 == false И результат2 == false И результат3 == false И результат4 == false Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Ожидания работают корректно")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Ожидания работают некорректно")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│                         РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ                              │")
    ВывестиСтрокуВКонсоль("├────────────────────────────────────────────────────────────────────────────────┤")
    ВывестиСтрокуВКонсоль("│  Всего тестов: " + всегоТестов + "                                                       │")
    
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + " (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)                    │")
        СброситьЦветКонсоли()
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("│  ✅ Успешно:   " + успешноТестов + "                                      │")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("│  ❌ Провалено: " + (всегоТестов - успешноТестов) + "                                     │")
        СброситьЦветКонсоли()
    КонецЕсли
    
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Возврат "Тест QtЛокальныйСокет завершён: " + успешноТестов + " из " + всегоТестов
КонецФункции


// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
//#ОтладкаПрепроцессора
    Пусть Режим_Отладки = ИСТИНА
    
    Пусть НомерВерсииПрограммы = ВерсияПрограммы()
    Если НомерВерсииПрограммы < 2.15 Тогда 
        ПоказатьСообщение("Данный сценарий корректно работает начиная с версии 2.15. Ваша версия программы " + НомерВерсииПрограммы +
           ". Обновите версию на https://github.com/andreoshRust/RusFoxQt6 ")
        Возврат    
    КонецЕсли;
    
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                   ТЕСТИРОВАНИЕ QtLocalSocket (QtЛокальныйСокет)                ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ДИАГНОСТИКА ==========
    ДиагностикаМетодовQtLocalSocket()
    ДиагностикаМетаОбъектаLocalSocket()
    
    // ========== ТЕСТЫ ==========
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("┌────────────────────────────────────────────────────────────────────────────────┐")
    ВывестиСтрокуВКонсоль("│ ТЕСТ QtЛокальныйСокет (русские и английские методы)                         │")
    ВывестиСтрокуВКонсоль("└────────────────────────────────────────────────────────────────────────────────┘")
    СброситьЦветКонсоли()
    
    Попытка
        результат = ТестQtLocalSocketFull()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка в тесте QtЛокальныйСокет: " + e)
    КонецПопытки;
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    // ========== ИТОГ ==========
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

