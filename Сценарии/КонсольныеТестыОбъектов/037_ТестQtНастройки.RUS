//
//№    Английский метод    Русский метод    Статус
//1    Создание объекта    Создание объекта    ✅
//2    isValid()    Действителен()    ✅
//3    Информационные методы    Информационные методы    ✅
//4    setValue()/value()    УстановитьЗначение()/Значение()    ✅
//5    contains()/remove()    Содержит()/Удалить()    ✅
//6    Работа с группами    Работа с группами    ✅
//7    sync()/clear()    Синхронизировать()/Очистить()    ✅
//8    Форматы и области    Форматы и области    ✅
//9    copyTo()    КопироватьВ()    ✅
//10    getRealSettings()    ПолучитьНастройки()    ✅


// ============================================================
// ФУНКЦИЯ ДИАГНОСТИКИ МЕТОДОВ QtНастройки
// ============================================================

Функция ДиагностикаМетодовQtSettings()
    ВывестиСтрокуВКонсоль("=== ДИАГНОСТИКА МЕТОДОВ QtНастройки ===")
    
    Попытка
        ВывестиСтрокуВКонсоль("Проверка существования QtНастройки: " + (typeof QtНастройки !== 'undefined'))
    Исключение
        ВывестиСтрокуВКонсоль("ОШИБКА при проверке QtНастройки: " + e)
    КонецПопытки;
    
    Попытка
        диагНастройки = Новый QtНастройки()
        Если диагНастройки == null Тогда
            ВывестиСтрокуВКонсоль("✗ ОШИБКА: QtНастройки не создан")
            Возврат
        КонецЕсли;
        
        диагНастройки.РежимОтладки(ИСТИНА)
        ВывестиСтрокуВКонсоль("✓ QtНастройки создан")
        
        // Проверка английских методов
        ВывестиСтрокуВКонсоль("Английские методы (должны работать):")
        англМетоды = [
            "isValid", "getRealSettings", 
            "organizationName", "applicationName", "fileName", "scope", "isWritable",
            "setValue", "value", "stringValue", "intValue", "boolValue",
            "stringListValue", "sizeValue", "pointValue", "rectValue",
            "contains", "remove", "clear", "sync",
            "beginGroup", "endGroup", "childKeys", "childGroups", "allKeys",
            "iniFormat", "nativeFormat", "userScope", "systemScope",
            "copyTo", "setDebug", "getDebug"
        ]
        
        рабочиеАнгл = 0
        Для i = 0 По англМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНастройки[англМетоды[i]] === 'function' Тогда
                    рабочиеАнгл = рабочиеАнгл + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + англМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + англМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеАнгл + " из " + англМетоды.length + " английских методов доступно")
        
        // Проверка русских методов
        ВывестиСтрокуВКонсоль("Русские методы (должны создаваться через RusFunc):")
        русМетоды = [
            "Действителен", "ПолучитьНастройки",
            "ИмяОрганизации", "ИмяПриложения", "ИмяФайла", "Область", "ДоступнаЗапись",
            "УстановитьЗначение", "Значение", "ЗначениеСтрока", "ЗначениеЦелое", "ЗначениеЛогическое",
            "ЗначениеСписокСтрок", "ЗначениеРазмер", "ЗначениеТочка", "ЗначениеПрямоугольник",
            "Содержит", "Удалить", "Очистить", "Синхронизировать",
            "НачатьГруппу", "ЗакончитьГруппу", "ДочерниеКлючи", "ДочерниеГруппы", "ВсеКлючи",
            "ФорматINI", "ФорматNative", "ОбластьПользователя", "ОбластьСистемы",
            "КопироватьВ", "РежимОтладки", "ПолучитьРежимОтладки"
        ]
        
        рабочиеРус = 0
        Для i = 0 По русМетоды.length - 1 Цикл
            Попытка
                Если typeof диагНастройки[русМетоды[i]] === 'function' Тогда
                    рабочиеРус = рабочиеРус + 1
                    ВывестиСтрокуВКонсоль("  ✓ " + русМетоды[i])
                Иначе
                    ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (НЕ ДОСТУПЕН)")
                КонецЕсли;
            Исключение
                ВывестиСтрокуВКонсоль("  ✗ " + русМетоды[i] + " (ОШИБКА: " + e + ")")
            КонецПопытки;
        КонецЦикла;
        ВывестиСтрокуВКонсоль("  Итого: " + рабочиеРус + " из " + русМетоды.length + " русских методов доступно")
        
        // Проверка RusFunc
        Попытка
            Если typeof диагНастройки.RusFunc === 'function' Тогда
                ВывестиСтрокуВКонсоль("✓ Метод RusFunc() существует")
                Попытка
                    jsonStr = диагНастройки.RusFunc()
                    ВывестиСтрокуВКонсоль("✓ RusFunc() вызван, длина JSON: " + jsonStr.length)
                    карта = JSON.parse(jsonStr)
                    ВывестиСтрокуВКонсоль("✓ JSON успешно распарсен, элементов: " + карта.length)
                Исключение
                    ВывестиСтрокуВКонсоль("✗ Ошибка при вызове RusFunc(): " + e)
                КонецПопытки;
            Иначе
                ВывестиСтрокуВКонсоль("✗ Метод RusFunc() НЕ СУЩЕСТВУЕТ")
            КонецЕсли;
        Исключение
            ВывестиСтрокуВКонсоль("✗ Ошибка при проверке RusFunc(): " + e)
        КонецПопытки;
        
    Исключение
        ВывестиСтрокуВКонсоль("✗ ОШИБКА при диагностике QtНастройки: " + e)
    КонецПопытки;
    
    ВывестиСтрокуВКонсоль("=== КОНЕЦ ДИАГНОСТИКИ ===")
    ВывестиСтрокуВКонсоль("")
КонецФункции

// ============================================================
// ФУНКЦИЯ ТЕСТИРОВАНИЯ QtНастройки
// ============================================================

Функция ТестQtSettings()
    всегоТестов = 0
    успешноАнгл = 0
    успешноРус = 0
    неуспешноАнгл = 0
    неуспешноРус = 0
    
    // Массивы для хранения результатов тестов
    англРезультаты = []
    русРезультаты = []
    
    // ===== 1. ТЕСТ: СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание объекта")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    настройки = null
    Попытка
        настройки = Новый QtНастройки()
        настройки.РежимОтладки(ИСТИНА)
        Если настройки != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект QtНастройки создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ИСТИНА
            русРезультаты[русРезультаты.length] = ИСТИНА
            успешноАнгл = успешноАнгл + 1
            успешноРус = успешноРус + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект НЕ создан")
            СброситьЦветКонсоли()
            англРезультаты[англРезультаты.length] = ЛОЖЬ
            русРезультаты[русРезультаты.length] = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
            неуспешноРус = неуспешноРус + 1
            Возврат "❌ Тест провален (объект не создан)"
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка создания: " + e)
        СброситьЦветКонсоли()
        англРезультаты[англРезультаты.length] = ЛОЖЬ
        русРезультаты[русРезультаты.length] = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
        неуспешноРус = неуспешноРус + 1
        Возврат "❌ Тест провален (ошибка создания)"
    КонецПопытки;
    
    // ===== 2. ТЕСТ: isValid() / Действителен() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Проверка валидности")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        валидный = настройки.isValid()
        Если валидный == ИСТИНА Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] isValid() = true")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] isValid() = false (ожидается true)")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            валидныйРус = настройки.Действителен()
            Если валидныйРус == ИСТИНА Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] Действителен() = true")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] Действителен() = false (ожидается true)")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 3. ТЕСТ: ИНФОРМАЦИОННЫЕ МЕТОДЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Информационные методы")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        орг = настройки.organizationName()
        прил = настройки.applicationName()
        файл = настройки.fileName()
        обл = настройки.scope()
        доступ = настройки.isWritable()
        
        ВывестиСтрокуВКонсоль("    [ENG] organizationName() = " + орг)
        ВывестиСтрокуВКонсоль("    [ENG] applicationName() = " + прил)
        ВывестиСтрокуВКонсоль("    [ENG] fileName() = " + файл)
        ВывестиСтрокуВКонсоль("    [ENG] scope() = " + обл)
        ВывестиСтрокуВКонсоль("    [ENG] isWritable() = " + доступ)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ [ENG] Информационные методы работают")
        СброситьЦветКонсоли()
        англУспех = ИСТИНА
        успешноАнгл = успешноАнгл + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            оргРус = настройки.ИмяОрганизации()
            прилРус = настройки.ИмяПриложения()
            файлРус = настройки.ИмяФайла()
            облРус = настройки.Область()
            доступРус = настройки.ДоступнаЗапись()
            
            ВывестиСтрокуВКонсоль("    [RUS] ИмяОрганизации() = " + оргРус)
            ВывестиСтрокуВКонсоль("    [RUS] ИмяПриложения() = " + прилРус)
            ВывестиСтрокуВКонсоль("    [RUS] ИмяФайла() = " + файлРус)
            ВывестиСтрокуВКонсоль("    [RUS] Область() = " + облРус)
            ВывестиСтрокуВКонсоль("    [RUS] ДоступнаЗапись() = " + доступРус)
            
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [RUS] Информационные методы работают")
            СброситьЦветКонсоли()
            русУспех = ИСТИНА
            успешноРус = успешноРус + 1
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 4. ТЕСТ: setValue() / value() / УстановитьЗначение() / Значение() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Установка и чтение значений")
    СброситьЦветКонсоли()
    
    тестПройден = ИСТИНА
    тестРусский = ИСТИНА
    англУспех = ЛОЖЬ
    русУспех = ЛОЖЬ
    
    // Английский метод
    Попытка
        настройки.setValue("test/string", "Hello World")
        настройки.setValue("test/int", 42)
        настройки.setValue("test/bool", true)
        
        стр = настройки.stringValue("test/string", "")
        число = настройки.intValue("test/int", 0)
        бул = настройки.boolValue("test/bool", false)
        
        ВывестиСтрокуВКонсоль("    [ENG] stringValue = " + стр + " (ожидается Hello World)")
        ВывестиСтрокуВКонсоль("    [ENG] intValue = " + число + " (ожидается 42)")
        ВывестиСтрокуВКонсоль("    [ENG] boolValue = " + бул + " (ожидается true)")
        
        Если стр == "Hello World" И число == 42 И бул == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ [ENG] setValue()/value() работают корректно")
            СброситьЦветКонсоли()
            англУспех = ИСТИНА
            успешноАнгл = успешноАнгл + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [ENG] setValue()/value() ошибка")
            СброситьЦветКонсоли()
            тестПройден = ЛОЖЬ
            неуспешноАнгл = неуспешноАнгл + 1
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ [ENG] Ошибка: " + e)
        СброситьЦветКонсоли()
        тестПройден = ЛОЖЬ
        неуспешноАнгл = неуспешноАнгл + 1
    КонецПопытки;
    
    // Русский метод
    Если тестПройден Тогда
        Попытка
            настройки.УстановитьЗначение("test/string_ru", "Привет Мир")
            настройки.УстановитьЗначение("test/int_ru", 100)
            настройки.УстановитьЗначение("test/bool_ru", false)
            
            стрРус = настройки.ЗначениеСтрока("test/string_ru", "")
            числоРус = настройки.ЗначениеЦелое("test/int_ru", 0)
            булРус = настройки.ЗначениеЛогическое("test/bool_ru", true)
            
            ВывестиСтрокуВКонсоль("    [RUS] ЗначениеСтрока = " + стрРус + " (ожидается Привет Мир)")
            ВывестиСтрокуВКонсоль("    [RUS] ЗначениеЦелое = " + числоРус + " (ожидается 100)")
            ВывестиСтрокуВКонсоль("    [RUS] ЗначениеЛогическое = " + булРус + " (ожидается false)")
            
            Если стрРус == "Привет Мир" И числоРус == 100 И булРус == false Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ [RUS] УстановитьЗначение()/Значение() работают корректно")
                СброситьЦветКонсоли()
                русУспех = ИСТИНА
                успешноРус = успешноРус + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ [RUS] УстановитьЗначение()/Значение() ошибка")
                СброситьЦветКонсоли()
                тестРусский = ЛОЖЬ
                неуспешноРус = неуспешноРус + 1
            КонецЕсли;
        Исключение
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ [RUS] Ошибка: " + e)
            СброситьЦветКонсоли()
            тестРусский = ЛОЖЬ
            неуспешноРус = неуспешноРус + 1
        КонецПопытки;
    Иначе
        ВывестиСтрокуВКонсоль("    ⚠️ [RUS] Пропущен (ошибка в английском тесте)")
    КонецЕсли;
    
    англРезультаты[англРезультаты.length] = англУспех
    русРезультаты[русРезультаты.length] = русУспех
    
    // ===== 5. ТЕСТ: contains() / remove() / Содержит() / Удалить() =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
