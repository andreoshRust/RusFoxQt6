//Итоговый результат тестирования QTcpSocket (Сокет):
//№    Тест    Статус
//1    Создание CPPObject    ✅
//2    Создание QTcpSocket через CPPObject    ✅
//3    Проверка имени класса    ✅
//4    Проверка валидности    ✅
//5    Получение реального объекта    ✅
//6    Проверка методов состояния    ✅
//7    Установка хоста и порта    ✅
//8    Проверка методов таймаута    ✅
//9    Проверка буферизации    ✅
//10    Проверка адресов    ✅
//11    Проверка чтения/записи    ✅
//12    Проверка строки ошибки    ✅
//13    Включение отладки    ✅
//14    Повторное создание объекта    ✅
//15    Создание нового объекта    ✅
//16    Проверка отключения    ✅
//17    Проверка паузы    ✅
//18    Проверка протокола    ✅
//✅ Тест QTcpSocket: 18 из 18 пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)
//
//Результаты тестирования методов QTcpSocket:
//Метод    Результат
//state()    ✅ Выполнен (возвращает состояние)
//openMode()    ✅ Выполнен
//error()    ✅ Выполнен
//connectToHost("localhost", 9999)    ✅ Выполнен
//peerName()    ✅ Выполнен
//peerPort()    ✅ Выполнен
//setSocketOption()    ✅ Выполнен
//socketOption()    ✅ Выполнен
//bytesAvailable()    ✅ Выполнен
//bytesToWrite()    ✅ Выполнен
//localAddress()    ✅ Выполнен
//localPort()    ✅ Выполнен
//peerAddress()    ✅ Выполнен
//write()    ✅ Выполнен
//readAll()    ✅ Выполнен
//errorString()    ✅ Выполнен
//disconnectFromHost()    ✅ Выполнен
//pauseMode()    ✅ Выполнен
//setPauseMode()    ✅ Выполнен
//protocol()    ✅ Выполнен
//Основные методы QTcpSocket:
//Категория    Методы
//Состояние    state(), openMode(), error(), errorString()
//Подключение    connectToHost(), disconnectFromHost()
//Адреса    localAddress(), localPort(), peerAddress(), peerPort(), peerName()
//Чтение/Запись    read(), readAll(), write(), bytesAvailable(), bytesToWrite()
//Настройки    setSocketOption(), socketOption(), setPauseMode(), pauseMode()
//Протокол    protocol()
//Особенности QTcpSocket:
//TCP-соединение - установка и разрыв соединения
//
//Асинхронность - работа в асинхронном режиме с сигналами
//
//Буферизация - чтение и запись с буферизацией
//
//Адресация - получение локальных и удаленных адресов
//
//Настройки - управление опциями сокета
//
//Обработка ошибок - получение информации об ошибках

// ============================================================
// ТЕСТ QTcpSocket (Сокет) через CPPObject
// ============================================================

Функция ТестQTcpSocket()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ QTcpSocket (Сокет) через CPPObject ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    тестХост = "localhost"
    тестПорт = 9999
    тестХост2 = "127.0.0.1"
    тестПорт2 = 12345
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА CPPObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QTcpSocket =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QTcpSocket через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QTcpSocket")
        ВывестиСтрокуВКонсоль("    Создать('QTcpSocket'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QTcpSocket создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QTcpSocket НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QTcpSocket" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное (ожидается QTcpSocket)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реальныйОбъект = об.УстановленОбъект()
        ВывестиСтрокуВКонсоль("    УстановленОбъект(): " + (реальныйОбъект != null ? "успешно" : "неудачно"))
        
        Если реальныйОбъект != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Реальный объект получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Реальный объект не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПРОВЕРКА МЕТОДОВ СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка методов состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = об.ВызватьМетод("state")
        ВывестиСтрокуВКонсоль("    state(): " + состояние)
        
        режим = об.ВызватьМетод("openMode")
        ВывестиСтрокуВКонсоль("    openMode(): " + режим)
        
        ошибка = об.ВызватьМетод("error")
        ВывестиСтрокуВКонсоль("    error(): " + ошибка)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Методы состояния работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. УСТАНОВКА ХОСТА И ПОРТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Установка хоста и порта")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("connectToHost", тестХост, тестПорт)
        ВывестиСтрокуВКонсоль("    connectToHost('" + тестХост + "', " + тестПорт + ") вызван")
        
        хост = об.ВызватьМетод("peerName")
        порт = об.ВызватьМетод("peerPort")
        ВывестиСтрокуВКонсоль("    peerName(): " + хост + ", peerPort(): " + порт)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Установка хоста и порта работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА МЕТОДОВ ТАЙМАУТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка методов таймаута")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("setSocketOption", 0, 5000) // QAbstractSocket::KeepAliveOption
        об.ВызватьМетод("setSocketOption", 1, 3000) // QAbstractSocket::SendBufferSizeSocketOption
        
        таймаут = об.ВызватьМетод("socketOption", 0)
        ВывестиСтрокуВКонсоль("    socketOption(KeepAlive): " + таймаут)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Методы таймаута работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА БУФЕРИЗАЦИИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка буферизации")
    СброситьЦветКонсоли()
    
    Попытка
        доступно = об.ВызватьМетод("bytesAvailable")
        ВывестиСтрокуВКонсоль("    bytesAvailable(): " + доступно)
        
        ожидает = об.ВызватьМетод("bytesToWrite")
        ВывестиСтрокуВКонсоль("    bytesToWrite(): " + ожидает)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Буферизация работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА АДРЕСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка адресов")
    СброситьЦветКонсоли()
    
    Попытка
        локальныйАдрес = об.ВызватьМетод("localAddress")
        локальныйПорт = об.ВызватьМетод("localPort")
        ВывестиСтрокуВКонсоль("    localAddress(): " + локальныйАдрес + ", localPort(): " + локальныйПорт)
        
        удаленныйАдрес = об.ВызватьМетод("peerAddress")
        удаленныйПорт = об.ВызватьМетод("peerPort")
        ВывестиСтрокуВКонсоль("    peerAddress(): " + удаленныйАдрес + ", peerPort(): " + удаленныйПорт)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Адреса работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА ЧТЕНИЯ/ЗАПИСИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка чтения/записи")
    СброситьЦветКонсоли()
    
    Попытка
        // Записываем данные
        записано = об.ВызватьМетод("write", "Test data")
        ВывестиСтрокуВКонсоль("    write('Test data'): " + записано)
        
        // Проверяем наличие данных для чтения
        доступно2 = об.ВызватьМетод("bytesAvailable")
        ВывестиСтрокуВКонсоль("    bytesAvailable(): " + доступно2)
        
        // Читаем данные
        прочитано = об.ВызватьМетод("readAll")
        ВывестиСтрокуВКонсоль("    readAll(): " + прочитано)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Чтение/запись работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА СТРОКИ ОШИБКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка строки ошибки")
    СброситьЦветКонсоли()
    
    Попытка
        ошибкаСтр = об.ВызватьМетод("errorString")
        ВывестиСтрокуВКонсоль("    errorString(): " + ошибкаСтр)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Строка ошибки работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ОТЛАДКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Включение отладки")
    СброситьЦветКонсоли()
    
    Попытка
        об.РежимОтладки(ИСТИНА)
        отладка = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ИСТИНА): " + отладка)
        
        об.РежимОтладки(ЛОЖЬ)
        отладка2 = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ЛОЖЬ): " + отладка2)
        
        Если отладка == ИСТИНА И отладка2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отладка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отладка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

// ===== 14. ПОВТОРНОЕ СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Повторное создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = об.Создать("QTcpSocket")  // <-- исправлено: resultado2 -> результат2
        имяКласса2 = об.ИмяКласса()
        валиден2 = об.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создать('QTcpSocket'): " + результат2)
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса2)
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден2)
        
        Если результат2 == true И имяКласса2 == "QTcpSocket" И валиден2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторное создание работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторное создание не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 15. СОЗДАНИЕ НОВОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Создание нового объекта")
    СброситьЦветКонсоли()
    
    Попытка
        об2 = НовыйОбъект("CPPОбъект")
        Если об2 != null Тогда
            об2.Создать("QTcpSocket")
            имяКласса3 = об2.ИмяКласса()
            ВывестиСтрокуВКонсоль("    Новый объект создан, класс: " + имяКласса3)
            
            Если имяКласса3 == "QTcpSocket" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание нового объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Новый объект не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось создать новый объект")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 16. ПРОВЕРКА АВТОМАТИЧЕСКОГО ОТКЛЮЧЕНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Проверка отключения")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("disconnectFromHost")
        ВывестиСтрокуВКонсоль("    disconnectFromHost() вызван")
        
        состояние2 = об.ВызватьМетод("state")
        ВывестиСтрокуВКонсоль("    state() после отключения: " + состояние2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Отключение работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 17. ПРОВЕРКА ПАУЗЫ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 17: Проверка паузы")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("pauseMode")
        ВывестиСтрокуВКонсоль("    pauseMode(): " + об.ВызватьМетод("pauseMode"))
        
        об.ВызватьМетод("setPauseMode", 1) // QAbstractSocket::PauseOnSslErrors
        ВывестиСтрокуВКонсоль("    setPauseMode() вызван")
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Пауза работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 18. ПРОВЕРКА ПРОТОКОЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 18: Проверка протокола")
    СброситьЦветКонсоли()
    
    Попытка
        протокол = об.ВызватьМетод("protocol")
        ВывестиСтрокуВКонсоль("    protocol(): " + протокол)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Протокол работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QTcpSocket: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QTcpSocket: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QTcpSocket завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТ QTcpSocket (Сокет)                                   ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    Попытка
        результат = ТестQTcpSocket()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


