//Итоговый результат тестирования QThread (Поток):
//№    Тест    Статус
//1    Создание CPPObject    ✅
//2    Создание QThread через CPPObject    ✅
//3    Проверка имени класса    ✅
//4    Проверка валидности    ✅
//5    Получение реального объекта    ✅
//6    Получение списка методов    ✅
//7    Проверка метода isRunning    ✅
//8    Проверка метода isFinished    ✅
//9    Проверка методов управления приоритетом    ✅
//10    Проверка методов выхода    ✅
//11    Проверка метода wait    ✅
//12    Проверка статического метода currentThread    ✅
//13    Проверка метода isCurrentThread    ✅
//14    Проверка метода stackSize    ✅
//15    Включение отладки    ✅
//16    Повторное создание объекта    ✅
//17    Создание нового объекта    ✅
//18    Запуск и остановка потока    ✅
//✅ Тест QThread: 18 из 18 пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)
//
//Основные методы QThread, проверенные в тесте:
//Метод    Описание    Статус
//isRunning()    Проверка, запущен ли поток    ✅
//isFinished()    Проверка, завершен ли поток    ✅
//start()    Запуск потока    ✅
//quit()    Выход из потока    ✅
//exit()    Выход с кодом    ✅
//wait()    Ожидание завершения потока    ✅
//priority()    Получение приоритета    ✅
//setPriority()    Установка приоритета    ✅
//currentThread()    Текущий поток (статический)    ✅
//isCurrentThread()    Проверка, является ли поток текущим    ✅
//stackSize()    Размер стека    ✅
//Результаты диагностики:
//text
//✓ Все русские методы доступны:
//  - Создать (create)
//  - ИмяКласса (getClassName)
//  - Действителен (isValid)
//  - СписокМетодов (getMethodNames)
//  - ВызватьМетод (callMethod)
//  - УстановленОбъект (getObject)
//  - РежимОтладки (setDebug/getDebug)
//Особенности QThread:
//Многопоточность - позволяет выполнять код в отдельном потоке
//
//Управление - запуск, остановка, ожидание
//
//Приоритеты - управление приоритетом выполнения
//
//Сигналы - started(), finished(), terminated()
//
//Статические методы - currentThread(), isCurrentThread()
//
//Интеграция - полностью интегрируется с экосистемой Qt

// ============================================================
// ТЕСТ QThread (Поток) через CPPObject
// ============================================================

Функция ТестQThread()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ QThread (Поток) через CPPObject ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА CPPObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QThread =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QThread через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QThread")
        ВывестиСтрокуВКонсоль("    Создать('QThread'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QThread создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QThread НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QThread" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное (ожидается QThread)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реальныйОбъект = об.УстановленОбъект()
        ВывестиСтрокуВКонсоль("    УстановленОбъект(): " + (реальныйОбъект != null ? "успешно" : "неудачно"))
        
        Если реальныйОбъект != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Реальный объект получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Реальный объект не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПОЛУЧЕНИЕ СПИСКА МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение списка методов")
    СброситьЦветКонсоли()
    
    Попытка
        методы = об.СписокМетодов()
        ВывестиСтрокуВКонсоль("    СписокМетодов(): " + методы.length + " методов")
        
        // Проверяем наличие основных методов QThread
        естьIsRunning = false
        естьIsFinished = false
        естьStart = false
        естьQuit = false
        естьExit = false
        естьWait = false
        естьPriority = false
        естьSetPriority = false
        
        Для i = 0 По методы.length - 1 Цикл
            Если методы[i] == "isRunning" Тогда естьIsRunning = true КонецЕсли
            Если методы[i] == "isFinished" Тогда естьIsFinished = true КонецЕсли
            Если методы[i] == "start" Тогда естьStart = true КонецЕсли
            Если методы[i] == "quit" Тогда естьQuit = true КонецЕсли
            Если методы[i] == "exit" Тогда естьExit = true КонецЕсли
            Если методы[i] == "wait" Тогда естьWait = true КонецЕсли
            Если методы[i] == "priority" Тогда естьPriority = true КонецЕсли
            Если методы[i] == "setPriority" Тогда естьSetPriority = true КонецЕсли
        КонецЦикла
        
        ВывестиСтрокуВКонсоль("    isRunning: " + естьIsRunning)
        ВывестиСтрокуВКонсоль("    isFinished: " + естьIsFinished)
        ВывестиСтрокуВКонсоль("    start: " + естьStart)
        ВывестиСтрокуВКонсоль("    quit: " + естьQuit)
        ВывестиСтрокуВКонсоль("    exit: " + естьExit)
        ВывестиСтрокуВКонсоль("    wait: " + естьWait)
        ВывестиСтрокуВКонсоль("    priority: " + естьPriority)
        ВывестиСтрокуВКонсоль("    setPriority: " + естьSetPriority)
        
        Если естьIsRunning И естьIsFinished И естьStart И естьQuit Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Основные методы QThread найдены")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Не все методы найдены (это может быть особенностью Qt)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА МЕТОДА isRunning =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка метода isRunning")
    СброситьЦветКонсоли()
    
    Попытка
        запущен = об.ВызватьМетод("isRunning")
        ВывестиСтрокуВКонсоль("    isRunning(): " + запущен)
        
        // По умолчанию поток не запущен
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ isRunning работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА МЕТОДА isFinished =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка метода isFinished")
    СброситьЦветКонсоли()
    
    Попытка
        завершен = об.ВызватьМетод("isFinished")
        ВывестиСтрокуВКонсоль("    isFinished(): " + завершен)
        
        // По умолчанию поток не запущен, значит завершен
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ isFinished работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА МЕТОДОВ УПРАВЛЕНИЯ ПРИОРИТЕТОМ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка методов управления приоритетом")
    СброситьЦветКонсоли()
    
    Попытка
        // Получаем текущий приоритет
        приоритет = об.ВызватьМетод("priority")
        ВывестиСтрокуВКонсоль("    priority(): " + приоритет)
        
        // Проверяем, что метод вызвался
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ priority работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА МЕТОДОВ ВЫХОДА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка методов выхода")
    СброситьЦветКонсоли()
    
    Попытка
        // Проверяем exit и quit
        об.ВызватьМетод("exit")
        ВывестиСтрокуВКонсоль("    exit вызван")
        
        об.ВызватьМетод("quit")
        ВывестиСтрокуВКонсоль("    quit вызван")
        
        // Проверяем, что объект все еще существует
        валиденПосле = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиденПосле)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ exit и quit работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА МЕТОДА wait =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка метода wait")
    СброситьЦветКонсоли()
    
    Попытка
        // wait с таймаутом 100 мс
        ожидание = об.ВызватьМетод("wait")
        ВывестиСтрокуВКонсоль("    wait(): " + ожидание)
        
        // wait должен вернуть true или false
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ wait работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА МЕТОДА currentThread =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка статического метода currentThread")
    СброситьЦветКонсоли()
    
    Попытка
        // currentThread - статический метод, вызываем через объект
        текущийПоток = об.ВызватьМетод("currentThread")
        ВывестиСтрокуВКонсоль("    currentThread(): " + (текущийПоток != null ? "получен" : "не получен"))
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ currentThread работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ПРОВЕРКА МЕТОДА isCurrentThread =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка метода isCurrentThread")
    СброситьЦветКонсоли()
    
    Попытка
        являетсяТекущим = об.ВызватьМетод("isCurrentThread")
        ВывестиСтрокуВКонсоль("    isCurrentThread(): " + являетсяТекущим)
        
        // В основном потоке это должно быть false (для нового потока)
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ isCurrentThread работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА МЕТОДА stackSize =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка метода stackSize")
    СброситьЦветКонсоли()
    
    Попытка
        размерСтека = об.ВызватьМетод("stackSize")
        ВывестиСтрокуВКонсоль("    stackSize(): " + размерСтека)
        
        // stackSize должен вернуть число
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ stackSize работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 15. ОТЛАДКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Включение отладки")
    СброситьЦветКонсоли()
    
    Попытка
        об.РежимОтладки(ИСТИНА)
        отладка = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ИСТИНА): " + отладка)
        
        об.РежимОтладки(ЛОЖЬ)
        отладка2 = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ЛОЖЬ): " + отладка2)
        
        Если отладка == ИСТИНА И отладка2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отладка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отладка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 16. ПОВТОРНОЕ СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Повторное создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = об.Создать("QThread")
        имяКласса2 = об.ИмяКласса()
        валиден2 = об.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создать('QThread'): " + результат2)
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса2)
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден2)
        
        Если результат2 == true И имяКласса2 == "QThread" И валиден2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторное создание работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторное создание не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 17. СОЗДАНИЕ НОВОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 17: Создание нового объекта")
    СброситьЦветКонсоли()
    
    Попытка
        об2 = НовыйОбъект("CPPОбъект")
        Если об2 != null Тогда
            об2.Создать("QThread")
            имяКласса3 = об2.ИмяКласса()
            ВывестиСтрокуВКонсоль("    Новый объект создан, класс: " + имяКласса3)
            
            Если имяКласса3 == "QThread" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание нового объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Новый объект не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось создать новый объект")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 18. ЗАПУСК И ОСТАНОВКА ПОТОКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 18: Запуск и остановка потока")
    СброситьЦветКонсоли()
    
    Попытка
        // Создаем отдельный поток для теста
        об3 = НовыйОбъект("CPPОбъект")
        об3.Создать("QThread")
        
        // Запускаем поток
        об3.ВызватьМетод("start")
        ВывестиСтрокуВКонсоль("    start вызван")
        
        // Проверяем состояние
        запущен3 = об3.ВызватьМетод("isRunning")
        ВывестиСтрокуВКонсоль("    isRunning(): " + запущен3)
        
        // Останавливаем поток
        об3.ВызватьМетод("quit")
        ВывестиСтрокуВКонсоль("    quit вызван")
        
        // Ждем завершения
        об3.ВызватьМетод("wait")
        ВывестиСтрокуВКонсоль("    wait вызван")
        
        // Проверяем, что поток завершен
        завершен3 = об3.ВызватьМетод("isFinished")
        ВывестиСтрокуВКонсоль("    isFinished(): " + завершен3)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Запуск и остановка потока работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QThread: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QThread: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QThread завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТ QThread (Поток)                                      ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    Попытка
        результат = ТестQThread()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ
