// ============================================================
// ТЕСТ QUdpSocket (UDP Сокет) через CPPObject
// ============================================================

Функция ТестQUdpSocket()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ QUdpSocket (UDP Сокет) через CPPObject ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    тестХост = "localhost"
    тестПорт = 9999
    тестПорт2 = 9998
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА CPPObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QUdpSocket =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QUdpSocket через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QUdpSocket")
        ВывестиСтрокуВКонсоль("    Создать('QUdpSocket'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QUdpSocket создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QUdpSocket НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QUdpSocket" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное (ожидается QUdpSocket)")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реальныйОбъект = об.УстановленОбъект()
        ВывестиСтрокуВКонсоль("    УстановленОбъект(): " + (реальныйОбъект != null ? "успешно" : "неудачно"))
        
        Если реальныйОбъект != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Реальный объект получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Реальный объект не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПРОВЕРКА МЕТОДОВ СОСТОЯНИЯ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Проверка методов состояния")
    СброситьЦветКонсоли()
    
    Попытка
        состояние = об.ВызватьМетод("state")
        ВывестиСтрокуВКонсоль("    state(): " + состояние)
        
        режим = об.ВызватьМетод("openMode")
        ВывестиСтрокуВКонсоль("    openMode(): " + режим)
        
        ошибка = об.ВызватьМетод("error")
        ВывестиСтрокуВКонсоль("    error(): " + ошибка)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Методы состояния работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРИВЯЗКА К ПОРТУ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Привязка к порту")
    СброситьЦветКонсоли()
    
    Попытка
        привязан = об.ВызватьМетод("bind", тестПорт)
        ВывестиСтрокуВКонсоль("    bind(" + тестПорт + "): " + привязан)
        
        локальныйПорт = об.ВызватьМетод("localPort")
        ВывестиСтрокуВКонсоль("    localPort(): " + локальныйПорт)
        
        Если привязан == true И локальныйПорт == тестПорт Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Привязка к порту работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Привязка к порту не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ОТПРАВКА ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Отправка данных")
    СброситьЦветКонсоли()
    
    Попытка
        тестДанные = "Hello UDP!"
        отправлено = об.ВызватьМетод("writeDatagram", тестДанные, тестХост, тестПорт2)
        ВывестиСтрокуВКонсоль("    writeDatagram('" + тестДанные + "', '" + тестХост + "', " + тестПорт2 + "): " + отправлено)
        
        Если отправлено > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отправка данных работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отправка данных не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПОЛУЧЕНИЕ ДАННЫХ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Получение данных")
    СброситьЦветКонсоли()
    
    Попытка
        доступно = об.ВызватьМетод("pendingDatagramSize")
        ВывестиСтрокуВКонсоль("    pendingDatagramSize(): " + доступно)
        
        Если доступно > 0 Тогда
            данные = об.ВызватьМетод("readDatagram", доступно)
            ВывестиСтрокуВКонсоль("    readDatagram(): " + данные)
        Иначе
            ВывестиСтрокуВКонсоль("    ⚠️ Нет данных для чтения (это нормально для UDP)")
        КонецЕсли
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Получение данных работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПРОВЕРКА АДРЕСОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Проверка адресов")
    СброситьЦветКонсоли()
    
    Попытка
        локальныйАдрес = об.ВызватьМетод("localAddress")
        локальныйПорт2 = об.ВызватьМетод("localPort")
        ВывестиСтрокуВКонсоль("    localAddress(): " + локальныйАдрес + ", localPort(): " + локальныйПорт2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Адреса работают")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ПРОВЕРКА БУФЕРИЗАЦИИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Проверка буферизации")
    СброситьЦветКонсоли()
    
    Попытка
        доступно2 = об.ВызватьМетод("bytesAvailable")
        ВывестиСтрокуВКонсоль("    bytesAvailable(): " + доступно2)
        
        ожидает = об.ВызватьМетод("bytesToWrite")
        ВывестиСтрокуВКонсоль("    bytesToWrite(): " + ожидает)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Буферизация работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. ПРОВЕРКА ТАЙМАУТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Проверка таймаута")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("setSocketOption", 0, 5000) // QAbstractSocket::KeepAliveOption
        таймаут = об.ВызватьМетод("socketOption", 0)
        ВывестиСтрокуВКонсоль("    socketOption(KeepAlive): " + таймаут)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Таймаут работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 13. ПРОВЕРКА МНОГОАДРЕСНОЙ РАССЫЛКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 13: Проверка многоадресной рассылки")
    СброситьЦветКонсоли()
    
    Попытка
        группа = "224.0.0.1"
        об.ВызватьМетод("joinMulticastGroup", группа)
        ВывестиСтрокуВКонсоль("    joinMulticastGroup('" + группа + "') вызван")
        
        об.ВызватьМетод("leaveMulticastGroup", группа)
        ВывестиСтрокуВКонсоль("    leaveMulticastGroup('" + группа + "') вызван")
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Многоадресная рассылка работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 14. ПРОВЕРКА СТРОКИ ОШИБКИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 14: Проверка строки ошибки")
    СброситьЦветКонсоли()
    
    Попытка
        ошибкаСтр = об.ВызватьМетод("errorString")
        ВывестиСтрокуВКонсоль("    errorString(): " + ошибкаСтр)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Строка ошибки работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 15. ОТЛАДКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 15: Включение отладки")
    СброситьЦветКонсоли()
    
    Попытка
        об.РежимОтладки(ИСТИНА)
        отладка = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ИСТИНА): " + отладка)
        
        об.РежимОтладки(ЛОЖЬ)
        отладка2 = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ЛОЖЬ): " + отладка2)
        
        Если отладка == ИСТИНА И отладка2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отладка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отладка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 16. ПОВТОРНОЕ СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 16: Повторное создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = об.Создать("QUdpSocket")
        имяКласса2 = об.ИмяКласса()
        валиден2 = об.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создать('QUdpSocket'): " + результат2)
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса2)
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден2)
        
        Если результат2 == true И имяКласса2 == "QUdpSocket" И валиден2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторное создание работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторное создание не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 17. СОЗДАНИЕ НОВОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 17: Создание нового объекта")
    СброситьЦветКонсоли()
    
    Попытка
        об2 = НовыйОбъект("CPPОбъект")
        Если об2 != null Тогда
            об2.Создать("QUdpSocket")
            имяКласса3 = об2.ИмяКласса()
            ВывестиСтрокуВКонсоль("    Новый объект создан, класс: " + имяКласса3)
            
            Если имяКласса3 == "QUdpSocket" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание нового объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Новый объект не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось создать новый объект")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 18. ЗАКРЫТИЕ СОКЕТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 18: Закрытие сокета")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("close")
        ВывестиСтрокуВКонсоль("    close() вызван")
        
        состояние2 = об.ВызватьМетод("state")
        ВывестиСтрокуВКонсоль("    state() после закрытия: " + состояние2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Закрытие сокета работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 19. ПРОВЕРКА ПРОТОКОЛА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 19: Проверка протокола")
    СброситьЦветКонсоли()
    
    Попытка
        протокол = об.ВызватьМетод("protocol")
        ВывестиСтрокуВКонсоль("    protocol(): " + протокол)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Протокол работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 20. ПРОВЕРКА РАЗМЕРА БУФЕРА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 20: Проверка размера буфера")
    СброситьЦветКонсоли()
    
    Попытка
        размерБуфера = об.ВызватьМетод("readBufferSize")
        ВывестиСтрокуВКонсоль("    readBufferSize(): " + размерБуфера)
        
        об.ВызватьМетод("setReadBufferSize", 65536)
        размерБуфера2 = об.ВызватьМетод("readBufferSize")
        ВывестиСтрокуВКонсоль("    setReadBufferSize(65536) -> readBufferSize(): " + размерБуфера2)
        
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ Размер буфера работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест QUdpSocket: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест QUdpSocket: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест QUdpSocket завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТ QUdpSocket (UDP Сокет)                              ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    Попытка
        результат = ТестQUdpSocket()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ

