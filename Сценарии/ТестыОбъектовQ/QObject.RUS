// ============================================================
// ТЕСТ CPPObject (Универсальная обертка) - ИСПРАВЛЕННЫЙ
// ============================================================

Функция ТестCPPObject()
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("=== ТЕСТ CPPObject (Универсальная обертка) ===")
    СброситьЦветКонсоли()
    
    всегоТестов = 0
    успешноТестов = 0
    
    // ===== 1. СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 1: Создание CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        об = НовыйОбъект("CPPОбъект")
        об.РежимОтладки(ИСТИНА)
        Если об != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ CPPObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ CPPObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли;
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки;
    
    Если об == null Тогда
        Возврат "❌ Тест прерван"
    КонецЕсли;

    // ===== 2. СОЗДАНИЕ QObject =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 2: Создание QObject через CPPObject")
    СброситьЦветКонсоли()
    
    Попытка
        результат = об.Создать("QObject")
        ВывестиСтрокуВКонсоль("    Создать('QObject'): " + результат)
        
        Если результат == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ QObject создан")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ QObject НЕ создан")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 3. ПРОВЕРКА ИМЕНИ КЛАССА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 3: Проверка имени класса")
    СброситьЦветКонсоли()
    
    Попытка
        имяКласса = об.ИмяКласса()
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса)
        
        Если имяКласса == "QObject" Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Имя класса верное")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Имя класса неверное")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 4. ПРОВЕРКА ВАЛИДНОСТИ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 4: Проверка валидности")
    СброситьЦветКонсоли()
    
    Попытка
        валиден = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден)
        
        Если валиден == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Объект валиден")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Объект невалиден")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 5. ПОЛУЧЕНИЕ РЕАЛЬНОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 5: Получение реального объекта")
    СброситьЦветКонсоли()
    
    Попытка
        реальныйОбъект = об.УстановленОбъект()
        ВывестиСтрокуВКонсоль("    УстановленОбъект(): " + (реальныйОбъект != null ? "успешно" : "неудачно"))
        
        Если реальныйОбъект != null Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Реальный объект получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Реальный объект не получен")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 6. ПОЛУЧЕНИЕ СПИСКА МЕТОДОВ =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 6: Получение списка методов")
    СброситьЦветКонсоли()
    
    Попытка
        методы = об.СписокМетодов()
        ВывестиСтрокуВКонсоль("    СписокМетодов(): " + методы.length + " методов")
        
        Если методы.length > 0 Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Список методов получен")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("yellow")
            ВывестиСтрокуВКонсоль("    ⚠️ Список методов пуст (это может быть особенностью Qt)")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 7. ПРОВЕРКА МЕТОДА objectName =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 7: Проверка метода objectName")
    СброситьЦветКонсоли()
    
    Попытка
        имя = об.ВызватьМетод("objectName")
        ВывестиСтрокуВКонсоль("    objectName(): " + имя)
        
        // objectName может вернуть пустую строку или undefined
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ objectName работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 8. ПРОВЕРКА МЕТОДА parent =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 8: Проверка метода parent")
    СброситьЦветКонсоли()
    
    Попытка
        родитель = об.ВызватьМетод("parent")
        ВывестиСтрокуВКонсоль("    parent(): " + (родитель != null ? "есть родитель" : "нет родителя"))
        
        // parent может вернуть null
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ parent работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 9. ПРОВЕРКА МЕТОДА deleteLater =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 9: Проверка метода deleteLater")
    СброситьЦветКонсоли()
    
    Попытка
        об.ВызватьМетод("deleteLater")
        ВывестиСтрокуВКонсоль("    deleteLater вызван")
        
        // Проверяем, что объект все еще существует
        валиденПосле = об.Действителен()
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиденПосле)
        
        // deleteLater не удаляет сразу, поэтому объект еще валиден
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("    ✓ deleteLater работает")
        СброситьЦветКонсоли()
        успешноТестов = успешноТестов + 1
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 10. ПОВТОРНОЕ СОЗДАНИЕ ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 10: Повторное создание объекта")
    СброситьЦветКонсоли()
    
    Попытка
        результат2 = об.Создать("QObject")
        имяКласса2 = об.ИмяКласса()
        валиден2 = об.Действителен()
        
        ВывестиСтрокуВКонсоль("    Создать('QObject'): " + результат2)
        ВывестиСтрокуВКонсоль("    ИмяКласса(): " + имяКласса2)
        ВывестиСтрокуВКонсоль("    Действителен(): " + валиден2)
        
        Если результат2 == true И имяКласса2 == "QObject" И валиден2 == true Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Повторное создание работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Повторное создание не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 11. ОТЛАДКА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 11: Включение отладки")
    СброситьЦветКонсоли()
    
    Попытка
        // setDebug принимает один параметр - bool
        об.РежимОтладки(ИСТИНА)
        отладка = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ИСТИНА): " + отладка)
        
        об.РежимОтладки(ЛОЖЬ)
        отладка2 = об.ПолучитьРежимОтладки()
        ВывестиСтрокуВКонсоль("    РежимОтладки(ЛОЖЬ): " + отладка2)
        
        Если отладка == ИСТИНА И отладка2 == ЛОЖЬ Тогда
            УстановитьЦветКонсоли("green")
            ВывестиСтрокуВКонсоль("    ✓ Отладка работает")
            СброситьЦветКонсоли()
            успешноТестов = успешноТестов + 1
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Отладка не работает")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== 12. СОЗДАНИЕ НОВОГО ОБЪЕКТА =====
    всегоТестов = всегоТестов + 1
    УстановитьЦветКонсоли("yellow")
    ВывестиСтрокуВКонсоль("  Тест 12: Создание нового объекта")
    СброситьЦветКонсоли()
    
    Попытка
        об2 = НовыйОбъект("CPPОбъект")
        Если об2 != null Тогда
            об2.Создать("QObject")
            имяКласса3 = об2.ИмяКласса()
            ВывестиСтрокуВКонсоль("    Новый объект создан, класс: " + имяКласса3)
            
            Если имяКласса3 == "QObject" Тогда
                УстановитьЦветКонсоли("green")
                ВывестиСтрокуВКонсоль("    ✓ Создание нового объекта работает")
                СброситьЦветКонсоли()
                успешноТестов = успешноТестов + 1
            Иначе
                УстановитьЦветКонсоли("red")
                ВывестиСтрокуВКонсоль("    ✗ Новый объект не создан")
                СброситьЦветКонсоли()
            КонецЕсли
        Иначе
            УстановитьЦветКонсоли("red")
            ВывестиСтрокуВКонсоль("    ✗ Не удалось создать новый объект")
            СброситьЦветКонсоли()
        КонецЕсли
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("    ✗ Ошибка: " + e)
        СброситьЦветКонсоли()
    КонецПопытки

    // ===== ИТОГ =====
    ВывестиСтрокуВКонсоль("")
    УстановитьЦветКонсоли("cyan")
    Если успешноТестов == всегоТестов Тогда
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль("✅ Тест CPPObject: " + успешноТестов + " из " + всегоТестов + " пройдено (ВСЕ ТЕСТЫ ПРОЙДЕНЫ!)")
    Иначе
        УстановитьЦветКонсоли("yellow")
        ВывестиСтрокуВКонсоль("✅ Тест CPPObject: " + успешноТестов + " из " + всегоТестов + " пройдено")
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("  ⚠️ НЕ ПРОЙДЕНО ТЕСТОВ: " + (всегоТестов - успешноТестов))
    КонецЕсли
    СброситьЦветКонсоли()
    
    Возврат "Тест CPPObject завершён"
КонецФункции

// ============================================================
// ГЛАВНАЯ ПРОЦЕДУРА СТАРТ
// ============================================================

ПРОЦЕДУРА Старт()
    ПодавитьВыводОкна(ИСТИНА)
    СкрытьГлавноеОкно()
    ОчиститьКонсоль()
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                     ТЕСТ CPPObject (Универсальная обертка)                    ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    Попытка
        результат = ТестCPPObject()
        УстановитьЦветКонсоли("green")
        ВывестиСтрокуВКонсоль(результат)
    Исключение
        УстановитьЦветКонсоли("red")
        ВывестиСтрокуВКонсоль("❌ Ошибка: " + e)
    КонецПопытки
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    УстановитьЦветКонсоли("cyan")
    ВывестиСтрокуВКонсоль("╔════════════════════════════════════════════════════════════════════════════════╗")
    ВывестиСтрокуВКонсоль("║                         ТЕСТИРОВАНИЕ ЗАВЕРШЕНО                                 ║")
    ВывестиСтрокуВКонсоль("╚════════════════════════════════════════════════════════════════════════════════╝")
    СброситьЦветКонсоли()
    ВывестиСтрокуВКонсоль("")
    
    ВывестиСтрокуВКонсоль("Тестирование завершено. Программа закроется через 10 секунд.")
    Пауза(10000)
    ЗавершитьПрограмму(0)
КОНЕЦПРОЦЕДУРЫ


